#!/bin/bash

# 1. Khai báo thư mục chứa mã nguồn cần quét
TARGET_DIR="."

# 2. Tìm tất cả các file có chứa chuỗi "sudo -u" để xử lý (Dùng grep -rl giúp bỏ qua các file không liên quan, tăng tốc cực nhanh)
files=$(grep -rl "sudo -u" "$TARGET_DIR")

if [[ -z "$files" ]]; then
  echo "Không tìm thấy file nào chứa lệnh 'sudo -u' trong $TARGET_DIR."
  exit 0
fi

# 3. Tiến hành vòng lặp để thay thế
for file in $files; do
  echo "Đang tối ưu chuẩn runuser cho file: $file"
  sed -i -E 's//sbin/runuser -u ([^ -- ]+) /\/sbin\/runuser -u \1 -- /g' "$file"
done
