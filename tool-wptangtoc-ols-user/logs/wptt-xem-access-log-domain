# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-menu-logs 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ LOGS ➜ Xem Access Log (Nhật ký truy cập)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# NHẬN DIỆN TÊN MIỀN
# ==============================================================================
. /etc/wptt-user/tenmien
lua_chon_NAME "Xem Access Log"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1; exit 0; }

# ==============================================================================
# KIỂM TRA ĐƯỜNG DẪN LOG BÊN TRONG LỒNG CHROOT
# ==============================================================================
LOG_FILE="/usr/local/lsws/$NAME/logs/access.log"

if [[ ! -f "$LOG_FILE" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file log tại: $LOG_FILE${C_RESET}"
  echo "Ghi chú: Có thể website chưa có lượt truy cập nào hoặc cấu hình Vhost chưa tự sinh file."
  sleep 4
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1
  exit 1
fi

# Đoạn này để kiểm tra xem User có quyền đọc file log không (Tránh báo lỗi nhảm ra màn hình)
if [[ ! -r "$LOG_FILE" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Bạn không có quyền (Permission) để đọc file log này!${C_RESET}"
  echo "Vui lòng liên hệ Admin để kiểm tra lại quyền sở hữu thư mục logs."
  sleep 4
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1
  exit 1
fi

# ==============================================================================
# HIỂN THỊ DỮ LIỆU
# ==============================================================================
clear
echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}DỮ LIỆU ACCESS LOG - WEBSITE: $NAME${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Đường dẫn file : $LOG_FILE"
left_text "Trạng thái     : Đang hiển thị 50 lượt truy cập mới nhất..."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""

# In ra 50 dòng cuối cùng của file log
tail -n 50 "$LOG_FILE"

echo ""
echo -e "${C_GREEN}────────────────────────────────────────────────────────────────────────────────${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu Logs...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-menu-logs 1
fi
