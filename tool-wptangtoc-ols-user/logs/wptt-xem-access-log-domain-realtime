#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-menu-logs 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ LOGS ➜ Xem Access Log (Trực tiếp / Real-time)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# NHẬN DIỆN TÊN MIỀN
# ==============================================================================
. /etc/wptt-user/tenmien
lua_chon_NAME "Xem Log Real-time"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1; exit 0; }

# ==============================================================================
# KIỂM TRA ĐƯỜNG DẪN LOG BÊN TRONG LỒNG CHROOT
# ==============================================================================
LOG_FILE="/usr/local/lsws/$NAME/logs/access.log"

if [[ ! -f "$LOG_FILE" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file log tại: $LOG_FILE${C_RESET}"
  echo "Ghi chú: Có thể website chưa có lượt truy cập nào hoặc cấu hình Vhost chưa tự sinh file."
  sleep 4
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1
  exit 1
fi

if [[ ! -r "$LOG_FILE" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Bạn không có quyền (Permission) để đọc file log này!${C_RESET}"
  sleep 4
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-menu-logs 1
  exit 1
fi

# ==============================================================================
# HÀM BẪY PHÍM CTRL+C (TRAP SIGINT) ĐỂ KHÔNG BỊ VĂNG RA NGOÀI
# ==============================================================================
trap_ctrl_c() {
    # Hủy trap để tránh loop
    trap - SIGINT
    echo -e "\n\n${C_YELLOW}Đã thoát chế độ xem trực tiếp (Real-time).${C_RESET}"
    sleep 1
    if [[ "$1" == "98" ]]; then
        exec /etc/wptt-user/wptt-menu-logs 1
    else
        exit 0
    fi
}

# Kích hoạt bẫy phím Ctrl+C
trap 'trap_ctrl_c "$1"' SIGINT

# ==============================================================================
# HIỂN THỊ DỮ LIỆU
# ==============================================================================
clear
echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}TRỰC TIẾP ACCESS LOG - WEBSITE: $NAME${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Đường dẫn file : $LOG_FILE"
left_text "Trạng thái     : Đang chờ luồng truy cập mới..."
left_text "Cảnh báo       : ${C_YELLOW}Bấm tổ hợp phím [Ctrl + C] để thoát về Menu!${C_RESET}"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""

# Chạy lệnh tail -f (Theo dõi trực tiếp)
tail -f "$LOG_FILE"

# Gỡ bẫy phím nếu tail thoát tự nhiên (ví dụ file bị xóa)
trap - SIGINT

echo ""
echo -e "${C_GREEN}────────────────────────────────────────────────────────────────────────────────${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu Logs...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-menu-logs 1
fi
