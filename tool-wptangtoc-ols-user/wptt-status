#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Nạp bảng màu chuẩn
. /etc/wptt-user/echo-color 2>/dev/null

box_inner_width=78

# Lấy thông tin môi trường
current_user="${USER:-$(whoami 2>/dev/null)}"
current_path=$(pwd)
if [[ "$current_path" == "/" ]]; then
  current_path="/ (Chroot Root)"
fi

# Lời chào theo buổi
thoi_gian=$(date +'%H' | sed 's/^0//g')
if (($thoi_gian < 10)); then
  thoi_diem='Chúc bạn có buổi sáng tuyệt vời'
elif (($thoi_gian < 14)); then
  thoi_diem='Chúc bạn có buổi trưa tuyệt vời'
elif (($thoi_gian < 18)); then
  thoi_diem='Chúc bạn có buổi chiều tuyệt vời'
else
  thoi_diem='Chúc bạn có buổi tối tuyệt vời'
fi

# --- CÁC HÀM VẼ UI SIÊU TỐC CHO LIVE CLOCK ---
center_text_live() {
  local text="$1"
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}
  local pad_left=$(((box_inner_width - text_len) / 2))
  local pad_right=$((box_inner_width - text_len - pad_left))
  [[ $pad_left -lt 0 ]] && pad_left=0
  [[ $pad_right -lt 0 ]] && pad_right=0
  printf "${C_CYAN}│${C_RESET}%*s%s%*s${C_CYAN}│${C_RESET}\n" "$pad_left" "" "$text" "$pad_right" ""
}

left_text_live() {
  local text="$1"
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}
  local pad_right=$((box_inner_width - text_len - 2))
  [[ $pad_right -lt 0 ]] && pad_right=0
  printf "${C_CYAN}│${C_RESET}  %s%*s${C_CYAN}│${C_RESET}\n" "$text" "$pad_right" ""
}

# --- DISPLAY FUNCTION ---
print_dashboard() {
  local current_time=$(date "+%d/%m/%Y %H:%M:%S")
  local out=""

  out+="${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}\n"
  out+=$(center_text_live "${C_BOLD_WHITE}WPTANGTOC OLS - USER CONTROL PANEL${C_RESET}")"\n"
  out+=$(center_text_live "${C_YELLOW}Môi trường quản trị bảo mật tuyệt đối (Chroot Jail)${C_RESET}")"\n"
  out+="${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}\n"
  
  out+=$(left_text_live "${C_GREEN}${thoi_diem}!${C_RESET}")"\n"
  out+=$(left_text_live "")"\n"
  
  out+=$(left_text_live "Tài khoản (User)   : ${C_YELLOW}$current_user${C_RESET}")"\n"
  out+=$(left_text_live "Thư mục hiện tại   : ${C_YELLOW}$current_path${C_RESET}")"\n"
  out+=$(left_text_live "Quyền hạn hệ thống : ${C_RED}Bị giới hạn (Restricted / Jail)${C_RESET}")"\n"
  out+=$(left_text_live "Thời gian máy chủ  : ${C_GREEN}$current_time${C_RESET}")"\n"
  
  out+="${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}\n"
  out+=$(center_text_live "${C_GREEN}[ENTER] Mở Menu Quản Trị  |  [0] Thoát ra dòng lệnh${C_RESET}")"\n"
  out+="${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  
  # Xóa các dòng thừa bên dưới để tránh lưu rác khi Terminal bị thu nhỏ
  out+="\033[J"
  
  # In toàn bộ cục String ra màn hình trong 1 lần (Chống giật/Flicker)
  echo -ne "$out"
}

# --- VÒNG LẶP CHÍNH (Đồng hồ Live siêu mượt) ---
tput civis # Ẩn con trỏ chuột
clear      # Xóa sạch màn hình 1 lần duy nhất lúc khởi động

ACTION="menu"

while true; do
  tput cup 0 0 # Ghim con trỏ chuột về tọa độ [0,0] (Góc trên cùng bên trái)
  print_dashboard

  # Chờ người dùng bấm phím trong 1 giây
  read -t 1 -n 1 -s key_input
  if [ $? -eq 0 ]; then
    if [[ "$key_input" == "0" ]]; then
      ACTION="exit"
    else
      ACTION="menu"
    fi
    break
  fi
done

# Bắt lỗi thoát đột ngột (Ctrl+C)
trap - SIGINT
tput cnorm # Hiện lại con trỏ chuột
echo ""

# --- CHUYỂN HƯỚNG MÀN HÌNH ---
case $ACTION in
"exit")
  echo -e "\nĐã thoát ra màn hình Terminal (Dòng lệnh)."
  echo -e "Nhập lệnh ${C_GREEN}1${C_RESET} hoặc ${C_GREEN}wptangtoc-user${C_RESET} để gọi lại Menu Quản Trị."
  ;;
*)
  if [ -f "/etc/wptt-user/wptangtoc-user" ]; then
    exec /etc/wptt-user/wptangtoc-user
  else
    echo -e "${C_RED}❌ Lỗi: Không tìm thấy file wptangtoc-user. Vui lòng liên hệ Admin!${C_RESET}"
  fi
  ;;
esac
