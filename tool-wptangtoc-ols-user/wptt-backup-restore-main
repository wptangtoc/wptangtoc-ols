#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

clear
if [[ -z "$1" ]]; then
  if [[ -f /etc/wptt-user/wptt-header-menu ]]; then
    . /etc/wptt-user/wptt-header-menu
    header_menu
  fi
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}WPTANGTOC OLS ➜ QUẢN LÝ SAO LƯU & KHÔI PHỤC${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

options=(
  "Sao lưu Website (Code & DB)"
  "Khôi phục Website (Code & DB)"
  "Sao lưu Database (Chỉ xuất SQL)"
  "Khôi phục Database (Chỉ nhập SQL)"
  "Xóa file Backup Local"
  "Thiết lập tự động Sao lưu Website"
  "Gỡ bỏ thiết lập tự động Sao lưu"
  "Thiết lập Backup lưu trữ Google Drive"
  "Gỡ bỏ thiết lập Backup Google Drive"
  "Tải (Download) file Backup từ Google Drive"
  "Xóa file Backup trên Google Drive"
  "Thiết lập xóa file Backup hết hạn trên Cloud"
  "Thiết lập Backup lưu trữ OneDrive"
)

# Render menu items
i=1
for opt in "${options[@]}"; do
  item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$opt")
  clean_text=$(printf "  %3d) %s" "$i" "$opt")
  pad=$((box_inner_width - ${#clean_text}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done

echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-${#options[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  case "$REPLY" in
    1) exec /etc/wptt-user/backup-restore/wptt-saoluu 98 ;;
    2) exec /etc/wptt-user/backup-restore/wptt-khoiphuc 98 ;;
    3) exec /etc/wptt-user/db/wptt-saoluu-database 97 ;;
    4) exec /etc/wptt-user/db/wptt-nhapdatabase 97 ;;
    5) exec /etc/wptt-user/backup-restore/wptt-xoa-file-backup 98 ;;
    6) exec /etc/wptt-user/backup-restore/wptt-auto-backup 98 ;;
    7) exec /etc/wptt-user/backup-restore/wptt-tat-auto-backup 98 ;;
    8) exec /etc/wptt-user/backup-restore/wptt-rclone 98 ;;
    9) exec /etc/wptt-user/backup-restore/wptt-huy-rclone 98 ;;
    10) exec /etc/wptt-user/backup-restore/wptt-download-rclone 98 ;;
    11) exec /etc/wptt-user/backup-restore/wptt-xoa-file-backup-google-driver 98 ;;
    12) exec /etc/wptt-user/backup-restore/wptt-xoa-file-backup-google-driver 98 ;;
    13) exec /etc/wptt-user/backup-restore/wptt-rclone-one-drive 98 ;;
    0) exec /etc/wptt-user/wptangtoc-user 1 ;;
    *)
      echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập từ 1 đến ${#options[@]} hoặc 0 để thoát.${C_RESET}"
      ;;
  esac
done
