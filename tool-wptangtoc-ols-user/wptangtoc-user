#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78


. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

version_wptangtoc_ols="Phiên bản Chroot"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
if [[ -z "$1" ]]; then
  center_text "${C_BOLD_WHITE}WPTANGTOC OLS - USER PANEL${C_RESET}"
  center_text "${C_YELLOW}Phát triển bởi: Gia Tuấn${C_RESET}"
else
  center_text "${C_YELLOW}WPTANGTOC OLS - MENU CHÍNH${C_RESET}"
fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

options=(
  "Quản lý Database"
  "Sao lưu & Khôi phục"
  "Cài mới WordPress trắng"
  "Preload Cache"
  "Quản lý Logs"
  "Quản lý Mã nguồn"
  "Quản lý Cache"
  "Cấu hình Crontab (Hẹn giờ)"
)

# Render menu items
i=1
for opt in "${options[@]}"; do
  item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$opt")
  clean_text=$(printf "  %3d) %s" "$i" "$opt")
  pad=$((box_inner_width - ${#clean_text}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done

echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-${#options[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  case "$REPLY" in
    1) exec /etc/wptt-user/wptt-db-main ;;
    2) exec /etc/wptt-user/wptt-backup-restore-main ;;
    3) exec /etc/wptt-user/wptt-install-wordpress2 99 ;;
    4) exec /etc/wptt-user/wptt-preload-cache2 98 ;;
    5) exec /etc/wptt-user/wptt-menu-logs ;;
    6) exec /etc/wptt-user/wptt-ma-nguon-main ;;
    7) exec /etc/wptt-user/wptt-cache-main ;;
    8) exec /etc/wptt-user/cron-cau-hinh ;;
    0)
      clear
      if [ -f "/etc/wptt-user/wptt-status" ]; then
        exec /etc/wptt-user/wptt-status
      else
        echo -e "${C_GREEN}Đã thoát menu WPTangToc OLS an toàn.${C_RESET}"
        exit 0
      fi
      ;;
    *)
      echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập từ 1 đến ${#options[@]} hoặc 0 để thoát.${C_RESET}"
      ;;
  esac
done
