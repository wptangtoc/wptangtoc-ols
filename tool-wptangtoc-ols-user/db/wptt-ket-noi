#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-db-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DATABASE ➜ Kết nối Database (wp-config.php)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  . /etc/wptt-user/tenmien
  lua_chon_NAME "Kết nối wp-config.php"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-db-main 1

. /etc/."$NAME".conf 2>/dev/null

wp_config_php_path="/usr/local/lsws/$NAME/html/wp-config.php"
if [[ ! -f "$wp_config_php_path" ]]; then
  echo -e "${C_RED}❌ Lỗi: Không xác định được file wp-config.php${C_RESET}"
  echo "Vui lòng kiểm tra lại mã nguồn của website này."
  sleep 3
  exec /etc/wptt-user/wptt-db-main 1
fi

_runing "Đang thiết lập kết nối Database chính với WordPress..."

# ==============================================================================
# GIẢI MÃ MẬT KHẨU VÀ TIÊM VÀO BẰNG WP-CLI (THAY THẾ SED)
# ==============================================================================
password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

wp config set DB_HOST 'localhost' --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
wp config set DB_NAME "$DB_Name_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
wp config set DB_USER "$DB_User_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
wp config set DB_PASSWORD "$password_database_website_giai_ma" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet

wp rewrite flush --allow-root --path="/usr/local/lsws/$NAME/html" >/dev/null 2>&1
_rundone "Kết nối Database chính thành công"

# ==============================================================================
# XỬ LÝ SUBFOLDER (NẾU CÓ) - TỰ ĐỘNG GIẢI MÃ PASS RIÊNG CỦA TỪNG SUBFOLDER
# ==============================================================================
co_ket_noi_subfolder=0
if [[ -d "/etc/wptt/$NAME-wptt" ]]; then
  for entry in $(ls -A "/etc/wptt/$NAME-wptt"); do
    subfolder=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//')
    . "/etc/wptt/$NAME-wptt/.${subfolder}.conf"
    
    subfolder_path=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//' | sed 's/__/ /g' | cut -f2 -d ' ')
    wp_config_php_path_sub="/usr/local/lsws/$NAME/html/$subfolder_path/wp-config.php"
    
    if [[ -f "$wp_config_php_path_sub" ]]; then
      _runing "Đang kết nối Database cho Subfolder: $subfolder_path..."
      
      subfolder_password_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
      [[ -z "$subfolder_password_giai_ma" ]] && subfolder_password_giai_ma="$DB_Password_web"

      wp config set DB_HOST 'localhost' --type=constant --allow-root --path="/usr/local/lsws/$NAME/html/$subfolder_path" --quiet
      wp config set DB_NAME "$DB_Name_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html/$subfolder_path" --quiet
      wp config set DB_USER "$DB_User_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html/$subfolder_path" --quiet
      wp config set DB_PASSWORD "$subfolder_password_giai_ma" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html/$subfolder_path" --quiet
      
      wp rewrite flush --allow-root --path="/usr/local/lsws/$NAME/html/$subfolder_path" >/dev/null 2>&1
      _rundone "Kết nối Subfolder $subfolder_path thành công"
      co_ket_noi_subfolder=1
    fi
  done
fi

# ==============================================================================
# NẠP LẠI LITESPEED BẰNG HÀM CHROOT-SAFE
# ==============================================================================
wptt_smart_reload_lsws >/dev/null 2>&1

echo "Kết nối database với wp-config.php cho website $NAME (User): $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log

# Phục hồi lại biến cấu hình gốc (vì vòng lặp Subfolder vừa nãy đã đè biến DB_*)
. /etc/."$NAME".conf 2>/dev/null

# ==============================================================================
# BẢNG TÓM TẮT THÀNH CÔNG
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}KẾT NỐI WP-CONFIG THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Tên Database : $DB_Name_web"
left_text "User Database: $DB_User_web"
left_text "Mật khẩu     : ******************** (Đã giải mã tự động)"
if [[ "$co_ket_noi_subfolder" == "1" ]]; then
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Ghi chú      : Hệ thống đã tự động cấu hình wp-config cho các Subfolder!"
fi
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-db-main 1
