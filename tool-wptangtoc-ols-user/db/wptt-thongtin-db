#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DATABASE ➜ Xem thông tin Database${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Xem thông tin tài khoản database"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-db-main 1; exit 0; }

. /etc/."$NAME".conf 2>/dev/null

# ==============================================================================
# GIẢI MÃ MẬT KHẨU AES-256
# ==============================================================================
password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

# ==============================================================================
# HIỂN THỊ THÔNG TIN VỚI KHUNG GIAO DIỆN
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}THÔNG TIN DATABASE${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website           : ${C_YELLOW}$NAME${C_RESET}"
left_text "Tên Database      : $DB_Name_web"
left_text "User Database     : $DB_User_web"
left_text "Mật khẩu Database : ${C_GREEN}$password_database_website_giai_ma${C_RESET}"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-db-main 1
fi
