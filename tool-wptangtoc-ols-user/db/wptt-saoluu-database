#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == "97" ]]; then
  TITLE_TXT="QUẢN LÝ SAO LƯU ➜ Sao lưu Database (Export)"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
else
  TITLE_TXT="QUẢN LÝ DATABASE ➜ Sao lưu Database (Export)"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-db-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${TITLE_TXT}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Sao lưu Database"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec $WPTT_MENU_BACK

. /etc/wptt/vhost/."$NAME".conf 2>/dev/null


mkdir -p "/usr/local/lsws/$NAME/backup-website"
timedate=$(date +%Hgio\_%d\_%m\_%Y)

echo "Sao lưu database website $NAME (User): $(date '+%d-%m-%Y %H:%M')" >>/tmp/wptangtoc-ols.log

_runing "Đang kết xuất (Export) Database của website $NAME..."

# ==============================================================================
# BỘ KHIÊN CHỐNG LOCAL SQL INJECTION & GIẢI MÃ AES
# ==============================================================================
wptt_abort_db_injection() {
    _runloi "$1"
    sleep 2
    exec $WPTT_MENU_BACK
}

[[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
[[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"

password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

TEMP_CNF=$(mktemp -p "/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF"
cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
trap "rm -f $TEMP_CNF" EXIT

# ==============================================================================
# THỰC THI XUẤT DATABASE VỚI THANH TIẾN TRÌNH
# ==============================================================================
RAW_SIZE=$(mariadb --defaults-extra-file="$TEMP_CNF" -N -e "SELECT SUM(data_length) FROM information_schema.TABLES WHERE table_schema='$DB_Name_web'")
if [[ -z "$RAW_SIZE" || "$RAW_SIZE" == "NULL" ]]; then RAW_SIZE=1024; fi
ADJUSTED_SIZE=$((RAW_SIZE * 95 / 100))

if command -v pv &>/dev/null; then
  PV_CMD="pv -s $ADJUSTED_SIZE -N 'Exporting' -p -t -e -w 80"
else
  PV_CMD="cat"
fi

echo ""
if [[ "$sql_gz" == '1' ]]; then
  FILE_OUT="/usr/local/lsws/$NAME/backup-website/$NAME$timedate.sql.gz"
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | gzip >"$FILE_OUT"
elif [[ "$sql_gz" == '2' ]]; then
  FILE_OUT="/usr/local/lsws/$NAME/backup-website/$NAME$timedate.sql.zst"
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | zstd >"$FILE_OUT"
else
  FILE_OUT="/usr/local/lsws/$NAME/backup-website/$NAME$timedate.sql"
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" >"$FILE_OUT"
fi

# Xóa vết dòng trạng thái Loading PV
echo -ne "\033[1A\r\033[K"
echo -ne "\033[1A\r\033[K"
rm -f "$TEMP_CNF"

# ==============================================================================
# KIỂM TRA LỖI FILE & BẢO MẬT PHÂN QUYỀN 600 TỨC THÌ
# ==============================================================================
if [[ -f "$FILE_OUT" ]]; then
  check_file_error=$(du -c "$FILE_OUT" 2>/dev/null | awk '{print $1}' | sed '1d')
  if ((${check_file_error:-0} < 3)); then
    rm -f "$FILE_OUT"
    _runloi "Sao lưu Database thất bại (Cơ sở dữ liệu trống hoặc lỗi)"
    sleep 3
    exec $WPTT_MENU_BACK
  else
    # SÁT CHIÊU: Khóa quyền 600 ngay lập tức sau khi file sinh ra thành công
    chmod 600 "$FILE_OUT"
    _rundone "Sao lưu Database thành công"
  fi
else
  _runloi "Sao lưu Database thất bại"
  sleep 3
  exec $WPTT_MENU_BACK
fi

clear
FILE_NAME=$(basename "$FILE_OUT")
FILE_SIZE=$(du -sh "$FILE_OUT" 2>/dev/null | awk '{print $1}')

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}SAO LƯU DATABASE THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Tên Database : $DB_Name_web"
left_text "Tên File     : ${C_GREEN}$FILE_NAME${C_RESET} ($FILE_SIZE)"
left_text "Lưu trữ tại  : /usr/local/lsws/$NAME/backup-website/"
left_text "Bảo mật      : Đã thiết lập quyền hạn 600 (An toàn tuyệt đối)"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

exec $WPTT_MENU_BACK
