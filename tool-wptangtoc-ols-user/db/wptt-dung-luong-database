#!/bin/bash
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DATABASE ➜ Xem dung luợng Database${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
. /etc/wptt-user/tenmien
lua_chon_NAME
. /etc/wptt/vhost/."$NAME".conf
path="/usr/local/lsws/$NAME/html"

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  . /etc/wptt-user/echo-color
  echoDo "He thong xac nhan ban chua kich hoat su dung WordPress"
  echoDo "Tinh nang chi danh cho WordPress"
  sleep 3
    . /etc/wptt-user/wptt-db-main 1
  exit
fi

wp db size --tables --path="$path" --allow-root

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r _
  exec /etc/wptt-user/wptt-db-main 1
fi

