#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-db-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DATABASE ➜ Chuyển đổi Storage Engine (InnoDB/MyISAM/Aria)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# NHẬN DIỆN TÊN MIỀN VÀ KIỂM TRA MÔI TRƯỜNG
# ==============================================================================
. /etc/wptt-user/tenmien
lua_chon_NAME "Chuyển đổi Engine Database"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-db-main 1

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-db-main 1
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Hệ thống xác nhận website không sử dụng mã nguồn WordPress!${C_RESET}"
  echo -e "${C_YELLOW}⚠️ Tính năng này vận hành dựa trên lõi WP-CLI nên chỉ hỗ trợ WordPress.${C_RESET}"
  sleep 4
  exec /etc/wptt-user/wptt-db-main 1
fi

# ==============================================================================
# MENU CHỌN ĐỊNH DẠNG ENGINE MỤC TIÊU
# ==============================================================================
echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHỌN CÔNG NGHỆ LƯU TRỮ (STORAGE ENGINE) MỤC TIÊU${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "  ${C_CYAN}1)${C_RESET} ${C_BOLD_WHITE}InnoDB${C_RESET} (Khuyên dùng: Hỗ trợ Transaction, Khóa ngoại, An toàn)" 2
left_text "  ${C_CYAN}2)${C_RESET} ${C_BOLD_WHITE}MyISAM${C_RESET} (Tốc độ đọc nhanh, Cấu trúc cũ, Không Transaction)" 2
left_text "  ${C_CYAN}3)${C_RESET} ${C_BOLD_WHITE}Aria${C_RESET}   (Cải tiến của MyISAM, Phục hồi sau sự cố tốt hơn)" 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-3) [0=Thoát]: ${C_RESET}"
  read -r REPLY
  case "$REPLY" in
    0) exec /etc/wptt-user/wptt-db-main 1 ;;
    1) engine="InnoDB"; break ;;
    2) engine="MyISAM"; break ;;
    3) engine="Aria"; break ;;
    *) echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}" ;;
  esac
done

# ==============================================================================
# THỰC THI CHUYỂN ĐỔI
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}TIẾN HÀNH CHUYỂN ĐỔI STORAGE ENGINE${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website mục tiêu : ${C_YELLOW}$NAME${C_RESET}" 2
left_text "Engine định dạng : ${C_YELLOW}$engine${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# Ghi log an toàn trong Chroot
echo "Chuyển đạng dạng lưu trữ sang $engine cho website $NAME : $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log

cd "/usr/local/lsws/$NAME/html" || exit

_runing "Đang quét Database để tìm các Table chưa ở định dạng $engine..."

# WP-CLI Query lấy danh sách Table lệch Engine (sử dụng wp-cli nguyên bản trong jail)
WPTABLES=($(wp db query "SHOW TABLE STATUS WHERE Engine != '$engine'" --allow-root --silent --skip-column-names 2>/dev/null | awk '{ print $1}'))

if [[ ${#WPTABLES[@]} -gt 0 ]]; then
  _rundone "Quét hoàn tất! Tìm thấy ${#WPTABLES[@]} Table cần được chuyển đổi."
  echo ""

  for WPTABLE in "${WPTABLES[@]}"; do
    _runing "Đang Convert Table: [${WPTABLE}] ➜ $engine"
    # Thực thi Alter Table
    wp db query "ALTER TABLE \`${WPTABLE}\` ENGINE=$engine" --allow-root --path="/usr/local/lsws/$NAME/html" >/dev/null 2>&1
    _rundone "Đã Convert Table: [${WPTABLE}] ➜ $engine"
  done

  echo ""
  _rundone "Hoàn tất chuyển đổi Database sang $engine cho website $NAME!"
else
  _rundone "Tuyệt vời! Tất cả các Table đều đã ở định dạng $engine, không cần chuyển đổi thêm!"
fi

if [[ "$1" == "98" ]]; then
  echo -en "\n${C_CYAN}Nhấn phím [Enter] để quay lại Menu Database...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-db-main 1
fi
