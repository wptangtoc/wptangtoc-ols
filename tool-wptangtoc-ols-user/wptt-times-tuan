function tuan() {
  export box_inner_width=78

  # Nạp UI nếu chưa có
  . /etc/wptt-user/echo-color 2>/dev/null
  . /etc/wptt-user/core-functions 2>/dev/null

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}CHỌN NGÀY THỰC THI (CRON JOB)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  local options=(
    "Thứ Hai"
    "Thứ Ba"
    "Thứ Tư"
    "Thứ Năm"
    "Thứ Sáu"
    "Thứ Bảy"
    "Chủ Nhật"
    "Hàng ngày (Mỗi ngày)"
  )

  local i=1
  for opt in "${options[@]}"; do
    local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$opt")
    local clean_text=$(printf "  %3d) %s" "$i" "$opt")
    local pad=$((box_inner_width - ${#clean_text}))
    [[ $pad -lt 0 ]] && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  thu="1" # Biến toàn cục để script gọi hàm này có thể sử dụng
  
  while true; do
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-8) [Enter = Mặc định Thứ Hai]: ${C_RESET}"
    read -r REPLY

    if [[ -z "$REPLY" ]]; then
      thu="1"
      break
    fi

    case "$REPLY" in
      1) thu="1"; break ;;
      2) thu="2"; break ;;
      3) thu="3"; break ;;
      4) thu="4"; break ;;
      5) thu="5"; break ;;
      6) thu="6"; break ;;
      7) thu="0"; break ;; # Chuẩn crontab: Chủ nhật là 0
      8) thu="*"; break ;; # Chuẩn crontab: Chạy mỗi ngày là *
      *)
        echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập số từ 1 đến 8.${C_RESET}"
        ;;
    esac
  done
}
