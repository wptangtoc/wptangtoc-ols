#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @email: giatuan@wptangtoc.com

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptangtoc-user 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}WPTANGTOC OLS ➜ QUẢN LÝ CACHE ➜ Preload Cache${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  . /etc/wptt-user/tenmien
  lua_chon_NAME "Preload Cache"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptangtoc-user 1

if [ "$NAME" = "${NAME/./}" ]; then
  echo -e "${C_RED}❌ Domain nhập không đúng định dạng.${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptangtoc-user 1
fi

_runing "Đang kiểm tra trạng thái hoạt động của website $NAME..."

if [[ -n "$ip_domain" ]]; then
  domain=$(curl -s ipv4.icanhazip.com 2>/dev/null)
else
  domain="$NAME"
fi

checkssl=$(curl -Is https://"${domain}" --connect-to "${domain}:443:127.0.0.1:443" -A "WPTangToc OLS preload cache" -m 5 2>/dev/null | head -n 1 | grep -c "200")
checkssl2=$(curl -Is http://"${domain}" --connect-to "${domain}:80:127.0.0.1:80" -A "WPTangToc OLS preload cache" -m 5 2>/dev/null | head -n 1 | grep -c "200")
checkssl3=$(curl -Is https://www."${domain}" --connect-to "www.${domain}:443:127.0.0.1:443" -A "WPTangToc OLS preload cache" -m 5 2>/dev/null | head -n 1 | grep -c "200")
checkssl4=$(curl -Is http://www."${domain}" --connect-to "www.${domain}:80:127.0.0.1:80" -A "WPTangToc OLS preload cache" -m 5 2>/dev/null | head -n 1 | grep -c "200")

if [[ "$checkssl" == "0" && "$checkssl2" == "0" && "$checkssl3" == "0" && "$checkssl4" == "0" ]]; then
  _runloi "Website $NAME hiện đang không phản hồi (Mã lỗi không phải 200 OK)."
  sleep 4
  exec /etc/wptt-user/wptangtoc-user 1
fi
_rundone "Website $NAME đang hoạt động bình thường"

NAME_path="$NAME"
if [[ "$checkssl3" == "1" || "$checkssl4" == "1" ]]; then
  domain="www.${domain}"
fi

if [[ "$checkssl" == "1" || "$checkssl3" == "1" ]]; then
  ssl="https"
else
  ssl="http"
fi

_runing "Đang quét Sitemap của website $NAME..."

# Kiểm tra công nghệ Cache trực tiếp qua file hệ thống
check_htaccess=$(cat "/usr/local/lsws/$NAME/html/.htaccess" 2>/dev/null)
grepmobile=$(echo "$check_htaccess" | grep -ci "Android")
grepwebp=$(echo "$check_htaccess" | grep -ci "+webp")

# Các đường dẫn sitemap phổ biến
sitemap_paths=(
  "/sitemap_index.xml"
  "/sitemap.xml"
  "/wp-sitemap.xml"
  "/sitemaps.xml"
)

found_sitemap=false
for path in "${sitemap_paths[@]}"; do
  full_url="${ssl}://${domain}${path}"
  domain_clean=$(echo "$domain" | sed 's/^www\.//g')
  
  check_http_200=$(curl -Is "$full_url" --connect-to "${domain}:443:127.0.0.1:443" --connect-to "${domain}:80:127.0.0.1:80" -A "WPTangToc OLS preload cache" -m 5 2>/dev/null | head -n 1 | grep -c "200")
  if [[ "$check_http_200" != "0" ]]; then
    found_sitemap=true
    NAME2="$full_url"
    break
  fi
done

if ! $found_sitemap; then
  _runloi "Không tìm thấy URL Sitemap hợp lệ của website $NAME!"
  sleep 4
  exec /etc/wptt-user/wptangtoc-user 1
fi
_rundone "Đã tìm thấy Sitemap: $NAME2"

# Nhận diện Plugin Cache
cong_cu=""
if [[ -d "/usr/local/lsws/$NAME_path/html/wp-content/plugins/litespeed-cache" ]]; then
  echo -e " ${C_GREEN}*${C_RESET} Công nghệ nhận diện: ${C_YELLOW}LiteSpeed Cache${C_RESET}"
  cong_cu="wptt-preload-cache-all.sh"
elif [[ -f "/usr/local/lsws/$NAME_path/html/wp-content/plugins/wptangtoc/class/Cache.php" ]]; then
  echo -e " ${C_GREEN}*${C_RESET} Công nghệ nhận diện: ${C_YELLOW}WPTangToc Cache${C_RESET}"
  cong_cu="wptt-preload-cache-all.sh"
else
  pluginsspeed=(
    cache-enabler fast-velocity-minify wp-rocket w3-total-cache wp-super-cache wp2speed
    nitropack wp-fastest-cache hummingbird-performance swift-performance-lite swift-performance-pro
    breeze wp-meteor phastpress flying-press simple-cache powered-cache yasakani-cache batcache sg-cachepress
  )
  for plugintt in "${pluginsspeed[@]}"; do
    if [[ -d "/usr/local/lsws/$NAME_path/html/wp-content/plugins/$plugintt" ]]; then
      plugintt2=$(echo "$plugintt" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++)sub(/./,toupper(substr($i,1,1)),$i)}1')
      echo -e " ${C_GREEN}*${C_RESET} Công nghệ nhận diện: ${C_YELLOW}$plugintt2${C_RESET}"
      cong_cu="wptt-preload-cache-all.sh"
      break
    fi
  done
fi

if [[ -z "$cong_cu" ]]; then
  echo -e "${C_RED}❌ Hệ thống xác định website chưa cài đặt công nghệ Cache nào!${C_RESET}"
  sleep 4
  exec /etc/wptt-user/wptangtoc-user 1
fi

if [[ "$grepmobile" != "0" ]]; then
  echo -e " ${C_GREEN}*${C_RESET} Phát hiện cấu hình Cache tách biệt cho thiết bị Mobile."
fi
if [[ "$grepwebp" != "0" ]]; then
  echo -e " ${C_GREEN}*${C_RESET} Phát hiện cấu hình tối ưu hình ảnh WebP."
fi

# ==============================================================================
# BẢO VỆ CHROOT TÀI NGUYÊN (CPU/RAM) VÀ XÓA TIẾN TRÌNH CŨ
# ==============================================================================
# Dọn dẹp tiến trình cũ (Cách Native không cần /proc)
pkill -u "${USER:-$(whoami)}" -f "wptt-preload-cache" 2>/dev/null

# Bọc lỗi an toàn cho CPU (Vì /proc có thể không khả dụng trong Chroot)
if [[ -f /proc/stat ]]; then
  cpu_su_dung=$(grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {print usage "%"}' | cut -f1 -d '.')
  if [[ -n "$cpu_su_dung" ]] && (( cpu_su_dung > 85 )); then
    echo -e "\n${C_RED}⚠️ CẢNH BÁO: CPU đang quá tải ($cpu_su_dung%). Không thể chạy Preload lúc này!${C_RESET}"
    sleep 3
    exit 1
  fi
fi

if [[ -f /proc/meminfo ]]; then
  ram_sudung=$(free | grep Mem | awk '{print $3/$2 * 100.0}' | cut -f1 -d '.' 2>/dev/null)
  if [[ -n "$ram_sudung" ]] && (( ram_sudung > 85 )); then
    echo -e "\n${C_RED}⚠️ CẢNH BÁO: RAM đang quá tải ($ram_sudung%). Không thể chạy Preload lúc này!${C_RESET}"
    sleep 3
    exit 1
  fi
fi

# ==============================================================================
# THỰC THI PRELOAD CẤP USER
# ==============================================================================
echo -e "\n${C_YELLOW}Hệ thống đang tiến hành giả lập người dùng để Preload Cache...${C_RESET}"
echo -e "Quá trình này sẽ chạy ngầm và tốn khá nhiều tài nguyên hệ thống.\n"

# ĐƯỜNG DẪN MỚI TƯƠNG THÍCH HỆ SINH THÁI USER
CORE_PRELOAD_SCRIPT="/etc/wptt-user/$cong_cu"

if [[ ! -f "$CORE_PRELOAD_SCRIPT" ]]; then
  echo -e "${C_RED}❌ Lỗi: Không tìm thấy Core Script ($CORE_PRELOAD_SCRIPT).${C_RESET}"
  echo "Vui lòng báo Admin copy file wptt-preload-cache-all.sh sang thư mục /etc/wptt-user/!"
  sleep 4
  exec /etc/wptt-user/wptangtoc-user 1
fi

check_run=''
if [[ "$grepmobile" != "0" ]]; then
  check_run='1'
  bash "$CORE_PRELOAD_SCRIPT" -i 0.5 -m -g "${NAME2}"
fi
if [[ "$grepwebp" != "0" ]]; then
  check_run='1'
  bash "$CORE_PRELOAD_SCRIPT" -i 0.5 -w "${NAME2}"
fi

if [[ -z "$check_run" ]]; then
  bash "$CORE_PRELOAD_SCRIPT" -i 0.5 "${NAME2}"
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}TẠO PRELOAD CACHE HOÀN TẤT${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Nguồn Sitemap: $NAME2"
left_text "Trạng thái   : Toàn bộ Request đã được đẩy vào Background."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ "$1" == "98" ]] && exec /etc/wptt-user/wptangtoc-user 1
