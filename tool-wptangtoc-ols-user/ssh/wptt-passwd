# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == "98" ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-ssh-main 1"
fi

# Lấy Username an toàn trong môi trường Chroot
current_user="${USER:-$(whoami 2>/dev/null)}"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ SSH/SFTP ➜ Thay đổi Mật khẩu${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Tài khoản (User) : ${C_GREEN}$current_user${C_RESET}"
left_text "Bảo mật          : Lời khuyên nên đặt mật khẩu từ 26 ký tự trở lên."
left_text "Lưu ý            : Mật khẩu sẽ KHÔNG hiển thị khi bạn gõ (tàng hình)."
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -e "${C_YELLOW}Hệ thống bắt đầu tiến trình đổi mật khẩu...${C_RESET}\n"

# Gọi lệnh đổi mật khẩu gốc của Linux (Sẽ tự yêu cầu nhập pass cũ rồi pass mới 2 lần)
passwd

if [[ $? -eq 0 ]]; then
  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}ĐỔI MẬT KHẨU THÀNH CÔNG${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Tài khoản : $current_user"
  left_text "Trạng thái: Hoàn tất. Hãy dùng mật khẩu mới cho các lần SSH/SFTP sau!"
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
else
  echo -e "\n${C_RED}Quá trình đổi mật khẩu thất bại (Hoặc bạn đã hủy thao tác).${C_RESET}\n"
fi

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-ssh-main 1
fi
