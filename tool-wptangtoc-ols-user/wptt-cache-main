#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

clear
if [[ -z "$1" ]]; then
  if [[ -f /etc/wptt-user/wptt-header-menu ]]; then
    . /etc/wptt-user/wptt-header-menu
    header_menu
  fi
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}WPTANGTOC OLS ➜ QUẢN LÝ CACHE${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

options=(
  "Xóa Cache website WordPress"
)

# Render menu items
i=1
for opt in "${options[@]}"; do
  item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$opt")
  clean_text=$(printf "  %3d) %s" "$i" "$opt")
  pad=$((box_inner_width - ${#clean_text}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done

echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-${#options[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  case "$REPLY" in
    1) exec /etc/wptt-user/cache/wptt-xoacache 98 ;;
    0)
      exec /etc/wptt-user/wptangtoc-user 1
      ;;
    *)
      echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập 1 hoặc 0 để thoát.${C_RESET}"
      ;;
  esac
done
