#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-ma-nguon-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ MÃ NGUỒN ➜ Xóa mã nguồn Website${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Xóa mã nguồn"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-ma-nguon-main 1; exit 0; }

WEB_ROOT="/usr/local/lsws/$NAME/html"

if [[ ! -d "$WEB_ROOT" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Thư mục mã nguồn của website $NAME không tồn tại!${C_RESET}"
  sleep 3
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-ma-nguon-main 1
  exit 1
fi

echo ""
if ! wptt_xac_nhan "Bạn có CHẮC CHẮN muốn XÓA SẠCH mã nguồn website này không?" "Thư mục: $WEB_ROOT" "Cảnh báo: Dữ liệu sẽ BỊ XÓA VĨNH VIỄN và không thể khôi phục!" "Đồng ý Xóa trắng" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-ma-nguon-main 1
  exit 0
fi

echo "Xóa mã nguồn website $NAME (User): $(date '+%d-%m-%Y %H:%M')" >>/tmp/wptangtoc-ols.log

_runing "Đang tiến hành xóa sạch mã nguồn (bao gồm file ẩn) của $NAME..."

# Kích hoạt dotglob để dấu '*' bắt được cả file ẩn (như .htaccess, .user.ini)
# shopt -s dotglob
rm -rf "${WEB_ROOT:?}"/.* 2>/dev/null
# Tắt lại dotglob cho an toàn
# shopt -u dotglob

_rundone "Xóa mã nguồn website $NAME thành công"

clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}XÓA MÃ NGUỒN THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website    : ${C_YELLOW}$NAME${C_RESET}"
left_text "Thư mục    : Đã dọn dẹp sạch sẽ $WEB_ROOT"
left_text "Trạng thái : Hiện tại thư mục đã trống (Zero Code)."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu Quản lý Mã nguồn...${C_RESET}"
  read -r _
  exec /etc/wptt-user/wptt-ma-nguon-main 1
fi
