#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == "98" ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-quan-ly-files-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}FILE MANAGER ➜ Xem thông tin Tài khoản${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Xem tài khoản File Manager"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-quan-ly-files-main 1

# ==============================================================================
# KIỂM TRA ĐIỀU KIỆN & TÍNH TOÀN VẸN
# ==============================================================================
. /etc/wptt/vhost/."$NAME".conf 2>/dev/null

FM_PATH="/usr/local/lsws/$NAME/html/quan-ly-files"

if [[ ! -d "$FM_PATH" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Website $NAME chưa được kích hoạt File Manager!${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-quan-ly-files-main 1
fi



# ==============================================================================
# XỬ LÝ SSL & GIẢI MÃ MẬT KHẨU AES-256
# ==============================================================================
if [[ ! -f "/etc/letsencrypt/live/$NAME/cert.pem" && ! -d "/usr/local/lsws/$NAME/ssl" ]]; then
  URL_TRUY_CAP="http://$NAME/quan-ly-files"
else
  URL_TRUY_CAP="https://$NAME/quan-ly-files"
fi

# Ghi log an toàn trong Chroot
echo "Xem thông tin tài khoản filemanager website $NAME (User): $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log

# Giải mã Mật khẩu cấp 2 (Popup HTTP Auth)
pass_cap_2=$(wptt_giai_ma "$password_dang_nhap_quan_ly_file_cap_2" 2>/dev/null)
[[ -z "$pass_cap_2" ]] && pass_cap_2="$password_dang_nhap_quan_ly_file_cap_2"

# Giải mã Mật khẩu File Manager chính
pass_fm=$(wptt_giai_ma "$password_quan_ly_file" 2>/dev/null)
[[ -z "$pass_fm" ]] && pass_fm="$password_quan_ly_file"

# ==============================================================================
# HIỂN THỊ GIAO DIỆN
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}THÔNG TIN FILE MANAGER (ĐÃ GIẢI MÃ)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Đường dẫn    : ${C_CYAN}$URL_TRUY_CAP${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
center_text "${C_YELLOW}LỚP BẢO VỆ 1: XÁC THỰC MÁY CHỦ (POPUP TRÌNH DUYỆT)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Username 1   : $id_dang_nhap_quan_ly_file_cap_2"
left_text "Mật khẩu 1   : ${C_GREEN}$pass_cap_2${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
center_text "${C_YELLOW}LỚP BẢO VỆ 2: ĐĂNG NHẬP ỨNG DỤNG (GIAO DIỆN WEB)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Username 2   : $id_quan_ly_files"
left_text "Mật khẩu 2   : ${C_GREEN}$pass_fm${C_RESET}"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# Chặn màn hình để người dùng kịp copy thông tin
echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu Quản lý...${C_RESET}"
read -r _
exec /etc/wptt-user/wptt-quan-ly-files-main 1
