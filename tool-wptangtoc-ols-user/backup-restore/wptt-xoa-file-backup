#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Xóa File Backup Local${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Xóa file Backup"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

DIR_BACKUP="/usr/local/lsws/$NAME/backup-website"

# ==============================================================================
# VÒNG LẶP CHÍNH (TỰ ĐỘNG REFRESH DANH SÁCH SAU KHI XÓA)
# ==============================================================================
while true; do
  clear
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}DỌN DẸP FILE BACKUP ➜ $NAME${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  if [ ! "$(ls -A "$DIR_BACKUP" 2>/dev/null)" ]; then
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}Thư mục trống. Không có file backup nào!${C_RESET}$(printf '%*s' $((box_inner_width - 42)) "")${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    sleep 3
    exec /etc/wptt-user/wptt-backup-restore-main 1
  fi

  # Quét và phân loại file
  selects=()
  for entry in $(ls -At "$DIR_BACKUP" 2>/dev/null); do
    selects+=("$entry")
  done
  
  count_db=$(ls -At "$DIR_BACKUP" 2>/dev/null | grep -cE '\.sql$|\.sql\.gz$|\.sql\.zst$')
  count_src=$(ls -At "$DIR_BACKUP" 2>/dev/null | grep -cE '\.zip$|\.tar\.gz$|\.tar\.zst$')
  
  before_delete=$(du -hs "$DIR_BACKUP" 2>/dev/null | awk '{print $1}')

  left_text "Số file Database : $count_db"
  left_text "Số file Mã nguồn : $count_src"
  left_text "Đang lưu trữ tại : $DIR_BACKUP/"
  left_text "Tổng dung lượng  : ${C_RED}${before_delete}${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  i=1
  for val in "${selects[@]}"; do
    fsize=$(du -sh "$DIR_BACKUP/$val" 2>/dev/null | cut -f1)
    item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_GREEN}%-7s${C_RESET}] ${C_BOLD_WHITE}%s${C_RESET}" "$i" "${fsize:-???}" "$val")
    clean_row=$(printf "  %3d) [%-7s] %s" "$i" "${fsize:-???}" "$val")
    pad=$((box_inner_width - ${#clean_row}))
    [[ $pad -lt 0 ]] && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  echo -en "${C_CYAN}Nhập số thứ tự file cần XÓA (1-${#selects[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  if [[ "$REPLY" == "0" || -z "$REPLY" ]]; then
    break # Thoát vòng lặp
  fi

  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
    idx=$((REPLY - 1))
    file_to_del="${selects[$idx]}"
    duong_dan_thu_muc="$DIR_BACKUP/$file_to_del"

    if wptt_xac_nhan "Bạn có CHẮC CHẮN muốn XÓA VĨNH VIỄN file này không?" "File: ${C_YELLOW}$file_to_del${C_RESET}" "Hành động này không thể hoàn tác!" "Đồng ý Xóa" "Giữ lại"; then
      
      # Ghi log an toàn trong Chroot
      echo "Xoá file backup website $NAME ($duong_dan_thu_muc): $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log
      
      rm -f "${duong_dan_thu_muc:?}"
      after_delete=$(du -hs "$DIR_BACKUP" 2>/dev/null | awk '{print $1}')
      
      clear
      echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}XÓA FILE THÀNH CÔNG${C_RESET}"
      echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "File đã xóa : $file_to_del"
      left_text "Dung lượng  : Giảm từ ${C_RED}$before_delete${C_RESET} xuống còn ${C_GREEN}$after_delete${C_RESET}"
      echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
      sleep 2
    fi
  else
    echo -e "${C_RED}Lựa chọn không hợp lệ!${C_RESET}"
    sleep 1
  fi
done

# ==============================================================================
# CẢNH BÁO FULL DISK BẰNG KILOBYTES (CHUẨN XÁC NHẤT)
# ==============================================================================
free_space_kb=$(df -k / | awk 'NR==2 {print $4}' 2>/dev/null)
# Nếu trống dưới 2GB (2097152 KB) thì cảnh báo
if [[ -n "$free_space_kb" ]] && (( free_space_kb < 2097152 )); then
  clear
  echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}CẢNH BÁO KHẨN CẤP: SẮP HẾT Ổ CỨNG (FULL DISK)${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Dung lượng ổ cứng máy chủ hiện tại CÒN TRỐNG DƯỚI 2GB."
  left_text "Tình trạng Disk: $(df -h / | awk 'NR==2 {printf "%s / %s (Sử dụng %s)\n", $3, $2, $5}')"
  left_text "Hãy xóa bớt file rác/backup cũ để tránh lỗi tràn bộ nhớ làm sập Web!"
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  echo -en "${C_CYAN}Nhấn [Enter] để tiếp tục...${C_RESET}"
  read -r _
fi

exec /etc/wptt-user/wptt-backup-restore-main 1
