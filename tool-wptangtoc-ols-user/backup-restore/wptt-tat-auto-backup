#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Gỡ bỏ Thiết lập Auto Backup${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Gỡ bỏ Auto Backup"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

# ==============================================================================
# KIỂM TRA TRẠNG THÁI CÀI ĐẶT
# ==============================================================================
if [[ ! -f "$HOME/wptt/$NAME-auto-backup-user" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Website $NAME chưa được thiết lập Tự động sao lưu!${C_RESET}"
  echo "Không có cấu hình nào để gỡ bỏ."
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

echo ""
if ! wptt_xac_nhan "Bạn có CHẮC CHẮN muốn gỡ bỏ lịch Tự động sao lưu của website này?" "Hành động này sẽ xóa Cron Job hẹn giờ đã thiết lập trước đó." "Website sẽ không tự động backup nữa!" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# ==============================================================================
# THỰC THI GỠ BỎ CRON VÀ FILE KỊCH BẢN
# ==============================================================================
_runing "Đang gỡ bỏ cấu hình Auto Backup của website $NAME..."

# Lọc bỏ dòng cron job của website hiện tại và nạp lại vào crontab
crontab -l 2>/dev/null | grep -v "$NAME-auto-backup-user" | crontab -

# Xóa file bash kịch bản
rm -f "$HOME/wptt/$NAME-auto-backup-user"

_rundone "Gỡ bỏ cấu hình Auto Backup thành công"

# ==============================================================================
# BẢNG TÓM TẮT
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}GỠ BỎ AUTO BACKUP THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website    : ${C_YELLOW}$NAME${C_RESET}"
left_text "Trạng thái : Đã xóa hoàn toàn lịch chạy tự động trong hệ thống Crontab."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi
