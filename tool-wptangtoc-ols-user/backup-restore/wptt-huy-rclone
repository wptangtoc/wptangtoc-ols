#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Gỡ bỏ Thiết lập Rclone Cloud${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI KẾT NỐI
# ==============================================================================
duong_dan_rclone="$HOME/.config/rclone/rclone.conf"

if ! grep -q 'wptangtoc' "$duong_dan_rclone" 2>/dev/null; then
  echo -e "\n${C_YELLOW}Hệ thống chưa được liên kết với Lưu trữ đám mây nào!${C_RESET}"
  echo "Không có cấu hình nào để gỡ bỏ."
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# Nhận diện thông minh nền tảng Cloud đang sử dụng
raw_type=$(grep -A 1 '\[wptangtoc\]' "$duong_dan_rclone" 2>/dev/null | grep 'type' | awk -F '=' '{print $2}' | tr -d ' ')
case "$raw_type" in
  drive)    cloud_service="Google Drive" ;;
  onedrive) cloud_service="Microsoft OneDrive" ;;
  s3)       cloud_service="S3 Storage" ;;
  *)        cloud_service="Cloud Khác ($raw_type)" ;;
esac

echo ""
if ! wptt_xac_nhan "Bạn có CHẮC CHẮN muốn gỡ bỏ liên kết Đám mây hiện tại không?" "Đang kết nối: ${C_YELLOW}$cloud_service${C_RESET}" "Các tính năng Tự động Upload/Xóa Cloud sẽ ngừng hoạt động!" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# ==============================================================================
# THỰC THI GỠ BỎ KẾT NỐI
# ==============================================================================
_runing "Đang gỡ bỏ kết nối $cloud_service..."

# Ghi log an toàn trong Chroot
echo "Hủy đăng ký rclone lưu trữ đám mây (User): $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log

# Xóa sạch file cấu hình Token
rm -f "$duong_dan_rclone"

_rundone "Gỡ bỏ cấu hình $cloud_service thành công"

# ==============================================================================
# BẢNG TÓM TẮT
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}GỠ BỎ KẾT NỐI CLOUD THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Nền tảng    : $cloud_service"
left_text "Trạng thái  : Đã xóa hoàn toàn thông tin xác thực (Token) trên máy chủ."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi
