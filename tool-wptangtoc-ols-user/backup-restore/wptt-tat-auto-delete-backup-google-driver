#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Gỡ bỏ tự động dọn dẹp Cloud${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI KẾT NỐI CLOUD
# ==============================================================================
if ! grep -rnw "$HOME/.config/rclone/rclone.conf" -e "wptangtoc" >/dev/null 2>&1; then
  echo -e "${C_RED}❌ Hệ thống của bạn chưa được liên kết với Lưu trữ đám mây nào!${C_RESET}"
  echo "Không có cấu hình nào để gỡ bỏ."
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="OneDrive"
elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="S3 Storage"
else
  cloud_service="Google Drive"
fi

. /etc/wptt-user/tenmien
lua_chon_NAME "Gỡ bỏ Tự động xóa Cloud"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

# ==============================================================================
# KIỂM TRA TỒN TẠI CRON JOB CỦA USER
# ==============================================================================
SCRIPT_PATH="$HOME/wptt/$NAME-auto-delete-cloud"

if [[ ! -f "$SCRIPT_PATH" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Website $NAME chưa được thiết lập Tự động xóa file Cloud!${C_RESET}"
  echo "Không có cấu hình nào để gỡ bỏ."
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

echo ""
if ! wptt_xac_nhan "Bạn có CHẮC CHẮN muốn gỡ bỏ lịch Tự động dọn dẹp Đám mây?" "Nền tảng: ${C_YELLOW}$cloud_service${C_RESET}" "Các file backup cũ trên Cloud sẽ KHÔNG CÒN BỊ XÓA nữa!" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# ==============================================================================
# THỰC THI GỠ BỎ CRON VÀ FILE KỊCH BẢN
# ==============================================================================
_runing "Đang gỡ bỏ cấu hình Tự động xóa Cloud của website $NAME..."

# Lọc bỏ dòng cron job của website hiện tại và nạp lại vào crontab
crontab -l 2>/dev/null | grep -v "$NAME-auto-delete-cloud" | crontab -

# Xóa file bash kịch bản trong thư mục wptt của User
rm -f "${SCRIPT_PATH:?}"

_rundone "Gỡ bỏ cấu hình thành công"

# ==============================================================================
# BẢNG TÓM TẮT
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}GỠ BỎ TỰ ĐỘNG DỌN DẸP CLOUD THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website    : ${C_YELLOW}$NAME${C_RESET}"
left_text "Cloud      : $cloud_service"
left_text "Trạng thái : Đã xóa hoàn toàn lịch dọn dẹp trong hệ thống Crontab."
left_text "Ghi chú    : Từ giờ, dữ liệu trên Cloud sẽ được lưu trữ vô thời hạn."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r _
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi
