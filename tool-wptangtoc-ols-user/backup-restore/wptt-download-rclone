#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Tải file Backup từ Cloud${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI KẾT NỐI CLOUD
# ==============================================================================
if ! grep -rnw "$HOME/.config/rclone/rclone.conf" -e "wptangtoc" >/dev/null 2>&1; then
  echo -e "${C_RED}❌ Hệ thống của bạn chưa được liên kết với Lưu trữ đám mây nào!${C_RESET}"
  echo "Vui lòng thiết lập Rclone (Google Drive / OneDrive) trước khi sử dụng."
  sleep 4
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="OneDrive"
elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="S3 Storage"
else
  cloud_service="Google Drive"
fi

. /etc/wptt-user/tenmien
lua_chon_NAME "Tải file từ Cloud"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

DIR_BACKUP="/usr/local/lsws/$NAME/backup-website"
mkdir -p "$DIR_BACKUP"

# Xác định tên thư mục Cloud
CLOUD_DIR="wptangtoc_ols_backup"
if [[ "$cloud_service" == "S3 Storage" ]]; then
  CLOUD_DIR="wptangtoc-ols-backup"
elif rclone lsd wptangtoc: 2>/dev/null | grep -q 'wptangtoc-ols-backup'; then
  CLOUD_DIR="wptangtoc-ols-backup"
fi

# ==============================================================================
# VÒNG LẶP CHÍNH (TỰ ĐỘNG REFRESH DANH SÁCH CLOUD)
# ==============================================================================
while true; do
  clear
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}TẢI BẢN SAO LƯU ➜ $NAME${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  
  _runing "Đang kết nối để lấy danh sách file từ $cloud_service..."
  
  # Fetch danh sách file từ Rclone
  x=$(rclone lsf "wptangtoc:$CLOUD_DIR/$NAME" 2>/dev/null)
  
  # Xóa dòng Loading
  echo -ne "\033[1A\r\033[K"
  
  selects=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && selects+=("$line")
  done <<< "$x"

  if [[ ${#selects[@]} -eq 0 || -z "${selects[0]}" ]]; then
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}Không tìm thấy file backup nào trên $cloud_service!${C_RESET}$(printf '%*s' $((box_inner_width - 55)) "")${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    sleep 4
    exec /etc/wptt-user/wptt-backup-restore-main 1
  fi

  left_text "Nguồn Cloud      : $cloud_service"
  left_text "Thư mục đích     : $DIR_BACKUP/"
  left_text "Tổng số file có  : ${#selects[@]} file"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  i=1
  for val in "${selects[@]}"; do
    item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$val")
    clean_row=$(printf "  %3d) %s" "$i" "$val")
    pad=$((box_inner_width - ${#clean_row}))
    [[ $pad -lt 0 ]] && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  echo -en "${C_CYAN}Nhập số thứ tự file cần TẢI VỀ (1-${#selects[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  if [[ "$REPLY" == "0" || -z "$REPLY" ]]; then
    break # Thoát vòng lặp
  fi

  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
    idx=$((REPLY - 1))
    file_to_down="${selects[$idx]}"

    if wptt_xac_nhan "Bạn có muốn tải file ${C_YELLOW}$file_to_down${C_RESET} về máy chủ không?" "Dung lượng Cloud lớn có thể sẽ mất vài phút để hoàn thành." "" "Đồng ý Tải về" "Chọn file khác"; then
      
      # Ghi log an toàn trong Chroot
      echo "Tải file $file_to_down từ $cloud_service về website $NAME (User): $(date '+%d-%m-%Y %H:%M')" >> /tmp/wptangtoc-ols.log
      
      echo ""
      rm -f "$DIR_BACKUP/$file_to_down" 2>/dev/null
      
      # Dùng Rclone Stats để hiện tiến trình (chống giật lag)
      _runing "Đang kéo dữ liệu từ $cloud_service xuống Server..."
      rclone copy "wptangtoc:$CLOUD_DIR/$NAME/$file_to_down" "$DIR_BACKUP/" --stats-one-line -q
      
      if [[ -f "$DIR_BACKUP/$file_to_down" ]]; then
        _rundone "Tải file $file_to_down hoàn tất"
        fsize=$(du -sh "$DIR_BACKUP/$file_to_down" 2>/dev/null | awk '{print $1}')
        
        clear
        echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
        center_text "${C_BOLD_WHITE}TẢI FILE TỪ CLOUD THÀNH CÔNG${C_RESET}"
        echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        left_text "File đã tải : $file_to_down"
        left_text "Dung lượng  : $fsize"
        left_text "Lưu trữ tại : $DIR_BACKUP/"
        echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
      else
        _runloi "Lỗi kết nối: Quá trình tải file từ $cloud_service thất bại!"
      fi
      
      echo -en "${C_CYAN}Nhấn [Enter] để tải thêm file khác (hoặc Thoát)...${C_RESET}"
      read -r
    fi
  else
    echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
    sleep 1
  fi
done

exec /etc/wptt-user/wptt-backup-restore-main 1
