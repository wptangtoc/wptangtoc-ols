#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Thiết lập Tự động dọn dẹp Cloud${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI KẾT NỐI CLOUD
# ==============================================================================
if ! grep -rnw "$HOME/.config/rclone/rclone.conf" -e "wptangtoc" >/dev/null 2>&1; then
  echo -e "${C_RED}❌ Hệ thống của bạn chưa được liên kết với Lưu trữ đám mây nào!${C_RESET}"
  echo "Vui lòng thiết lập Rclone (Google Drive / OneDrive) trước khi sử dụng."
  sleep 4
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="OneDrive"
elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
  cloud_service="S3 Storage"
else
  cloud_service="Google Drive"
fi

. /etc/wptt-user/tenmien
lua_chon_NAME "Tự động xóa Backup Cloud"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

# ==============================================================================
# KIỂM TRA TRẠNG THÁI ĐÃ CÀI ĐẶT
# ==============================================================================
# Thay vì kiểm tra ở /etc/cron.d (quyền Root), ta kiểm tra trong thư mục riêng của User
SCRIPT_PATH="$HOME/wptt/$NAME-auto-delete-cloud"

if [[ -f "$SCRIPT_PATH" ]]; then
  echo -e "\n${C_YELLOW}⚠️ Website $NAME đã được kích hoạt tính năng tự động xóa file Cloud trước đó!${C_RESET}"
  echo "Nếu muốn thay đổi số ngày, tính năng này sẽ ghi đè lên cấu hình cũ."
  sleep 2
fi

# ==============================================================================
# CẤU HÌNH SỐ NGÀY LƯU TRỮ
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CẤU HÌNH THỜI GIAN LƯU TRỮ (RETENTION)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Bạn muốn giữ lại file backup trên $cloud_service trong tối đa bao nhiêu ngày?"
left_text "Các file cũ hơn số ngày này sẽ BỊ TỰ ĐỘNG XÓA VĨNH VIỄN."
left_text "Ví dụ: Nhập 15 (Giữ file trong 15 ngày, ngày thứ 16 sẽ bị xóa)."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -en "${C_CYAN}Nhập số ngày lưu trữ (Số nguyên dương) [0=Thoát]: ${C_RESET}"
read -r ngay

if [[ "$ngay" == "0" || -z "$ngay" ]]; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 1
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

if [[ ! "$ngay" =~ ^[0-9]+$ ]] || (( ngay <= 0 )); then
  echo -e "\n${C_RED}❌ Lỗi: Bạn phải nhập một số nguyên dương hợp lệ (VD: 7, 15, 30).${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

echo ""
if ! wptt_xac_nhan "Xác nhận LƯU THIẾT LẬP tự động dọn dẹp Đám mây?" "Thời gian giữ file: ${C_YELLOW}$ngay ngày${C_RESET}" "Lịch trình: Lúc 03:00 Sáng hàng ngày." "Đồng ý Kích hoạt" "Hủy bỏ"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# ==============================================================================
# THỰC THI GHI CẤU HÌNH VÀO CHROOT
# ==============================================================================
_runing "Đang thiết lập Cron xóa file backup tự động trên $cloud_service..."

mkdir -p "$HOME/wptt"

# Ghi file bash kịch bản (Kế thừa gọi sang file core gốc)
cat >"$SCRIPT_PATH" <<END
#!/bin/bash
. /etc/wptt-user/backup-restore/wptt-auto-delete-google-driver-backup $NAME $ngay
END

chmod 500 "$SCRIPT_PATH"

# Ghi đè vào Fake Crontab của User Chroot
(crontab -l 2>/dev/null | grep -v "$NAME-auto-delete-cloud"; echo "0 3 * * * $SCRIPT_PATH >/dev/null 2>&1") | crontab -

_rundone "Thiết lập cấu hình tự động dọn dẹp Cloud thành công"

# ==============================================================================
# BẢNG TÓM TẮT THÀNH CÔNG
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}KÍCH HOẠT TỰ ĐỘNG DỌN DẸP CLOUD THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website        : ${C_YELLOW}$NAME${C_RESET}"
left_text "Nền tảng Cloud : $cloud_service"
left_text "Thời gian lưu  : Tối đa ${C_YELLOW}$ngay ngày${C_RESET}"
left_text "Lịch trình xóa : Vào lúc 03:00 Sáng mỗi ngày."
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Ghi chú: File backup nào trên thư mục wptangtoc_ols_backup/$NAME"
left_text "có độ tuổi cũ hơn $ngay ngày sẽ tự động bị xóa đi để giải phóng dung lượng."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "$1" == "98" ]]; then
  echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi
