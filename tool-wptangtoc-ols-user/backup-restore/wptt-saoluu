#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$backup_restore ➜ $sao_luu_website${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME=$1
ggdriver=$2
ggdriver2=$3

[[ "$NAME" == "98" ]] && NAME=""


if [[ -z "$NAME" ]]; then
  . /etc/wptt-user/tenmien
  lua_chon_NAME "$sao_luu_website"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1; exit 0; }



mkdir -p "/usr/local/lsws/$NAME/backup-website"
pathcheck="/usr/local/lsws/$NAME/backup-website"
before_optimize=$(du -hs "$pathcheck" 2>/dev/null | awk '{print $1}')
times=$(date +%Hgio\_%d\_%m\_%Y)

. /etc/."$NAME".conf 2>/dev/null
cd /usr/local/lsws/"$NAME"/html || exit 1

_runing "$sao_luu_database website $NAME"

# ==============================================================================
# BỘ KHIÊN CHỐNG LOCAL SQL INJECTION & GIẢI MÃ AES
# ==============================================================================
wptt_abort_db_injection() {
    _runloi "$1"
    sleep 2
    [[ "$2" == "98" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
    flock -u 200; exec 200>&-; rm -f "${LOCK_FILE:?}" 2>/dev/null
    exit 1
}

# [[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
# [[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"

password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

TEMP_CNF=$(mktemp -p "/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF"
cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
trap "rm -f ${TEMP_CNF:?}" EXIT

# UX Progress Bar cho Database
RAW_SIZE=$(mariadb --defaults-extra-file="$TEMP_CNF" -N -e "SELECT SUM(data_length) FROM information_schema.TABLES WHERE table_schema='$DB_Name_web'")
if [[ -z "$RAW_SIZE" || "$RAW_SIZE" == "NULL" ]]; then RAW_SIZE=1024; fi
ADJUSTED_SIZE=$((RAW_SIZE * 95 / 100))

if command -v pv &>/dev/null; then
  PV_CMD="pv -s $ADJUSTED_SIZE -N 'Exporting' -p -t -e -w 80"
else
  PV_CMD="cat"
fi

echo ""
# THỰC THI BACKUP DATABASE
if [[ "$sql_gz" = '1' ]]; then
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | gzip >"/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.gz"
elif [[ "$sql_gz" = '2' ]]; then
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | zstd >"/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.zst"
else
  mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" >"/usr/local/lsws/$NAME/backup-website/$NAME$times.sql"
fi

echo -ne "\033[1A\r\033[K"
echo -ne "\033[1A\r\033[K"
rm -rf "${TEMP_CNF:?}"

# KIỂM TRA LỖI DATABASE
unset check_file_error_database tuanxacnhandb
if [[ "$sql_gz" = '1' ]]; then
  check_file_error_database=$(du -c "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.gz" 2>/dev/null | awk '{print $1}' | sed '1d')
  if ((${check_file_error_database:-0} < 3)); then rm -f "/usr/local/lsws/${NAME:?}/backup-website/${NAME:?}${times:?}.sql.gz"; fi
elif [[ "$sql_gz" = '2' ]]; then
  check_file_error_database=$(du -c "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.zst" 2>/dev/null | awk '{print $1}' | sed '1d')
  if ((${check_file_error_database:-0} < 3)); then rm -f "/usr/local/lsws/${NAME:?}/backup-website/${NAME:?}${times:?}.sql.zst"; fi
else
  check_file_error_database=$(du -c "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql" 2>/dev/null | awk '{print $1}' | sed '1d')
  if ((${check_file_error_database:-0} < 3)); then rm -f "/usr/local/lsws/${NAME:?}/backup-website/${NAME:?}${times:?}.sql"; fi
fi

if [[ -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql" || -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.gz" || -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.zst" ]]; then
  chmod 600 "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql"* 2>/dev/null
  _rundone "$sao_luu_database website $NAME"
  tuanxacnhandb="1"
else
  _runloi "$sao_luu_database website $NAME"
  tuanxacnhandb="0"
fi

# ==============================================================================
# SAO LƯU MÃ NGUỒN (HỖ TRỢ ZIP, TAR.GZ, TAR.ZST)
# ==============================================================================
_runing "$sao_luu_ma_nguon website $NAME"
echo ''

if [[ "$dinh_dang_nen_ma_nguon" = '1' ]]; then 
  rm -f "/usr/local/lsws/${NAME:?}/backup-website/${NAME:?}${times:?}.tar.zst" 2>/dev/null
  cd "/usr/local/lsws/$NAME/html" && tar -c \
    --exclude="./wp-content/ai1wm-backups" \
    --exclude="./wp-content/cache" \
    --exclude="./wp-content/updraft" \
    --exclude="./error_log" \
    --exclude="./wp-content/debug.log" \
    --exclude="./wp-content/uploads/backupbuddy_backups" \
    --exclude="./wp-content/backups-dup-pro" \
    --exclude="./wp-content/backups-dup-lite" \
    . | zstd -3 -o "/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.zst"
elif [[ "$dinh_dang_nen_ma_nguon" = '2' ]]; then
  rm -f "/usr/local/lsws/${NAME:?}/backup-website/${NAME:?}${times:?}.tar.gz" 2>/dev/null
  cd "/usr/local/lsws/$NAME/html" && tar -c \
    --exclude="./wp-content/ai1wm-backups" \
    --exclude="./wp-content/cache" \
    --exclude="./wp-content/updraft" \
    --exclude="./error_log" \
    --exclude="./wp-content/debug.log" \
    --exclude="./wp-content/uploads/backupbuddy_backups" \
    --exclude="./wp-content/backups-dup-pro" \
    --exclude="./wp-content/backups-dup-lite" \
    . | gzip >"/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.gz"
else
  cd "/usr/local/lsws/$NAME/html" && zip -r "/usr/local/lsws/$NAME/backup-website/$NAME$times.zip" * -x "wp-content/ai1wm-backups/*" -x "wp-content/cache/*" -x "wp-content/updraft/*" -x "error_log" -x "wp-content/debug.log" -x "wp-content/uploads/backupbuddy_backups/*" -x "wp-content/backups-dup-pro/*" -x "wp-content/backups-dup-lite/*"
fi

unset tuanxacnhan
if [[ -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.zip" || -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.zst" || -f "/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.gz" ]]; then
  _rundone "$sao_luu_ma_nguon website $NAME"
  chmod 600 "/usr/local/lsws/$NAME/backup-website/$NAME$times"* 2>/dev/null
  tuanxacnhan="1"
else
  _runloi "$sao_luu_ma_nguon website $NAME"
  tuanxacnhan="0"
fi

# ==============================================================================
# XỬ LÝ RCLONE UPLOAD (HỖ TRỢ ĐIỀU TỐC THÔNG MINH)
# ==============================================================================
checkdathietlap=$(grep -rnw "$HOME/.config/rclone/rclone.conf" -e "wptangtoc" >>/dev/null 2>&1 && echo 1)

if [[ -n "$checkdathietlap" ]]; then
  if [[ "$ggdriver" != "1998" ]]; then
    if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
      drive_name="OneDrive"
    elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
      drive_name="S3 Storage"
    else
      drive_name="Google Drive"
    fi

    echo ""
    if wptt_xac_nhan "Bạn có muốn upload file backup lên Lưu trữ Đám mây ($drive_name) không?" "" "" "Đồng ý Upload" "Không cần"; then
      uploads="y"
    else
      uploads="n"
    fi
  fi
  
  if [[ "$uploads" == "y" || "$ggdriver" == "1998" ]]; then
    _runing "Đang đẩy file backup lên $drive_name..."
    truoc_khi_backup=$(rclone size wptangtoc: 2>/dev/null --exclude "Personal Vault/**" --exclude "Kho lưu trữ cá nhân/**" | grep 'size' | cut -f2 -d ':' | cut -f1 -d '(' | head -1)

    CLOUD_DIR="wptangtoc_ols_backup"
    if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
      CLOUD_DIR="wptangtoc-ols-backup"
    elif rclone lsd wptangtoc: 2>/dev/null | grep -q 'wptangtoc-ols-backup'; then
      CLOUD_DIR="wptangtoc-ols-backup"
    fi

    TOTAL_CORES=$(nproc 2>/dev/null || echo 1)
    TOTAL_RAM_MB=$(free -m | awk '/^Mem:/{print $2}')

    if (( TOTAL_CORES <= 2 )) || (( TOTAL_RAM_MB <= 2048 )); then
      OPT_TRANSFERS=2
      OPT_CHUNK="32M"
    else
      OPT_TRANSFERS=4
      OPT_CHUNK="64M"
    fi

    RCLONE_OPTS=(
      "--transfers=$OPT_TRANSFERS"
      "--checkers=$OPT_TRANSFERS"
      "--drive-chunk-size=$OPT_CHUNK"
      "--s3-upload-concurrency=$OPT_TRANSFERS"
      "--contimeout" "60s"
      "--timeout" "300s"
      "--retries" "3"
      "--log-level" "ERROR"
    )

    function wptt_upload_ux() {
      local src_file="$1"
      local dest_dir="$2"
      local file_type="$3"
      local fname=$(basename "$src_file")

      if [[ "$ggdriver" == "1998" ]]; then
        rclone copy "$src_file" "$dest_dir" "${RCLONE_OPTS[@]}" >/dev/null 2>&1
      else
        if command -v pv &>/dev/null; then
          local fsize=$(du -b "$src_file" | cut -f1)
          pv -s "$fsize" -N "Upload $file_type" -p -t -e -r -b -w 90 "$src_file" | rclone rcat "$dest_dir/$fname" "${RCLONE_OPTS[@]}"
          echo -en "\033[1A\033[2K\r"
        else
          rclone copy "$src_file" "$dest_dir" "${RCLONE_OPTS[@]}" --progress --stats-one-line
          echo -en "\033[1A\033[2K\r"
        fi
      fi
    }

    # Upload Mã Nguồn
    if [[ "$dinh_dang_nen_ma_nguon" == '1' ]]; then
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.zst" "wptangtoc:$CLOUD_DIR/$NAME" "Mã Nguồn"
    elif [[ "$dinh_dang_nen_ma_nguon" == '2' ]]; then
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.tar.gz" "wptangtoc:$CLOUD_DIR/$NAME" "Mã Nguồn"
    else
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.zip" "wptangtoc:$CLOUD_DIR/$NAME" "Mã Nguồn"
    fi

    # Upload Database
    if [[ "$sql_gz" == '1' ]]; then
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.gz" "wptangtoc:$CLOUD_DIR/$NAME" "Database"
    elif [[ "$sql_gz" == '2' ]]; then
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql.zst" "wptangtoc:$CLOUD_DIR/$NAME" "Database"
    else
      wptt_upload_ux "/usr/local/lsws/$NAME/backup-website/$NAME$times.sql" "wptangtoc:$CLOUD_DIR/$NAME" "Database"
    fi

    kiem_tra_xem_file_da_uploads=$(rclone lsf wptangtoc:$CLOUD_DIR/"$NAME" 2>/dev/null | grep "$NAME$times")
    if [[ -n "$kiem_tra_xem_file_da_uploads" ]]; then
      _rundone "Uploads thành công lên $drive_name"
    else
      _runloi "Uploads lên $drive_name thất bại"
    fi

    if [[ "$ggdriver2" != "1998" && "$ggdriver2" != "12345" && -n "$kiem_tra_xem_file_da_uploads" ]]; then
      echo ""
      if wptt_xac_nhan "Bạn có muốn XÓA file backup tại máy chủ (Local) để trống ổ cứng không?" "" "" "Có (Xóa Local)" "Giữ lại Local"; then
        clearfile="y"
      else
        clearfile="n"
      fi
    fi

    if [[ "$clearfile" == "y" || "$ggdriver2" == "1998" ]]; then
      _runing "Đang xóa file backup tại Local..."
      rm -f /usr/local/lsws/"${NAME:?}"/backup-website/"${NAME:?}""${times:?}".tar*
      rm -f /usr/local/lsws/"${NAME:?}"/backup-website/"${NAME:?}""${times:?}".zip
      rm -f /usr/local/lsws/"${NAME:?}"/backup-website/"${NAME:?}""${times:?}".sql*
      _rundone "Đã dọn dẹp sạch sẽ ổ cứng Local"
    fi
  fi
fi

# ==============================================================================
# BẢNG TÓM TẮT THÀNH CÔNG
# ==============================================================================
clear
if [[ "$tuanxacnhandb" == "1" && "$tuanxacnhan" == "1" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "$sao_luu_website $NAME thành công"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  if [[ "$clearfile" != "y" && "$ggdriver2" != "1998" ]]; then 
    left_text "Thư mục backup  : /usr/local/lsws/$NAME/backup-website"
    left_text "Thư mục website : /usr/local/lsws/$NAME/html"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    left_text "Dung lượng thư mục backup TRƯỚC : ${before_optimize:-0}"
    left_text "Dung lượng thư mục backup SAU   : $(du -hs "$pathcheck" 2>/dev/null | awk '{print $1}')"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    left_text "Trạng thái Local: Đã xóa bản sao lưu tại máy chủ để tiết kiệm dung lượng."
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  fi
else
  echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  left_text "$sao_luu_website $NAME $khong_thanh_cong"
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

if [[ "$uploads" == "y" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  left_text "Dung lượng $drive_name TRƯỚC khi tải lên : $truoc_khi_backup"
  left_text "Dung lượng $drive_name SAU khi tải lên   : $(rclone size wptangtoc: 2>/dev/null --exclude "Personal Vault/**" --exclude "Kho lưu trữ cá nhân/**"| grep 'size' | cut -f2 -d ':' | cut -f1 -d '(' | head -1)"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi


[[ "$1" == "98" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
