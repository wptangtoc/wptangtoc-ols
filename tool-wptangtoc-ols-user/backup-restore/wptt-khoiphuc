#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$backup_restore ➜ $khoi_phuc_website${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  . /etc/wptt-user/tenmien
  lua_chon_NAME "$khoi_phuc_website"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

. /etc/."$NAME".conf 2>/dev/null

# ==============================================================================
# 1. CHỌN BẢN SAO LƯU MÃ NGUỒN (SOURCE CODE)
# ==============================================================================
if [ ! "$(ls -A /usr/local/lsws/"$NAME"/backup-website/ 2>/dev/null)" ]; then
  echo -e "\n${C_YELLOW}⚠️ $khong_co_file_backup_nao_ton_tai${C_RESET}"
  echo "Vui lòng tải file backup của bạn lên thư mục: /usr/local/lsws/$NAME/backup-website/"
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

selects_code=()
for entry in $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep -E '\.zip$|\.tar\.gz$|\.tar\.zst$' | grep -v -- '-wptt-luy-tien'); do
  selects_code+=("$entry")
done

if [[ ${#selects_code[@]} -eq 0 ]]; then
  echo -e "\n${C_RED}❌ Không có file backup Mã Nguồn (.zip, .tar.gz, .tar.zst) nào hợp lệ!${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHỌN MỐC THỜI GIAN KHÔI PHỤC (MÃ NGUỒN)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

i=1
for val in "${selects_code[@]}"; do
  fsize=$(du -sh "/usr/local/lsws/$NAME/backup-website/$val" 2>/dev/null | cut -f1)
  item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_GREEN}%-7s${C_RESET}] ${C_BOLD_WHITE}%s${C_RESET}" "$i" "${fsize:-???}" "$val")
  clean_row=$(printf "  %3d) [%-7s] %s" "$i" "${fsize:-???}" "$val")
  pad=$((box_inner_width - ${#clean_row}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập số thứ tự file Mã nguồn cần khôi phục (1-${#selects_code[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY
  [[ "$REPLY" == "0" || -z "$REPLY" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects_code[@]} ]; then
    idx=$((REPLY - 1))
    file="${selects_code[$idx]}"
    break
  else
    echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
  fi
done

duong_dan_thu_muc="/usr/local/lsws/$NAME/backup-website/$file"

# ==============================================================================
# 2. CHỌN BẢN SAO LƯU CƠ SỞ DỮ LIỆU (DATABASE)
# ==============================================================================
selects_db=()
for entry in $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep -E '\.sql$|\.sql\.gz$|\.sql\.zst$'); do
  selects_db+=("$entry")
done

if [[ ${#selects_db[@]} -eq 0 ]]; then
  echo -e "\n${C_RED}❌ Không có file backup Database (.sql, .gz, .zst) nào tồn tại.${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHỌN MỐC THỜI GIAN KHÔI PHỤC (DATABASE)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

i=1
for val in "${selects_db[@]}"; do
  fsize=$(du -sh "/usr/local/lsws/$NAME/backup-website/$val" 2>/dev/null | cut -f1)
  item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_GREEN}%-7s${C_RESET}] ${C_BOLD_WHITE}%s${C_RESET}" "$i" "${fsize:-???}" "$val")
  clean_row=$(printf "  %3d) [%-7s] %s" "$i" "${fsize:-???}" "$val")
  pad=$((box_inner_width - ${#clean_row}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập số thứ tự file Database cần khôi phục (1-${#selects_db[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY
  [[ "$REPLY" == "0" || -z "$REPLY" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects_db[@]} ]; then
    idx=$((REPLY - 1))
    filesql="${selects_db[$idx]}"
    break
  else
    echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
  fi
done

duong_dan_thu_muc_sql="/usr/local/lsws/$NAME/backup-website/$filesql"

check_file_error=$(du -c "$duong_dan_thu_muc_sql" 2>/dev/null | awk '{print $1}' | sed '1d')
if ((${check_file_error:-0} < 3)); then
  echo -e "\n${C_RED}❌ Lỗi: File $filesql quá nhỏ (Dưới 3KB), có thể bị lỗi corrupt!${C_RESET}"
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

clear
echo "Khôi phục website $NAME: $(date '+%d-%m-%Y %H:%M')" >>/tmp/wptangtoc-ols.log

# ==============================================================================
# KHÔI PHỤC DATABASE
# ==============================================================================
echo ""
_runing "Đang Dọn dẹp & Tái tạo Database hiện tại..."

wptt_abort_db_injection() {
    _runloi "$1"
    sleep 2
    [[ "$2" == "98" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
    exit 1
}

[[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
[[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"

password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

TEMP_CNF=$(mktemp -p "/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF"
cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4
EOF

mariadb --defaults-extra-file="$TEMP_CNF" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_Name_web}\`;"
mariadb --defaults-extra-file="$TEMP_CNF" --ssl-verify-server-cert=false -e "CREATE DATABASE IF NOT EXISTS \`${DB_Name_web}\`;"
_rundone "Dọn dẹp & Tái tạo Database hoàn tất"

_runing "Đang Import (Bơm dữ liệu) vào Database..."

INIT_SQL="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET AUTOCOMMIT=0;"
END_SQL="COMMIT; SET FOREIGN_KEY_CHECKS=1; SET UNIQUE_CHECKS=1; SET AUTOCOMMIT=1;"

if command -v pv &>/dev/null; then
  if [[ "$duong_dan_thu_muc_sql" == *".sql.zst" ]]; then
    ( echo "$INIT_SQL"; pv -N "Importing" "$duong_dan_thu_muc_sql" | zstd -d; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  elif [[ "$duong_dan_thu_muc_sql" == *".sql.gz" ]]; then
    ( echo "$INIT_SQL"; pv -N "Importing" "$duong_dan_thu_muc_sql" | zcat; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  else
    ( echo "$INIT_SQL"; pv -N "Importing" "$duong_dan_thu_muc_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  fi
else
  if [[ "$duong_dan_thu_muc_sql" == *".sql.zst" ]]; then
    ( echo "$INIT_SQL"; zstd -d <"$duong_dan_thu_muc_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  elif [[ "$duong_dan_thu_muc_sql" == *".sql.gz" ]]; then
    ( echo "$INIT_SQL"; zcat "$duong_dan_thu_muc_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  else
    ( echo "$INIT_SQL"; cat "$duong_dan_thu_muc_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false
  fi
fi

if [[ $? -eq 0 ]]; then
  echo ""
  _rundone "Khôi phục Database thành công"
else
  echo ""
  _runloi "Khôi phục Database thất bại"
fi
rm -f "${TEMP_CNF:?}"

# ==============================================================================
# KHÔI PHỤC MÃ NGUỒN
# ==============================================================================
_runing "Đang Xóa trắng mã nguồn cũ..."
if [[ -n "$NAME" ]];then
	rm -rf /usr/local/lsws/"${NAME:?}"/html/*
fi
_rundone "Xóa mã nguồn cũ hoàn tất"

_runing "Đang Giải nén Mã nguồn website..."
if [[ "$file" == *".zip" ]]; then
  if unzip -l "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $4 }' | grep -q '^wp-load.php$'; then
    unzip -oq "$duong_dan_thu_muc" -d /usr/local/lsws/"$NAME"/html/
  else
    check_wrapped=$(unzip -l "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $4 }' | grep '/wp-load.php$')
    if [[ -n "$check_wrapped" ]]; then
      wrapped_dir=$(echo "$check_wrapped" | sed 's/wp-load.php/*/g')
      TEMP_DIR=$(mktemp -d /tmp/XXXXXX)
      unzip -oq "$duong_dan_thu_muc" -d "$TEMP_DIR"
      mv "$TEMP_DIR"/$wrapped_dir /usr/local/lsws/"$NAME"/html/
      rm -rf "${TEMP_DIR:?}"
    else
      unzip -oq "$duong_dan_thu_muc" -d /usr/local/lsws/"$NAME"/html/
    fi
  fi
fi

if [[ "$file" == *".tar.zst" ]]; then
  if tar --use-compress-program="zstd" -tvf "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $6 }' | grep -qE '^\./wp-load.php$|^wp-load.php$'; then
    tar --use-compress-program="zstd" -xf "$duong_dan_thu_muc" -C /usr/local/lsws/"$NAME"/html --overwrite
  else
    check_wrapped=$(tar --use-compress-program="zstd" -tvf "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $6 }' | sed 's#\./##g' | grep '/wp-load.php$')
    if [[ -n "$check_wrapped" ]]; then
      wrapped_dir=$(echo "$check_wrapped" | sed 's/wp-load.php/*/g')
      TEMP_DIR=$(mktemp -d /tmp/XXXXXX)
      tar --use-compress-program="zstd" -xf "$duong_dan_thu_muc" -C "$TEMP_DIR" --overwrite
      mv "$TEMP_DIR"/$wrapped_dir /usr/local/lsws/"$NAME"/html
      rm -rf "${TEMP_DIR:?}"
    else
      tar --use-compress-program="zstd" -xf "$duong_dan_thu_muc" -C /usr/local/lsws/"$NAME"/html --overwrite
    fi
  fi
fi

if [[ "$file" == *".tar.gz" ]]; then
  if tar -tvzf "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $6 }' | grep -qE '^\./wp-load.php$|^wp-load.php$'; then
    tar -xzf "$duong_dan_thu_muc" -C /usr/local/lsws/"$NAME"/html --overwrite
  else
    check_wrapped=$(tar -tvzf "$duong_dan_thu_muc" 2>/dev/null | awk '{ print $6 }' | sed 's#\./##g' | grep '/wp-load.php$')
    if [[ -n "$check_wrapped" ]]; then
      wrapped_dir=$(echo "$check_wrapped" | sed 's/wp-load.php/*/g')
      TEMP_DIR=$(mktemp -d /tmp/XXXXXX)
      tar -xzf "$duong_dan_thu_muc" -C "$TEMP_DIR" --overwrite
      mv "$TEMP_DIR"/$wrapped_dir /usr/local/lsws/"$NAME"/html
      rm -rf "${TEMP_DIR:?}"
    else
      tar -xzf "$duong_dan_thu_muc" -C /usr/local/lsws/"$NAME"/html --overwrite
    fi
  fi
fi
_rundone "Giải nén mã nguồn thành công"

_runing "Đang Thiết lập Phân quyền (Chown/Chmod)..."
# chown -R "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/html
find /usr/local/lsws/"$NAME"/html -type d -exec chmod 755 {} \;
find /usr/local/lsws/"$NAME"/html -type f -exec chmod 644 {} \;
_rundone "Thiết lập phân quyền an toàn hoàn tất"

wp_config_php_path="/usr/local/lsws/$NAME/html/wp-config.php"
if [[ -f "$wp_config_php_path" ]]; then
  _runing "Đang kết nối dữ liệu (Cập nhật wp-config.php)..."
  wp config set DB_HOST 'localhost' --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_NAME "$DB_Name_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_USER "$DB_User_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_PASSWORD "$password_database_website_giai_ma" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp rewrite flush --allow-root --path="/usr/local/lsws/$NAME/html" >/dev/null 2>&1
  _rundone "Kết nối dữ liệu website thành công"
else
  echo -e "${C_YELLOW}Không tìm thấy file wp-config.php. Có vẻ như đây không phải mã nguồn WordPress.${C_RESET}"
fi

if [[ -f "/usr/local/lsws/$NAME/html/wp-load.php" ]]; then
  . /etc/wptt-user/cache/wptt-xoacache "$NAME" >/dev/null 2>&1
fi

wptt_smart_reload_lsws >/dev/null 2>&1

clear
thong_bao_sql=$(basename "$duong_dan_thu_muc_sql" | sed "s/^$NAME//g" | cut -f1 -d '.')
thong_bao_ma_nguon=$(basename "$duong_dan_thu_muc" | sed "s/^$NAME//g" | cut -f1 -d '.')

time_str="Đã khôi phục mới nhất"
if [[ -n "$thong_bao_sql" && -n "$thong_bao_ma_nguon" && "$thong_bao_ma_nguon" == "$thong_bao_sql" ]]; then
  chuyen_doi_thong_bao_gio=$(echo "$thong_bao_ma_nguon" | cut -c 1-2)
  chuyen_doi_thong_bao_ngay=$(echo "$thong_bao_ma_nguon" | cut -f2 -d '_' | cut -c 1-2)
  chuyen_doi_thong_bao_thang=$(echo "$thong_bao_ma_nguon" | cut -f3 -d '_' | cut -c 1-2)
  chuyen_doi_thong_bao_nam=$(echo "$thong_bao_ma_nguon" | cut -f4 -d '_' | cut -c 1-4)
  if [[ -n "$chuyen_doi_thong_bao_gio" && -n "$chuyen_doi_thong_bao_nam" ]]; then
    time_str="${chuyen_doi_thong_bao_gio}:00 - Ngày ${chuyen_doi_thong_bao_ngay}/${chuyen_doi_thong_bao_thang}/${chuyen_doi_thong_bao_nam}"
  fi
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}KHÔI PHỤC WEBSITE THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Mốc dữ liệu  : ${C_GREEN}$time_str${C_RESET}"
left_text "Trạng thái   : Cơ sở dữ liệu và Mã nguồn đã được phục hồi."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ "${1:-}" == "98" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1
