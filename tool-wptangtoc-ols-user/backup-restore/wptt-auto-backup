#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt-user/wptt-backup-restore-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Thiết lập Tự động Sao lưu${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Auto Backup"
NAME="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt-user/wptt-backup-restore-main 1

# ==============================================================================
# KIỂM TRA ĐIỀU KIỆN (QUÉT TRỰC TIẾP TỪ CRONTAB)
# ==============================================================================
. /etc/wptt/vhost/."$NAME".conf 2>/dev/null

if crontab -l 2>/dev/null | grep -q "wptt-saoluu $NAME"; then
  echo -e "\n${C_YELLOW}Website $NAME đã được thiết lập Auto Backup từ trước!${C_RESET}"
  echo "Vui lòng Gỡ bỏ thiết lập cũ trước khi muốn tạo lịch mới."
  sleep 3
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

# ==============================================================================
# HỎI ĐÁP CẤU HÌNH THỜI GIAN
# ==============================================================================
echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CẤU HÌNH THỜI GIAN (CRON)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
echo -en "${C_CYAN}│${C_RESET} ${C_YELLOW}Nhập khung GIỜ chạy Backup (Từ 0 đến 23) [Nhấn Enter = 1h sáng]: ${C_RESET}"
read gio

if [[ ! "$gio" =~ ^-?[0-9]+$ ]] || (( gio < 0 )) || (( gio > 23 )); then
  gio="1"
fi
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
echo -e "${C_CYAN}│${C_RESET} ${C_YELLOW}Chọn NGÀY trong tuần để chạy Backup:${C_RESET}"

. /etc/wptt-user/wptt-times-tuan
tuan
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

case "$thu" in
  0|7) thu12="Chủ Nhật" ;;
  1) thu12="Thứ Hai" ;;
  2) thu12="Thứ Ba" ;;
  3) thu12="Thứ Tư" ;;
  4) thu12="Thứ Năm" ;;
  5) thu12="Thứ Sáu" ;;
  6) thu12="Thứ Bảy" ;;
  *) thu12="Mỗi ngày (Hàng ngày)" ;;
esac

# ==============================================================================
# HỎI ĐÁP LƯU TRỮ CLOUD BẰNG WPTT_XAC_NHAN
# ==============================================================================
tuan1=""
tuan2=""
uploads="n"

checkdathietlap=$(grep -rnw "$HOME/.config/rclone/rclone.conf" -e "wptangtoc" >>/dev/null 2>&1 && echo 1)
if [[ -n "$checkdathietlap" ]]; then
  if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
    drive_name="OneDrive"
  elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$HOME/.config/rclone/rclone.conf" 2>/dev/null; then
    drive_name="S3 Storage"
  else
    drive_name="Google Drive"
  fi

  echo ""
  if wptt_xac_nhan "Hệ thống phát hiện bạn đã liên kết Lưu trữ Đám mây ($drive_name)." "Bạn có muốn tự động TẢI FILE LÊN ĐÁM MÂY sau khi backup xong không?" "" "Đồng ý Upload" "Chỉ lưu Local"; then
    uploads="y"
    tuan1="1998"
    
    echo ""
    if wptt_xac_nhan "Bạn có muốn XÓA BẢN SAO LOCAL (Ổ cứng Server) sau khi đã upload lên Đám mây không?" "Điều này giúp Server không bị đầy ổ cứng." "" "Đồng ý Xóa Local" "Giữ lại Local"; then
      tuan2="1998" # Mã lệnh xóa local
    else
      tuan2="12345" # Mã lệnh giữ local
    fi
  fi
fi

# ==============================================================================
# XÁC NHẬN CHUNG CUỘC VÀ LƯU VÀO CRON
# ==============================================================================
echo ""
if ! wptt_xac_nhan "Bạn có CHẮC CHẮN muốn lưu thiết lập Tự động sao lưu này?" "Thời gian: Lúc ${C_YELLOW}${gio}:00${C_RESET} - ${C_GREEN}${thu12}${C_RESET}" "Hành động này sẽ ghi vào hệ thống Crontab của bạn." "Lưu thiết lập" "Hủy bỏ"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  exec /etc/wptt-user/wptt-backup-restore-main 1
fi

_runing "Đang ghi cấu hình vào hệ thống..."

# Chèn thẳng câu lệnh vào Crontab (Kỹ thuật File-less, bỏ qua Permission Denied)
CRON_CMD="0 $gio * * $thu bash -c '. /etc/wptt-user/backup-restore/wptt-saoluu $NAME $tuan1 $tuan2' >/dev/null 2>&1"
(crontab -l 2>/dev/null | grep -v "wptt-saoluu $NAME"; echo "$CRON_CMD") | crontab -

_rundone "Lưu cấu hình tự động sao lưu thành công"

# ==============================================================================
# BẢNG TÓM TẮT THÀNH CÔNG
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CẤU HÌNH AUTO BACKUP THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website      : ${C_YELLOW}$NAME${C_RESET}"
left_text "Lịch chạy    : Vào lúc ${C_YELLOW}${gio}:00${C_RESET} - ${C_GREEN}${thu12}${C_RESET} hàng tuần."
if [[ "$uploads" == "y" ]]; then
  left_text "Lưu trữ Cloud: Tự động tải lên ${drive_name} (Thư mục: wptangtoc_ols_backup)"
  if [[ "$tuan2" == "1998" ]]; then
    left_text "Dọn dẹp Local: Tự động XÓA file tại ổ cứng Server (Tiết kiệm dung lượng)."
  else
    left_text "Dọn dẹp Local: Lưu trữ song song cả trên Server và Đám mây."
  fi
else
  left_text "Lưu trữ      : Chỉ lưu tại thư mục Local (/usr/local/lsws/$NAME/backup-website)"
fi
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
echo -en "${C_CYAN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
read -r

exec /etc/wptt-user/wptt-backup-restore-main 1
