# HÀM NHẬN DIỆN TÊN MIỀN TỰ ĐỘNG CHO USER 
function lua_chon_NAME() {
  local title_msg
  title_msg="${1:-Xác định Tên miền}"
  NAME=""

  # Quét trực tiếp file Vhost được mount trong lồng Chroot
  # Vì môi trường User Jail chỉ chứa duy nhất 1 file .domain.conf của chính họ
  if [[ -d "/etc" ]]; then
    NAME=$(ls -A /etc 2>/dev/null | grep '^\.' | grep '\.conf$' | head -n 1 | sed 's/^\.//' | sed 's/\.conf$//')
  fi

  # [SÁT CHIÊU 2]: Fallback cắt đường dẫn hiện tại (pwd) nếu cách 1 bị lỗi mount
  if [[ -z "$NAME" || "$NAME" == "html" || "$NAME" == "bin" ]]; then
    NAME=$(pwd | cut -f5 -d '/')
  fi

  # [SÁT CHIÊU 3]: Fallback dò Lối tắt (Symlink) ở thư mục lsws
  if [[ -z "$NAME" || "$NAME" == "html" || "$NAME" == "bin" ]]; then
    NAME=$(ls /usr/local/lsws/ 2>/dev/null | grep '\.' | grep -v 'lsphp' | head -n 1)
    
    if [[ -z "$NAME" ]]; then
      NAME=$(find /usr/local/lsws/ -maxdepth 1 -type l 2>/dev/null | awk -F'/' '{print $NF}' | head -n 1)
    fi
  fi

  # ==============================================================================
  # CHỐT HẠ & BÁO LỖI (NẾU MÔI TRƯỜNG CHROOT BỊ PHÁ HỎNG)
  # ==============================================================================
  if [[ -z "$NAME" || "$NAME" == "html" || "$NAME" == "bin" ]]; then
    clear
    echo -e "\n\e[36m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
    echo -e "\e[36m│\e[0m  \e[31mLỖI CHÍ MẠNG: KHÔNG THỂ XÁC ĐỊNH TÊN MIỀN\e[0m                                \e[36m│\e[0m"
    echo -e "\e[36m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[36m│\e[0m  Môi trường nhận diện tự động đã bị lỗi hoặc hệ thống mount bị gãy.          \e[36m│\e[0m"
    echo -e "\e[36m│\e[0m  Vui lòng liên hệ Admin (Gia Tuấn) để kiểm tra lại cấu trúc lồng Chroot.     \e[36m│\e[0m"
    echo -e "\e[36m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m\n"
    sleep 4
    exit 1
  fi
}
