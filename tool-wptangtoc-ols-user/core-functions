#!/bin/bash
# ==============================================================================
# Đường dẫn: . /etc/wptt-user/core-functions
# Môi trường: Dành riêng cho tài khoản User trong Chroot Jail
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HÀM NHẬN DIỆN HỆ ĐIỀU HÀNH (OS DETECTION)
# ------------------------------------------------------------------------------
function wptt_get_os_family() {
  if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
    echo "ubuntu"
  elif grep -q "AlmaLinux\|Rocky Linux\|Red Hat Enterprise Linux\|Oracle Linux Server" /etc/*release 2>/dev/null; then
    echo "rhel"
  else
    echo "unknown"
  fi
}

# ------------------------------------------------------------------------------
# 2. HÀM LẤY IP PUBLIC SIÊU TỐC VÀ CHỐNG LỖI MẠNG
# ------------------------------------------------------------------------------
function wptt_get_public_ip() {
  local ip
  ip=$(curl -sf -m 3 ipv4.icanhazip.com)
  if [[ -z "$ip" ]]; then
    ip=$(curl -sf -m 3 api.ipify.org)
  fi
  if [[ -z "$ip" ]]; then
    ip=$(curl -sf -m 3 ifconfig.me)
  fi
  echo "$ip"
}

# ------------------------------------------------------------------------------
# 3. HÀM LẤY DUNG LƯỢNG RAM THỰC TẾ (Đơn vị: MB)
# ------------------------------------------------------------------------------
function wptt_get_ram_mb() {
  local ram_bytes
  ram_bytes=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)
  local ram_mb=$(echo "scale=0;${ram_bytes:-2048576}/1024" | bc)
  if [[ -z "$ram_mb" ]]; then
    echo "2048" # Fallback an toàn
  else
    echo "$ram_mb"
  fi
}

# ------------------------------------------------------------------------------
# 4. HÀM BẢO VỆ CHỐNG TỰ HỦY KHI XÓA THƯ MỤC (ANTI RM -RF /)
# ------------------------------------------------------------------------------
function wptt_kha_dung_de_xoa_xac_thuc() {
  local domain="$1"
  if [[ -z "$domain" || "$domain" == "." || "$domain" == "/" || "$domain" == *"*"* ]]; then
    return 1 # Trả về False (Lỗi)
  fi
  if [[ ! "$domain" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
    return 1
  fi
  return 0 # Trả về True (Hợp lệ)
}

# ------------------------------------------------------------------------------
# HÀM BÁO LỖI VÀ QUAY LẠI MENU
# ------------------------------------------------------------------------------
wptt_die() {
  local ERROR_MSG="$1"
  echo -e "\e[31m[LỖI] $ERROR_MSG\e[0m"

  if [[ "$WPTT_IN_MENU" == "yes" && -n "$WPTT_MENU_BACK" ]]; then
    echo ""
    read -n 1 -s -r -p "Nhấn phím bất kỳ để quay lại Menu..."
    echo ""
    exec $WPTT_MENU_BACK
  else
    exit 1
  fi
}

# ------------------------------------------------------------------------------
# HÀM KIỂM TRA MARIADB CHO USER (CHỈ PING VÀO SOCKET)
# Không dùng systemctl vì User trong lồng Chroot không có quyền quản lý Service
# ------------------------------------------------------------------------------
wptt_check_mariadb() {
  # Kiểm tra kết nối thực tế qua Socket (Đã được mount vào lồng)
  if ! mariadb-admin ping >/dev/null 2>&1; then
    return 1 # Trả về lỗi nếu MySQL không phản hồi
  fi
  return 0 # Trả về true
}

# ------------------------------------------------------------------------------
# HÀM KIỂM TRA OPENLITESPEED CHO USER
# ------------------------------------------------------------------------------
wptt_check_lsws() {
  if ! /usr/local/lsws/bin/lswsctrl status 2>/dev/null | grep -iq "is running"; then
    return 1
  fi
  return 0
}

# ==============================================================================
# THƯ VIỆN UI: POPUP XÁC NHẬN BO CONG WPTANGTOC
# ==============================================================================
function wptt_xac_nhan() {
  local msg_title="${1:-Bạn có chắc chắn muốn thực hiện thao tác này?}"
  local info_1="$2"
  local info_2="$3"
  local opt_1="${4:-Đồng ý}"
  local opt_2="${5:-Không đồng ý}"

  local box_inner_width=${box_inner_width:-78}

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

  local clean_title=$(echo -e "$msg_title" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local pad_title=$((box_inner_width - ${#clean_title} - 2))
  [[ $pad_title -lt 0 ]] && pad_title=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${msg_title}${C_RESET}$(printf '%*s' "$pad_title" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  if [[ -n "$info_1" ]]; then
    local clean_info1=$(echo -e "$info_1" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
    local pad_1=$((box_inner_width - ${#clean_info1} - 2))
    [[ $pad_1 -lt 0 ]] && pad_1=0
    echo -e "${C_CYAN}│${C_RESET}  ${info_1}$(printf '%*s' "$pad_1" "")${C_CYAN}│${C_RESET}"
  fi

  if [[ -n "$info_2" ]]; then
    local clean_info2=$(echo -e "$info_2" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
    local pad_2=$((box_inner_width - ${#clean_info2} - 2))
    [[ $pad_2 -lt 0 ]] && pad_2=0
    echo -e "${C_CYAN}│${C_RESET}  ${info_2}$(printf '%*s' "$pad_2" "")${C_CYAN}│${C_RESET}"
  fi

  if [[ -n "$info_1" || -n "$info_2" ]]; then
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  fi

  local clean_opt1="1) $opt_1"
  local pad_opt1=$((box_inner_width - ${#clean_opt1} - 2))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_CYAN}1)${C_RESET} ${opt_1}$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

  local clean_opt2="2) $opt_2"
  local pad_opt2=$((box_inner_width - ${#clean_opt2} - 2))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_CYAN}2)${C_RESET} ${opt_2}$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  while true; do
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r confirm
    case "$confirm" in
    1)
      return 0
      ;;
    2|0)
      return 1
      ;;
    *)
      echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập 1, 2 hoặc 0 để thoát.${C_RESET}"
      ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# HÀM RELOAD LITESPEED CHO USER
# Dùng /tmp để User có quyền ghi Lock File. Đã bỏ lệnh systemctl.
# ------------------------------------------------------------------------------
function wptt_smart_reload_lsws() {
    local lock_file="/tmp/.wptt_ls_reload.lock"
    local lsws_marker="/usr/local/lsws/cgid"

    (
        flock -n 9 || exit 0

        local current_time=$(date +%s)
        local last_run=0
        
        if [[ -f "$lsws_marker" ]]; then
            last_run=$(stat -c %Y "$lsws_marker" 2>/dev/null || echo 0)
        fi

        local time_diff=$((current_time - last_run))

        if [[ $time_diff -lt 8 ]]; then
            sleep $((8 - time_diff))
        fi

        /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1
    ) 9> "$lock_file" &
}

# ==============================================================================
# HÀM MÃ HÓA & GIẢI MÃ AES-256-CBC (LẤY KEY TỪ BÊN TRONG LỒNG CHROOT)
# ==============================================================================

wptt_ma_hoa() {
    local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
    local plaintext="$1"
    
    echo -n "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
}

wptt_giai_ma() {
    local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
    local ciphertext="$1"
    
    if [[ "$ciphertext" == U2FsdGVkX1* ]]; then
        echo -n "$ciphertext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -d -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
    else
        echo -n "$ciphertext"
    fi
}
