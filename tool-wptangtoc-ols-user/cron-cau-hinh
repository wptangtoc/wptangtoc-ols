#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ TỰ ĐỘNG HÓA ➜ Cấu hình Cron Job (Hẹn giờ)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Mẹo: Truy cập ${C_GREEN}https://wptangtoc.com/crontab/${C_RESET} để lấy mã Cron chuẩn."
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# XÁC NHẬN TRƯỚC KHI VÀO TRÌNH SOẠN THẢO
# ==============================================================================
if ! wptt_xac_nhan "Bạn có muốn mở trình soạn thảo để chỉnh sửa Cron Job không?" "Công cụ soạn thảo: Nano" "Lưu ý: Chỉ chỉnh sửa khi bạn hiểu rõ về lệnh Crontab!" "Đồng ý (Mở Nano)" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 1
  exec /etc/wptt-user/wptangtoc-user 1
fi

# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG NANO UI BO CONG
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HƯỚNG DẪN SỬ DỤNG NANO (TRÌNH SOẠN THẢO)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "1. Sau khi chỉnh sửa xong, ấn tổ hợp phím ${C_YELLOW}Ctrl + O${C_RESET} để Lưu."
left_text "2. Ấn phím ${C_YELLOW}Enter${C_RESET} để xác nhận ghi đè file."
left_text "3. Ấn tổ hợp phím ${C_YELLOW}Ctrl + X${C_RESET} để Thoát ra ngoài."
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -e "${C_CYAN}Đang mở trình soạn thảo trong 3 giây...${C_RESET}"
sleep 3

# [MẤU CHỐT]: Ép tuyệt đối trình soạn thảo Nano cho môi trường Chroot hiện tại
export VISUAL=nano
export EDITOR=nano

# Gọi lệnh cron (Nó sẽ ăn theo cái Fake Crontab ở file /usr/bin/crontab trong lồng)
crontab -e

echo -e "\n${C_GREEN}Đang lưu thiết lập và quay lại Menu chính...${C_RESET}"
sleep 1
exec /etc/wptt-user/wptangtoc-user 1
