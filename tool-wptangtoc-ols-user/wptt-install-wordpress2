#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export box_inner_width=78

. /etc/wptt-user/echo-color 2>/dev/null
. /etc/wptt-user/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ WEBSITE ➜ Cài mới trắng toàn bộ WordPress${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt-user/tenmien
lua_chon_NAME "Cài đặt WordPress trắng"
domain="$NAME"

[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "$1" == "99" ]] && wptangtoc-user 1; exit 0; }

. /etc/wptt/vhost/."$NAME".conf 2>/dev/null

# ==============================================================================
# CẢNH BÁO NẾU ĐÃ CÓ MÃ NGUỒN
# ==============================================================================
if [[ -f /usr/local/lsws/$NAME/html/wp-load.php ]]; then
  echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}CẢNH BÁO: MÃ NGUỒN ĐANG TỒN TẠI${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Hệ thống phát hiện website $NAME đang có mã nguồn." 2
  left_text "Nếu tiếp tục, TOÀN BỘ dữ liệu cũ (Core, Uploads, Database)" 2
  left_text "sẽ bị XÓA SẠCH không thể khôi phục để cài mới hoàn toàn!" 2
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

if ! wptt_xac_nhan "Bạn có chắc chắn muốn CÀI MỚI WordPress cho website này không?" "${C_BOLD_WHITE}Website:${C_RESET} ${C_YELLOW}$domain${C_RESET}" "" "Đồng ý Cài mới" "Hủy thao tác"; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 2
  [[ "$1" == "99" ]] && wptangtoc-user 1
  exit 0
fi

# Chuyển ghi log vào /tmp vì môi trường Chroot không có /var/log
echo "Install Wordpress Mới trắng hoàn toàn: $(date '+%d-%m-%Y %H:%M')" >>/tmp/wptangtoc-ols.log

# ==============================================================================
# BƯỚC 1: DỌN DẸP & TẢI MÃ NGUỒN
# ==============================================================================
echo ""
_runing "Làm sạch toàn bộ dữ liệu mã nguồn cũ của $NAME..."
cd /usr/local/lsws/"$NAME"/html/ || exit 1
rm -rf /usr/local/lsws/"$NAME"/html/*
_rundone "Làm sạch mã nguồn hoàn tất"

_runing "Đang tải mã nguồn WordPress bản mới nhất..."
# FIX LỖI TẢI XUỐNG: Bỏ qua kiểm tra CA Certificate vì môi trường Chroot không có chứng chỉ
wget -q https://wordpress.org/latest.tar.gz || curl -sLOk https://wordpress.org/latest.tar.gz

if [[ ! -f latest.tar.gz ]]; then
  _runloi "Download mã nguồn WordPress thất bại"
  echo -e "${C_RED}Mạng gặp sự cố. Chưa thể download mã nguồn WordPress, vui lòng thử lại sau!${C_RESET}"
  sleep 3
  [[ "$1" == "99" ]] && wptangtoc-user 1
  exit 1
fi
_rundone "Tải mã nguồn hoàn tất"

_runing "Đang giải nén mã nguồn WordPress..."
tar -zxf latest.tar.gz
mv wordpress/* /usr/local/lsws/"$NAME"/html && rm -rf wordpress && rm -f latest.tar.gz
_rundone "Giải nén thành công"

if [[ ! -f "/etc/letsencrypt/live/$NAME/cert.pem" && ! -d /usr/local/lsws/$NAME/ssl ]]; then
  ssl_check="http://"
else
  ssl_check="https://"
fi

# ==============================================================================
# BƯỚC 2: XỬ LÝ DATABASE (GIẢI MÃ AES & TÁI TẠO)
# ==============================================================================
if [[ -n "$DB_Name_web" ]]; then
  _runing "Làm sạch & Tái tạo Database (Cơ sở dữ liệu)..."
  
  # GIẢI MÃ MẬT KHẨU
  password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
  [[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

  # DÙNG FILE TẠM ĐỂ GIẤU PASSWORD KHỎI CLI
  TEMP_CNF=$(mktemp -p /tmp wptt_db_XXXXXX.cnf)
  chmod 600 "$TEMP_CNF"
  cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
EOF

  mariadb --defaults-extra-file="$TEMP_CNF" -e "DROP DATABASE IF EXISTS \`${DB_Name_web}\`;"
  mariadb --defaults-extra-file="$TEMP_CNF" -e "CREATE DATABASE IF NOT EXISTS \`${DB_Name_web}\`;"
  rm -f "$TEMP_CNF"
  _rundone "Tái tạo Database thành công"

  # ==============================================================================
  # BƯỚC 3: THIẾT LẬP WP-CONFIG VÀ CÀI ĐẶT WP
  # ==============================================================================
  echo ""
  if wptt_xac_nhan "Bạn có muốn thiết lập WP-Config và tạo tài khoản Admin ngay bây giờ không?" "" "" "Có (Setup ngay)" "Bỏ qua (Tự Setup trên Web)"; then
    
    tien_to_db=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 6)

    # NẠP PASSWORD ĐÃ GIẢI MÃ VÀO LỆNH WP-CLI
    wp core config --dbname="$DB_Name_web" --dbuser="$DB_User_web" --dbpass="$password_database_website_giai_ma" --dbhost=localhost --dbprefix="${tien_to_db}_" --allow-root --extra-php >/dev/null 2>&1 <<PHP
define( 'WP_DEBUG_LOG', false );
define( 'WP_DEBUG_DISPLAY', false );
PHP
    
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}CẤU HÌNH THÔNG TIN WEBSITE${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    
    echo -en "${C_GREEN} 1. Tên tiêu đề Website (Site Title)  : ${C_RESET}"; read -r SiteTitle
    echo -en "${C_GREEN} 2. Nhập ID đăng nhập (Admin User)    : ${C_RESET}"; read -r idusername
    
    while true; do
      echo -en "${C_GREEN} 3. Nhập Mật khẩu (Ẩn khi gõ)         : ${C_RESET}"; read -rs mypassword
      echo ""
      if [[ -z "$mypassword" ]]; then
        echo -e "${C_RED}❌ Bạn chưa nhập mật khẩu! Vui lòng nhập lại.${C_RESET}"
      else
        break
      fi
    done

    while true; do
      echo -en "${C_GREEN} 4. Nhập Email Quản trị viên          : ${C_RESET}"; read -r emailwp
      if [[ "$emailwp" == "${emailwp/@/}" ]]; then
        echo -e "${C_RED}❌ Email không đúng định dạng (thiếu @). Vui lòng nhập lại.${C_RESET}"
      else
        break
      fi
    done

    echo ""
    _runing "Đang cài đặt lõi WordPress..."
    wp core install --url="${ssl_check}${domain}" --title="$SiteTitle" --admin_user="$idusername" --admin_password="$mypassword" --admin_email="$emailwp" --allow-root >/dev/null 2>&1
    
    wp language core install vi --path=/usr/local/lsws/"$NAME"/html --activate --allow-root >/dev/null 2>&1
    wp option update timezone_string "Asia/Ho_Chi_Minh" --path=/usr/local/lsws/"$domain"/html --allow-root >/dev/null 2>&1
    wp rewrite structure '/%postname%/' --path=/usr/local/lsws/"$NAME"/html --allow-root >/dev/null 2>&1
    _rundone "Cài đặt lõi WordPress thành công"
    setup_done="y"
  fi
fi

# ==============================================================================
# BƯỚC 4: FILE HTACCESS & PHÂN QUYỀN
# ==============================================================================
echo '
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress' >/usr/local/lsws/"$domain"/html/.htaccess

_runing "Đang phân quyền thư mục website $NAME..."
chown -R "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$domain"/html

# Dùng hàm Reload OLS chuyên biệt cho User thay cho lệnh lswsctrl trực tiếp
wptt_smart_reload_lsws >/dev/null 2>&1
_rundone "Phân quyền và nạp lại dịch vụ hoàn tất"

# ==============================================================================
# BẢNG TÓM TẮT THÀNH CÔNG
# ==============================================================================
clear
blue='\033[1;34m'
NC='\033[0m'

echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CÀI ĐẶT WORDPRESS THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Tên miền (Domain)  : ${ssl_check}${domain}"
left_text "Thư mục mã nguồn   : /usr/local/lsws/$domain/html/"
left_text "Tên Database       : $DB_Name_web"
left_text "User Database      : $DB_User_web"
left_text "Mật khẩu Database  : ******************** (Đã mã hóa an toàn)"

if [[ "$setup_done" == "y" ]]; then
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Tiêu đề Website    : $SiteTitle"
  left_text "URL Đăng nhập      : ${ssl_check}${domain}/wp-admin/"
  left_text "Tài khoản Admin    : $idusername"
  left_text "Mật khẩu Admin     : ******************** (Ẩn vì lý do bảo mật)"
  left_text "Email Quản trị     : $emailwp"
fi
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ "$1" == "99" ]] && wptangtoc-user 1
