#!/bin/bash
# UPDATE_DONE="YES"
# phải có dòng thứ 2 để download xác thực đầy đủ xem file download có bị lỗi không thì mới thực thi

if grep -q "AlmaLinux 8" /etc/*release 2>/dev/null; then
  check_gpg=$(rpm -q gpg-pubkey-ced7258b-6525146f | grep -q 'not installed')
  if [[ $check_gpg ]]; then
    dnf -y clean packages
    rpm --import https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux
  fi
fi


if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
  ln -sf /etc/cron.d/check-version-wptangtoc-ols.cron /etc/cron.d/check-version-wptangtoc-ols_cron
  systemctl restart cron
fi

if command -v ! monit >/dev/null 2>&1; then
  (/etc/wptt/monit)
fi


if [[ $(crontab -l | grep 'wptt-auto-tune') = '' ]]; then
  cat <(crontab -l) <(echo '@reboot /bin/bash /etc/wptt/cau-hinh/wptt-auto-tune >/dev/null 2>&1') | crontab -
  #phuc vụ auto tune trong tương lai
  TOTAL_RAM=$(free -m | awk '/^Mem:/{print $2}')
  FILE_CACHE="/etc/wptt/.ram_hien_tai"
  echo "$TOTAL_RAM" >"$FILE_CACHE"
  #end phục vụ auto tune trong tương lai
#if $(cat /etc/*release | grep -q "Ubuntu"); 
  if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
    systemctl restart cron
  else
    systemctl restart crond
  fi
fi

# =========================================================
# KHÓA BẢO VỆ MARIADB KHỎI HỆ ĐIỀU HÀNH (OS Auto-Update)
# =========================================================
if [ -f /etc/os-release ] && grep -qi "ubuntu" /etc/os-release; then
  # Khóa trên Ubuntu/Debian
  if command -v apt-mark >/dev/null 2>&1; then
    apt-mark hold mariadb-server mariadb-client >/dev/null 2>&1
  fi
else
  # Khóa trên AlmaLinux/Rocky/RHEL
  if [ -f /etc/dnf/dnf.conf ] && ! grep -q "^exclude=.*MariaDB" /etc/dnf/dnf.conf; then
    echo "exclude=MariaDB-* mariadb-*" >>/etc/dnf/dnf.conf
    echo -e "\e[32m[*] Đã kích hoạt lớp khiên bảo vệ (update) MariaDB ở cấp độ Hệ điều hành!\e[0m"
  fi
fi



# ==============================================================================
# PRE-CHECK REPO MARIADB TRƯỚC KHI UPDATE HỆ THỐNG
# ==============================================================================
#giải quyết vấn đề repo mariadb hết hạn nó 404 chuyển về nhánh archive
if [[ -f /etc/yum.repos.d/MariaDB.repo ]] && ! grep -q "archive.mariadb.org" /etc/yum.repos.d/MariaDB.repo; then
  if grep -qE "10\.[0-5]/" /etc/yum.repos.d/MariaDB.repo; then
    echo -e "\033[1;33mĐang tối ưu hóa Repository trước khi cập nhật...\033[0m"
    # Gọi script chạy trực tiếp (Không có dấu & để ép hệ thống phải chờ nó chạy xong)
    bash /etc/wptt/db/repo-mariadb-fix-eol >/dev/null 2>&1
  fi
fi

# Đường dẫn tới file bashrc
FILE_BASHRC="/root/.bashrc"

# Kiểm tra xem file bashrc có tồn tại không VÀ chưa chứa chuỗi "WPTT_BYPASS"
if [[ -f "$FILE_BASHRC" ]] && ! grep -q 'WPTT_BYPASS' "$FILE_BASHRC"; then
  # Lệnh sed 'i' (insert): Chèn dòng if vào ngay TRƯỚC dòng gọi wptt-status
  sed -i '/^\. \/etc\/wptt\/wptt-status/i if [[ "$WPTT_BYPASS" != "1" ]]; then' "$FILE_BASHRC"
  # Lệnh sed 'a' (append): Chèn dòng fi vào ngay SAU dòng gọi wptt-check
  sed -i '/^\. \/etc\/wptt\/wptt-check/a fi' "$FILE_BASHRC"
  echo "Với bản update này: khi update sau để hệ thống ổn định nhất bạn hãy reboot lại máy chủ"
fi


if ! command -v wtop &>/dev/null; then #kiểm tra xem đã cài đặt wptt top hay chưa
	\cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin
fi


sed -i '/^wptt *() *{/,/^}/d' /root/.bashrc
cat << 'EOF' >> /root/.bashrc
wptt() {
    case "$1" in
        cd-src|cd-log|cdbk)
            source /usr/bin/wptt "$@"
            ;;
        *)
            /usr/bin/wptt "$@"
            ;;
    esac
}
EOF

sed -i '/\/wptangtoc-ols/d' /root/.bashrc
echo "cd /wptangtoc-ols" >>/root/.bashrc



#pub key gpg
if ! gpg --list-keys "giatuan@wptangtoc.com" >/dev/null 2>&1; then
  
  # 1. Tải file key về máy
  curl -sL --connect-timeout 10 "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
  
  # Dự phòng Github nếu web chính sập
  if [[ ! -s wptangtoc-gpg-pub.key ]]; then
    curl -sL --connect-timeout 10 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
  fi

  # 2. Đọc Fingerprint thực tế (Chỉ lấy dòng đầu của Master Key)
  real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)
  
  # 3. Fingerprint "chuẩn không cần chỉnh" của sếp
  expected_fp="EE091EEB9A5189BC80837C059AA528D37B902267"

  # 4. Kiểm định khắt khe trước khi nạp
  if [[ -n "$real_fp" && "$real_fp" == "$expected_fp" ]]; then
    gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
  fi
  
  # Dọn dẹp file key rác
  rm -f wptangtoc-gpg-pub.key
fi


WPTT_AES_DIR="/etc/wptt-aes"
WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

# 1. Xây boong-ke và khóa cửa (Chỉ Root được vào)
if [[ ! -d "$WPTT_AES_DIR" ]]; then
    mkdir -p "$WPTT_AES_DIR"
    chmod 700 "$WPTT_AES_DIR"
fi

# 2. Sinh chìa khóa ngẫu nhiên nếu chưa có
if [[ ! -f "$WPTT_KEY_FILE" ]]; then
    openssl rand -base64 48 > "$WPTT_KEY_FILE"
    chmod 600 "$WPTT_KEY_FILE"
fi

mkdir -p /etc/wptt/tmp
chmod 700 /etc/wptt/tmp







. /etc/wptt/.wptt.conf 2>/dev/null

TOTAL_WP_SITES=$(ls -1 /etc/wptt/vhost/.*.conf 2>/dev/null | grep -v '^\.\.conf$' | wc -l)
PRIORITY_CMD="/usr/bin/ionice -c 3 /usr/bin/nice -n 19"
count_success=0

# Đảm bảo thư mục tmp hệ thống tồn tại cho Master Cron
mkdir -p /etc/wptt/tmp
chmod 700 /etc/wptt/tmp

# ==============================================================================
# TRÍCH XUẤT CHU KỲ "PHÚT" CŨ
# ==============================================================================
old_master_phut=$(grep -hoP '^[0-9*,-]+/\K[0-9]+' /etc/cron.d/wptt-master-cron 2>/dev/null | head -n 1)

if [[ "$TOTAL_WP_SITES" -ge 30 ]]; then
  # ----------------------------------------------------------------------------
  # MÔ HÌNH 1: MASTER CRON (CHIỀU DỌC)
  # ----------------------------------------------------------------------------
  phut="${old_master_phut}"
  
  if [[ -z "$phut" ]]; then
    phut=$(grep -hoP '^[0-9*,-]+/\K[0-9]+' /etc/cron.d/wp-cron-job-*.cron 2>/dev/null | head -n 1)
  fi
  
  if [[ -z "$phut" ]]; then exit 0; fi

  rm -f /etc/cron.d/wp-cron-job-*.cron /etc/cron.d/wp-cron-job-*_cron 2>/dev/null
  rm -f /etc/cron.d/wptt-master-cron /etc/wptt-auto/wptt-cron-worker.sh 2>/dev/null
  
  mkdir -p /etc/wptt-auto
  WORKER_FILE="/etc/wptt-auto/wptt-cron-worker.sh"
  MASTER_CRON_FILE="/etc/cron.d/wptt-master-cron"

  cat >"$WORKER_FILE" <<'EOF'
#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
  DOMAIN="${filepath##*/}"
  DOMAIN="${DOMAIN%.conf}"
  DOMAIN="${DOMAIN#.}"

  wp_config="/usr/local/lsws/$DOMAIN/html/wp-config.php"
  
  if [[ -f "$wp_config" ]] && grep -qiE "define\s*\(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*true\s*\)" "$wp_config" 2>/dev/null; then
    . "$filepath" 2>/dev/null
    . /etc/wptt/php/php-cli-domain-config "$DOMAIN" 2>/dev/null
    
    [[ -z "$User_name_vhost" || -z "$phien_ban_php_domain_thuc_thi" ]] && continue
    
    # HẠ QUYỀN NON-ROOT CHO WP-CLI
    /usr/bin/ionice -c 3 /usr/bin/nice -n 19 /sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php -d memory_limit=512M /usr/local/bin/wp cron event run --due-now --path="/usr/local/lsws/$DOMAIN/html" --quiet >/dev/null 2>&1
    
    /usr/bin/sleep 1
  fi
done
EOF
  chmod +x "$WORKER_FILE"

  # [ANTI-SYMLINK] Master Cron chạy quyền Root -> File lock ném vào /etc/wptt/tmp
  cat >"$MASTER_CRON_FILE" <<END
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
*/$phut * * * * root /usr/bin/flock -n /etc/wptt/tmp/wptt_master_cron.lock /bin/bash $WORKER_FILE >/dev/null 2>&1
END

  count_success=1
  echo "Tự động Upgrade WP-Cron (Master Cron) - Anti-Symlink Lock: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

else
  # ----------------------------------------------------------------------------
  # MÔ HÌNH 2: CRON LẺ PHÂN TÁN (CHIỀU NGANG)
  # ----------------------------------------------------------------------------
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    
    [[ "$domain" != ?*.?* ]] && continue

    wp_config="/usr/local/lsws/$domain/html/wp-config.php"
    cron_file="/etc/cron.d/wp-cron-job-$domain.cron"
    ubuntu_cron_file="/etc/cron.d/wp-cron-job-${domain//[.]/_}_cron"
    
    domain_phut=$(grep -oP '^[0-9*,-]+/\K[0-9]+' "$cron_file" 2>/dev/null | head -n 1)
    
    if [[ -z "$domain_phut" ]]; then domain_phut="$old_master_phut"; fi
    if [[ -z "$domain_phut" ]]; then continue; fi
    
    if [[ -f "$wp_config" ]] && grep -qiE "define\s*\(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*true\s*\)" "$wp_config" 2>/dev/null; then
      
      . "$filepath" 2>/dev/null
      . /etc/wptt/php/php-cli-domain-config "$domain" 2>/dev/null
      
      if [[ -z "$User_name_vhost" || -z "$phien_ban_php_domain_thuc_thi" ]]; then continue; fi

      rm -f "$cron_file" "$ubuntu_cron_file" 2>/dev/null
      
      # TẠO THƯ MỤC TMP VÀ ÉP QUYỀN USER ĐỂ TRÁNH LỖI FLOCK PERMISSION DENIED
      mkdir -p "/usr/local/lsws/$domain/tmp"
      chown "$User_name_vhost" "/usr/local/lsws/$domain/tmp"
      chmod 700 "/usr/local/lsws/$domain/tmp"
      
      offset_minute=$(( RANDOM % domain_phut ))
      if [[ "$offset_minute" -eq 0 ]]; then cron_time="*/$domain_phut"; else cron_time="${offset_minute}-59/${domain_phut}"; fi
      
      offset_second=$(( RANDOM % 60 ))
      sleep_cmd="/usr/bin/sleep $offset_second && "

      # [ANTI-SYMLINK] Cron lẻ chạy quyền Non-Root -> File lock ném thẳng vào thư mục tmp của User để cô lập quyền
      cat >"$cron_file" <<END
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
$cron_time * * * * $User_name_vhost $sleep_cmd$PRIORITY_CMD /usr/bin/flock -n /usr/local/lsws/$domain/tmp/.wptt_cron.lock /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php -d memory_limit=512M /usr/local/bin/wp cron event run --due-now --path="/usr/local/lsws/$domain/html" --quiet >/dev/null 2>&1
END
      
      if grep -qi "Ubuntu" /etc/*release 2>/dev/null; then ln -sf "$cron_file" "$ubuntu_cron_file"; fi
      
      ((count_success++))
      sleep 0.1
    fi
  done
  
  rm -f /etc/cron.d/wptt-master-cron /etc/wptt-auto/wptt-cron-worker.sh 2>/dev/null
  
  if [[ $count_success -gt 0 ]]; then
    echo "Tự động Upgrade WP-Cron (Splaying Ngang) - Anti-Symlink Lock: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  fi
fi

if [[ $count_success -gt 0 ]]; then
  if grep -qi "Ubuntu" /etc/*release 2>/dev/null; then
    systemctl restart cron.service >/dev/null 2>&1
  else
    systemctl restart crond.service >/dev/null 2>&1
  fi
fi
