#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com

function huong_dan() {
  Hệ thống tự động giám sát và sửa lỗi phân quyền [Chmod/Chown] theo thời gian thực.
  Ngăn chặn lỗi 403, 500 do tải file hoặc giải nén sai quyền [như dùng quyền root].
}

# . /etc/wptt/thiet-lap-auto-phanquyen on
# . /etc/wptt/thiet-lap-auto-phanquyen off

export box_inner_width=78
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

FLAG_FILE="/etc/wptt/auto-chmod-active"
WATCHER_BIN="/etc/wptt/wptt-phanquyen-watcher"
SERVICE_FILE="/etc/systemd/system/wptt-phanquyen.service"

ACTION=""
check_menu_wptangtoc_active=""
for arg in "$@"; do
  [[ "$arg" == "on" || "$arg" == "off" ]] && ACTION="$arg"
  [[ "$arg" == "98" ]] && check_menu_wptangtoc_active="98"
done

if [[ -z "$ACTION" ]]; then
  clear
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}TỐI ƯU BẢO MẬT ➜ Realtime Auto Chmod/Chown${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

kich_hoat_tinh_nang() {
  local task_enable="Thiết lập hệ thống Auto Phân quyền Realtime"
  [[ -z "$ACTION" ]] && echo ""
  _runing "$task_enable"

  mkdir -p /etc/wptt/cau-hinh

  # 1. Chỉ dọn dẹp Crontab nếu thực sự còn tồn tại cronjob cũ
  if crontab -l 2>/dev/null | grep -qF 'chmod-chown-auto-wptangtoc'; then
    (crontab -l 2>/dev/null | grep -vF 'chmod-chown-auto-wptangtoc' || true) | crontab - 2>/dev/null
  fi

  # 2. Kiểm tra và cài đặt inotify-tools nếu thiếu
  if ! command -v inotifywait &>/dev/null; then
    if [[ -f /etc/redhat-release ]]; then
      dnf install inotify-tools -y -q >/dev/null 2>&1 || yum install inotify-tools -y -q >/dev/null 2>&1
    elif [[ -f /etc/debian_version ]]; then
      DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null 2>&1 && \
        DEBIAN_FRONTEND=noninteractive apt-get install inotify-tools -y -q >/dev/null 2>&1
    fi
  fi

  if ! command -v inotifywait &>/dev/null || [[ ! -f "$WATCHER_BIN" ]]; then
    _runloi "$task_enable"
    return 1
  fi

  chmod 700 "$WATCHER_BIN" 2>/dev/null

  # 3. Tự động co giãn thông số (Auto-Scale) theo cấu hình VPS (Nhỏ vs To)
  local ram_kb ram_mb cpu_cores target_watches target_queue mem_high mem_max cpu_quota
  ram_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 1048576)
  ram_mb=$(( ram_kb / 1024 ))
  cpu_cores=$(nproc 2>/dev/null || echo 1)
  (( cpu_cores <= 0 )) && cpu_cores=1

  if (( ram_mb <= 2048 )); then
    # Cấu hình tiết kiệm tối đa cho VPS nhỏ (512MB - 2GB RAM)
    target_watches=131072
    target_queue=65536
    mem_high="16M"
    mem_max="32M"
    cpu_quota="25%"
  else
    # Cấu hình hiệu năng cao cho VPS lớn (> 2GB RAM, nhiều Website)
    target_watches=524288
    target_queue=131072
    mem_high="64M"
    mem_max="256M"
    cpu_quota="$(( cpu_cores * 50 ))%"
  fi

  if [[ -w /proc/sys/fs/inotify/max_user_watches ]]; then
    local cur_watches
    cur_watches=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo 8192)
    if (( cur_watches < target_watches )); then
      sysctl -w "fs.inotify.max_user_watches=${target_watches}" >/dev/null 2>&1 || true
    fi
  fi
  if [[ -w /proc/sys/fs/inotify/max_queued_events ]]; then
    local cur_queue
    cur_queue=$(cat /proc/sys/fs/inotify/max_queued_events 2>/dev/null || echo 16384)
    if (( cur_queue < target_queue )); then
      sysctl -w "fs.inotify.max_queued_events=${target_queue}" >/dev/null 2>&1 || true
    fi
  fi

  # 4. Khởi tạo Systemd Service theo thông số phần cứng đã tính toán
  cat << EOF > "$SERVICE_FILE"
[Unit]
Description=WPTangToc Auto Chmod/Chown Watcher
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /etc/wptt/wptt-phanquyen-watcher
Restart=always
RestartSec=5
# Nhường ưu tiên cho OpenLiteSpeed & MariaDB khi tải cao, chạy tối đa khi máy rảnh
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
# Giới hạn tài nguyên tự động co giãn theo phần cứng VPS
LimitSTACK=512K
MemoryHigh=$mem_high
MemoryMax=$mem_max
CPUQuota=$cpu_quota

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload >/dev/null 2>&1
  systemctl enable wptt-phanquyen >/dev/null 2>&1
  if systemctl restart wptt-phanquyen >/dev/null 2>&1 && systemctl is-active --quiet wptt-phanquyen; then
    touch "$FLAG_FILE"
    _rundone "$task_enable"
  else
    rm -f -- "$FLAG_FILE"
    _runloi "$task_enable"
    return 1
  fi
}

huy_bo_tinh_nang() {
  local task_disable="Hủy hệ thống Auto Phân quyền Realtime"
  [[ -z "$ACTION" ]] && echo ""
  _runing "$task_disable"

  rm -f -- "$FLAG_FILE"
  systemctl stop wptt-phanquyen >/dev/null 2>&1 || true
  systemctl disable wptt-phanquyen >/dev/null 2>&1 || true
  rm -f -- "$SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  if ! systemctl is-active --quiet wptt-phanquyen 2>/dev/null; then
    _rundone "$task_disable"
  else
    _runloi "$task_disable"
    return 1
  fi
}

if [[ "$ACTION" == "on" ]]; then
  if [[ ! -f "$FLAG_FILE" ]] || ! systemctl is-active --quiet wptt-phanquyen 2>/dev/null; then
    kich_hoat_tinh_nang
  fi
elif [[ "$ACTION" == "off" ]]; then
  if [[ -f "$FLAG_FILE" ]] || systemctl is-active --quiet wptt-phanquyen 2>/dev/null; then
    huy_bo_tinh_nang
  fi
else
  if [[ ! -f "$FLAG_FILE" ]]; then
    if wptt_xac_nhan "Bạn có muốn BẬT hệ thống Tự động Phân quyền Realtime?" "0% Disk IO - Sửa lỗi quyền file ngay lập tức." "" "Đồng ý Bật" "Hủy bỏ"; then
      kich_hoat_tinh_nang
    fi
  else
    if wptt_xac_nhan "Bạn có chắc chắn muốn TẮT hệ thống Tự động Phân quyền?" "Trạng thái: Đang hoạt động" "" "Đồng ý Tắt" "Giữ nguyên"; then
      huy_bo_tinh_nang
    fi
  fi
fi

[[ -z "$ACTION" ]] && sleep 2
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wptt-add-one-main 1
fi
