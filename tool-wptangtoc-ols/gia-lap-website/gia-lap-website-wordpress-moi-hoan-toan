#!/bin/bash

function huong_dan() {
  Giả lập một website WordPress trắng hoàn toàn là việc tạo ra một bản cài đặt WordPress gốc, sạch sẽ, và cung cấp một tên miền miễn phí dành cho bạn, trên máy chủ của bạn. Điều này rất hữu ích cho việc phát triển, kiểm thử, học tập và chuẩn bị cho một dự án website mới một cách an toàn và hiệu quả.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện UX Bo Cong

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}GIẢ LẬP WEBSITE ➜ Tạo Website WordPress Trắng (Tên miền miễn phí)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "${1:-}" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-gia-lap-main 1"
fi

wptt_check_mariadb || wptt_die "MariaDB đang bị sập! Hệ thống từ chối khởi tạo website."
wptt_check_lsws || wptt_die "OpenLiteSpeed đang bị sập! Hệ thống từ chối khởi tạo website."

# ==============================================================================
# KHỞI TẠO BIẾN VÀ TÊN MIỀN RANDOM (TỐI ƯU CHIỀU DÀI SUBDOMAIN < 63 KÝ TỰ)
# ==============================================================================
NAME="${Website_chinh:-}"
domain_phuc_vu="wptangtoc-ols.com"

# 1. Tính toán không gian an toàn cho Subdomain (Cắt bỏ phần đuôi .wptangtoc-ols.com)
max_subdomain_len=$((63 - ${#domain_phuc_vu} - 1)) # -1 cho dấu chấm nối

# 2. Xóa bỏ các ký tự đặc biệt khỏi Tên miền chính để làm tiền tố
clean_name="${NAME//[-._]/}"
clean_name=$(echo "$clean_name" | tr '[:upper:]' '[:lower:]')

# 3. Tính toán không gian còn lại cho tiền tố (Dành 5 ký tự cho hậu tố random)
# Ví dụ random là "abcd", thì cần 5 ký tự (1 gạch ngang + 4 random)
max_prefix_len=$((max_subdomain_len - 5))

# 4. Cắt gọt tiền tố nếu nó quá dài
if [[ ${#clean_name} -gt $max_prefix_len ]]; then
    clean_name="${clean_name:0:$max_prefix_len}"
fi

# 5. Khởi tạo chuỗi ngẫu nhiên (4 ký tự)
ten_ngau_nhien=$(openssl rand -base64 32 | tr -dc 'a-z0-9' | head -c 4)

# 6. Lắp ráp Subdomain an toàn 100% tuân thủ RFC (không quá 63 ký tự)
subdomain_ten_mien="${clean_name}-${ten_ngau_nhien}"
STAGING_DOMAIN="${subdomain_ten_mien}.${domain_phuc_vu}"

ip=$(curl -sf --connect-timeout 5 --max-time 10 https://ipv4.icanhazip.com || curl -sf --connect-timeout 5 --max-time 10 https://checkip.amazonaws.com)

if [[ -z "$ip" ]]; then
  echo -e "\n${C_RED}Lỗi: Máy chủ không có địa chỉ IPv4 Public!${C_RESET}"
  echo -e "Tính năng giả lập yêu cầu IPv4 để liên kết DNS."
  sleep 3
  exec /etc/wptt/wptt-gia-lap-main 1
fi

echo -e "${C_YELLOW}Hệ thống sẽ tự động cấp phát tên miền và cài đặt WordPress trắng.${C_RESET}\n"

# ==============================================================================
# CẤU HÌNH CLOUDFLARE DNS & TẠO VHOST
# ==============================================================================
_runing "Đang kết nối Cloudflare API để tạo tên miền giả lập ($STAGING_DOMAIN)..."
. /etc/wptt/gia-lap-website/cloudflare-dns "${subdomain_ten_mien}" "$ip" >/dev/null 2>&1
_rundone "Cấu hình tên miền giả lập hoàn tất ($STAGING_DOMAIN)"

echo "Giả lập website $STAGING_DOMAIN mới trắng: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

_runing "Khởi tạo Virtual Host và thư mục mã nguồn..."
. /etc/wptt/domain/wptt-themwebsite "$STAGING_DOMAIN" >/dev/null 2>&1

if ! wptt_kha_dung_de_xoa_xac_thuc "$STAGING_DOMAIN"; then
  _runloi "Lỗi khởi tạo Vhost rỗng. Đã hủy bỏ lệnh!"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-gia-lap-main 1
  exit 1
fi
_rundone "Khởi tạo Virtual Host thành công"

# ==============================================================================
# DOWNLOAD VÀ GIẢI NÉN WORDPRESS CORE (NÂNG CẤP BẢO MẬT SHA-1 VÀ PV UX)
# ==============================================================================
_runing "Đang tải xuống và giải nén mã nguồn WordPress mới nhất..."

OLD_PWD=$(pwd)
TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
cd "$TMP_DIR" || exit

echo "" # Tạo một dòng trống cho thanh tiến trình PV chạy mượt

# Hàm tải file tích hợp giao diện PV UX Tàng Hình
function wptt_download_wp_ux() {
  local url="$1"
  # Lấy kích thước file từ Header để mớm cho PV tính %
  local fsize
  fsize=$(curl -sI --max-time 5 "$url" | grep -i -E "Content-Length" | awk '{print $2}' | tr -d '\r')

  if command -v pv &>/dev/null && [[ -n "$fsize" && "$fsize" -gt 0 ]]; then
    wget -qO- --timeout=15 --tries=3 "$url" | pv -s "$fsize" -N "Tải WordPress" -p -t -e -r -b -w 90 >latest.tar.gz
    echo -en "\033[1A\033[2K\r"
  else
    wget -q --show-progress --timeout=15 --tries=3 "$url"
    echo -en "\033[1A\033[2K\r"
  fi
}

wptt_download_wp_ux "https://wordpress.org/latest.tar.gz"

# SỬ DỤNG SHA1 ĐỂ KIỂM ĐỊNH MÃ NGUỒN TỐT HƠN MD5
id_checksum_wordpress=$(curl -s https://wordpress.org/latest.tar.gz.sha1 | head -1)
[[ "${id_checksum_wordpress:?}" != $(sha1sum latest.tar.gz 2>/dev/null | awk '{print $1}') ]] && rm -f latest.tar.gz

# Dự phòng tải HTTP nếu bị lỗi mạng
if [[ ! -f latest.tar.gz ]]; then
  wptt_download_wp_ux "http://wordpress.org/latest.tar.gz"
  id_checksum_wordpress=$(curl -s http://wordpress.org/latest.tar.gz.sha1 | head -1)
  [[ "${id_checksum_wordpress:?}" != $(sha1sum latest.tar.gz 2>/dev/null | awk '{print $1}') ]] && rm -f latest.tar.gz
fi
echo -en "\033[1A\033[2K\r"

if [[ ! -f latest.tar.gz ]]; then
  _runloi "Tải mã nguồn WordPress thất bại"
  echo -e "${C_RED}Lỗi: Chưa thể download hoặc mã SHA-1 không khớp, vui lòng thử lại sau!${C_RESET}"
  cd "$OLD_PWD" || cd /root || exit
  rm -rf "${TMP_DIR:?}"
  . /etc/wptt/domain/wptt-xoa-website "$STAGING_DOMAIN" >/dev/null 2>&1
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-gia-lap-main 1
  return 2>/dev/null
  exit
fi

# Kiểm tra thư viện nén
if ! command -v tar &>/dev/null; then 
  if [ -f /etc/redhat-release ]; then
    dnf install tar -y -q >/dev/null 2>&1 || yum install tar -y -q >/dev/null 2>&1
  elif [ -f /etc/debian_version ]; then apt-get update -q >/dev/null 2>&1 && apt-get install tar -y -q >/dev/null 2>&1; fi
fi

if ! command -v gzip &>/dev/null; then 
  if [ -f /etc/redhat-release ]; then
    dnf install gzip -y -q >/dev/null 2>&1 || yum install gzip -y -q >/dev/null 2>&1
  elif [ -f /etc/debian_version ]; then apt-get update -q >/dev/null 2>&1 && apt-get install gzip -y -q >/dev/null 2>&1; fi
fi

# Xả nén an toàn và chuyển mã nguồn
tar -zxf latest.tar.gz
rm -rf "/usr/local/lsws/${STAGING_DOMAIN:?}/html/"*
mv wordpress/* "/usr/local/lsws/$STAGING_DOMAIN/html/"
cd "$OLD_PWD" || cd /root || exit
rm -rf "${TMP_DIR:?}"

_rundone "Tải và giải nén mã nguồn WordPress hoàn tất"

# ==============================================================================
# CÀI ĐẶT DATABASE & WORDPRESS BẰNG WP-CLI
# ==============================================================================
_runing "Đang tự động thiết lập Database và cài đặt WordPress..."

if [[ ! -x /usr/local/bin/wp ]]; then
  curl -sO https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
  chmod +x wp-cli.phar
  mv wp-cli.phar /usr/local/bin/wp
fi

. "/etc/wptt/vhost/.$STAGING_DOMAIN.conf"
tien_to_db=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 6)

# Cấu hình wp-config.php
password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"
/usr/local/bin/wp core config --dbname="$DB_Name_web" --dbuser="$DB_User_web" --dbpass="$password_database_website_giai_ma" --dbhost=localhost --dbprefix="${tien_to_db}_" --allow-root --path="/usr/local/lsws/$STAGING_DOMAIN/html/" --extra-php >/dev/null 2>&1 <<PHP
define( 'WP_DEBUG_LOG', false );
define( 'WP_DEBUG_DISPLAY', false );
PHP

# Tạo thông tin quản trị viên ngẫu nhiên
idusername="admin_$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 6)"
SiteTitle="WPTangToc OLS Staging"
mypassword=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 16)
emailwp="admin@${STAGING_DOMAIN}"

# Install WP
/usr/local/bin/wp core install --url="http://$STAGING_DOMAIN" --title="$SiteTitle" --admin_user="$idusername" --admin_password="$mypassword" --admin_email="$emailwp" --path="/usr/local/lsws/$STAGING_DOMAIN/html/" --allow-root >/dev/null 2>&1
/usr/local/bin/wp language core install vi --path="/usr/local/lsws/$STAGING_DOMAIN/html" --activate --allow-root >/dev/null 2>&1
/usr/local/bin/wp option update timezone_string "Asia/Ho_Chi_Minh" --path="/usr/local/lsws/$STAGING_DOMAIN/html" --allow-root >/dev/null 2>&1
/usr/local/bin/wp rewrite structure '/%postname%/' --path="/usr/local/lsws/$STAGING_DOMAIN/html" --allow-root >/dev/null 2>&1

# Chặn Bot tìm kiếm
/usr/local/bin/wp option set blog_public 0 --allow-root --path="/usr/local/lsws/$STAGING_DOMAIN/html" >/dev/null 2>&1

if [[ -f "/usr/local/lsws/$STAGING_DOMAIN/html/robots.txt" ]]; then
  cp -f "/usr/local/lsws/$STAGING_DOMAIN/html/robots.txt" "/tmp/$STAGING_DOMAIN-robots.txt"
fi

echo '# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress' >"/usr/local/lsws/$STAGING_DOMAIN/html/.htaccess"

_rundone "Cài đặt WordPress thành công"

_runing "Đang phân quyền bảo mật (Chown) cho thư mục mã nguồn..."
chown -R "$User_name_vhost":"$User_name_vhost" "/usr/local/lsws/$STAGING_DOMAIN/html"
chown root:root "/usr/local/lsws/$STAGING_DOMAIN"
_rundone "Phân quyền bảo mật hoàn tất"

# ==============================================================================
# CHỜ XÁC THỰC DNS (ĐƠN GIẢN HÓA - ỔN ĐỊNH 100%)
# ==============================================================================
unset check_dns api_google_check_dns_online_ipv4 api_cloudflare_dns_check_ipv4
a=0

TEMP_DNS_gia_lap=$(mktemp -p "/etc/wptt/tmp" dns_tmp_XXXXXX.cnf)
_runing "Đang chờ Cloudflare cập nhật máy chủ DNS toàn cầu..."
while [[ -z "$check_dns" && -z "$api_google_check_dns_online_ipv4" && -z "$api_cloudflare_dns_check_ipv4" ]]; do
  
  check_dns=$(host "$STAGING_DOMAIN" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
  api_google_check_dns_online_ipv4=$(curl -s --connect-timeout 5 "https://dns.google/resolve?name=$STAGING_DOMAIN&type=A" | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
  api_cloudflare_dns_check_ipv4=$(curl -s --connect-timeout 5 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$STAGING_DOMAIN&type=A" | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)

  a=$((a + 3))
  echo "$a" > "$TEMP_DNS_gia_lap"
  sleep 3

  if [[ $(cat "$TEMP_DNS_gia_lap") == '15' ]]; then
    . /etc/wptt/gia-lap-website/cloudflare-dns "${subdomain_ten_mien}" "$ip" >/dev/null 2>&1
  fi

  if [[ $(cat "$TEMP_DNS_gia_lap") == '30' ]]; then
    _runloi "Xác thực DNS quá thời gian (Timeout 30s)"
    echo -e "${C_RED}Chưa thể khởi tạo website giả lập lúc này (Cloudflare phản hồi chậm).${C_RESET}"
    echo -e "Hệ thống đang tự động gỡ bỏ các tệp tin lỗi sinh ra..."
	rm -f "$TEMP_DNS_gia_lap"
    . /etc/wptt/domain/wptt-xoa-website "$STAGING_DOMAIN" >/dev/null 2>&1
    sleep 3
    exec /etc/wptt/wptt-gia-lap-main 1
  fi
done

_rundone "Cập nhật DNS toàn cầu thành công"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI WEBSITE SAU KHI DỰNG (FIX LOCAL DNS CACHE BUG)
# ==============================================================================
_runing "Đang kiểm tra tính khả dụng của Website và cấu hình SEO..."

# Cập nhật Litespeed để nạp cấu hình wp-config.php & .htaccess vừa tạo
wptt_smart_reload_lsws >/dev/null 2>&1
sleep 3

# Dùng cờ --resolve ép Curl trỏ thẳng domain về IP của VPS để vượt rào Local DNS Cache
http_status="000"
for i in {1..3}; do
  http_status=$(curl -o /dev/null -s -w "%{http_code}" --resolve "$STAGING_DOMAIN:80:127.0.0.1" --connect-timeout 5 "http://$STAGING_DOMAIN" 2>/dev/null)

  if [[ "$http_status" == "200" || "$http_status" == "301" || "$http_status" == "302" ]]; then 
    break
  fi
  sleep 2
done

if [[ "$http_status" != "200" && "$http_status" != "301" && "$http_status" != "302" ]]; then 
  # Không xóa website vì wp-cli đã báo cài đặt thành công, chỉ báo lỗi kết nối cục bộ
  _runloi "Website phản hồi mã $http_status (Có thể do mạng cục bộ chậm)."
  # Vẫn chèn Noindex vì file .conf vẫn tồn tại
  sed -i '/extraHeaders /a X-Robots-Tag noindex' "/usr/local/lsws/conf/vhosts/$STAGING_DOMAIN/$STAGING_DOMAIN.conf"
else
  # Đóng dấu chặn Google Bots (Noindex) ở tầng Server
  sed -i '/extraHeaders /a X-Robots-Tag noindex' "/usr/local/lsws/conf/vhosts/$STAGING_DOMAIN/$STAGING_DOMAIN.conf"
  _rundone "Kiểm tra khả dụng và thiết lập Noindex hoàn tất"
fi

# ==============================================================================
# CÀI ĐẶT SSL VÀ RESTART LITESPEED
# ==============================================================================
_runing "Đang cài đặt bảo mật SSL (Let's Encrypt) cho website..."
wptt ssl "$STAGING_DOMAIN" >/dev/null 2>&1
SSL_STATUS="Đã BẬT (Let's Encrypt)"
PROTOCOL="https"
_rundone "Cài đặt SSL Let's Encrypt hoàn tất"

wptt_smart_reload_lsws >/dev/null 2>&1
echo "domain_gia_lap=1" >>"/etc/wptt/vhost/.$STAGING_DOMAIN.conf"

# ==============================================================================
# BẢNG BÁO CÁO KẾT QUẢ VÀ CẤP PHÁT TÀI KHOẢN
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}KHỞI TẠO WEBSITE WORDPRESS TRẮNG THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "  Tên miền thử nghiệm : ${C_YELLOW}${PROTOCOL}://$STAGING_DOMAIN${C_RESET}" 2
left_text "  Trang quản trị (WP) : ${C_CYAN}${PROTOCOL}://$STAGING_DOMAIN/wp-admin/${C_RESET}" 2
left_text "  Trạng thái SSL      : ${C_GREEN}$SSL_STATUS${C_RESET}" 2
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text " ${C_YELLOW}THÔNG TIN TÀI KHOẢN ĐĂNG NHẬP:${C_RESET}" 2
left_text "  Tên đăng nhập (User): ${C_BOLD_WHITE}$idusername${C_RESET}" 2
left_text "  Mật khẩu (Password) : ${C_RED}$mypassword${C_RESET}" 2
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text " ${C_YELLOW}Ghi chú:${C_RESET}" 2
left_text " - Hãy copy Mật khẩu và lưu lại ngay lập tức!" 2
left_text " - Bản thử nghiệm đã được tự động chặn Google (Noindex)." 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

check_menu_wptangtoc_active=${1:-}
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wptt-gia-lap-main 1
fi
