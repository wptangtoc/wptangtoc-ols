# Xử lý cô lập Redis/Valkey (Giữ nguyên logic an toàn của bạn)
if [[ -n "${REDIS_MASTER_PASS:-}" ]]; then
  socket_path=""
  cache_cli=""

  if systemctl is-active --quiet valkey 2>/dev/null; then
    socket_path="/var/run/valkey/valkey.sock"
    cache_cli="valkey-cli"
  elif systemctl is-active --quiet redis 2>/dev/null; then
    socket_path="/var/run/redis/redis.sock"
    cache_cli="redis-cli"
  fi

  if [[ -n "$cache_cli" && -S "$socket_path" ]]; then
    redis_acl_user="$(openssl rand -hex 12 2>/dev/null)"
    raw_redis_pass="$(openssl rand -hex 16 2>/dev/null)"
    redis_acl_pass_luu="$(wptt_ma_hoa "$raw_redis_pass" 2>/dev/null)"
    redis_acl_pass_luu="${redis_acl_pass_luu//$'\n'/}"

    redis_db_id="$(awk -F"['=]" '/^redis_db_id=/ { val=$3; gsub(/[^0-9]/,"",val); if(val!="") u[val+0]=1 } END { for(i=1;i<=999;i++) if(!(i in u)){print i; exit} print 999}' /etc/wptt/vhost/.*.conf 2>/dev/null)"
    [[ -z "$redis_db_id" ]] && redis_db_id=1

    raw_master_pass="$(wptt_giai_ma "$REDIS_MASTER_PASS" 2>/dev/null)"
    ACL_RULES=(+@all -flushall +flushdb -config -module -replicaof -slaveof -acl -shutdown -client -save -bgsave -debug -monitor -swapdb)

    if [[ -n "$raw_master_pass" ]] && "$cache_cli" -s "$socket_path" -a "$raw_master_pass" --no-auth-warning ACL SETUSER "$redis_acl_user" on ">$raw_redis_pass" "~*" "${ACL_RULES[@]}" >/dev/null 2>&1; then
      "$cache_cli" -s "$socket_path" -a "$raw_master_pass" --no-auth-warning ACL SAVE >/dev/null 2>&1
      
      {
        echo "redis_acl_user='$redis_acl_user'"
        echo "redis_acl_pass='$redis_acl_pass_luu'"
        echo "redis_db_id='$redis_db_id'"
      } >>"/etc/wptt/vhost/.$NAME2.conf"

      if [[ -d "$duong_dan_nguon_moi/wp-content/plugins/litespeed-cache" ]]; then
        WP_EXEC_CACHE=(timeout 15 /sbin/runuser -u "$USER" -- "${PHP_EXEC[@]}" /usr/local/bin/wp)
        "${WP_EXEC_CACHE[@]}" litespeed-option set object-user "$redis_acl_user" --path="$duong_dan_nguon_moi" --quiet >/dev/null 2>&1
        "${WP_EXEC_CACHE[@]}" litespeed-option set object-pswd "$raw_redis_pass" --path="$duong_dan_nguon_moi" --quiet >/dev/null 2>&1
        "${WP_EXEC_CACHE[@]}" litespeed-option set object-db_id "$redis_db_id" --path="$duong_dan_nguon_moi" --quiet >/dev/null 2>&1
      fi
    fi
  fi
fi

