#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Nhân bản (Clone) Website WordPress

function huong_dan() {
  cat <<'EOF'
  Tính năng sao chép website (Website Cloning, Nhân bản website) cho phép bạn nhân bản toàn bộ mã nguồn, cơ sở dữ liệu và cấu hình từ một domain nguồn sang một domain đích hoàn toàn độc lập.

  Mục đích:
  Tạo nhanh một website hoàn chỉnh gắn liền với domain mới hoặc subdomain thử nghiệm mà không gây gián đoạn hay ảnh hưởng tới hoạt động của website chính.

  Lợi ích nổi bật:
  * Triển khai tức thì sang domain mới: Tự động tạo Virtual Host, cấp thư mục web root và database riêng cho domain đích.
  * Tự động xử lý URL domain: Hệ thống tự động tìm và thay thế (Search & Replace) toàn bộ chuỗi domain cũ sang domain mới.
  * An toàn tuyệt đối cho domain gốc: Mọi thao tác đọc, trích xuất dữ liệu đều diễn ra ở chế độ an toàn, Zero-Downtime.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
if [[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]]; then . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

TEMP_CNF_ROOT=""
tmp_conf_httpd=""

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  [[ -n "${TEMP_CNF_ROOT:-}" && -f "$TEMP_CNF_ROOT" ]] && /bin/rm -f -- "${TEMP_CNF_ROOT:?}"
  [[ -n "${tmp_conf_httpd:-}" && -f "$tmp_conf_httpd" ]] && /bin/rm -f -- "${tmp_conf_httpd:?}"
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

route_flag="${1:-}"
NAME="${1:-}"
NAME2="${2:-}"
mode_arg="${3:-}"

[[ "$NAME" == "98" || "$NAME" == "99" ]] && NAME=""

clear
echo ""
print_border_top "$C_CYAN"
center_text "${C_YELLOW}QUẢN LÝ DOMAIN ➜ Nhân Bản (Clone) Website${C_RESET}" "$C_CYAN"
print_border_bot "$C_CYAN"
echo ""

# ==============================================================================
# 1. CHỌN WEBSITE NGUỒN
# ==============================================================================
if [[ -z "$NAME" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/tenmien-only-website-by-wordpress
  lua_chon_NAME "Chọn Website NGUỒN để nhân bản"
fi

[[ -z "${NAME:-}" ]] && wptt_quay_ve_menu "$route_flag" 1
[[ "$NAME" == "0" ]] && wptt_quay_ve_menu "$route_flag" 0

NAME="${NAME,,}"
pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền nguồn ($NAME) không tồn tại trên hệ thống này!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

NAME_NGUON="$NAME"

# ==============================================================================
# 2. NHẬP WEBSITE ĐÍCH VÀ CHUẨN HÓA ĐỊNH DẠNG
# ==============================================================================
if [[ -z "${NAME2:-}" ]]; then
  echo ""
  echo -e "Website Nguồn: ${C_GREEN}${NAME_NGUON}${C_RESET}"
  echo -e "${C_YELLOW}Ví dụ web đích: clone.wptangtoc.com, shop.vn...${C_RESET}"
  echo -en "${C_CYAN}Nhập Tên miền MỚI (Website Đích) [0=Thoát]: ${C_RESET}"
  read -r NAME2
fi

[[ -z "${NAME2:-}" || "$NAME2" == "0" ]] && wptt_quay_ve_menu "$route_flag" 0

NAME2="${NAME2//$'\r'/}"
NAME2="${NAME2//[[:space:]]/}"
NAME2="${NAME2,,}"
[[ "$NAME2" == *"://"* ]] && NAME2="${NAME2#*://}"
NAME2="${NAME2%%/*}"
[[ "$NAME2" == www.* ]] && NAME2="${NAME2#www.}"

if [[ -f /etc/wptt/domain/punycode.php ]] && command -v php >/dev/null 2>&1; then
  puny_out="$(php /etc/wptt/domain/punycode.php "$NAME2" 2>/dev/null || true)"
  if [[ -n "$puny_out" ]]; then
    NAME2="${puny_out//[[:space:]]/}"
    NAME2="${NAME2,,}"
  fi
fi

if [[ "$NAME2" != *"."* ]] || [[ ! "$NAME2" =~ ^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z0-9-]{2,}$ ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền đích ($NAME2) chứa ký tự không hợp lệ hoặc sai cấu trúc!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

if [[ "$NAME" == "$NAME2" ]]; then
  echo -e "\n${C_RED}🛡️ CẢNH BÁO AN TOÀN: Tên miền Đích ($NAME2) không được trùng với Nguồn ($NAME)!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

# ==============================================================================
# 3. KIỂM TRA DỊCH VỤ & XỬ LÝ GHI ĐÈ
# ==============================================================================
wptt_check_mariadb "$route_flag"
wptt_check_lsws "$route_flag"

path2="/etc/wptt/vhost/.$NAME2.conf"
if [[ -f "$path2" ]]; then
  xac_nhan_ghi_de=0
  if [[ "$mode_arg" == "no-config" ]]; then
    xac_nhan_ghi_de=1
  else
    echo -e "\n${C_YELLOW}⚠️ CẢNH BÁO QUAN TRỌNG:${C_RESET}"
    echo -e "Tên miền đích (${C_BOLD_WHITE}$NAME2${C_RESET}) đã tồn tại trên hệ thống!"
    echo -e "Nếu tiếp tục, ${C_RED}TOÀN BỘ DỮ LIỆU HIỆN TẠI${C_RESET} của $NAME2 sẽ bị XÓA SẠCH để nhường chỗ cho bản Clone.\n"
    if wptt_xac_nhan "Bạn có chắc chắn muốn GHI ĐÈ $NAME lên $NAME2 không?" \
      "${C_BOLD_WHITE}Nguồn:${C_RESET}$NAME" \
      "${C_BOLD_WHITE}Đích :${C_RESET}$NAME2" \
      "Đồng ý XÓA VÀ GHI ĐÈ" "Hủy bỏ"; then
      xac_nhan_ghi_de=1
    fi
  fi

  if ((xac_nhan_ghi_de == 1)); then
    echo ""
    if ! /bin/bash /etc/wptt/domain/wptt-xoa-website "$NAME2" 'nhan-ban' >/dev/null 2>&1; then
      echo -e "${C_RED}❌ Lỗi: Không thể xóa website cũ ($NAME2) để ghi đè!${C_RESET}"
      wptt_quay_ve_menu "$route_flag" 1 "enter"
    fi
  else
    echo -e "${C_YELLOW}Đã hủy thao tác nhân bản.${C_RESET}"
    wptt_quay_ve_menu "$route_flag" 0 "enter"
  fi
fi

# ==============================================================================
# 4. CHUẨN BỊ MÔI TRƯỜNG & KHỞI TẠO USER HỆ THỐNG
# ==============================================================================
# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi

cpucore=1
if [[ -r /proc/cpuinfo ]]; then
  cpucore="$(grep -c ^processor /proc/cpuinfo 2>/dev/null)"
  ((cpucore < 1)) && cpucore=1
fi
core_tien_lsphp_child=$((cpucore * 2))

tong_ram_kb=1048576
if [[ -r /proc/meminfo ]]; then
  tong_ram_kb="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)"
fi
TOTAL_RAM_MB=$((tong_ram_kb / 1024))

if ((TOTAL_RAM_MB <= 1200)); then KA_REQS="1000"
elif ((TOTAL_RAM_MB <= 4500)); then KA_REQS="5000"
else KA_REQS="10000"; fi

echo ""
task_init="Khởi tạo hệ thống và Virtual Host cho $NAME2"
_runing "$task_init"

wptt_heal_user_locks() {
  local lock_files=("/etc/passwd.lock" "/etc/shadow.lock" "/etc/group.lock" "/etc/gshadow.lock" "/etc/subuid.lock" "/etc/subgid.lock")
  for lock in "${lock_files[@]}"; do
    [[ -f "$lock" ]] && /bin/rm -f -- "$lock" 2>/dev/null
  done
}

random_suffix_USER="$(openssl rand -hex 2 2>/dev/null)"
USER="${NAME2//[-._]/$random_suffix_USER}"
((${#USER} > 32)) && USER="${USER:0:30}"

user_created=0
base_NAME2="${NAME2//[-._]/}"

for attempt in 1 2 3; do
  wptt_heal_user_locks
  if useradd -m -d "/usr/local/lsws/$NAME2" -s /sbin/nologin "$USER" >/dev/null 2>&1; then
    user_created=1
    break
  fi
  USER="${base_NAME2:0:26}_$(openssl rand -hex 2 2>/dev/null)"
  sleep 0.2
done

if ((user_created == 0)); then
  _runloi "$task_init"
  echo -e "\n${C_RED}❌ Lỗi: Không thể tạo user mới!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

usermod -L "$USER" >/dev/null 2>&1

/bin/mkdir -p /etc/wptt/tmp
chmod 700 /etc/wptt/tmp
tmp_conf_httpd="$(mktemp -p "/etc/wptt/tmp" httpd_config.XXXXXX)"
/bin/cp -fp "/usr/local/lsws/conf/httpd_config.conf" "$tmp_conf_httpd"

sed -i -e "/^virtualhost ${NAME2:?}[[:space:]]*{/,/^}/d" "$tmp_conf_httpd"
cat >>"$tmp_conf_httpd" <<EOF
virtualhost $NAME2 {
vhRoot                  /usr/local/lsws/$NAME2/
configFile              /usr/local/lsws/conf/vhosts/$NAME2/$NAME2.conf
allowSymbolLink         1
enableScript            1
restrained              1
maxKeepAliveReq         $KA_REQS
setUIDMode              2
user                    $USER
group                   $USER
}
EOF

NAME2_ESC="${NAME2//./\\.}"
sed -i -E "/^[[:space:]]*map[[:space:]]+${NAME2_ESC:?}[[:space:]]+(.*[[:space:],])?${NAME2_ESC:?}([[:space:],]|$)/d" "$tmp_conf_httpd"
sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS)[[:space:]]*\{/a \  map                     '"$NAME2 $NAME2" "$tmp_conf_httpd"

/bin/mv -fT "$tmp_conf_httpd" "/usr/local/lsws/conf/httpd_config.conf"
tmp_conf_httpd=""

/bin/mkdir -p "/usr/local/lsws/conf/vhosts/$NAME2"
touch "/usr/local/lsws/conf/vhosts/$NAME2/$NAME2.conf"
chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME2"

lsapi_namespace="2"
virt_type="$(systemd-detect-virt 2>/dev/null || true)"
if [[ "${virt_type:-}" =~ ^(lxc|lxd|openvz|docker|container|wsl)$ ]] || [[ -f /proc/user_beancounters ]]; then
  lsapi_namespace="1"
fi

NAMEPHP="${NAME2//[-._]/}"
cat >"/usr/local/lsws/conf/vhosts/$NAME2/$NAME2.conf" <<EOF
docRoot                   /usr/local/lsws/$NAME2/html
vhDomain                  $NAME2
enableGzip                1
cgroups                   0

index  {
  useServer               0
  indexFiles              index.php, index.html
  autoIndex               0
}

scripthandler  {
  add                     lsapi:$NAMEPHP php
}

accessControl  {
  allow                   *
}

lsrecaptcha  {
  enabled                 1
  type                    0
}

namespace                 ${lsapi_namespace:-2}

extprocessor $NAMEPHP {
  type                    lsapi
  address                 uds://tmp/lshttpd/$NAMEPHP.sock
  maxConns                $core_tien_lsphp_child
  env                     PHP_LSAPI_CHILDREN=$core_tien_lsphp_child
  env                     LSAPI_ACCEPT_NOTIFY=1
  env                     LSAPI_MAX_CMD_SCRIPT_PATH_LEN=200
  env                     LSAPI_AVOID_FORK=300M
  initTimeout             60
  retryTimeout            0
  pcKeepAliveTimeout      5
  respBuffer              0
  autoStart               1
  path                    /usr/local/lsws/lsphp83/bin/lsphp
  backlog                 100
  instances               1
  extUser                 $USER
  extGroup                $USER
  runOnStartUp            2
  priority                0
  memSoftLimit            2048M
  memHardLimit            2048M
  procSoftLimit           300
  procHardLimit           400
}

context / {
  location                /usr/local/lsws/$NAME2/html
  allowBrowse             1
  extraHeaders            <<<END_extraHeaders
X-XSS-Protection 1;mode=block
X-Frame-Options SAMEORIGIN
Referrer-Policy strict-origin-when-cross-origin
X-Content-Type-Options nosniff
X-Powered-By WPTangTocOLS
permissions-policy accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  END_extraHeaders
  rewrite  {
  }
  addDefaultCharset       off
  phpIniOverride  {
  }
}

rewrite  {
  enable                  1
  autoLoadHtaccess        1
/usr/local/lsws/$NAME2/html/.htaccess
}

vhssl  {
  keyFile                 /etc/wptt-ssl-tu-ky/$NAME2/$NAME2.key
  certFile                /etc/wptt-ssl-tu-ky/$NAME2/cert.crt
  certChain               0
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}

module cache {
checkPrivateCache   1
checkPublicCache    1
maxCacheObjSize     10000000
maxStaleAge         200
qsCache             1
reqCookieCache      1
respCookieCache     1
ignoreReqCacheCtrl  1
ignoreRespCacheCtrl 0
storagePath /usr/local/lsws/$NAME2/luucache
enableCache         0
expireInSeconds     3600
enablePrivateCache  0
privateExpireInSeconds 3600
  ls_enabled              1
}
EOF

ssl_dir="/etc/wptt-ssl-tu-ky/$NAME2"
key_file="$ssl_dir/$NAME2.key"
crt_file="$ssl_dir/cert.crt"
/bin/mkdir -p "$ssl_dir"
if /usr/bin/openssl req -x509 -nodes -days 3650 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -keyout "$key_file" -out "$crt_file" -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTT/CN=$NAME2" -addext "subjectAltName=DNS:$NAME2,DNS:*.$NAME2" >/dev/null 2>&1; then
  /bin/chmod 600 -- "$key_file"
  /bin/chmod 644 -- "$crt_file"
fi

tuong_thich_nhom_litespeed="nobody"
if grep -qi "ubuntu\|debian" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
fi

chown -Rh "lsadm:$tuong_thich_nhom_litespeed" "/usr/local/lsws/conf/vhosts/$NAME2"
chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME2"

/bin/mkdir -p "/usr/local/lsws/$NAME2/html" "/usr/local/lsws/$NAME2/backup-website" "/usr/local/lsws/$NAME2/luucache"
chmod 755 "/usr/local/lsws/$NAME2" "/usr/local/lsws/$NAME2/html"
chmod 700 "/usr/local/lsws/$NAME2/backup-website"
chown -Rh "$USER:$USER" "/usr/local/lsws/$NAME2/html"
chown root:root "/usr/local/lsws/$NAME2"

_rundone "$task_init"

# ==============================================================================
# 5. KHỞI TẠO DATABASE MỚI
# ==============================================================================
name_db="${NAME2//[-._]/}"
ramdom_db="$(openssl rand -hex 9 2>/dev/null)"
database="${name_db}_${ramdom_db}_dbname"
username="${name_db}_${ramdom_db}_username"
password="$(openssl rand -hex 18 2>/dev/null)"

((${#database} > 60)) && database="${database:0:60}"
((${#username} > 60)) && username="${username:0:60}"

task_db="Khởi tạo Database riêng cho website $NAME2"
_runing "$task_db"

password_database_root="$(wptt_giai_ma "${database_admin_password:-}" 2>/dev/null || true)"
[[ -z "$password_database_root" ]] && password_database_root="${database_admin_password:-}"

umask 077
TEMP_CNF_ROOT="$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)"
umask 022

cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username:-root}"
password="${password_database_root}"
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4
EOF

if ! mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false <<EOF_SQL; then
DROP DATABASE IF EXISTS \`${database}\`;
CREATE DATABASE IF NOT EXISTS \`${database}\`;
DROP USER IF EXISTS '${username}'@'localhost';
CREATE USER IF NOT EXISTS '${username}'@'localhost' IDENTIFIED BY '${password}';
GRANT ALL PRIVILEGES ON \`${database}\`.* TO '${username}'@'localhost';
FLUSH PRIVILEGES;
EOF_SQL
  _runloi "$task_db"
  echo -e "${C_RED}❌ Lỗi: MariaDB từ chối tạo Database/User!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi
_rundone "$task_db"

# ==============================================================================
# 6. COPY DỮ LIỆU & TÌM KIẾM THAY THẾ (TỐI ƯU I/O)
# ==============================================================================
task_clone="Nhân bản dữ liệu và đồng bộ cấu hình từ $NAME sang$NAME2"
_runing "$task_clone"

# shellcheck source=/dev/null
if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then . "/etc/wptt/vhost/.$NAME.conf"; fi
php_ver_chon="${phien_ban_php_domain:-83}"
php_ver_chon="${php_ver_chon//[-._]/}"

sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "/usr/local/lsws/conf/vhosts/$NAME2/$NAME2.conf"

PHP_EXEC=("/usr/local/lsws/lsphp${php_ver_chon}/bin/php")
WP_CLI_FLAGS=(--allow-root --quiet --skip-plugins --skip-themes --skip-packages)

IS_SQLITE_SOURCE=0
if [[ -f "/usr/local/lsws/$NAME/html/wp-content/db.php" ]] && grep -qi "sqlite" "/usr/local/lsws/$NAME/html/wp-content/db.php" 2>/dev/null; then
  IS_SQLITE_SOURCE=1
fi

# Clone Database bằng Direct Pipe Siêu tốc
if ((IS_SQLITE_SOURCE == 0)) && [[ -n "${DB_Name_web:-}" ]]; then
  (
    echo "SET AUTOCOMMIT=0; SET UNIQUE_CHECKS=0; SET FOREIGN_KEY_CHECKS=0;"
    mariadb-dump --defaults-extra-file="$TEMP_CNF_ROOT" --single-transaction --quick --routines --triggers "$DB_Name_web" --ssl-verify-server-cert=false 2>/dev/null
    echo "SET FOREIGN_KEY_CHECKS=1; SET UNIQUE_CHECKS=1; SET AUTOCOMMIT=1; COMMIT;"
  ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$database" --ssl-verify-server-cert=false >/dev/null 2>&1
fi
/bin/rm -f -- "${TEMP_CNF_ROOT:?}"
TEMP_CNF_ROOT=""

duong_dan_nguon_cu="/usr/local/lsws/$NAME/html"
duong_dan_nguon_moi="/usr/local/lsws/$NAME2/html"

# Clone File bằng `cp -a` (Giữ nguyên phân quyền, chủ sở hữu của file cũ, nhanh hơn find -exec)
/bin/cp -a "$duong_dan_nguon_cu/." "$duong_dan_nguon_moi/"

# Xóa cache rác & sửa quyền Root thư mục mới
/bin/rm -rf -- "$duong_dan_nguon_moi/wp-content/cache" "$duong_dan_nguon_moi/wp-content/.litespeed_conf.dat" 2>/dev/null
((IS_SQLITE_SOURCE == 0)) && /bin/rm -f -- "$duong_dan_nguon_moi/wp-content/db.php" 2>/dev/null

if command -v lsattr >/dev/null 2>&1 && [[ -f "$duong_dan_nguon_moi/wp-config.php" ]]; then
  chattr -i -R "$duong_dan_nguon_moi" 2>/dev/null || true
fi

chown -Rh "$USER:$USER" "$duong_dan_nguon_moi"

if [[ -f "$duong_dan_nguon_moi/wp-config.php" ]]; then
  sed -i "/WP_SITEURL/d" "$duong_dan_nguon_moi/wp-config.php"
  sed -i "/WP_HOME/d" "$duong_dan_nguon_moi/wp-config.php"
fi

# Đổi config DB & Salt Key (Batch WP-CLI không tải WP core)
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set DB_HOST 'localhost' --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set DB_NAME "$database" --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set DB_USER "$username" --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set DB_PASSWORD --prompt --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" <<<"$password" >/dev/null 2>&1
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set WP_CACHE_KEY_SALT "${NAME2}_$(openssl rand -hex 4)" --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config shuffle-salts --force --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1

cd "$duong_dan_nguon_moi" || exit 1

# Tìm kiếm thay thế URL (Tốc độ cao nhờ bỏ qua plugins/themes)
timeout 180 "${PHP_EXEC[@]}" /usr/local/bin/wp search-replace "//${NAME}" "//${NAME2}" --path="$duong_dan_nguon_moi" --all-tables "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
timeout 180 "${PHP_EXEC[@]}" /usr/local/bin/wp search-replace "/usr/local/lsws/${NAME}/html" "/usr/local/lsws/${NAME2}/html" --path="$duong_dan_nguon_moi" --all-tables "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1

# Xử lý SQLite riêng
if ((IS_SQLITE_SOURCE == 1)); then
  timeout 30 "${PHP_EXEC[@]}" /usr/local/bin/wp config set WP_SQLITE_AST_DRIVER true --raw --type=constant --path="$duong_dan_nguon_moi" "${WP_CLI_FLAGS[@]}" >/dev/null 2>&1
