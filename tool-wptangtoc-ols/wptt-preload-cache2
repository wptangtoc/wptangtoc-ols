else
  _rundone "Tìm thấy Sitemap: $NAME2"
fi

# Xác định công cụ Cache (Dùng pure bash string matching thay cho echo | grep)
cong_cu=""
if [[ "$check" != *[Ll]ite[Ss]peed* ]]; then
  pluginsspeed=(cache-enabler fast-velocity-minify wp-rocket w3-total-cache wp-super-cache wp2speed nitropack wp-fastest-cache hummingbird-performance swift-performance-lite swift-performance-pro breeze wp-meteor phastpress flying-press simple-cache powered-cache yasakani-cache batcache sg-cachepress cloudflare wp-optimize)
  for plugintt in "${pluginsspeed[@]}"; do
    pathcheckplugin3="/usr/local/lsws/${NAME_path}/html/wp-content/plugins/$plugintt"
    if [[ -d "$pathcheckplugin3" ]]; then
      plugintt2="${plugintt//-/ }"
      echo -e "${C_GREEN}Xác nhận bạn đang sử dụng công nghệ cache: ${C_YELLOW}$plugintt2${C_RESET}"
      cong_cu="wptt-preload-cache-all.sh"
    fi
  done
  if [[ -f "/usr/local/lsws/${NAME_path}/html/wp-content/plugins/wptangtoc/class/Cache.php" ]]; then
    echo -e "${C_GREEN}Đang sử dụng hệ thống WPTangToc Cache${C_RESET}"
    cong_cu="wptt-preload-cache-all.sh"
  fi
  if [[ -z "$cong_cu" ]]; then
    _runloi "Hệ thống xác định bạn chưa sử dụng công nghệ cache tương thích nào."
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi
else
  echo -e "${C_GREEN}Xác nhận bạn đang sử dụng công nghệ: ${C_YELLOW}LiteSpeed Cache${C_RESET}"
  cong_cu="wptt-preload-cache-all.sh"
fi

# =======================================================================
# 3. KIỂM TRA & TỰ ĐỘNG ĐIỀU TIẾT TÀI NGUYÊN HỆ THỐNG (ADAPTIVE PREFLIGHT)
# =======================================================================
# Dọn dẹp tiến trình preload cũ bị kẹt của đúng domain này (An toàn bằng pkill -f)
pkill -f "wptt-preload-cache-all.sh.*${domain}" >/dev/null 2>&1 || true

CPU_CORES=$(get_cpu_cores)
cpu_su_dung=$(get_realtime_cpu_usage)
read -r ram_sudung ram_avail_mb <<< "$(get_ram_stats)"

# Tính toán khoảng nghỉ động (Dynamic Interval) dựa trên sức khỏe VPS hiện tại
CRAWL_INTERVAL="0.3"
SPIDER_WAIT="1"

if ((cpu_su_dung > 92)); then
  _runloi "Cảnh báo: CPU đang quá tải ($cpu_su_dung%). Tạm dừng để bảo vệ server."
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

if ((ram_sudung > 92 && ram_avail_mb < 64)); then
  _runloi "Cảnh báo: RAM đang đầy ($ram_sudung%). Tạm dừng để bảo vệ server."
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# Nếu máy chủ RAM thấp (<= 1GB) hoặc đang chịu tải trung bình (> 70%), tự động giảm tốc độ cào
if ((ram_avail_mb < 256 || cpu_su_dung > 70 || ram_sudung > 75)); then
  CRAWL_INTERVAL="1.2"
  SPIDER_WAIT="2"
  echo -e "${C_YELLOW}⚡ Phát hiện máy chủ đang bận (CPU: ${cpu_su_dung}%, RAM: ${ram_sudung}%) -> Tự động kích hoạt chế độ Tiết kiệm Tài nguyên (Interval: ${CRAWL_INTERVAL}s).${C_RESET}"
fi

# =======================================================================
# 4. PHÂN NHÁNH THỰC THI (SITEMAP HOẶC SPIDER LOCALHOST TRỰC QUAN)
# =======================================================================
echo ""
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}TIẾN TRÌNH PRELOAD ĐANG CHẠY${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

trang_thai_bao_loi_preload_cache=0

if [[ "$spider_mode" = false ]]; then
  # TRƯỜNG HỢP 1: CÓ SITEMAP
  # Gộp các cờ để chỉ phải tải và phân tích XML Sitemap 1 LẦN DUY NHẤT (Tiết kiệm 50-70% RAM & I/O)
  crawler_args=("-i" "$CRAWL_INTERVAL")

  if ((grepmobile != 0)); then
    left_text "  ➜ Tạo cache Mobile & Desktop giao diện..." 2
    crawler_args+=("-m" "-g")
  else
    left_text "  ➜ Tạo cache mặc định..." 2
  fi

  if ((grepwebp != 0)); then
    left_text "  ➜ Kích hoạt luồng nạp bộ nhớ đệm định dạng WebP..." 2
    crawler_args+=("-w")
  fi

  ionice -c 3 nice -n 19 /bin/bash "/etc/wptt/$cong_cu" "${crawler_args[@]}" "${NAME2}" || trang_thai_bao_loi_preload_cache=$?

else
  # TRƯỜNG HỢP 2: KHÔNG CÓ SITEMAP (SPIDER LOCALHOST ROUTING + ADAPTIVE THROTTLE)
  UA_DESKTOP="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  UA_MOBILE="Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) Version/16.0 Mobile/15E148"
  HEADER_WEBP="Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"

  REGEX_REJECT="(wp-content|wp-includes|/wp-admin/|/wp-json/|/feed/|\.php|\.png|\.jpg|\.jpeg|\.gif|\.css|\.js|\.svg|\.woff|\.zip|p=|replytocom=|attachment_id=|s=|add-to-cart=|/%20|add_to_wishlist=|add_to_compare=|add-to-wishlist|tel:|action=|filtera-kich-thuoc=|product-cato=|price=|designId=|wmc-currency=)"

  # Tạo file hosts ảo an toàn trong /etc/wptt/tmp (Chống Symlink Attack ở /tmp)
  /bin/mkdir -p /etc/wptt/tmp
  chmod 700 /etc/wptt/tmp
  FAKE_HOSTS=$(mktemp -p /etc/wptt/tmp "wptt_hosts_fake_${NAME}.XXXXXX")
  /bin/cp -f -- /etc/hosts "$FAKE_HOSTS"
  printf "127.0.0.1\t%s\n127.0.0.1\twww.%s\n" "${domain#www.}" "${domain#www.}" >>"$FAKE_HOSTS"
  chmod 644 "$FAKE_HOSTS"

  # Hàm xử lý in log thời gian thực thuần Bash (Zero-Subshell: Không gọi grep/sed trong mỗi dòng log)
  process_spider_log() {
    local current_url="" line url_count=0
    while IFS= read -r line; do
      # 1. Bắt dòng "--YYYY-MM-DD HH:MM:SS--  http..." của wget bằng Bash Regex
      if [[ "$line" =~ ^--[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9:]+--\ \ (https?://.+) ]]; then
        current_url="${BASH_REMATCH[1]}"
        if [[ ! "${current_url,,}" =~ $REGEX_REJECT ]]; then
          printf "\r\033[K      \033[0;33mĐang quét:\033[0m \033[0;36m%s\033[0m" "$current_url"
        else
          current_url=""
        fi
      # 2. Bắt dòng "200 OK" bằng Bash Glob
      elif [[ "$line" == *"200 OK"* ]]; then
        if [[ -n "$current_url" ]]; then
          printf "\r\033[K      \033[0;32mĐã nạp Cache:\033[0m %s\n" "$current_url"
          current_url=""
          ((url_count++))
          # Cứ mỗi 10 URLs kiểm tra tải máy chủ 1 lần để tự động phanh nếu VPS quá tải
          if ((url_count % 10 == 0)); then
            adaptive_throttle_check "$CPU_CORES"
          fi
        fi
      fi
    done
    echo ""
  }

  # Hàm chạy spider cách ly namespace mạng/mount an toàn, có fallback nếu container chặn unshare
  run_spider_pass() {
    local ua="$1"
    local extra_header="${2:-}"
    local wget_args=(
      -r -l 3 -nd --delete-after
      -w "$SPIDER_WAIT" -T 5 -t 1
      "--domains=${domain}"
      --no-check-certificate
      "--reject-regex=${REGEX_REJECT}"
      -U "$ua"
    )
    [[ -n "$extra_header" ]] && wget_args+=("--header=$extra_header")
    wget_args+=("${ssl}://${domain}/")

    if unshare -m true 2>/dev/null; then
      unshare -m /bin/bash -c '
        mount --bind "$1" /etc/hosts 2>/dev/null || true
        shift
        exec ionice -c 3 nice -n 19 wget "$@"
      ' _ "$FAKE_HOSTS" "${wget_args[@]}" 2>&1 | process_spider_log
    else
      # Fallback nếu chạy trong môi trường container (Docker/LXC) không cấp quyền unshare mount
      ionice -c 3 nice -n 19 wget "${wget_args[@]}" 2>&1 | process_spider_log
    fi
  }

  left_text "  ➜ Cào liên kết chế độ mặc định" 2
  run_spider_pass "$UA_DESKTOP" "" || trang_thai_bao_loi_preload_cache=$?

  if ((grepmobile != 0)); then
    left_text "  ➜ Cào liên kết chế độ Mobile" 2
    run_spider_pass "$UA_MOBILE" "" || trang_thai_bao_loi_preload_cache=$?
  fi

  if ((grepwebp != 0)); then
    left_text "  ➜ Cào liên kết chế độ WebP" 2
    run_spider_pass "$UA_DESKTOP" "$HEADER_WEBP" || trang_thai_bao_loi_preload_cache=$?
  fi

  if [[ -n "$FAKE_HOSTS" && -f "$FAKE_HOSTS" ]]; then
    /bin/rm -f -- "${FAKE_HOSTS:?}"
    FAKE_HOSTS=""
  fi
fi

echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

