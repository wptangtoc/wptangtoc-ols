# 0. QUẢN LÝ TÀI NGUYÊN TẠM & BẪY LỖI AN TOÀN (TRAP CLEANUP)
# =======================================================================
FAKE_HOSTS=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${FAKE_HOSTS:-}" && -f "$FAKE_HOSTS" ]]; then
    case "$FAKE_HOSTS" in
      /etc/wptt/tmp/*) /bin/rm -f -- "${FAKE_HOSTS:?}" ;;
    esac
  fi
  exit "$rc"
}
