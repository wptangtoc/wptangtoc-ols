  _rundone "Preload cache thành công cho website: $NAME"
else
  _runloi "Preload cache thất bại website: $NAME"
fi

wptt_quay_ve_menu "${1:-}" "${trang_thai_bao_loi_preload_cache:-0}" "enter"
