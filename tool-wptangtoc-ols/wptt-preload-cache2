# =======================================================================
# HÀM ĐO LƯỜNG TÀI NGUYÊN SIÊU TỐC (PURE BASH BUILT-IN - ZERO SUBSHELL)
# =======================================================================
get_cpu_cores() {
  local cores=0 line
  if [[ -r /proc/cpuinfo ]]; then
    while IFS= read -r line; do
      [[ "$line" == processor* ]] && ((cores++))
    done < /proc/cpuinfo
  fi
  ((cores == 0)) && cores=1
  printf '%s' "$cores"
}

# Đọc trực tiếp /proc/stat tại 2 thời điểm cách nhau 0.2s để lấy tải CPU THỰC TẾ
get_realtime_cpu_usage() {
  local _cpu u1 n1 s1 i1 w1 x1 y1 z1 u2 n2 s2 i2 w2 x2 y2 z2
  read -r _cpu u1 n1 s1 i1 w1 x1 y1 z1 < /proc/stat
  sleep 0.2
  read -r _cpu u2 n2 s2 i2 w2 x2 y2 z2 < /proc/stat

  local idle1=$((i1 + w1))
  local idle2=$((i2 + w2))
  local total1=$((u1 + n1 + s1 + i1 + w1 + x1 + y1 + z1))
  local total2=$((u2 + n2 + s2 + i2 + w2 + x2 + y2 + z2))

  local diff_idle=$((idle2 - idle1))
  local diff_total=$((total2 - total1))
  if ((diff_total <= 0)); then
    printf '0'
    return 0
  fi
  local usage=$(( (100 * (diff_total - diff_idle)) / diff_total ))
  printf '%s' "$usage"
}

# Đọc trực tiếp /proc/meminfo không qua lệnh free hay awk
get_ram_stats() {
  local key val _unit total=0 avail=0 free_mem=0 buffers=0 cached=0
  while read -r key val _unit; do
    case "$key" in
      MemTotal:) total="$val" ;;
      MemAvailable:) avail="$val" ;;
      MemFree:) free_mem="$val" ;;
      Buffers:) buffers="$val" ;;
      Cached:) cached="$val" ;;
    esac
  done < /proc/meminfo

  if ((avail == 0)); then
    avail=$((free_mem + buffers + cached))
  fi
  local used_pct=0
  if ((total > 0)); then
    used_pct=$(( (total - avail) * 100 / total ))
  fi
  local avail_mb=$((avail / 1024))
  printf '%s %s' "$used_pct" "$avail_mb"
}

# Hàm tự động phanh (Adaptive Throttling) khi máy chủ tăng tải giữa chừng
adaptive_throttle_check() {
  local cores="${1:-1}"
  local load1 _rest load_int
  read -r load1 _rest < /proc/loadavg
  load_int="${load1%%.*}"
  [[ -z "$load_int" ]] && load_int=0

  local ram_used_pct ram_avail_mb
  read -r ram_used_pct ram_avail_mb <<< "$(get_ram_stats)"

  # Ngưỡng nguy hiểm: RAM trống < 64MB hoặc Load > 2 lần số nhân CPU
  if ((ram_avail_mb < 64 || load_int >= cores * 2)); then
    printf "\r\033[K      \033[0;31m[Bảo vệ Server]\033[0m Tải cao (Load: %s, RAM trống: %sMB) -> Tạm nghỉ 8s...\n" "$load1" "$ram_avail_mb"
    sleep 8
  elif ((ram_used_pct > 85 || load_int >= cores)); then
    # Ngưỡng cảnh báo: Tự động giãn nhịp thở thêm 2 giây
    sleep 2
  fi
}

