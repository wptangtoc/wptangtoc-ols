[[ "$check" == *"Android"* ]] && grepmobile=1
grepwebp=0
[[ "$check" == *"+webp"* ]] && grepwebp=1

# =======================================================================
# 2. TÌM KIẾM SITEMAP & PHÂN LOẠI CÔNG NGHỆ CACHE
# =======================================================================
TASK_SITEMAP="Đang quét cấu trúc Sitemap..."
_runing "$TASK_SITEMAP"
