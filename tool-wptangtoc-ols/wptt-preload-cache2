TASK_CONN="Kiểm tra kết nối cho website: $NAME"
_runing "$TASK_CONN"

# Hàm kiểm tra HTTP 200 siêu nhẹ không dùng pipe head/grep
probe_http_200() {
  local target_url="$1"
  local connect_domain="${2#www.}"
  local code
  code=$(curl -kIs -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 \
    --connect-to "${connect_domain}::127.0.0.1:443" \
    --connect-to "${connect_domain}::127.0.0.1:80" \
    -A "WPTangToc OLS preload cache" "$target_url" 2>/dev/null || true)
  [[ "$code" == "200" ]]
}

checkssl=0; checkssl2=0; checkssl3=0; checkssl4=0
if probe_http_200 "https://${domain}" "$domain"; then
  checkssl=1
elif probe_http_200 "https://www.${domain}" "$domain"; then
  checkssl3=1
elif probe_http_200 "http://${domain}" "$domain"; then
  checkssl2=1
elif probe_http_200 "http://www.${domain}" "$domain"; then
  checkssl4=1
fi

