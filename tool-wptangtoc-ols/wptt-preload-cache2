  echo -e "${C_RED}Website $NAME ngưng hoạt động hoặc không phản hồi nội bộ.${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi
_rundone "$TASK_CONN"

check=""
if [[ -n "${vhost_chuyen_htaccess:-}" && -f "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf" ]]; then
  check=$(sed -e '/^context/,/^}$/!d' -e '/rewrite/,/^}$/!d' "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf" 2>/dev/null || true)
elif [[ -f "/usr/local/lsws/$NAME/html/.htaccess" ]]; then
  check=$(<"/usr/local/lsws/$NAME/html/.htaccess")
fi

NAME_path="$NAME"
if ((checkssl3 == 1 || checkssl4 == 1)); then
  domain="www.${domain#www.}"
fi

ssl="http"
((checkssl == 1 || checkssl3 == 1)) && ssl="https"

