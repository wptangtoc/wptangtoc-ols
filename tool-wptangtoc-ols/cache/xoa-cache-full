#!/bin/bash
. /etc/wptt/.wptt.conf

if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

echo ""
echo ""
echo ""
echo "========================================================================="
echo "|$quan_ly_cache => $xoa_all_cache_wordpress                       |"
echo "========================================================================="
echo ""
echo ""
echo "$xac_nhan $xoa_all_cache_wordpress"
prompt="$nhap_lua_chon_cua_ban [1-2]: "
dongy="n"
options=("$dong_y" "$khong_dong_y")

PS3="$prompt"
select opt in "${options[@]}"; do
  case "$REPLY" in
  1)
    dongy="y"
    break
    ;;

  2)
    dongy="n"
    break
    ;;

  $((${#options[@]} + 1)))
    printf "\n$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"
    break
    ;;
  *)
    printf "$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"
    break
    ;;
  esac
done

. /etc/wptt/echo-color
if [[ "$dongy" = "y" ]]; then
  if [ "$(ls -At /etc/wptt/vhost)" ]; then
    i=1
	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		NAME="${filepath##*/}" #cắt hết / ở phía truớc chỉ dữ giá trị / ở sau còn dữ lại như: .wptangtoc.com.conf
		NAME="${NAME%.conf}" #cắt .conf ở phía sau => còn: .wptangtoc.com
		NAME="${NAME#.}" #cắt . ở phía truớc => còn wptangtoc.com

		if [[ "$NAME" != ?*.?* ]]; then #yêu cầu phải có dấu . trong NAME thì mới gọi là NAME đúng, nếu không có . thì continue nhảy qua for 
			continue
		fi
      path="/usr/local/lsws/$NAME/html"
      if [[ ! -f $path/wp-load.php ]]; then
        echo "$don_dep cache cho website $NAME $khong_thanh_cong"
        echo "$tinh_nang_nay_chi_danh_cho_ma_nguon_wordpress"
        continue
      fi

      _runing "$don_dep cache website $NAME"
      . /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1
      _rundone "$don_dep cache website $NAME"
    done
  fi
fi

check_menu_wptangtoc_active=$1
if [[ $check_menu_wptangtoc_active = "98" ]]; then
  exec /etc/wptt/wptt-cache-main 1
fi
