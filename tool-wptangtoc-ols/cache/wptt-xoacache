# ----------------- AUTOPTIMIZE -----------------
if grep -q 'autoptimize' <<< "$plugins_active"; then
  _runing "$don_dep cache autoptimize"
  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp eval 'autoptimizeCache::clearall();' --allow-root --path="$path2" >/dev/null 2>&1
  if [ $? -eq 0 ]; then
    _rundone "$don_dep cache autoptimize"
  else
    _runloi "$don_dep cache autoptimize"
  fi
fi

# ----------------- CLOUDFLARE -----------------
if [[ -f "/etc/wptt/cloudflare-cdn-cache/.wptt-$NAME.conf" ]] || grep -q 'cloudflare' <<< "$plugins_active"; then
  unset TRACE_OUTPUT
  TRACE_OUTPUT=$(curl -Is --connect-timeout 5 --max-time 10 "https://$NAME/cdn-cgi/trace" 2>/dev/null)
  
  if grep -q 'cloudflare' <<< "$plugins_active"; then
    _runing "$don_dep cache cloudflare apo"
    /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp eval '$apo_api = new \CF\WordPress\Hooks(); $apo_api->purgeCacheEverything();' --allow-root --path="$path2" >/dev/null 2>&1
    if [ $? -eq 0 ]; then
      . /etc/wptt/cache/cloudflare-cdn-cache-xoa "$NAME" >/dev/null 2>&1
	  cloudflare_cdn_apo='1'
      _rundone "$don_dep cache cloudflare apo"
    else
      _runloi "$don_dep cache cloudflare apo"
    fi
  fi


  if [[ -z "$cloudflare_cdn_apo" ]];then
	  if grep -Eqi 'cloudflare|cf-ray' <<< "$TRACE_OUTPUT"; then 
		  if [[ -f /etc/wptt/cloudflare-cdn-cache/.wptt-$NAME.conf ]]; then
			  _runing "$don_dep cache cloudflare CDN"
			  . /etc/wptt/cache/cloudflare-cdn-cache-xoa "$NAME" >/dev/null 2>&1
			  if [ $? -eq 0 ]; then
				  _rundone "$don_dep cache cloudflare CDN"
			  else
				  _runloi "$don_dep cache cloudflare CDN"
			  fi
		  fi
	  fi
  fi

fi

