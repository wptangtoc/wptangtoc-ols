  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp flying-press purge-everything --allow-root --path="$path2" >/dev/null 2>&1
