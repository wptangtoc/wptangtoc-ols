#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  Đây là tính năng xoá cache website WordPress
  Nó sẽ giúp bạn tự động xoá cache: OpCache, Object Cache, Page Cache HTML, CDN Cache
  Với điều kiện: website bạn đang sử dụng công nghệ Cache đó

  Tính năng Xóa toàn bộ cache WordPress là hành động loại bỏ tất cả các dữ liệu đã được lưu trữ tạm thời [bộ nhớ đệm] mà website WordPress của bạn sử dụng để tăng tốc độ tải trang và giảm tải cho máy chủ.

  Nói một cách đơn giản, đây là việc bạn dọn dẹp các bản sao lưu trữ sẵn của trang web, buộc WordPress phải tạo lại nội dung mới nhất từ cơ sở dữ liệu và các tệp gốc khi có người truy cập tiếp theo.

  Mục Đích Chính
  * Xem các thay đổi mới nhất: Đây là lý do phổ biến nhất. Nếu bạn vừa cập nhật nội dung, thiết kế, cài đặt theme/plugin, hoặc sửa file CSS/JS, những thay đổi này có thể không hiển thị ngay do website đang phục vụ phiên bản cũ từ cache. Xóa cache sẽ buộc website hiển thị phiên bản mới nhất.
  * Gỡ lỗi sự cố: Khi website hoạt động không như mong đợi [lỗi giao diện, thông tin cũ, lỗi hiển thị], xóa cache là một trong những bước đầu tiên để kiểm tra xem có phải do cache bị lỗi thời hay hỏng không.
  * Sau khi cập nhật: Sau khi cập nhật WordPress, theme, hoặc plugin, việc xóa cache được khuyến nghị để đảm bảo tính tương thích và các tính năng/bản vá mới được áp dụng đúng cách.
  * Khắc phục tình trạng website bị kẹt: Đôi khi website bị đóng băng ở một phiên bản cũ, xóa cache có thể giải quyết được vấn đề này.

  Sau khi xóa toàn bộ cache, lần truy cập tiếp theo vào website có thể chậm hơn một chút do máy chủ phải tạo lại mọi thứ từ đầu. Tuy nhiên, điều này đảm bảo bạn và người dùng sẽ thấy được phiên bản mới nhất và chính xác nhất của website.
EOF
}

. /etc/wptt/echo-color 2>/dev/null
NAME="${1:-}"
if [[ "$NAME" == "98" ]]; then
  NAME=""
fi

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null

if [[ -z "${ngon_ngu:-}" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

if [[ -z "$NAME" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}$quan_ly_cache ➜ $don_dep cache${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$don_dep $toan_bo Cache"
fi

# ==============================================================================
# 1. CHẾ ĐỘ XÓA CACHE HÀNG LOẠT (TẤT CẢ WEBSITE WORDPRESS)
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  wp_domains=()
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    dom="${filepath##*/}"
    dom="${dom%.conf}"
    dom="${dom#.}"
    if [[ "$dom" == ?*.?* && -f "/usr/local/lsws/$dom/html/wp-config.php" ]]; then
      wp_domains+=("$dom")
    fi
  done

  tong_so_web="${#wp_domains[@]}"
  if ((tong_so_web == 0)); then
    echoDo "Hệ thống hiện không có website WordPress nào để xóa cache!"
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi

  mapfile -t wp_domains < <(printf "%s\n" "${wp_domains[@]}" | sort -uV)
  tong_so_web="${#wp_domains[@]}"

  print_border_top
  center_text "${C_YELLOW}DASHBOARD THAO TÁC HÀNG LOẠT${C_RESET}"
  print_border_mid
  left_text "▪ Tổng số   : ${C_GREEN}$tong_so_web website WordPress${C_RESET}" 2
  left_text "▪ Nhiệm vụ  : ${C_GREEN}$don_dep $toan_bo Cache website${C_RESET}" 2
  print_border_bot

  tien_do=1
  for domain in "${wp_domains[@]}"; do
    _runing "[ $tien_do / $tong_so_web ] $don_dep $toan_bo Cache" "$domain"
    if /bin/bash /etc/wptt/cache/wptt-xoacache "$domain" >/dev/null 2>&1; then
      _rundone "[ $tien_do / $tong_so_web ] $don_dep $toan_bo Cache" "$domain"
    else
      _runloi "[ $tien_do / $tong_so_web ] $don_dep $toan_bo Cache" "$domain"
    fi
    ((tien_do++))
  done

  # Bồi thêm 1 phát xóa OpCache cấp toàn cục sau khi dọn hàng loạt
  if ! declare -F wptt_xoa_opcache >/dev/null 2>&1 && [[ -f /etc/wptt/cache/lib-opcache-clear ]]; then
    . /etc/wptt/cache/lib-opcache-clear
  fi
  declare -F wptt_xoa_opcache >/dev/null 2>&1 && wptt_xoa_opcache "all" >/dev/null 2>&1 || true

  wptt_quay_ve_menu "${1:-}" 0
fi

# ==============================================================================
# 2. KIỂM TRA ĐIỀU KIỆN ĐẦU VÀO CHO 1 WEBSITE
# ==============================================================================
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "${1:-}" 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "$ten_mien_nay_khong_ton_tai_tren_he_thong"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

path2="/usr/local/lsws/$NAME/html"
if [[ ! -f "$path2/wp-load.php" ]]; then
  echoDo "$he_thong_xac_nhan_ban_khong_su_ma_nguon"
  echoDo "$tinh_nang_nay_chi_danh_cho_ma_nguon_wordpress"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

wptt_logs "INFO" "Xoá Cache website $NAME"
wptt_load_vhost_conf "$NAME"

if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP" "$NAME"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# Chuỗi thực thi WP-CLI chuẩn Enterprise: Hạ quyền xuống user vhost + cấp 512M RAM + chống kẹt proc_open
wp_exec=(
  /sbin/runuser -u "$User_name_vhost" --
  "/usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php"
  -d disable_functions=""
  -d memory_limit=512M
  -d max_execution_time=600
  /usr/local/bin/wp
)

# ==============================================================================
# 3. QUÉT DANH SÁCH PLUGIN ĐANG KÍCH HOẠT (0-SUBSHELL MATCHING)
# ==============================================================================
plugins_active="$("${wp_exec[@]}" plugin list --field=name --status=active --skip-plugins --skip-themes --quiet --path="$path2" 2>/dev/null)"
wp_status=$?

if ((wp_status != 0)); then
  wptt_logs "WARNING" "WP-CLI thất bại khi đọc plugin tại $path2 (Lỗi kết nối DB). Kích hoạt Fallback quét thư mục..."
  plugin_dir="$path2/wp-content/plugins"
  plugins_active=""
  if [[ -d "$plugin_dir" ]]; then
    for pdir in "$plugin_dir"/*/; do
      [[ -d "$pdir" ]] || continue
      pdir="${pdir%/}"
      plugins_active+="${pdir##*/}"$'\n'
    done
    wptt_logs "INFO" "Fallback: Đã lấy danh sách plugin bằng Pure Bash globbing."
  else
    wptt_logs "ERROR" "Thư mục plugins không tồn tại: $plugin_dir"
  fi
fi

# Chuẩn hóa danh sách plugin có ký tự xuống dòng bọc 2 đầu để tra cứu 0-subshell chính xác tuyệt đối
PLUGINS_NL=$'\n'"${plugins_active//$'\r'/}"$'\n'

_has_plugin() {
  [[ "$PLUGINS_NL" == *$'\n'"$1"$'\n'* ]]
}

# Hàm trợ giúp chạy lệnh xóa cache qua WP-CLI gọn gàng
_wp_clear_step() {
  local label="$1"
  shift
  _runing "$label" "$NAME"
  if "${wp_exec[@]}" "$@" --path="$path2" >/dev/null 2>&1; then
    _rundone "$label" "$NAME"
    return 0
  else
    _runloi "$label" "$NAME"
    return 1
  fi
}

# Hàm Atomic Swap xóa thư mục Cache vật lý với Zero-Downtime (0ms khóa I/O)
_atomic_purge_dir() {
  local target_dir="$1"
  [[ -d "$target_dir" && ! -L "$target_dir" ]] || return 1
  local trash_dir="${target_dir}_trash_${EPOCHSECONDS:-$(date +%s)}_${RANDOM}"

  if mv -T -- "$target_dir" "$trash_dir" 2>/dev/null; then
    # Tái tạo ngay thư mục rỗng đúng quyền để Webserver/Plugin ghi cache mới không bị lỗi
    mkdir -p "$target_dir" 2>/dev/null || true
    chown "$User_name_vhost:$User_name_vhost" "$target_dir" 2>/dev/null || true
    chmod 0755 "$target_dir" 2>/dev/null || true
    (
      exec </dev/null >/dev/null 2>&1
      ionice -c 3 nice -n 19 rm -rf -- "$trash_dir"
    ) &
    disown $! 2>/dev/null || true
    return 0
  fi
  return 1
}

echo -e "\n${C_BOLD_WHITE}▸ $don_dep $toan_bo cache website ${C_CYAN}$NAME${C_RESET}:"

# ==============================================================================
# 4. XÓA TỪNG TẦNG CACHE (OPCACHE -> OBJECT -> PAGE CACHE -> ASSETS -> CDN)
# ==============================================================================

# ----------------- OPCACHE -----------------
TASK_OPCACHE="$don_dep Cache OpCache"
_runing "$TASK_OPCACHE" "$NAME"
if ! declare -F wptt_xoa_opcache >/dev/null 2>&1; then
  . /etc/wptt/cache/lib-opcache-clear
fi
if wptt_xoa_opcache "$NAME"; then
  _rundone "$TASK_OPCACHE" "$NAME"
else
  _runloi "$TASK_OPCACHE" "$NAME"
fi

# ----------------- WP OBJECT CACHE -----------------
_wp_clear_step "$don_dep WP Object Cache" cache flush

# ----------------- LITESPEED CACHE -----------------
if _has_plugin "litespeed-cache"; then
  _runing "$don_dep cache LiteSpeed Cache" "$NAME"

  purge_output="$("${wp_exec[@]}" litespeed-purge all --path="$path2" 2>&1)"
  purge_rc=$?

  # Kiểm tra nếu WP-CLI báo lỗi hoặc văng lỗi cURL / DNS / Timeout
  if ((purge_rc != 0)) || [[ "$purge_output" == *"cURL error"* || "$purge_output" == *"Could not resolve"* || "$purge_output" == *"Error:"* ]]; then
    # Chuyển thẳng sang Cú Đấm Thép: Xóa thư mục lscache vật lý của RIÊNG domain này bằng Atomic Swap
    # (Tuyệt đối không xóa /usr/local/lsws/cachedata toàn cục để bảo vệ các website khác trên VPS)
    CACHE_DIR_LOCAL="/usr/local/lsws/$NAME/lscache"
    if [[ -d "$CACHE_DIR_LOCAL" ]]; then
      if _atomic_purge_dir "$CACHE_DIR_LOCAL"; then
        _rundone "$don_dep cache LiteSpeed Cache (Vật lý)" "$NAME"
      else
        _runloi "$don_dep cache LiteSpeed Cache (Lỗi lscache)" "$NAME"
      fi
    elif [[ -d "/usr/local/lsws/cachedata/$NAME" ]]; then
      if _atomic_purge_dir "/usr/local/lsws/cachedata/$NAME"; then
        _rundone "$don_dep cache LiteSpeed Cache (Vật lý)" "$NAME"
      else
        _runloi "$don_dep cache LiteSpeed Cache (Lỗi cachedata)" "$NAME"
      fi
    else
      # Nếu chưa phát sinh thư mục lscache trên ổ cứng thì coi như cache đã trống
      _rundone "$don_dep cache LiteSpeed Cache" "$NAME"
    fi
  else
    _rundone "$don_dep cache LiteSpeed Cache" "$NAME"
  fi

  # Xóa Object Cache (Redis/Memcached/LSMCD) do LiteSpeed quản lý nếu có
  if [[ -f "$path2/wp-content/object-cache.php" ]]; then
    if grep -q 'litespeed_conf' "$path2/wp-content/object-cache.php" 2>/dev/null; then
      if [[ -f "${duong_dan_config_redis:-}" || -f "${duong_path_memcached_config:-}" || -d "/usr/local/lsmcd" ]]; then
        _wp_clear_step "$don_dep LiteSpeed Object Cache" eval 'LiteSpeed\Purge::purge_all_object();'
      fi
    fi
  fi
fi

# ----------------- SWIFT PERFORMANCE (LITE & PRO) -----------------
if _has_plugin "swift-performance-lite"; then
  _wp_clear_step "$don_dep cache Swift Performance Lite" sp_clear_all_cache
elif _has_plugin "swift-performance"; then
  _wp_clear_step "$don_dep cache Swift Performance Pro" sp_clear_all_cache
fi

# ----------------- WP ROCKET -----------------
if _has_plugin "wp-rocket"; then
  if ! _wp_clear_step "$don_dep cache WP Rocket" eval 'if (function_exists("rocket_clean_domain")) { rocket_clean_domain(); }'; then
    _atomic_purge_dir "$path2/wp-content/cache/wp-rocket/$NAME" || true
  fi
fi

# ----------------- ELEMENTOR -----------------
if _has_plugin "elementor"; then
  _wp_clear_step "$don_dep cache Elementor CSS" elementor flush_css
fi

# ----------------- W3 TOTAL CACHE -----------------
if _has_plugin "w3-total-cache"; then
  _wp_clear_step "$don_dep cache W3 Total Cache" eval 'if (function_exists("w3tc_flush_all")) { w3tc_flush_all(); } elseif (function_exists("w3tc_pgcache_flush")) { w3tc_pgcache_flush(); }'
fi

# ----------------- CACHE ENABLER -----------------
if _has_plugin "cache-enabler"; then
  _wp_clear_step "$don_dep cache Cache Enabler" eval 'Cache_Enabler::clear_total_cache();'
fi

# ----------------- AUTOPTIMIZE -----------------
if _has_plugin "autoptimize"; then
  _wp_clear_step "$don_dep cache Autoptimize" eval 'autoptimizeCache::clearall();'
fi

# ----------------- FLYING PRESS -----------------
if _has_plugin "flying-press"; then
  _wp_clear_step "$don_dep cache FlyingPress" flying-press purge-everything
fi

# ----------------- WP-OPTIMIZE -----------------
if _has_plugin "wp-optimize"; then
  _wp_clear_step "$don_dep cache WP-Optimize" eval '$wpo = new WP_Optimize_Cache_Commands(); $wpo->purge_page_cache();'
fi

# ----------------- BREEZE -----------------
if _has_plugin "breeze"; then
  _wp_clear_step "$don_dep cache Breeze" eval "do_action('breeze_clear_all_cache');"
fi

# ----------------- FLYINGPROXY -----------------
if _has_plugin "flyingproxy"; then
  _wp_clear_step "$don_dep cache FlyingProxy" eval "FlyingProxy\Purge::invalidate();"
fi

# ----------------- WP FASTEST CACHE -----------------
if _has_plugin "wp-fastest-cache"; then
  _wp_clear_step "$don_dep cache WP Fastest Cache" fastest-cache clear all
fi

# ----------------- WP PERFORMANCE -----------------
if _has_plugin "wp-performance"; then
  _wp_clear_step "$don_dep cache WP Performance" wpp flush
fi

# ----------------- WPTANGTOC PLUGIN -----------------
if _has_plugin "wptangtoc" && [[ -f "$path2/wp-content/plugins/wptangtoc/class/Cache.php" ]]; then
  _wp_clear_step "$don_dep cache WPTangToc" eval "WPTangToc\Preload::purge_all_cache_wptangtoc();"
fi

# ----------------- WP SUPER CACHE -----------------
if _has_plugin "wp-super-cache"; then
  _wp_clear_step "$don_dep cache WP Super Cache" eval 'global $file_prefix, $supercachedir; if (empty($supercachedir) && function_exists("get_supercache_dir")) { $supercachedir = get_supercache_dir(); } wp_cache_clean_cache($file_prefix, true);'
fi

# ----------------- CLOUDFLARE (APO & CDN) -----------------
if [[ -f "/etc/wptt/cloudflare-cdn-cache/.wptt-$NAME.conf" ]] || _has_plugin "cloudflare"; then
  cloudflare_cdn_apo=""

  if _has_plugin "cloudflare"; then
    _runing "$don_dep cache Cloudflare APO" "$NAME"
    if "${wp_exec[@]}" eval '$apo_api = new \CF\WordPress\Hooks(); $apo_api->purgeCacheEverything();' --path="$path2" >/dev/null 2>&1; then
      if [[ -f "/etc/wptt/cloudflare-cdn-cache/.wptt-$NAME.conf" ]]; then
        . /etc/wptt/cache/cloudflare-cdn-cache-xoa "$NAME" >/dev/null 2>&1 || true
      fi
      cloudflare_cdn_apo='1'
      _rundone "$don_dep cache Cloudflare APO" "$NAME"
    else
      _runloi "$don_dep cache Cloudflare APO" "$NAME"
    fi
  fi

  if [[ -z "$cloudflare_cdn_apo" && -f "/etc/wptt/cloudflare-cdn-cache/.wptt-$NAME.conf" ]]; then
    TRACE_OUTPUT="$(curl -ksL --connect-timeout 3 --max-time 6 "https://$NAME/cdn-cgi/trace" 2>/dev/null || true)"
    if [[ "${TRACE_OUTPUT,,}" == *"cloudflare"* || "${TRACE_OUTPUT,,}" == *"h=$NAME"* ]]; then
      _runing "$don_dep cache Cloudflare CDN" "$NAME"
      if . /etc/wptt/cache/cloudflare-cdn-cache-xoa "$NAME" >/dev/null 2>&1; then
        _rundone "$don_dep cache Cloudflare CDN" "$NAME"
      else
        _runloi "$don_dep cache Cloudflare CDN" "$NAME"
      fi
    fi
  fi
fi

# ----------------- KÍCH HOẠT PRELOAD WP-CRON NGẦM -----------------
if [[ -f "$path2/wp-content/plugins/wptangtoc/PreloadClearAll.php" ]]; then
  (
    exec </dev/null >/dev/null 2>&1
    curl -ksL --connect-timeout 3 --max-time 10 "https://${NAME}/wp-cron.php?doing_wp_cron" || true
  ) &
  disown $! 2>/dev/null || true
fi

wptt_quay_ve_menu "${1:-}" 0
