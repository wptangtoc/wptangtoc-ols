function huong_dan() {
  Đây là tính năng xoá cache website WordPress
  Nó sẽ giúp bạn tự động xoá cache: OpCache, Object Cache, Page Cache HTML, CDN Cache
  Với điều kiện: website bạn đang sử dụng công nghệ Cache đó

  Tính năng Xóa toàn bộ cache WordPress là hành động loại bỏ tất cả các dữ liệu đã được lưu trữ tạm thời [bộ nhớ đệm] mà website WordPress của bạn sử dụng để tăng tốc độ tải trang và giảm tải cho máy chủ.

  Nói một cách đơn giản, đây là việc bạn dọn dẹp các bản sao lưu trữ sẵn của trang web, buộc WordPress phải tạo lại nội dung mới nhất từ cơ sở dữ liệu và các tệp gốc khi có người truy cập tiếp theo.

  Mục Đích Chính
  * Xem các thay đổi mới nhất: Đây là lý do phổ biến nhất. Nếu bạn vừa cập nhật nội dung, thiết kế, cài đặt theme/plugin, hoặc sửa file CSS/JS, những thay đổi này có thể không hiển thị ngay do website đang phục vụ phiên bản cũ từ cache. Xóa cache sẽ buộc website hiển thị phiên bản mới nhất.
  * Gỡ lỗi sự cố: Khi website hoạt động không như mong đợi [lỗi giao diện, thông tin cũ, lỗi hiển thị], xóa cache là một trong những bước đầu tiên để kiểm tra xem có phải do cache bị lỗi thời hay hỏng không.
  * Sau khi cập nhật: Sau khi cập nhật WordPress, theme, hoặc plugin, việc xóa cache được khuyến nghị để đảm bảo tính tương thích và các tính năng/bản vá mới được áp dụng đúng cách.
  * Khắc phục tình trạng website bị kẹt: Đôi khi website bị đóng băng ở một phiên bản cũ, xóa cache có thể giải quyết được vấn đề này.

  Sau khi xóa toàn bộ cache, lần truy cập tiếp theo vào website có thể chậm hơn một chút do máy chủ phải tạo lại mọi thứ từ đầu. Tuy nhiên, điều này đảm bảo bạn và người dùng sẽ thấy được phiên bản mới nhất và chính xác nhất của website.
}

. /etc/wptt/echo-color
NAME=$1
if [[ $NAME = "98" ]]; then
  NAME=""
fi

. /etc/wptt/.wptt.conf

if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

if [[ -z "$NAME" ]]; then
  . /etc/wptt/echo-color
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}$quan_ly_cache ➜ $don_dep cache${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$don_dep $toan_bo Cache"
fi

if [[ $NAME = 'Tất cả website' ]]; then
	tien_do='1'
	#$tong_so_web đuợc gọi từ thư viện tenmien

	print_border_top
	center_text "${C_YELLOW}DASHBOARD THAO TÁC HÀNG LOẠT${C_RESET}"
	print_border_mid
	left_text "▪ Tổng số   : ${C_GREEN}$tong_so_web website${C_RESET}" 2
	left_text "▪ Nhiệm vụ  : ${C_GREEN}$don_dep $toan_bo Cache website${C_RESET}" 2
	print_border_bot


	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}"
		domain="${domain%.conf}"
		domain="${domain#.}"

		if [[ "$domain" == ?*.?* ]]; then
			path="/usr/local/lsws/$domain/html/wp-config.php"
			if [[ -f "$path" ]]; then
				_runing "[ $tien_do / $tong_so_web ] $don_dep $toan_bo Cache website $domain"
				(/etc/wptt/cache/wptt-xoacache "$domain" >/dev/null 2>&1)
				_rundone "[ $tien_do / $tong_so_web ] $don_dep $toan_bo Cache website $domain"
				((tien_do++)) # Tăng tiến độ sau mỗi lần chạy xong
			fi
		fi
	done

	check_menu_wptangtoc_active=$1
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-cache-main 1
	fi
	return 2>/dev/null || exit
fi

. /etc/wptt/echo-color

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-cache-main 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "$ten_mien_nay_khong_ton_tai_tren_he_thong"
  sleep 3
  exec /etc/wptt/wptt-cache-main 1
  return >/dev/null 2>&1
  exit
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  echoDo "$he_thong_xac_nhan_ban_khong_su_ma_nguon"
  echoDo "$tinh_nang_nay_chi_danh_cho_ma_nguon_wordpress"
  sleep 3
  exec /etc/wptt/wptt-cache-main 1
  return >/dev/null 2>&1
  exit
fi

echo "Xoá Cache website $NAME: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

path2="/usr/local/lsws/$NAME/html"

. /etc/wptt/vhost/."$NAME".conf

. /etc/wptt/php/php-cli-domain-config "$NAME"

plugins_active=$(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp plugin list --fields=name --status=active --path="$path2" --allow-root 2>/dev/null | sed '1d')

if [[ -z "$plugins_active" ]]; then
  plugins_active=$(ls -At "$path2"/wp-content/plugins)
fi

echo "$don_dep $toan_bo cache website $NAME:"

# ----------------- OPCACHE -----------------
_runing "$don_dep Cache OpCache"
. /etc/wptt/cache/lib-opcache-clear
wptt_xoa_opcache "$NAME"
if [ $? -eq 0 ]; then
  _rundone "$don_dep Cache OpCache"
else
  _runloi "$don_dep Cache OpCache"
fi

# ----------------- WP OBJECT CACHE -----------------
_runing "$don_dep WP object cache"
/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp cache flush --path="$path2" --allow-root >/dev/null 2>&1
if [ $? -eq 0 ]; then
  _rundone "$don_dep WP object cache"
else
  _runloi "$don_dep WP object cache"
fi

# ----------------- LITESPEED CACHE -----------------
if grep -q 'litespeed-cache' <<< "$plugins_active"; then
  _runing "$don_dep cache LiteSpeed cache"

  # 1. Chạy lệnh WP-CLI lần 1 (Thử bằng DNS thật)
  purge_output=$(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-purge all --path="$path2" --allow-root 2>&1)

  # 2. Nếu dính lỗi cURL (Bao gồm cả lỗi 6, 7 DNS và lỗi 28 Timeout)
  if [[ "$purge_output" == *"cURL error"* ]] || [[ "$purge_output" == *"Could not resolve"* ]]; then #xác định website chưa trỏ dns chuẩn xác vào máy chủ
    
    # --- KÍCH HOẠT FAKE DNS BẰNG IP THẬT CỦA MÁY CHỦ ---
    # Lấy IP LAN/Public chính của VPS thay vì dùng 127.0.0.1 để tránh lỗi Listener của OLS
    SERVER_IP=$(ip -4 route get 8.8.8.8 | awk '{print $7}' | head -n 1)
    
    echo "$SERVER_IP $NAME www.$NAME #wptt_dns_local_clear_cache" >>/etc/hosts
    
    # Chạy lại lệnh purge lần 2
    purge_output=$(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-purge all --path="$path2" --allow-root 2>&1)
    
    # Dọn dẹp trả lại nguyên trạng file hosts
    sed -i '/#wptt_dns_local_clear_cache/d' /etc/hosts
  fi

  # 3. ĐÁNH GIÁ KẾT QUẢ & KÍCH HOẠT FALLBACK VẬT LÝ
  if [[ "$purge_output" == *"cURL error"* ]] || [[ "$purge_output" == *"Could not resolve"* ]]; then
    
    # --- CÚ ĐẤM THÉP: XÓA FILE CACHE VẬT LÝ NẾU WP-CLI VẪN THẤT BẠI ---
    # (Đảm bảo cache được dọn dẹp 100% kể cả khi web bị lỗi mạng/đứt DNS)
    if [[ -d "/usr/local/lsws/$NAME/lscache" ]]; then
      rm -rf "/usr/local/lsws/$NAME/lscache/"* 2>/dev/null
      _rundone "$don_dep cache LiteSpeed cache (Bằng File vật lý)"
    elif [[ -d "/usr/local/lsws/cachedata" ]]; then
      rm -rf "/usr/local/lsws/cachedata/"* 2>/dev/null
      _rundone "$don_dep cache LiteSpeed cache (Bằng File vật lý)"
    else
      _runloi "$don_dep cache LiteSpeed cache"
      echo "   -> Lỗi Timeout/DNS: WP-CLI thất bại và không tìm thấy thư mục lscache."
      echo "   -> Chi tiết: $purge_output"
    fi

  else
    # Nếu không còn chữ cURL error thì là thành công
    _rundone "$don_dep cache LiteSpeed cache"
  fi

  # Object cache chỉ kiểm tra khi litespeed-cache thực sự active
  if [[ -f "/usr/local/lsws/$NAME/html/wp-content/object-cache.php" ]]; then
    if grep -q 'litespeed_conf' "/usr/local/lsws/$NAME/html/wp-content/object-cache.php" 2>/dev/null; then
      if [[ -f "$duong_dan_config_redis" || -f "$duong_path_memcached_config" || -d "/usr/local/lsmcd" ]]; then
        _runing "$don_dep Object Cache"
        /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp eval 'LiteSpeed\Purge::purge_all_object();' --allow-root --path="$path2" >/dev/null 2>&1
        if [ $? -eq 0 ]; then
          _rundone "$don_dep Object Cache"
        else
          _runloi "$don_dep Object Cache"
        fi
      fi
    fi
  fi
fi

# ----------------- SWIFT PERFORMANCE LITE -----------------
