function huong_dan() {
  Tính năng Thiết lập giới hạn dung lượng Page Cache HTML là một cài đặt cho phép bạn quy định dung lượng ổ đĩa tối đa mà bộ nhớ đệm [cache] chứa các trang HTML tĩnh của website được phép sử dụng.

  Nói một cách đơn giản, đây là cách bạn đặt ra một ngưỡng cho kho lưu trữ các bản sao trang web đã được tạo sẵn [Page Cache HTML]. Khi kho này đầy đến ngưỡng đó, hệ thống sẽ tự động dọn dẹp bớt các file cache cũ hoặc ít dùng để nhường chỗ cho các file mới, tránh làm đầy ổ cứng của máy chủ.

  Mục Đích Chính
  * Ngăn chặn việc sử dụng ổ đĩa quá mức: Các tệp HTML được cache, đặc biệt với website có nhiều trang hoặc thay đổi thường xuyên, có thể chiếm nhiều dung lượng. Giới hạn này giúp cache không phình to vô hạn, tránh làm đầy ổ cứng và gây ảnh hưởng đến hoạt động của máy chủ.
  * Quản lý tài nguyên hiệu quả: Giúp kiểm soát việc sử dụng không gian lưu trữ, đặc biệt quan trọng với các gói hosting có dung lượng hạn chế.
  * Tự động dọn dẹp cache cũ: Khi đạt đến giới hạn, cơ chế cache thường sẽ tự động xóa các tệp cache cũ nhất hoặc ít được truy cập nhất để tạo không gian cho các trang mới được cache.
  * Duy trì sức khỏe máy chủ: Tránh tình trạng hết dung lượng ổ đĩa, một yếu tố quan trọng cho sự ổn định chung.

  Khi thiết lập giới hạn, Page Cache HTML sẽ hoạt động trong một khuôn khổ dung lượng được kiểm soát. Hệ thống sẽ tự động quản lý kích thước của nó, đảm bảo cache vẫn mang lại lợi ích về tốc độ mà không gây quá tải tài nguyên ổ cứng.
}

#Cú pháp BẬT: /etc/wptt/cache/wptt-setup-gioi-han-dung-luong-page-cache-html all on 10240 (Bật đồng loạt giới hạn 10GB).
#Cú pháp TẮT: /etc/wptt/cache/wptt-setup-gioi-han-dung-luong-page-cache-html domain.com off.
#Cú pháp TẮT: /etc/wptt/cache/wptt-setup-gioi-han-dung-luong-page-cache-html all off.
# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_cache} ➜ Thiết lập giới hạn dung lượng Page Cache HTML${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE CÓ HIỂN THỊ TRẠNG THÁI GIỚI HẠN
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -At /etc/wptt/vhost 2>/dev/null | grep -v '^\.\.conf$' | sort -uV)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        local status_text=""
        local status_color=""

        if [[ -f "/etc/cron.d/delete-cache-page-$domain.cron" ]]; then
          local current_limit=$(grep -oP "$domain \K[0-9]+" "/etc/cron.d/delete-cache-page-$domain.cron" 2>/dev/null | head -n 1)
          if [[ -z "$current_limit" ]]; then
            current_limit=$(awk -v d="$domain" '{for(i=1;i<=NF;i++) if($i==d) print $(i+1)}' "/etc/cron.d/delete-cache-page-$domain.cron" 2>/dev/null | tr -cd '0-9')
          fi

          if [[ -n "$current_limit" ]]; then
            status_text="[Đã giới hạn: ${current_limit} MB]"
            status_color=$C_GREEN
          else
            status_text="[Đang Lỗi Cấu Hình]"
            status_color=$C_RED
          fi
        else
          status_text="[Chưa giới hạn]"
          status_color=$C_YELLOW
        fi

        selects+=("$domain|$status_text|$status_color")
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Hệ thống chưa có website nào được khởi tạo!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-cache-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}

  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Lựa chọn Website để cấu hình giới hạn dung lượng Cache:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Thiết lập giới hạn Cache cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Thiết lập giới hạn Cache cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}

  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-cache-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""
CLI_LIMIT=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
  CLI_ACTION="bat"
  CLI_LIMIT="${3:-10240}" # Mặc định 10GB nếu truyền CLI thiếu dung lượng
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
  CLI_ACTION="tat"
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
    CLI_LIMIT="${3:-10240}"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""
Dung_luong=""

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then

  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="BẬT Giới hạn Cache"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="GỠ BỎ Giới hạn Cache"
  else
    # NẾU CHỌN TỪ MENU UI (SỐ TÙY CHỌN CUỐI CÙNG) -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: GIỚI HẠN DUNG LƯỢNG CACHE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác quản lý dung lượng ổ cứng cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    str_opt1="  1) BẬT Giới hạn Cache (Áp dụng mức dung lượng đồng loạt)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Giới hạn Cache${C_RESET} (Áp dụng mức dung lượng đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

    str_opt2="  2) GỠ BỎ Giới hạn Cache (Cho phép lưu trữ thoải mái đồng loạt)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}GỠ BỎ Giới hạn Cache${C_RESET} (Cho phép lưu trữ thoải mái đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice

    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="BẬT Giới hạn Cache"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="GỠ BỎ Giới hạn Cache"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-cache-main 1
    fi
  fi

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  pathcheck="/etc/wptt/vhost/.$NAME.conf"
  [[ ! -f "$pathcheck" ]] && echo -e "\n${C_RED}Tên miền không tồn tại trên hệ thống này!${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-cache-main 1

  DOMAIN_LIST=("$NAME")

  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "bat" ]]; then
      action_text="BẬT Giới hạn Cache"
    else
      action_text="GỠ BỎ Giới hạn Cache"
    fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH GIỚI HẠN DUNG LƯỢNG CACHE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if [[ -f "/etc/cron.d/delete-cache-page-$NAME.cron" ]]; then
      local current_limit=$(grep -oP "$NAME \K[0-9]+" "/etc/cron.d/delete-cache-page-$NAME.cron" 2>/dev/null | head -n 1)
      left_text "  Website ${NAME} hiện ĐÃ THIẾT LẬP giới hạn (${current_limit} MB)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      str_opt1="  1) GỠ BỎ Giới hạn (Cho phép lưu trữ thoải mái, không dọn dẹp tự động)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}GỠ BỎ Giới hạn${C_RESET} (Cho phép lưu trữ thoải mái, không dọn dẹp tự động)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

      str_opt2="  2) Không làm gì cả (Giữ nguyên cấu hình hiện tại)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên cấu hình hiện tại)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice

      if [[ "$single_choice" == "1" ]]; then
        wp_action="tat"
        action_text="GỠ BỎ Giới hạn Cache"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-cache-main 1
      fi
    else
      left_text "  Website ${NAME} hiện CHƯA THIẾT LẬP giới hạn dung lượng." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      str_opt1="  1) BẬT Giới hạn Cache (Chống phình to ổ cứng tự động)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Giới hạn Cache${C_RESET} (Chống phình to ổ cứng tự động)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice

      if [[ "$single_choice" == "1" ]]; then
        wp_action="bat"
        action_text="BẬT Giới hạn Cache"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-cache-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# HỎI MỨC DUNG LƯỢNG NẾU HÀNH ĐỘNG LÀ BẬT
# ==============================================================================
if [[ "$wp_action" == "bat" ]]; then
  if [[ $CLI_MODE -eq 1 && "$CLI_LIMIT" =~ ^[0-9]+$ ]]; then
    Dung_luong="$CLI_LIMIT"
  else
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THIẾT LẬP DUNG LƯỢNG GIỚI HẠN CACHE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Nhập mức dung lượng MB bạn muốn làm ngưỡng dọn dẹp." 2
    left_text "  (Ví dụ: Nhập ${C_GREEN}10240${C_RESET} cho 10GB, hoặc ${C_GREEN}5120${C_RESET} cho 5GB)" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập dung lượng MB [0=Thoát]: ${C_RESET}"
    read -r Dung_luong

    if [[ "$Dung_luong" == "0" || -z "$Dung_luong" ]]; then
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1 && exec /etc/wptt/wptt-cache-main 1
    fi

    if [[ ! "$Dung_luong" =~ ^[0-9]+$ ]]; then
      echo -e "\n${C_RED}Lỗi: Bạn nhập sai kiểu dữ liệu! Vui lòng chỉ nhập số nguyên (Ví dụ: 2048, 5120...)${C_RESET}"
      sleep 3
      exec /etc/wptt/wptt-cache-main 1
    fi
  fi
fi

# ==============================================================================
# THỰC THI SỬA ĐỔI CRONTAB
# ==============================================================================
echo ""
thao_tac_thanh_cong=false

for DOMAIN in "${DOMAIN_LIST[@]}"; do
  _runing "$action_text cho website $DOMAIN"

  if [[ "$wp_action" == "bat" ]]; then
    phut=$(shuf -i0-59 -n1)
    [[ -z "$phut" ]] && phut='30'

    cat >"/etc/cron.d/delete-cache-page-$DOMAIN.cron" <<END
$phut * * * * root /etc/wptt/cache/delete-cache-html-page-gioi-han-dung-luong-o-cung $DOMAIN $Dung_luong > /dev/null 2>&1
END

    if cat /etc/*release 2>/dev/null | grep -qi "ubuntu"; then
      NAME_CRON_ubuntu=${DOMAIN//[.]/_}
      ln -sf "/etc/cron.d/delete-cache-page-$DOMAIN.cron" "/etc/cron.d/delete-cache-page-${NAME_CRON_ubuntu}_cron"
    fi

    # Thực thi luôn lệnh dọn dẹp lần đầu
    . /etc/wptt/cache/delete-cache-html-page-gioi-han-dung-luong-o-cung "$DOMAIN" "$Dung_luong" >/dev/null 2>&1

  else
    rm -f "/etc/cron.d/delete-cache-page-$DOMAIN.cron"
    if cat /etc/*release 2>/dev/null | grep -qi "ubuntu"; then
      NAME_CRON_ubuntu=${DOMAIN//[.]/_}
      rm -f "/etc/cron.d/delete-cache-page-${NAME_CRON_ubuntu}_cron"
    fi
  fi

  echo "$action_text dung lượng $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cho website $DOMAIN"
  thao_tac_thanh_cong=true
done

# ==============================================================================
# KHỞI ĐỘNG LẠI DỊCH VỤ CRON VÀ HIỂN THỊ KẾT QUẢ
# ==============================================================================
if $thao_tac_thanh_cong; then
  if cat /etc/*release 2>/dev/null | grep -qi "ubuntu"; then
    systemctl restart cron.service >/dev/null 2>&1
  else
    systemctl restart crond.service >/dev/null 2>&1
  fi

  if [[ "$wp_action" == "bat" ]]; then
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
