    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
      left_text "Website thao tác : ${C_YELLOW}Tất cả ${#DOMAIN_LIST[@]} website${C_RESET}" 2
    else
      left_text "Website thao tác : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
    fi
    left_text "Ngưỡng giới hạn  : ${C_GREEN}${Dung_luong} MB${C_RESET}" 2
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hệ thống sẽ chạy ngầm và tự động xóa bớt các file cache cũ" 2
    left_text "nhất mỗi khi tổng dung lượng cache vượt qua ngưỡng thiết lập." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ GIỚI HẠN CACHE${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
      left_text "Kể từ bây giờ, Page Cache HTML của ${C_YELLOW}Toàn bộ website${C_RESET} sẽ được lưu" 2
    else
      left_text "Kể từ bây giờ, Page Cache HTML của ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET} sẽ được lưu" 2
    fi
    left_text "trữ thoải mái mà không bị giới hạn dung lượng tự động nữa." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  fi
fi

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-cache-main 1
