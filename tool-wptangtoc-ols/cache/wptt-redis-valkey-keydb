function huong_dan() {
  1. Tính Năng Cài Đặt [Install Object Cache]
  Cài đặt Valkey/KeyDB/Redis là quá trình thiết lập và chạy phần mềm máy chủ trên hệ thống để các ứng dụng có thể kết nối và sử dụng nó.

  2. Tính Năng Hủy Cài Đặt [Uninstall]
  Hủy cài đặt là quá trình gỡ bỏ phần mềm, các tệp cấu hình và có thể cả dữ liệu của nó khỏi hệ thống.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

# =========================================================================
# HÀM RENDER DANH SÁCH ACL VÀ CẤP PHÁT DATABASE CÔ LẬP
# =========================================================================
function in_thong_tin_acl_cho_khach() {
  # CHẶN NGAY TỪ ĐẦU NẾU CHƯA CÀI ĐẶT
  if [[ "$socket_path" == "Không có" || "$active_cache" == "Chưa cài đặt" ]]; then
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THÔNG TIN KẾT NỐI OBJECT CACHE (ACL & DB)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  ${C_RED}Hệ thống hiện chưa cài đặt Object Cache.${C_RESET}" 2
    left_text "  Vui lòng cài đặt Engine (Valkey/KeyDB/Redis) để tạo tài khoản!" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    return
  fi

  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}THÔNG TIN KẾT NỐI OBJECT CACHE (ACL & DB CÔ LẬP)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Để kích hoạt Cache, bạn vui lòng sử dụng chính xác các thông số bên dưới:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  ➤ Host / Đường dẫn  : ${C_YELLOW}$socket_path${C_RESET}" 2
  left_text "  ➤ Port / Cổng       : ${C_YELLOW}0${C_RESET}" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  local cache_cli="redis-cli"
  command -v valkey-cli >/dev/null 2>&1 && cache_cli="valkey-cli"
  command -v keydb-cli >/dev/null 2>&1 && cache_cli="keydb-cli"

  # Nạp và giải mã Master Password từ file cấu hình lõi
  . /etc/wptt/.wptt.conf 2>/dev/null
  local raw_master_pass=""
  [[ -n "$REDIS_MASTER_PASS" ]] && raw_master_pass=$(wptt_giai_ma "$REDIS_MASTER_PASS")

  local found=0
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    local domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    
    unset redis_acl_user redis_acl_pass redis_db_id User_name_vhost
    source "$filepath" 2>/dev/null
    local pass_show=""

    # 1. TẠO TÀI KHOẢN MỚI HOẶC BỔ SUNG DB_ID NẾU CHƯA CÓ
    if [[ -z "$redis_acl_user" || -z "$redis_acl_pass" ]]; then
        local redis_acl_user=$(openssl rand -hex 12)
        local raw_pass=$(openssl rand -hex 16)
        redis_acl_pass=$(wptt_ma_hoa "$raw_pass")
        
        # --- THUẬT TOÁN TÌM ID CÔ LẬP KHÔNG TRÙNG LẶP ---
        local used_ids=$(awk -F"['=]" '/^redis_db_id=/ {print $3}' /etc/wptt/vhost/.*.conf 2>/dev/null | tr -d "'" | sort -un)
        redis_db_id=1
        while echo "$used_ids" | grep -qw "$redis_db_id"; do
            ((redis_db_id++))
            if [[ $redis_db_id -gt 999 ]]; then redis_db_id=999; break; fi
        done
        # ------------------------------------------------
        
        echo "redis_acl_user='$redis_acl_user'" >> "$filepath"
        echo "redis_acl_pass='$redis_acl_pass'" >> "$filepath"
        echo "redis_db_id='$redis_db_id'" >> "$filepath"
        
        # Mở khóa +flushdb cho plugin
        if [[ "$socket_path" != "Không có" && -n "$raw_master_pass" ]]; then
            $cache_cli -s "$socket_path" -a "$raw_master_pass" --no-auth-warning ACL SETUSER "$redis_acl_user" on ">$raw_pass" "~*" +@all -flushall +flushdb >/dev/null 2>&1
        fi
        pass_show="$raw_pass"
    else
        pass_show=$(wptt_giai_ma "$redis_acl_pass")
        
        # Cập nhật DB ID cho các website cũ chưa được chia lô
        if [[ -z "$redis_db_id" ]]; then
            # --- THUẬT TOÁN TÌM ID CÔ LẬP KHÔNG TRÙNG LẶP ---
            local used_ids=$(awk -F"['=]" '/^redis_db_id=/ {print $3}' /etc/wptt/vhost/.*.conf 2>/dev/null | tr -d "'" | sort -un)
            redis_db_id=1
            while echo "$used_ids" | grep -qw "$redis_db_id"; do
                ((redis_db_id++))
                if [[ $redis_db_id -gt 999 ]]; then redis_db_id=999; break; fi
            done
            # ------------------------------------------------
            echo "redis_db_id='$redis_db_id'" >> "$filepath"
        fi

        # Cập nhật lại quyền +flushdb
        if [[ "$socket_path" != "Không có" && -n "$raw_master_pass" ]]; then
            $cache_cli -s "$socket_path" -a "$raw_master_pass" --no-auth-warning ACL SETUSER "$redis_acl_user" on ">$pass_show" "~*" +@all -flushall +flushdb >/dev/null 2>&1
        fi
    fi

    if [[ -n "$redis_acl_user" && -n "$pass_show" ]]; then
      left_text "Website: ${C_GREEN}$domain${C_RESET}" 2
      left_text "   - Username    : ${C_BOLD_WHITE}$redis_acl_user${C_RESET}" 2
      left_text "   - Password    : ${C_YELLOW}$pass_show${C_RESET}" 2
			left_text "   - Database ID : ${C_CYAN}${redis_db_id}${C_RESET}" 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      found=1
    fi
  done
  
  if [[ $found -eq 0 ]]; then
    left_text "  Không tìm thấy Website nào trên hệ thống." 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  else
    echo -en "\033[1A\033[2K\r" 
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "\n${C_GREEN}HƯỚNG DẪN ĐIỀN VÀO LITESPEED CACHE / WP-REDIS:${C_RESET}"
    echo -e "1. Bật Object Cache: ${C_YELLOW}ON${C_RESET} | Method: ${C_YELLOW}Redis${C_RESET}"
    echo -e "2. Host: ${C_YELLOW}$socket_path${C_RESET} | Port: ${C_YELLOW}0${C_RESET}"
    echo -e "3. Copy Username/Password và điền đúng số ID Database ở trên."
  fi
}

function hien_thi_tai_khoan_acl() {
  clear
  in_thong_tin_acl_cho_khach
  echo -en "\nNhấn phím ${C_GREEN}Enter${C_RESET} để quay lại Menu..."
  read -r
  exec "$0"
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_cache} ➜ Object Cache (Valkey / KeyDB / Redis)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

active_cache="Chưa cài đặt"
socket_path="Không có"
if systemctl is-active --quiet valkey-server 2>/dev/null || systemctl is-active --quiet valkey 2>/dev/null; then active_cache="valkey"; active_name_display="Valkey"; socket_path="/var/run/valkey/valkey.sock";
elif systemctl is-active --quiet keydb-server 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null; then active_cache="keydb"; active_name_display="KeyDB"; socket_path="/var/run/keydb/keydb.sock";
elif systemctl is-active --quiet redis-server 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null; then active_cache="redis"; active_name_display="Redis"; socket_path="/var/run/redis/redis.sock"; fi

box_inner_width=${box_inner_width:-71}
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
if [[ "$active_cache" != "Chưa cài đặt" ]]; then
  left_text "Trạng thái    : ${C_GREEN}Đang hoạt động (${active_name_display})${C_RESET}" 2
  left_text "Unix Socket   : ${C_YELLOW}$socket_path${C_RESET}" 2
  left_text "Bảo mật ACL   : ${C_GREEN}Đã kích hoạt (Unix Socket + Master Lock)${C_RESET}" 2
else
  left_text "Trạng thái    : ${C_RED}Chưa cài đặt Object Cache${C_RESET}" 2
fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
center_text "${C_YELLOW}VUI LÒNG CHỌN ENGINE BẠN MUỐN QUẢN LÝ / CÀI ĐẶT${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

OUTPUT=$(cat /etc/*release)
is_alma_10=false; if echo "$OUTPUT" | grep -q "AlmaLinux 10\|Rocky Linux 10\|Red Hat Enterprise Linux 10\|Oracle Linux Server 10"; then is_alma_10=true; fi

left_text "  ${C_CYAN}1)${C_RESET} ${C_BOLD_WHITE}Valkey${C_RESET} (Khuyên dùng - Nhanh, nhẹ, ổn định nhất)" 2
left_text "  ${C_CYAN}2)${C_RESET} ${C_BOLD_WHITE}KeyDB${C_RESET}  (Tối ưu ép xung Đa luồng cho VPS nhiều Core)" 2
if ! $is_alma_10; then left_text "  ${C_CYAN}3)${C_RESET} ${C_BOLD_WHITE}Redis${C_RESET}  (Phiên bản truyền thống)" 2; fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "  ${C_CYAN}4)${C_RESET} ${C_YELLOW}Xem thông tin Tài khoản ACL & Database ID${C_RESET}" 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  if $is_alma_10; then echo -en "${C_CYAN}Nhập lựa chọn của bạn [1-2, 4] [0=Thoát]: ${C_RESET}"; else echo -en "${C_CYAN}Nhập lựa chọn của bạn [1-4] [0=Thoát]: ${C_RESET}"; fi
  read -r cache_choice
  if [[ "$cache_choice" == "0" ]]; then echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"; [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-cache-main 1; exit 0; fi
  case "$cache_choice" in
  1) name_service="valkey"; display_name="Valkey"; break ;;
  2) name_service="keydb"; display_name="KeyDB"; break ;;
  3) if ! $is_alma_10; then name_service="redis"; display_name="Redis"; break; else echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"; fi ;;
  4) hien_thi_tai_khoan_acl ;;
  *) echo -e "${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}" ;;
  esac
done

duong_dan_config_redis="/etc/$name_service/$name_service.conf"
if $(cat /etc/*release | grep -q "AlmaLinux 8\|Rocky Linux 8\|Red Hat Enterprise Linux 8\|Oracle Linux Server 8") && [[ "$name_service" == 'redis' ]]; then duong_dan_config_redis="/etc/$name_service.conf"; fi
if [[ ! -f "$duong_dan_config_redis" && -f "/etc/$name_service.conf" ]]; then duong_dan_config_redis="/etc/$name_service.conf"; elif [[ ! -f "$duong_dan_config_redis" && -f "/etc/$name_service/$name_service.conf" ]]; then duong_dan_config_redis="/etc/$name_service/$name_service.conf"; fi

echo ""
if [[ ! -f "$duong_dan_config_redis" ]]; then
  if [[ "$active_cache" != "Chưa cài đặt" && "$active_cache" != "$name_service" ]]; then msg_confirm="Hệ thống đang chạy ${C_YELLOW}$active_name_display${C_RESET}. Bạn có muốn XÓA nó và cài đặt ${C_GREEN}$display_name${C_RESET} không?"; else msg_confirm="Bạn có muốn tiến hành CÀI ĐẶT ${C_GREEN}$display_name${C_RESET} không?"; fi

  if wptt_xac_nhan "$msg_confirm" "" "" "Đồng ý Cài đặt" "Hủy bỏ"; then
    echo ""
    _runing "Cài đặt Package $display_name"
    echo "Kích hoạt $name_service: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

    for other_service in redis valkey keydb; do
      if [[ "$other_service" != "$name_service" ]]; then
        systemctl stop $other_service ${other_service}-server >/dev/null 2>&1
        systemctl disable $other_service ${other_service}-server >/dev/null 2>&1
        killall -9 ${other_service}-server ${other_service} >/dev/null 2>&1
        if grep -q "Ubuntu\|Debian" /etc/*release 2>/dev/null; then apt-get remove --purge $other_service ${other_service}-server -y >/dev/null 2>&1; else dnf remove ${other_service:?} -y >/dev/null 2>&1; fi
        rm -rf /etc/${other_service:?}.conf /etc/${other_service:?} /var/run/${other_service:?} /var/lib/${other_service:?} /var/log/${other_service:?} /etc/monit.d/${other_service:?} /etc/monit/conf.d/${other_service:?}
      fi
    done

    if grep -q "Ubuntu\|Debian" /etc/*release 2>/dev/null; then
      apt-get update >/dev/null 2>&1
      apt-get install "$name_service" "${name_service}"-server -y >/dev/null 2>&1
      lsphp=($(ls -A /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$'))
      for phpredis in ${lsphp[@]}; do apt-get install lsphp"${phpredis}"-redis lsphp"${phpredis}"-igbinary -y >/dev/null 2>&1; done
    else
      dnf install epel-release -y >/dev/null 2>&1
      yum install "${name_service}" -y --disablerepo="mariadb" >/dev/null 2>&1
      lsphp=($(ls -A /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$'))
      (/etc/wptt/php/kho-luu-tru-litespeed)
      for phpredis in ${lsphp[@]}; do
        if [[ $(dnf list available 2>/dev/null | grep "lsphp${phpredis}-pecl-redis") ]]; then
          yum install lsphp"${phpredis}"-pecl-redis lsphp"${phpredis}"-pecl-igbinary -y --nogpgcheck --disablerepo="mariadb" 2>/dev/null
        else
          dnf install https://rpms.litespeedtech.com/centos/8/x86_64/lsphp${phpredis}-pecl-redis-6.0.2-1.el8.x86_64.rpm -y >/dev/null 2>&1 || true
          dnf install https://rpms.litespeedtech.com/centos/8/x86_64/lsphp${phpredis}-pecl-igbinary-3.2.14-1.el8.x86_64.rpm -y >/dev/null 2>&1 || true
        fi
      done
    fi

    if [[ ! -f "$duong_dan_config_redis" ]]; then
      if [[ -f "/etc/$name_service/$name_service.conf" ]]; then duong_dan_config_redis="/etc/$name_service/$name_service.conf"; elif [[ -f "/etc/$name_service.conf" ]]; then duong_dan_config_redis="/etc/$name_service.conf"; fi
    fi
    _rundone "Cài đặt Package $display_name"

    _runing "Cấu hình bảo mật Unix Socket + Admin Requirepass + Databases 1000..."

    # TẠO VÀ LƯU MASTER PASSWORD VÀO FILE .wptt.conf GỐC (MÃ HÓA)
    . /etc/wptt/.wptt.conf 2>/dev/null
    if [[ -z "$REDIS_MASTER_PASS" ]]; then
        raw_master=$(openssl rand -hex 24)
        master_pass_encrypted=$(wptt_ma_hoa "$raw_master")
        echo "REDIS_MASTER_PASS='$master_pass_encrypted'" >> /etc/wptt/.wptt.conf
        REDIS_MASTER_PASS="$master_pass_encrypted"
    fi
    dec_master_pass=$(wptt_giai_ma "$REDIS_MASTER_PASS")
    
    # [TỐI ƯU CÔ LẬP]: Bơm databases 1000 để mở rộng quỹ đất lưu trữ riêng biệt
    echo -e "\n# WPTangToc Optimize
port 0
unixsocket /var/run/$name_service/$name_service.sock
unixsocketperm 777
requirepass \"$dec_master_pass\"
maxmemory 128mb
maxmemory-policy allkeys-lfu
databases 1000
save \"\"
appendonly no
tcp-keepalive 60" >>"$duong_dan_config_redis"

    sed -i 's/^[[:space:]]*port 6379/#port 6379/g' "$duong_dan_config_redis"
    sed -i 's/^[[:space:]]*tcp-keepalive 300/tcp-keepalive 0/g' "$duong_dan_config_redis"
    sed -i 's/^[[:space:]]*rdbcompression yes/rdbcompression no/g' "$duong_dan_config_redis"
    sed -i 's/^[[:space:]]*rdbchecksum yes/rdbchecksum no/g' "$duong_dan_config_redis"

    mkdir -p /var/run/"$name_service" /var/lib/"$name_service" /var/log/"$name_service"
    chmod 755 /var/run/"$name_service"
    chmod 700 /var/lib/"$name_service"
    
    chown -R "$name_service":"$name_service" /var/run/"$name_service" /var/log/"$name_service" /var/lib/"$name_service" 2>/dev/null
    chown "$name_service":"$name_service" "$duong_dan_config_redis" 2>/dev/null
    chmod 644 "$duong_dan_config_redis"

    systemctl daemon-reload >/dev/null 2>&1
    if systemctl list-unit-files | grep -q "^${name_service}-server.service"; then SVC_NAME="${name_service}-server"; else SVC_NAME="${name_service}"; fi
    systemctl enable "$SVC_NAME" >/dev/null 2>&1
    systemctl restart "$SVC_NAME" >/dev/null 2>&1
    systemctl restart lsws >/dev/null 2>&1

    (/etc/wptt/monit >/dev/null 2>&1)
    (/etc/wptt/cache/object-cache-optimize-tune >/dev/null 2>&1)

    _rundone "Cấu hình bảo mật Unix Socket + Admin Requirepass + Databases 1000..."
    
    # FIX LỖI: Cập nhật lại 2 biến trạng thái để hàm in_thong_tin_acl_cho_khach chạy mượt mà
    active_cache="$name_service"
    socket_path="/var/run/$name_service/$name_service.sock"
    
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT CÀI ĐẶT OBJECT CACHE${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Engine        : ${C_YELLOW}$display_name${C_RESET}" 2
    left_text "Chế độ        : ${C_GREEN}Unix Socket + Admin ACL Master${C_RESET}" 2
    left_text "Cô lập Dữ liệu: ${C_GREEN}Đã kích hoạt 1000 Database ID độc lập${C_RESET}" 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    
    in_thong_tin_acl_cho_khach
    echo -en "\nNhấn phím ${C_GREEN}Enter${C_RESET} để tiếp tục..."
    read -r
  else
    echo -e "${C_YELLOW}Đã hủy thao tác Cài đặt.${C_RESET}"
  fi
else
  if wptt_xac_nhan "Hệ thống đang chạy ${C_YELLOW}$display_name${C_RESET}. Bạn có chắc chắn muốn GỠ BỎ không?" "" "" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
    echo ""
    echo "Huỷ kích hoạt $name_service: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

    _runing "Gỡ bỏ hoàn toàn $display_name và dọn dẹp hệ thống..."
    systemctl stop "${name_service}" "${name_service}"-server >/dev/null 2>&1
    systemctl disable "${name_service}" "${name_service}"-server >/dev/null 2>&1

    if $(cat /etc/*release | grep -qi "Ubuntu\|Debian"); then apt-get remove --purge "${name_service}" "${name_service}"-server -y >/dev/null 2>&1; else yum remove "${name_service}" -y >/dev/null 2>&1; fi

    lsphp=($(ls /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$'))
    for php_redis in "${lsphp[@]}"; do yum remove lsphp"${php_redis}"-pecl-redis -y --disablerepo="*" --enablerepo="litespeed,litespeed-update" >/dev/null 2>&1; done

    rm -rf "${duong_dan_config_redis:?}" /var/run/"${name_service:?}" /var/lib/"${name_service:?}" /var/log/"${name_service:?}"
    [[ -n "$name_service" && -d /etc/"${name_service}" ]] && rm -rf /etc/"${name_service:?}"
    if grep -qi "ubuntu\|debian" /etc/*release; then DIR_MONIT="/etc/monit/conf.d"; else DIR_MONIT="/etc/monit.d"; fi
    [[ -f "$DIR_MONIT/$name_service" ]] && rm -f "$DIR_MONIT/$name_service"
    if systemctl is-active --quiet monit; then systemctl reload monit >/dev/null 2>&1; fi

    # DỌN DẸP SẠCH SẼ BIẾN TRONG .wptt.conf VÀ VHOST
    sed -i '/^REDIS_MASTER_PASS=/d' /etc/wptt/.wptt.conf 2>/dev/null
    for vhost_file in /etc/wptt/vhost/.*.conf; do
        if [[ -f "$vhost_file" ]]; then
            sed -i '/^redis_acl_user=/d' "$vhost_file"
            sed -i '/^redis_acl_pass=/d' "$vhost_file"
            sed -i '/^redis_db_id=/d' "$vhost_file"
        fi
    done

    _rundone "Gỡ bỏ hoàn toàn $display_name và dọn dẹp hệ thống..."
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ OBJECT CACHE${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hệ thống đã xóa sạch ${C_YELLOW}$display_name${C_RESET}, PHP Extension và các biến ACL." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "${C_YELLOW}Đã hủy thao tác Gỡ bỏ.${C_RESET}"
  fi
fi

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-cache-main 1
