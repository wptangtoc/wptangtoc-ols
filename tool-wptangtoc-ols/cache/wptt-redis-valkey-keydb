#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Quản lý Object Cache (Valkey / KeyDB / Redis) với Unix Socket, ACL & Database ID Cô lập

function huong_dan() {
  cat <<'EOF'
  🚀 TÍNH NĂNG: QUẢN LÝ OBJECT CACHE (VALKEY / KEYDB / REDIS)

  Object Cache là một công nghệ tối ưu hóa bộ nhớ tạm (In-Memory Database), giúp WordPress lưu trữ các câu lệnh truy vấn phức tạp thẳng vào bộ nhớ RAM thay vì phải bắt MariaDB/MySQL chạy lại từ đầu. Tính năng này được coi là "Trái tim" để tăng tốc các trang web động (Dynamic Sites) như WooCommerce, các diễn đàn hoặc các trang quản trị wp-admin.

1. TÍNH NĂNG CÀI ĐẶT (INSTALL OBJECT CACHE):
   ➜ Tăng tốc đột phá: Tự động tải, biên dịch và cấu hình một trong 3 Engine hàng đầu (Valkey, KeyDB hoặc Redis).
   ➜ Unix Socket & ACL: Bỏ qua kết nối mạng TCP chậm chạp, hệ thống tự động cấu hình giao tiếp qua Unix Socket để tối đa hóa băng thông nội bộ. Đồng thời, kích hoạt tính năng ACL (Phân quyền bảo mật) để cấp cho mỗi website một User/Pass và Database ID độc lập, ngăn chặn hoàn toàn việc nhìn trộm dữ liệu chéo giữa các web.
   ➜ Tương thích PHP: Tự động nhúng Extension `redis.so` và `igbinary.so` vào toàn bộ các phiên bản PHP đang chạy trên OpenLiteSpeed.

2. TÍNH NĂNG HỦY CÀI ĐẶT (UNINSTALL OBJECT CACHE):
   ➜ Dọn dẹp sạch sẽ: Tự động dừng dịch vụ (Stop Service), gỡ bỏ gói cài đặt, xóa thư mục dữ liệu, và dọn dẹp các tài khoản ACL đã được mã hóa trong hệ thống để trả lại dung lượng RAM cho máy chủ.
   ➜ An toàn: Hệ thống sẽ tự động tắt Extension PHP liên quan, do đó bạn không cần lo lắng về lỗi 500 khi gỡ bỏ.

  ⚠️ CẢNH BÁO QUAN TRỌNG KHI SỬ DỤNG:
- "Đại gia sát RAM": Object Cache ngốn rất nhiều RAM. Tuyệt đối KHÔNG nên cài đặt tính năng này nếu VPS của bạn chỉ có 1GB RAM, vì nó sẽ dễ dàng đẩy máy chủ vào trạng thái tràn bộ nhớ (OOM) làm sập luôn cả MariaDB.
- Bảo mật Mật khẩu: Master Password (Mật khẩu gốc) chỉ dành cho hệ thống quản trị nội bộ. Tuyệt đối KHÔNG sử dụng Master Password để điền vào cấu hình các Plugin trên WordPress. Hãy sử dụng Mật khẩu ACL riêng biệt được hệ thống cấp phát cho từng trang web.
EOF
}

# =========================================================================
# 1. NẠP THƯ VIỆN LÕI TRƯỚC KHI KIỂM TRA RAM (TRÁNH LỖI COMMAND NOT FOUND)
# =========================================================================
. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

if [[ "${1:-}" == "98" && ! -t 0 ]]; then
  huong_dan
  exit 0
fi

TOTAL_RAM_MB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)

# 1. HARD BLOCK (Chặn tuyệt đối) với VPS siêu nhỏ (512MB)
if ((TOTAL_RAM_MB <= 600)); then
  _runloi "Cài đặt Object Cache"
  echo -e "${C_RED}CẢNH BÁO: VPS của bạn chỉ có ${TOTAL_RAM_MB}MB RAM!${C_RESET}"
  echo -e "Việc cài đặt Object Cache trên VPS < 1GB RAM chắc chắn sẽ gây tràn bộ nhớ (OOM) và sập Database."
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# 2. SOFT WARNING (Cảnh báo mềm) với VPS 1GB
if ((TOTAL_RAM_MB > 600 && TOTAL_RAM_MB <= 1200)); then
  echo -e "\n${C_YELLOW}CẢNH BÁO TÀI NGUYÊN (VPS ~ 1GB RAM):${C_RESET}"
  echo -e "Hệ thống nhận thấy VPS của bạn có khoảng ${TOTAL_RAM_MB}MB RAM."
  echo -e "Ở mức RAM này, bạn ${C_GREEN}CÓ THỂ${C_RESET} cài Object Cache, nhưng hệ thống sẽ phải ép giới hạn dung lượng Redis/Valkey rất nhỏ (khoảng 64MB) để chống sập."
  echo -e "Lưu ý: Nếu web của bạn là WooCommerce nặng, 1GB RAM vẫn là không đủ dù có cài Object Cache.\n"

  if ! wptt_xac_nhan "Bạn có chắc chắn muốn tiếp tục cài đặt Object Cache không?" "Gợi ý: Chọn [Không]." "n" "Vẫn Cài Đặt" "Hủy Bỏ"; then
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi
fi

# =========================================================================
# 2. CÁC HÀM BỔ TRỢ KẾT NỐI CLI & ĐỒNG BỘ ACL ĐA ENGINE (VALKEY/KEYDB/REDIS)
# =========================================================================

# Xác định đúng binary CLI tương ứng với Engine đang chạy
_wptt_get_cache_cli() {
  case "${active_cache:-}" in
    valkey)
      command -v valkey-cli >/dev/null 2>&1 && { echo "valkey-cli"; return 0; }
      ;;
    keydb)
      command -v keydb-cli >/dev/null 2>&1 && { echo "keydb-cli"; return 0; }
      ;;
    redis)
      command -v redis-cli >/dev/null 2>&1 && { echo "redis-cli"; return 0; }
      ;;
  esac
  if command -v valkey-cli >/dev/null 2>&1; then
    echo "valkey-cli"
  elif command -v keydb-cli >/dev/null 2>&1; then
    echo "keydb-cli"
  else
    echo "redis-cli"
  fi
}

# Đợi Unix Socket sẵn sàng sau khi khởi động dịch vụ (Fix lỗi KeyDB khởi động đa luồng chậm)
_wptt_wait_cache_socket() {
  local sock="$1"
  local tries=0
  while ((tries < 25)); do
    [[ -S "$sock" ]] && return 0
    sleep 0.2
    ((tries++))
  done
  return 1
}

# Ghi hoặc cập nhật khóa cấu hình vào file vhost nguyên tử (Atomic Replace 100% độc lập)
_wptt_set_vhost_kv() {
  local target_file="$1"
  local cfg_key="$2"
  local cfg_val="$3"

  [[ ! -f "$target_file" || -z "$cfg_key" ]] && return 1

  /bin/mkdir -p /etc/wptt/tmp
  /bin/chmod 700 /etc/wptt/tmp
  local tmp_vhost
  tmp_vhost=$(/bin/mktemp /etc/wptt/tmp/wptt_vhost_kv_XXXXXX) || return 1

  # Dùng awk xóa toàn bộ dòng cũ của cfg_key (kể cả dòng bị rỗng redis_db_id=) và ghi dòng mới chuẩn xác
  if /usr/bin/awk -v k="$cfg_key" -v v="$cfg_val" '
    BEGIN { found = 0 }
    $0 ~ "^[[:space:]]*" k "=" {
      if (!found) {
        print k "=\x27" v "\x27"
        found = 1
      }
      next
    }
    { print }
    END {
      if (!found) {
        print k "=\x27" v "\x27"
      }
    }
  ' "$target_file" >"$tmp_vhost"; then
    /bin/chown --reference="$target_file" -- "$tmp_vhost" 2>/dev/null || true
    /bin/chmod --reference="$target_file" -- "$tmp_vhost" 2>/dev/null || true
    /bin/mv -T -- "$tmp_vhost" "$target_file"
  else
    /bin/rm -f -- "$tmp_vhost"
    return 1
  fi
}

# Thực thi lệnh ACL trên Valkey / KeyDB / Redis an toàn (Không lộ mật khẩu qua ps aux nhờ REDISCLI_AUTH)
_wptt_apply_acl_user() {
  local cli="$1"
  local sock="$2"
  local master_pass="$3"
  local acl_user="$4"
  local acl_pass="$5"

  [[ ! -S "$sock" || -z "$master_pass" || -z "$acl_user" || -z "$acl_pass" ]] && return 1

  # Quy tắc ACL chuẩn tương thích 100% với cả Redis 6 / KeyDB lẫn Redis 7 / Valkey:
  # - Bắt buộc có `reset` ở đầu để xóa trạng thái lỗi cũ của user (nếu có).
  # - Bắt buộc có `+select` tường minh để cho phép chuyển sang Database ID > 0 trên KeyDB!
  local -a rules_v1=(reset on ">$acl_pass" "~*" "+@all" -flushall +flushdb +select -config -module -replicaof -slaveof -acl -shutdown -save -bgsave -debug -monitor -swapdb)
  local -a rules_keydb=(reset on ">$acl_pass" "~*" "+@all" -flushall +flushdb +select -config -acl -shutdown -save -bgsave -debug -monitor)

  local out=""
  out=$(REDISCLI_AUTH="$master_pass" "$cli" -s "$sock" ACL SETUSER "$acl_user" "${rules_v1[@]}" 2>&1)
  if [[ "$out" != *"OK"* ]]; then
    # Fallback nếu KeyDB kén một trong các flag phụ (-module / -swapdb)
    out=$(REDISCLI_AUTH="$master_pass" "$cli" -s "$sock" ACL SETUSER "$acl_user" "${rules_keydb[@]}" 2>&1)
  fi
  if [[ "$out" != *"OK"* ]]; then
    # Fallback trường hợp Engine chưa nhận REDISCLI_AUTH (một số bản keydb-cli cũ cần cờ -a)
    "$cli" -s "$sock" -a "$master_pass" --no-auth-warning ACL SETUSER "$acl_user" "${rules_keydb[@]}" >/dev/null 2>&1 || true
  fi

  # Lưu xuống đĩa cứng (users.acl)
  REDISCLI_AUTH="$master_pass" "$cli" -s "$sock" ACL SAVE >/dev/null 2>&1 || \
    "$cli" -s "$sock" -a "$master_pass" --no-auth-warning ACL SAVE >/dev/null 2>&1 || true
  return 0
}

# =========================================================================
# 3. HÀM RENDER DANH SÁCH ACL VÀ CẤP PHÁT DATABASE CÔ LẬP
# =========================================================================
function in_thong_tin_acl_cho_khach() {
  if [[ "$socket_path" == "Không có" || "$active_cache" == "Chưa cài đặt" ]]; then
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THÔNG TIN KẾT NỐI OBJECT CACHE (ACL & DB)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  ${C_RED}Hệ thống hiện chưa cài đặt Object Cache.${C_RESET}" 2
    left_text "  Vui lòng cài đặt Engine (Valkey/KeyDB/Redis) để tạo tài khoản!" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    return
  fi

  _wptt_wait_cache_socket "$socket_path" || true

  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}THÔNG TIN KẾT NỐI OBJECT CACHE (ACL & DB CÔ LẬP)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Để kích hoạt Cache, bạn vui lòng sử dụng chính xác các thông số bên dưới:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  ➤ Host / Đường dẫn  : ${C_YELLOW}$socket_path${C_RESET}" 2
  left_text "  ➤ Port / Cổng       : ${C_YELLOW}0${C_RESET}" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  local cache_cli
  cache_cli="$(_wptt_get_cache_cli)"

  wptt_load_main_conf 2>/dev/null
  local raw_master_pass=""
  [[ -n "${REDIS_MASTER_PASS:-}" ]] && raw_master_pass=$(wptt_giai_ma "$REDIS_MASTER_PASS")

  # Mở khóa đủ 1000 Databases trên RAM cho KeyDB/Valkey/Redis
  if [[ -S "$socket_path" && -n "$raw_master_pass" ]]; then
    REDISCLI_AUTH="$raw_master_pass" "$cache_cli" -s "$socket_path" CONFIG SET databases 1000 >/dev/null 2>&1 || true
  fi

  local -a taken_db_ids=()
  local filepath="" domain=""

  shopt -s nullglob
  local -a vhost_files=(/etc/wptt/vhost/.*.conf)
  shopt -u nullglob

  local found=0
  for filepath in "${vhost_files[@]}"; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    unset redis_acl_user redis_acl_pass redis_db_id User_name_vhost
    # shellcheck source=/dev/null
    source "$filepath" 2>/dev/null || true
    local pass_show=""
    local need_new_db_id=0

    # 1. Kiểm tra & Tự động cấp lại nếu redis_db_id bị rỗng hoặc trùng với web trước đó
    if [[ -z "${redis_db_id:-}" || ! "${redis_db_id:-}" =~ ^[0-9]+$ ]] || ((10#$redis_db_id < 1 || 10#$redis_db_id > 999)); then
      need_new_db_id=1
    elif [[ -n "${taken_db_ids[$((10#$redis_db_id))]:-}" ]]; then
      need_new_db_id=1
    else
      redis_db_id=$((10#$redis_db_id))
      taken_db_ids[redis_db_id]=1
    fi

    if ((need_new_db_id == 1)); then
      local cand_id=1
      while ((cand_id <= 999)); do
        if [[ -z "${taken_db_ids[cand_id]:-}" ]]; then
          break
        fi
        ((cand_id++))
      done
      ((cand_id > 999)) && cand_id=999
      redis_db_id=$cand_id
      taken_db_ids[redis_db_id]=1
      _wptt_set_vhost_kv "$filepath" "redis_db_id" "$redis_db_id"
    fi

    # 2. Kiểm tra & Tự động tạo lại nếu User hoặc Pass bị rỗng (hoặc giải mã ra rỗng)
    if [[ -n "${redis_acl_pass:-}" ]]; then
      pass_show=$(wptt_giai_ma "$redis_acl_pass" 2>/dev/null || true)
    fi

    if [[ -z "${redis_acl_user:-}" || -z "${redis_acl_pass:-}" || -z "$pass_show" ]]; then
      redis_acl_user=$(openssl rand -hex 12)
      local raw_pass
      raw_pass=$(openssl rand -hex 16)
      redis_acl_pass=$(wptt_ma_hoa "$raw_pass")

      _wptt_set_vhost_kv "$filepath" "redis_acl_user" "$redis_acl_user"
      _wptt_set_vhost_kv "$filepath" "redis_acl_pass" "$redis_acl_pass"
      pass_show="$raw_pass"
    fi

    # 3. Đồng bộ tài khoản ACL vào Engine đang chạy (Valkey / KeyDB / Redis)
    if [[ "$socket_path" != "Không có" && -n "$raw_master_pass" && -n "$pass_show" ]]; then
      _wptt_apply_acl_user "$cache_cli" "$socket_path" "$raw_master_pass" "$redis_acl_user" "$pass_show"
    fi

    if [[ -n "${redis_acl_user:-}" && -n "$pass_show" ]]; then
      left_text "Website: ${C_GREEN}$domain${C_RESET}" 2
      left_text "   - Username    : ${C_BOLD_WHITE}$redis_acl_user${C_RESET}" 2
      left_text "   - Password    : ${C_YELLOW}$pass_show${C_RESET}" 2
      left_text "   - Database ID : ${C_CYAN}${redis_db_id}${C_RESET}" 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      found=1
    fi
  done

  if [[ $found -eq 0 ]]; then
    left_text "  Không tìm thấy Website nào trên hệ thống." 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  else
    echo -en "\033[1A\033[2K\r"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "\n${C_GREEN}HƯỚNG DẪN ĐIỀN VÀO LITESPEED CACHE / WP-REDIS:${C_RESET}"
    echo -e "1. Bật Object Cache: ${C_YELLOW}ON${C_RESET} | Method: ${C_YELLOW}Redis${C_RESET}"
    echo -e "2. Host: ${C_YELLOW}$socket_path${C_RESET} (hoặc ${C_YELLOW}unix://$socket_path${C_RESET}) | Port: ${C_YELLOW}0${C_RESET}"
    echo -e "3. Copy Username/Password và điền đúng số ID Database ở trên."
  fi

  if [[ -n "$raw_master_pass" ]]; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}THÔNG TIN QUẢN TRỊ MASTER KEY (CHỈ DÀNH CHO ADMIN)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Mật khẩu gốc (Master Password) của hệ thống Object Cache:" 2
    center_text "${C_YELLOW}$raw_master_pass${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  ${C_YELLOW}CẢNH BÁO BẢO MẬT:${C_RESET}" 2
    left_text "  - Tuyệt đối KHÔNG lấy Master Key này điền vào plugin Website." 2
    left_text "  - Chỉ sử dụng để Debug hoặc bảo trì hệ thống qua dòng lệnh Terminal." 2
    left_text "    (VD: $cache_cli -s $socket_path -a \"Master_Key\" PING)" 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  fi
}

in_menu_wptt="${1:-}"
function hien_thi_tai_khoan_acl() {
  clear
  in_thong_tin_acl_cho_khach
  wptt_quay_ve_menu "${in_menu_wptt:-}" 0 "enter"
}

# =========================================================================
# 4. GIAO DIỆN CHÍNH & KIỂM TRA TRẠNG THÁI ENGINE
# =========================================================================
clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_cache:-Quản lý Cache} ➜ Object Cache (Valkey / KeyDB / Redis)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

active_cache="Chưa cài đặt"
socket_path="Không có"
if systemctl is-active --quiet valkey-server 2>/dev/null || systemctl is-active --quiet valkey 2>/dev/null; then
  active_cache="valkey"
  active_name_display="Valkey"
  socket_path="/var/run/valkey/valkey.sock"
elif systemctl is-active --quiet keydb-server 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null; then
  active_cache="keydb"
  active_name_display="KeyDB"
  socket_path="/var/run/keydb/keydb.sock"
elif systemctl is-active --quiet redis-server 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null; then
  active_cache="redis"
  active_name_display="Redis"
  socket_path="/var/run/redis/redis.sock"
fi

box_inner_width=${box_inner_width:-78}
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
if [[ "$active_cache" != "Chưa cài đặt" ]]; then
  left_text "Trạng thái    : ${C_GREEN}Đang hoạt động (${active_name_display})${C_RESET}" 2
  left_text "Unix Socket   : ${C_YELLOW}$socket_path${C_RESET}" 2
  left_text "Bảo mật ACL   : ${C_GREEN}Đã kích hoạt (Unix Socket + Master Lock)${C_RESET}" 2
else
  left_text "Trạng thái    : ${C_RED}Chưa cài đặt Object Cache${C_RESET}" 2
fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
center_text "${C_YELLOW}VUI LÒNG CHỌN ENGINE BẠN MUỐN QUẢN LÝ / CÀI ĐẶT${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

OUTPUT=$(cat /etc/*release 2>/dev/null || true)
is_alma_10=false
if echo "$OUTPUT" | grep -q "AlmaLinux 10\|Rocky Linux 10\|Red Hat Enterprise Linux 10\|Oracle Linux Server 10"; then is_alma_10=true; fi

left_text "  ${C_CYAN}1)${C_RESET} ${C_BOLD_WHITE}Valkey${C_RESET} (Khuyên dùng - Nhanh, nhẹ, ổn định nhất)" 2
left_text "  ${C_CYAN}2)${C_RESET} ${C_BOLD_WHITE}KeyDB${C_RESET}  (Tối ưu ép xung Đa luồng cho VPS nhiều Core)" 2
if ! $is_alma_10; then left_text "  ${C_CYAN}3)${C_RESET} ${C_BOLD_WHITE}Redis${C_RESET}  (Phiên bản truyền thống)" 2; fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "  ${C_CYAN}4)${C_RESET} ${C_YELLOW}Xem thông tin Tài khoản ACL & Database ID${C_RESET}" 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  if $is_alma_10; then echo -en "${C_CYAN}Nhập lựa chọn của bạn [1-2, 4] [0=Thoát]: ${C_RESET}"; else echo -en "${C_CYAN}Nhập lựa chọn của bạn [1-4] [0=Thoát]: ${C_RESET}"; fi
  read -r cache_choice || exit 0
  if [[ "$cache_choice" == "0" ]]; then
    echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
    wptt_quay_ve_menu "${1:-}" 0
  fi
  case "$cache_choice" in
    1)
      name_service="valkey"
      display_name="Valkey"
      break
      ;;
    2)
      name_service="keydb"
      display_name="KeyDB"
      break
      ;;
    3)
      if ! $is_alma_10; then
        name_service="redis"
        display_name="Redis"
        break
      else
        echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
      fi
      ;;
    4) hien_thi_tai_khoan_acl ;;
    *) echo -e "${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}" ;;
  esac
done

duong_dan_config_redis="/etc/$name_service/$name_service.conf"
if echo "$OUTPUT" | grep -q "AlmaLinux 8\|Rocky Linux 8\|Red Hat Enterprise Linux 8\|Oracle Linux Server 8" && [[ "$name_service" == 'redis' ]]; then
  duong_dan_config_redis="/etc/$name_service.conf"
fi
if [[ ! -f "$duong_dan_config_redis" && -f "/etc/$name_service.conf" ]]; then
  duong_dan_config_redis="/etc/$name_service.conf"
elif [[ ! -f "$duong_dan_config_redis" && -f "/etc/$name_service/$name_service.conf" ]]; then
  duong_dan_config_redis="/etc/$name_service/$name_service.conf"
fi

echo ""
if [[ ! -f "$duong_dan_config_redis" ]]; then
  if [[ "$active_cache" != "Chưa cài đặt" && "$active_cache" != "$name_service" ]]; then
    msg_confirm="Hệ thống đang chạy ${C_YELLOW}$active_name_display${C_RESET}. Bạn có muốn XÓA nó và cài đặt ${C_GREEN}$display_name${C_RESET} không?"
  else
    msg_confirm="Bạn có muốn tiến hành CÀI ĐẶT ${C_GREEN}$display_name${C_RESET} không?"
  fi

  if wptt_xac_nhan "$msg_confirm" "" "" "Đồng ý Cài đặt" "Hủy bỏ"; then
    echo ""
    _runing "Cài đặt Package $display_name"
    wptt_logs "INFO" "Kích hoạt $name_service"

    for other_service in redis valkey keydb; do
      if [[ "$other_service" != "$name_service" ]]; then
        systemctl stop "$other_service" "${other_service}-server" >/dev/null 2>&1 || true
        systemctl disable "$other_service" "${other_service}-server" >/dev/null 2>&1 || true
        killall -9 "${other_service}-server" "${other_service}" >/dev/null 2>&1 || true
        if grep -q "Ubuntu\|Debian" /etc/*release 2>/dev/null; then
          apt-get remove --purge "$other_service" "${other_service}-server" -y >/dev/null 2>&1 || true
        else
          dnf remove "${other_service:?}" -y >/dev/null 2>&1 || true
        fi
        rm -rf /etc/"${other_service:?}".conf /etc/"${other_service:?}" /var/run/"${other_service:?}" /var/lib/"${other_service:?}" /var/log/"${other_service:?}" /etc/monit.d/"${other_service:?}" /etc/monit/conf.d/"${other_service:?}"
      fi
    done

    if grep -q "Ubuntu\|Debian" /etc/*release 2>/dev/null; then
      apt-get update >/dev/null 2>&1
      apt-get install "$name_service" "${name_service}"-server -y >/dev/null 2>&1 || apt-get install "$name_service" -y >/dev/null 2>&1
      mapfile -t lsphp < <(ls -A /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$')
      for phpredis in "${lsphp[@]}"; do
        apt-get install lsphp"${phpredis}"-redis lsphp"${phpredis}"-igbinary -y >/dev/null 2>&1 || true
      done
    else
      dnf install epel-release -y >/dev/null 2>&1 || true
      yum install "${name_service}" -y --disablerepo="mariadb" >/dev/null 2>&1
      mapfile -t lsphp < <(ls -A /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$')
      (/etc/wptt/php/kho-luu-tru-litespeed)
      for phpredis in "${lsphp[@]}"; do
        if dnf list available 2>/dev/null | grep -q "lsphp${phpredis}-pecl-redis"; then
          yum install lsphp"${phpredis}"-pecl-redis lsphp"${phpredis}"-pecl-igbinary -y --disablerepo="mariadb" >/dev/null 2>&1 || true
        else
          dnf install "https://rpms.litespeedtech.com/centos/8/x86_64/lsphp${phpredis}-pecl-redis-6.0.2-1.el8.x86_64.rpm" -y >/dev/null 2>&1 || true
          dnf install "https://rpms.litespeedtech.com/centos/8/x86_64/lsphp${phpredis}-pecl-igbinary-3.2.14-1.el8.x86_64.rpm" -y >/dev/null 2>&1 || true
        fi
      done
    fi

    if [[ ! -f "$duong_dan_config_redis" ]]; then
      if [[ -f "/etc/$name_service/$name_service.conf" ]]; then
        duong_dan_config_redis="/etc/$name_service/$name_service.conf"
      elif [[ -f "/etc/$name_service.conf" ]]; then
        duong_dan_config_redis="/etc/$name_service.conf"
      fi
    fi
    _rundone "Cài đặt Package $display_name"

    _runing "Cấu hình bảo mật Unix Socket + Requirepass"

    wptt_load_main_conf 2>/dev/null
    if [[ -z "${REDIS_MASTER_PASS:-}" ]]; then
      raw_master=$(openssl rand -hex 24)
      master_pass_encrypted=$(wptt_ma_hoa "$raw_master")
      echo "REDIS_MASTER_PASS='$master_pass_encrypted'" >>/etc/wptt/.wptt.conf
      REDIS_MASTER_PASS="$master_pass_encrypted"
    fi
    dec_master_pass=$(wptt_giai_ma "$REDIS_MASTER_PASS")

    # -------------------------------------------------------------------------
    # [FIX QUAN TRỌNG CHO KEYDB]:
    # 1. Ghi sẵn "user default on >MasterPass ~* +@all" vào users.acl trước khi
    #    khởi động để KeyDB KHÔNG bị lỗi xung đột giữa requirepass và aclfile rỗng!
    # 2. Vô hiệu hóa các dòng databases 16, port 6379, active-replica cũ trong
    #    file cấu hình gốc của KeyDB để databases 1000 và SELECT <db_id> hoạt động 100%.
    # -------------------------------------------------------------------------
    mkdir -p "/etc/$name_service"
    umask 077
    printf 'user default on >%s ~* +@all\n' "$dec_master_pass" >"/etc/$name_service/users.acl"
    umask 022
    chown -hR "$name_service":"$name_service" "/etc/$name_service/users.acl" 2>/dev/null || true
    chmod 600 "/etc/$name_service/users.acl"

    # Comment sạch các chỉ thị cũ trong file config gốc để tránh xung đột với cấu hình WPTangToc ở cuối file
    sed -i -E \
      -e 's/^[[:space:]]*(port[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(bind[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(unixsocket[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(unixsocketperm[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(requirepass[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(aclfile[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(databases[[:space:]]+)/#\1/g' \
      -e 's/^[[:space:]]*(active-replica[[:space:]]+yes)/#active-replica no/g' \
      -e 's/^[[:space:]]*(multi-master[[:space:]]+yes)/#multi-master no/g' \
      -e 's/^[[:space:]]*tcp-keepalive 300/tcp-keepalive 0/g' \
      -e 's/^[[:space:]]*rdbcompression yes/rdbcompression no/g' \
      -e 's/^[[:space:]]*rdbchecksum yes/rdbchecksum no/g' \
      "$duong_dan_config_redis"

    cat <<EOF >>"$duong_dan_config_redis"

# WPTangToc Optimize
port 0
unixsocket /var/run/$name_service/$name_service.sock
unixsocketperm 777
requirepass "$dec_master_pass"
aclfile /etc/$name_service/users.acl
maxmemory 128mb
maxmemory-policy allkeys-lfu
databases 1000
save ""
appendonly no
tcp-keepalive 60
EOF

    mkdir -p /var/run/"$name_service" /var/lib/"$name_service" /var/log/"$name_service"
    chmod 755 /var/run/"$name_service"
    chmod 700 /var/lib/"$name_service"

    chown -hR "$name_service":"$name_service" /var/run/"$name_service" /var/log/"$name_service" /var/lib/"$name_service" 2>/dev/null || true
    chown "$name_service":"$name_service" "$duong_dan_config_redis" 2>/dev/null || true
    chmod 600 "$duong_dan_config_redis"

    systemctl daemon-reload >/dev/null 2>&1
    if systemctl list-unit-files | grep -q "^${name_service}-server.service"; then
      SVC_NAME="${name_service}-server"
    else
      SVC_NAME="${name_service}"
    fi
    systemctl enable "$SVC_NAME" >/dev/null 2>&1
    systemctl restart "$SVC_NAME" >/dev/null 2>&1

    # Chờ Unix Socket của KeyDB/Valkey xuất hiện rồi mới tiếp tục nạp ACL
    active_cache="$name_service"
    active_name_display="$display_name"
    socket_path="/var/run/$name_service/$name_service.sock"
    _wptt_wait_cache_socket "$socket_path" || true

    systemctl restart lsws >/dev/null 2>&1

    (/bin/bash /etc/wptt/monit >/dev/null 2>&1) || true
    (/bin/bash /etc/wptt/cache/object-cache-optimize-tune >/dev/null 2>&1) || true
    (/bin/bash /etc/wptt/oomscore >/dev/null 2>&1) || true

    _rundone "Cấu hình bảo mật Unix Socket + Requirepass"

    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT CÀI ĐẶT OBJECT CACHE${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Engine        : ${C_YELLOW}$display_name${C_RESET}" 2
    left_text "Chế độ        : ${C_GREEN}Unix Socket + Admin ACL Master${C_RESET}" 2
    left_text "Cô lập Dữ liệu: ${C_GREEN}Đã kích hoạt Database ID độc lập (1000 DBs)${C_RESET}" 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

    in_thong_tin_acl_cho_khach
    echo -en "\nNhấn phím ${C_GREEN}Enter${C_RESET} để tiếp tục..."
    read -r
  else
    echo -e "${C_YELLOW}Đã hủy thao tác Cài đặt.${C_RESET}"
  fi
else
  if wptt_xac_nhan "Hệ thống đang chạy ${C_YELLOW}$display_name${C_RESET}. Bạn có chắc chắn muốn GỠ BỎ không?" "" "" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
    echo ""
    wptt_logs "INFO" "Huỷ kích hoạt $name_service"

    _runing "Gỡ bỏ hoàn toàn $display_name và dọn dẹp hệ thống"
    systemctl stop "${name_service}" "${name_service}"-server >/dev/null 2>&1 || true
    systemctl disable "${name_service}" "${name_service}"-server >/dev/null 2>&1 || true

    if echo "$OUTPUT" | grep -qi "Ubuntu\|Debian"; then
      apt-get remove --purge "${name_service}" "${name_service}"-server -y >/dev/null 2>&1 || true
    else
      yum remove "${name_service}" -y >/dev/null 2>&1 || true
    fi

    mapfile -t lsphp < <(ls /usr/local/lsws | grep -oP '^lsphp\K[0-9]+$')
    for php_redis in "${lsphp[@]}"; do
      yum remove lsphp"${php_redis}"-pecl-redis -y --disablerepo="*" --enablerepo="litespeed,litespeed-update" >/dev/null 2>&1 || true
    done

    rm -rf "${duong_dan_config_redis:?}" /var/run/"${name_service:?}" /var/lib/"${name_service:?}" /var/log/"${name_service:?}"
    [[ -n "$name_service" && -d /etc/"${name_service}" ]] && rm -rf /etc/"${name_service:?}"
    if grep -qi "ubuntu\|debian" /etc/*release 2>/dev/null; then DIR_MONIT="/etc/monit/conf.d"; else DIR_MONIT="/etc/monit.d"; fi
    [[ -f "$DIR_MONIT/$name_service" ]] && rm -f "$DIR_MONIT/$name_service"
    if systemctl is-active --quiet monit; then systemctl reload monit >/dev/null 2>&1; fi

    sed -i '/^REDIS_MASTER_PASS=/d' /etc/wptt/.wptt.conf 2>/dev/null || true
    for vhost_file in /etc/wptt/vhost/.*.conf; do
      if [[ -f "$vhost_file" ]]; then
        sed -i '/^redis_acl_user=/d' "$vhost_file"
        sed -i '/^redis_acl_pass=/d' "$vhost_file"
        sed -i '/^redis_db_id=/d' "$vhost_file"
      fi
    done

    _rundone "Gỡ bỏ hoàn toàn $display_name và dọn dẹp hệ thống"
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ OBJECT CACHE${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hệ thống đã xóa sạch ${C_YELLOW}$display_name${C_RESET}, PHP Extension và các biến ACL." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "${C_YELLOW}Đã hủy thao tác Gỡ bỏ.${C_RESET}"
  fi
fi

wptt_quay_ve_menu "${1:-}" 0
