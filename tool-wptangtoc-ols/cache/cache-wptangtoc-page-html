#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Kích hoạt Rewrite Page Cache HTML & Pre-compressed Gzip (.html + .html.gz) cho OpenLiteSpeed

set -Eeuo pipefail

# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true
wptt_load_main_conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

tmp_dir=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${tmp_dir:-}" && -d "$tmp_dir" ]]; then
    case "$tmp_dir" in
      /etc/wptt/tmp/*) /bin/rm -rf -- "${tmp_dir:?}" 2>/dev/null || true ;;
    esac
  fi
  exit "$rc"
}
on_error() {
  printf '[ERROR] Dòng %s, lệnh: %s (mã lỗi: %s)\n' "$2" "$3" "$1" >&2
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
trap 'on_error $? $LINENO "$BASH_COMMAND"' ERR

# Đảm bảo Locale UTF-8 để đếm độ dài ký tự tiếng Việt chính xác (0-subshell)
_wptt_eff_cs="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "${_wptt_eff_cs,,}" in
  *utf-8* | *utf8*) : ;;
  *)
    if [[ -n "${LC_ALL:-}" ]]; then
      export LC_ALL="C.UTF-8"
    else
      export LC_CTYPE="C.UTF-8"
    fi
    ;;
esac
unset _wptt_eff_cs

printf '|Quản lý Cache => Thêm rewrite htaccess cache WPTangToc|\n'

MENU_ARG="${1:-}"
NAME="${1:-}"
if [[ "$NAME" == "98" || "$NAME" == "99" ]]; then
  NAME=""
fi

function lua_chon_NAME() {
  local action_desc="${1:-}"
  unset NAME
  local -a selects=()
  local i=1
  local box_inner_width="${box_inner_width:-78}"
  local filepath="" domain=""

  # 1. Quét các domain có cài WordPress & đã kích hoạt plugin WPTangToc Cache (Cache.php)
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
      if [[ -f "/usr/local/lsws/$domain/html/wp-load.php" && -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
        if [[ -f "/usr/local/lsws/$domain/html/wp-content/plugins/wptangtoc/class/Cache.php" ]]; then
          selects+=("$domain")
        fi
      fi
    fi
  done
  shopt -u nullglob

  # 2. Kiểm tra nếu chưa có website nào thỏa mãn
  if [[ ${#selects[@]} -eq 0 ]]; then
    clear
    printf '\n%b❌ Lỗi: Không có website WordPress nào đã kích hoạt WPTangToc Cache (Cache.php) trên hệ thống.%b\n' "${C_RED:-}" "${C_RESET:-}"
    if declare -F wptt_quay_ve_menu >/dev/null 2>&1; then
      wptt_quay_ve_menu "${MENU_ARG:-}" 1 "enter"
    fi
    exit 1
  fi

  # 3. Sắp xếp mảng chuẩn tự nhiên
  mapfile -t selects < <(printf '%s\n' "${selects[@]}" | sort -uV)

  # 4. Render bảng chọn chuẩn khung 78 cột (0-subshell character count)
  printf '%b╭──────────────────────────────────────────────────────────────────────────────╮%b\n' "${C_CYAN:-}" "${C_RESET:-}"

  if [[ -n "$action_desc" ]]; then
    local title_text="${lua_chon_website_ban_muon:-Nhập lựa chọn website của bạn muốn} $action_desc:"
    local clean_title="$title_text"
    if declare -F _wptt_strip_ansi >/dev/null 2>&1; then
      _wptt_strip_ansi "$title_text"
      clean_title="$WPTT_CLEAN_STR"
    fi
    clean_title="${clean_title//$'\r'/}"
    clean_title="${clean_title//$'\n'/}"

    local len=${#clean_title}
    local pad_r=$((box_inner_width - len - 2))
    ((pad_r < 0)) && pad_r=0

    printf '%b│%b  %b%s%b%*s%b│%b\n' "${C_CYAN:-}" "${C_RESET:-}" "${C_YELLOW:-}" "$title_text" "${C_RESET:-}" "$pad_r" "" "${C_CYAN:-}" "${C_RESET:-}"

    local line_len=$((len + 3))
    ((line_len > box_inner_width)) && line_len=$box_inner_width
    local pad_line_r=$((box_inner_width - line_len))
    local short_line=""
    printf -v short_line '%*s' "$line_len" ""
    short_line="${short_line// /─}"

    printf '%b├%s%*s│%b\n' "${C_CYAN:-}" "$short_line" "$pad_line_r" "" "${C_RESET:-}"
  fi

  for domain in "${selects[@]}"; do
    local item_text="" clean_text="" len=0 pad=0
    printf -v item_text "  %b%3d)%b %b%s%b" "${C_CYAN:-}" "$i" "${C_RESET:-}" "${C_BOLD_WHITE:-}" "$domain" "${C_RESET:-}"
    printf -v clean_text "  %3d) %s" "$i" "$domain"

    len=${#clean_text}
    pad=$((box_inner_width - len))
    ((pad < 0)) && pad=0

    printf '%b│%b%s%*s%b│%b\n' "${C_CYAN:-}" "${C_RESET:-}" "$item_text" "$pad" "" "${C_CYAN:-}" "${C_RESET:-}"
    ((i++))
  done
  printf '%b╰──────────────────────────────────────────────────────────────────────────────╯%b\n' "${C_CYAN:-}" "${C_RESET:-}"

  # 5. Dòng nhắc lệnh hỗ trợ FZF
  local fzf_installed=false
  if command -v fzf &>/dev/null; then
    fzf_installed=true
  fi

  local prompt_quick_select=""
  if [[ "$fzf_installed" == true && ${#selects[@]} -gt 1 ]]; then
    prompt_quick_select=" [00=${chon_nhanh:-Chọn nhanh}]"
  fi

  local PROMPT_TEXT="${nhap_lua_chon_website_cua_ban:-Nhập lựa chọn website của bạn} (1-${#selects[@]})${prompt_quick_select} [0=${exit_thoat:-Thoát}]: "

  # Xả sạch phím bấm thừa trong bộ đệm trước khi đọc
  if declare -F wptt_flush_stdin >/dev/null 2>&1; then
    wptt_flush_stdin
  fi

  # 6. Động cơ nhận phím an toàn
  while true; do
    printf '%b%s%b' "${C_CYAN:-}" "$PROMPT_TEXT" "${C_RESET:-}"

    if ! IFS= read -r REPLY; then
      printf '\n%b⚠️ Đã mất kết nối Terminal (EOF). Tự động thoát để bảo vệ hệ thống...%b\n' "${C_RED:-}" "${C_RESET:-}"
      exit 1
    fi

    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
      0)
        printf '\n%bĐang thoát...%b\n' "${C_GREEN:-}" "${C_RESET:-}"
        NAME="0"
        return 0
        ;;

      00)
        if [[ "$fzf_installed" == true && ${#selects[@]} -gt 1 ]]; then
          local fzf_height=$((${#selects[@]} + 4))
          local fzf_prompt="${nhap_lua_chon_website_cua_ban:-Tìm kiếm website} (Mũi tên di chuyển, Enter chọn, ESC hủy): "
          local selected_name=""
          local fzf_exit_status=0

          selected_name=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="$fzf_prompt" --height="$fzf_height" --border=rounded --color=border:red --cycle --reverse) || fzf_exit_status=$?
          selected_name="${selected_name#*: }"

          if [[ $fzf_exit_status -eq 0 && -n "$selected_name" ]]; then
            NAME="$selected_name"
            return 0
          else
            printf '\n%bĐã hủy chọn. %s%b\n' "${C_YELLOW:-}" "${vui_long_chon_lai:-Vui lòng chọn lại.}" "${C_RESET:-}"
            continue
          fi
        else
          printf '\n%b❌ Lỗi: %s "00". Tính năng chọn nhanh không khả dụng lúc này.%b\n' "${C_RED:-}" "${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ}" "${C_RESET:-}"
          continue
        fi
        ;;

      *)
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((REPLY >= 1 && REPLY <= ${#selects[@]})); then
          local action_index=$((REPLY - 1))
          NAME="${selects[$action_index]}"
          return 0
        elif [[ "$REPLY" == ?*.?* && "$REPLY" != "." ]]; then
          local found=false
          local valid_domain=""
          for valid_domain in "${selects[@]}"; do
            if [[ "$valid_domain" == "$REPLY" ]]; then
              NAME="$valid_domain"
              found=true
              break
            fi
          done

          if [[ "$found" == true ]]; then
            return 0
          else
            printf '\n%b❌ Lỗi: Tên miền "%s" không tồn tại hoặc chưa bật Cache.php.%b\n' "${C_RED:-}" "$REPLY" "${C_RESET:-}"
            continue
          fi
        else
          printf '\n%b❌ %s: "%s". %s%b\n' "${C_RED:-}" "${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ}" "$REPLY" "${vui_long_chon_lai:-Vui lòng chọn lại.}" "${C_RESET:-}"
          continue
        fi
        ;;
    esac
  done
}

# ==============================================================================
# LUỒNG THỰC THI CHÍNH (ATOMIC, IDEMPOTENT & OLS NATIVE GZIP-STATIC)
# ==============================================================================
if [[ -z "${NAME:-}" ]]; then
  lua_chon_NAME "Cache WPTangToc"
fi

if [[ -z "${NAME:-}" || "$NAME" == "0" ]]; then
  exit 0
fi

# Validate tên miền nghiêm ngặt theo whitelist chống Path Traversal
if [[ ! "$NAME" =~ ^[a-zA-Z0-9._-]+$ || "$NAME" == -* || "$NAME" == *".."* ]]; then
  printf '%b❌ Lỗi: Tên miền không hợp lệ: %s%b\n' "${C_RED:-}" "$NAME" "${C_RESET:-}" >&2
  exit 1
fi

task_msg="Kích hoạt Rewrite Page Cache HTML (.html + .gz) cho $NAME"
if declare -F _runing >/dev/null 2>&1; then
  _runing "$task_msg"
fi

vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
doc_root="/usr/local/lsws/$NAME/html"
htaccess_file="$doc_root/.htaccess"

if [[ ! -f "$vhost_conf" || ! -d "$doc_root" ]]; then
  if declare -F _runloi >/dev/null 2>&1; then
    _runloi "$task_msg"
  fi
  printf '%b❌ Lỗi: Không tìm thấy cấu hình VHost hoặc thư mục gốc của %s.%b\n' "${C_RED:-}" "$NAME" "${C_RESET:-}" >&2
  exit 1
fi

/bin/mkdir -p /etc/wptt/tmp
/bin/chmod 700 /etc/wptt/tmp
tmp_dir=$(/bin/mktemp -d /etc/wptt/tmp/wptt-cache-XXXXXX)

# ------------------------------------------------------------------------------
# 1. CẬP NHẬT VHOST OPENLITESPEED NGUYÊN TỬ (TÁCH RIÊNG CONTEXT .HTML.GZ & .HTML)
#    Vì OLS bỏ qua <FilesMatch> và ForceType trong .htaccess, bắt buộc phải cấu hình:
#    - Context 1 (.html.gz): enableGzip 0, enableBr 0 (chống nén kép) + ép Header
#      Content-Type: text/html; charset=UTF-8 và Content-Encoding: gzip.
#    - Context 2 (.html): enableGzip 1 để OLS tự nén khi fallback.
# ------------------------------------------------------------------------------
vhost_backup="${tmp_dir}/vhost.conf.bak"
vhost_tmp="${tmp_dir}/vhost.conf.tmp"

/bin/cp -a -- "$vhost_conf" "$vhost_backup"
/bin/cp -a -- "$vhost_conf" "$vhost_tmp"

# Xóa toàn bộ các mẫu context cache html cũ để đảm bảo tính lũy đẳng (Idempotent 100%)
/bin/sed -i \
  -e '/^context exp:\^.\*(html)/,/^}$/d' \
  -e '/^context exp:\^.\*\\.(html|html\\.gz)\$/,/^}$/d' \
  -e '/^context exp:\^.\*\\.html\\.gz\$/,/^}$/d' \
  -e '/^context exp:\^.\*\\.html\$/,/^}$/d' \
  "$vhost_tmp"

cat <<'EOF' >>"$vhost_tmp"

context exp:^.*\.html\.gz$ {
  location                $DOC_ROOT/$0
  allowBrowse             1
  enableGzip              0
  enableBr                0
  extraHeaders            <<<END_extraHeaders
Content-Type: text/html; charset=UTF-8
Content-Encoding: gzip
Cache-Control: public, max-age=0, s-maxage=3600
Vary: Accept-Encoding, Cookie
x-wptangtoc-cache: HIT-GZIP
X-XSS-Protection: 1; mode=block
X-Frame-Options: SAMEORIGIN
Referrer-Policy: strict-origin-when-cross-origin
X-Content-Type-Options: nosniff
X-Powered-By: WPTangTocOLS
Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  END_extraHeaders

  rewrite  {

  }
  addDefaultCharset       off

  phpIniOverride  {

  }
}

context exp:^.*\.html$ {
  location                $DOC_ROOT/$0
  allowBrowse             1
  enableGzip              1
  extraHeaders            <<<END_extraHeaders
Content-Type: text/html; charset=UTF-8
Cache-Control: public, max-age=0, s-maxage=3600
Vary: Accept-Encoding, Cookie
x-wptangtoc-cache: HIT
X-XSS-Protection: 1; mode=block
X-Frame-Options: SAMEORIGIN
Referrer-Policy: strict-origin-when-cross-origin
X-Content-Type-Options: nosniff
X-Powered-By: WPTangTocOLS
Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  END_extraHeaders

  rewrite  {

  }
  addDefaultCharset       off

  phpIniOverride  {

  }
}
EOF

/bin/chown --reference="$vhost_conf" -- "$vhost_tmp" 2>/dev/null || true
/bin/chmod --reference="$vhost_conf" -- "$vhost_tmp" 2>/dev/null || true
/bin/mv -T -- "$vhost_tmp" "$vhost_conf"

# Validate cấu hình VHost với OpenLiteSpeed; nếu lỗi thì Rollback ngay lập tức
if [[ -x /usr/local/lsws/bin/openlitespeed ]]; then
  if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
    /bin/cp -a -- "$vhost_backup" "$vhost_conf"
    if declare -F _runloi >/dev/null 2>&1; then
      _runloi "$task_msg"
    fi
    printf '%b❌ Lỗi: Cấu hình VHost OpenLiteSpeed không hợp lệ! Đã tự động Rollback an toàn.%b\n' "${C_RED:-}" "${C_RESET:-}" >&2
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 2. CẬP NHẬT .HTACCESS NGUYÊN TỬ (CHUẨN HÓA REWRITE CHO OLS, KHÔNG DƯ SLASH //)
# ------------------------------------------------------------------------------
if [[ ! -f "$htaccess_file" ]]; then
  /bin/touch -- "$htaccess_file"
  /bin/chown --reference="$doc_root" -- "$htaccess_file" 2>/dev/null || true
  /bin/chmod 644 -- "$htaccess_file"
fi

htaccess_tmp="${tmp_dir}/htaccess.tmp"
/bin/cp -a -- "$htaccess_file" "$htaccess_tmp"

# Xóa khối #begin-cache-wptangtoc cũ nếu có
/bin/sed -i -e '/^#begin-cache-wptangtoc/,/^#end-cache-wptangtoc$/d' "$htaccess_tmp"

if [[ ! -f "$doc_root/wp-content/plugins/wptangtoc/class/CSSAllLazy.php" && ! -f "$doc_root/wp-content/plugins/wptangtoc/class/CSSAllLazyZ.php" ]]; then
  htaccess_new="${tmp_dir}/htaccess.new"
  cat <<EOF >"$htaccess_new"
#begin-cache-wptangtoc
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Phục vụ trực tiếp bản nén tĩnh .html.gz (0% CPU) khi trình duyệt hỗ trợ Gzip
RewriteCond %{HTTPS} on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} https
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_USER_AGENT} !WPTangToc-Preload [NC]
RewriteCond %{QUERY_STRING} ^(|(utm_[a-z0-9_]+|fbclid|gclid|gad_[a-z0-9_]+|gbraid|wbraid|ttclid|twclid|msclkid|mc_[a-z]+|zarsrc|srsltid|ref|_ga|_gid|_gl)=[^&]*(&|$))*$ [NC]
RewriteCond %{HTTP:Cookie} !(wordpress_logged_in_|wp-postpass_|comment_author_|wordpress_no_cache|woocommerce_items_in_cart|edd_items_in_cart|fp_logged_in_roles|wptt_logged_in_roles|aelia_cs_selected_currency|wmc_current_currency) [NC]
RewriteCond %{HTTP:Accept-Encoding} gzip [NC]
RewriteCond %{REQUEST_URI} !^/(wp-(?:admin|login|register|comments-post|cron|json)|wc-api|cart|gio-hang|checkout|thanh-toan|my-account|tai-khoan|feed)(/|$) [NC]
RewriteCond $doc_root/wp-content/cache/wptangtoc/%{HTTP_HOST}%{REQUEST_URI}/index.html.gz -f
RewriteRule ^ /wp-content/cache/wptangtoc/%{HTTP_HOST}%{REQUEST_URI}/index.html.gz [L]

# 2. Fallback phục vụ bản .html tiêu chuẩn (khi trình duyệt không gửi Accept-Encoding: gzip)
RewriteCond %{HTTPS} on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} https
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_USER_AGENT} !WPTangToc-Preload [NC]
RewriteCond %{QUERY_STRING} ^(|(utm_[a-z0-9_]+|fbclid|gclid|gad_[a-z0-9_]+|gbraid|wbraid|ttclid|twclid|msclkid|mc_[a-z]+|zarsrc|srsltid|ref|_ga|_gid|_gl)=[^&]*(&|$))*$ [NC]
RewriteCond %{HTTP:Cookie} !(wordpress_logged_in_|wp-postpass_|comment_author_|wordpress_no_cache|woocommerce_items_in_cart|edd_items_in_cart|fp_logged_in_roles|wptt_logged_in_roles|aelia_cs_selected_currency|wmc_current_currency) [NC]
RewriteCond %{REQUEST_URI} !^/(wp-(?:admin|login|register|comments-post|cron|json)|wc-api|cart|gio-hang|checkout|thanh-toan|my-account|tai-khoan|feed)(/|$) [NC]
RewriteCond $doc_root/wp-content/cache/wptangtoc/%{HTTP_HOST}%{REQUEST_URI}/index.html -f
RewriteRule ^ /wp-content/cache/wptangtoc/%{HTTP_HOST}%{REQUEST_URI}/index.html [L]
</IfModule>
#end-cache-wptangtoc
EOF
  /bin/cat -- "$htaccess_tmp" >>"$htaccess_new"
  /bin/chown --reference="$htaccess_file" -- "$htaccess_new" 2>/dev/null || true
  /bin/chmod --reference="$htaccess_file" -- "$htaccess_new" 2>/dev/null || true
  /bin/mv -T -- "$htaccess_new" "$htaccess_file"
else
  /bin/mv -T -- "$htaccess_tmp" "$htaccess_file"
fi

# ------------------------------------------------------------------------------
# 3. ĐỒNG BỘ CHUYỂN HƯỚNG SSL, VHOST-SYNC & RELOAD OPENLITESPEED AN TOÀN
# ------------------------------------------------------------------------------
if [[ -f /etc/wptt/ssl/wptt-renew-chuyen-huong ]]; then
  /bin/bash /etc/wptt/ssl/wptt-renew-chuyen-huong "$NAME" >/dev/null 2>&1 || true
fi

if declare -F wptt_load_vhost_conf >/dev/null 2>&1; then
  wptt_load_vhost_conf "$NAME"
  if [[ -n "${vhost_chuyen_htaccess:-}" && -f /etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost ]]; then
    /bin/bash /etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost "$NAME" --no-reload >/dev/null 2>&1 || true
  fi
fi

if [[ -x /etc/wptt/wptt-htaccess-sync ]]; then
  /bin/bash /etc/wptt/wptt-htaccess-sync "$NAME" --no-reload >/dev/null 2>&1 || true
fi

if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
  wptt_smart_reload_lsws >/dev/null 2>&1 || true
else
  /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1 || true
fi

if declare -F _rundone >/dev/null 2>&1; then
  _rundone "$task_msg"
else
  printf 'Kích hoạt hoàn tất page cache html cho %s\n' "$NAME"
fi
