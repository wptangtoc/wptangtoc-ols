#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Thiết lập khiên bảo vệ OOM phân cấp (Hỗ trợ cả KVM/Bare-metal & Container LXD)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null || true

# Kiểm tra trong subshell: thử hạ xuống -1000 mà không ảnh hưởng tiến trình hiện tại
wptt_can_set_negative_oom() {
  (printf -- '-1000' >/proc/self/oom_score_adj) 2>/dev/null
}

wptt_optimize_oom_score() {
  local can_negative=1
  if ! wptt_can_set_negative_oom; then
    can_negative=0
  fi

  # Bảng phân cấp dịch vụ lõi (tên-dịch-vụ:điểm-KVM:điểm-Container)
  local -a SERVICE_RULES=(
    "sshd:-1000:0"
    "ssh:-1000:0"
    "monit:-900:0"
    "mariadb:-600:0"
    "mysql:-600:0"
    "lshttpd:-300:50"
    "lsws:-300:50"
    "valkey:-200:150"
    "keydb:-200:150"
    "redis:-200:150"
    "redis-server:-200:150"
    "memcached:-200:150"
  )

  declare -A PROCESSED_UNITS=()
  local need_reload=0

  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
  /bin/chmod 700 /etc/wptt/tmp 2>/dev/null || true

  if ((can_negative == 1)); then
    echo -e "\033[1;36mĐang thiết lập lớp giáp bảo vệ OOM (Chế độ Kernel Full-Privilege: -1000 ➜ +300)...\033[0m"
  else
    echo -e "\033[1;33m[!] Phát hiện môi trường Container giới hạn CAP_SYS_RESOURCE (Không cho phép oom_score_adj < 0).\033[0m"
    echo -e "\033[1;36mĐang chuyển sang Chế độ Phân cấp Dương (Core=0, OLS=+50, Cache=+150, Worker PHP=+800)...\033[0m"
  fi

  local entry="" svc="" rest="" neg_score="" pos_score="" score=""
  local real_unit="" load_state="" main_pid="" cgroup_path=""

  for entry in "${SERVICE_RULES[@]}"; do
    svc="${entry%%:*}"
    rest="${entry#*:}"
    neg_score="${rest%%:*}"
    pos_score="${rest##*:}"

    if ((can_negative == 1)); then
      score="$neg_score"
    else
      score="$pos_score"
    fi

    # Lấy toàn bộ thông tin unit trong 1 lần gọi systemctl show duy nhất
    real_unit="" load_state="" main_pid="0" cgroup_path=""
    while IFS='=' read -r k v; do
      case "$k" in
        Id) real_unit="$v" ;;
        LoadState) load_state="$v" ;;
        MainPID) main_pid="$v" ;;
        ControlGroup) cgroup_path="$v" ;;
      esac
    done < <(systemctl show -p Id -p LoadState -p MainPID -p ControlGroup "${svc}.service" 2>/dev/null || true)

    [[ "$load_state" == "loaded" && -n "$real_unit" ]] || continue
    [[ -n "${PROCESSED_UNITS[$real_unit]:-}" ]] && continue
    PROCESSED_UNITS["$real_unit"]=1

    local dropin_dir="/etc/systemd/system/${real_unit}.d"
    local conf_file="${dropin_dir}/oom-protect.conf"
    local expected_content=""

    # Đặc trị riêng cho SSHD: chỉ khóa MainPID lắng nghe, không áp OOMScoreAdjust toàn cục
    # để tránh các phiên bash con của người dùng thừa kế điểm -1000 (bất tử)
    if [[ "$svc" == "sshd" || "$svc" == "ssh" ]]; then
      expected_content="# Cấu hình được tạo bởi WPTangToc OLS
# Chỉ bảo vệ MainPID của SSHD sau mỗi lần khởi động/reboot, không lây sang session con
[Service]
ExecStartPost=-/bin/sh -c 'if [ -n \"\$MAINPID\" ] && [ -w \"/proc/\$MAINPID/oom_score_adj\" ]; then printf \"%s\" \"${score}\" > \"/proc/\$MAINPID/oom_score_adj\" 2>/dev/null || true; fi'"
    else
      expected_content="# Cấu hình được tạo bởi WPTangToc OLS
# Bảo vệ tiến trình khỏi OOM Killer khi cạn kiệt RAM
[Service]
OOMScoreAdjust=${score}"
    fi

    /bin/mkdir -p "$dropin_dir"
    /bin/chmod 755 "$dropin_dir"

    # Tính lũy đẳng (Idempotent): chỉ ghi file và reload khi nội dung thực sự thay đổi
    if [[ ! -f "$conf_file" ]] || [[ "$(<"$conf_file")" != "$expected_content" ]]; then
      local tmp_conf=""
      tmp_conf="$(mktemp -p /etc/wptt/tmp wptt_oom_XXXXXX.conf)"
      printf '%s\n' "$expected_content" >"$tmp_conf"
      /bin/chmod 644 "$tmp_conf"
      /bin/mv -fT -- "$tmp_conf" "$conf_file"

      if command -v restorecon >/dev/null 2>&1; then
        restorecon -F "$dropin_dir" "$conf_file" >/dev/null 2>&1 || true
      fi
      need_reload=1
    fi

    # Áp dụng NÓNG trực tiếp vào tiến trình đang chạy (Zero-Downtime)
    if [[ "$svc" == "sshd" || "$svc" == "ssh" ]]; then
      if [[ "$main_pid" =~ ^[0-9]+$ ]] && ((main_pid > 1)) && [[ -w "/proc/${main_pid}/oom_score_adj" ]]; then
        printf -- '%s' "$score" >"/proc/${main_pid}/oom_score_adj" 2>/dev/null || true
      fi
    else
      local cg_file="" cg_pid="" applied_cg=0
      if [[ -n "$cgroup_path" ]]; then
        for cg_file in "/sys/fs/cgroup${cgroup_path}/cgroup.procs" "/sys/fs/cgroup/systemd${cgroup_path}/cgroup.procs"; do
          if [[ -r "$cg_file" ]]; then
            while IFS= read -r cg_pid; do
              if [[ "$cg_pid" =~ ^[0-9]+$ && -w "/proc/${cg_pid}/oom_score_adj" ]]; then
                printf -- '%s' "$score" >"/proc/${cg_pid}/oom_score_adj" 2>/dev/null || true
              fi
            done <"$cg_file" 2>/dev/null
            applied_cg=1
            break
          fi
        done
      fi
      if ((applied_cg == 0)) && [[ "$main_pid" =~ ^[0-9]+$ ]] && ((main_pid > 1)) && [[ -w "/proc/${main_pid}/oom_score_adj" ]]; then
        printf -- '%s' "$score" >"/proc/${main_pid}/oom_score_adj" 2>/dev/null || true
      fi
    fi

    echo -e "- Đã kích hoạt khiên bảo vệ cho \033[1;33m[${real_unit%.service}]\033[0m với điểm số: \033[1;32m${score}\033[0m"
  done

  # Quét trực tiếp /proc/[0-9]*/comm bằng Pure Bash (không dùng pgrep -f tránh bắn nhầm)
  local ols_target_score="-300"
  local php_target_score="300"
  if ((can_negative == 0)); then
    ols_target_score="50"
    php_target_score="800"
  fi

  local proc_dir="" comm_name=""
  for proc_dir in /proc/[0-9]*; do
    [[ -r "${proc_dir}/comm" && -w "${proc_dir}/oom_score_adj" ]] || continue
    comm_name=""
    read -r comm_name <"${proc_dir}/comm" 2>/dev/null || continue
    case "$comm_name" in
      lshttpd | openlitespeed)
        printf -- '%s' "$ols_target_score" >"${proc_dir}/oom_score_adj" 2>/dev/null || true
        ;;
      lsphp*)
        printf -- '%s' "$php_target_score" >"${proc_dir}/oom_score_adj" 2>/dev/null || true
        ;;
    esac
  done

  if ((need_reload == 1)); then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi

  echo -e "\n\033[1;32m✔ Hoàn tất! Đã đồng bộ điểm OOM trực tiếp vào Kernel cho toàn bộ tiến trình đang chạy.\033[0m"
}

wptt_optimize_oom_score
