function huong_dan() {
  tính năng cập nhật WP-CLI thì đây là một chức năng tiện ích giúp bạn dễ dàng nâng cấp WP-CLI [WordPress Command-Line Interface] lên phiên bản mới nhất ngay trên máy chủ của mình.

  [NÂNG CẤP BẢO MẬT ZERO TRUST]
  Tính năng này đã được nâng cấp cơ chế bảo mật GPG. Thay vì tải và cài đặt thông thường, hệ thống sẽ tự động xác thực chữ ký điện tử trực tiếp từ đội ngũ lõi của WP-CLI. Đảm bảo file thực thi an toàn tuyệt đối 100%, không bị giả mạo hay cài cắm mã độc [Man-in-the-Middle].

  🎯 Mục đích của tính năng cập nhật WP-CLI:
  * Sử dụng Tính năng Mới: WP-CLI liên tục được phát triển.
  * Vá lỗi & Tăng Ổn định: Các phiên bản mới sửa các lỗi được phát hiện trong các phiên bản cũ.
  * Bảo mật: Đảm bảo tương thích tốt nhất với các phiên bản WordPress mới nhất và PHP.
}

if [[ $1 = '98' ]]; then
  echo ""
  echo ""
  echo ""
  echo "========================================================================="
  echo "| Quản lý cập nhật Update => Cập nhật WP-CLI (Bảo mật GPG)              |"
  echo "========================================================================="
  echo ""
  echo ""
fi

. /etc/wptt/echo-color 2>/dev/null

# =========================================================
# HÀM LÕI: TẢI & XÁC THỰC WP-CLI BẰNG GPG (ZERO TRUST)
# =========================================================
function wptt_secure_install_wpcli() {
    local tmp_dir
	tmp_dir=$(mktemp -d /etc/wptt/tmp/XXXXXX)
    
    # 1. Tải file thực thi và chữ ký GPG vào thư mục tạm (cách ly hoàn toàn)
    curl -sL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar -o "$tmp_dir/wp-cli.phar"
    curl -sL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar.asc -o "$tmp_dir/wp-cli.phar.asc"

    # 2. Nhập Public Key của đội ngũ WP-CLI
    curl -sL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/wp-cli.pgp | gpg --import --quiet >/dev/null 2>&1

    # 3. Kích hoạt bộ xác thực
    if gpg --verify "$tmp_dir/wp-cli.phar.asc" "$tmp_dir/wp-cli.phar" >/dev/null 2>&1; then
        chmod +x "$tmp_dir/wp-cli.phar"
        mv -f "$tmp_dir/wp-cli.phar" /usr/local/bin/wp
        
        # Cưỡng chế ánh xạ Symlink cho Cronjob & AWS
        ln -sf /usr/local/bin/wp /usr/bin/wp
        
        rm -rf "${tmp_dir:?}"
        return 0
    else
        rm -rf "${tmp_dir:?}"
        return 1
    fi
}

if ! command -v wp >/dev/null 2>&1; then
  echo -e "\e[33m[*] Hệ thống chưa có WP-CLI. Đang tiến hành cài đặt mới (Xác thực GPG)...\e[0m"

  if wptt_secure_install_wpcli; then
    echo -e "\e[32m[OK] Xác thực GPG thành công! Đã cài đặt WP-CLI an toàn tuyệt đối.\e[0m"
  else
    echo -e "\e[31m[LỖI] Chữ ký GPG không hợp lệ hoặc lỗi mạng! Từ chối cài đặt để bảo vệ hệ thống.\e[0m"
  fi

  check_menu_wptangtoc_active=${1:-}
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-update-main 1
  fi
  return 2>/dev/null || exit 0
fi

# =========================================================
# QUY TRÌNH NÂNG CẤP WP-CLI (Dành cho máy đã cài)
# =========================================================

CURRENT_VER=$(wp cli version --allow-root 2>/dev/null | awk '{print $2}')
echo -e "Phiên bản WP-CLI hiện tại của bạn là: \e[36m$CURRENT_VER\e[0m"
echo -e "\e[33mĐang tiến hành kiểm tra chữ ký GPG và cập nhật WP-CLI, vui lòng đợi...\e[0m"

if wptt_secure_install_wpcli; then
  # Kiểm tra lại phiên bản sau khi ghi đè thành công
  NEW_VER=$(wp cli version --allow-root 2>/dev/null | awk '{print $2}')

  if [[ "$CURRENT_VER" == "$NEW_VER" ]]; then
    echo -e "\e[32m[✓] GPG Hợp lệ: Hiện tại bạn đã sử dụng phiên bản WP-CLI mới nhất rồi ($NEW_VER).\e[0m"
  else
    if command -v echoDone >/dev/null 2>&1; then
      echoDone "Xác thực GPG thành công! Đã nâng cấp WP-CLI từ phiên bản $CURRENT_VER lên $NEW_VER"
    else
      echo -e "\e[32m[✓] Xác thực GPG thành công! Đã nâng cấp WP-CLI từ phiên bản $CURRENT_VER lên $NEW_VER\e[0m"
    fi
  fi
else
  echo -e "\e[31m[LỖI] Chữ ký GPG không khớp! Đã hủy bỏ quá trình cập nhật để bảo vệ hệ thống.\e[0m"
fi

check_menu_wptangtoc_active=${1:-}
if [[ $check_menu_wptangtoc_active = "98" ]]; then
  exec /etc/wptt/wptt-update-main 1
fi
