#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
# @author: Gia Tuấn
# @website: https://wptangtoc.com

umask 077
trap 'cd /root || exit; [[ -n "$TMP_DIR" ]] && rm -rf "${TMP_DIR:?}" 2>/dev/null' EXIT

TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
cd "$TMP_DIR" || exit 1

# ==============================================================================
# GPG FINGERPRINT PINNING & KEY VERIFICATION
# ==============================================================================
if ! gpg --list-keys "giatuan@wptangtoc.com" >/dev/null 2>&1; then
    wptt_logs "INFO" "Importing GPG key for giatuan@wptangtoc.com"
    
    curl --tlsv1.3 -fsSL --connect-timeout 10 \
        "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" \
        -o wptangtoc-gpg-pub.key
    
    if [[ ! -s wptangtoc-gpg-pub.key ]]; then
        wptt_logs "INFO" "Primary server failed, trying GitHub fallback"
        curl --tlsv1.3 -fsSL --connect-timeout 10 \
            "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" \
            -o wptangtoc-gpg-pub.key
    fi
    
    if [[ ! -f wptangtoc-gpg-pub.key ]]; then
        wptt_logs "ERROR" "Failed to download GPG key from all sources"
        exit 1
    fi
    
    real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | \
              awk -F: '$1 == "fpr" {print $10}' | head -n 1)
    
    expected_fp="EE091EEB9A5189BC80837C059AA528D37B902267"
    
    if [[ -z "$real_fp" ]]; then
        wptt_logs "ERROR" "Cannot extract fingerprint from GPG key"
        exit 1
    fi
    
    if [[ "$real_fp" != "$expected_fp" ]]; then
        wptt_logs "CRITICAL" "GPG Key fingerprint mismatch! Expected: $expected_fp, Got: $real_fp"
        exit 1
    fi
    
    gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
fi

# ==============================================================================
# DOWNLOAD VERSION FILES
# ==============================================================================
curl --tlsv1.3 -fsSL --connect-timeout 60 --max-time 60 \
    "https://wptangtoc.com/share/version-wptangtoc-ols.txt?kiem-tra-version-crond" \
    -o version.txt

curl --tlsv1.3 -fsSL --connect-timeout 60 --max-time 60 \
    -A "checksum wptangtoc ols" \
    "https://hub.wptangtoc.com/version-wptangtoc-ols.txt.sig" \
    -o version.sig

if [[ ! -s version.txt || ! -s version.sig ]]; then
    wptt_logs "INFO" "Primary servers unavailable, using GitHub fallback"
    curl --tlsv1.3 -fsSL --connect-timeout 60 --max-time 60 \
        "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt" \
        -o version.txt
    curl --tlsv1.3 -fsSL --connect-timeout 60 --max-time 60 \
        "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt.sig" \
        -o version.sig
fi

# ==============================================================================
# GPG VERIFICATION & VERSION EXTRACTION
# ==============================================================================
if [[ -s version.txt && -s version.sig ]]; then
    if gpg --verify version.sig version.txt 2>/dev/null; then
        wptangtocols_version=$(head -1 version.txt | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# ✅ Chặn 8 và 8.1 (thiếu minor version)
# ✅ Chấp nhận 8.1.1 (chính thức 3 phần)
# ✅ Chấp nhận 8.1.1.4 (hotfix, 4 phần)
					if [[ "$wptangtocols_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
            echo "$wptangtocols_version" > "/etc/wptt/tmp/new-version"
            mv "/etc/wptt/tmp/new-version" /etc/wptt/tmp/wptangtoc-ols-version
            wptt_logs "INFO" "Version check completed: $wptangtocols_version"
        else
            wptt_logs "WARN" "Version format invalid: $wptangtocols_version"
        fi
    else
        wptt_logs "ERROR" "GPG signature verification failed"
    fi
else
    wptt_logs "ERROR" "Version files are empty or missing"
fi

exit 0
