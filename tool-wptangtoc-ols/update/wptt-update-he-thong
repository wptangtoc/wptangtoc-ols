#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng Cập nhật toàn bộ hệ thống Linux là quá trình áp dụng các bản cập nhật phần mềm mới nhất cho toàn bộ hệ điều hành Linux của bạn, bao gồm nhân [kernel], các thư viện hệ thống, các ứng dụng đã cài đặt, và quan trọng nhất là các bản vá bảo mật.

  Nói một cách đơn giản, đây là việc bạn làm mới toàn bộ phần mềm trên máy Linux của mình, đưa nó lên phiên bản mới nhất mà nhà phát triển hoặc cộng đồng Linux cung cấp, giống như việc cập nhật Windows hay macOS.

  Mục Đích Chính
  * Bảo mật [Quan trọng nhất]: Các bản cập nhật thường xuyên vá các lỗ hổng bảo mật mới được phát hiện, giúp bảo vệ hệ thống của bạn khỏi virus, mã độc, và các cuộc tấn công.
  * Sửa lỗi [Bug Fixes]: Khắc phục các lỗi đã biết trong phần mềm, giúp hệ thống hoạt động ổn định và đáng tin cậy hơn.
  * Tính năng mới và cải tiến: Cập nhật có thể mang đến các chức năng mới, cải thiện hiệu suất, và hỗ trợ phần cứng tốt hơn.
  * Đảm bảo tính ổn định: Việc sửa lỗi góp phần vào sự ổn định chung của hệ thống, giảm thiểu nguy cơ treo máy hoặc các hành vi không mong muốn.
  * Duy trì hỗ trợ: Các nhà phát triển phần mềm [bao gồm các bản phân phối Linux] sẽ ngừng hỗ trợ các phiên bản cũ. Cập nhật thường xuyên giúp hệ thống của bạn luôn nằm trong diện được hỗ trợ.

  Cập nhật toàn bộ hệ thống Linux định kỳ là một trong những việc làm thiết yếu để giữ cho máy tính/máy chủ của bạn an toàn, ổn định và hoạt động hiệu quả.
}

. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/.wptt.conf
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

# ==============================================================================
# LỚP KHIÊN 1: KHÓA TIẾN TRÌNH (MUTEX LOCK)
# Ngăn chặn 2 quản trị viên cùng bấm cập nhật hoặc cronjob chạy đè lên nhau
# ==============================================================================
LOCK_FILE="/etc/wptt/tmp/wptt_update_system.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
	echo -e "${C_RED}❌ CẢNH BÁO: Hệ thống đang được cập nhật bởi một tiến trình khác! Vui lòng chờ.${C_RESET}"
	check_menu_wptangtoc_active=${1:-}
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-update-main 1
	fi
	exit 1
fi

echo "$dang_tien_hanh_cap_nhat_vui_long_doi"

# ==============================================================================
# LỚP KHIÊN 2: KIỂM TRA TIỀN TRẠM (PRE-FLIGHT CHECKS)
# ==============================================================================
_runing "Kiểm tra an toàn tài nguyên hệ thống trước khi cập nhật"

# 2.1 Kiểm tra Internet / Phân giải tên miền
if ! ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1; then
	_runloi "Kiểm tra an toàn thất bại: Mất kết nối Internet!"
	flock -u 200
	exec 200>&-
	rm -f "$LOCK_FILE"
	check_menu_wptangtoc_active=${1:-}
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-update-main 1
	fi
	exit 1
fi

# 2.2 Kiểm tra Ổ cứng (Disk Space) - Yêu cầu trống tối thiểu 2GB (2048 MB) ở phân vùng gốc
FREE_SPACE_MB=$(df -m / | awk 'NR==2 {print $4}')
if [[ "$FREE_SPACE_MB" -lt 2048 ]]; then
	_runloi "Kiểm tra an toàn thất bại: Ổ cứng / sắp đầy!"
	echo -e "${C_YELLOW}Hệ thống cần tối thiểu 2GB trống để tải và bung file cập nhật. Hiện tại chỉ còn: ${FREE_SPACE_MB}MB.${C_RESET}"
	flock -u 200
	exec 200>&-
	rm -f "$LOCK_FILE"
	check_menu_wptangtoc_active=${1:-}
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-update-main 1
	fi
	exit 1
fi

# 2.3 Kiểm tra Bộ nhớ (RAM Available) - Yêu cầu trống tối thiểu 300MB
FREE_RAM_MB=$(free -m | awk '/^Mem:/{print $7}')
if [[ "$FREE_RAM_MB" -lt 300 ]]; then
	_runloi "Kiểm tra an toàn thất bại: RAM khả dụng quá thấp!"
	echo -e "${C_YELLOW}Nguy cơ sập hệ thống (OOM Killer). Hiện tại chỉ còn: ${FREE_RAM_MB}MB RAM khả dụng.${C_RESET}"
	flock -u 200
	exec 200>&-
	rm -f "$LOCK_FILE"
	check_menu_wptangtoc_active=${1:-}
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-update-main 1
	fi
	exit 1
fi


# 2.4 Kiểm tra Inodes (Số lượng tệp tin khả dụng) - Yêu cầu tối thiểu 15.000 Inodes
FREE_INODES=$(df -i / | awk 'NR==2 {print $4}')
if [[ "$FREE_INODES" =~ ^[0-9]+$ ]] && [[ "$FREE_INODES" -lt 15000 ]]; then
	_runloi "Kiểm tra an toàn thất bại: Cạn kiệt Inodes!"
	echo -e "${C_YELLOW}Hệ thống cần ít nhất 15.000 Inodes trống để bung các gói cập nhật. Hiện tại chỉ còn: ${FREE_INODES} Inodes.${C_RESET}"
	echo -e "Gợi ý: Hãy xóa bớt các file rác nhỏ (Session PHP, cache, thư mục log cũ) trước khi cập nhật."
	# Giải phóng khóa trước khi thoát
	flock -u 200
	exec 200>&-
	rm -f "$LOCK_FILE"
	check_menu_wptangtoc_active=${1:-}
	if [[ $check_menu_wptangtoc_active = "98" ]]; then
		exec /etc/wptt/wptt-update-main 1
	fi
	exit 1
fi

_rundone "Kiểm tra an toàn hệ thống: OK (Disk: ${FREE_SPACE_MB}MB, RAM: ${FREE_RAM_MB}MB)"

# ==============================================================================
# XỬ LÝ GPG KEYS VÀ REPO (TƯƠNG THÍCH NGƯỢC)
# ==============================================================================
# Update GPG AlmaLinux
if grep -q "AlmaLinux 8" /etc/*release 2>/dev/null; then
  if rpm -q gpg-pubkey-ced7258b-6525146f | grep -q 'not installed'; then
    dnf -y clean packages >/dev/null 2>&1
    rpm --import https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux
  fi
fi

# Update GPG LiteSpeed
if [[ -f /etc/yum.repos.d/litespeed.repo ]]; then
    os_major_version=$(grep '^VERSION_ID=' /etc/os-release | cut -d '"' -f 2 | cut -d '.' -f 1)
    if [[ "$os_major_version" == "10" ]]; then
        sed -i 's|gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-litespeed|gpgkey=https://rpms.litespeedtech.com/centos/RPM-GPG-KEY-litespeed2025|g' /etc/yum.repos.d/litespeed.repo
    else
        sed -i 's|gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-litespeed|gpgkey=https://rpms.litespeedtech.com/centos/RPM-GPG-KEY-litespeed|g' /etc/yum.repos.d/litespeed.repo
    fi
fi

# Fix MariaDB Repo Archive
if [[ -f /etc/yum.repos.d/MariaDB.repo ]] && ! grep -q "archive.mariadb.org" /etc/yum.repos.d/MariaDB.repo; then
  if grep -qE "10\.[0-5]/" /etc/yum.repos.d/MariaDB.repo; then
    echo -e "\033[1;33mĐang tối ưu hóa Repository MariaDB trước khi cập nhật...\033[0m"
    bash /etc/wptt/db/repo-mariadb-fix-eol >/dev/null 2>&1
  fi
fi

# ==============================================================================
# CẬP NHẬT WPTANGTOC CORE (KIỂM TRA ĐIỀU KIỆN CHẶT CHẼ)
# ==============================================================================
wptangtocols_version=$(curl --tlsv1.3 -sL --connect-timeout 10 --max-time 15 "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update=$Website_chinh" 2>/dev/null)

# Bắt buộc định dạng phải là số (VD: 8.1.4.4) để tránh tải nhầm trang HTML báo lỗi của Cloudflare
if [[ -n "$wptangtocols_version" && "$wptangtocols_version" =~ ^[0-9]+\.[0-9]+ && "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then
	if [[ "$wptangtocols_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
		/etc/wptt/wptt-update2
	fi
fi

# ==============================================================================
# LỚP KHIÊN 3: CẬP NHẬT HỆ ĐIỀU HÀNH BẮT MÃ LỖI (DNF/YUM)
# ==============================================================================
_runing "Đang nạp và làm mới thư viện Repository..."
dnf clean all >/dev/null 2>&1
dnf install epel-release -y >/dev/null 2>&1
_rundone "Làm mới thư viện Repository"

_runing "Đang nâng cấp toàn bộ gói phần mềm hệ thống (OS Update)..."

ROOT_DEV=$(df -P / | tail -1 | awk '{print $1}')
BOOT_DEV=$(df -P /boot | awk 'NR==2 {print $1}') # Tối ưu bằng awk NR==2 thay vì tail

# Ghi log quá trình DNF ra file tạm để kiểm tra thay vì tắt ngấm bằng /dev/null
DNF_LOG="/tmp/wptt_dnf_update.log"

if [[ "$ROOT_DEV" != "$BOOT_DEV" ]]; then
  dnf update -y --exclude=kernel* --exclude=grub2* --exclude=shim* --exclude=centos-release* --exclude=redhat-release* --exclude=almalinux-release* --exclude=rocky-release* --exclude=microcode_ctl > "$DNF_LOG" 2>&1
  DNF_EXIT=$?
else
  dnf update -y > "$DNF_LOG" 2>&1
  DNF_EXIT=$?
fi

if [[ $DNF_EXIT -ne 0 ]]; then
    _runloi "Nâng cấp hệ thống thất bại (Exit Code: $DNF_EXIT)!"
    echo -e "${C_RED}Vui lòng kiểm tra log tại $DNF_LOG để xem chi tiết lỗi Repository.${C_RESET}"
    # Giải phóng khóa trước khi thoát
    flock -u 200
    exec 200>&-
    exit 1
fi
_rundone "Nâng cấp gói phần mềm OS thành công"

# ==============================================================================
# BẢO TRÌ & KHỞI ĐỘNG LẠI DỊCH VỤ
# ==============================================================================
rm -rf -- /var/lib/sss/db/* || true
systemctl restart sssd >/dev/null 2>&1

/etc/wptt/update/wptt-wp-cli
/etc/wptt/update/update-mariadb
/usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1

echoDone "$cap_nhat_thanh_cong $he_thong"
wptt_logs "INFO" "Cập nhật toàn bộ hệ thống"

# Mở khóa
flock -u 200
exec 200>&-
rm -f "$LOCK_FILE"

# Hỏi ý kiến Reboot thay vì tự động khởi động lại sập web khách (Tùy chọn UX)
echo -e "\n${C_YELLOW}Hệ thống khởi động lại máy chủ để nạp Kernel/Thư viện mới.${C_RESET}"
/etc/wptt/service/reboot-server
