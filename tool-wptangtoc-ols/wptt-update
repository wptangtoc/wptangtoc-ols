  [[ -n "$wptangtocols_version" ]] && echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version

  echo -e "\n${C_RED:-}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET:-}"
  echo -e "${C_RED:-}│${C_RESET:-} ${C_YELLOW:-}CẢNH BÁO BẢO MẬT NGHIÊM TRỌNG (GPG AUTHENTICATION FAILED)${C_RESET:-}                    ${C_RED:-}│${C_RESET:-}"
  echo -e "${C_RED:-}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET:-}"
  echo -e "${C_RED:-}│${C_RESET:-} Hệ thống phát hiện mã nguồn tải về bị hỏng hoặc chữ ký không hợp lệ!       ${C_RED:-}│${C_RESET:-}"
  echo -e "${C_RED:-}│${C_RESET:-} Quá trình cập nhật đã bị HỦY BỎ để bảo vệ an toàn cho máy chủ của bạn.       ${C_RED:-}│${C_RESET:-}"
