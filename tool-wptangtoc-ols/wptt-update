else
  # ============================================================================
  # DÙNG THƯ VIỆN GIAO DIỆN ĐỂ HỎI NGƯỜI DÙNG CÓ MUỐN CẬP NHẬT HAY KHÔNG
  # ============================================================================
  if wptt_xac_nhan "Đã có bản cập nhật mới! Bạn có muốn nâng cấp ngay không?" "${C_BOLD_WHITE}Bản hiện tại:${C_RESET} ${C_YELLOW}$version_wptangtoc_ols${C_RESET}" "${C_BOLD_WHITE}Bản mới nhất:${C_RESET} ${C_GREEN}$wptangtocols_version${C_RESET}" "Tiến hành nâng cấp" "Để sau"; then
    echo ""

    OLD_PWD=$(pwd)

    if [[ ! -d /etc/wptt/tmp ]]; then
      mkdir -p /etc/wptt/tmp
      chmod 700 /etc/wptt/tmp
    fi

    TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
    cd "$TMP_DIR" || exit

    # ==========================================================================
    # BỘ MÁY XÁC THỰC BẢO MẬT GPG & FINGERPRINT PINNING (CHỐNG TRÁO HÀNG)
    # ==========================================================================
    # 1. Tải Public Key (Nếu chưa có, chỉ cần tải 1 lần lưu vào hệ thống)
    EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
    KEY_EMAIL="giatuan@wptangtoc.com"
    if ! gpg --list-keys "$EXPECTED_FP" 2>/dev/null | grep -qi "$KEY_EMAIL"; then
      _runing "Đang nạp Khóa bảo mật GPG..."

      # Tải file key về thư mục tạm (Có Retry)
      if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"; then
        secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"
      fi

      # Đọc Fingerprint thực tế (Chỉ lấy dòng đầu của Master Key)
      real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

      # Fingerprint chuẩn
      expected_fp="EE091EEB9A5189BC80837C059AA528D37B902267"

      # Kiểm định khắt khe
      if [[ -n "$real_fp" && "$real_fp" == "$expected_fp" ]]; then
        gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
        _rundone "Nạp Khóa bảo mật GPG thành công"
      else
        _runloi "CẢNH BÁO: Public Key giả mạo hoặc sai lệch Fingerprint!"
        rm -f wptangtoc-gpg-pub.key
        cd "$OLD_PWD" || cd /root || exit
        rm -rf "${TMP_DIR:?}"
        sleep 4
        [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-update-main 1
        [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
        exec /etc/wptt/wptt-status2
        exit 1
      fi
      rm -f wptangtoc-gpg-pub.key
    fi

    # 2. Tải File Core (.zip) và File Chữ Ký (.sig) Bằng Hàm secure_download (Có Retry)
    _runing "Đang tải mã nguồn Core WPTangToc OLS"
    if ! secure_download "https://wptangtoc.com/share/wptangtoc-ols.zip" "wptangtoc-ols.zip"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" "wptangtoc-ols.zip"
    fi
    if ! secure_download "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig" "checksum wptangtoc ols"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig"
    fi
    _rundone "Tải mã nguồn Core WPTangToc OLS"

    # 3. Tải File User (.zip) và File Chữ Ký (.sig) Bằng Hàm secure_download
    _runing "Đang tải mã nguồn User WPTangToc OLS"
    if ! secure_download "https://wptangtoc.com/share/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip"
    fi
    if ! secure_download "https://hub.wptangtoc.com/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig" "checksum wptangtoc ols"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig"
    fi
    _rundone "Tải mã nguồn User WPTangToc OLS"

    # ==========================================================================
    # QUY TRÌNH QUÉT CHỮ KÝ VÀ KIỂM ĐỊNH TOÀN VẸN (ENTERPRISE STANDARD)
    # ==========================================================================
    _runing "Đang xác thực Chữ ký điện tử (GPG Signature)..."

    auth_core=0
    auth_user=0

    # [FIX GPG Spoofing] Bắt buộc tìm thấy '[GNUPG:] GOODSIG' qua status-fd 1
    # Kiểm tra File Core
    if [[ -f wptangtoc-ols.zip && -f wptangtoc-ols.zip.sig ]]; then
      if gpg --status-fd 1 --verify wptangtoc-ols.zip.sig wptangtoc-ols.zip 2>/dev/null | grep -q '\[GNUPG:\] GOODSIG'; then
        auth_core=1
      fi
    fi

    # Kiểm tra File User
    if [[ -f wptangtoc-ols-user.zip && -f wptangtoc-ols-user.zip.sig ]]; then
      if gpg --status-fd 1 --verify wptangtoc-ols-user.zip.sig wptangtoc-ols-user.zip 2>/dev/null | grep -q '\[GNUPG:\] GOODSIG'; then
        auth_user=1
      fi
    fi

    # Báo lỗi khẩn cấp nếu GPG phát hiện giả mạo
    if [[ $auth_core -eq 0 || $auth_user -eq 0 ]]; then
      _runloi "Xác thực GPG Không Thành Công"
      [[ -n "$wptangtocols_version" ]] && echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version

      echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      echo -e "${C_RED}│${C_RESET} ${C_YELLOW}CẢNH BÁO BẢO MẬT NGHIÊM TRỌNG (GPG AUTHENTICATION FAILED)${C_RESET}                    ${C_RED}│${C_RESET}"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      echo -e "${C_RED}│${C_RESET} Hệ thống phát hiện mã nguồn tải về bị hỏng hoặc chữ ký không hợp lệ!       ${C_RED}│${C_RESET}"
      echo -e "${C_RED}│${C_RESET} Quá trình cập nhật đã bị HỦY BỎ để bảo vệ an toàn cho máy chủ của bạn.       ${C_RED}│${C_RESET}"
      echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

      rm -rf "${TMP_DIR:?}"
      sleep 4

      if [[ "${CI:-}" == "true" ]]; then
        exit 1
      fi

      [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-update-main 1
      [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
      exec /etc/wptt/wptt-status2
      exit 1
    fi

    _rundone "Xác thực GPG Thành Công. Đang tiến hành cài đặt..."

    # ==========================================================================
    # BACKUP ĐỂ ROLLBACK (PHÒNG HỜ)
    # ==========================================================================
    kiem_tra_ton_tai_nhom=$(cat /etc/group | grep '^wptangtoc-ols:')

    # 1. Lưu lại umask mặc định của hệ điều hành
    OLD_UMASK=$(umask)
    # 2. Bật khiên bảo vệ 077 (chỉ owner có quyền)
    umask 077
    mkdir -p /etc/wptt/wptt-backup-system
    timedate=$(date +%Hgio_%d_%m_%Y)
    BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:$version_wptangtoc_ols.zip"

    (cd /etc/wptt && zip -r -q "$BACKUP_FILE" . -x "wptt-backup-system/*" -x ".wptt.conf" -x ".ram_hien_tai" -x "vhost/*" -x "tmp/*")
    [[ -f "$BACKUP_FILE" ]] && zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop
    ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r rm -f

    unzip -oq wptangtoc-ols.zip
    if ! \cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then
      umask "$OLD_UMASK"
      echo -e "\n${C_RED}❌ Lỗi chép file! Đang tự động khôi phục lại phiên bản cũ...${C_RESET}"
      unzip -oq "$BACKUP_FILE" -d /etc/wptt/
      \cp -f /etc/wptt/wptangtoc /usr/bin
      rm -f /etc/wptt/wptangtoc
      \cp -f /etc/wptt/wptt /usr/bin
      rm -f /etc/wptt/wptt

      \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin

      cd "$OLD_PWD" || cd /root || exit
      rm -rf "${TMP_DIR:?}"
      sleep 3
      [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-update-main 1
      [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
      exec /etc/wptt/wptt-status2
      exit
    fi
    # 3. Tắt khiên, trả lại umask mặc định cho các tiến trình bên dưới
    umask "$OLD_UMASK"

    rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
    rm -rf tool-wptangtoc-ols

    [[ -d /etc/wptt/wptt-child ]] && \cp -rf /etc/wptt/wptt-child/* /etc/wptt

    chmod -R 700 /etc/wptt
    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      chown root:wptangtoc-ols /etc/wptt /etc/wptt/vhost
      chmod 750 /etc/wptt /etc/wptt/vhost
    else
      chown root:root /etc/wptt /etc/wptt/vhost
    fi

    \cp -f /etc/wptt/wptangtoc /usr/bin
    rm -f /etc/wptt/wptangtoc
    \cp -f /etc/wptt/wptt /usr/bin
    rm -f /etc/wptt/wptt

    \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin

    # ==========================================================================
    # CẬP NHẬT PHÂN QUYỀN VHOST THEO CƠ CHẾ BẢO MẬT (ZERO TRUST)
    # ==========================================================================
    chown root:root /etc/wptt/.wptt.conf
    chmod 600 /etc/wptt/.wptt.conf

    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      # 1. Trạng thái mặc định: Đóng băng tuyệt đối (Auto-Healing)
      chown root:root "$filepath"
      chmod 600 "$filepath"

      # 2. Kiểm tra nới lỏng quyền nếu hệ thống có sử dụng Jail
      if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
        domain="${filepath##*/}"
        domain="${domain%.conf}"
        domain="${domain#.}"

        path="/usr/local/lsws/$domain"

        # Xác định lồng Jail đang hoạt động (có thư mục /etc của root)
        if [[ -d "$path" && -d "$path/etc" ]]; then
          if [[ $(stat -c '%U' "$path/etc" 2>/dev/null) == "root" ]]; then
            # Dùng grep bóc tách biến an toàn
            check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"' | tr -d "'")

            if [[ -n "$check_user_vhost" ]]; then
              # Kiểm tra user có nằm trong nhóm wptangtoc-ols không
              if grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
                chown root:wptangtoc-ols "$filepath"
                chmod 640 "$filepath"
              fi
            fi
          fi
        fi
      fi
    done

    # ==========================================================================
    # TIẾN HÀNH GIẢI NÉN VÀ CHÉP FILE (USER)
    # ==========================================================================
    OLD_UMASK=$(umask)
    umask 007
    unzip -qo wptangtoc-ols-user.zip
    \cp -rf tool-wptangtoc-ols-user/* /etc/wptt-user
    umask "$OLD_UMASK"

    rm -f wptangtoc-ols-user.zip wptangtoc-ols-user.zip.sig
    rm -rf tool-wptangtoc-ols-user

    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      chown -hR root:wptangtoc-ols /etc/wptt-user
      chmod -R 750 /etc/wptt-user
      \cp -f /etc/wptt-user/wptangtoc-user /usr/bin
      chown root:wptangtoc-ols /usr/bin/wptangtoc-user
      chmod 750 /usr/bin/wptangtoc-user
    else
      chown -hR root:root /etc/wptt-user
      chmod -R 700 /etc/wptt-user
      \cp -f /etc/wptt-user/wptangtoc-user /usr/bin
      chown root:root /usr/bin/wptangtoc-user
      chmod 700 /usr/bin/wptangtoc-user
    fi

    chmod 700 /etc/wptt/tmp

    # Khử dấu ngôn ngữ
    if [[ "$khong_dau_vi_ngon_ngu" == '1' ]]; then
      find /etc/wptt -type f ! -path '/etc/wptt/lang/wptt-set-lang-vi' ! -path '/etc/wptt/wptt-update2' ! -path '/etc/wptt/wptt-update' ! -name '.*' -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
      [[ -n "$kiem_tra_ton_tai_nhom" ]] && sudo find /etc/wptt-user -type f -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
    fi

    # ==========================================================================
    # Cấu hình phụ trợ (Script Update server & Dự phòng Github bọc GPG)
    # ==========================================================================
    # 1. Tải file update và file chữ ký số (Sử dụng hàm secure_download mới)
    if ! secure_download "https://wptangtoc.com/share/update" "update"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update"
    fi
    if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig"
    fi

    # 3. [FIX GPG Spoofing] Quét GPG với status-fd 1 và chỉ thực thi khi 100% chính chủ
    if [[ -s update && -s update.sig ]] && gpg --status-fd 1 --verify update.sig update 2>/dev/null | grep -q '\[GNUPG:\] GOODSIG'; then
      if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
        bash update >/dev/null 2>&1
      fi
    else
      # Ghi log ngầm nếu phát hiện file bị can thiệp hoặc rớt mạng không lấy được chữ ký
      wptt_logs "INFO" "Lỗi: Script 'update' sai chữ ký GPG hoặc rớt mạng - Bỏ qua thực thi $(date '+%d-%m-%Y %H:%M')"
    fi

    # 4. Dọn rác
    rm -f update update.sig

    # Lưu Version
    wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure"

    echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version
    echo "$version_wptangtoc_ols" >/etc/wptt/tmp/wptangtoc-ols-version-main

    # Dọn dẹp
    cd "$OLD_PWD" || cd /root || exit
    rm -rf "${TMP_DIR:?}"

    # Thông báo hoàn tất
    _rundone "WPTangToc OLS đã cập nhật Hệ thống lên bản $wptangtocols_version"

    wptt_logs "INFO" "Cập nhật WPTangToc OLS"
    sleep 3

    if [[ -n "${1:-}" ]]; then
      [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-update-main
      [[ "${1:-}" == "97" ]] && exec /usr/bin/wptangtoc 1
    fi
  else
    # Nếu người dùng bấm "Không đồng ý / Để sau"
    echo -e "${C_YELLOW}Đã hủy thao tác cập nhật.${C_RESET}"
    sleep 1
  fi

  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then #test ci thì không được vào đây trả exit
    exit 0
  fi

  if [[ -n "${1:-}" ]]; then
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-update-main
    [[ "${1:-}" == "97" ]] && exec /usr/bin/wptangtoc 1
  fi
  exec /etc/wptt/wptt-status2
fi
