    /bin/cp -fp /etc/wptt/tai-nguyen-server/wtop /usr/bin/ 2>/dev/null || true
  fi
  _runloi "Hệ thống đã phục hồi về trạng thái ban đầu an toàn."
  sleep 3
  exit 1
}

