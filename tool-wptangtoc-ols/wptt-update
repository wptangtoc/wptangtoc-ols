cleanup_on_exit() {
  local exit_code=$?
  cd "$OLD_PWD" || cd /root || true
  if [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]]; then
    rm -rf "${TMP_DIR:?}"
  fi
  # Mở khóa và đóng FD 200
  flock -u 200 2>/dev/null || true
  exec 200>&- 2>/dev/null || true
  exit "$exit_code"
}
