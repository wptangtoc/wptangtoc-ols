  [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
  exec /etc/wptt/wptt-status2
  exit 1
fi

_rundone "Xác thực GPG Hoàn Tất. Bắt đầu tiến trình cài đặt..."

# ==============================================================================
# 5. BACKUP NGUYÊN TỬ (TRANSACTIONAL SAFETY & ROLLBACK)
# ==============================================================================
