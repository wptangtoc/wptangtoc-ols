# ==============================================================================
# HÀM TIỆN ÍCH BẢO MẬT & RETRY LOGIC (FAIL-SAFE & ZERO-HANG)
# ==============================================================================
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while ((attempt <= max_attempts)); do
    if curl --tlsv1.2 --proto "=https" -sfL --connect-timeout 8 --max-time 45 -A "$user_agent" "$url" -o "$dest"; then
      if [[ -s "$dest" ]]; then
        return 0
      fi
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1
  local result=""

  while ((attempt <= max_attempts)); do
    result=$(curl --tlsv1.2 --proto "=https" -sfL --connect-timeout 5 --max-time 10 "$url" 2>/dev/null || true)
    result="${result//$'\r'/}"
    result="${result//[[:space:]]/}"
    if [[ -n "$result" ]]; then
      printf '%s\n' "$result"
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

