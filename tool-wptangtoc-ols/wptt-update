# ==============================================================================
# Hàm tải file với cơ chế Retry 3 lần
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    if curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 45 -A "$user_agent" "$url" -o "$dest"; then
      return 0
    fi
    sleep 3
    ((attempt++))
  done
  return 1
}

# Hàm lấy dữ liệu text (Version) với cơ chế Retry 3 lần
get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    local result=$(curl --tlsv1.2 -sfL --connect-timeout 5 --max-time 10 "$url")
    if [[ -n "$result" ]]; then
      echo "$result"
      return 0
    fi
    sleep 2
    ((attempt++))
  done
  return 1
}

