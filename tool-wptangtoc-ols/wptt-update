  /bin/chmod 750 /usr/bin/wptangtoc-user
else
  /bin/chown -hR root:root /etc/wptt-user
  /bin/chmod -R 700 /etc/wptt-user
  /bin/cp -fp /etc/wptt-user/wptangtoc-user /usr/bin/
  /bin/chown root:root /usr/bin/wptangtoc-user
  /bin/chmod 700 /usr/bin/wptangtoc-user
fi

/bin/chmod 700 /etc/wptt/tmp

# Khử dấu tiếng Việt nếu người dùng cấu hình không dấu
if [[ "$khong_dau_vi_ngon_ngu" == '1' ]]; then
  find /etc/wptt -type f ! -path '/etc/wptt/lang/wptt-set-lang-vi' ! -path '/etc/wptt/wptt-update2' ! -path '/etc/wptt/wptt-update' ! -name '.*' \
    -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    find /etc/wptt-user -type f \
      -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
  fi
fi

# ==============================================================================
# 9. HOÀN THIỆN CẬP NHẬT & METADATA
# ==============================================================================
if ! secure_download "https://wptangtoc.com/share/update" "update"; then
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update"
fi
if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig"
fi

# Chạy update helper chỉ khi vượt qua bài test verify chữ ký chính chủ
if [[ -s update && -s update.sig ]] && verify_gpg_signature "update" "update.sig"; then
  if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
    bash update >/dev/null 2>&1 || true
  fi
fi
/bin/rm -f update update.sig

# Lưu version bằng atomic edit
wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure" 2>/dev/null || true
echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true
echo "$version_wptangtoc_ols" >/etc/wptt/tmp/wptangtoc-ols-version-main 2>/dev/null || true

_rundone "WPTangToc OLS đã nâng cấp thành công lên phiên bản $wptangtocols_version"
wptt_logs "INFO" "Cập nhật WPTangToc OLS lên phiên bản $wptangtocols_version"
sleep 2

cd "$OLD_PWD" || cd /root || true

if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-update-main
  [[ "${1:-}" == "97" ]] && exec /usr/bin/wptangtoc 1
fi
exec /etc/wptt/wptt-status2
