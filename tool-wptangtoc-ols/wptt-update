      echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

      sleep 3
      if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
        exit 1
      fi

      [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-update-main 1
      [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
      exec /etc/wptt/wptt-status2
      exit 1
    fi

    _rundone "Xác thực GPG Thành Công. Đang tiến hành cài đặt..."

    # ==========================================================================
    # BACKUP ĐỂ ROLLBACK (PHÒNG HỜ)
    # ==========================================================================
    kiem_tra_ton_tai_nhom=$(grep -E '^wptangtoc-ols:' /etc/group 2>/dev/null || true)

    # 1. Lưu lại umask mặc định của hệ điều hành
    OLD_UMASK=$(umask)
    # 2. Bật khiên bảo vệ 077 (chỉ owner có quyền)
    umask 077
    mkdir -p /etc/wptt/wptt-backup-system
    timedate=$(date +%Hgio_%d_%m_%Y)
    BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:$version_wptangtoc_ols.zip"

    (cd /etc/wptt && zip -r -q "$BACKUP_FILE" . -x "wptt-backup-system/*" -x ".wptt.conf" -x ".ram_hien_tai" -x "vhost/*" -x "tmp/*") 2>/dev/null || true
    [[ -f "$BACKUP_FILE" ]] && zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop 2>/dev/null || true
    ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r rm -f 2>/dev/null || true

    # ==========================================================================
    # HÀM TỰ ĐỘNG ROLLBACK KHI GẶP LỖI (FAIL-SAFE ROLLBACK)
    # ==========================================================================
    rollback_and_exit() {
      umask "$OLD_UMASK"
      echo -e "\n${C_RED}❌ Lỗi chép file! Đang tự động khôi phục lại phiên bản cũ...${C_RESET}"
      if [[ -f "$BACKUP_FILE" ]]; then
        unzip -oq "$BACKUP_FILE" -d /etc/wptt/ 2>/dev/null || true
        /bin/cp -fp /etc/wptt/wptangtoc /usr/bin/ 2>/dev/null || true
        rm -f /etc/wptt/wptangtoc
        /bin/cp -fp /etc/wptt/wptt /usr/bin/ 2>/dev/null || true
        rm -f /etc/wptt/wptt
        /bin/cp -fp /etc/wptt/tai-nguyen-server/wtop /usr/bin/ 2>/dev/null || true
      fi

      sleep 3
      [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-update-main 1
      [[ ${1:-} == "97" ]] && exec /usr/bin/wptangtoc 1
      exec /etc/wptt/wptt-status2
      exit 1
    }

    # ==========================================================================
    # GIẢI NÉN VÀ CÀI ĐẶT (CORE)
    # ==========================================================================
    unzip -oq wptangtoc-ols.zip || rollback_and_exit

    if ! /bin/cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then
      rollback_and_exit
    fi
    # 3. Tắt khiên, trả lại umask mặc định cho các tiến trình bên dưới
    umask "$OLD_UMASK"

    rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
    rm -rf tool-wptangtoc-ols

    [[ -d /etc/wptt/wptt-child ]] && /bin/cp -rf /etc/wptt/wptt-child/* /etc/wptt/ 2>/dev/null || true

    chmod -R 700 /etc/wptt
    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      chown root:wptangtoc-ols /etc/wptt /etc/wptt/vhost
      chmod 750 /etc/wptt /etc/wptt/vhost
    else
      chown root:root /etc/wptt /etc/wptt/vhost
    fi

    /bin/cp -fp /etc/wptt/wptangtoc /usr/bin/
    rm -f /etc/wptt/wptangtoc
    /bin/cp -fp /etc/wptt/wptt /usr/bin/
    rm -f /etc/wptt/wptt

    /bin/cp -fp /etc/wptt/tai-nguyen-server/wtop /usr/bin/

    # ==========================================================================
    # CẬP NHẬT PHÂN QUYỀN VHOST THEO CƠ CHẾ BẢO MẬT (ZERO TRUST)
    # ==========================================================================
    chown root:root /etc/wptt/.wptt.conf
    chmod 600 /etc/wptt/.wptt.conf

    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      # 1. Trạng thái mặc định: Đóng băng tuyệt đối (Auto-Healing)
      chown root:root "$filepath"
      chmod 600 "$filepath"

      # 2. Kiểm tra nới lỏng quyền nếu hệ thống có sử dụng Jail
      if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
        domain="${filepath##*/}"
        domain="${domain%.conf}"
        domain="${domain#.}"

        path_site="/usr/local/lsws/$domain"

        # Xác định lồng Jail đang hoạt động (có thư mục /etc của root)
        if [[ -d "$path_site" && -d "$path_site/etc" ]]; then
          if [[ $(stat -c '%U' "$path_site/etc" 2>/dev/null) == "root" ]]; then
            # Dùng grep bóc tách biến an toàn
            check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"' | tr -d "'")

            if [[ -n "$check_user_vhost" ]]; then
              # Kiểm tra user có nằm trong nhóm wptangtoc-ols không
              if grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
                chown root:wptangtoc-ols "$filepath"
                chmod 640 "$filepath"
              fi
            fi
          fi
        fi
      fi
    done

    # ==========================================================================
    # TIẾN HÀNH GIẢI NÉN VÀ CHÉP FILE (USER)
    # ==========================================================================
    OLD_UMASK=$(umask)
    umask 007
    unzip -qo wptangtoc-ols-user.zip 2>/dev/null || true
    /bin/cp -rf tool-wptangtoc-ols-user/* /etc/wptt-user/ 2>/dev/null || true
    umask "$OLD_UMASK"

    rm -f wptangtoc-ols-user.zip wptangtoc-ols-user.zip.sig
    rm -rf tool-wptangtoc-ols-user

    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      chown -hR root:wptangtoc-ols /etc/wptt-user
      chmod -R 750 /etc/wptt-user
      /bin/cp -fp /etc/wptt-user/wptangtoc-user /usr/bin/
      chown root:wptangtoc-ols /usr/bin/wptangtoc-user
      chmod 750 /usr/bin/wptangtoc-user
    else
      chown -hR root:root /etc/wptt-user
      chmod -R 700 /etc/wptt-user
      /bin/cp -fp /etc/wptt-user/wptangtoc-user /usr/bin/
      chown root:root /usr/bin/wptangtoc-user
      chmod 700 /usr/bin/wptangtoc-user
    fi

    chmod 700 /etc/wptt/tmp 2>/dev/null || true

    # Khử dấu ngôn ngữ
    if [[ "$khong_dau_vi_ngon_ngu" == '1' ]]; then
      find /etc/wptt -type f ! -path '/etc/wptt/lang/wptt-set-lang-vi' ! -path '/etc/wptt/wptt-update2' ! -path '/etc/wptt/wptt-update' ! -name '.*' -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} + 2>/dev/null || true
      if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
        find /etc/wptt-user -type f -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} + 2>/dev/null || true
      fi
    fi

    # ==========================================================================
    # Cấu hình phụ trợ (Script Update server & Dự phòng Github bọc GPG)
    # ==========================================================================
    # 1. Tải file update và file chữ ký số (Sử dụng hàm secure_download mới)
    if ! secure_download "https://wptangtoc.com/share/update" "update"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update"
    fi
    if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig"
    fi

    # 3. [FIX GPG Spoofing] Quét GPG và chỉ thực thi khi 100% chính chủ
    if [[ -s update && -s update.sig ]] && verify_gpg_package "update" "update.sig" "UpdateScript"; then
      if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
        bash update >/dev/null 2>&1 || true
      fi
    else
      wptt_logs "INFO" "Lỗi: Script 'update' sai chữ ký GPG hoặc rớt mạng - Bỏ qua thực thi $(date '+%d-%m-%Y %H:%M')"
    fi

    # 4. Dọn rác
    rm -f update update.sig 2>/dev/null || true

    # Lưu Version
    wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure" 2>/dev/null || true

    echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true
    echo "$version_wptangtoc_ols" >/etc/wptt/tmp/wptangtoc-ols-version-main 2>/dev/null || true

    # Quay về thư mục gốc
    cd "$OLD_PWD" 2>/dev/null || cd /root || true

    # Thông báo hoàn tất
    _rundone "WPTangToc OLS đã cập nhật Hệ thống lên bản $wptangtocols_version"

    wptt_logs "INFO" "Cập nhật WPTangToc OLS"
    sleep 3

    if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
      exit 0
    fi

    if [[ -n "${1:-}" ]]; then
      [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-update-main
      [[ "${1:-}" == "97" ]] && exec /usr/bin/wptangtoc 1
    fi
  else
    # Nếu người dùng bấm "Không đồng ý / Để sau"
    echo -e "${C_YELLOW}Đã hủy thao tác cập nhật.${C_RESET}"
    sleep 1
  fi

  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    exit 0
  fi

  if [[ -n "${1:-}" ]]; then
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-update-main
    [[ "${1:-}" == "97" ]] && exec /usr/bin/wptangtoc 1
  fi
  exec /etc/wptt/wptt-status2
fi
