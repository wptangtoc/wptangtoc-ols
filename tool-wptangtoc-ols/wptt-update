verify_gpg_signature() {
  local data_file="$1"
  local sig_file="$2"
  local status_out

  status_out=$(gpg --status-fd 1 --verify "$sig_file" "$data_file" 2>/dev/null || true)
  if grep -q '\[GNUPG:\] GOODSIG' <<<"$status_out" &&
    grep -qE "\[GNUPG:\] VALIDSIG ${EXPECTED_FP}" <<<"$status_out"; then
    return 0
  fi
  return 1
}

auth_core=0
auth_user=0

[[ -f wptangtoc-ols.zip && -f wptangtoc-ols.zip.sig ]] && verify_gpg_signature "wptangtoc-ols.zip" "wptangtoc-ols.zip.sig" && auth_core=1
