# ==============================================================================
# HÀM TIỆN ÍCH BẢO MẬT & RETRY LOGIC
# ==============================================================================
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    if curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 45 -A "$user_agent" "$url" -o "$dest"; then
      return 0
    fi
    sleep 3
    attempt=$((attempt + 1))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    local result
    result=$(curl --tlsv1.2 -sfL --connect-timeout 5 --max-time 10 "$url" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo "$result"
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  return 1
}

# Xác thực chữ ký số bằng keyring hệ thống kết hợp kiểm tra VALIDSIG
verify_gpg_validsig() {
  local sig_file="$1"
  local target_file="$2"

  [[ ! -s "$sig_file" || ! -s "$target_file" ]] && return 1

  local gpg_output gpg_ec=0
  gpg_output=$(gpg --status-fd 1 --batch --verify "$sig_file" "$target_file" 2>/dev/null) || gpg_ec=$?

  if [[ $gpg_ec -ne 0 ]]; then
    return 1
  fi

  local signer_fp primary_fp is_valid=0
  while IFS= read -r line; do
    if [[ "$line" =~ ^\[GNUPG:\]\ VALIDSIG[[:space:]]+([A-Fa-f0-9]+)[[:space:]]+.*[[:space:]]+([A-Fa-f0-9]+)$ ]]; then
      signer_fp="${BASH_REMATCH[1]}"
      primary_fp="${BASH_REMATCH[2]}"
      if [[ "$signer_fp" == "$EXPECTED_FP" || "$primary_fp" == "$EXPECTED_FP" ]]; then
        is_valid=1
        break
      fi
    fi
  done <<<"$gpg_output"

  [[ $is_valid -eq 1 ]]
}

