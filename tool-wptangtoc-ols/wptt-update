  PUB_KEY_FETCH="$TMP_DIR/wptangtoc-gpg-pub.key"

  if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "$PUB_KEY_FETCH"; then
    if ! secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "$PUB_KEY_FETCH"; then
      _runloi "Không thể tải Khóa bảo mật GPG từ cả máy chủ chính và GitHub!"
      exit 1
    fi
  fi

  real_fp=$(gpg --show-keys --with-colons "$PUB_KEY_FETCH" 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1 || true)
  if [[ -n "$real_fp" && "$real_fp" == "$EXPECTED_FP" ]]; then
    gpg --batch --import "$PUB_KEY_FETCH" >/dev/null 2>&1 || true
    _rundone "Nạp Khóa bảo mật GPG thành công"
  else
    _runloi "CẢNH BÁO BẢO MẬT: Public Key giả mạo hoặc sai lệch Fingerprint!"
    rm -f "$PUB_KEY_FETCH"
    exit 1
  fi
