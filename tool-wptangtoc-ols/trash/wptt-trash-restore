function huong_dan() {
  Tính năng Phục hồi website từ Thùng rác ảo [Virtual Trash Restore]

  [ Mục đích và Lợi ích ]
  Đưa website bị xóa nhầm quay trở lại hoạt động bình thường trên máy chủ. Tính năng tự động hóa hoàn toàn giúp tiết kiệm thời gian, không cần thao tác kỹ thuật phức tạp.

  [ Cơ chế hoạt động Tự động hóa ]
  Hệ thống sẽ không chỉ lấy lại mã nguồn, mà còn thực hiện quy trình "Hồi sinh" toàn diện:
  1. Tự động tái tạo cấu hình máy chủ [Vhost, PHP, Logs].
  2. Tự động khôi phục Database siêu tốc.
  3. Tự động đồng bộ file wp-config.php với thông tin bảo mật mới nhất.
  Bạn không cần phải làm thêm bất cứ thao tác kỹ thuật nào ngoài việc cài lại SSL!

  [ Hướng dẫn và Lưu ý ]
  Nếu bạn đã tạo lại website với cùng một tên miền đang tồn tại trên hệ thống, kịch bản sẽ chặn khôi phục để bảo vệ dữ liệu mới. Hãy xóa website hiện tại trước khi khôi phục bản cũ.
}

cd /root 2>/dev/null || cd /

export box_inner_width=78

function huong_dan() {
Tính năng Phục hồi website từ Thùng rác ảo [Virtual Trash Restore]

[ Cơ chế hoạt động Tự động hóa ]
Hệ thống sẽ không chỉ lấy lại mã nguồn, mà còn thực hiện quy trình "Hồi sinh" toàn diện:
1. Tự động tái tạo cấu hình máy chủ [Vhost, PHP, Logs].
2. Tự động khởi tạo Database siêu tốc.
3. Tự động đồng bộ file wp-config.php với thông tin bảo mật mới nhất.
Bạn không cần phải làm thêm bất cứ thao tác kỹ thuật nào ngoài việc cài lại SSL!
}

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
TRASH_PATH="${WPTT_TRASH_PATH:-/usr/local/.wptt_trash}"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}TRUNG TÂM PHỤC HỒI TỪ THÙNG RÁC${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

if [[ ! -d "$TRASH_PATH" || -z "$(ls -A "$TRASH_PATH" 2>/dev/null)" ]]; then
    echo -e "\n${C_GREEN}Thùng rác hiện đang trống rỗng! Không có dữ liệu nào để khôi phục.${C_RESET}\n"
    read -p "Bấm phím Enter để quay lại..."
    exit 0
fi

# ==============================================================================
# 1. THỐNG KÊ VÀ HIỂN THỊ DANH SÁCH
# ==============================================================================
stt=1
declare -A trash_list
declare -A domain_list

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}DANH SÁCH WEBSITE ĐANG TRONG THÙNG RÁC${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

for dir in "$TRASH_PATH"/*; do
    [[ ! -d "$dir" ]] && continue
    folder_name=$(basename "$dir")
    
    domain="${folder_name%_*}" 
    domain="${domain%_*}"       
    
    datetime_part="${folder_name#${domain}_}"
    yyyy="${datetime_part:0:4}"
    mm="${datetime_part:4:2}"
    dd="${datetime_part:6:2}"
    hh="${datetime_part:9:2}"
    min="${datetime_part:11:2}"
    
    fsize=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
    
    trash_list[$stt]="$folder_name"
    domain_list[$stt]="$domain"

    item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_GREEN}%-7s${C_RESET}] ${C_BOLD_WHITE}%-25s${C_RESET} (Xóa lúc: %s/%s/%s %s:%s)" "$stt" "${fsize:-???}" "$domain" "$dd" "$mm" "$yyyy" "$hh" "$min")
    clean_row=$(printf "  %3d) [%-7s] %-25s (Xóa lúc: %s/%s/%s %s:%s)" "$stt" "${fsize:-???}" "$domain" "$dd" "$mm" "$yyyy" "$hh" "$min")
    
    pad=$((box_inner_width - ${#clean_row}))
    [[ $pad -lt 0 ]] && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((stt++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

# ==============================================================================
# 2. CHỌN LỰA WEBSITE
# ==============================================================================
while true; do
    echo -en "${C_CYAN}Nhập số thứ tự Website cần khôi phục (1-$((stt-1))) [0=Thoát]: ${C_RESET}"
    read -r choice
    [[ "$choice" == "0" || -z "$choice" ]] && exit 0
    
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$stt" ]; then
        selected_folder="${trash_list[$choice]}"
        domain="${domain_list[$choice]}"
        full_trash_path="$TRASH_PATH/$selected_folder"
        break
    else
        echo -e "${C_RED}Lựa chọn không hợp lệ!${C_RESET}"
    fi
done

if [[ -d "/usr/local/lsws/$domain" ]]; then
    echo -e "\n${C_RED}LỖI: website $domain hiện đang tồn tại trên hệ thống.${C_RESET}"
    echo "Vui lòng xóa website hiện tại trước khi tiến hành khôi phục!"
    read -p "Bấm phím Enter để quay lại..."
    exit 1
fi

echo -e "\n${C_CYAN}Đang tự động tái tạo cấu hình Vhost và Database cho: ${C_YELLOW}$domain${C_RESET}..."

# ==============================================================================
# 3. TỰ ĐỘNG HÓA 100%: GỌI MODULE THÊM WEBSITE CHẠY NGẦM
# ==============================================================================
if [[ -f "/etc/wptt/domain/wptt-themwebsite" ]]; then
    . /etc/wptt/domain/wptt-themwebsite "$domain" >/dev/null 2>&1
fi

if [[ ! -f "/etc/wptt/vhost/.$domain.conf" ]]; then
    echo -e "${C_RED}Lỗi nghiêm trọng: Quá trình tái tạo cấu hình máy chủ thất bại!${C_RESET}"
    exit 1
fi

echo -e "${C_CYAN}Khôi phục Dữ liệu...${C_RESET}"

# Đọc cấu hình ngẫu nhiên (DB, User, Password) vừa được wptt-themwebsite sinh ra
. "/etc/wptt/vhost/.$domain.conf"

# ==============================================================================
# 4. TRÁO ĐỔI DỮ LIỆU & CẬP NHẬT WP-CONFIG
# ==============================================================================
# A. Đắp mã nguồn từ thùng rác vào vỏ Vhost mới (Dùng RENAME_EXCHANGE Syscall)
THU_MUC_CHINH="/usr/local/lsws/$domain/html"
THU_MUC_TAM="$full_trash_path/html"

python3 -c "
import ctypes
import sys
try:
    libc = ctypes.CDLL('libc.so.6')
    res = libc.renameat2(-100, b'${THU_MUC_CHINH}', -100, b'${THU_MUC_TAM}', 2)
    if res != 0: sys.exit(1)
except Exception:
    sys.exit(1)
" >/dev/null 2>&1

if [[ $? -eq 0 ]]; then
    # Tráo đổi thành công: Mã nguồn thật đã vào Vhost, vỏ rỗng bị đẩy ra thư mục rác
    rm -rf "$THU_MUC_TAM"
else
    # Fallback tương thích ngược (Hệ điều hành không hỗ trợ renameat2)
    rm -rf "$THU_MUC_CHINH"
    mv "$THU_MUC_TAM" "/usr/local/lsws/$domain/"
fi

# Cứu hộ thư mục mật khẩu (.passwd) nếu có
[[ -d "$full_trash_path/passwd" ]] && cp -rf "$full_trash_path/passwd" "/usr/local/lsws/$domain/" 2>/dev/null

. /etc/wptt/.wptt.conf
# B. Chuẩn bị thông tin xác thực Database an toàn
password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF_ROOT"
cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username}"
password="${password_database_root}"
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF

unset password_database_root database_admin_password

# C. Ve sầu thoát xác: Dời dữ liệu Database rác sang Database mới tinh
db_trash_file="$full_trash_path/.trash_db_name"
if [[ -f "$db_trash_file" ]]; then
    TRASH_DB=$(cat "$db_trash_file")
    if [[ -n "$DB_Name_web" && -n "$TRASH_DB" ]]; then
        # Gọi mariadb đi kèm file xác thực an toàn
        RENAME_QUERY=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -s -e "SELECT CONCAT('RENAME TABLE \`', table_schema, '\`.\`', table_name, '\` TO \`$DB_Name_web\`.\`', table_name, '\`;') FROM information_schema.TABLES WHERE table_schema='$TRASH_DB';" 2>/dev/null)
        if [[ -n "$RENAME_QUERY" ]]; then
            mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "$RENAME_QUERY" 2>/dev/null
        fi
        mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`$TRASH_DB\`;" 2>/dev/null
    fi
fi

# Dọn dẹp file cấu hình bảo mật tạm
rm -f "$TEMP_CNF_ROOT"

# D. WP-CLI: Bơm tài khoản Database mới vào file wp-config.php cũ
wp_config_php_path="/usr/local/lsws/$domain/html/wp-config.php"
if [[ -f "$wp_config_php_path" ]]; then
    # Mở khóa file (nếu bị bảo vệ)
    if [[ $(lsattr "$wp_config_php_path" 2>/dev/null | cut -f1 -d ' ' | grep 'i') ]]; then
        chattr -i "$wp_config_php_path" 2>/dev/null
    fi

    password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
    [[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

    wp config set DB_NAME "$DB_Name_web" --type=constant --allow-root --path="/usr/local/lsws/$domain/html" --quiet
    wp config set DB_USER "$DB_User_web" --type=constant --allow-root --path="/usr/local/lsws/$domain/html" --quiet
    wp config set DB_PASSWORD "$password_database_website_giai_ma" --type=constant --allow-root --path="/usr/local/lsws/$domain/html" --quiet
fi

# E. Dọn dẹp xác thùng rác và sửa phân quyền
rm -rf "$full_trash_path"
. /etc/wptt/wptt-phanquyen "$domain" >/dev/null 2>&1
/usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CHÚC MỪNG! WEBSITE ĐÃ HỒI SINH HOÀN TOÀN!${C_RESET}"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
# ==============================================================================
# 5. UX SMART HINT TÌNH TRẠNG SSL
# ==============================================================================
. /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$NAME" >/dev/null 2>&1
if [[ "$ssl_xac_thuc_kha_dung" == 'true' ]]; then
	echo -e "${C_GREEN}Chứng chỉ SSL của website vẫn còn nguyên vẹn${C_RESET}"
else
	TRACE_OUTPUT=$(curl -Is --connect-timeout 5 --max-time 10 "https://$NAME/cdn-cgi/trace" 2>/dev/null)
	if grep -Eqi 'cloudflare|cf-ray' <<< "$TRACE_OUTPUT"; then
		:
	else
		echo -e "vui lòng cài đặt lại chứng chỉ bằng lệnh: ${C_CYAN}wptt ssl -d $domain hoặc menu quản lý SSL${C_RESET}"
	fi
fi

cd /root 2>/dev/null || cd /

echo ""
read -p "Bấm phím Enter để quay lại..."
