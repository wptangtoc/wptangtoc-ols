function huong_dan() {
  Tính năng Thay đổi số ngày lưu trữ tự động [Set Trash Retention Days]

  [ Mục đích và Lợi ích ]
  Cấu hình thời gian tối đa [tuổi thọ] mà một website bị xóa được phép nằm trong thùng rác trước khi bị hệ thống Cronjob tiêu hủy vĩnh viễn. Giúp cân bằng giữa an toàn dữ liệu và không gian lưu trữ.

  [ Lời khuyên thiết lập ]
  * Mặc định hệ thống là 3 ngày: Đây là khoảng thời gian lý tưởng để khách hàng kịp thời nhận ra sai sót và yêu cầu khôi phục.
  * 1 - 2 ngày: Dành cho máy chủ VPS có dung lượng ổ cứng nhỏ, I/O thấp.
  * 7 - 14 ngày: Dành cho hệ thống máy chủ vật lý [Dedicated Server], lưu trữ dư dả, yêu cầu an toàn dữ liệu khắt khe.
}

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

CONF_FILE="/etc/wptt/.wptt.conf"
CURRENT_DAYS=${WPTT_TRASH_DAYS:-3}

# ==============================================================================
# 1. PHÂN TÍCH ĐỐI SỐ ĐẦU VÀO (HỖ TRỢ CLI AUTOMATION)
# ==============================================================================
NEW_DAYS=""
is_interactive=1

# Nếu chạy script kèm đối số (không phải mã 98 của menu), ép kiểu chạy ngầm
if [[ -n "$1" && "$1" != "98" ]]; then
    NEW_DAYS="$1"
    is_interactive=0
fi

# ==============================================================================
# 2. GIAO DIỆN HỎI ĐÁP (MENU MODE)
# ==============================================================================
if [[ $is_interactive -eq 1 ]]; then
    clear
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}CẤU HÌNH THỜI GIAN LƯU TRỮ THÙNG RÁC${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    
    echo -e "Hiện tại hệ thống sẽ tự động dọn rác sau: ${C_YELLOW}${CURRENT_DAYS} Ngày${C_RESET}\n"
    read -p "Nhập số ngày bạn muốn giữ lại (1-30, nhập 0 để hủy): " input_days
    NEW_DAYS="$input_days"
fi

# ==============================================================================
# 3. LOGIC XỬ LÝ & CẬP NHẬT CẤU HÌNH
# ==============================================================================
if [[ "$NEW_DAYS" == "0" ]]; then
    echo -e "\n${C_YELLOW}Đã hủy thao tác. Hệ thống giữ nguyên mốc thời gian ${CURRENT_DAYS} ngày.${C_RESET}"
elif [[ "$NEW_DAYS" =~ ^[0-9]+$ && "$NEW_DAYS" -gt 0 && "$NEW_DAYS" -le 30 ]]; then
    
    [[ $is_interactive -eq 1 ]] && echo ""
    _runing "Đang cập nhật thời gian lưu trữ Thùng rác ảo thành $NEW_DAYS ngày"
    
    if grep -q "^WPTT_TRASH_DAYS=" "$CONF_FILE"; then
        sed -i "s/^WPTT_TRASH_DAYS=.*/WPTT_TRASH_DAYS=$NEW_DAYS/" "$CONF_FILE"
    else
        echo "WPTT_TRASH_DAYS=$NEW_DAYS" >> "$CONF_FILE"
    fi
    
    _rundone "Đang cập nhật thời gian lưu trữ Thùng rác ảo thành $NEW_DAYS ngày"
    
    echo -e "\n${C_GREEN}✅ Cập nhật thành công!${C_RESET}"
    echo -e "Dữ liệu rác sẽ được bảo vệ an toàn trong ${C_CYAN}${NEW_DAYS} ngày${C_RESET} trước khi bị tiêu hủy tự động."
else
    echo -e "\n${C_RED}❌ Lỗi: Vui lòng nhập một số nguyên hợp lệ từ 1 đến 30.${C_RESET}"
fi

# ==============================================================================
# 4. ĐIỀU HƯỚNG THÔNG MINH
# ==============================================================================
if [[ $is_interactive -eq 1 || "$1" == "98" ]]; then
    echo ""
    read -p "Bấm phím Enter để quay lại..."
fi
