function huong_dan() {
  Tính năng Xem danh sách website trong thùng rác [Virtual Trash List]

  [ Mục đích và Lợi ích ]
  Hiển thị chi tiết tất cả các website đang được lưu trữ tạm thời trong Thùng rác ảo. Giúp bạn kiểm soát, quản lý dung lượng ổ cứng hiệu quả và dễ dàng tìm lại dữ liệu khi cần.

  [ Thông tin cung cấp ]
  * Tên miền: Tên website gốc đã bị xóa.
  * Thời gian xóa: Ngày giờ chính xác website được đưa vào thùng rác.
  * Dung lượng: Kích thước mã nguồn [Source Code] đang chiếm dụng trên ổ đĩa.
  * Trạng thái Database: Cho biết bản sao lưu cơ sở dữ liệu có còn nguyên vẹn [Lưu: Code + DB] hay không.
  * Tổng quan: Đánh giá tổng dung lượng rác để bạn cân nhắc việc dọn dẹp hoặc khôi phục.
}

export box_inner_width=78

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
TRASH_PATH="${WPTT_TRASH_PATH:-/usr/local/.wptt_trash}"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}DANH SÁCH WEBSITE ĐANG TRONG THÙNG RÁC${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

if [[ ! -d "$TRASH_PATH" || -z "$(ls -A "$TRASH_PATH" 2>/dev/null)" ]]; then
    echo -e "\n${C_GREEN}Thùng rác hiện đang trống rỗng! Ổ cứng của bạn đang rất sạch sẽ.${C_RESET}\n"
    read -p "Bấm phím Enter để quay lại..."
    exit 0
fi

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

stt=1
total_size_kb=0

for dir in "$TRASH_PATH"/*; do
    [[ ! -d "$dir" ]] && continue
    folder_name=$(basename "$dir")
    
    # Bóc tách tên miền gốc
    domain="${folder_name%_*}" 
    domain="${domain%_*}"       
    
    # Bóc tách thời gian xóa
    datetime_part="${folder_name#${domain}_}"
    yyyy="${datetime_part:0:4}"
    mm="${datetime_part:4:2}"
    dd="${datetime_part:6:2}"
    hh="${datetime_part:9:2}"
    min="${datetime_part:11:2}"
    
    # Đo lường dung lượng
    size_human=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
    size_kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    total_size_kb=$((total_size_kb + size_kb))

    # Xử lý UX thông báo rõ ràng (Code + DB)
    if [[ -f "$dir/.trash_db_name" ]]; then
        status_text="Code + DB"
        status_colored="${C_GREEN}Code + DB${C_RESET}"
    else
        status_text="Chỉ Code"
        status_colored="${C_YELLOW}Chỉ Code${C_RESET}"
    fi
    
    # Tính toán padding (khoảng trống) để kẻ khung chuẩn 78 ký tự (Căn chỉnh biến domain max 20 ký tự)
    clean_row=$(printf "  %3d) [%-7s] %-19s (Xóa: %s/%s/%s %s:%s | Lưu: %s)" "$stt" "${size_human:-0B}" "$domain" "$dd" "$mm" "$yyyy" "$hh" "$min" "$status_text")
    pad=$((box_inner_width - ${#clean_row}))
    [[ $pad -lt 0 ]] && pad=0

    item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_YELLOW}%-7s${C_RESET}] ${C_BOLD_WHITE}%-19s${C_RESET} (Xóa: %s/%s/%s %s:%s | Lưu: %s)" "$stt" "${size_human:-0B}" "$domain" "$dd" "$mm" "$yyyy" "$hh" "$min" "$status_colored")
    
    echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((stt++))
done

# Tính tổng dung lượng (MB/GB) để hiển thị ở footer
if (( total_size_kb > 1048576 )); then
    total_human=$(awk "BEGIN {printf \"%.2f GB\", $total_size_kb/1048576}")
else
    total_human=$(awk "BEGIN {printf \"%.2f MB\", $total_size_kb/1024}")
fi

echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

summary_text="Tổng cộng: $((stt-1)) Website đang bị giam giữ (Chiếm ${total_human})"
pad_sum=$((box_inner_width - ${#summary_text} - 2))
[[ $pad_sum -lt 0 ]] && pad_sum=0

echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}Tổng cộng:${C_RESET} $((stt-1)) Website đang bị giam giữ (Chiếm ${C_YELLOW}${total_human}${C_RESET})$(printf '%*s' "$pad_sum" "")${C_CYAN}│${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""
read -p "Bấm phím Enter để quay lại..."
