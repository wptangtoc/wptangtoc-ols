#Ép toàn bộ tiến trình script hiện tại xuống mức ưu tiên thấp nhất
renice -n 19 -p $$ >/dev/null 2>&1
if command -v ionice &>/dev/null; then
    ionice -c 3 -p $$ >/dev/null 2>&1
fi

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

TRASH_PATH="${WPTT_TRASH_PATH:-/usr/local/.wptt_trash}"
TRASH_DAYS="${WPTT_TRASH_DAYS:-3}"

# Nếu tính năng bị tắt hoặc số ngày = 0 thì không làm gì cả
[[ "$WPTT_TRASH_ENABLE" == "0" || "$TRASH_DAYS" -eq 0 ]] && exit 0
[[ ! -d "$TRASH_PATH" ]] && exit 0

CURRENT_EPOCH=$(date +%s)
THRESHOLD_SECONDS=$((TRASH_DAYS * 86400)) # Quy đổi số ngày ra giây

# CHUẨN BỊ XÁC THỰC DATABASE
password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf 2>/dev/null || mktemp /tmp/wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF_ROOT"
cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username}"
password="${password_database_root}"
host=localhost
EOF
unset password_database_root database_admin_password

# QUÉT VÀ TIÊU HỦY THEO THỜI GIAN THỰC TẾ (HẠN CHẾ TÀI NGUYÊN)
# Khai báo bộ khung lệnh chạy ngầm êm ái
CMD_NICE="nice -n 19"
if command -v ionice &>/dev/null; then
    CMD_NICE="ionice -c 3 nice -n 19"
fi

for dir in "$TRASH_PATH"/*; do
    [[ ! -d "$dir" ]] && continue
    
    folder_name=$(basename "$dir")
    
    # Bóc tách tên miền gốc
    domain="${folder_name%_*}" 
    domain="${domain%_*}"
    
    # Bóc tách chuỗi thời gian YYYYMMDD_HHMMSS
    datetime_part="${folder_name#${domain}_}"
    
    yyyy="${datetime_part:0:4}"
    mm="${datetime_part:4:2}"
    dd="${datetime_part:6:2}"
    hh="${datetime_part:9:2}"
    min="${datetime_part:11:2}"
    ss="${datetime_part:13:2}"
    
    # Ép kiểu về format chuẩn của Linux: YYYY-MM-DD HH:MM:SS
    formatted_date="$yyyy-$mm-$dd $hh:$min:$ss"
    trash_epoch=$(date -d "$formatted_date" +%s 2>/dev/null)
    
    # Nếu giải mã thời gian thành công
    if [[ -n "$trash_epoch" ]]; then
        diff=$((CURRENT_EPOCH - trash_epoch))
        
        # Nếu tuổi thọ trong thùng rác vượt quá ngưỡng cho phép
        if (( diff >= THRESHOLD_SECONDS )); then
            
            # Xóa Database rác trước (Ép xung I/O nhàn rỗi)
            if [[ -f "$dir/.trash_db_name" ]]; then
                TRASH_DB=$(cat "$dir/.trash_db_name")
                if [[ -n "$TRASH_DB" ]]; then
                    $CMD_NICE mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`$TRASH_DB\`;" 2>/dev/null
                fi
            fi
            
            # Xóa mã nguồn vật lý (Tác vụ tốn I/O nhất -> Bọc kỹ bằng ionice)
            $CMD_NICE rm -rf "${dir:?}"
            
            # Ghi log âm thầm
            wptt_logs "INFO" "Cronjob: Đã tự động tiêu hủy rác của website $domain (Quá $TRASH_DAYS ngày)"
        fi
    fi
done

# Dọn dẹp file cấu hình bảo mật
rm -f "$TEMP_CNF_ROOT"
