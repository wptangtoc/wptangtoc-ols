#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng Chống DDoS 403 trong WPTangToc OLS là một cơ chế phòng vệ giúp máy chủ OpenLiteSpeed của bạn đối phó với các cuộc tấn công từ chối dịch vụ phân tán [DDoS] ở mức độ đơn giản đến trung bình.

  Mã lỗi HTTP 403 Forbidden là một mã trạng thái HTTP tiêu chuẩn mà máy chủ web gửi lại cho trình duyệt [hoặc client] khi máy chủ hiểu yêu cầu của bạn, nhưng từ chối thực hiện yêu cầu đó.

  Bằng cách theo dõi các địa chỉ IP bị trả về lỗi 403 Forbidden. Nếu trong vòng 10 giây mà IP đó yêu cầu và bị trả về 403 hơn 5 lần sẽ bị tạm khoá IP trong vòng 2 tiếng.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. /etc/wptt/lang/$ngon_ngu.sh 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

FILTER_PATH="/etc/fail2ban/filter.d/http-403-wptangtoc-ols.conf"
JAIL_NAME="http-403-vi-pham-bao-mat"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BẢO MẬT ➜ Cấu hình Chống DDoS qua lỗi HTTP 403${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ ! -f "$FILTER_PATH" ]]; then
    # ==========================================================================
    # TRẠNG THÁI: ĐANG TẮT -> CHO PHÉP BẬT
    # ==========================================================================
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN KÍCH HOẠT CHỐNG DDOS 403${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Tính năng này hiện ĐANG TẮT trên toàn hệ thống." 2
    left_text "  Nếu IP bị lỗi 403 quá 5 lần trong 10 giây, sẽ bị khóa 2 tiếng." 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT CHỐNG DDOS 403 (Theo dõi toàn bộ Access Log hệ thống)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT CHỐNG DDOS 403${C_RESET} (Theo dõi toàn bộ Access Log hệ thống)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) Không làm gì cả (Hủy thao tác)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r choice

    if [[ "$choice" == "1" ]]; then
        
        # 1. KIỂM TRA BẢO MẬT: BẬT CLOUDFLARE REAL IP ĐỂ CHỐNG KHÓA NHẦM IP CDN
        if ! grep -q '103.21.244.0' /usr/local/lsws/conf/httpd_config.conf 2>/dev/null; then
            echo -e "\n${C_RED}[CẢNH BÁO QUAN TRỌNG]${C_RESET}"
            echo -e "Hệ thống phát hiện máy chủ ${C_YELLOW}CHƯA BẬT${C_RESET} Show Real IP cho Cloudflare CDN."
            echo "Nếu hệ thống của bạn dùng Cloudflare, Fail2ban sẽ chặn nhầm IP của Cloudflare gây sập web!"
            if wptt_xac_nhan "Bạn có muốn KÍCH HOẠT Cloudflare Real IP ngay bây giờ không?" "Tính năng này giúp xác định đúng địa chỉ IP thật của Client." "Khuyên dùng để chống DDoS chính xác." "Đồng ý kích hoạt" "Bỏ qua rủi ro"; then
                _runing "Đang cấu hình Cloudflare Show Real IP..."
                . /etc/wptt/cloudflare-cdn-ip-show-real >/dev/null 2>&1
                _rundone "Cấu hình Cloudflare Real IP thành công!"
            fi
        fi

        echo ""
        _runing "Đang kích hoạt quy tắc Chống DDoS HTTP 403..."
        
        # 2. CÀI ĐẶT GÓI PHỤ THUỘC (DEPENDENCIES)
        if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
            dpkg -s python3-pyinotify ipset >/dev/null 2>&1 || {
                export DEBIAN_FRONTEND=noninteractive
                apt-get update >/dev/null 2>&1
                apt-get install -y python3-pyinotify ipset >/dev/null 2>&1
            }
        else
            rpm -q python3-inotify ipset >/dev/null 2>&1 || {
                dnf install -y python3-inotify ipset >/dev/null 2>&1
            }
        fi
        
        # 3. TÍNH TOÁN QUY TẮC FIREWALL (BACKEND)
        rule_fail2ban_name="http-403-wptt"
        if [[ -f /etc/csf/csf.conf ]]; then
            action_thuc_thi_block="iptables-multiport[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
           iptables-multiport[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
        elif [[ $(systemctl status nftables.service 2>/dev/null | grep -i 'Active' | grep -o 'active') == "active" ]]; then
            action_thuc_thi_block="nftables-allports[name=$rule_fail2ban_name]"
        elif [[ $(systemctl status firewalld.service 2>/dev/null | grep -i 'Active' | grep -o 'active') == "active" ]]; then
            action_thuc_thi_block="firewallcmd-ipset[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
           firewallcmd-ipset[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
        else
            action_thuc_thi_block="iptables-multiport[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
           iptables-multiport[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
        fi

        # Xóa khối cấu hình cũ nếu còn sót lại
        sed -i -e '/^#begin-http-403-vi-pham-bao-mat/,/^#end-http-403-vi-pham-bao-mat$/d' /etc/fail2ban/jail.local 2>/dev/null
        
        # Ghi khối cấu hình Jail mới bằng HereDoc
        cat <<EOF >> "/etc/fail2ban/jail.local"

#begin-http-403-vi-pham-bao-mat
[$JAIL_NAME]
enabled = true
action = $action_thuc_thi_block
filter = http-403-wptangtoc-ols
logpath = /usr/local/lsws/*/logs/access.log
backend = pyinotify
bantime = 7200
maxretry = 5
findtime = 10
#end-http-403-vi-pham-bao-mat
EOF

        # Ghi Regex nhận diện
        echo '[Definition]
failregex = ^<HOST> .* "(GET|POST|DELETE|PUT|PATCH|HEAD) .* HTTP\/.*" 403 .*$
ignoreregex = \.(?i)(robots\.txt|favicon\.ico|jpg|png|webp|css|js|jpeg|woff2|avif|gif|svg|woff|ttf)(\?.*)?$' > "$FILTER_PATH"

        # Khởi động lại dịch vụ
        /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1
        fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1
        
        _rundone "Kích hoạt Chống DDoS HTTP 403 thành công!"
        echo -e "   ${C_CYAN}➜ Ghi chú:${C_RESET} IP bị lỗi 403 quá 5 lần trong 10 giây sẽ tự động bị khóa 2 tiếng."
        sleep 3
        exec /etc/wptt/wptt-bao-mat-main 1
    else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
    fi

else
    # ==========================================================================
    # TRẠNG THÁI: ĐANG BẬT -> CHO PHÉP TẮT
    # ==========================================================================
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN TẮT CHỐNG DDOS 403${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Tính năng này hiện ĐANG BẬT trên toàn hệ thống." 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) TẮT CHỐNG DDOS 403 (Gỡ bỏ quy tắc chặn IP)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT CHỐNG DDOS 403${C_RESET} (Gỡ bỏ quy tắc chặn IP)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) Không làm gì cả (Giữ nguyên bảo vệ)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên bảo vệ)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r choice

    if [[ "$choice" == "1" ]]; then
        echo ""
        _runing "Đang tắt quy tắc Chống DDoS HTTP 403..."
        
        rm -f "$FILTER_PATH"
        sed -i -e '/^#begin-http-403-vi-pham-bao-mat/,/^#end-http-403-vi-pham-bao-mat$/d' /etc/fail2ban/jail.local
        
        fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1
        _rundone "Tắt Chống DDoS HTTP 403 thành công!"
        
        sleep 2
        exec /etc/wptt/wptt-bao-mat-main 1
    else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
    fi
fi
