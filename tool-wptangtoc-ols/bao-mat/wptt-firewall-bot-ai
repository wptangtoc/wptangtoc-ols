# ==============================================================================
# HÀM MENU LỌC THÔNG MINH (CÓ TRẠNG THÁI + FZF)
# ==============================================================================
function lua_chon_NAME() {
  unset NAME selects
  selects=()
  local i=1

  # Vòng lặp Globbing siêu tốc không qua sub-shell
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    local domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
      local htaccess_path="/usr/local/lsws/$domain/html/.htaccess"
      if [[ -f "$htaccess_path" ]]; then
        local status_text=""
        local status_color=""

        if grep -q '#begin-tuong-lua-block-bot-ai' "$htaccess_path" 2>/dev/null; then
          status_text="[Đang BẬT Chặn AI]"
          status_color=$C_GREEN
        else
          status_text="[Đang TẮT]"
          status_color=$C_RED
        fi

        selects+=("$domain|$status_text|$status_color")
      fi
    fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không tìm thấy website nào có file .htaccess trên hệ thống!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  # Sắp xếp mảng
  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER KHỐI BO CONG (TAB GẠCH CHÂN + CHIA CỘT)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Nhập lựa chọn website cấu hình Chặn BOT AI:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      # Xử lý cắt lớp (Box Layout) cho tùy chọn đồng loạt
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Bật / Tắt Tường lửa AI cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Bật / Tắt Tường lửa AI cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      # Dòng website bình thường
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # Dòng nhắc lệnh (Prompt) siêu sạch
  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Tìm Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-bao-mat-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm nhanh >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ truyền đối số cho 1 domain cụ thể
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# HÀM THỰC THI BẬT/TẮT TƯỜNG LỬA CHẶN AI CHO 1 DOMAIN
# ==============================================================================
function process_firewall_bot_ai() {
  local target_domain=$1
  local action=$2 # "bat" hoac "tat"
  local path_ht="/usr/local/lsws/$target_domain/html/.htaccess"

  if [[ ! -f "$path_ht" ]]; then
    return
  fi

  if [[ "$action" == "bat" ]]; then
    if grep -q '#begin-tuong-lua-block-bot-ai' "$path_ht" 2>/dev/null; then
      return
    fi

    UI_STRING="Kích hoạt Tường lửa Chặn BOT AI cho $target_domain"
    _runing "$UI_STRING"

    # 1. Dọn dẹp bản cũ (nếu có lỗi sót lại)
    sed -i '/^#begin-tuong-lua-block-bot-ai/,/^#end-tuong-lua-block-bot-ai$/d' "$path_ht"

    # 2. Tiêm Quy tắc lên đỉnh file
    TMP_FILE=$(mktemp)
    cat "$path_firewall_rules" >"$TMP_FILE"
    echo "" >>"$TMP_FILE"
    cat "$path_ht" >>"$TMP_FILE"
    cat "$TMP_FILE" >"$path_ht"
    rm -f "$TMP_FILE"

    # 3. Update htaccess cache Vhost
    vhost_chuyen_htaccess=""
    . /etc/wptt/vhost/.$target_domain.conf 2>/dev/null
    [[ -n "$vhost_chuyen_htaccess" ]] && /etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost "$target_domain" >/dev/null 2>&1

    echo "Bật Chặn BOT AI website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"

  elif [[ "$action" == "tat" ]]; then
    if ! grep -q '#begin-tuong-lua-block-bot-ai' "$path_ht" 2>/dev/null; then
      return
    fi

    UI_STRING="Tắt (Hủy) Tường lửa Chặn BOT AI cho $target_domain"
    _runing "$UI_STRING"

    # Dọn dẹp sạch sẽ block cấu hình
    sed -i -e '/^#begin-tuong-lua-block-bot-ai/,/^#end-tuong-lua-block-bot-ai$/d' "$path_ht"

    # Update htaccess cache Vhost
    vhost_chuyen_htaccess=""
    . /etc/wptt/vhost/.$target_domain.conf 2>/dev/null
    [[ -n "$vhost_chuyen_htaccess" ]] && /etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost "$target_domain" >/dev/null 2>&1

    echo "Tắt Chặn BOT AI website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"
  fi
}

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
mass_action=""
msg_action=""
thao_tac_thanh_cong=false

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  
  # NẾU DÙNG CLI ĐỐI SỐ -> BỎ QUA HỎI ĐÁP
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    mass_action="bat"
    msg_action="BẬT Hàng Loạt (Đã chặn BOT AI)"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    mass_action="tat"
    msg_action="TẮT Hàng Loạt (Cho phép BOT AI)"
  else
    # NẾU CHỌN TỪ MENU UI (SỐ TÙY CHỌN CUỐI CÙNG) -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: TƯỜNG LỬA CHẶN AI${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác cấu hình Tường lửa Chặn AI cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT Chặn BOT AI (Bảo vệ đồng loạt)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Chặn BOT AI${C_RESET} (Bảo vệ đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) TẮT Chặn BOT AI (Gỡ bỏ đồng loạt)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT Chặn BOT AI${C_RESET} (Gỡ bỏ đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice
    
    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      mass_action="bat"
      msg_action="BẬT Hàng Loạt (Đã chặn BOT AI)"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      mass_action="tat"
      msg_action="TẮT Hàng Loạt (Cho phép BOT AI)"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi

  # Quét toàn bộ danh sách domain để thực thi
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -d "/usr/local/lsws/$domain/html" ]]; then
      process_firewall_bot_ai "$domain" "$mass_action"
    fi
  done
  thao_tac_thanh_cong=true

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  pathcheck="/etc/wptt/vhost/.$NAME.conf"
  [[ ! -f "$pathcheck" ]] && {
    echo -e "\n${C_RED}❌ Tên miền không tồn tại!${C_RESET}"
    sleep 2
    exec /etc/wptt/wptt-bao-mat-main 1
  }

  path_ht="/usr/local/lsws/$NAME/html/.htaccess"

  # NẾU TRUYỀN CLI_MODE -> BỎ QUA BOX UI
  if [[ $CLI_MODE -eq 1 ]]; then
    process_firewall_bot_ai "$NAME" "$CLI_ACTION"
    thao_tac_thanh_cong=true
    if [[ "$CLI_ACTION" == "bat" ]]; then msg_action="BẬT Chặn BOT AI (Đá văng OpenAI, Claude...)"; else msg_action="TẮT Chặn BOT AI (Cho phép AI Crawlers truy cập)"; fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH TƯỜNG LỬA CHẶN BOT AI${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if grep -q '#begin-tuong-lua-block-bot-ai' "$path_ht" 2>/dev/null; then
      left_text "  Website ${NAME} hiện ĐANG BẬT Chặn AI." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) TẮT Chặn BOT AI (Mở cửa cho AI vào cào dữ liệu)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT Chặn BOT AI${C_RESET} (Mở cửa cho AI vào cào dữ liệu)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        msg_action="TẮT Chặn BOT AI (Cho phép AI Crawlers truy cập)"
        process_firewall_bot_ai "$NAME" "tat"
        thao_tac_thanh_cong=true
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      fi
    else
      left_text "  Website ${NAME} hiện ĐANG MỞ CỬA cho Bot AI." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) BẬT Chặn BOT AI (Đá văng OpenAI, Claude... ra khỏi Server)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Chặn BOT AI${C_RESET} (Đá văng OpenAI, Claude... ra khỏi Server)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        msg_action="BẬT Chặn BOT AI (Đá văng OpenAI, Claude, CCBot...)"
        process_firewall_bot_ai "$NAME" "bat"
        thao_tac_thanh_cong=true
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      fi
    fi
  fi
fi

