#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  YARA Engine
  Đây là hệ thống rà quét mã độc cực kỳ tối ưu và thông minh dành riêng cho WordPress.
  Lợi ích khi sử dụng công cụ này so với các kiểu quét truyền thống:
  
  * Quét siêu nhanh và không tốn RAM: Vì không cần chạy ngầm bất cứ tiến trình nào như ClamAV nên máy chủ của bạn sẽ luôn nhẹ nhàng, không bao giờ lo bị sập VPS do tốn tài nguyên.
  
  * Không bao giờ làm chậm website: Hệ thống được thiết lập để tự động hạ độ ưu tiên xuống mức thấp nhất, tức là chỉ tận dụng CPU và ổ cứng khi máy chủ đang rảnh rỗi.
  
  * Chính xác tuyệt đối và không báo nhầm: Nhờ kết hợp với WP-CLI để kiểm tra tính toàn vẹn của mã nguồn, hệ thống sẽ bỏ qua những file chuẩn sạch 100 phần trăm từ WordPress và chỉ tập trung vào các thư mục nghi ngờ hoặc file bị sửa đổi.
  
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BẢO MẬT ➜ Rà Quét Mã Độc WordPress (YARA)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# PHẦN 1: CÀI ĐẶT YARA & KIỂM TRA BỘ LUẬT
# ==============================================================================
if ! command -v yara >/dev/null 2>&1; then
  _runing "Lần đầu sử dụng: Đang cài đặt lõi quét YARA Engine..."
  if grep -qi "ubuntu\|debian" /etc/*release 2>/dev/null; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y -q >/dev/null 2>&1
    apt-get install yara -y -q >/dev/null 2>&1
  else
    dnf install epel-release -y -q >/dev/null 2>&1
    dnf install yara -y -q >/dev/null 2>&1
  fi
  _rundone "Cài đặt YARA Engine hoàn tất"
fi

YARA_RULE_FILE="/etc/wptt/bao-mat/wptt-scan-wp-malware.yar"
if [[ ! -f "$YARA_RULE_FILE" ]]; then
  _runloi "Không tìm thấy bộ luật YARA tại: $YARA_RULE_FILE"
  exit 1
fi

YARA_SYNTAX_CHECK=$(yara -w -d filepath="" "$YARA_RULE_FILE" /dev/null 2>&1 >/dev/null)
if [[ -n "$YARA_SYNTAX_CHECK" ]] && echo "$YARA_SYNTAX_CHECK" | grep -q 'error:'; then
  _runloi "Bộ luật YARA có lỗi biên dịch, dừng quét:"
  echo -e "${C_RED}$YARA_SYNTAX_CHECK${C_RESET}"
  exit 1
fi

# Tạo thư mục TMP nội bộ của WPTangToc
mkdir -p /etc/wptt/tmp
chmod 700 /etc/wptt/tmp

# ==============================================================================
# PHẦN 2: LỰA CHỌN WEBSITE ĐỂ QUÉT
# ==============================================================================
NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  if [[ -f "/etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress" ]]; then
    . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
    lua_chon_NAME "kiểm tra mã độc"
  else
    echo -e "${C_RED}❌ Lỗi: Không tìm thấy thư viện chọn tên miền.${C_RESET}"
    exit 1
  fi
fi

DOMAINS=()
SCAN_ALL=0

if [[ "$NAME" == 'Tất cả website' ]]; then
  echo -e "${C_YELLOW}ĐANG KÍCH HOẠT QUÉT DIỆN RỘNG TOÀN BỘ WEBSITE...${C_RESET}\n"
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" != ?*.?* ]]; then continue; fi
    
    path_html="/usr/local/lsws/$domain/html"
    if [[ -d "$path_html" ]]; then
      DOMAINS+=("$domain")
    fi
  done
  SCAN_ALL=1
else
  if [[ "$NAME" == "0" ]]; then
    [[ -f "/etc/wptt/wptt-bao-mat-main" ]] && exec /etc/wptt/wptt-bao-mat-main 1
    exit 0
  fi
  if [[ ! -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy cấu hình website $NAME${C_RESET}"
    sleep 2
    [[ -f "/etc/wptt/wptt-bao-mat-main" ]] && exec /etc/wptt/wptt-bao-mat-main 1
    exit 0
  fi
  DOMAINS+=("$NAME")
fi

RESULT_HITS=()
RESULT_DETAILS=()

# ==============================================================================
# PHẦN 3: VÒNG LẶP QUÉT TỪNG WEBSITE (SMART EXCLUDE + RUNUSER)
# ==============================================================================
for i in "${!DOMAINS[@]}"; do
  CURRENT_DOMAIN="${DOMAINS[$i]}"
  PATH_SCAN="/usr/local/lsws/$CURRENT_DOMAIN/html"
  DIR_SIZE=$(du -sh "$PATH_SCAN" 2>/dev/null | cut -f1)

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  left_text "  Tiến trình : ${C_BOLD_WHITE}Đang xử lý Website $CURRENT_DOMAIN${C_RESET}" 2
  left_text "  Dung lượng : ${C_YELLOW}$DIR_SIZE${C_RESET}" 2
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  if ! . /etc/wptt/php/php-cli-domain-config "$CURRENT_DOMAIN"; then
    wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $CURRENT_DOMAIN"
    _runloi "Lỗi: Không xác định được phiên bản PHP của website này."
    continue
  fi
  
  WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

  TEMP_OUT=$(mktemp -p /etc/wptt/tmp)
  TEMP_ERR=$(mktemp -p /etc/wptt/tmp)
  SCAN_LIST=$(mktemp -p /etc/wptt/tmp)
  EXCLUDE_LIST=$(mktemp -p /etc/wptt/tmp)

  cleanup_process() {
    echo -e "\n\n${C_RED} NHẬN TÍN HIỆU HỦY! Đang dừng tiến trình quét YARA...${C_RESET}"
    pkill -P "$YARA_SHELL_PID" 2>/dev/null
    kill -9 "$YARA_SHELL_PID" 2>/dev/null
    rm -f "${TEMP_OUT:?}" "${TEMP_ERR:?}" "${SCAN_LIST:?}" "${EXCLUDE_LIST:?}" "${SCAN_LIST:?}.final" 2>/dev/null
    tput cnorm
    stty sane
    echo "Quay trở về menu Bảo mật..."
    exec /etc/wptt/wptt-bao-mat-main 1
  }
  trap cleanup_process SIGINT SIGTERM

  # ==============================================================================
  # 3.1: KHỞI ĐỘNG SMART EXCLUDE FILTER (Explicit Whitelist & L10n Fix)
  # ==============================================================================
  find "$PATH_SCAN" -type f ! -iregex '.*\.\(jpg\|jpeg\|png\|gif\|svg\|webp\|mp4\|mp3\|woff\|woff2\|ttf\|eot\|otf\|css\|js\|txt\|md\)$' > "$SCAN_LIST"
  TOTAL_FILES_RAW=$(wc -l < "$SCAN_LIST")

  if "${WP_EXEC[@]}" core is-installed --path="$PATH_SCAN" --quiet 2>/dev/null; then
    echo -e "  ${C_CYAN}➜ Kích hoạt bộ lọc Smart Exclude (WP-CLI)...${C_RESET}"
    
    WP_ROOT_FILES=(
      "index.php" "wp-activate.php" "wp-blog-header.php" "wp-comments-post.php"
      "wp-config-sample.php" "wp-cron.php" "wp-links-opml.php" "wp-load.php"
      "wp-login.php" "wp-mail.php" "wp-settings.php" "wp-signup.php"
      "wp-trackback.php" "xmlrpc.php" "readme.html" "license.txt"
    )

    echo -en "    - Đối chiếu checksum Core (Mã nguồn)... "
    if "${WP_EXEC[@]}" core verify-checksums --path="$PATH_SCAN" --quiet 2>/dev/null; then
        find "$PATH_SCAN/wp-admin" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        find "$PATH_SCAN/wp-includes" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        for f in "${WP_ROOT_FILES[@]}"; do
            [[ -f "$PATH_SCAN/$f" ]] && echo "$PATH_SCAN/$f" >> "$EXCLUDE_LIST"
        done
    else
        "${WP_EXEC[@]}" core verify-checksums --path="$PATH_SCAN" 2>&1 | grep "verify against checksum" | awk '{print $NF}' > "/etc/wptt/tmp/bad_core_$$.txt"
        find "$PATH_SCAN/wp-admin" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        find "$PATH_SCAN/wp-includes" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        for f in "${WP_ROOT_FILES[@]}"; do
            [[ -f "$PATH_SCAN/$f" ]] && echo "$PATH_SCAN/$f" >> "$EXCLUDE_LIST"
        done
        while read -r bad_file; do
            sed -i "|^$PATH_SCAN/$bad_file$|d" "$EXCLUDE_LIST"
        done < "/etc/wptt/tmp/bad_core_$$.txt" ; rm -f "/etc/wptt/tmp/bad_core_$$.txt"
    fi
    echo -e "${C_GREEN}Hoàn tất${C_RESET}"

    echo -en "    - Đối chiếu file ngôn ngữ (Translations)... "
    find "$PATH_SCAN/wp-content" -type f -name "*.l10n.php" >> "$EXCLUDE_LIST" 2>/dev/null
    echo -e "${C_GREEN}Hoàn tất${C_RESET}"

    echo -en "    - Đối chiếu checksum Plugins... "
    for p in $("${WP_EXEC[@]}" plugin list --field=name --path="$PATH_SCAN" 2>/dev/null); do
        if "${WP_EXEC[@]}" plugin verify-checksums "$p" --path="$PATH_SCAN" --quiet 2>/dev/null; then
            find "$PATH_SCAN/wp-content/plugins/$p" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        fi
    done
    echo -e "${C_GREEN}Hoàn tất${C_RESET}"

    echo -en "    - Đối chiếu checksum Themes... "
    for t in $("${WP_EXEC[@]}" theme list --field=name --path="$PATH_SCAN" 2>/dev/null); do
        if "${WP_EXEC[@]}" theme verify-checksums "$t" --path="$PATH_SCAN" --quiet 2>/dev/null; then
            find "$PATH_SCAN/wp-content/themes/$t" -type f >> "$EXCLUDE_LIST" 2>/dev/null
        fi
    done
    echo -e "${C_GREEN}Hoàn tất${C_RESET}"

    if [ -s "$EXCLUDE_LIST" ]; then
        grep -vFxf "$EXCLUDE_LIST" "$SCAN_LIST" > "${SCAN_LIST}.final"
    else
        cp "$SCAN_LIST" "${SCAN_LIST}.final"
    fi

  else
    echo -e "  ${C_YELLOW}➜ Cảnh báo: Không thể kết nối WP-CLI, chuyển sang chế độ Quét toàn diện.${C_RESET}"
    cp "$SCAN_LIST" "${SCAN_LIST}.final"
  fi

  TOTAL_SCAN=$(wc -l < "${SCAN_LIST}.final")
  echo -e "  ${C_GREEN}✔ Tối ưu thành công: Đã bỏ qua các tệp an toàn. Tiến hành rà soát ${C_YELLOW}$TOTAL_SCAN / $TOTAL_FILES_RAW${C_GREEN} tệp tin nghi vấn.${C_RESET}"

  # ==============================================================================
  # 3.2: THỰC THI YARA (ĐA LUỒNG + ƯU TIÊN TÀI NGUYÊN THẤP NHẤT)
  # ==============================================================================
  ( cat "${SCAN_LIST}.final" | tr '\n' '\0' | nice -n 19 ionice -c 3 xargs -0 -P 4 -I {} yara -w -d filepath="{}" "$YARA_RULE_FILE" "{}" ) > "$TEMP_OUT" 2> "$TEMP_ERR" &
  YARA_SHELL_PID=$!

  tput civis
  spin='-\|/'
  spinner_idx=0
  while kill -0 "$YARA_SHELL_PID" 2>/dev/null; do
    spinner_idx=$(((spinner_idx + 1) % 4))
    echo -en "\r  ${C_CYAN} Đang phân tích YARA đa luồng... ${C_RESET}${spin:$spinner_idx:1} "
    sleep 0.15
  done
  echo -en "\r\033[K" 
  tput cnorm
  trap - SIGINT SIGTERM

  scan_output=$(awk 'NF>=2 && $2 ~ /^\// {print}' "$TEMP_OUT")

  if [[ -s "$TEMP_ERR" ]]; then
    wptt_logs "WARN" "YARA diagnostics khi quét $CURRENT_DOMAIN ($(wc -l < "$TEMP_ERR") dòng): $(head -c 500 "$TEMP_ERR")"
  fi

  rm -f "${TEMP_OUT:?}" "${TEMP_ERR:?}" "${SCAN_LIST:?}" "${EXCLUDE_LIST:?}" "${SCAN_LIST:?}.final" 2>/dev/null

  if [[ -n "$scan_output" ]]; then
    TOTAL_HITS=$(echo "$scan_output" | wc -l)
  else
    TOTAL_HITS=0
  fi

  RESULT_HITS+=("$TOTAL_HITS")
  RESULT_DETAILS+=("$scan_output")

  if [[ "$TOTAL_HITS" -eq 0 ]]; then
    echo -e "  ${C_GREEN}✔ Website Sạch Sẽ: Không phát hiện hành vi mã độc cấp độ cao.${C_RESET}"
  else
    echo -e "  ${C_RED}CẢNH BÁO BẢO MẬT: Phát hiện $TOTAL_HITS dấu hiệu nghi ngờ!${C_RESET}"
    echo -e "  ${C_YELLOW}Chi tiết phân tích mã độc (Gom nhóm theo tệp tin):${C_RESET}"
    
    echo "$scan_output" | awk '{rules[$2] = rules[$2] (rules[$2]? ", ": "") $1} END {for (file in rules) print file "|" rules[file]}' | while IFS="|" read -r file_path rule_list; do
      short_path=$(echo "$file_path" | sed "s|/usr/local/lsws/$CURRENT_DOMAIN/html|.../html|g")
      echo -e "   ${C_CYAN}➜ File: ${C_RESET}${short_path}"
      
      IFS=',' read -ra rule_array <<< "$rule_list"
      for rule in "${rule_array[@]}"; do
        clean_rule=$(echo "$rule" | xargs)
        echo -e "      ${C_RED}☠ Nhận diện: ${C_RESET}${clean_rule}"
      done
    done
  fi
done

# ==============================================================================
# PHẦN 4: BẢNG TỔNG KẾT
# ==============================================================================
# Hàm hỗ trợ padding chuỗi UTF-8 hiển thị hoàn hảo trên giao diện Terminal
pad_string() {
  local str="$1"
  local width="$2"
  local len=${#str}
  local pad=$(( width - len ))
  echo -n "$str"
  if [[ $pad -gt 0 ]]; then
    printf '%*s' "$pad" ""
  fi
}

# ==============================================================================
# PHẦN 4: BẢNG TỔNG KẾT
# ==============================================================================
if [[ "$SCAN_ALL" -eq 1 ]]; then
	print_border_top
  center_text "${C_BOLD_WHITE}TỔNG KẾT QUÉT MÃ ĐỘC YARA TOÀN BỘ WEBSITE${C_RESET}"
	print_border_bot
  INFECTED_COUNT=0
  for i in "${!DOMAINS[@]}"; do
    domain="${DOMAINS[$i]}"
    hits="${RESULT_HITS[$i]}"

    if [[ "$hits" -eq 0 ]]; then
      status="${C_GREEN}An Toàn${C_RESET}"
      hits_disp="${C_GREEN}0${C_RESET}"
      action="${C_GREEN}Tốt${C_RESET}"
    else
      status="${C_RED}Nghi vấn!${C_RESET}"
      hits_disp="${C_RED}${hits}${C_RESET}"
      action="${C_YELLOW}Kiểm tra${C_RESET}"
      ((INFECTED_COUNT++))
    fi

    echo -e " ➜ ${C_BOLD_WHITE}${domain}${C_RESET}"
    echo -e "    Trạng thái: ${status}  |  Cảnh báo: ${hits_disp}  |  Đánh giá: ${action}"
    echo -e "${C_CYAN}------------------------------------------------------------------------------${C_RESET}"
  done

  if [[ "$INFECTED_COUNT" -gt 0 ]]; then
    echo -e "   Cảnh báo: Có ${C_RED}$INFECTED_COUNT website${C_RESET} trên hệ thống có dấu hiệu khả nghi. Vui lòng kiểm tra log!\n"
  else
    echo -e "   Tuyệt vời! ${C_GREEN}Toàn bộ các website trên máy chủ đều vượt qua bài kiểm tra hành vi 100%.${C_RESET}\n"
  fi
fi

check_menu_wptangtoc_active=$1
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wptt-bao-mat-main 1
fi
