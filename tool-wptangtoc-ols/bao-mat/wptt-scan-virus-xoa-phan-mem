#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng này giúp bạn gỡ bỏ hoàn toàn YARA Engine và các bộ luật [Rules] nhận diện mã độc khỏi hệ thống.
  Dù YARA cực kỳ nhẹ và không chạy ngầm, nhưng nếu bạn không còn nhu cầu quét mã độc trên máy chủ, bạn có thể gỡ cài đặt để làm sạch hoàn toàn hệ thống.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện UX Bo Cong

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BẢO MẬT ➜ Gỡ bỏ Công cụ Rà Quét Mã Độc (YARA Engine)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "${1:-}" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-bao-mat-main 1"
fi

# ==============================================================================
# KIỂM TRA TRẠNG THÁI CÀI ĐẶT
# ==============================================================================
if ! command -v yara >/dev/null 2>&1 ; then
  echo -e "${C_YELLOW}THÔNG BÁO: Máy chủ của bạn chưa cài đặt (hoặc đã gỡ) YARA Engine!${C_RESET}\n"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
  exit 0
fi

if ! wptt_xac_nhan "BẠN CÓ CHẮC CHẮN MUỐN GỠ CÀI ĐẶT YARA ENGINE?" \
  "Hành động này sẽ xóa lõi quét YARA và toàn bộ" \
  "tập luật (Rules) nhận diện mã độc WordPress độc quyền." \
  "Đồng ý GỠ CÀI ĐẶT" "Hủy thao tác"; then
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
  exit 0
fi

echo ""

# ==============================================================================
# NHẬN DIỆN HỆ ĐIỀU HÀNH
# ==============================================================================
if grep -qi "ubuntu" /etc/*release 2>/dev/null || grep -qi "debian" /etc/*release 2>/dev/null; then
  OS_TYPE="debian"
else
  OS_TYPE="rhel"
fi

# ==============================================================================
# BƯỚC 1: GỠ BỎ LÕI YARA BẰNG TRÌNH QUẢN LÝ GÓI
# ==============================================================================
_runing "Bước 1/2: Đang gỡ bỏ lõi YARA Engine..."
if [[ "$OS_TYPE" == "rhel" ]]; then
  # Dùng dnf/yum để gỡ sạch sẽ
  dnf remove yara -y -q >/dev/null 2>&1
elif [[ "$OS_TYPE" == "debian" ]]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get remove --purge yara -y -q >/dev/null 2>&1
  apt-get autoremove -y -q >/dev/null 2>&1
fi
_rundone "Đã gỡ bỏ lõi YARA thành công"


echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ YARA ENGINE${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Hệ thống đã được làm sạch hoàn toàn 100%." 2
left_text "Không còn lệnh thực thi hay tệp tin nào của YARA tồn tại." 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
