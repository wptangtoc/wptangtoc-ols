function huong_dan() {
  Kích hoạt hoặc huỷ kích hoạt open_basedir để nâng cao bảo mật PHP để giảm thiểu tối đa việc 1 website bị hack, nó lây ra website còn lại.

  open_basedir là đóng phân vùng hoạt động của PHP

  Mục đích chính của open_basedir:

  * Tăng cường bảo mật: Đây là mục đích cốt lõi. Bằng cách giới hạn phạm vi truy cập tệp tin, open_basedir giúp ngăn chặn các script PHP [đặc biệt là khi website bị tấn công hoặc chứa mã độc] truy cập, đọc hoặc ghi vào các tệp tin nhạy cảm nằm ngoài thư mục gốc của website đó. Điều này đặc biệt hữu ích trong môi trường hosting chia sẻ, nơi nhiều website cùng hoạt động trên một máy chủ. Nếu một website bị xâm nhập, open_basedir sẽ giúp hạn chế khả năng mã độc lây lan sang các website khác hoặc truy cập vào các tệp tin hệ thống của máy chủ.
  * Kiểm soát môi trường thực thi của PHP: Nó giúp quản trị viên máy chủ định rõ những khu vực nào trên hệ thống tệp mà các kịch bản PHP được phép tương tác.

  Thường anh em sử dụng plugin backup như duplicator hay backupbuddy sẽ bị lỗi.. nếu bạn không sử dụng plugin thì hãy nên bật tính năng này.
  Ghi chú: khi bật có thể bị lỗi một số tính năng bạn vui lòng kiểm tra kỹ trước khi triển khai.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${bao_mat} ➜ Bật / Tắt open_basedir PHP${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE CÓ HIỂN THỊ TRẠNG THÁI OPEN_BASEDIR
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -At /etc/wptt/vhost 2>/dev/null | grep -v '^\.\.conf$' | sort -uV)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        local vhost_path="/usr/local/lsws/conf/vhosts/$domain/$domain.conf"
        if [[ -f "$vhost_path" ]]; then
          local status_text=""
          local status_color=""

          # Kiểm tra xem open_basedir có đang bật không
          if grep -q 'open_basedir' "$vhost_path" 2>/dev/null; then
            status_text="[Đang BẬT - An toàn]"
            status_color=$C_GREEN
          else
            status_text="[Đang TẮT - Chưa bảo vệ]"
            status_color=$C_RED
          fi

          selects+=("$domain|$status_text|$status_color")
        fi
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}Lỗi: Không tìm thấy website nào trên hệ thống!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Trạng thái hiện tại & Chọn Website muốn thao tác:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      # Giao diện cắt lớp cho tùy chọn cuối cùng (Đồng loạt)
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Bật / Tắt open_basedir cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Bật / Tắt open_basedir cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      # Dòng website bình thường
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # Dòng nhắc lệnh (Prompt) siêu sạch
  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0) exec /etc/wptt/wptt-bao-mat-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ truyền đối số cho 1 domain cụ thể
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  
  # NẾU DÙNG CLI ĐỐI SỐ -> BỎ QUA HỎI ĐÁP
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="BẬT"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="TẮT"
  else
    # NẾU CHỌN TỪ MENU UI (SỐ TÙY CHỌN CUỐI CÙNG) -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH OPEN_BASEDIR${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác cấu hình bảo mật open_basedir cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT open_basedir (Bảo vệ an toàn đồng loạt)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT open_basedir${C_RESET} (Bảo vệ an toàn đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) TẮT open_basedir (Gỡ bỏ bảo vệ đồng loạt)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT open_basedir${C_RESET} (Gỡ bỏ bảo vệ đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice
    
    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="BẬT"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="TẮT"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi

  # Quét toàn bộ danh sách domain để thực thi
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/conf/vhosts/$domain/$domain.conf" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

  [[ ! -f "$vhost_conf" ]] && echo -e "\n${C_RED}Tên miền không tồn tại trên hệ thống này${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-bao-mat-main 1

  DOMAIN_LIST=("$NAME")

  # NẾU TRUYỀN CLI_MODE -> BỎ QUA BOX UI
  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "bat" ]]; then
      action_text="BẬT"
    else
      action_text="TẮT"
    fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH OPEN_BASEDIR${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if grep -q 'open_basedir' "$vhost_conf" 2>/dev/null; then
      left_text "  Website ${NAME} hiện ĐANG BẬT bảo vệ open_basedir." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) TẮT open_basedir (Gỡ bỏ bảo vệ - Không khuyến nghị)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT open_basedir${C_RESET} (Gỡ bỏ bảo vệ - Không khuyến nghị)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên khóa bảo vệ)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên khóa bảo vệ)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="tat"
        action_text="TẮT"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
      fi
    else
      left_text "  Website ${NAME} hiện ĐANG TẮT open_basedir (Kém an toàn)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) BẬT open_basedir (Kích hoạt bảo vệ giới hạn an toàn)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT open_basedir${C_RESET} (Kích hoạt bảo vệ giới hạn an toàn)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="bat"
        action_text="BẬT"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# THỰC THI SỬA FILE CẤU HÌNH VHOST
# ==============================================================================
echo ""
for DOMAIN in "${DOMAIN_LIST[@]}"; do
  vhost_conf="/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf"
  [[ ! -f "$vhost_conf" ]] && continue
  
  _runing "$action_text bảo mật open_basedir cho $DOMAIN..."
  
  ALLOWED_PATHS="/usr/local/lsws/$DOMAIN:/tmp:/var/run/redis:/var/run/memcached:/var/run/valkey:/var/run/keydb"
  has_root_php_override=$(grep -c '^phpIniOverride' "$vhost_conf")

  if [[ "$wp_action" == "bat" ]]; then
    if ! grep -q 'open_basedir' "$vhost_conf" 2>/dev/null; then
      if [[ $has_root_php_override -gt 0 ]]; then
        # Tiêm vào khối phpIniOverride hiện có
        sed -i "/^phpIniOverride/a \  php_admin_value open_basedir \"$ALLOWED_PATHS\"" "$vhost_conf"
      else
        # Nếu chưa có, tự tạo khối mới
        echo -e "\nphpIniOverride  {\n  php_admin_value open_basedir \"$ALLOWED_PATHS\"\n}" >>"$vhost_conf"
      fi
    fi
  else
    if grep -q 'open_basedir' "$vhost_conf" 2>/dev/null; then
      # Xóa dòng open_basedir
      sed -i '/open_basedir/d' "$vhost_conf"
      # Xóa khối phpIniOverride nếu rỗng
      sed -i '/^phpIniOverride[[:space:]]*{/{:a; /}/!{N; ba;}; /^phpIniOverride[[:space:]]*{[[:space:]\n]*}$/d}' "$vhost_conf"
    fi
  fi

  echo "$action_text open_basedir website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text open_basedir cho $DOMAIN"
done

# ==============================================================================
# RELOAD LITESPEED ĐỂ ÁP DỤNG CẤU HÌNH
# ==============================================================================
wptt_smart_reload_lsws >/dev/null 2>&1

if [[ ${1:-} == "98" ]]; then
  exec /etc/wptt/wptt-bao-mat-main 1
fi
