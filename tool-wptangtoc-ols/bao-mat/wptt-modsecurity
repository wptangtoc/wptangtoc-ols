#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
    cat << 'EOF'
  Kích hoạt/Hủy kích hoạt Modsecurity.

  ModSecurity là một tường lửa ứng dụng web [Web Application Firewall - WAF] mã nguồn mở, đa nền tảng, được sử dụng rộng rãi. Nó hoạt động như một module cho các máy chủ web như Apache, Nginx và IIS, LiteSpeed.

  Mục đích chính của ModSecurity là bảo vệ các ứng dụng web khỏi một loạt các cuộc tấn công mạng, bao gồm:
  * SQL Injection [SQLi]: Kẻ tấn công chèn mã SQL độc hại vào các truy vấn để thao túng cơ sở dữ liệu.
  * Cross-Site Scripting [XSS]: Kẻ tấn công chèn mã độc JavaScript vào các trang web mà người dùng khác sẽ xem.
  * Local File Inclusion [LFI] / Remote File Inclusion [RFI]: Kẻ tấn công lừa ứng dụng web thực thi hoặc hiển thị các tệp tin không mong muốn trên máy chủ hoặc từ xa.
  * Session Hijacking: Kẻ tấn công chiếm đoạt phiên làm việc hợp lệ của người dùng.
  * Command Injection: Kẻ tấn công thực thi các lệnh tùy ý trên hệ điều hành của máy chủ.
  * Denial of Service [DoS] ở tầng ứng dụng: Các cuộc tấn công làm cạn kiệt tài nguyên của ứng dụng web.
  Và nhiều loại lỗ hổng và tấn công khác.

  Ghi chú: Khi kích hoạt ModSecurity sẽ làm giảm khá khá hiệu suất tốc độ của website do máy chủ phải phân tích sâu từng gói tin.
EOF
}


. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${bao_mat:-Bảo mật} ➜ Bật / Tắt Tường lửa ModSecurity (WAF)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

config_file="/usr/local/lsws/conf/httpd_config.conf"
path_owasp="/usr/local/lsws/modsec/owasp"

mkdir -p /usr/local/lsws/conf/
touch "$config_file"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI HIỆN TẠI
# ==============================================================================
is_modsec_active=0
if grep -q 'module mod_security' "$config_file" 2>/dev/null; then
  is_modsec_active=1
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
if [[ $is_modsec_active -eq 1 ]]; then
  left_text "Trạng thái WAF : ${C_GREEN}ĐANG BẬT (Active)${C_RESET}" 2
  left_text "Bộ quy tắc     : OWASP Core Rule Set (v4.30.0 - Optimized for PHP/Linux)" 2
else
  left_text "Trạng thái WAF : ${C_YELLOW}ĐANG TẮT (Inactive)${C_RESET}" 2
fi
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "ModSecurity là tường lửa cấp ứng dụng, giúp chặn đứng SQL Injection," 2
left_text "XSS, và hàng loạt rủi ro bảo mật khác trên toàn bộ Server." 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# NHÁNH 1: BẬT WAF (ENTERPRISE ATOMIC DEPLOYMENT)
# ==============================================================================
if [[ $is_modsec_active -eq 0 ]]; then
  if wptt_xac_nhan "Bạn có muốn KÍCH HOẠT Tường lửa ModSecurity không?" "LƯU Ý: ModSecurity kiểm tra sâu từng gói tin, do đó nó sẽ" "tiêu thụ thêm một phần tài nguyên CPU và làm web chậm hơn đôi chút." "Đồng ý BẬT WAF" "Hủy thao tác"; then
    echo ""

    _runing "Đang tải và xác thực OWASP Core Rule Set v4.30.0..."
    TMP_DIR=$(mktemp -d /etc/wptt/tmp/wptt_waf_XXXXXX)
    cd "$TMP_DIR" || exit 1

    if ! wget -qO master.zip --timeout=15 --tries=3 "https://github.com/coreruleset/coreruleset/archive/v4.30.0/master.zip"; then
       _runloi "Tải xuống thất bại! Vui lòng kiểm tra lại kết nối mạng."
       rm -rf "$TMP_DIR"
       [[ -z "$BATS_VERSION" && "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
       exit 1
    fi
    
    if ! unzip -tq master.zip >/dev/null 2>&1; then
       _runloi "File mã nguồn WAF bị hỏng. Hủy tiến trình!"
       rm -rf "$TMP_DIR"
       exit 1
    fi
    _rundone "Tải xuống và xác thực OWASP thành công"

    _runing "Đang thiết lập và nạp quy tắc bảo mật động (Dynamic Include)..."
    unzip -oq master.zip
    
    extracted_dir=$(find . -maxdepth 1 -type d -name "coreruleset*" | head -n 1)
    mv "$extracted_dir" crs30
    rm -f master.zip

    mv crs30/crs-setup.conf.example crs30/crs-setup.conf
    mv crs30/rules/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf.example crs30/rules/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf
    mv crs30/rules/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf.example crs30/rules/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf

    # ==========================================================================
    # [TỐI ƯU HIỆU NĂNG] Lọc bỏ các quy tắc không thuộc hệ sinh thái Linux + PHP + WordPress
    # ==========================================================================
    rm -f crs30/rules/*JAVA*.conf 2>/dev/null
    rm -f crs30/rules/*NODEJS*.conf 2>/dev/null
    rm -f crs30/rules/*IIS*.conf 2>/dev/null
    rm -f crs30/rules/*WINDOWS*.conf 2>/dev/null
    rm -f crs30/rules/*RUBY*.conf 2>/dev/null
    rm -f crs30/rules/*PYTHON*.conf 2>/dev/null
    
    master_conf="crs30/owasp-master.conf"
    echo "include /usr/local/lsws/modsec/owasp/crs30/crs-setup.conf" > "$master_conf"
    
    for rule_file in crs30/rules/*.conf; do
        # Phòng hờ trường hợp thư mục rỗng, Bash sẽ trả về chuỗi literal '*.conf'
        [[ -e "$rule_file" ]] || continue
        
        # Lấy tên file (Dùng tính năng xử lý chuỗi tích hợp của Bash thay vì gọi lệnh basename bên ngoài để tối ưu tốc độ)
        filename="${rule_file##*/}"
        
        echo "include /usr/local/lsws/modsec/owasp/crs30/rules/$filename" >> "$master_conf"
    done
    
    rm -rf "${path_owasp:?}"
    mkdir -p "$path_owasp"
    mv crs30 "$path_owasp/"
		cd / || exit 1
    rm -rf "${TMP_DIR:?}"
    _rundone "Thiết lập Core Rule Set hoàn tất"

    _runing "Đang tích hợp ModSecurity vào OpenLiteSpeed..."
    sed -i '/^[[:space:]]*module mod_security/,/^[[:space:]]*}/d' "$config_file" 2>/dev/null
    
    cat <<EOF >>"$config_file"

module mod_security {
  modsecurity  on
  modsecurity_rules \`
    SecRuleEngine On
  \`
  modsecurity_rules_file         /usr/local/lsws/modsec/owasp/crs30/owasp-master.conf
}
EOF
    wptt_smart_reload_lsws >/dev/null 2>&1
    wptt_logs "INFO" "Kích hoạt ModSecurity"
    _rundone "Cập nhật Server Core thành công"

    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT KÍCH HOẠT TƯỜNG LỬA WAF${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Máy chủ đã được bảo vệ bởi tập luật tự động nhận diện mới nhất." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  else
    echo -e "${C_YELLOW}Đã hủy thao tác kích hoạt WAF.${C_RESET}\n"
  fi

# ==============================================================================
# NHÁNH 2: TẮT WAF
# ==============================================================================
else
  if wptt_xac_nhan "Bạn có CHẮC CHẮN muốn TẮT Tường lửa ModSecurity không?" "Việc tắt WAF sẽ giải phóng RAM & CPU, tăng tốc xử lý nhưng" "máy chủ sẽ mất lớp khiên chống SQLi/XSS ở tầng ứng dụng." "Đồng ý TẮT WAF" "Hủy thao tác"; then
    echo ""

    _runing "Đang dọn dẹp thư mục cấu hình Rule Set..."
    rm -rf "${path_owasp:?}"
    _rundone "Dọn dẹp thư mục cấu hình Rule Set hoàn tất"

    _runing "Đang gỡ bỏ cấu hình ModSecurity khỏi OpenLiteSpeed..."
    sed -i '/^[[:space:]]*module mod_security/,/^[[:space:]]*}/d' "$config_file"

    wptt_smart_reload_lsws >/dev/null 2>&1
    wptt_logs "INFO" "Tắt ModSecurity"
    _rundone "Gỡ bỏ cấu hình ModSecurity khỏi OpenLiteSpeed thành công"

    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ TƯỜNG LỬA WAF${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Tường lửa ModSecurity đã được TẮT hoàn toàn. Máy chủ của bạn" 2
    left_text "sẽ hoạt động với tốc độ và hiệu suất tối đa (Raw Performance)." 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  else
    echo -e "${C_YELLOW}Đã hủy thao tác tắt WAF.${C_RESET}\n"
  fi
fi

[[ -z "$BATS_VERSION" && "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
exit 0
