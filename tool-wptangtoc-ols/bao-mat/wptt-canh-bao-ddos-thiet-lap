function huong_dan() {
  Tính năng Chống DDoS [WPTangToc OLS] sử dụng Fail2ban:
  🛡️ Mục đích:
  Tự động phát hiện và chặn các địa chỉ IP có dấu hiệu truy cập bất thường, đặc biệt là nhắm vào các nội dung động [dynamic content] - những nội dung tốn nhiều tài nguyên xử lý của máy chủ [như PHP, cơ sở dữ liệu].

  ⚙️ Quy tắc hoạt động cụ thể:
  * Công cụ: Sử dụng Fail2ban, một phần mềm giám sát log và chặn IP.
  * Điều kiện Kích hoạt [Trigger]: Nếu một địa chỉ IP thực hiện 20 yêu cầu [requests] đến các tệp tin động [html document] trong vòng 30 giây.
  * Hành động [Action]: Ngay lập tức, Fail2ban sẽ ra lệnh cho tường lửa chặn [block] địa chỉ IP đó trong vòng 2 tiếng.

  Bạn có thể dễ dàng Bật/Tắt tính năng này cho từng website hoặc tất cả website bằng 1 cú chạm.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BẢO MẬT ➜ Bật / Tắt Chống DDoS Website (Fail2ban)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# HÀM MENU LỌC THÔNG MINH (CÓ TRẠNG THÁI + FZF) - CHUẨN UX 78PX
# ==============================================================================
function lua_chon_NAME() {
  unset NAME domain selects
  selects=()
  local i=1

  # Vòng lặp Globbing siêu tốc không qua sub-shell
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    local domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
      local domain_fail2ban="${domain//[-._]/wp}"
      local filter_path="/etc/fail2ban/filter.d/ddos-$domain_fail2ban.conf"
      
      local status_text=""
      local status_color=""

      if [[ -f "$filter_path" ]]; then
        status_text="[Đang BẬT]"
        status_color=$C_GREEN
      else
        status_text="[Đang TẮT]"
        status_color=$C_RED
      fi
      selects+=("$domain|$status_text|$status_color")
    fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Không có website nào hợp lệ trên hệ thống để cấu hình!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  # Sắp xếp mảng chuẩn Version (Alphabetical)
  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Nhập lựa chọn website cấu hình Chống DDoS:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      # Giao diện cắt lớp cho tùy chọn cuối cùng (Đồng loạt)
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Bật / Tắt DDoS cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Bật / Tắt DDoS cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      # Dòng website bình thường
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # Dòng nhắc lệnh (Prompt) siêu sạch
  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Tìm Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-bao-mat-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm nhanh >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# Nếu gọi script kèm tên domain từ command line
if [[ -n "$1" && "$1" != "98" ]]; then
  NAME="$1"
else
  lua_chon_NAME
fi

# Tách lấy tên chuẩn (Cắt bỏ dòng trạng thái nếu có lọt qua)
NAME=$(echo "$NAME" | cut -f1 -d ' ')

# --- CHỐT CHẶN THOÁT HIỂM ---
[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt/wptt-bao-mat-main 1

# ==============================================================================
# HÀM CÀI ĐẶT GÓI PHỤ THUỘC (Chạy 1 lần duy nhất)
# ==============================================================================
function install_dependencies() {
  if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
    if ! dpkg -s python3-pyinotify ipset >/dev/null 2>&1; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get update >/dev/null 2>&1
      apt-get install -y python3-pyinotify ipset >/dev/null 2>&1
    fi
    tuong_thich_nhom_litespeed="nogroup"
  else
    if ! rpm -q python3-inotify ipset >/dev/null 2>&1; then
      dnf install -y python3-inotify ipset >/dev/null 2>&1
    fi
    tuong_thich_nhom_litespeed="nobody"
  fi
}

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

# ==============================================================================
# HÀM THỰC THI BẬT/TẮT CHỐNG DDOS CHO 1 DOMAIN
# ==============================================================================
function process_ddos() {
  local target_domain=$1
  local action=$2 # "bat" hoac "tat"
  local domain_fail2ban="${target_domain//[-._]/wp}"
  local filter_path="/etc/fail2ban/filter.d/ddos-$domain_fail2ban.conf"
  local vhost_conf="/usr/local/lsws/conf/vhosts/$target_domain/$target_domain.conf"

  if [[ "$action" == "bat" ]]; then
    [[ -f "$filter_path" ]] && return # Đã bật rồi thì bỏ qua

    UI_STRING="Kích hoạt Chống DDoS (Fail2ban) cho $target_domain"
    _runing "$UI_STRING"

    # Kiểm tra Cloudflare CDN (Chống khóa nhầm IP Cloudflare)
    local TRACE_OUTPUT=$(curl -Is --connect-timeout 5 --max-time 10 "https://$target_domain/cdn-cgi/trace" 2>/dev/null)
	if echo "$TRACE_OUTPUT" | grep -qi 'cloudflare\|cf-ray'; then
		if ! grep -q '103.21.244.0' /usr/local/lsws/conf/httpd_config.conf 2>/dev/null; then
			echo -en "\033[1A\033[2K\r" #xoá dùng runing ở trên
			echo -e "\n\033[1;31m[CẢNH BÁO] Phát hiện $target_domain dùng Cloudflare CDN nhưng chưa bật Real IP!\033[0m"
			echo "Vui lòng bật tính năng Hiện thị IP Log Real bypass Cloudflare CDN trước khi dùng chức năng này để tránh chặn nhầm IP."
			if ! wptt_xac_nhan "Bạn có muốn kích hoạt tính năng Cloudflare Real IP không?" "Tính năng này để xác định đúng địa chi ip client" "Khi dùng cloudflare cdn" "Đồng ý kích hoạt" "Hủy thao tác"; then
				[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
				exit 0
			else
				_runing "Kích hoạt Cloudflare show real IP"
				. /etc/wptt/cloudflare-cdn-ip-show-real >/dev/null 2>&1
				_rundone "Kích hoạt Cloudflare show real IP"
			    _runing "$UI_STRING"
			fi
		fi
	fi

    # Tách log cho Vhost
    if ! grep -q 'accesslog' "$vhost_conf" 2>/dev/null; then
      sed -i '/^errorlog /,/^}$/d' "$vhost_conf"
      sed -i '/^accesslog /,/^}$/d' "$vhost_conf"
      cat <<EOF >>"$vhost_conf"

errorlog \$VH_ROOT/logs/error.log {
  useServer               1
  logLevel                ERROR
  rollingSize             10M
}

accesslog \$VH_ROOT/logs/access.log {
  useServer               0
  rollingSize             10M
  keepDays                30
  compressArchive         1
}
EOF
    fi

    mkdir -p "/usr/local/lsws/$target_domain/logs"
    chown -R nobody:$tuong_thich_nhom_litespeed "/usr/local/lsws/$target_domain/logs"
    chmod 700 "/usr/local/lsws/$target_domain/logs"

    # Tính toán biến Rule
    local rule_fail2ban_name="ddos-$domain_fail2ban"
    if ((${#rule_fail2ban_name} > 20)); then
      rule_fail2ban_name=$(echo "$rule_fail2ban_name" | cut -c 1-20)
    fi

    local action_thuc_thi_block=""
    if [[ -f /etc/csf/csf.conf ]]; then
      action_thuc_thi_block="iptables-multiport[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
          iptables-multiport[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
    elif [[ $(systemctl status nftables.service 2>/dev/null | grep -i 'Active' | grep -o 'active') == "active" ]]; then
      action_thuc_thi_block="nftables-allports[name=$rule_fail2ban_name]"
    elif [[ $(systemctl status firewalld.service 2>/dev/null | grep -i 'Active' | grep -o 'active') == "active" ]]; then
      action_thuc_thi_block="firewallcmd-ipset[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
          firewallcmd-ipset[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
    else
      action_thuc_thi_block="iptables-multiport[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
          iptables-multiport[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
    fi

    cat <<EOF >>"/etc/fail2ban/jail.local"

#begin-ddos-website-$domain_fail2ban
[$rule_fail2ban_name]
enabled = true
action = $action_thuc_thi_block
filter = ddos-$domain_fail2ban
logpath = /usr/local/lsws/$target_domain/logs/access.log
backend = pyinotify
bantime = 7200
maxretry = 20
findtime = 30
#end-ddos-website-$domain_fail2ban
EOF

    echo '[Definition]
failregex = ^<HOST> .* "(GET|POST|HEAD) .* HTTP\/.*"
ignoreregex = \.(?i)(robots\.txt|favicon\.ico|jpg|png|webp|css|js|jpeg|woff2|avif|gif|svg|woff|ttf)(\?.*)?$' >"$filter_path"

    echo "Bật Chống DDoS website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"

  elif [[ "$action" == "tat" ]]; then
    [[ ! -f "$filter_path" ]] && return # Chưa bật thì bỏ qua

    UI_STRING="Tắt (Hủy) Chống DDoS cho $target_domain"
    _runing "$UI_STRING"

    bat_log_domain=""
    [[ -f "/etc/wptt/vhost/.$target_domain.conf" ]] && . "/etc/wptt/vhost/.$target_domain.conf"

    if [[ -z "$bat_log_domain" ]]; then
      sed -i '/^errorlog /,/^}$/d' "$vhost_conf"
      sed -i '/^accesslog /,/^}$/d' "$vhost_conf"
      rm -rf "/usr/local/lsws/${target_domain:?}/logs"
    fi

    if [[ ! -d "/usr/local/lsws/logs" ]]; then
      mkdir -p /usr/local/lsws/logs
      chown root:nobody /usr/local/lsws/logs
    fi

    sed -i "/^#begin-ddos-website-$domain_fail2ban/,/^#end-ddos-website-$domain_fail2ban$/d" /etc/fail2ban/jail.local
    rm -f "${filter_path:?}"

    echo "Tắt Chống DDoS website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"
  fi
}

# ==============================================================================
# XỬ LÝ LÔGIC RẼ NHÁNH VÀ XÁC NHẬN BẰNG BOX UI
# ==============================================================================
echo ""

if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" ]]; then
  
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH CHỐNG DDOS${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Bạn đang thao tác cấu hình Fail2ban cho toàn bộ hệ thống." 2
  left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  
  str_opt1="  1) BẬT ĐỒNG LOẠT (Bật chống DDoS cho tất cả website)"
  pad_opt1=$((box_inner_width - ${#str_opt1}))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT ĐỒNG LOẠT${C_RESET} (Bật chống DDoS cho tất cả website)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
  
  str_opt2="  2) TẮT ĐỒNG LOẠT (Tắt chống DDoS trên tất cả website)"
  pad_opt2=$((box_inner_width - ${#str_opt2}))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT ĐỒNG LOẠT${C_RESET} (Tắt chống DDoS trên tất cả website)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
  
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
  read -r mass_choice
  
  mass_action=""
  if [[ "$mass_choice" == "1" ]]; then
    mass_action="bat"
  elif [[ "$mass_choice" == "2" ]]; then
    mass_action="tat"
  else
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  [[ "$mass_action" == "bat" ]] && install_dependencies

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* ]]; then
      process_ddos "$domain" "$mass_action"
    fi
  done

else
  pathcheck="/etc/wptt/vhost/.$NAME.conf"
  [[ ! -f "$pathcheck" ]] && {
    echo -e "\n${C_RED}❌ Tên miền không tồn tại!${C_RESET}"
    sleep 2
    exec /etc/wptt/wptt-bao-mat-main 1
  }

  domain_fail2ban="${NAME//[-._]/wp}"
  
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH CHỐNG DDOS (FAIL2BAN)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  
  if [[ -f "/etc/fail2ban/filter.d/ddos-$domain_fail2ban.conf" ]]; then
    left_text "  Website ${NAME} hiện ĐANG BẬT chế độ chống DDoS." 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) TẮT CHỐNG DDOS (Hủy theo dõi log và xóa quy tắc chặn)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT CHỐNG DDOS${C_RESET} (Hủy theo dõi log và xóa quy tắc chặn)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) Không làm gì cả (Giữ nguyên cấu hình)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên cấu hình)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r single_choice
    
    if [[ "$single_choice" == "1" ]]; then
      process_ddos "$NAME" "tat"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  else
    left_text "  Website ${NAME} hiện ĐANG TẮT chế độ chống DDoS." 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT CHỐNG DDOS (Chặn IP có dấu hiệu spam, truy cập ảo)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT CHỐNG DDOS${C_RESET} (Chặn IP có dấu hiệu spam, truy cập ảo)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) Không làm gì cả (Hủy thao tác)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r single_choice
    
    if [[ "$single_choice" == "1" ]]; then
      install_dependencies
      process_ddos "$NAME" "bat"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi
fi

