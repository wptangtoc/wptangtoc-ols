#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Chế độ Kernel Hardening Chống DDoS Tầng TCP/UDP/Conntrack (Tương thích ZRAM & Nftables)

function huong_dan() {
  cat <<'EOF'
  Tính năng Khiên Chống DDoS Tầng Kernel (Kernel Anti-DDoS Shield) giúp gia cố ngăn xếp mạng (Network Stack) của Linux để chống chịu các cuộc tấn công SYN Flood, ACK Flood, Slowloris và cạn kiệt bảng trạng thái Conntrack.

  Cơ chế hoạt động chuẩn Enterprise:
  * Khi BẬT: Hệ thống tạo file /etc/sysctl.d/99-z-wptangtoc-ddos.conf nạp đè lên 99-wptangtoc-ols.conf. Chỉ siết chặt tầng TCP/UDP/Conntrack mà vẫn giữ nguyên cấu hình ZRAM, Dirty Bytes và MariaDB AIO.
  * Khi TẮT: Hệ thống gỡ bỏ lớp cấu hình DDoS và khôi phục ngay lập tức về thông số Kernel tối ưu tốc độ tiêu chuẩn mà không cần khởi động lại VPS.
EOF
}

# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null || true
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null || true
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8 2>/dev/null || true

DDOS_SYSCTL_FILE="/etc/sysctl.d/99-z-wptangtoc-ddos.conf"

# 0. Xóa sạch file cấu hình cũ bị sai thứ tự bảng chữ cái (nếu còn sót từ bản cũ)
/bin/rm -f /etc/sysctl.d/101-sysctl.conf 2>/dev/null || true

# 1. Kiểm tra môi trường ảo hóa (OpenVZ cũ không cho phép can thiệp sysctl mạng)
if [[ -f /proc/user_beancounters || ! -d /etc/sysctl.d ]]; then
  echo -e "\n${C_YELLOW:-}⚠️ Môi trường ảo hóa container hạn chế quyền can thiệp Kernel Network.${C_RESET:-}"
  if declare -F wptt_quay_ve_menu >/dev/null; then
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi
  exit 0
fi

# 2. Tự động đo dung lượng RAM thực tế bằng Pure Bash (0-Subshell)
mem_total_kb=0
if [[ -r /proc/meminfo ]]; then
  while IFS=': ' read -r key val _; do
    if [[ "$key" == "MemTotal" && "$val" =~ ^[0-9]+$ ]]; then
      mem_total_kb="$val"
      break
    fi
  done </proc/meminfo
fi
mem_total_mb=$((mem_total_kb / 1024))
((mem_total_mb <= 0)) && mem_total_mb=1024

# 3. Phân tầng giới hạn Chống DDoS & Tiêu chuẩn theo RAM
if ((mem_total_mb <= 768)); then
  # VPS 512MB RAM
  STD_HASHSIZE=16384
  DDOS_CONNTRACK_MAX=131072
  DDOS_HASHSIZE=32768
  DDOS_ORPHANS=4096
  DDOS_TW_BUCKETS=131072
  DDOS_SYN_BACKLOG=32768
  DDOS_NETDEV_BACKLOG=65536
  TCP_MEM_LOW=16384
  TCP_MEM_PRESSURE=32768
  TCP_MEM_HIGH=65536
elif ((mem_total_mb <= 1536)); then
  # VPS 1GB RAM
  STD_HASHSIZE=32768
  DDOS_CONNTRACK_MAX=262144
  DDOS_HASHSIZE=65536
  DDOS_ORPHANS=8192
  DDOS_TW_BUCKETS=262144
  DDOS_SYN_BACKLOG=65536
  DDOS_NETDEV_BACKLOG=131072
  TCP_MEM_LOW=32768
  TCP_MEM_PRESSURE=65536
  TCP_MEM_HIGH=131072
elif ((mem_total_mb <= 4096)); then
  # VPS 2GB - 4GB RAM
  STD_HASHSIZE=65536
  DDOS_CONNTRACK_MAX=524288
  DDOS_HASHSIZE=131072
  DDOS_ORPHANS=16384
  DDOS_TW_BUCKETS=524288
  DDOS_SYN_BACKLOG=131072
  DDOS_NETDEV_BACKLOG=262144
  TCP_MEM_LOW=65536
  TCP_MEM_PRESSURE=131072
  TCP_MEM_HIGH=262144
elif ((mem_total_mb <= 8192)); then
  # VPS 6GB - 8GB RAM
  STD_HASHSIZE=131072
  DDOS_CONNTRACK_MAX=1048576
  DDOS_HASHSIZE=262144
  DDOS_ORPHANS=32768
  DDOS_TW_BUCKETS=1048576
  DDOS_SYN_BACKLOG=262144
  DDOS_NETDEV_BACKLOG=262144
  TCP_MEM_LOW=131072
  TCP_MEM_PRESSURE=262144
  TCP_MEM_HIGH=524288
else
  # Máy chủ > 8GB RAM
  STD_HASHSIZE=131072
  DDOS_CONNTRACK_MAX=2097152
  DDOS_HASHSIZE=524288
  DDOS_ORPHANS=65536
  DDOS_TW_BUCKETS=1440000
  DDOS_SYN_BACKLOG=262144
  DDOS_NETDEV_BACKLOG=524288
  TCP_MEM_LOW=262144
  TCP_MEM_PRESSURE=524288
  TCP_MEM_HIGH=1048576
fi

# ==============================================================================
# HÀM THỰC THI BẬT / TẮT KHIÊN CHỐNG DDOS TẦNG KERNEL
# ==============================================================================
_enable_kernel_ddos() {
  local msg="Kích hoạt Khiên Chống DDoS Tầng Kernel (Anti-DDoS Shield)"
  declare -F _runing >/dev/null && _runing "$msg"

  modprobe tcp_bbr >/dev/null 2>&1 || true
  modprobe sch_fq >/dev/null 2>&1 || true
  modprobe nf_conntrack >/dev/null 2>&1 || true

  /bin/mkdir -p /etc/modprobe.d /etc/wptt/tmp 2>/dev/null
  printf 'options nf_conntrack hashsize=%s\n' "$DDOS_HASHSIZE" >/etc/modprobe.d/nf_conntrack.conf
  if [[ -w /sys/module/nf_conntrack/parameters/hashsize ]]; then
    printf '%s\n' "$DDOS_HASHSIZE" >/sys/module/nf_conntrack/parameters/hashsize 2>/dev/null || true
  fi

  local avail_cc="" TCP_CC="cubic"
  if [[ -r /proc/sys/net/ipv4/tcp_available_congestion_control ]]; then
    read -r avail_cc </proc/sys/net/ipv4/tcp_available_congestion_control || true
  fi
  [[ "$avail_cc" == *"bbr"* ]] && TCP_CC="bbr"

  local tmp_ddos_sysctl
  tmp_ddos_sysctl=$(mktemp -p /etc/wptt/tmp wptt_ddos_sysctl_XXXXXX.conf 2>/dev/null || mktemp)

  cat >"$tmp_ddos_sysctl" <<EOF
# ==============================================================================
# WPTangToc OLS - Enterprise Anti-DDoS Kernel Shield (${mem_total_mb}MB RAM)
# Ghi đè tầng Network & Conntrack lên 99-wptangtoc-ols.conf (Bảo toàn ZRAM & I/O)
# ==============================================================================

# 1. Bảo vệ hàng đợi Card mạng (NIC) & Neighbor ARP Cache
net.core.netdev_max_backlog = ${DDOS_NETDEV_BACKLOG}
net.core.netdev_budget = 1200
net.core.netdev_budget_usecs = 10000
net.core.somaxconn = 65535
net.ipv4.neigh.default.gc_thresh1 = 2048
net.ipv4.neigh.default.gc_thresh2 = 4096
net.ipv4.neigh.default.gc_thresh3 = 8192
net.ipv4.neigh.default.gc_interval = 5
net.ipv4.neigh.default.gc_stale_time = 120

# 2. Chống SYN Flood, ACK Flood, Slowloris & Cạn kiệt Socket (Orphan Starvation)
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = ${DDOS_SYN_BACKLOG}
net.ipv4.tcp_syn_retries = 1
net.ipv4.tcp_synack_retries = 1
net.ipv4.tcp_abort_on_overflow = 0
net.ipv4.tcp_fin_timeout = 5
net.ipv4.tcp_keepalive_time = 120
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_max_orphans = ${DDOS_ORPHANS}
net.ipv4.tcp_orphan_retries = 1
net.ipv4.tcp_max_tw_buckets = ${DDOS_TW_BUCKETS}
net.ipv4.tcp_tw_reuse = 2
net.ipv4.tcp_rfc1337 = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_dsack = 1
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_no_metrics_save = 1
net.ipv4.tcp_invalid_ratelimit = 500
net.ipv4.tcp_challenge_ack_limit = 999999999

# 3. Quản lý bộ nhớ TCP/UDP an toàn (Không nâng rmem_default tránh nổ RAM khi bị Flood)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = ${TCP_CC}
net.ipv4.tcp_mem = ${TCP_MEM_LOW} ${TCP_MEM_PRESSURE} ${TCP_MEM_HIGH}
net.ipv4.udp_mem = ${TCP_MEM_LOW} ${TCP_MEM_PRESSURE} ${TCP_MEM_HIGH}
net.ipv4.ip_no_pmtu_disc = 0
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_base_mss = 1024

# 4. Siết chặt Netfilter Conntrack chống tràn bảng trạng thái (Nftables Anti-DDoS)
# - nf_conntrack_tcp_loose = 0: Chặn đứng gói tin ACK giả mạo không qua bước SYN
net.netfilter.nf_conntrack_max = ${DDOS_CONNTRACK_MAX}
net.netfilter.nf_conntrack_buckets = ${DDOS_HASHSIZE}
net.netfilter.nf_conntrack_tcp_loose = 0
net.netfilter.nf_conntrack_tcp_be_liberal = 0
net.netfilter.nf_conntrack_tcp_max_retrans = 2
net.netfilter.nf_conntrack_tcp_timeout_syn_sent = 15
net.netfilter.nf_conntrack_tcp_timeout_syn_recv = 10
net.netfilter.nf_conntrack_tcp_timeout_established = 600
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 10
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 10
net.netfilter.nf_conntrack_tcp_timeout_last_ack = 10
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 10
net.netfilter.nf_conntrack_tcp_timeout_close = 5
net.netfilter.nf_conntrack_tcp_timeout_unacknowledged = 15
net.netfilter.nf_conntrack_udp_timeout = 15
net.netfilter.nf_conntrack_udp_timeout_stream = 45
net.netfilter.nf_conntrack_icmp_timeout = 10
net.netfilter.nf_conntrack_generic_timeout = 30

# 5. Giới hạn tốc độ phản hồi ICMP & Chống IP Spoofing
net.ipv4.icmp_ratelimit = 100
net.ipv4.icmp_msgs_per_sec = 100
net.ipv4.icmp_msgs_burst = 20
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.conf.all.log_martians = 0
net.ipv4.conf.default.log_martians = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
EOF

  chmod 644 "$tmp_ddos_sysctl"
  /bin/mv -fT -- "$tmp_ddos_sysctl" "$DDOS_SYSCTL_FILE"

  /sbin/sysctl --system >/dev/null 2>&1 || true

  declare -F _rundone >/dev/null && _rundone "$msg"
  wptt_logs "INFO" "Đã BẬT Kernel Anti-DDoS Shield (ConntrackMax=${DDOS_CONNTRACK_MAX}, Hash=${DDOS_HASHSIZE}, Orphans=${DDOS_ORPHANS})" 2>/dev/null || true
}

_disable_kernel_ddos() {
  local msg="Tắt Khiên Chống DDoS & Khôi phục thông số Kernel tiêu chuẩn"
  declare -F _runing >/dev/null && _runing "$msg"

  /bin/rm -f -- "$DDOS_SYSCTL_FILE" 2>/dev/null || true

  # Trả lại Conntrack Hashsize về mức tiêu chuẩn theo RAM của 99-wptangtoc-ols.conf
  /bin/mkdir -p /etc/modprobe.d 2>/dev/null
  printf 'options nf_conntrack hashsize=%s\n' "$STD_HASHSIZE" >/etc/modprobe.d/nf_conntrack.conf
  if [[ -w /sys/module/nf_conntrack/parameters/hashsize ]]; then
    printf '%s\n' "$STD_HASHSIZE" >/sys/module/nf_conntrack/parameters/hashsize 2>/dev/null || true
  fi

  # Khôi phục lại tcp_loose = 1 (mặc định của Linux khi không bị DDoS) trước khi nạp lại sysctl
  if [[ -w /proc/sys/net/netfilter/nf_conntrack_tcp_loose ]]; then
    printf '1\n' >/proc/sys/net/netfilter/nf_conntrack_tcp_loose 2>/dev/null || true
  fi

  /sbin/sysctl --system >/dev/null 2>&1 || true

  declare -F _rundone >/dev/null && _rundone "$msg"
  wptt_logs "INFO" "Đã TẮT Kernel Anti-DDoS Shield và khôi phục Kernel tiêu chuẩn" 2>/dev/null || true
}

# ==============================================================================
# 4. XỬ LÝ THAM SỐ CLI NHANH (DÀNH CHO SCRIPT TỰ ĐỘNG GỌI NGẦM)
# ==============================================================================
case "${1:-}" in
on | enable)
  _enable_kernel_ddos
  exit 0
  ;;
off | disable)
  _disable_kernel_ddos
  exit 0
  ;;
esac

# ==============================================================================
# 5. GIAO DIỆN MENU TƯƠNG TÁC (SỬ DỤNG HÀM LÕI wptt_xac_nhan)
# ==============================================================================
clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
if declare -F center_text >/dev/null; then
  center_text "${C_YELLOW}BẢO MẬT HỆ THỐNG ➜ KHIÊN CHỐNG DDOS TẦNG KERNEL${C_RESET}"
else
  echo -e "  ${C_YELLOW}BẢO MẬT HỆ THỐNG ➜ KHIÊN CHỐNG DDOS TẦNG KERNEL${C_RESET}"
fi
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

if [[ -f "$DDOS_SYSCTL_FILE" ]]; then
  # TRẠNG THÁI HIỆN TẠI: ĐANG BẬT -> Hỏi người dùng có muốn TẮT không
  if wptt_xac_nhan \
    "Trạng thái: ĐANG BẬT. Bạn có muốn TẮT Khiên Chống DDoS Kernel không?" \
    "Hiện tại : Đang siết chặt TCP/Conntrack (${DDOS_CONNTRACK_MAX} kết nối, khóa ACK giả mạo)" \
    "Gợi ý    : Khi hết bị tấn công DDoS, nên TẮT để tối ưu tốc độ giữ kết nối chuẩn." \
    "Đồng ý (Tắt Chống DDoS)" \
    "Giữ nguyên (Đang Bật)"; then

    echo ""
    _disable_kernel_ddos
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    left_text "Trạng thái mới : ${C_YELLOW}ĐÃ TẮT (Chế độ Kernel Tốc Độ Tiêu Chuẩn)${C_RESET}" 2
    left_text "Cấu hình áp dụng: /etc/sysctl.d/99-wptangtoc-ols.conf" 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "\n${C_YELLOW}Đã giữ nguyên trạng thái BẬT Khiên Chống DDoS Tầng Kernel.${C_RESET}\n"
  fi
else
  # TRẠNG THÁI HIỆN TẠI: ĐANG TẮT -> Hỏi người dùng có muốn BẬT không
  if wptt_xac_nhan \
    "Trạng thái: ĐANG TẮT. Bạn có muốn BẬT Khiên Chống DDoS Kernel không?" \
    "Tác dụng : Chống SYN/ACK Flood, Slowloris, cạn kiệt Socket (RAM: ${mem_total_mb}MB)" \
    "An toàn  : Tự động bảo toàn 100% cấu hình ZRAM, MariaDB AIO & Nftables hiện tại." \
    "Đồng ý (Bật Chống DDoS)" \
    "Hủy bỏ (Giữ nguyên)"; then

    echo ""
    _enable_kernel_ddos
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    left_text "Trạng thái mới : ${C_GREEN}ĐANG BẬT (Enterprise Anti-DDoS Kernel Shield)${C_RESET}" 2
    left_text "Bảng Conntrack : Tối đa ${C_YELLOW}${DDOS_CONNTRACK_MAX}${C_RESET} kết nối (Hashsize: ${DDOS_HASHSIZE})" 2
    left_text "Bảo vệ TCP     : Khóa chặt ACK Flood (tcp_loose=0), Orphans=${DDOS_ORPHANS}" 2
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "\n${C_YELLOW}Đã hủy thao tác. Hệ thống tiếp tục chạy cấu hình Kernel tiêu chuẩn.${C_RESET}\n"
  fi
fi

if declare -F wptt_quay_ve_menu >/dev/null; then
  wptt_quay_ve_menu "${1:-}" 0 "enter"
fi
