#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Khởi tạo Nftables thuần (Zero-Overhead)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

TMP_NFT=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${TMP_NFT:-}" && -f "$TMP_NFT" ]]; then
    /bin/rm -f -- "${TMP_NFT:?}"
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# ==============================================================================
# 1. PHÁT HIỆN PORT SSH ĐA TẦNG (CHỐNG TỰ KHÓA CHÍNH MÌNH - ANTI LOCKOUT 100%)
# ==============================================================================
current_ssh_port="${port_ssh:-}"
if [[ -z "$current_ssh_port" || ! "$current_ssh_port" =~ ^[0-9]+$ ]]; then
  current_ssh_port="$(awk '/^[ \t]*[Pp]ort[ \t]+[0-9]+/ {print $2; exit}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null)"
fi
if [[ -z "$current_ssh_port" || ! "$current_ssh_port" =~ ^[0-9]+$ ]] || ((10#$current_ssh_port < 1 || 10#$current_ssh_port > 65535)); then
  current_ssh_port=22
fi

# Xây dựng danh sách Port TCP mở mặc định (Chống trùng lặp nếu SSH port là 80/443)
tcp_elements="80, 443"
if ((10#$current_ssh_port != 80 && 10#$current_ssh_port != 443)); then
  tcp_elements="${current_ssh_port}, ${tcp_elements}"
fi

# Bảo vệ thêm Port của phiên SSH đang kết nối trực tiếp (nếu khác với port trong file config)
if [[ -n "${SSH_CONNECTION:-}" ]]; then
  active_session_port="${SSH_CONNECTION##* }"
  if [[ "$active_session_port" =~ ^[0-9]+$ ]] &&
    ((10#$active_session_port != 10#$current_ssh_port && 10#$active_session_port != 80 && 10#$active_session_port != 443)); then
    tcp_elements="${active_session_port}, ${tcp_elements}"
  fi
fi

# ==============================================================================
# 2. ĐẢM BẢO GÓI NFTABLES ĐÃ ĐƯỢC CÀI ĐẶT (LŨY ĐẲNG)
# ==============================================================================
if ! command -v nft >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y nftables >/dev/null 2>&1 || true
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y nftables >/dev/null 2>&1 || true
  elif command -v yum >/dev/null 2>&1; then
    yum install -y nftables >/dev/null 2>&1 || true
  fi
fi

if ! command -v nft >/dev/null 2>&1; then
  echo -e "${C_RED:-}❌ Lỗi: Không tìm thấy công cụ 'nft'. Giữ nguyên tường lửa hiện tại để đảm bảo an toàn!${C_RESET:-}" >&2
  exit 1
fi

# ==============================================================================
# 3. TẠO FILE CẤU HÌNH NGUYÊN TỬ (ATOMIC) & KIỂM TRA CÚ PHÁP TRƯỚC KHI ÁP DỤNG
# ==============================================================================
/bin/mkdir -p /etc/wptt/tmp 2>/dev/null
chmod 700 /etc/wptt/tmp 2>/dev/null

umask 077
TMP_NFT="$(mktemp -p /etc/wptt/tmp nftables_init_XXXXXX.conf)"
umask 022

cat >"$TMP_NFT" <<EOF
#!/usr/sbin/nft -f

# Làm mới cô lập 2 bảng của WPTangToc (Không làm mất bảng của SSHGuard / Fail2ban)
table inet blackblock
delete table inet blackblock
table inet filter
delete table inet filter

# ==============================================================================
# BẢNG 1: KHIÊN CHẮN BLACKLIST TẦNG THẤP (Chặn sớm ở Priority -10)
# ==============================================================================
table inet blackblock {
	set blackaction_v4 {
		type ipv4_addr
		flags interval,timeout
		auto-merge
		comment "Danh sach chan IPv4 & CIDR"
	}

	set blackaction_v6 {
		type ipv6_addr
		flags interval,timeout
		auto-merge
		comment "Danh sach chan IPv6 & CIDR"
	}

	chain blackblock-chain-input {
		type filter hook input priority filter - 10; policy accept;
		ip saddr @blackaction_v4 counter drop
		ip6 saddr @blackaction_v6 counter drop
	}
}

# ==============================================================================
# BẢNG 2: BỘ LỌC TƯỜNG LỬA CHÍNH (Quản lý Port bằng Hash Set O(1))
# ==============================================================================
table inet filter {
	set tcp_ports {
		type inet_service
		comment "Danh sach Port TCP duoc phep mo"
		elements = { ${tcp_elements} }
	}

	set udp_ports {
		type inet_service
		comment "Danh sach Port UDP duoc phep mo (QUIC/HTTP3)"
		elements = { 443 }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		# 1. Fast-Path: Cho qua ngay lập tức các kết nối đã thiết lập (99% traffic)
		ct state established,related accept

		# 2. Cho phép giao tiếp Loopback nội bộ (PHP-LSAPI, MariaDB, Redis Socket)
		iifname "lo" accept

		# 3. Loại bỏ sớm các gói tin dị dạng / không hợp lệ
		ct state invalid drop

		# 4. Cho phép ICMPv4 và ICMPv6 thiết yếu (Chống đứt mạng IPv6 NDP & PMTU)
		ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 15/second accept
		ip6 nexthdr icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } accept

		# 5. Cho phép gia hạn IP tự động trên Cloud VPS (DHCPv4 & DHCPv6 Client)
		ip protocol udp udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept

		# 6. Mở Port động siêu tốc qua Hash Set O(1)
		tcp dport @tcp_ports ct state new accept
		udp dport @udp_ports ct state new accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
EOF

# Kiểm tra cú pháp và khả năng hỗ trợ Kernel Netfilter trước khi tắt Firewalld
if ! nft -c -f "$TMP_NFT" >/dev/null 2>&1; then
  echo -e "${C_RED:-}❌ Lỗi: Kernel hoặc cú pháp Nftables không tương thích. Đã hủy chuyển đổi để an toàn!${C_RESET:-}" >&2
  exit 1
fi

# ==============================================================================
# 4. TẮT FIREWALLD & KÍCH HOẠT NFTABLES THUẦN
# ==============================================================================
if systemctl is-active --quiet firewalld 2>/dev/null || systemctl is-enabled --quiet firewalld 2>/dev/null; then
  systemctl stop firewalld >/dev/null 2>&1 || true
  systemctl disable firewalld >/dev/null 2>&1 || true
  systemctl mask firewalld >/dev/null 2>&1 || true
  # Dọn sạch bảng tàn dư của firewalld trong Kernel (nếu còn sót)
  nft delete table inet firewalld >/dev/null 2>&1 || true
  nft delete table ip firewalld >/dev/null 2>&1 || true
  nft delete table ip6 firewalld >/dev/null 2>&1 || true
fi

chmod 600 "$TMP_NFT"
/bin/mv -fT "$TMP_NFT" /etc/nftables.conf
TMP_NFT=""

# Đồng bộ đường dẫn cấu hình giữa RHEL/AlmaLinux (/etc/sysconfig/nftables.conf) và Ubuntu (/etc/nftables.conf)
if [[ -d /etc/sysconfig ]]; then
  ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
fi

# Khôi phục nhãn SELinux chuẩn trên họ RHEL để systemd đọc được khi boot
if command -v restorecon >/dev/null 2>&1; then
  restorecon -F /etc/nftables.conf /etc/sysconfig/nftables.conf >/dev/null 2>&1 || true
fi

systemctl unmask nftables >/dev/null 2>&1 || true
systemctl enable --now nftables >/dev/null 2>&1 || true
nft -f /etc/nftables.conf >/dev/null 2>&1 || true

if declare -F wptt_logs >/dev/null 2>&1; then
  wptt_logs "INFO" "Đã kích hoạt Nftables thuần (Zero-Overhead), mở sẵn TCP Port: ${tcp_elements}"
fi
