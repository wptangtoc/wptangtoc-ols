#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Đóng Port & Dải Port (TCP/UDP) trên Nftables thuần (Có chốt chặn bảo vệ SSH theo dải)

# Sử dụng:
# /bin/bash /etc/wptt/bao-mat/nftables/wptt-dong-port 7000 tcp
# /bin/bash /etc/wptt/bao-mat/nftables/wptt-dong-port "7000-8000" tcp

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

# ==============================================================================
# HÀM 1: TỰ ĐỘNG KHỞI TẠO / NÂNG CẤP SET LÊN INTERVAL (AUTO-HEAL)
# ==============================================================================
wptt_ensure_nft_ready() {
  local need_init=0
  if ! nft list set inet filter tcp_ports >/dev/null 2>&1; then
    need_init=1
  elif ! nft list set inet filter udp_ports >/dev/null 2>&1; then
    need_init=1
  elif ! nft list table inet blackblock >/dev/null 2>&1; then
    need_init=1
  elif ! nft list set inet filter tcp_ports 2>/dev/null | grep -q "flags interval"; then
    need_init=1
  fi

  if ((need_init == 1)); then
    if [[ -f /etc/wptt/bao-mat/nftables/wptt-setup-nftables ]]; then
      /bin/bash /etc/wptt/bao-mat/nftables/wptt-setup-nftables >/dev/null 2>&1 || true
    fi

    if ! nft list set inet filter tcp_ports 2>/dev/null | grep -q "flags interval"; then
      local cur_ssh="${port_ssh:-}"
      if [[ -z "$cur_ssh" || ! "$cur_ssh" =~ ^[0-9]+$ ]]; then
        cur_ssh="$(awk '/^[ \t]*[Pp]ort[ \t]+[0-9]+/ {print $2; exit}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null)"
      fi
      [[ -z "$cur_ssh" || ! "$cur_ssh" =~ ^[0-9]+$ ]] && cur_ssh=22
      local tcp_init="80, 443"
      ((10#$cur_ssh != 80 && 10#$cur_ssh != 443)) && tcp_init="${cur_ssh}, ${tcp_init}"

      nft -f - >/dev/null 2>&1 <<EOF || return 1
table inet blackblock
delete table inet blackblock
table inet filter
delete table inet filter

table inet blackblock {
	set blackaction_v4 {
		type ipv4_addr
		flags interval
		auto-merge
	}
	set blackaction_v6 {
		type ipv6_addr
		flags interval
		auto-merge
	}
	chain blackblock-chain-input {
		type filter hook input priority -10; policy accept;
		ip saddr @blackaction_v4 counter drop
		ip6 saddr @blackaction_v6 counter drop
	}
}

table inet filter {
	set tcp_ports {
		type inet_service
		flags interval
		auto-merge
		elements = { ${tcp_init} }
	}
	set udp_ports {
		type inet_service
		flags interval
		auto-merge
		elements = { 443 }
	}
	chain input {
		type filter hook input priority 0; policy drop;
		ct state established,related accept
		iifname "lo" accept
		ct state invalid drop
		icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 15/second accept
		icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		tcp dport @tcp_ports ct state new accept
		udp dport @udp_ports ct state new accept
	}
	chain forward {
		type filter hook forward priority 0; policy drop;
	}
	chain output {
		type filter hook output priority 0; policy accept;
	}
}
EOF
    fi
  fi
  return 0
}

# ==============================================================================
# HÀM 2: KIỂM TRA ĐỊNH DẠNG PORT / DẢI PORT & CHỐNG KHÓA NHẦM PORT SSH
# ==============================================================================
NORMALIZED_PORT_SPEC=""

wptt_validate_port_spec() {
  local raw="${1//[[:space:]]/}"
  raw="${raw//:/-}"
  [[ -z "$raw" ]] && return 1

  local IFS=','
  local -a tokens=()
  read -r -a tokens <<<"$raw"
  ((${#tokens[@]} == 0)) && return 1

  local tok p_start p_end
  local result_spec=""

  for tok in "${tokens[@]}"; do
    [[ -z "$tok" ]] && return 1
    if [[ "$tok" =~ ^([0-9]{1,5})$ ]]; then
      p_start=$((10#${BASH_REMATCH[1]}))
      if ((p_start < 1 || p_start > 65535)); then
        return 1
      fi
      result_spec+="${p_start},"
    elif [[ "$tok" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
      p_start=$((10#${BASH_REMATCH[1]}))
      p_end=$((10#${BASH_REMATCH[2]}))
      if ((p_start < 1 || p_end > 65535 || p_start > p_end)); then
        return 1
      fi
      if ((p_start == p_end)); then
        result_spec+="${p_start},"
      else
        result_spec+="${p_start}-${p_end},"
      fi
    else
      return 1
    fi
  done

  NORMALIZED_PORT_SPEC="${result_spec%,}"
  return 0
}

# Kiểm tra xem Port SSH có nằm trong Port đơn hoặc Dải Port sắp đóng hay không
wptt_port_spec_contains_ssh() {
  local spec="$1"
  local ssh_p="$2"
  [[ -z "$ssh_p" || ! "$ssh_p" =~ ^[0-9]+$ ]] && return 1

  local IFS=','
  local -a tokens=()
  read -r -a tokens <<<"$spec"

  local tok p_start p_end
  for tok in "${tokens[@]}"; do
    if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      p_start=$((10#${BASH_REMATCH[1]}))
      p_end=$((10#${BASH_REMATCH[2]}))
      if ((10#$ssh_p >= p_start && 10#$ssh_p <= p_end)); then
        return 0
      fi
    elif [[ "$tok" =~ ^([0-9]+)$ ]]; then
      p_start=$((10#${BASH_REMATCH[1]}))
      if ((10#$ssh_p == p_start)); then
        return 0
      fi
    fi
  done
  return 1
}

# ==============================================================================
# HÀM 3: CẬP NHẬT BITMAP PORT & TÁCH/XÓA DẢI NGUYÊN TỬ
# ==============================================================================
wptt_modify_port_set() {
  local set_name="$1"
  local action="$2" # add hoặc del
  local spec="$3"

  local current_set_out=""
  current_set_out="$(nft list set inet filter "$set_name" 2>/dev/null)" || return 1

  local new_elements=""
  new_elements="$(awk -v act="$action" -v spec="$spec" '
    function apply_token(tok, val,   n, arr, s, e, k) {
      gsub(/[ \t,]/, "", tok)
      if (tok == "") return
      n = split(tok, arr, "-")
      if (n == 1 && arr[1] ~ /^[0-9]+$/) {
        s = arr[1] + 0
        if (s >= 1 && s <= 65535) p[s] = val
      } else if (n == 2 && arr[1] ~ /^[0-9]+$/ && arr[2] ~ /^[0-9]+$/) {
        s = arr[1] + 0
        e = arr[2] + 0
        if (s >= 1 && e <= 65535 && s <= e) {
          for (k = s; k <= e; k++) p[k] = val
        }
      }
    }
    /elements[ \t]*=[ \t]*\{/ {
      in_elem = 1
      sub(/.*elements[ \t]*=[ \t]*\{[ \t]*/, "")
    }
    in_elem {
      if (index($0, "}") > 0) {
        sub(/[ \t]*\}.*/, "")
        in_elem = 0
      }
      gsub(/,/, " ")
      for (i = 1; i <= NF; i++) {
        apply_token($i, 1)
      }
    }
    END {
      m = split(spec, sp, ",")
      target_val = (act == "add") ? 1 : 0
      for (i = 1; i <= m; i++) {
        apply_token(sp[i], target_val)
      }

      out = ""
      in_run = 0
      run_start = 0
      for (k = 1; k <= 65536; k++) {
        if (k <= 65535 && p[k] == 1) {
          if (!in_run) {
            in_run = 1
            run_start = k
          }
        } else {
          if (in_run) {
            run_end = k - 1
            if (run_start == run_end) {
              seg = run_start
            } else {
              seg = run_start "-" run_end
            }
            out = (out == "") ? seg : out ", " seg
            in_run = 0
          }
        }
      }
      print out
    }
  ' <<<"$current_set_out")"

  if [[ -n "$new_elements" ]]; then
    nft -f - >/dev/null 2>&1 <<EOF || return 1
flush set inet filter ${set_name}
add element inet filter ${set_name} { ${new_elements} }
EOF
  else
    nft flush set inet filter "$set_name" >/dev/null 2>&1 || return 1
  fi
  return 0
}

# ==============================================================================
# HÀM 4: LƯU TRẠNG THÁI KERNEL XUỐNG /etc/nftables.conf NGUYÊN TỬ (ATOMIC)
# ==============================================================================
wptt_nft_save_persistent() {
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  local tmp_nft=""
  tmp_nft="$(mktemp -p /etc/wptt/tmp nftables_save_XXXXXX.conf)"

  local tbl_black=""
  local tbl_filter=""
  tbl_black="$(nft list table inet blackblock 2>/dev/null)" || true
  tbl_filter="$(nft list table inet filter 2>/dev/null)" || true

  if [[ -z "$tbl_filter" ]]; then
    /bin/rm -f -- "${tmp_nft:?}"
    return 1
  fi

  {
    printf '#!/usr/sbin/nft -f\n\nflush ruleset\n\n'
    if [[ -n "$tbl_black" ]]; then
      printf '%s\n\n' "$tbl_black"
    fi
    printf '%s\n' "$tbl_filter"
  } > "$tmp_nft"

  chmod 600 "$tmp_nft"
  /bin/mv -fT "$tmp_nft" /etc/nftables.conf
  if [[ -d /etc/sysconfig ]]; then
    ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
  fi
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -F /etc/nftables.conf /etc/sysconfig/nftables.conf >/dev/null 2>&1 || true
  fi
  return 0
}

wptt_get_open_ports_display() {
  local set_name="$1"
  nft list set inet filter "$set_name" 2>/dev/null | awk '
    /elements[ \t]*=[ \t]*\{/ { in_e = 1; sub(/.*elements[ \t]*=[ \t]*\{[ \t]*/, "") }
    in_e {
      if (index($0, "}") > 0) { sub(/[ \t]*\}.*/, ""); in_e = 0 }
      gsub(/[ \t]+/, " ")
      out = out $0 " "
    }
    END {
      gsub(/^[ \t]+|[ \t]+$/, "", out)
      gsub(/ ,[ \t]*/, ", ", out)
      print out
    }
  '
}

IS_CLI_MODE=0
route_flag="${1:-}"
PORT_IN=""
PROTO_IN="${2:-both}"

if [[ -n "${1:-}" && "${1:-}" != "98" && "${1:-}" != "99" ]]; then
  IS_CLI_MODE=1
  PORT_IN="$1"
  route_flag=""
fi

wptt_exit_handler() {
  local code="${1:-0}"
  local wait_mode="${2:-}"
  if ((IS_CLI_MODE == 1)); then
    exit "$code"
  else
    wptt_quay_ve_menu "$route_flag" "$code" "$wait_mode"
  fi
}

wptt_ensure_nft_ready || {
  echo -e "\n${C_RED}❌ Lỗi: Không thể khởi tạo cấu trúc bảng Nftables trong Kernel!${C_RESET}"
  wptt_exit_handler 1 "enter"
}

if [[ -z "$PORT_IN" ]]; then
  clear
  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}TƯỜNG LỬA NFTABLES ➜ Đóng Cổng Kết Nối (Close Port / Range)${C_RESET}" "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""

  open_tcp="$(wptt_get_open_ports_display tcp_ports)"
  open_udp="$(wptt_get_open_ports_display udp_ports)"
  echo -e "Port TCP đang mở: ${C_GREEN}${open_tcp:-Trống}${C_RESET}"
  echo -e "Port UDP đang mở: ${C_GREEN}${open_udp:-Trống}${C_RESET}\n"

  echo -en "${C_CYAN}Nhập Port hoặc Dải Port cần ĐÓNG (VD: 7080 hoặc 7000-8000) [0=Thoát]: ${C_RESET}"
  read -r PORT_IN
  [[ -z "$PORT_IN" || "$PORT_IN" == "0" ]] && wptt_exit_handler 0
fi

if ! wptt_validate_port_spec "$PORT_IN"; then
  echo -e "\n${C_RED}❌ Lỗi: Cú pháp Port '$PORT_IN' không hợp lệ! (VD đúng: 7080 hoặc 7000-8000, trong khoảng 1-65535)${C_RESET}"
  wptt_exit_handler 1 "enter"
fi

PORT_SPEC="$NORMALIZED_PORT_SPEC"
PROTO_IN="${PROTO_IN,,}"

# [CHỐT CHẶN AN TOÀN THEO DẢI]: Cấm đóng Port SSH đang hoạt động (dù đóng lẻ hay đóng theo dải)
if [[ "$PROTO_IN" == "tcp" || "$PROTO_IN" == "both" ]]; then
  active_ssh_port="$(awk '/^[ \t]*[Pp]ort[ \t]+[0-9]+/ {print $2; exit}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null)"
  [[ -z "$active_ssh_port" ]] && active_ssh_port="${port_ssh:-22}"

  if wptt_port_spec_contains_ssh "$PORT_SPEC" "$active_ssh_port"; then
    echo -e "\n${C_RED}🛡️ CẢNH BÁO TỬ HUYỆT: Lựa chọn '$PORT_SPEC' có chứa cổng kết nối SSH hiện tại (Port $active_ssh_port)!${C_RESET}"
    echo -e "${C_YELLOW}Hệ thống từ chối đóng để bảo vệ bạn khỏi nguy cơ mất quyền điều khiển VPS.${C_RESET}"
    wptt_exit_handler 1 "enter"
  fi
fi

task_close="Đóng cổng $PORT_SPEC (${PROTO_IN^^}) trên tường lửa Nftables"
_runing "$task_close"

err_flag=0
if [[ "$PROTO_IN" == "tcp" || "$PROTO_IN" == "both" ]]; then
  if ! wptt_modify_port_set "tcp_ports" "del" "$PORT_SPEC"; then
    err_flag=1
  fi
fi

if [[ "$PROTO_IN" == "udp" || "$PROTO_IN" == "both" ]]; then
  if ! wptt_modify_port_set "udp_ports" "del" "$PORT_SPEC"; then
    err_flag=1
  fi
fi

if ((err_flag == 0)) && wptt_nft_save_persistent; then
  _rundone "$task_close"
  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "INFO" "Nftables: Đã đóng Port $PORT_SPEC (${PROTO_IN^^})"
  fi
  echo -e "\n${C_GREEN}✔ Đã đóng thành công Port $PORT_SPEC (${PROTO_IN^^}) và lưu cấu hình vĩnh viễn!${C_RESET}"
  wptt_exit_handler 0 "enter"
else
  _runloi "$task_close"
  echo -e "\n${C_RED}❌ Lỗi: Không thể lưu cấu hình Nftables!${C_RESET}"
  wptt_exit_handler 1 "enter"
fi
