#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Mở Port / Dải Port (TCP/UDP) trên Nftables (Atomic & Persistent)

# Cách gọi CLI: /bin/bash /etc/wptt/bao-mat/nftables/wptt-mo-port 7080 tcp
# Hoặc mở dải:  /bin/bash /etc/wptt/bao-mat/nftables/wptt-mo-port 30000-35000 tcp
# Mở nhiều port: /bin/bash /etc/wptt/bao-mat/nftables/wptt-mo-port "7080,7081" tcp
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true
umask 077

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

tmp_nft=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${tmp_nft:-}" && -f "$tmp_nft" ]]; then
    case "$tmp_nft" in
    /etc/wptt/tmp/nftables_save_*)
      /bin/rm -f -- "${tmp_nft:?}"
      ;;
    esac
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# ==============================================================================
# HÀM LÕI: LƯU TRẠNG THÁI RUNTIME RA FILE /etc/nftables.conf NGUYÊN TỬ (ATOMIC)
# ==============================================================================
wptt_nft_save_persistent() {
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  tmp_nft="$(mktemp -p /etc/wptt/tmp nftables_save_XXXXXX.conf)" || return 1

  {
    printf '#!/usr/sbin/nft -f\n\nflush ruleset\n\n'
    nft list table inet blackblock 2>/dev/null || true
    printf '\n'
    nft list table inet filter 2>/dev/null || true
  } >"$tmp_nft"

  if nft -c -f "$tmp_nft" >/dev/null 2>&1; then
    chmod 600 "$tmp_nft"
    /bin/mv -fT -- "$tmp_nft" /etc/nftables.conf
    tmp_nft=""
    [[ -d /etc/sysconfig ]] && ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
    return 0
  else
    /bin/rm -f -- "${tmp_nft:?}"
    tmp_nft=""
    return 1
  fi
}

# ==============================================================================
# HÀM TRÍCH XUẤT DANH SÁCH PORT ĐANG MỞ (DÙNG -nn ĐỂ ÉP SỐ PORT 100%)
# ==============================================================================
wptt_get_open_ports() {
  local set_name="$1"
  nft -nn list set inet filter "$set_name" 2>/dev/null | awk '
    /elements = \{/ { in_elem = 1; sub(/.*elements = \{[ \t]*/, "") }
    in_elem {
      if ($0 ~ /\}/) {
        sub(/[ \t]*\}.*/, "")
        buf = buf " " $0
        in_elem = 0
      } else {
        buf = buf " " $0
      }
    }
    END {
      gsub(/[ \t\r\n]+/, " ", buf)
      sub(/^ +/, "", buf)
      sub(/ +$/, "", buf)
      print buf
    }
  '
}

# ==============================================================================
# HÀM XÁC THỰC & CHUẨN HÓA DANH SÁCH PORT / DẢI PORT BẰNG PURE BASH
# ==============================================================================
wptt_validate_and_normalize_ports() {
  local raw_input="${1//[[:space:]]/}"
  [[ -z "$raw_input" ]] && return 1

  local IFS=','
  local -a tokens=()
  read -ra tokens <<<"$raw_input"

  local -a clean_list=()
  local token="" p_start="" p_end=""
  for token in "${tokens[@]}"; do
    [[ -z "$token" ]] && continue
    if [[ "$token" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
      p_start="$((10#${BASH_REMATCH[1]}))"
      p_end="$((10#${BASH_REMATCH[2]}))"
      if ((p_start < 1 || p_end > 65535 || p_start > p_end)); then
        return 1
      fi
      if ((p_start == p_end)); then
        clean_list+=("$p_start")
      else
        clean_list+=("${p_start}-${p_end}")
      fi
    elif [[ "$token" =~ ^[0-9]{1,5}$ ]]; then
      p_start="$((10#$token))"
      if ((p_start < 1 || p_start > 65535)); then
        return 1
      fi
      clean_list+=("$p_start")
    else
      return 1
    fi
  done

  ((${#clean_list[@]} == 0)) && return 1

  local out="" item=""
  for item in "${clean_list[@]}"; do
    out+="${out:+, }${item}"
  done
  printf '%s' "$out"
  return 0
}

# ==============================================================================
# HÀM NẠP & GỘP PORT VÀO SET INTERVAL AN TOÀN (CHỐNG LỖI OVERLAP KERNEL)
# ==============================================================================
wptt_add_ports_to_set() {
  local set_name="$1"
  local new_elements="$2"
  local current_elements=""
  current_elements="$(wptt_get_open_ports "$set_name")"

  local combined="$new_elements"
  [[ -n "$current_elements" ]] && combined="${current_elements}, ${new_elements}"

  # Dùng awk hợp nhất các khoảng giao nhau/liền kề (Chỉ nhận số hợp lệ 1..65535)
  local merged_elements=""
  merged_elements="$(awk -v raw="$combined" '
    BEGIN {
      n = split(raw, arr, ",")
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t]+|[ \t]+$/, "", arr[i])
        if (arr[i] == "") continue
        if (arr[i] ~ /^[0-9]+-[0-9]+$/) {
          split(arr[i], r, "-")
          s = r[1] + 0; e = r[2] + 0
        } else if (arr[i] ~ /^[0-9]+$/) {
          s = arr[i] + 0; e = s
        } else {
          continue
        }
        if (s < 1) s = 1
        if (e > 65535) e = 65535
        for (p = s; p <= e; p++) port_map[p] = 1
      }
      out = ""
      in_range = 0
      for (p = 1; p <= 65536; p++) {
        if (port_map[p] == 1) {
          if (!in_range) { start_p = p; in_range = 1 }
        } else if (in_range) {
          end_p = p - 1
          seg = (start_p == end_p) ? start_p : (start_p "-" end_p)
          out = (out == "") ? seg : (out ", " seg)
          in_range = 0
        }
      }
      print out
    }
  ')"

  [[ -z "$merged_elements" ]] && return 1

  nft -f - >/dev/null 2>&1 <<EOF
add set inet filter ${set_name} { type inet_service; flags interval; }
flush set inet filter ${set_name}
add element inet filter ${set_name} { ${merged_elements} }
EOF
}

# ==============================================================================
# PHÂN TÁCH CHẾ ĐỘ MENU TƯƠNG TÁC VS CLI TỰ ĐỘNG
# ==============================================================================
is_interactive=0
route_flag=""
PORT_IN="${1:-}"
PROTO_IN="${2:-tcp}"

if [[ -z "$PORT_IN" ]] || { [[ -z "${2:-}" ]] && [[ "$PORT_IN" == "98" || "$PORT_IN" == "99" ]]; }; then
  is_interactive=1
  route_flag="$PORT_IN"
  PORT_IN=""
fi

finish_script() {
  local code="$1"
  local wait_mode="${2:-enter}"
  if ((is_interactive == 1)); then
    wptt_quay_ve_menu "$route_flag" "$code" "$wait_mode"
  else
    exit "$code"
  fi
}

# Kiểm tra điều kiện tiên quyết (Preflight Check)
if ! systemctl is-active --quiet nftables 2>/dev/null || ! nft list table inet filter >/dev/null 2>&1; then
  echo -e "\n${C_RED}❌ Lỗi: Kiến trúc Nftables của WPTangToc chưa được kích hoạt!${C_RESET}"
  finish_script 1 "enter"
fi

if ((is_interactive == 1)); then
  clear
  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}TƯỜNG LỬA NFTABLES ➜ Mở Cổng Kết Nối (Open Port)${C_RESET}" "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""

  open_tcp="$(wptt_get_open_ports "tcp_ports")"
  open_udp="$(wptt_get_open_ports "udp_ports")"
  echo -e "Port TCP đang mở: ${C_GREEN}${open_tcp:-Trống}${C_RESET}"
  echo -e "Port UDP đang mở: ${C_GREEN}${open_udp:-Trống}${C_RESET}\n"

  echo -en "${C_CYAN}Nhập Port hoặc dải Port cần MỞ (VD: 7080, 8080 hoặc 30000-35000) [0=Thoát]: ${C_RESET}"
  read -r PORT_IN
  [[ -z "$PORT_IN" || "$PORT_IN" == "0" ]] && finish_script 0 ""

  echo -en "${C_CYAN}Chọn giao thức (1=TCP, 2=UDP, 3=Cả TCP & UDP) [Mặc định=1]: ${C_RESET}"
  read -r chon_proto
  case "${chon_proto:-1}" in
  2) PROTO_IN="udp" ;;
  3) PROTO_IN="both" ;;
  *) PROTO_IN="tcp" ;;
  esac
fi

# Chuẩn hóa và kiểm tra hợp lệ của Port
NORMALIZED_PORTS=""
if ! NORMALIZED_PORTS="$(wptt_validate_and_normalize_ports "$PORT_IN")"; then
  echo -e "\n${C_RED}❌ Lỗi: Số Port '$PORT_IN' không hợp lệ (Phải từ 1 đến 65535, VD: 7080 hoặc 30000-35000)!${C_RESET}"
  finish_script 1 "enter"
fi

PROTO_IN="${PROTO_IN,,}"
case "$PROTO_IN" in
tcp | udp | both) ;;
*)
  echo -e "\n${C_RED}❌ Lỗi: Giao thức '$PROTO_IN' không hợp lệ (Chỉ hỗ trợ: tcp, udp, both)!${C_RESET}"
  finish_script 1 "enter"
  ;;
esac

task_open="Mở cổng $NORMALIZED_PORTS (${PROTO_IN^^}) trên tường lửa Nftables"
_runing "$task_open"

err_flag=0
if [[ "$PROTO_IN" == "tcp" || "$PROTO_IN" == "both" ]]; then
  if ! wptt_add_ports_to_set "tcp_ports" "$NORMALIZED_PORTS"; then
    err_flag=1
  fi
fi

if [[ "$PROTO_IN" == "udp" || "$PROTO_IN" == "both" ]]; then
  if ! wptt_add_ports_to_set "udp_ports" "$NORMALIZED_PORTS"; then
    err_flag=1
  fi
fi

if ((err_flag == 0)) && wptt_nft_save_persistent; then
  _rundone "$task_open"
  wptt_logs "INFO" "Nftables: Đã mở Port $NORMALIZED_PORTS (${PROTO_IN^^})"
  if ((is_interactive == 1)); then
    echo -e "\n${C_GREEN}✔ Đã mở thành công Port $NORMALIZED_PORTS (${PROTO_IN^^}) và lưu cấu hình vĩnh viễn!${C_RESET}"
  fi
  finish_script 0 "enter"
else
  _runloi "$task_open"
  echo -e "\n${C_RED}❌ Lỗi: Không thể cập nhật cấu hình Nftables!${C_RESET}"
  finish_script 1 "enter"
fi
