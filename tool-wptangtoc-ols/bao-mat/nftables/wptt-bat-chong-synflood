#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Kích hoạt Khiên chống SYN Flood / HTTP Flood (Nftables Dynamic Per-IP)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8 2>/dev/null || true

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

# ==============================================================================
# THÔNG SỐ TÙY CHỈNH (CÓ THỂ SỬA CHO PHÙ HỢP VỚI SERVER)
# ==============================================================================
RATE_LIMIT="40/second"
BURST_PKTS="50 packets"
TRACK_TIME="1m"  # Thời gian theo dõi hành vi IP
BLOCK_TIME="30m" # Thời gian phạt (Giam vào denylist)

# ==============================================================================
# HÀM LƯU CẤU HÌNH VĨNH VIỄN
# ==============================================================================
wptt_nft_save_persistent() {
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  local tmp_nft=""
  tmp_nft="$(mktemp -p /etc/wptt/tmp nftables_save_XXXXXX.conf)"

  {
    printf '#!/usr/sbin/nft -f\n\nflush ruleset\n\n'
    nft list table inet blackblock 2>/dev/null
    printf '\n'
    nft list table inet filter 2>/dev/null
  } >"$tmp_nft"

  if nft -c -f "$tmp_nft" >/dev/null 2>&1; then
    chmod 600 "$tmp_nft"
    /bin/mv -fT "$tmp_nft" /etc/nftables.conf
    [[ -d /etc/sysconfig ]] && ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
    return 0
  else
    /bin/rm -f -- "${tmp_nft:?}"
    return 1
  fi
}

route_flag="${1:-}"
task_msg="Kích hoạt khiên chắn DDoS / SYN Flood trên Nftables"
_runing "$task_msg"

# Kiểm tra môi trường
if ! systemctl is-active --quiet nftables 2>/dev/null || ! nft list table inet blackblock >/dev/null 2>&1; then
  _runloi "$task_msg"
  echo -e "\n${C_RED}❌ Lỗi: Máy chủ chưa kích hoạt kiến trúc Nftables của WPTangToc!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

# 1. Khởi tạo Set danh sách theo dõi (Tracking) và danh sách đen (Denylist) cho cả IPv4 & IPv6
nft add set inet blackblock httpdlist_v4 "{ type ipv4_addr; size 262144; flags dynamic,timeout; timeout $TRACK_TIME; }" >/dev/null 2>&1 || true
nft add set inet blackblock denylist_v4 "{ type ipv4_addr; size 131072; flags dynamic,timeout; timeout $BLOCK_TIME; }" >/dev/null 2>&1 || true

nft add set inet blackblock httpdlist_v6 "{ type ipv6_addr; size 262144; flags dynamic,timeout; timeout $TRACK_TIME; }" >/dev/null 2>&1 || true
nft add set inet blackblock denylist_v6 "{ type ipv6_addr; size 131072; flags dynamic,timeout; timeout $BLOCK_TIME; }" >/dev/null 2>&1 || true

# 2. Tạo chuỗi xử lý SYN Flood (Chèn vào Hook input, chạy ngay sau luật Block vĩnh viễn)
nft add chain inet blackblock synflood_chain '{ type filter hook input priority filter - 5; policy accept; }' >/dev/null 2>&1
nft flush chain inet blackblock synflood_chain >/dev/null 2>&1

# 3. Luật ưu tiên Pass (Cực kỳ quan trọng để không khóa nhầm hệ thống và Bot xịn)
nft add rule inet blackblock synflood_chain iifname "lo" accept >/dev/null 2>&1
nft add rule inet blackblock synflood_chain ct state established,related accept >/dev/null 2>&1

# Đảm bảo set Whitelist tồn tại để Bypass Cloudflare / Google / IP Văn phòng
nft add set inet blackblock whiteaction_v4 '{ type ipv4_addr; flags interval; }' >/dev/null 2>&1 || true
nft add set inet blackblock whiteaction_v6 '{ type ipv6_addr; flags interval; }' >/dev/null 2>&1 || true
nft add rule inet blackblock synflood_chain ip saddr @whiteaction_v4 accept >/dev/null 2>&1
nft add rule inet blackblock synflood_chain ip6 saddr @whiteaction_v6 accept >/dev/null 2>&1

# 4. Chặn lập tức các IP đã bị phạt (Nằm trong Denylist) để tiết kiệm CPU
nft add rule inet blackblock synflood_chain ip saddr @denylist_v4 drop >/dev/null 2>&1
nft add rule inet blackblock synflood_chain ip6 saddr @denylist_v6 drop >/dev/null 2>&1

# 5. LÕI CHỐNG DDOS (Per-IP Rate Limiting):
# Vừa theo dõi đếm số Request, nếu quá giới hạn thì Đẩy thẳng vào Denylist và Drop gói tin ngay tức khắc
nft add rule inet blackblock synflood_chain tcp dport \{ 80, 443 \} ct state new update @httpdlist_v4 \{ ip saddr limit rate over $RATE_LIMIT burst $BURST_PKTS \} add @denylist_v4 \{ ip saddr \} drop >/dev/null 2>&1
nft add rule inet blackblock synflood_chain tcp dport \{ 80, 443 \} ct state new update @httpdlist_v6 \{ ip6 saddr limit rate over $RATE_LIMIT burst $BURST_PKTS \} add @denylist_v6 \{ ip6 saddr \} drop >/dev/null 2>&1

# 6. Lưu vĩnh viễn
if wptt_nft_save_persistent; then
  _rundone "$task_msg"
  wptt_logs "WARN" "Đã BẬT khiên chống DDoS/SYN Flood (Ngưỡng: $RATE_LIMIT, Khóa: $BLOCK_TIME)."
  echo -e "\n${C_GREEN}✔ Thành công! Hệ thống chống DDoS đã kích hoạt và bảo vệ tự động.${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 0 "enter"
else
  _runloi "$task_msg"
  echo -e "\n${C_RED}❌ Lỗi: Cập nhật luật Nftables thất bại.${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi
