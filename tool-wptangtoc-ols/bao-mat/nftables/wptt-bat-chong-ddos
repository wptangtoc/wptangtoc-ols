#!/bin/bash
# @description: Biên dịch và kích hoạt Anti-DDoS Golang (Netlink API Engine) - Hỗ trợ Dual-Stack

export LANG=en_US.UTF-8
stty iutf8 2>/dev/null || true

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

task_msg="Biên dịch Engine Golang và nạp vào Kernel"
_runing "$task_msg"
route_flag="${1:-}"

if ! systemctl is-active --quiet nftables 2>/dev/null || ! nft list table inet blackblock >/dev/null 2>&1; then
  _runloi "$task_msg"
  echo -e "\n${C_RED}❌ Lỗi: Máy chủ chưa kích hoạt kiến trúc Nftables của WPTangToc!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

if ! command -v go >/dev/null 2>&1; then
  if command -v dnf >/dev/null 2>&1; then
    dnf install -y golang >/dev/null 2>&1 || true
  elif command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y golang >/dev/null 2>&1 || true
  fi
fi

src_file="/etc/wptt/bao-mat/nftables/anti.go"
build_dir="/etc/wptt/tmp/anti_ddos_build"
/bin/rm -rf "$build_dir" 2>/dev/null
mkdir -p "$build_dir"
cp -f "$src_file" "$build_dir/anti.go"

# Lấy Public IP an toàn cho cả 2 kiến trúc mạng
vps_ipv4="$(curl -4 -sfL --connect-timeout 3 https://ipv4.icanhazip.com || curl -4 -sfL --connect-timeout 3 https://checkip.amazonaws.com || true)"
vps_ipv6="$(curl -6 -sfL --connect-timeout 3 https://ipv6.icanhazip.com || true)"

inject_ips=""
[[ -n "$vps_ipv4" ]] && inject_ips+="\"$vps_ipv4\": true,\n\t"
[[ -n "$vps_ipv6" ]] && inject_ips+="\"$vps_ipv6\": true,\n\t"

if [[ -n "$inject_ips" ]]; then
  sed -i "s|// IP_VPS_HERE|${inject_ips}// IP_VPS_HERE|g" "$build_dir/anti.go"
fi

cd "$build_dir" || exit 1
export GOPATH="/etc/wptt/tmp/go_path"

go mod init wptt-anti-ddos >/dev/null 2>&1
go get github.com/google/nftables >/dev/null 2>&1

if ! go build -ldflags="-s -w" -o wptt-anti-ddos anti.go >/dev/null 2>&1; then
  _runloi "$task_msg"
  echo -e "\n${C_RED}❌ Lỗi: Biên dịch mã nguồn Golang thất bại. Vui lòng kiểm tra kết nối mạng!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

systemctl stop wptt-anti-ddos.service >/dev/null 2>&1 || true
/bin/rm -f /usr/local/bin/wptt-anti-ddos
/bin/mv -f wptt-anti-ddos /usr/local/bin/
chmod +x /usr/local/bin/wptt-anti-ddos
/bin/rm -rf "$build_dir" "$GOPATH" 2>/dev/null

cat >/etc/systemd/system/wptt-anti-ddos.service <<'EOF'
[Unit]
Description=WPTangToc OLS Golang Anti-DDoS (Netlink)
After=network.target nftables.service lsws.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wptt-anti-ddos
Restart=always
RestartSec=5
User=root
Group=root
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >/dev/null 2>&1
systemctl enable --now wptt-anti-ddos.service >/dev/null 2>&1

_rundone "$task_msg"
wptt_logs "WARN" "Đã BẬT hệ thống chặn DDoS bằng Golang Netlink API."
echo -e "\n${C_GREEN}✔ Thành công! Cỗ máy chém DDoS cấp Kernel đã đi vào hoạt động.${C_RESET}"
wptt_quay_ve_menu "$route_flag" 0 "enter"
