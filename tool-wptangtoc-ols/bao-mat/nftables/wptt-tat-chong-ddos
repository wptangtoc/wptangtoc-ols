#!/bin/bash
# @description: Tắt và gỡ bỏ Anti-DDoS Golang

export LANG=en_US.UTF-8
stty iutf8 2>/dev/null || true

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

task_msg="Gỡ bỏ hệ thống quét Log chặn DDoS"
_runing "$task_msg"
route_flag="${1:-}"

# 1. Dừng và xóa Service
if systemctl is-active --quiet wptt-anti-ddos.service 2>/dev/null || systemctl is-enabled --quiet wptt-anti-ddos.service 2>/dev/null; then
  systemctl stop wptt-anti-ddos.service >/dev/null 2>&1 || true
  systemctl disable wptt-anti-ddos.service >/dev/null 2>&1 || true
fi

/bin/rm -f /etc/systemd/system/wptt-anti-ddos.service
systemctl daemon-reload >/dev/null 2>&1 || true

# 2. Xóa Binary
/bin/rm -f /usr/local/bin/wptt-anti-ddos

# 3. Làm sạch Set Blacklist của Nftables (Giải phóng IP đã bị chặn)
if command -v nft >/dev/null 2>&1; then
  nft flush set inet blackblock blackaction_v4 >/dev/null 2>&1 || true
  nft flush set inet blackblock blackaction_v6 >/dev/null 2>&1 || true
fi

_rundone "$task_msg"
wptt_logs "INFO" "Đã TẮT hệ thống quét Log OLS chặn DDoS bằng Golang."
echo -e "\n${C_GREEN}✔ Đã tắt hệ thống Anti-DDoS và xả bộ đệm danh sách đen thành công.${C_RESET}"
wptt_quay_ve_menu "$route_flag" 0 "enter"
