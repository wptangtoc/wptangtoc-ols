#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Tắt và gỡ bỏ WPTangToc Anti-DDoS Golang (Bảo toàn danh sách chặn vĩnh viễn)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true
umask 077

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

tmp_nft=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${tmp_nft:-}" && -f "$tmp_nft" ]]; then
    case "$tmp_nft" in
      /etc/wptt/tmp/nftables_save_*)
        /bin/rm -f -- "${tmp_nft:?}"
        ;;
    esac
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

wptt_nft_save_persistent() {
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  tmp_nft="$(mktemp -p /etc/wptt/tmp nftables_save_XXXXXX.conf)" || return 1

  {
    printf '#!/usr/sbin/nft -f\n\nflush ruleset\n\n'
    nft list table inet blackblock 2>/dev/null || true
    printf '\n'
    nft list table inet filter 2>/dev/null || true
  } > "$tmp_nft"

  if nft -c -f "$tmp_nft" >/dev/null 2>&1; then
    chmod 600 "$tmp_nft"
    /bin/mv -fT -- "$tmp_nft" /etc/nftables.conf
    tmp_nft=""
    [[ -d /etc/sysconfig ]] && ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
    return 0
  else
    /bin/rm -f -- "${tmp_nft:?}"
    tmp_nft=""
    return 1
  fi
}

route_flag="${1:-}"
task_msg="Gỡ bỏ hệ thống quét Log chặn DDoS Golang"
_runing "$task_msg"

# 1. Dừng và gỡ bỏ Systemd Service
if systemctl is-active --quiet wptt-anti-ddos.service 2>/dev/null || systemctl is-enabled --quiet wptt-anti-ddos.service 2>/dev/null; then
  systemctl stop wptt-anti-ddos.service >/dev/null 2>&1 || true
  systemctl disable wptt-anti-ddos.service >/dev/null 2>&1 || true
fi

/bin/rm -f /etc/systemd/system/wptt-anti-ddos.service
systemctl daemon-reload >/dev/null 2>&1 || true
/bin/rm -f /usr/local/bin/wptt-anti-ddos

# 2. Xóa Rule tham chiếu trước, sau đó xả và xóa Set ddos_v4 / ddos_v6
if command -v nft >/dev/null 2>&1 && nft list table inet blackblock >/dev/null 2>&1; then
  while IFS= read -r handle; do
    [[ -n "$handle" && "$handle" =~ ^[0-9]+$ ]] || continue
    nft delete rule inet blackblock blackblock-chain-input handle "$handle" >/dev/null 2>&1 || true
  done < <(nft -a list chain inet blackblock blackblock-chain-input 2>/dev/null | awk '/@ddos_v4|@ddos_v6/ {print $NF}')

  for s in ddos_v4 ddos_v6; do
    if nft list set inet blackblock "$s" >/dev/null 2>&1; then
      nft flush set inet blackblock "$s" >/dev/null 2>&1 || true
      nft delete set inet blackblock "$s" >/dev/null 2>&1 || true
    fi
  done

  wptt_nft_save_persistent || true
fi

_rundone "$task_msg"
wptt_logs "INFO" "Đã TẮT hệ thống quét Log OLS chặn DDoS bằng Golang."
echo -e "\n${C_GREEN}✔ Đã tắt hệ thống Anti-DDoS và giải phóng bộ đệm ddos_v4/v6 thành công.${C_RESET}"
wptt_quay_ve_menu "$route_flag" 0 "enter"
