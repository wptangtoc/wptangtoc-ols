#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Gỡ bỏ khiên chống SYN Flood / HTTP Flood khỏi Nftables

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8 2>/dev/null || true

# shellcheck source=/dev/null
if [[ -f /etc/wptt/.wptt.conf ]]; then . /etc/wptt/.wptt.conf 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/echo-color ]]; then . /etc/wptt/echo-color 2>/dev/null; fi
# shellcheck source=/dev/null
if [[ -f /etc/wptt/core-functions ]]; then . /etc/wptt/core-functions 2>/dev/null; fi

wptt_nft_save_persistent() {
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  local tmp_nft=""
  tmp_nft="$(mktemp -p /etc/wptt/tmp nftables_save_XXXXXX.conf)"

  {
    printf '#!/usr/sbin/nft -f\n\nflush ruleset\n\n'
    nft list table inet blackblock 2>/dev/null
    printf '\n'
    nft list table inet filter 2>/dev/null
  } > "$tmp_nft"

  if nft -c -f "$tmp_nft" >/dev/null 2>&1; then
    chmod 600 "$tmp_nft"
    /bin/mv -fT "$tmp_nft" /etc/nftables.conf
    [[ -d /etc/sysconfig ]] && ln -sfn /etc/nftables.conf /etc/sysconfig/nftables.conf
    return 0
  else
    /bin/rm -f -- "${tmp_nft:?}"
    return 1
  fi
}

route_flag="${1:-}"
task_msg="Gỡ bỏ khiên chắn DDoS / SYN Flood khỏi hệ thống"
_runing "$task_msg"

# Xóa Chain bảo vệ
nft delete chain inet blackblock synflood_chain >/dev/null 2>&1 || true

# Xóa các bộ nhớ chứa IP đang bị giam lỏng
nft delete set inet blackblock httpdlist_v4 >/dev/null 2>&1 || true
nft delete set inet blackblock denylist_v4 >/dev/null 2>&1 || true
nft delete set inet blackblock httpdlist_v6 >/dev/null 2>&1 || true
nft delete set inet blackblock denylist_v6 >/dev/null 2>&1 || true

if wptt_nft_save_persistent; then
  _rundone "$task_msg"
  wptt_logs "INFO" "Đã TẮT khiên chống DDoS/SYN Flood và xả các IP đang bị phạt."
  echo -e "\n${C_GREEN}✔ Thành công! Đã tắt tính năng chống DDoS.${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 0 "enter"
else
  _runloi "$task_msg"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi
