#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

# ==============================================================================
# BẢO MẬT ENTERPRISE: TẠO WORKSPACE AN TOÀN & DỌN DẸP TỰ ĐỘNG
# ==============================================================================
mkdir -p /etc/wptt/tmp 2>/dev/null
TMP_WORKSPACE=$(mktemp -d -p "/etc/wptt/tmp" csf_country.XXXXXX) || {
  echo "Lỗi: Không thể tạo thư mục tạm"
  exit 1
}
trap 'rm -rf "$TMP_WORKSPACE"' EXIT

function huong_dan() {
  cat <<'EOF'
 Tính năng Thiết lập chặn hết quốc gia ngoại trừ quốc gia cụ thể được phép CSF trong WPTangToc OLS là một cấu hình bảo mật rất nghiêm ngặt của tường lửa ConfigServer Security &
 Firewall [CSF]. Thay vì liệt kê các quốc gia bị cấm, bạn sẽ chỉ định một danh sách các quốc gia DUY NHẤT được phép truy cập vào máy chủ của mình
 tất cả các quốc gia khác sẽ tự động bị chặn.

 🌍 Cơ chế hoạt động
 CSF sẽ chỉ chấp nhận kết nối từ các địa chỉ IP thuộc những quốc gia này và từ chối tất cả kết nối từ các quốc gia còn lại.

 🎯 Mục đích của việc áp dụng chính sách chỉ cho phép
 * Bảo mật Tối đa cho Đối tượng Mục tiêu Hẹp: Rất lý tưởng nếu website hoặc dịch vụ của bạn chỉ phục vụ người dùng ở một số ít quốc gia cụ thể.
 * Kiểm soát Địa lý Nghiêm ngặt: Đảm bảo rằng chỉ người dùng từ các vùng địa lý được ủy quyền mới có thể truy cập dịch vụ.
 * Giảm thiểu Tối đa Lưu lượng Rác: Chặn đứng phần lớn lưu lượng truy cập không mong muốn, spam, bot.

 Ghi chú: Tính năng này luôn bypass những ip của google, cloudflare, bing sẽ không bao giờ bị chặn.

 Tính năng này cung cấp mức độ kiểm soát truy cập địa lý cao nhất nhưng đòi hỏi sự hiểu biết và cẩn trọng tối đa.
EOF
}

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ BẢO MẬT ➜ CSF Firewall ➜ Chỉ cho phép quốc gia truy cập${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [ ! -f /etc/csf/csf.conf ]; then
  echoDo "Bạn chưa cài đặt CSF"
  exec /etc/wptt/bao-mat/csf-main 1
fi

countryblicklist=$(grep "^CC_ALLOW_FILTER[[:space:]]*=" /etc/csf/csf.conf | awk -F'"' '{print $2}')
if [ -z "$countryblicklist" ]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}Hiện tại CSF Firewall chưa thiết lập tính năng chặn quốc gia.${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

echo "Sử dụng chức năng này để block một số quốc gia được truy cập website trên server."
echo "-------------------------------------------------------------------------"
echo "Bạn cần nhập mã quốc gia gồm 2 chữ cái. Bạn có thể nhập nhiều đất nước bằng cách"
echo "-------------------------------------------------------------------------"
echo "sử dụng dấu phảy [,] và không có dấu cách [space] giữa các mã nước. VD: PK,CN,RU,DE "
echo "-------------------------------------------------------------------------"
echo "Để chặn quốc gia Pakistan, China, Russia, Germany."
echo "-------------------------------------------------------------------------"
echo "========================================================================="
read -rp "Nhập mã nước [0 = Thoát] [99 = Xem mã quốc gia]: " countrycode

if [[ "$countrycode" == '99' ]]; then
  sed 's/|$//g; s/|/==> /g' /etc/wptt/bao-mat/csf/quoc-gia-ma-code-csf
  echo -n "Nhập mã nước [0 = Thoát]: "
  read -r countrycode
fi

if [[ -z "$countrycode" || "$countrycode" == '0' ]]; then
  exec /etc/wptt/bao-mat/csf-main 1
fi

# Chuyển đổi mã thành chữ hoa, xóa khoảng trắng và các ký tự thừa
countrycode=$(echo "$countrycode" | tr '[:lower:]' '[:upper:]' | tr -d ' ' | sed 's/\///g; s/,$//')

# Tách chuỗi thành mảng để xử lý RAM (Không dùng File)
IFS=',' read -ra CODE_ARRAY <<<"$countrycode"
declare -A seen_codes
TMP_SHOW_FILE="$TMP_WORKSPACE/show_quoc_gia.txt"

for manuoc in "${CODE_ARRAY[@]}"; do
  if [[ ${#manuoc} -ne 2 ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc không tồn tại (Phải gồm 2 ký tự)."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  # Lấy tên nước từ file từ điển
  country_name=$(grep "|${manuoc}|" /etc/wptt/bao-mat/csf/quoc-gia-ma-code-csf | sed "s/|${manuoc}|//")

  if [[ -z "$country_name" ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc không tồn tại trong hệ thống."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  # Chống nhập trùng code
  if [[ -n "${seen_codes[$manuoc]}" ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc xuất hiện nhiều hơn 1 lần trong danh sách."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  seen_codes[$manuoc]=1
  echo "$country_name" >>"$TMP_SHOW_FILE"
done

sonuoc=${#CODE_ARRAY[@]}
if [[ "$sonuoc" -gt 1 ]]; then
  hoithoai1="Danh sách các nước được phép truy cập bởi CSF Firewall:"
  hoithoai2="Bạn muốn chặn toàn bộ các nước ngoại trừ $sonuoc nước trong danh sách này?"
else
  hoithoai1="Bạn muốn chặn tất cả các nước, chỉ cho phép quốc gia này truy cập bởi CSF Firewall:"
  hoithoai2="Bạn muốn chặn tất cả các quốc gia ngoại trừ quốc gia này?"
fi

echo "========================================================================="
echo "$hoithoai1"
echo "-------------------------------------------------------------------------"
pr -2 -t "$TMP_SHOW_FILE"
echo "========================================================================="
echo "$hoithoai2"

dongy="n"
options=("Đồng ý" "Không đồng ý")
PS3="Nhập lựa chọn của bạn [1-2]: "
select opt in "${options[@]}"; do
  case "$REPLY" in
  1)
    dongy="y"
    break
    ;;
  2)
    dongy="n"
    break
    ;;
  *)
    printf "\nBạn nhập sai, hệ thống sẽ chọn là không đồng ý\n"
    break
    ;;
  esac
done

if [[ "$dongy" == 'y' ]]; then
  _runing "Chặn toàn bộ quốc gia, chỉ cho phép: $countrycode"

  # ==========================================================================
  # CẬP NHẬT ATOMIC CSF.CONF
  # ==========================================================================
  TMP_CSF_CONF="$TMP_WORKSPACE/csf.conf"
  \cp -fp /etc/csf/csf.conf "$TMP_CSF_CONF"
  sed -i "s/^CC_ALLOW_FILTER[[:space:]]*=.*/CC_ALLOW_FILTER = \"$countrycode\"/g" "$TMP_CSF_CONF"
  \mv -fT "$TMP_CSF_CONF" /etc/csf/csf.conf

  _rundone "Chặn toàn bộ quốc gia, chỉ cho phép: $countrycode"
  _runing "Đang cấu hình Auto Bypass cho Cloudflare, Google, Bing..."

  # ==========================================================================
  # TỐI ƯU CẬP NHẬT BYPASS IP - THÊM VÀO FILE ALLOW ATOMIC
  # ==========================================================================
  TMP_ALLOW="$TMP_WORKSPACE/csf.allow"
  /bin/cp -fp /etc/csf/csf.allow "$TMP_ALLOW"

  # Khởi tạo thư viện JQ nếu thiếu
  if ! command -v jq >/dev/null 2>&1; then
    dnf install jq -y >/dev/null 2>&1
  fi

  echo "# --- Tự động Bypass WPTangToc OLS ---" >>"$TMP_ALLOW"

  # Cloudflare Bypass
  curl -s --max-time 10 https://www.cloudflare.com/ips-v4 | while read -r ip; do
    if [[ -n "$ip" ]] && ! grep -q "^$ip" "$TMP_ALLOW"; then
      echo "$ip # Cloudflare IP" >>"$TMP_ALLOW"
    fi
  done

  # Google Bypass (Tối ưu jq)
  curl -s --max-time 10 https://developers.google.com/static/search/apis/ipranges/googlebot.json | jq -r '.prefixes[].ipv4Prefix // empty' | while read -r ip; do
    if [[ -n "$ip" ]] && ! grep -q "^$ip" "$TMP_ALLOW"; then
      echo "$ip # GoogleBot IP" >>"$TMP_ALLOW"
    fi
  done

  # Bing Bypass (Tối ưu jq)
  curl -s --max-time 10 https://www.bing.com/toolbox/bingbot.json | jq -r '.prefixes[].ipv4Prefix // empty' | while read -r ip; do
    if [[ -n "$ip" ]] && ! grep -q "^$ip" "$TMP_ALLOW"; then
      echo "$ip # BingBot IP" >>"$TMP_ALLOW"
    fi
  done

  # Gmail SMTP Bypass
  if ! grep -q "^74.125.0.0/16" "$TMP_ALLOW"; then
    echo "74.125.0.0/16 # Gmail SMTP" >>"$TMP_ALLOW"
  fi

  /bin/mv -fT "$TMP_ALLOW" /etc/csf/csf.allow

  csf -x >/dev/null 2>&1
  csf -e >/dev/null 2>&1
  systemctl reload csf >/dev/null 2>&1 || systemctl restart csf >/dev/null 2>&1
  systemctl restart lfd >/dev/null 2>&1

  _rundone "Cấu hình Bypass hoàn tất."
fi

check_menu_wptangtoc_active=$1
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/bao-mat/csf-main 1
fi
