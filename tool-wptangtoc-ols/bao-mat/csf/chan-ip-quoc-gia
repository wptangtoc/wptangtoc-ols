#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

mkdir -p /etc/wptt/tmp 2>/dev/null
TMP_WORKSPACE=$(mktemp -d -p "/etc/wptt/tmp" csf_deny.XXXXXX) || {
  echo "Lỗi: Không thể tạo thư mục tạm"
  exit 1
}
trap 'rm -rf "$TMP_WORKSPACE"' EXIT

function huong_dan() {
  cat <<'EOF'
 Tính năng Thiết lập chặn quốc gia CSF trong WPTangToc OLS cho phép bạn sử dụng tường lửa ConfigServer Security & Firewall [CSF] để cấm hoàn toàn truy cập từ các vùng lãnh thổ cụ thể.

 🌍 Cơ chế hoạt động
 CSF sẽ tự động từ chối (Drop) tất cả các gói tin đến từ danh sách mã quốc gia (Country Code) mà bạn cấu hình trong biến CC_DENY.

 🎯 Mục đích của việc áp dụng chính sách chặn quốc gia
 * Giảm thiểu DDoS và Botnet: Chặn đứng các đợt tấn công dò quét mật khẩu, spam từ các quốc gia thường xuyên phát tán mã độc.
 * Tối ưu tài nguyên: Loại bỏ truy cập từ các khu vực địa lý không nằm trong tệp khách hàng mục tiêu, giúp tiết kiệm băng thông và giảm tải cho máy chủ.
EOF
}

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ BẢO MẬT ➜ CSF Firewall ➜ Chặn Quốc Gia${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [ ! -f /etc/csf/csf.conf ]; then
  echoDo "Bạn chưa cài đặt CSF"
  exec /etc/wptt/bao-mat/csf-main 1
fi

countryblicklist=$(grep "^CC_DENY[[:space:]]*=" /etc/csf/csf.conf | awk -F'"' '{print $2}')
if [ -z "$countryblicklist" ]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}Hiện tại CSF Firewall không chặn quốc gia nào.${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

echo "Sử dụng chức năng này để block một số quốc gia truy cập website trên server."
echo "-------------------------------------------------------------------------"
echo "Bạn cần nhập mã quốc gia gồm 2 chữ cái. Bạn có thể nhập nhiều đất nước bằng cách"
echo "-------------------------------------------------------------------------"
echo "sử dụng dấu phảy [,] và không có dấu cách [space] giữa các mã nước. VD: PK,CN,RU,DE "
echo "-------------------------------------------------------------------------"
echo "Để chặn quốc gia Pakistan, China, Russia, Germany."
echo "-------------------------------------------------------------------------"
echo "========================================================================="
read -rp "Nhập mã nước [0 = Thoát] [99 = Xem mã quốc gia]: " countrycode

if [[ "$countrycode" == '99' ]]; then
  sed 's/|$//g; s/|/==> /g' /etc/wptt/bao-mat/csf/quoc-gia-ma-code-csf
  echo -n "Nhập mã nước [0 = Thoát]: "
  read -r countrycode
fi

if [[ -z "$countrycode" || "$countrycode" == '0' ]]; then
  exec /etc/wptt/bao-mat/csf-main 1
fi

# Chuẩn hóa đầu vào: Chuyển chữ hoa, xóa khoảng trắng và ký tự xuyệt
countrycode=$(echo "$countrycode" | tr '[:lower:]' '[:upper:]' | tr -d ' ' | sed 's/\///g; s/,$//')

# Tách chuỗi thành mảng để xử lý trên RAM (Không dùng File)
IFS=',' read -ra CODE_ARRAY <<<"$countrycode"
declare -A seen_codes
TMP_SHOW_FILE="$TMP_WORKSPACE/show_quoc_gia.txt"

for manuoc in "${CODE_ARRAY[@]}"; do
  if [[ ${#manuoc} -ne 2 ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc không tồn tại (Phải gồm 2 ký tự)."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  # Lấy tên nước từ file từ điển
  country_name=$(grep "|${manuoc}|" /etc/wptt/bao-mat/csf/quoc-gia-ma-code-csf | sed "s/|${manuoc}|//")

  if [[ -z "$country_name" ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc không tồn tại trong hệ thống."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  # Chống nhập trùng code
  if [[ -n "${seen_codes[$manuoc]}" ]]; then
    clear
    echo "========================================================================= "
    echo "Lỗi: Mã nước $manuoc xuất hiện nhiều hơn 1 lần trong danh sách."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy nhập lại !"
    exec /etc/wptt/bao-mat/csf-main 1
    exit
  fi

  seen_codes[$manuoc]=1
  echo "$country_name" >>"$TMP_SHOW_FILE"
done

sonuoc=${#CODE_ARRAY[@]}
if [[ "$sonuoc" -gt 1 ]]; then
  hoithoai1="Danh sách các nước bạn muốn chặn bởi CSF Firewall:"
  hoithoai2="Bạn chắc chắn muốn chặn $sonuoc nước trong danh sách?"
else
  hoithoai1="Nước bạn muốn chặn bởi CSF Firewall:"
  hoithoai2="Bạn chắc chắn muốn chặn đất nước này?"
fi

echo "========================================================================="
echo "$hoithoai1"
echo "-------------------------------------------------------------------------"
pr -2 -t "$TMP_SHOW_FILE"
echo "========================================================================="
echo "$hoithoai2"

dongy="n"
options=("Đồng ý" "Không đồng ý")
PS3="Nhập lựa chọn của bạn [1-2]: "
select opt in "${options[@]}"; do
  case "$REPLY" in
  1)
    dongy="y"
    break
    ;;
  2)
    dongy="n"
    break
    ;;
  *)
    printf "\nBạn nhập sai, hệ thống sẽ chọn là không đồng ý\n"
    break
    ;;
  esac
done

if [[ "$dongy" == 'y' ]]; then
  _runing "Đang cấu hình chặn các quốc gia truy cập: $countrycode"

  # ==========================================================================
  # CẬP NHẬT ATOMIC CSF.CONF
  # ==========================================================================
  TMP_CSF_CONF="$TMP_WORKSPACE/csf.conf"
  \cp -fp /etc/csf/csf.conf "$TMP_CSF_CONF"

  sed -i "s/^CC_DENY[[:space:]]*=.*/CC_DENY = \"$countrycode\"/g" "$TMP_CSF_CONF"

  \mv -fT "$TMP_CSF_CONF" /etc/csf/csf.conf

  _rundone "Hoàn tất chặn các quốc gia truy cập: $countrycode"

  # Nạp lại cấu hình an toàn thay vì Stop/Start
  csf -r >/dev/null 2>&1
  systemctl reload lfd >/dev/null 2>&1 || systemctl restart lfd >/dev/null 2>&1
fi

check_menu_wptangtoc_active=$1
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/bao-mat/csf-main 1
fi
