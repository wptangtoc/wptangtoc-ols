    fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH FAIL2BAN WP-ADMIN${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if [[ -f "$filter_path" ]]; then
      left_text "  Website ${NAME} hiện ĐANG BẬT chống Brute Force." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) TẮT bảo vệ (Gỡ bỏ chặn IP - Không khuyến nghị)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT bảo vệ${C_RESET} (Gỡ bỏ chặn IP - Không khuyến nghị)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên khóa bảo vệ)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
