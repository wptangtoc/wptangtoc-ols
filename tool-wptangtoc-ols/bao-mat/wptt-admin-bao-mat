# ==============================================================================
# HÀM CHỌN WEBSITE CÓ HIỂN THỊ TRẠNG THÁI
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -At /etc/wptt/vhost 2>/dev/null | grep -v '^\.\.conf$' | sort -uV)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
        local domain_fail2ban="${domain//[-._]/wp}"
        local filter_path="/etc/fail2ban/filter.d/wordpress-dangnhap-$domain_fail2ban.conf"
        
        local status_text=""
        local status_color=""

        if [[ -f "$filter_path" ]]; then
          status_text="[Đang BẬT - An toàn]"
          status_color=$C_GREEN
        else
          status_text="[Đang TẮT - Chưa bảo vệ]"
          status_color=$C_RED
        fi

        selects+=("$domain|$status_text|$status_color")
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Hệ thống chưa có Website WordPress nào để cấu hình!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Trạng thái hiện tại & Chọn Website muốn thao tác:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Bật / Tắt chống Brute Force cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Bật / Tắt chống Brute Force cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0) exec /etc/wptt/wptt-bao-mat-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ truyền đối số cho 1 domain cụ thể
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# HÀM CÀI ĐẶT GÓI PHỤ THUỘC (Chạy 1 lần duy nhất)
# ==============================================================================
function install_dependencies() {
  _runing "Kiểm tra và cài đặt gói phụ thuộc Fail2ban..."
  if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
    if ! dpkg -s python3-pyinotify ipset >/dev/null 2>&1; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get update >/dev/null 2>&1
      apt-get install -y python3-pyinotify ipset >/dev/null 2>&1
    fi
  else
    if ! rpm -q python3-inotify ipset >/dev/null 2>&1; then
      dnf install -y python3-inotify ipset >/dev/null 2>&1
    fi
  fi
  _rundone "Kiểm tra gói phụ thuộc Fail2ban"
}

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

# ==============================================================================
# HÀM THỰC THI BẬT/TẮT BRUTE FORCE CHO 1 DOMAIN
# ==============================================================================
function process_bruteforce() {
  local target_domain=$1
  local action=$2 # "bat" hoac "tat"
  local domain_fail2ban="${target_domain//[-._]/wp}"
  local filter_path="/etc/fail2ban/filter.d/wordpress-dangnhap-$domain_fail2ban.conf"
  local vhost_conf="/usr/local/lsws/conf/vhosts/$target_domain/$target_domain.conf"

  if [[ "$action" == "bat" ]]; then
    [[ -f "$filter_path" ]] && return

    UI_STRING="Kích hoạt chống Brute Force cho $target_domain"
    _runing "$UI_STRING"


	# Kiểm tra Cloudflare CDN (Chống khóa nhầm IP Cloudflare)
	local TRACE_OUTPUT=$(curl -Is --connect-timeout 5 --max-time 10 "https://$target_domain/cdn-cgi/trace" 2>/dev/null)
	if grep -Eqi 'cloudflare|cf-ray' <<< "$TRACE_OUTPUT"; then #check xem có đang sử dụng CDN cloudflare không
		if ! grep -q '103.21.244.0' /usr/local/lsws/conf/httpd_config.conf 2>/dev/null; then
			echo -en "\033[1A\033[2K\r" #xoá dùng runing ở trên
			echo -e "\n\033[1;31m[CẢNH BÁO] Phát hiện $target_domain dùng Cloudflare CDN nhưng chưa bật Real IP!\033[0m"
			echo "Vui lòng bật tính năng Hiện thị IP Log Real bypass Cloudflare CDN trước khi dùng chức năng này để tránh chặn nhầm IP."
			if ! wptt_xac_nhan "Bạn có muốn kích hoạt tính năng Cloudflare Real IP không?" "Tính năng này để xác định đúng địa chi ip client" "Khi dùng cloudflare cdn" "Đồng ý kích hoạt" "Hủy thao tác"; then
				[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
				exit 0
			else
				_runing "Kích hoạt Cloudflare show real IP"
				. /etc/wptt/cloudflare-cdn-ip-show-real >/dev/null 2>&1
				_rundone "Kích hoạt Cloudflare show real IP"
				_runing "$UI_STRING"
			fi
		fi
	fi


    # 1. Tách biệt Access Log cho Vhost để Fail2ban đọc
    if ! grep -q 'accesslog' "$vhost_conf" 2>/dev/null; then
      sed -i '/^errorlog /,/^}$/d' "$vhost_conf"
      sed -i '/^accesslog /,/^}$/d' "$vhost_conf"
      cat <<EOF >>"$vhost_conf"

errorlog \$VH_ROOT/logs/error.log {
  useServer               1
  logLevel                ERROR
  rollingSize             10M
}

accesslog \$VH_ROOT/logs/access.log {
  useServer               0
  rollingSize             10M
  keepDays                30
  compressArchive         1
}
EOF
    fi

    mkdir -p "/usr/local/lsws/$target_domain/logs"
    chown -R nobody:$tuong_thich_nhom_litespeed "/usr/local/lsws/$target_domain/logs"
    chmod 700 "/usr/local/lsws/$target_domain/logs"

    # 2. Xử lý logic tên Rule
    local rule_fail2ban_name="wp-admin-$domain_fail2ban"
    if ((${#rule_fail2ban_name} > 20)); then
      rule_fail2ban_name=$(echo "$rule_fail2ban_name" | cut -c 1-20)
    fi

    # 3. Phân luồng Action Tường lửa
    local action_thuc_thi_block=""
    if [[ -f /etc/csf/csf.conf ]]; then
      action_thuc_thi_block="iptables-multiport[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
          iptables-multiport[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
    elif [[ $(systemctl status nftables.service 2>/dev/null | grep -i 'Active' | grep -o 'active') == "active" ]]; then
      action_thuc_thi_block="nftables-allports[name=$rule_fail2ban_name]"
    else
      action_thuc_thi_block="firewallcmd-ipset[actname=block-tcp, name=$rule_fail2ban_name-t, port=\"80,443\", protocol=\"tcp\"]
          firewallcmd-ipset[actname=block-udp, name=$rule_fail2ban_name-u, port=\"80,443\", protocol=\"udp\"]"
    fi

    # 4. Ghi cấu hình Fail2ban
    cat <<EOF >>"/etc/fail2ban/jail.local"

#begin-wordpress-dangnhap-$domain_fail2ban
[$rule_fail2ban_name]
enabled = true
action = $action_thuc_thi_block
filter = wordpress-dangnhap-$domain_fail2ban
logpath = /usr/local/lsws/$target_domain/logs/access.log
backend = pyinotify
bantime = 7200
maxretry = 3
findtime = 300
#end-wordpress-dangnhap-$domain_fail2ban
EOF

    echo '[Definition]
failregex = ^<HOST> .* "POST \/+wp-login\.php HTTP\/.*" 200' >"$filter_path"

    echo "Kích hoạt Brute Force website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"

  elif [[ "$action" == "tat" ]]; then
    [[ ! -f "$filter_path" ]] && return

    UI_STRING="Tắt (Hủy) chống Brute Force cho $target_domain"
    _runing "$UI_STRING"

    # 1. Gỡ Log (Chỉ gỡ nếu người dùng không chủ động giữ log)
    bat_log_domain=""
    [[ -f "/etc/wptt/vhost/.$target_domain.conf" ]] && . "/etc/wptt/vhost/.$target_domain.conf"

    if [[ -z "$bat_log_domain" ]]; then
      sed -i '/^errorlog /,/^}$/d' "$vhost_conf"
      sed -i '/^accesslog /,/^}$/d' "$vhost_conf"
      rm -rf "/usr/local/lsws/${target_domain:?}/logs"
    fi

    if [[ ! -d "/usr/local/lsws/logs" ]]; then
      mkdir -p /usr/local/lsws/logs
      chown root:nobody /usr/local/lsws/logs
    fi

    # 2. Xóa cấu hình Fail2ban
    rm -f "${filter_path:?}"
    sed -i "/^#begin-wordpress-dangnhap-$domain_fail2ban/,/^#end-wordpress-dangnhap-$domain_fail2ban$/d" /etc/fail2ban/jail.local

    echo "Tắt Brute Force website $target_domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    _rundone "$UI_STRING"
  fi
}

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""
thao_tac_thanh_cong=false

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  
  # NẾU DÙNG CLI ĐỐI SỐ -> BỎ QUA HỎI ĐÁP
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="BẬT bảo vệ Brute Force"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="TẮT bảo vệ Brute Force"
  else
    # NẾU CHỌN TỪ MENU UI (SỐ TÙY CHỌN CUỐI CÙNG) -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CHỐNG BRUTE FORCE FAIL2BAN${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác cấu hình bảo vệ wp-admin cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT chống Brute Force (Bảo vệ an toàn đồng loạt)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT chống Brute Force${C_RESET} (Bảo vệ an toàn đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) TẮT chống Brute Force (Gỡ bỏ bảo vệ đồng loạt)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT chống Brute Force${C_RESET} (Gỡ bỏ bảo vệ đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice
    
    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="BẬT bảo vệ Brute Force"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="TẮT bảo vệ Brute Force"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi

  # Quét toàn bộ danh sách domain để thực thi
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  pathcheck="/etc/wptt/vhost/.$NAME.conf"

  [[ ! -f "$pathcheck" ]] && echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-bao-mat-main 1

