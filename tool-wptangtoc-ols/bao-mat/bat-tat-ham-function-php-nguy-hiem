function huong_dan() {
  Kích hoạt hoặc huỷ kích hoạt chặn thực thi những hàm nguy hiểm về bảo mật PHP:
  Kích hoạt hoặc huỷ kích hoạt chặn thực thi những hàm nguy hiểm về bảo mật PHP [Cấp độ Toàn Cục]:

  Chặn các hàm PHP như exec, system, passthru, shell_exec, dl, show_source, và các hàm posix_* khác là một biện pháp bảo mật quan trọng trên máy chủ web. Việc này giúp ngăn chặn các cuộc tấn công tiềm ẩn, đặc biệt khi chạy các ứng dụng PHP có thể chứa lỗ hổng.

  Gồm những hàm: exec,system,passthru,shell_exec,dl,show_source,posix_kill,posix_mkfifo,posix_getpwuid,posix_setpgid,posix_setsid,posix_setuid,posix_setgid,posix_seteuid,posix_setegid,posix_uname

  Tại sao cần chặn các hàm này?
  Các hàm bạn liệt kê có khả năng thực hiện những tác vụ nhạy cảm, có thể bị lạm dụng nếu mã PHP bị xâm nhập hoặc chứa lỗ hổng:

  Thực thi lệnh hệ thống:
  * exec[], system[], passthru[], shell_exec[]: Cho phép PHP chạy các lệnh trực tiếp trên hệ điều hành của máy chủ. Nếu kẻ tấn công kiểm soát được đầu vào của các hàm này, họ có thể thực thi mã độc, chiếm quyền kiểm soát máy chủ.
  * Tải thư viện động và hiển thị mã nguồn:
  * dl[]: Cho phép tải các phần mở rộng PHP động trong lúc chạy. Kẻ tấn công có thể dùng nó để tải mã độc. [Hàm này thường bị vô hiệu hóa mặc định ở các phiên bản PHP mới hơn].
  * show_source[] [còn gọi là highlight_file[]]: Hiển thị mã nguồn của một tệp PHP. Kẻ tấn công có thể lợi dụng để xem mã nguồn, tìm kiếm lỗ hổng.
  * Quản lý tiến trình và thông tin POSIX:
  * Các hàm posix_* [như posix_kill, posix_setuid, posix_getpwuid, posix_uname]: Cung cấp khả năng tương tác sâu với hệ điều hành dựa trên POSIX, bao gồm việc kết thúc tiến trình, thay đổi quyền sở hữu của tiến trình, hoặc thu thập thông tin chi tiết về hệ thống và người dùng. Việc lạm dụng các hàm này có thể dẫn đến leo thang đặc quyền hoặc phá hoại hệ thống.

  Tác động
  * Tăng cường bảo mật: Giảm đáng kể nguy cơ máy chủ bị tấn công qua các lỗ hổng trong mã PHP hoặc khi kẻ tấn công tìm cách thực thi mã tùy ý.
  * Có thể ảnh hưởng đến một số ứng dụng: Một số plugin, theme hoặc ứng dụng PHP hợp lệ có thể sử dụng các hàm này cho các chức năng cụ thể [ví dụ: một số plugin backup có thể dùng shell_exec]. Nếu bạn chặn chúng, các ứng dụng đó có thể không hoạt động đúng cách. Trong trường hợp này, bạn cần cân nhắc kỹ giữa bảo mật và tính năng, hoặc tìm giải pháp thay thế an toàn hơn.

  Ghi chú: khi bật có thể bị lỗi một số tính năng bạn vui lòng kiểm tra kỹ trước khi triển khai.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78
FUNCS_LIST="exec,system,passthru,shell_exec,dl,show_source,posix_kill,posix_mkfifo,posix_getpwuid,posix_setpgid,posix_setsid,posix_setuid,posix_setgid,posix_seteuid,posix_setegid,posix_uname,proc_open,popen"

# Kiểm tra OS một lần duy nhất để xác định đường dẫn php.ini
OS_UBUNTU=0
grep -qi "ubuntu" /etc/os-release 2>/dev/null && OS_UBUNTU=1

# ==============================================================================
# XỬ LÝ ĐỐI SỐ CLI (AUTO MODE)
# Cách gọi: wptt-chan-ham-php all on | lsphp81 off
# ==============================================================================
if [[ -n "${1:-}" && "$1" != "98" && "$1" != "99" ]]; then
  TARGET_PHP="$1"
  TARGET_ACTION="${2:-}"
  
  if [[ "$TARGET_PHP" == "all" ]]; then
    PHP_DIRS=(/usr/local/lsws/lsphp*/)
  else
    PHP_DIRS=("/usr/local/lsws/$TARGET_PHP/")
  fi

  for dir in "${PHP_DIRS[@]}"; do
    [[ ! -d "$dir" ]] && continue
    php_name=$(basename "$dir")
    [[ "$php_name" == "lsphp73" || "$php_name" == "lsphp74" ]] && continue

    num_ver=${php_name#lsphp}
    ver_len=${#num_ver}
    phien_ban_php_co_cham="${num_ver:0:$ver_len-1}.${num_ver: -1}"

    if [[ "$OS_UBUNTU" == 1 ]]; then
      ini_path="$dir/etc/php/$phien_ban_php_co_cham/litespeed/php.ini"
    else
      ini_path="$dir/etc/php.ini"
    fi

    if [[ -f "$ini_path" ]]; then
      sed -i '/^disable_functions[ \t]*=/d' "$ini_path"
      if [[ "$TARGET_ACTION" == "on" ]]; then
        echo "disable_functions = $FUNCS_LIST" >> "$ini_path"
        echo -e "   ${C_GREEN}➜ Đã BẬT chặn hàm nguy hiểm cho $php_name (php.ini)${C_RESET}"
      elif [[ "$TARGET_ACTION" == "off" ]]; then
        echo -e "   ${C_YELLOW}➜ Đã TẮT chặn hàm nguy hiểm cho $php_name (php.ini)${C_RESET}"
      fi
    fi
  done
  
  wptt_smart_reload_lsws >/dev/null 2>&1
  killall -9 lsphp 2>/dev/null
  return 0 2>/dev/null || exit 0
fi

clear
print_border_top "$C_CYAN"
center_text "${C_YELLOW}${bao_mat} ➜ Bật / Tắt chặn Hàm nguy hiểm (Toàn Cục)${C_RESET}" "$C_CYAN"
print_border_bot "$C_CYAN"
echo ""

# ==============================================================================
# QUÉT VÀ HIỂN THỊ DANH SÁCH PHP
# ==============================================================================
function lua_chon_PHP_BaoMat() {
  unset LSPHP selects
  selects=()

  for dir in /usr/local/lsws/lsphp*/; do
    [[ ! -d "$dir" ]] && continue

    local php_name=$(basename "$dir")
    [[ "$php_name" == "lsphp73" || "$php_name" == "lsphp74" ]] && continue

    local num_ver=${php_name#lsphp}
    local ver_len=${#num_ver}
    local phien_ban_php_co_cham="${num_ver:0:$ver_len-1}.${num_ver: -1}"

    local duong_dan_php_ini=""
    if [[ "$OS_UBUNTU" == 1 ]]; then
      duong_dan_php_ini="$dir/etc/php/$phien_ban_php_co_cham/litespeed/php.ini"
    else
      duong_dan_php_ini="$dir/etc/php.ini"
    fi

    if [[ -f "$duong_dan_php_ini" ]]; then
      local block_stt="0"
      grep -qE '^disable_functions.*exec' "$duong_dan_php_ini" 2>/dev/null && block_stt="1"
      selects+=("$php_name|PHP $phien_ban_php_co_cham|$block_stt|$duong_dan_php_ini")
    fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "${C_RED}❌ Không tìm thấy phiên bản PHP 8.0+ nào trên hệ thống!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  if [[ ${#selects[@]} -ge 2 ]]; then
    selects+=("all|TẤT CẢ CÁC PHIÊN BẢN PHP (Thao tác đồng loạt)|-1|none")
  fi

  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}Trạng thái Bảo Mật hiện tại & Chọn phiên bản PHP:${C_RESET}" "$C_CYAN"
  print_border_mid "$C_CYAN"

  local i=1
  for item in "${selects[@]}"; do
    local p_name=$(echo "$item" | cut -d'|' -f1)
    local p_ver=$(echo "$item" | cut -d'|' -f2)
    local p_stt=$(echo "$item" | cut -d'|' -f3)

    if [[ "$p_name" == "all" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_text=$(printf "  %3d) [ĐỒNG LOẠT] %s" "$i" "$p_ver")
      local item_text=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] %s" "$i" "$p_ver")
      local pad=$((box_inner_width - ${#clean_text}))
      [[ $pad -lt 0 ]] && pad=0
      printf "${C_CYAN}│${C_RESET}%b%*s${C_CYAN}│${C_RESET}\n" "$item_text" "$pad" ""
    else
      local color_stt="${C_GREEN}[Đang BẬT chặn - An Toàn]${C_RESET}"
      local clean_stt="[Đang BẬT chặn - An Toàn]"

      if [[ "$p_stt" == "0" ]]; then
        color_stt="${C_RED}[Đang TẮT chặn - Nguy Hiểm]${C_RESET}"
        clean_stt="[Đang TẮT chặn - Nguy Hiểm]"
      fi

      local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-25s${C_RESET} %s" "$i" "$p_ver" "$color_stt")
      local clean_text=$(printf "  %3d) %-25s %s" "$i" "$p_ver" "$clean_stt")
      local pad=$((box_inner_width - ${#clean_text}))
      [[ $pad -lt 0 ]] && pad=0

      printf "${C_CYAN}│${C_RESET}%b%*s${C_CYAN}│${C_RESET}\n" "$item_text" "$pad" ""
    fi
    ((i++))
  done
  print_border_bot "$C_CYAN"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true

  local PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
  $fzf_installed && PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0)
      LSPHP="0"
      return 0
      ;;
    00)
      if $fzf_installed; then
        local selected_item=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm PHP >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
        local extracted_data=$(echo "$selected_item" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//')
        if [[ -n "$extracted_data" ]]; then
          LSPHP=$(echo "$extracted_data" | cut -d'|' -f1)
          PHP_VER_DISPLAY=$(echo "$extracted_data" | cut -d'|' -f2)
          PHP_CURRENT_STT=$(echo "$extracted_data" | cut -d'|' -f3)
          PHP_INI_PATH=$(echo "$extracted_data" | cut -d'|' -f4)
          return 0
        else
          echo -e "${C_YELLOW}Đã hủy chọn.${C_RESET}"
        fi
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local action_index=$((REPLY - 1))
        local extracted_data="${selects[$action_index]}"
        LSPHP=$(echo "$extracted_data" | cut -d'|' -f1)
        PHP_VER_DISPLAY=$(echo "$extracted_data" | cut -d'|' -f2)
        PHP_CURRENT_STT=$(echo "$extracted_data" | cut -d'|' -f3)
        PHP_INI_PATH=$(echo "$extracted_data" | cut -d'|' -f4)
        return 0
      else
        echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
      fi
      ;;
    esac
  done
}

lua_chon_PHP_BaoMat

# Chốt chặn thoát
if [[ "$LSPHP" == "0" || -z "$LSPHP" ]]; then
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
  exit 0
fi

# ==============================================================================
# XỬ LÝ LOGIC BẬT / TẮT
# ==============================================================================
echo ""
action_msg=""
FINAL_TARGETS=()

if [[ "$LSPHP" == "all" ]]; then
  # THAO TÁC ĐỒNG LOẠT
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT CHO TẤT CẢ PHP${C_RESET}" "$C_CYAN"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  str_opt1="  1) BẬT chặn Hàm (Bảo vệ an toàn đồng loạt)"
  pad_opt1=$((box_inner_width - ${#str_opt1}))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT chặn Hàm${C_RESET} (Bảo vệ an toàn đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
  
  str_opt2="  2) TẮT chặn Hàm (Gỡ bỏ bảo vệ đồng loạt)"
  pad_opt2=$((box_inner_width - ${#str_opt2}))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT chặn Hàm${C_RESET} (Gỡ bỏ bảo vệ đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
  read -r mass_choice

  if [[ "$mass_choice" == "1" ]]; then
    wp_action="bat"
  elif [[ "$mass_choice" == "2" ]]; then
    wp_action="tat"
  else
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
    exec /etc/wptt/wptt-bao-mat-main 1
  fi
  
  # Đẩy tất cả file php.ini hợp lệ vào mảng xử lý
  for item in "${selects[@]}"; do
    p_name=$(echo "$item" | cut -d'|' -f1)
    p_ini=$(echo "$item" | cut -d'|' -f4)
    [[ "$p_name" != "all" && -f "$p_ini" ]] && FINAL_TARGETS+=("$p_name|$p_ini")
  done

else
  # THAO TÁC ĐƠN LẺ
  if [[ "$PHP_CURRENT_STT" == "1" ]]; then
    if wptt_xac_nhan "Tính năng chặn hàm của phiên bản này đang BẬT. Bạn có muốn TẮT không?" "${C_BOLD_WHITE}Phiên bản:${C_RESET} $PHP_VER_DISPLAY" "${C_RED}Cảnh báo: Tắt tính năng này sẽ làm giảm bảo mật máy chủ!${C_RESET}" "Đồng ý TẮT" "Hủy bỏ"; then
      wp_action="tat"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  else
    if wptt_xac_nhan "BẬT chặn các hàm nguy hiểm cho phiên bản này?" "${C_BOLD_WHITE}Phiên bản:${C_RESET} $PHP_VER_DISPLAY" "Ngăn chặn: exec, system, proc_open, shell_exec..." "Đồng ý BẬT" "Hủy bỏ"; then
      wp_action="bat"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi
  FINAL_TARGETS+=("$LSPHP|$PHP_INI_PATH")
fi

# ==============================================================================
# THỰC THI CHỈNH SỬA PHP.INI VÀ ÁP DỤNG
# ==============================================================================
for target in "${FINAL_TARGETS[@]}"; do
  target_php=$(echo "$target" | cut -d'|' -f1)
  target_ini=$(echo "$target" | cut -d'|' -f2)
  
  _runing "Đang cấu hình $target_php..."
  
  # Xóa dòng disable_functions cũ (nếu có) để tránh trùng lặp
  sed -i '/^disable_functions[ \t]*=/d' "$target_ini"
  
  if [[ "$wp_action" == "bat" ]]; then
    echo "disable_functions = $FUNCS_LIST" >> "$target_ini"
    action_msg="Đã BẬT chặn hàm (An Toàn)"
    action_color="${C_GREEN}"
  else
    action_msg="Đã TẮT chặn hàm (Nguy Hiểm)"
    action_color="${C_RED}"
  fi
  
  _rundone "Hoàn tất cấu hình $target_php"
done

# Bắn bỏ tiến trình PHP cũ để file php.ini mới ăn ngay lập tức
_runing "Khởi động lại Litespeed và dọn dẹp các tiến trình PHP cũ..."
wptt_smart_reload_lsws >/dev/null 2>&1
killall -9 lsphp 2>/dev/null
_rundone "Khởi động lại Litespeed và dọn dẹp các tiến trình PHP cũ"

echo ""
print_border_top "$C_GREEN"
center_text "${C_BOLD_WHITE}HOÀN TẤT THAY ĐỔI CẤU HÌNH BẢO MẬT PHP${C_RESET}" "$C_GREEN"
print_border_mid "$C_GREEN"
left_text "Phạm vi áp dụng : ${C_YELLOW}$PHP_VER_DISPLAY${C_RESET}" 2 "$C_GREEN"
left_text "Trạng thái mới  : ${action_color}${action_msg}${C_RESET}" 2 "$C_GREEN"
print_border_bot "$C_GREEN"

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-bao-mat-main 1
