    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH CHẶN HÀM PHP${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác cấu hình bảo mật PHP cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT chặn Hàm (Bảo vệ an toàn đồng loạt)"
