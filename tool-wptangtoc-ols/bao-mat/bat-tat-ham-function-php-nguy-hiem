      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT chặn hàm${C_RESET} (Gỡ bỏ bảo vệ - Không khuyến nghị)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
