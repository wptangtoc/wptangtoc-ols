  if [[ ! -f wptangtoc-ols.zip || ! -f wptangtoc-ols.zip.sig ]]; then
    wget -q --timeout=15 --tries=3 https://github.com/wptangtoc/wptangtoc-ols/raw/refs/heads/main/wptangtoc-ols-beta.zip -O wptangtoc-ols.zip
    wget -q --timeout=15 --tries=3 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-beta.zip.sig -O wptangtoc-ols.zip.sig
  fi

  # Tải User Beta
  wget -q --timeout=15 --tries=3 https://wptangtoc.com/share/wptangtoc-ols-user-beta.zip -O wptangtoc-ols-user.zip
  wget -q --timeout=15 --tries=3 https://hub.wptangtoc.com/wptangtoc-ols-user-beta.zip.sig -O wptangtoc-ols-user.zip.sig -U 'checksum wptangtoc ols'
  if [[ ! -f wptangtoc-ols-user.zip || ! -f wptangtoc-ols-user.zip.sig ]]; then
    wget -q --timeout=15 --tries=3 https://github.com/wptangtoc/wptangtoc-ols/raw/refs/heads/main/wptangtoc-ols-user-beta.zip -O wptangtoc-ols-user.zip
    wget -q --timeout=15 --tries=3 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user-beta.zip.sig -O wptangtoc-ols-user.zip.sig
  fi
fi

# ==============================================================================
# 2.2 XÁC THỰC CHỮ KÝ GPG
# ==============================================================================
_runing "Đang xác thực Chữ ký điện tử (GPG Signature)..."

auth_core=0
auth_user=0

if [[ -f wptangtoc-ols.zip && -f wptangtoc-ols.zip.sig ]]; then
  if gpg --verify wptangtoc-ols.zip.sig wptangtoc-ols.zip 2>/dev/null; then
    auth_core=1
  fi
fi

if [[ -f wptangtoc-ols-user.zip && -f wptangtoc-ols-user.zip.sig ]]; then
  if gpg --verify wptangtoc-ols-user.zip.sig wptangtoc-ols-user.zip 2>/dev/null; then
    auth_user=1
  fi
fi

if [[ "$nhanh_wptangtoc_ols" == "beta" || (-z "$nhanh_wptangtoc_ols" && "$beta_wptangtoc_ols" == '1') ]];then #nhánh beta thì đuợc bypass không phải check gpg
    auth_user=1
    auth_core=1
fi

if [[ $auth_core -eq 0 || $auth_user -eq 0 ]]; then
	_runloi "Xác thực GPG không thành công"
	echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
	echo -e "${C_RED}│${C_RESET} ${C_YELLOW}CẢNH BÁO BẢO MẬT NGHIÊM TRỌNG (GPG AUTHENTICATION FAILED)${C_RESET}                    ${C_RED}│${C_RESET}"
	echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
	echo -e "${C_RED}│${C_RESET} Hệ thống phát hiện mã nguồn tải về bị hỏng hoặc chữ ký không hợp lệ!       ${C_RED}│${C_RESET}"
	echo -e "${C_RED}│${C_RESET} Quá trình cài đặt đã bị HỦY BỎ để bảo vệ an toàn cho máy chủ của bạn.       ${C_RED}│${C_RESET}"
	echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

	rm -rf "$TMP_DIR"
	cd "$OLD_PWD" || cd /root || exit
