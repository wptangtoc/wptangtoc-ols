function huong_dan() {
  Tính năng Chuyển nhánh Beta hoặc Nhánh Chính thức trong WPTangToc OLS cho phép người dùng lựa chọn giữa việc sử dụng phiên bản ổn định [nhánh chính thức] hoặc phiên bản thử nghiệm mới nhất [nhánh beta] của bộ script wptangtoc ols.

  Giải thích ngắn gọn:
  Nhánh Chính thức [Stable/Main Branch]:
  * Đây là phiên bản đã được kiểm thử kỹ lưỡng, được coi là ổn định và đáng tin cậy nhất.
  * Khuyến nghị cho hầu hết người dùng, đặc biệt là cho các website quan trọng đang hoạt động [production environment].
  * Tập trung vào sự ổn định và các tính năng đã được chứng minh.

  Nhánh Beta [Beta Branch]:
  * Đây là phiên bản đang trong quá trình phát triển, chứa các tính năng mới nhất, các cải tiến hoặc bản vá lỗi thử nghiệm.
  * Người dùng có thể trải nghiệm sớm các cập nhật nhưng cũng có khả năng gặp lỗi hoặc hoạt động chưa ổn định.
  * Phù hợp cho người dùng có kinh nghiệm muốn thử nghiệm, đóng góp ý kiến và giúp tác giả phát hiện lỗi trước khi các thay đổi được đưa vào nhánh chính thức.

  Tóm lại, tính năng chuyển đổi nhánh trong WPTangToc OLS mang lại sự linh hoạt cho người dùng, cho phép họ lựa chọn giữa sự ổn định của phiên bản chính thức và sự mới mẻ của phiên bản beta, tùy theo nhu cầu và mức độ chấp nhận rủi ro.
}

unset khong_dau_vi_ngon_ngu wptangtocols_version ngon_ngu
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

PATH='/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin'

nhanh_wptangtoc_ols=$1
[[ "$nhanh_wptangtoc_ols" == '999' ]] && nhanh_wptangtoc_ols=''

# ==============================================================================
# HÀM TRỢ GIÚP VẼ KHUNG 78 (ÉP TRÁI)
# ==============================================================================
box_inner_width=78

print_line() {
  local text="$1"
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}
  local pad=$((box_inner_width - text_len - 1))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET} ${text}$(printf '%*s' "$pad" "")\e[K${C_CYAN}│${C_RESET}"
}

center_text() {
  local text="$1"
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}
  if ((text_len >= box_inner_width)); then
    printf "${C_CYAN}│${C_RESET} %b ${C_CYAN}│${C_RESET}\n" "$text"
    return
  fi
  local pad_left=$(((box_inner_width - text_len) / 2))
  local pad_right=$((box_inner_width - text_len - pad_left))
  printf "${C_CYAN}│${C_RESET}%*s%b%*s${C_CYAN}│${C_RESET}\n" "$pad_left" "" "$text" "$pad_right" ""
}

clear
if [[ "$nhanh_wptangtoc_ols" == "chinhthuc" ]]; then
  target_branch="ỔN ĐỊNH (Stable/Main)"
  call_log="(chuyển đổi phiên bản ổn định)"
elif [[ "$nhanh_wptangtoc_ols" == "beta" ]]; then
  target_branch="THỬ NGHIỆM (Beta)"
  call_log="(chuyển đổi phiên bản beta)"
else
  # Cài lại nhánh hiện tại (Reinstall)
  if [[ "$beta_wptangtoc_ols" == '1' ]]; then
    target_branch="THỬ NGHIỆM (Beta) - Cài đặt lại"
    call_log="(Cài đặt lại phiên bản beta)"
  else
    target_branch="ỔN ĐỊNH (Stable/Main) - Cài đặt lại"
    call_log="(Cài đặt lại phiên bản ổn định)"
  fi
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}HỆ THỐNG ➜ CÀI ĐẶT LẠI / CHUYỂN NHÁNH WPTANGTOC OLS${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
print_line "${C_BOLD_WHITE}Tiến hành cài đặt nhánh:${C_RESET} ${C_YELLOW}$target_branch${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# 2. BẮT ĐẦU TẢI FILE VÀ CÀI ĐẶT
# ==============================================================================
_runing "WPTangToc OLS đang tiến hành cập nhật, vui lòng đợi..."

OLD_PWD=$(pwd)
TMP_DIR=$(mktemp -d)
cd "$TMP_DIR" || exit

# ==============================================================================
# BỘ MÁY TẢI VÀ GẮN CỨNG FINGERPRINT CHO PUBLIC KEY (CHỐNG TRÁO HÀNG)
# ==============================================================================
# 1. Tải Public Key (Nếu chưa có, chỉ cần tải 1 lần lưu vào hệ thống)
if ! gpg --list-keys "giatuan@wptangtoc.com" >/dev/null 2>&1; then
  _runing "Đang nạp Khóa bảo mật GPG..."
  
  # Tải file key về thư mục tạm
  curl -sL --connect-timeout 10 "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
  
  # Dự phòng Github nếu web chính sập
  if [[ ! -s wptangtoc-gpg-pub.key ]]; then
    curl -sL --connect-timeout 10 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
  fi

  # Đọc Fingerprint thực tế (Chỉ lấy dòng đầu của Master Key)
  real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)
  
  # Fingerprint
  expected_fp="EE091EEB9A5189BC80837C059AA528D37B902267"

  # Kiểm định khắt khe
  if [[ -n "$real_fp" && "$real_fp" == "$expected_fp" ]]; then
    gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
    _rundone "Nạp Khóa bảo mật GPG thành công"
  else
    _runloi "CẢNH BÁO BẢO MẬT: Public Key giả mạo hoặc sai lệch Fingerprint!"
    rm -f wptangtoc-gpg-pub.key
    cd "$OLD_PWD" || cd /root || exit
    rm -rf "$TMP_DIR"
    sleep 4
    check_menu_wptangtoc_active=$2
    [[ "$check_menu_wptangtoc_active" == "98" ]] && exec /etc/wptt/wptt-update-main 1
    exec /etc/wptt/wptt-status2
    exit 1
  fi
  rm -f wptangtoc-gpg-pub.key
fi

# Tải File Core + User + Chữ ký GPG theo Nhánh
if [[ "$nhanh_wptangtoc_ols" == "chinhthuc" || (-z "$nhanh_wptangtoc_ols" && "$beta_wptangtoc_ols" != '1') ]]; then
  sed -i "/beta_wptangtoc_ols/d" /etc/wptt/.wptt.conf 2>/dev/null

  # Tải Core Stable
  wget -q --timeout=15 --tries=3 https://wptangtoc.com/share/wptangtoc-ols.zip
  wget -q --timeout=15 --tries=3 https://hub.wptangtoc.com/wptangtoc-ols.zip.sig -U 'checksum wptangtoc ols'
  if [[ ! -f wptangtoc-ols.zip || ! -f wptangtoc-ols.zip.sig ]]; then
    wget -q --timeout=15 --tries=3 https://github.com/wptangtoc/wptangtoc-ols/raw/refs/heads/main/wptangtoc-ols.zip -O wptangtoc-ols.zip
    wget -q --timeout=15 --tries=3 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig -O wptangtoc-ols.zip.sig
  fi

  # Tải User Stable
  wget -q --timeout=15 --tries=3 https://wptangtoc.com/share/wptangtoc-ols-user.zip
  wget -q --timeout=15 --tries=3 https://hub.wptangtoc.com/wptangtoc-ols-user.zip.sig -U 'checksum wptangtoc ols'
  if [[ ! -f wptangtoc-ols-user.zip || ! -f wptangtoc-ols-user.zip.sig ]]; then
    wget -q --timeout=15 --tries=3 https://github.com/wptangtoc/wptangtoc-ols/raw/refs/heads/main/wptangtoc-ols-user.zip -O wptangtoc-ols-user.zip
    wget -q --timeout=15 --tries=3 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip.sig -O wptangtoc-ols-user.zip.sig
  fi

