  chmod 600 "$filepath"

  if [[ $has_wptt_group -eq 1 ]]; then
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    path="/usr/local/lsws/$domain"

    if [[ -d "$path" && -d "$path/etc" ]]; then
      if [[ $(stat -c '%U' "$path/etc" 2>/dev/null) == "root" ]]; then
        check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"'"'")

        if [[ -n "$check_user_vhost" ]] && grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
          chown root:wptangtoc-ols "$filepath"
          chmod 640 "$filepath"
        fi
      fi
    fi
  fi
done

