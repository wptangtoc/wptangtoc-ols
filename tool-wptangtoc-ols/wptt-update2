# Xác thực chữ ký số bằng keyring hệ thống kết hợp kiểm tra VALIDSIG
verify_gpg_validsig() {
  local sig_file="$1"
  local target_file="$2"

  [[ ! -s "$sig_file" || ! -s "$target_file" ]] && return 1

  local gpg_output gpg_ec=0
  gpg_output=$(gpg --status-fd 1 --batch --verify "$sig_file" "$target_file" 2>/dev/null) || gpg_ec=$?

  if [[ $gpg_ec -ne 0 ]]; then
    return 1
  fi

  local signer_fp primary_fp is_valid=0
  while IFS= read -r line; do
    if [[ "$line" =~ ^\[GNUPG:\]\ VALIDSIG[[:space:]]+([A-Fa-f0-9]+)[[:space:]]+.*[[:space:]]+([A-Fa-f0-9]+)$ ]]; then
      signer_fp="${BASH_REMATCH[1]}"
      primary_fp="${BASH_REMATCH[2]}"
      if [[ "$signer_fp" == "$EXPECTED_FP" || "$primary_fp" == "$EXPECTED_FP" ]]; then
        is_valid=1
        break
      fi
    fi
  done <<<"$gpg_output"

  [[ $is_valid -eq 1 ]]
}

