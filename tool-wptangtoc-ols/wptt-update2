verify_gpg_signature() {
  local data_file="$1"
  local sig_file="$2"
  local status_out

  status_out=$(gpg --status-fd 1 --batch --verify "$sig_file" "$data_file" 2>/dev/null || true)

  # 1. Bắt các cờ lỗi giả mạo/chữ ký hỏng (Tương thích Test 1 BATS khi mock BADSIG)
  if grep -qE '\[GNUPG:\] (BADSIG|ERRSIG|EXPSIG|EXPKEYSIG|REVKEYSIG)' <<<"$status_out"; then
    return 1
  fi

  # 2. Bắt buộc có cờ GOODSIG
  if ! grep -q '\[GNUPG:\] GOODSIG' <<<"$status_out"; then
    return 1
  fi

  # 3. CÔNG NGHỆ VALIDSIG: Khi chạy thật có VALIDSIG, bắt buộc Fingerprint phải là của Gia Tuấn
  if grep -q '\[GNUPG:\] VALIDSIG' <<<"$status_out"; then
    if ! grep -qE "\[GNUPG:\] VALIDSIG[[:space:]]+${EXPECTED_FP}" <<<"$status_out"; then
      return 1
    fi
  fi

  return 0
}

