# ==============================================================================
# HÀM TIỆN ÍCH BẢO MẬT & RETRY LOGIC (CHUẨN ENTERPRISE)
# ==============================================================================
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    if curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 45 -A "$user_agent" "$url" -o "$dest"; then
      return 0
    fi
    sleep 3
    attempt=$((attempt + 1))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    local result
    result=$(curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 60 "$url" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo "$result"
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  return 1
}

