#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com

cd /root 2>/dev/null || cd /

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

# Khởi tạo bẫy dọn dẹp file tạm an toàn
TMP_CRON=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  [[ -n "$TMP_CRON" && -f "$TMP_CRON" ]] && /bin/rm -f -- "$TMP_CRON"
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

NAME="${1:-}"
[[ "$NAME" == "98" ]] && NAME=""

# ==============================================================================
# BƯỚC 1: XÁC MINH VÀ LỌC TÊN MIỀN ĐẦU VÀO
# ==============================================================================
if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien 2>/dev/null
  echo -e "\n${C_CYAN}Lựa chọn website muốn kết nối API Preload:${C_RESET}\n"
  lua_chon_NAME
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exit 0

# Kiểm tra định dạng tên miền hợp lệ chống Command Injection
if [[ ! "$NAME" =~ ^[a-zA-Z0-9.-]+$ ]]; then
  echoDo "Tên miền không hợp lệ!"
  sleep 2
  exit 1
fi

vhost_conf="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$vhost_conf" ]]; then
  clear
  echoDo "Domain không tồn tại trên hệ thống."
  sleep 2
  exit 1
fi

wp_load="/usr/local/lsws/${NAME}/html/wp-load.php"
if [[ ! -f "$wp_load" ]]; then
  clear
  echoDo "Hệ thống xác nhận website chưa kích hoạt WordPress."
  sleep 2
  exit 1
fi

# Tên an toàn không chứa dấu chấm dùng cho file trong /etc/cron.d
SAFE_NAME="${NAME//./_}"
cron_expire_file="/etc/cron.d/wptt_preload_expire_${SAFE_NAME}"

# Kiểm tra nếu đã kết nối từ trước
if [[ -f "$cron_expire_file" ]]; then
  echoDo "Website $NAME đã được thiết lập API Preload từ trước."
  read -rp "Bạn có muốn ghi đè cấu hình mới? (y/n): " dongyghide
  if [[ "${dongyghide,,}" != "y" ]]; then
    exit 0
  fi
  /bin/rm -f -- "$cron_expire_file" 2>/dev/null || true
fi

TASK_NAME="Thiết lập API Preload cho website $NAME"
_runing "$TASK_NAME"

# ==============================================================================
# BƯỚC 2: TÍNH TOÁN NGÀY HẾT HẠN AN TOÀN (30 NGÀY TỚI)
# ==============================================================================
# Dùng cờ +%-d và +%-m để bỏ số 0 ở đầu mà KHÔNG làm hỏng các ngày 10, 20, 30
target_day=$(date -d "+30 days" +%-d 2>/dev/null || date +%-d)
target_month=$(date -d "+30 days" +%-m 2>/dev/null || date +%-m)

# ==============================================================================
# BƯỚC 3: TÍNH TOÁN GIỜ THỰC THI THEO MÚI GIỜ KHÁCH HÀNG (02:00 ĐÊM)
# ==============================================================================
server_hour=$(date +%-H)
client_tz=$(curl -s -m 5 "https://ipinfo.io/timezone" 2>/dev/null || true)
[[ -z "$client_tz" ]] && client_tz="Asia/Ho_Chi_Minh"

client_hour=$(TZ="$client_tz" date +%-H 2>/dev/null || echo "$server_hour")

# Tính độ lệch múi giờ giữa máy chủ và khách truy cập bằng toán tử Bash thuần
diff_hour=$(( (server_hour - client_hour + 24) % 24 ))

# Giờ chạy mặc định của Preload Bash: 2 giờ sáng tại múi giờ khách hàng
preload_bash_hour=$(( (2 + diff_hour) % 24 ))
preload_php_hour=$(( (0 + diff_hour) % 24 ))

# Phân bổ lệch giờ nếu hệ thống có nhiều website cùng chạy preload
overlap_count=$(crontab -l 2>/dev/null | grep 'wptt-preload-cache2' | grep -vc "$NAME" || true)
if (( overlap_count > 0 )); then
  preload_bash_hour=$(( (preload_bash_hour + overlap_count) % 24 ))
  preload_php_hour=$(( (preload_php_hour + overlap_count) % 24 ))
fi

# ==============================================================================
# BƯỚC 4: CẬP NHẬT CRONTAB NGUYÊN TỬ (TRANSACTIONAL CRONTAB)
# ==============================================================================
mkdir -p /etc/wptt/tmp 2>/dev/null
TMP_CRON=$(mktemp -p "/etc/wptt/tmp" "crontab_${SAFE_NAME}.XXXXXX") || {
  _runloi "$TASK_NAME"
  exit 1
}

# Lấy crontab hiện tại một cách an toàn và loại bỏ các dòng cũ của domain này
crontab -l 2>/dev/null | grep -Fv "$NAME" > "$TMP_CRON" || true

# Bổ sung các tiến trình cronjob mới cho website
cat <<EOF >> "$TMP_CRON"
0 $preload_bash_hour * * * ionice -c 3 nice -n 19 /bin/bash /etc/wptt/wptt-preload-cache2 $NAME >/dev/null 2>&1
*/5 * * * * ionice -c 3 nice -n 19 /bin/bash /etc/wptt/preload-wptangtoc-api $NAME >/dev/null 2>&1
EOF

# Kiểm tra nếu có plugin PHP Preload chuyên sâu
php_preload_plugin="/usr/local/lsws/${NAME}/html/wp-content/plugins/wptangtoc/class/PreloadAllPHP.php"
if [[ -f "$php_preload_plugin" ]]; then
  # shellcheck disable=SC1090
  . "$vhost_conf" 2>/dev/null

  if [[ -z "${phien_ban_php_domain:-}" ]]; then
    phien_ban_php_domain=$(php -v 2>/dev/null | awk '/PHP/{print $2}' | cut -d'.' -f1,2 | head -n 1)
  fi
  phien_ban_php_domain="${phien_ban_php_domain//[!0-9]/}"

  cat <<EOF >> "$TMP_CRON"
0 $preload_php_hour * * * ionice -c 3 nice -n 19 /bin/bash /etc/wptt/cache/php-cache-preload-wptangtoc.sh $NAME >/dev/null 2>&1
*/2 * * * * ionice -c 3 nice -n 19 /bin/bash /etc/wptt/cache/php-preload $NAME >/dev/null 2>&1
EOF
fi

# Nạp đè crontab một lần duy nhất
crontab "$TMP_CRON"
/bin/rm -f -- "$TMP_CRON"

# ==============================================================================
# BƯỚC 5: TẠO CRON TỰ ĐỘNG HỦY SAU 30 NGÀY (/etc/cron.d/)
# ==============================================================================
# Tên file không chứa dấu chấm để tương thích 100% với cả cron của Debian/Ubuntu lẫn RHEL
cat <<EOF > "$cron_expire_file"
0 0 $target_day $target_month * root /bin/bash /etc/wptt/delete-preload-api $NAME >/dev/null 2>&1
0 12 $target_day $target_month * root /bin/bash /etc/wptt/delete-preload-api $NAME >/dev/null 2>&1
EOF

chmod 644 "$cron_expire_file"

# Khởi động lại service cron nếu cần
if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
  systemctl restart cron.service >/dev/null 2>&1 || true
else
  systemctl restart crond.service >/dev/null 2>&1 || true
fi

wptt_logs "INFO" "Setup API preload thành công cho $NAME" 2>/dev/null || true
_rundone "$TASK_NAME"

echo -e "\n${C_GREEN}✔ Đã kích hoạt API Preload cho ${C_YELLOW}${NAME}${C_GREEN} thành công!${C_RESET}"
echo -e "  - Giờ quét cache đêm: ${C_CYAN}${preload_bash_hour}:00${C_RESET} (Máy chủ)"
