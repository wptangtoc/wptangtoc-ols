#!/bin/bash

. /etc/wptt/core-functions 2>/dev/null

dung_luong=$1

if [[ -z "$dung_luong" ]]; then
  read -rp "Dung lượng size cache lưu vào ram (Nhập số nguyên dương): " dung_luong
fi

if [[ ! $dung_luong =~ ^[0-9]+$ ]] || [[ $dung_luong -eq 0 ]]; then
  echo "Lỗi: Vui lòng chỉ nhập số nguyên dương lớn hơn 0."
  exit 1
fi

wptt_atomic_edit_config "/usr/local/lsws/conf/httpd_config.conf" "totalInMemCacheSize" "delete"
sed -i "/maxCachedFileSize/a  	totalInMemCacheSize 	   ${dung_luong}M" /usr/local/lsws/conf/httpd_config.conf
wptt_smart_reload_lsws >/dev/null 2>&1
