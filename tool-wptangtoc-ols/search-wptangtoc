# ==============================================================================
# 5. GHI NHẬN THÓI QUEN DÙNG & ĐIỀU HƯỚNG THỰC THI AN TOÀN (GIỮ SHLVL=1)
# ==============================================================================
if [[ -n "$selected_line" ]]; then
  IFS=$'\t' read -r selected_feature script_to_run _ <<<"$selected_line"

  if [[ -n "$selected_feature" ]]; then
    [[ -f "$HITS_FILE" ]] || : >"$HITS_FILE" 2>/dev/null
    hits_tmp="${HITS_FILE}.tmp.$$"
    if awk -F'\t' -v feat="$selected_feature" '
        BEGIN { OFS="\t"; found=0 }
        NF >= 2 {
          if ($1 == feat) { $2 = int($2) + 1; found=1 }
          print $1, $2
        }
        END { if (!found) print feat, 1 }
      ' "$HITS_FILE" >"$hits_tmp" 2>/dev/null; then
      mv -f "$hits_tmp" "$HITS_FILE" 2>/dev/null || rm -f "$hits_tmp"
    else
      rm -f "$hits_tmp"
    fi
  fi

  echo ""
  echoXanhlacay "Bạn đã chọn:"
  echo "$selected_feature"
  echo ""
  echoDo "────────────────────────────────────────────────────────────────────────────────"

  if [[ -n "$script_to_run" && -f "$script_to_run" ]]; then
    chmod +x "$script_to_run" 2>/dev/null || true
    case "$script_to_run" in
      *-main | */wptangtoc | */wptt-status* | */search-wptangtoc*)
        # 1. Nếu là Menu -> Dùng exec để giữ nguyên SHLVL=1 (tắt nóng Terminal không bị treo)
        exec "$script_to_run" 1
        ;;
      *)
        # 2. Nếu là Tính năng -> Chạy /bin/bash con không đối số (chặn tự chạy menu phụ gây tăng SHLVL)
        /bin/bash "$script_to_run" || true
        echo ""
        exec /usr/bin/wptangtoc 1
        ;;
    esac
  else
    _runloi "Lỗi: Không thể thực thi script '$script_to_run'."
    sleep 2
    exec /usr/bin/wptangtoc 1
  fi
else
  echoVang "Không chọn gì. Đang thoát..."
  if [[ -f /etc/wptt/wptt-status2 ]]; then
    exec /etc/wptt/wptt-status2
  else
    exec /usr/bin/wptangtoc
  fi
fi
