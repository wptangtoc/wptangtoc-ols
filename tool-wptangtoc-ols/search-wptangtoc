trap '_wptt_search_ctrl_c' SIGINT SIGTERM SIGQUIT

# ==============================================================================
# 1. CÁC HÀM XỬ LÝ CHUỖI, GIẢI MÃ BIẾN & BÓC TÁCH HƯỚNG DẪN (0 SUBSHELL)
# ==============================================================================
_trim_str() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  REPLY_TRIM="$s"
}

_expand_vars_safe() {
  local s="$1"
  local REPLY_TRIM=""
  _trim_str "$s"
  s="$REPLY_TRIM"

  if [[ "$s" == \"*\" ]]; then
    s="${s#\"}"
    s="${s%\"}"
  elif [[ "$s" == \'*\' ]]; then
    s="${s#\'}"
    s="${s%\'}"
  fi

  local re='\$\{([a-zA-Z_][a-zA-Z0-9_]*):-([^}]*)\}|\$\{([a-zA-Z_][a-zA-Z0-9_]*)\}|\$([a-zA-Z_][a-zA-Z0-9_]*)'
  local out="" rest="$s" full prefix var_name def_val var_val
  while [[ "$rest" =~ $re ]]; do
    full="${BASH_REMATCH[0]}"
    if [[ -n "${BASH_REMATCH[1]}" ]]; then
      var_name="${BASH_REMATCH[1]}"
      def_val="${BASH_REMATCH[2]}"
      var_val="${!var_name:-$def_val}"
    elif [[ -n "${BASH_REMATCH[3]}" ]]; then
      var_name="${BASH_REMATCH[3]}"
      var_val="${!var_name:-}"
    else
      var_name="${BASH_REMATCH[4]}"
      var_val="${!var_name:-}"
    fi
    prefix="${rest%%"$full"*}"
    out+="${prefix}${var_val}"
    rest="${rest#*"$full"}"
  done
  s="${out}${rest}"

  printf -v s '%b' "$s"
  s="${s//$'\x1B'\[*([0-9;])[a-zA-Z]/}"
  _trim_str "$s"
  REPLY_EXPANDED="$REPLY_TRIM"
}

_parse_options_from_file() {
  local filepath="$1"
  PARSED_OPTIONS=()
  local in_opts=0 line clean_line REPLY_TRIM="" REPLY_EXPANDED=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    clean_line="${line%%#*}"
    _trim_str "$clean_line"
    clean_line="$REPLY_TRIM"
    [[ -z "$clean_line" ]] && continue

    if ((in_opts == 0)); then
      if [[ "$clean_line" =~ ^options=\((.*)$ ]]; then
        in_opts=1
        clean_line="${BASH_REMATCH[1]}"
        _trim_str "$clean_line"
        clean_line="$REPLY_TRIM"
        if [[ "$clean_line" == *")" ]]; then
          clean_line="${clean_line%)}"
          _trim_str "$clean_line"
          if [[ -n "$REPLY_TRIM" ]]; then
            _expand_vars_safe "$REPLY_TRIM"
            [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
          fi
          break
        fi
        [[ -z "$clean_line" ]] && continue
      else
        continue
      fi
    fi

    if ((in_opts == 1)); then
      if [[ "$clean_line" == ")"* ]]; then
        break
      elif [[ "$clean_line" == *")" ]]; then
        clean_line="${clean_line%)}"
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
        break
      else
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
      fi
    fi
  done <"$filepath"
}

declare -A script_doc_map=()
_extract_huong_dan_flat() {
  local script_file="$1"
  REPLY_DOC=""
  [[ -r "$script_file" ]] || return 0

  if [[ -v script_doc_map["$script_file"] ]]; then
    REPLY_DOC="${script_doc_map["$script_file"]}"
    return 0
  fi

  local active=0 line trimmed doc_acc=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" == *huong_dan*"("*")"*"{"* ]]; then
        active=1
      fi
      continue
    fi

    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ "$trimmed" == "}"* ]] && break
    [[ -z "$trimmed" || "$trimmed" == "EOF"* || "$trimmed" == "cat <<"* ]] && continue

    if [[ "$trimmed" =~ ^echo([[:space:]]+-[eEn]+)?[[:space:]]+(.*)$ ]]; then
      trimmed="${BASH_REMATCH[2]}"
      trimmed="${trimmed#\"}"
      trimmed="${trimmed%\"}"
      trimmed="${trimmed#\'}"
      trimmed="${trimmed%\'}"
    fi

    trimmed="${trimmed//$'\t'/ }"
    if [[ -n "$doc_acc" ]]; then
      doc_acc+=" $trimmed"
    else
      doc_acc="$trimmed"
    fi
  done <"$script_file"

  if [[ "$doc_acc" == *"\033"* || "$doc_acc" == *"\e"* || "$doc_acc" == *$'\x1B'* ]]; then
    printf -v doc_acc '%b' "$doc_acc"
    doc_acc="${doc_acc//$'\x1B'\[*([0-9;])[a-zA-Z]/}"
  fi
  doc_acc="${doc_acc//[$'\r\n\t']/ }"

  script_doc_map["$script_file"]="$doc_acc"
  REPLY_DOC="$doc_acc"
}

# ==============================================================================
# 2. ĐỌC HOẶC XÂY DỰNG CACHE INDEX FULL-TEXT V4 (3 CỘT TSV - 0 SUBSHELL)
# ==============================================================================
mkdir -p /etc/wptt/tmp 2>/dev/null || true
/bin/rm -f -- /etc/wptt/tmp/wptt_search_ft_v2_* /etc/wptt/tmp/wptt_search_ft_v3_* 2>/dev/null || true
export CACHE_FILE="/etc/wptt/tmp/wptt_search_ft_v4_${ngon_ngu}_${version_wptangtoc_ols:-latest}.tsv"
export IDX_FILE="${CACHE_FILE%.tsv}.idx"
export HITS_FILE="/etc/wptt/tmp/wptt_hits_search.tsv"

if [[ ! -s "$HITS_FILE" ]]; then
  cat <<'EOF' >"$HITS_FILE" 2>/dev/null || true
Wptangtoc > Tải mã nguồn WordPress	5
Wptangtoc > Duplicate nhân bản website	3
Quản lý Domain > Thêm domain && subdomain	3
Sao lưu & Khôi phục > Sao lưu website	2
Quản lý WordPress > Auto Tối ưu Plugin LSCache	1
EOF
fi

declare -a initial_lines=()

if [[ -s "$CACHE_FILE" && "$CACHE_FILE" -nt /usr/bin/wptangtoc && "$CACHE_FILE" -nt "$0" ]]; then
  while IFS=$'\t' read -r f_key f_script _; do
    [[ -z "$f_key" || -z "$f_script" ]] && continue
    initial_lines+=("${f_key}"$'\t'"${f_script}")
  done <"$CACHE_FILE"
fi

if ((${#initial_lines[@]} == 0)); then
  main_definition_file="/usr/bin/wptangtoc"
  declare -A main_menu_priority=()
  declare -A feature_scripts=()

  if [[ -r "$main_definition_file" ]]; then
    _parse_options_from_file "$main_definition_file"
    for i in "${!PARSED_OPTIONS[@]}"; do
      printf -v prio_str "%02d" "$i"
      main_menu_priority["${PARSED_OPTIONS[$i]}"]="$prio_str"
    done
  fi

  shopt -s nullglob
  all_files_to_process=(/etc/wptt/*-main /etc/wptt/*/*-main /etc/wptt/*/*/*-main)
  shopt -u nullglob

  if [[ -r "$main_definition_file" ]]; then
    has_main=0
    for f in "${all_files_to_process[@]}"; do
      if [[ "$f" -ef "$main_definition_file" ]]; then
        has_main=1
        break
      fi
    done
    ((has_main == 0)) && all_files_to_process+=("$main_definition_file")
  fi

  if ((${#all_files_to_process[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tệp menu nào trên hệ thống."
    exit 1
  fi

  declare -A feature_sort_keys=()
  declare -A feature_docs=()

  for filepath in "${all_files_to_process[@]}"; do
    [[ -r "$filepath" ]] || continue
    file="${filepath##*/}"

    category_title=""
    last_title_var=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^[[:space:]]*echo[[:space:]]+\"\$([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
        last_title_var="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*options=\( ]]; then
        break
      fi
    done <"$filepath"

    if [[ -n "$last_title_var" && -n "${!last_title_var:-}" ]]; then
      category_title="${!last_title_var}"
      category_title="${category_title%:}"
      _trim_str "$category_title"
      category_title="$REPLY_TRIM"
    fi

    if [[ -z "$category_title" ]]; then
      category_base="${file%-main}"
      category_base="${category_base#wptt-}"
      category_base="${category_base#wptangtoc-}"
      category_base="${category_base//-/ }"
      category_title="${category_base^}"
    fi

    _parse_options_from_file "$filepath"
    ((${#PARSED_OPTIONS[@]} == 0)) && continue

    in_run_action=0
    in_case=0
    current_label=""
    current_script=""

    while IFS= read -r line || [[ -n "$line" ]]; do
      clean_line="${line%%#*}"
      _trim_str "$clean_line"
      clean_line="$REPLY_TRIM"
      [[ -z "$clean_line" ]] && continue

      if ((in_run_action == 0)); then
        [[ "$clean_line" =~ ^run_action[[:space:]]*\(\) ]] && in_run_action=1
        continue
      fi

      if ((in_case == 0)); then
        [[ "$clean_line" =~ ^case[[:space:]]+ ]] && in_case=1
        continue
      fi

      if [[ "$clean_line" == "esac"* ]]; then
        break
      fi

      if [[ "$clean_line" =~ ^([0-9]+)\)(.*)$ ]]; then
        current_label="${BASH_REMATCH[1]}"
        clean_line="${BASH_REMATCH[2]}"
        current_script=""
      fi

      if [[ -n "$current_label" ]]; then
        if [[ "$clean_line" =~ script_path=\"([^\"]+)\" ]]; then
          current_script="${BASH_REMATCH[1]}"
        elif [[ "$clean_line" =~ (exec|\.)[[:space:]]+(/etc/wptt/[^[:space:]\;]+) ]]; then
          current_script="${BASH_REMATCH[2]}"
        fi

        if [[ "$clean_line" == *";;"* ]]; then
          idx=$((10#$current_label))
          if ((idx >= 0 && idx < ${#PARSED_OPTIONS[@]})) && [[ -n "$current_script" ]]; then
            opt_title="${PARSED_OPTIONS[$idx]}"
            if [[ -n "$opt_title" && "$opt_title" != *"───"* ]]; then
              feature_key="$category_title > $opt_title"
              if [[ -z "${feature_scripts["$feature_key"]:-}" ]]; then
                feature_scripts["$feature_key"]="$current_script"
                feature_sort_keys["$feature_key"]="${main_menu_priority["$opt_title"]:-${main_menu_priority["$category_title"]:-99}}"

                REPLY_DOC=""
                _extract_huong_dan_flat "$current_script"
                feature_docs["$feature_key"]="$REPLY_DOC"
              fi
            fi
          fi
          current_label=""
        fi
      fi
    done <"$filepath"
  done

  if ((${#feature_scripts[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tính năng nào khả dụng."
    exit 1
  fi

  : >"${CACHE_FILE}.tmp.$$"
  while IFS=$'\t' read -r _ f_key; do
    [[ -z "$f_key" ]] && continue
    f_script="${feature_scripts["$f_key"]}"
    f_doc="${feature_docs["$f_key"]:-}"

    initial_lines+=("${f_key}"$'\t'"${f_script}")
    printf "%s\t%s\t%s\n" "$f_key" "$f_script" "$f_doc" >>"${CACHE_FILE}.tmp.$$"
  done < <(
    for key in "${!feature_scripts[@]}"; do
      printf "%s\t%s\n" "${feature_sort_keys["$key"]:-99}" "$key"
    done | sort -k1,1 -k2,2
  )
  mv -f "${CACHE_FILE}.tmp.$$" "$CACHE_FILE" 2>/dev/null || rm -f "${CACHE_FILE}.tmp.$$"
fi

# ------------------------------------------------------------------------------
# 2B. DỰNG FILE INDEX (.idx - 12 CỘT) TƯƠNG THÍCH 100% VỚI MAWK & GAWK
#     Cột: 1:title | 2:script | 3:base_hot | 4:opt_len | 5:t_norm
#          6:cat_part | 7:opt_part | 8:t_ascii | 9:cat_ascii | 10:opt_ascii
#          11:d_ascii | 12:t_words
# ------------------------------------------------------------------------------
if ! [[ -s "$IDX_FILE" && "$IDX_FILE" -nt "$CACHE_FILE" && "$IDX_FILE" -nt "$0" ]]; then
  if [[ -s "$CACHE_FILE" ]]; then
    LC_ALL=C.UTF-8 awk -F'\t' -v OFS='\t' '
      function norm_vn(s) {
        s = tolower(s)
        gsub(/À/, "à", s); gsub(/Á/, "á", s); gsub(/Ả/, "ả", s); gsub(/Ã/, "ã", s); gsub(/Ạ/, "ạ", s)
        gsub(/Ă/, "ă", s); gsub(/Ằ/, "ằ", s); gsub(/Ắ/, "ắ", s); gsub(/Ẳ/, "ẳ", s); gsub(/Ẵ/, "ẵ", s); gsub(/Ặ/, "ặ", s)
        gsub(/Â/, "â", s); gsub(/Ầ/, "ầ", s); gsub(/Ấ/, "ấ", s); gsub(/Ẩ/, "ẩ", s); gsub(/Ẫ/, "ẫ", s); gsub(/Ậ/, "ậ", s)
        gsub(/Đ/, "đ", s)
        gsub(/È/, "è", s); gsub(/É/, "é", s); gsub(/Ẻ/, "ẻ", s); gsub(/Ẽ/, "ẽ", s); gsub(/Ẹ/, "ẹ", s)
        gsub(/Ê/, "ê", s); gsub(/Ề/, "ề", s); gsub(/Ế/, "ế", s); gsub(/Ể/, "ể", s); gsub(/Ễ/, "ễ", s); gsub(/Ệ/, "ệ", s)
        gsub(/Ì/, "ì", s); gsub(/Í/, "í", s); gsub(/Ỉ/, "ỉ", s); gsub(/Ĩ/, "ĩ", s); gsub(/Ị/, "ị", s)
        gsub(/Ò/, "ò", s); gsub(/Ó/, "ó", s); gsub(/Ỏ/, "ỏ", s); gsub(/Õ/, "õ", s); gsub(/Ọ/, "ọ", s)
        gsub(/Ô/, "ô", s); gsub(/Ồ/, "ồ", s); gsub(/Ố/, "ố", s); gsub(/Ổ/, "ổ", s); gsub(/Ỗ/, "ỗ", s); gsub(/Ộ/, "ộ", s)
        gsub(/Ơ/, "ơ", s); gsub(/Ờ/, "ờ", s); gsub(/Ớ/, "ớ", s); gsub(/Ở/, "ở", s); gsub(/Ỡ/, "ỡ", s); gsub(/Ợ/, "ợ", s)
        gsub(/Ù/, "ù", s); gsub(/Ú/, "ú", s); gsub(/Ủ/, "ủ", s); gsub(/Ũ/, "ũ", s); gsub(/Ụ/, "ụ", s)
        gsub(/Ư/, "ư", s); gsub(/Ừ/, "ừ", s); gsub(/Ứ/, "ứ", s); gsub(/Ử/, "ử", s); gsub(/Ữ/, "ữ", s); gsub(/Ự/, "ự", s)
        gsub(/Ỳ/, "ỳ", s); gsub(/Ý/, "ý", s); gsub(/Ỷ/, "ỷ", s); gsub(/Ỹ/, "ỹ", s); gsub(/Ỵ/, "ỵ", s)
        gsub(/oá/, "óa", s); gsub(/oà/, "òa", s); gsub(/oả/, "ỏa", s); gsub(/oã/, "õa", s); gsub(/oạ/, "ọa", s)
        gsub(/uỷ/, "ủy", s); gsub(/uý/, "úy", s); gsub(/uỳ/, "ùy", s); gsub(/uỹ/, "ũy", s); gsub(/uỵ/, "ụy", s)
        return s
      }
      function strip_vn(s) {
        s = tolower(s)
        gsub(/à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ|À|Á|Ả|Ã|Ạ|Ă|Ằ|Ắ|Ẳ|Ẵ|Ặ|Â|Ầ|Ấ|Ẩ|Ẫ|Ậ/, "a", s)
        gsub(/đ|Đ/, "d", s)
        gsub(/è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ|È|É|Ẻ|Ẽ|Ẹ|Ê|Ề|Ế|Ể|Ễ|Ệ/, "e", s)
        gsub(/ì|í|ỉ|ĩ|ị|Ì|Í|Ỉ|Ĩ|Ị/, "i", s)
        gsub(/ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ|Ò|Ó|Ỏ|Õ|Ọ|Ô|Ồ|Ố|Ổ|Ỗ|Ộ|Ơ|Ờ|Ớ|Ở|Ỡ|Ợ/, "o", s)
        gsub(/ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự|Ù|Ú|Ủ|Ũ|Ụ|Ư|Ừ|Ứ|Ử|Ữ|Ự/, "u", s)
        gsub(/ỳ|ý|ỷ|ỹ|ỵ|Ỳ|Ý|Ỷ|Ỹ|Ỵ/, "y", s)
        return s
      }
      function calc_base_hot(opt_a,    h) {
        h = 50
        if (opt_a == "them domain && subdomain" || opt_a == "them domain") h = 1
        else if (opt_a == "tai ma nguon wordpress" || index(opt_a, "tai ma nguon wordpress") == 1) h = 2
        else if (index(opt_a, "quet ma doc") == 1 || index(opt_a, "sao luu") == 1 || index(opt_a, "khoi phuc") == 1) h = 5
        else if (index(opt_a, "cai dat ssl") == 1 || index(opt_a, "xoa domain") == 1 || index(opt_a, "phan quyen domain") == 1) h = 8
        else if (index(opt_a, "xoa toan bo cache") == 1 || index(opt_a, "xoa cache") == 1 || index(opt_a, "khoi dong lai") == 1) h = 10
        else if (index(opt_a, "chinh sua vhost") == 1 || index(opt_a, "chinh sua php") == 1 || index(opt_a, "doi mat khau") == 1) h = 12
        else if (index(opt_a, "tao swap") == 1 || index(opt_a, "xoa swap") == 1 || index(opt_a, "nhan ban") == 1) h = 15
        return h
      }
      {
        t_norm = norm_vn($1)
        sep = index(t_norm, ">")
        if (sep > 0) {
          cat = substr(t_norm, 1, sep - 1)
          opt = substr(t_norm, sep + 1)
          gsub(/^[ \t]+|[ \t]+$/, "", cat)
          gsub(/^[ \t]+|[ \t]+$/, "", opt)
        } else {
          cat = ""
          opt = t_norm
        }
        t_ascii = strip_vn(t_norm)
        cat_ascii = strip_vn(cat)
        opt_ascii = strip_vn(opt)
        d_ascii = strip_vn($3)

        t_words = t_ascii
        gsub(/[^a-z0-9]+/, " ", t_words)
        gsub(/^ +| +$/, "", t_words)

        base_hot = calc_base_hot(opt_ascii)
        opt_len = length(opt_ascii)
        if (opt_len > 999) opt_len = 999

        print $1, $2, base_hot, opt_len, t_norm, cat, opt, \
              t_ascii, cat_ascii, opt_ascii, d_ascii, t_words
      }
    ' "$CACHE_FILE" >"${IDX_FILE}.tmp.$$" 2>/dev/null &&
      mv -f "${IDX_FILE}.tmp.$$" "$IDX_FILE" 2>/dev/null ||
      rm -f "${IDX_FILE}.tmp.$$" 2>/dev/null
  fi
fi

((BUILD_ONLY == 1)) && exit 0

# ==============================================================================
# 3. ENGINE TÌM KIẾM 1 TIẾN TRÌNH DUY NHẤT (SORT TRONG RAM AWK - 0 SORT/CUT FORK)
# ==============================================================================
wptt_fzf_search() {
  local query="${1:-}"
  [[ -s "$IDX_FILE" ]] || return 0

  LC_ALL=C.UTF-8 awk -F'\t' -v q="$query" -v hits_file="$HITS_FILE" '
    function norm_vn_q(s) {
      s = tolower(s)
      gsub(/À/, "à", s); gsub(/Á/, "á", s); gsub(/Ả/, "ả", s); gsub(/Ã/, "ã", s); gsub(/Ạ/, "ạ", s)
      gsub(/Ă/, "ă", s); gsub(/Ằ/, "ằ", s); gsub(/Ắ/, "ắ", s); gsub(/Ẳ/, "ẳ", s); gsub(/Ẵ/, "ẵ", s); gsub(/Ặ/, "ặ", s)
      gsub(/Â/, "â", s); gsub(/Ầ/, "ầ", s); gsub(/Ấ/, "ấ", s); gsub(/Ẩ/, "ẩ", s); gsub(/Ẫ/, "ẫ", s); gsub(/Ậ/, "ậ", s)
      gsub(/Đ/, "đ", s)
      gsub(/È/, "è", s); gsub(/É/, "é", s); gsub(/Ẻ/, "ẻ", s); gsub(/Ẽ/, "ẽ", s); gsub(/Ẹ/, "ẹ", s)
      gsub(/Ê/, "ê", s); gsub(/Ề/, "ề", s); gsub(/Ế/, "ế", s); gsub(/Ể/, "ể", s); gsub(/Ễ/, "ễ", s); gsub(/Ệ/, "ệ", s)
      gsub(/Ì/, "ì", s); gsub(/Í/, "í", s); gsub(/Ỉ/, "ỉ", s); gsub(/Ĩ/, "ĩ", s); gsub(/Ị/, "ị", s)
      gsub(/Ò/, "ò", s); gsub(/Ó/, "ó", s); gsub(/Ỏ/, "ỏ", s); gsub(/Õ/, "õ", s); gsub(/Ọ/, "ọ", s)
      gsub(/Ô/, "ô", s); gsub(/Ồ/, "ồ", s); gsub(/Ố/, "ố", s); gsub(/Ổ/, "ổ", s); gsub(/Ỗ/, "ỗ", s); gsub(/Ộ/, "ộ", s)
      gsub(/Ơ/, "ơ", s); gsub(/Ờ/, "ờ", s); gsub(/Ớ/, "ớ", s); gsub(/Ở/, "ở", s); gsub(/Ỡ/, "ỡ", s); gsub(/Ợ/, "ợ", s)
      gsub(/Ù/, "ù", s); gsub(/Ú/, "ú", s); gsub(/Ủ/, "ủ", s); gsub(/Ũ/, "ũ", s); gsub(/Ụ/, "ụ", s)
      gsub(/Ư/, "ư", s); gsub(/Ừ/, "ừ", s); gsub(/Ứ/, "ứ", s); gsub(/Ử/, "ử", s); gsub(/Ữ/, "ữ", s); gsub(/Ự/, "ự", s)
      gsub(/Ỳ/, "ỳ", s); gsub(/Ý/, "ý", s); gsub(/Ỷ/, "ỷ", s); gsub(/Ỹ/, "ỹ", s); gsub(/Ỵ/, "ỵ", s)
      gsub(/oá/, "óa", s); gsub(/oà/, "òa", s); gsub(/oả/, "ỏa", s); gsub(/oã/, "õa", s); gsub(/oạ/, "ọa", s)
      gsub(/uỷ/, "ủy", s); gsub(/uý/, "úy", s); gsub(/uỳ/, "ùy", s); gsub(/uỹ/, "ũy", s); gsub(/uỵ/, "ụy", s)
      return s
    }
    function strip_vn_q(s) {
      gsub(/à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ/, "a", s)
      gsub(/đ/, "d", s)
      gsub(/è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ/, "e", s)
      gsub(/ì|í|ỉ|ĩ|ị/, "i", s)
      gsub(/ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ/, "o", s)
      gsub(/ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự/, "u", s)
      gsub(/ỳ|ý|ỷ|ỹ|ỵ/, "y", s)
      return s
    }
    function can_delete_one(long_s, short_s, ll, ls,    i, j, skipped) {
      i = 1; j = 1; skipped = 0
      while (i <= ll && j <= ls) {
        if (substr(long_s, i, 1) == substr(short_s, j, 1)) { i++; j++ }
        else { if (++skipped > 1) return 0; i++ }
      }
      return 1
    }
    function edit_dist_le1(a, b,    la, lb, i, diff, p1, p2) {
      la = length(a); lb = length(b)
      if (la < 4 || lb < 4 || la - lb > 1 || lb - la > 1) return 0
      if (la == lb) {
        diff = 0
        for (i = 1; i <= la; i++) {
          if (substr(a, i, 1) != substr(b, i, 1)) {
            if (++diff == 1) p1 = i
            else if (diff == 2) p2 = i
            else return 0
          }
        }
        if (diff <= 1) return 1
        return (diff == 2 && p2 == p1 + 1 && substr(a, p1, 1) == substr(b, p2, 1) && substr(a, p2, 1) == substr(b, p1, 1))
      }
      return (la > lb) ? can_delete_one(a, b, la, lb) : can_delete_one(b, a, lb, la)
    }
    function check_typo_word(w, t_ascii, t_words,    c1, c2, n_tw, tw_arr, k) {
      if (length(w) < 2) return 0
      c1 = substr(w, 1, 1); c2 = substr(w, 1, 2)
      if (c1 == "s") { if (index(t_ascii, "x" substr(w, 2)) > 0) return 1 }
      else if (c1 == "x") { if (index(t_ascii, "s" substr(w, 2)) > 0) return 1 }
      else if (c2 == "ch") { if (index(t_ascii, "tr" substr(w, 3)) > 0) return 1 }
      else if (c2 == "tr") { if (index(t_ascii, "ch" substr(w, 3)) > 0) return 1 }
      else if (c2 == "gi") { if (index(t_ascii, "d" substr(w, 3)) > 0) return 1 }

      if (length(w) >= 4) {
        n_tw = split(t_words, tw_arr, " ")
        for (k = 1; k <= n_tw; k++) {
          if (edit_dist_le1(w, tw_arr[k])) return 1
        }
      }
      return 0
    }
    BEGIN {
      q_norm = norm_vn_q(q)
      gsub(/^[ \t]+|[ \t]+$/, "", q_norm)
      q_ascii = strip_vn_q(q_norm)
      n_words = split(q_norm, q_words, /[ \t]+/)
      split(q_ascii, q_words_ascii, /[ \t]+/)

      if (n_words > 0 && hits_file != "") {
        while ((getline hline < hits_file) > 0) {
          split(hline, hparts, "\t")
          if (hparts[1] != "") user_hits[hparts[1]] = int(hparts[2])
        }
        close(hits_file)
      }

      n_alias = 0
      alias_q[++n_alias] = "cai dat wordpress"; alias_t[n_alias] = "tai ma nguon wordpress"
      alias_q[++n_alias] = "install wordpress"; alias_t[n_alias] = "tai ma nguon wordpress"
			alias_q[++n_alias] = "cai wordpress";     alias_t[n_alias] = "tai ma nguon wordpress"
      alias_q[++n_alias] = "cai worpress";     alias_t[n_alias] = "tai ma nguon wordpress"
      alias_q[++n_alias] = "cai wp";            alias_t[n_alias] = "tai ma nguon wordpress"
      alias_q[++n_alias] = "cai ma nguon";      alias_t[n_alias] = "tai ma nguon wordpress"
      alias_q[++n_alias] = "cai dat ma nguon";  alias_t[n_alias] = "tai ma nguon wordpress"
      m = 0
    }
    {
      if (n_words == 0) {
        print $1 "\t" $2
        next
      }

      title = $1; script = $2
      base_hot = int($3); opt_len = int($4)
      t_norm = $5; cat_part = $6; opt_part = $7
      t_ascii = $8; cat_ascii = $9; opt_ascii = $10
      d_ascii = $11; t_words = $12

      for (a = 1; a <= n_alias; a++) {
        if (length(q_ascii) >= 5 &&
            (index(alias_q[a], q_ascii) == 1 || index(q_ascii, alias_q[a]) == 1) &&
            index(opt_ascii, alias_t[a]) > 0) {
          m++
          keys[m] = sprintf("00000000%04d", NR)
          rows[m] = title "\t" script
          next
        }
      }

      in_title_exact = 0; in_title_ascii = 0
      in_cat = 0; in_opt = 0; in_doc = 0; in_typo = 0

      for (i = 1; i <= n_words; i++) {
        w = q_words[i]; wa = q_words_ascii[i]
        matched_t = 0
        if (index(opt_part, w) > 0 || index(cat_part, w) > 0) {
          in_title_exact++; in_title_ascii++; matched_t = 1
          if (index(opt_part, w) > 0) in_opt++
          if (index(cat_part, w) > 0) in_cat++
        } else if (index(opt_ascii, wa) > 0 || index(cat_ascii, wa) > 0) {
          in_title_ascii++; matched_t = 1
          if (index(opt_ascii, wa) > 0) in_opt++
          if (index(cat_ascii, wa) > 0) in_cat++
        }

        if (matched_t == 1) continue
        else if (index(d_ascii, wa) > 0) in_doc++
        else if (check_typo_word(wa, t_ascii, t_words)) in_typo++
        else next
      }

      if (in_typo > 0) score = 45 + in_typo
      else if (index(opt_part, q_norm) == 1) score = (in_cat > 0) ? 1 : 3
      else if (index(opt_ascii, q_ascii) == 1) score = (in_cat > 0) ? 2 : 4
      else if (index(opt_part, q_norm) > 0) score = (in_cat > 0) ? 6 : 8
      else if (index(opt_ascii, q_ascii) > 0) score = (in_cat > 0) ? 7 : 9
      else if (index(t_norm, q_norm) > 0) score = 10
      else if (index(t_ascii, q_ascii) > 0) score = 11
      else if (in_opt == n_words) score = (in_title_exact == n_words) ? ((in_cat > 0) ? 13 : 15) : ((in_cat > 0) ? 14 : 16)
      else if (in_title_ascii == n_words) score = (in_title_exact == n_words) ? 19 : 20
      else if (in_title_ascii > 0) score = 30 + (n_words - in_title_ascii)
      else if (index(d_ascii, q_ascii) > 0) score = 50
      else score = 60

      hot_rank = base_hot
      if (title in user_hits) {
        hot_rank -= (user_hits[title] * 3)
        if (hot_rank < 1) hot_rank = 1
      }

      m++
      keys[m] = sprintf("%02d%03d%03d%04d", score, hot_rank, opt_len, NR)
      rows[m] = title "\t" script
    }
    END {
      if (m > 1) {
        gap = int(m / 2)
        while (gap > 0) {
          for (i = gap + 1; i <= m; i++) {
            tk = keys[i]; tr = rows[i]
            j = i
            while (j > gap && keys[j - gap] > tk) {
              keys[j] = keys[j - gap]
              rows[j] = rows[j - gap]
              j -= gap
            }
            keys[j] = tk; rows[j] = tr
          }
          gap = int(gap / 2)
        }
      }
      for (i = 1; i <= m; i++) print rows[i]
    }
  ' "$IDX_FILE"
}
export -f wptt_fzf_search

wptt_fzf_previewer() {
  local f_title="$1"
  local script_to_preview="$2"
  local search_query="${3:-}"

  printf "\033[1;36m⚡ %s\033[0m\n" "$f_title"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    return 0
  fi

  local alt_regex="" word esc_word i ch
  if [[ -n "$search_query" ]]; then
    for word in $search_query; do
      ((${#word} < 2)) && continue
      esc_word=""
      for ((i = 0; i < ${#word}; i++)); do
        ch="${word:i:1}"
        case "$ch" in
          '\' | '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|') esc_word+="\\$ch" ;;
          'a' | 'A') esc_word+="(a|à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ)" ;;
          'd' | 'D') esc_word+="(d|đ)" ;;
          'e' | 'E') esc_word+="(e|è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ)" ;;
          'i' | 'I') esc_word+="(i|ì|í|ỉ|ĩ|ị)" ;;
          'o' | 'O') esc_word+="(o|ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ)" ;;
          'u' | 'U') esc_word+="(u|ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự)" ;;
          'y' | 'Y') esc_word+="(y|ỳ|ý|ỷ|ỹ|ỵ)" ;;
          *) esc_word+="$ch" ;;
        esac
      done
      if [[ -n "$alt_regex" ]]; then
        alt_regex+="|${esc_word}"
      else
        alt_regex="${esc_word}"
      fi
    done
  fi

  local active=0 line trimmed line_count=0 re=""
  [[ -n "$alt_regex" ]] && re="($alt_regex)"

  shopt -s nocasematch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" == *huong_dan*"("*")"*"{"* ]]; then
        active=1
      fi
      continue
    fi
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ "$trimmed" == "}"* ]] && break
    [[ -z "$trimmed" || "$trimmed" == "EOF"* || "$trimmed" == "cat <<"* ]] && continue

    if [[ "$trimmed" == "echo "* ]]; then
      line="${trimmed#echo }"
      if [[ "$line" == -* ]]; then
        line="${line#-*([eEn]) }"
      fi
      line="${line#\"}"
      line="${line%\"}"
      line="${line#\'}"
      line="${line%\'}"
    fi

    if [[ -n "$re" && "$line" =~ $re ]]; then
      local out="" rest="$line" m_str prefix
      while [[ "$rest" =~ $re ]]; do
        m_str="${BASH_REMATCH[1]}"
        [[ -z "$m_str" ]] && break
        prefix="${rest%%"$m_str"*}"
        out+="${prefix}"$'\033[1;33;4m'"${m_str}"$'\033[0m'
        rest="${rest#*"$m_str"}"
      done
      line="${out}${rest}"
    fi
    printf "\033[90m%b\033[0m\n" "$line"
    ((++line_count >= 6)) && break
  done <"$script_to_preview"
  shopt -u nocasematch
}
export -f wptt_fzf_previewer

clear

# ==============================================================================
# 4. HIỂN THỊ GIAO DIỆN TÌM KIẾM FZF
