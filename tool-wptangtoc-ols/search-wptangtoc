export SHELL=/bin/bash
selected_line=""

# ============================================================================
# XỬ LÝ TYPEAHEAD BUFFERING (CHỐNG RÁC BÀN PHÍM VÀO THANH TÌM KIẾM FZF)
# ============================================================================
if [[ -t 0 ]]; then stty -echo 2>/dev/null; fi
if declare -F wptt_flush_stdin >/dev/null; then
  wptt_flush_stdin
fi
if [[ -t 0 ]]; then stty echo 2>/dev/null; fi
# ============================================================================

trap '' SIGINT
selected_line=$(
  printf "%s\n" "${initial_lines[@]}" | fzf \
    --ansi \
    --disabled \
    --bind 'change:reload:sleep 0.041; wptt_fzf_search {q}' \
    --prompt="🔍 Tìm kiếm tính năng WPTangToc OLS > " \
    --height='~65%' \
    --border=rounded \
    --color=border:red \
    --layout=reverse \
    --cycle \
    --with-nth=1 \
    --delimiter=$'\t' \
    --header="Tìm thấy ${#initial_lines[@]} tính năng [↑/↓] Di chuyển, ESC hủy, Gõ để lọc, Enter chọn." \
    --preview='wptt_fzf_previewer {1} {2} {q}' \
