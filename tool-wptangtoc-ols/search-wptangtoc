if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/core-functions 2>/dev/null
fi

BUILD_ONLY=0
[[ "${1:-}" == "--preload-cache" ]] && BUILD_ONLY=1

if ! command -v fzf >/dev/null 2>&1; then
  echo "Vui lòng cài fzf thì mới sử dụng được tính năng này"
  exit 1
fi

export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=en_US.UTF-8 2>/dev/null || true
export LANG=C.UTF-8 2>/dev/null || export LANG=en_US.UTF-8 2>/dev/null || true
stty iutf8 2>/dev/null || true
shopt -s extglob

if [[ -z "${C_CYAN:-}" ]]; then
  if [[ -f /etc/wptt/echo-color ]]; then
    # shellcheck source=/dev/null
    . /etc/wptt/echo-color
  else
    echo "Lỗi: Không tìm thấy /etc/wptt/echo-color"
    exit 1
  fi
fi

if [[ -f /etc/wptt/.wptt.conf ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/.wptt.conf
else
  echo "Lỗi: Không tìm thấy /etc/wptt/.wptt.conf"
  exit 1
fi

[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
lang_file="/etc/wptt/lang/${ngon_ngu}.sh"
if [[ -f "$lang_file" ]]; then
  # shellcheck source=/dev/null
  . "$lang_file"
elif [[ -f "/etc/wptt/lang/vi.sh" ]]; then
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/vi.sh"
fi

_wptt_search_ctrl_c() {
  trap - SIGINT SIGTERM SIGQUIT
  stty sane 2>/dev/null || true
  tput cnorm 2>/dev/null || true
  echo -e "\n\nĐã thoát. Nhập lệnh ${C_GREEN}1${C_RESET} hoặc ${C_GREEN}wptangtoc${C_RESET} để quay lại."
  export WPTT_BYPASS=1
  exec bash --login
}
trap '_wptt_search_ctrl_c' SIGINT SIGTERM SIGQUIT

# ==============================================================================
# 1. CÁC HÀM XỬ LÝ CHUỖI, GIẢI MÃ BIẾN & BÓC TÁCH HƯỚNG DẪN (0 SUBSHELL)
# ==============================================================================
_trim_str() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  REPLY_TRIM="$s"
}

_expand_vars_safe() {
  local s="$1"
  local REPLY_TRIM=""
  _trim_str "$s"
  s="$REPLY_TRIM"

  if [[ "$s" == \"*\" ]]; then
    s="${s#\"}"
    s="${s%\"}"
  elif [[ "$s" == \'*\' ]]; then
    s="${s#\'}"
    s="${s%\'}"
  fi

  local re='\$\{([a-zA-Z_][a-zA-Z0-9_]*):-([^}]*)\}|\$\{([a-zA-Z_][a-zA-Z0-9_]*)\}|\$([a-zA-Z_][a-zA-Z0-9_]*)'
  local out="" rest="$s" full prefix var_name def_val var_val
  while [[ "$rest" =~ $re ]]; do
    full="${BASH_REMATCH[0]}"
    if [[ -n "${BASH_REMATCH[1]}" ]]; then
      var_name="${BASH_REMATCH[1]}"
      def_val="${BASH_REMATCH[2]}"
      var_val="${!var_name:-$def_val}"
    elif [[ -n "${BASH_REMATCH[3]}" ]]; then
      var_name="${BASH_REMATCH[3]}"
      var_val="${!var_name:-}"
    else
      var_name="${BASH_REMATCH[4]}"
      var_val="${!var_name:-}"
    fi
    prefix="${rest%%"$full"*}"
    out+="${prefix}${var_val}"
    rest="${rest#*"$full"}"
  done
  s="${out}${rest}"

  printf -v s '%b' "$s"
  s="${s//$'\x1B'\[*([0-9;])[a-zA-Z]/}"
  _trim_str "$s"
  REPLY_EXPANDED="$REPLY_TRIM"
}

_parse_options_from_file() {
  local filepath="$1"
  PARSED_OPTIONS=()
  local in_opts=0 line clean_line REPLY_TRIM="" REPLY_EXPANDED=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    clean_line="${line%%#*}"
    _trim_str "$clean_line"
    clean_line="$REPLY_TRIM"
    [[ -z "$clean_line" ]] && continue

    if ((in_opts == 0)); then
      if [[ "$clean_line" =~ ^options=\((.*)$ ]]; then
        in_opts=1
        clean_line="${BASH_REMATCH[1]}"
        _trim_str "$clean_line"
        clean_line="$REPLY_TRIM"
        if [[ "$clean_line" == *")" ]]; then
          clean_line="${clean_line%)}"
          _trim_str "$clean_line"
          if [[ -n "$REPLY_TRIM" ]]; then
            _expand_vars_safe "$REPLY_TRIM"
            [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
          fi
          break
        fi
        [[ -z "$clean_line" ]] && continue
      else
        continue
      fi
    fi

    if ((in_opts == 1)); then
      if [[ "$clean_line" == ")"* ]]; then
        break
      elif [[ "$clean_line" == *")" ]]; then
        clean_line="${clean_line%)}"
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
        break
      else
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
      fi
    fi
  done <"$filepath"
}

declare -A script_doc_map=()
_extract_huong_dan_flat() {
  local script_file="$1"
  REPLY_DOC=""
  [[ -r "$script_file" ]] || return 0

  if [[ -v script_doc_map["$script_file"] ]]; then
    REPLY_DOC="${script_doc_map["$script_file"]}"
    return 0
  fi

  local active=0 line trimmed doc_acc=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?huong_dan[[:space:]]*\(\)[[:space:]]*\{ ]]; then
        active=1
      fi
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*\} ]]; then
      break
    fi

    if [[ "$line" =~ ^[[:space:]]*cat[[:space:]]+\<\<-?[[:space:]]*[\'\"]?EOF[\'\"]? ]] || [[ "$line" =~ ^[[:space:]]*EOF[[:space:]]*$ ]]; then
      continue
    fi

    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -z "$trimmed" ]] && continue

    if [[ "$trimmed" =~ ^echo([[:space:]]+-[eEn]+)?[[:space:]]+(.*)$ ]]; then
      trimmed="${BASH_REMATCH[2]}"
      if [[ "$trimmed" == \"*\" ]]; then
        trimmed="${trimmed#\"}"
        trimmed="${trimmed%\"}"
      elif [[ "$trimmed" == \'*\' ]]; then
        trimmed="${trimmed#\'}"
        trimmed="${trimmed%\'}"
      fi
    fi

    trimmed="${trimmed//$'\t'/ }"
    if [[ -n "$doc_acc" ]]; then
      doc_acc+=" $trimmed"
    else
      doc_acc="$trimmed"
    fi
  done <"$script_file"

  if [[ "$doc_acc" == *"\033"* || "$doc_acc" == *"\e"* || "$doc_acc" == *$'\x1B'* ]]; then
    printf -v doc_acc '%b' "$doc_acc"
    doc_acc="${doc_acc//$'\x1B'\[*([0-9;])[a-zA-Z]/}"
  fi
  doc_acc="${doc_acc//[$'\r\n\t']/ }"

  script_doc_map["$script_file"]="$doc_acc"
  REPLY_DOC="$doc_acc"
}

# ==============================================================================
# 2. ĐỌC HOẶC XÂY DỰNG CACHE INDEX FULL-TEXT (DÙNG CHUNG VỚI SEARCH-HUONG-DAN)
# ==============================================================================
mkdir -p /etc/wptt/tmp 2>/dev/null || true
export CACHE_FILE="/etc/wptt/tmp/wptt_search_ft_${ngon_ngu}_${version_wptangtoc_ols:-latest}.tsv"

declare -A feature_scripts=()
declare -A feature_args=()
declare -a initial_lines=()

use_cache=0
if [[ -s "$CACHE_FILE" ]]; then
  cache_mtime=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)
  main_mtime=$(stat -c %Y /usr/bin/wptangtoc 2>/dev/null || echo 0)
  self_mtime=$(stat -c %Y "$0" 2>/dev/null || echo 0)
  printf -v now_ts '%(%s)T' -1
  if ((cache_mtime >= main_mtime && cache_mtime >= self_mtime && (now_ts - cache_mtime) < 86400)); then
    use_cache=1
  fi
fi

if ((use_cache == 1)); then
  while IFS=$'\t' read -r f_key f_script f_arg _; do
    [[ -z "$f_key" || -z "$f_script" ]] && continue
    feature_scripts["$f_key"]="$f_script"
    feature_args["$f_key"]="${f_arg:-98}"
    initial_lines+=("${f_key}"$'\t'"${f_key}"$'\t'"${f_script}"$'\t'"${f_arg:-98}")
  done <"$CACHE_FILE"
fi

if ((${#initial_lines[@]} == 0)); then
  main_definition_file="/usr/bin/wptangtoc"
  declare -A main_menu_priority=()

  if [[ -r "$main_definition_file" ]]; then
    _parse_options_from_file "$main_definition_file"
    for i in "${!PARSED_OPTIONS[@]}"; do
      printf -v prio_str "%02d" "$i"
      main_menu_priority["${PARSED_OPTIONS[$i]}"]="$prio_str"
    done
  fi

  shopt -s nullglob
  all_files_to_process=(/etc/wptt/*-main /etc/wptt/*/*-main /etc/wptt/*/*/*-main)
  shopt -u nullglob

  if [[ -r "$main_definition_file" ]]; then
    has_main=0
    for f in "${all_files_to_process[@]}"; do
      if [[ "$f" -ef "$main_definition_file" ]]; then
        has_main=1
        break
      fi
    done
    ((has_main == 0)) && all_files_to_process+=("$main_definition_file")
  fi

  if ((${#all_files_to_process[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tệp menu nào trên hệ thống."
    exit 1
  fi

  declare -A feature_sort_keys=()
  declare -A feature_docs=()

  for filepath in "${all_files_to_process[@]}"; do
    [[ -r "$filepath" ]] || continue
    file="${filepath##*/}"

    category_title=""
    last_title_var=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^[[:space:]]*echo[[:space:]]+\"\$([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
        last_title_var="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*options=\( ]]; then
        break
      fi
    done <"$filepath"

    if [[ -n "$last_title_var" && -n "${!last_title_var:-}" ]]; then
      category_title="${!last_title_var}"
      category_title="${category_title%:}"
      _trim_str "$category_title"
      category_title="$REPLY_TRIM"
    fi

    if [[ -z "$category_title" ]]; then
      category_base="${file%-main}"
      category_base="${category_base#wptt-}"
      category_base="${category_base#wptangtoc-}"
      category_base="${category_base//-/ }"
      category_title="${category_base^}"
    fi

    _parse_options_from_file "$filepath"
    ((${#PARSED_OPTIONS[@]} == 0)) && continue

    in_run_action=0
    in_case=0
    current_label=""
    current_script=""
    current_args="98"

    while IFS= read -r line || [[ -n "$line" ]]; do
      clean_line="${line%%#*}"
      _trim_str "$clean_line"
      clean_line="$REPLY_TRIM"
      [[ -z "$clean_line" ]] && continue

      if ((in_run_action == 0)); then
        [[ "$clean_line" =~ ^run_action[[:space:]]*\(\) ]] && in_run_action=1
        continue
      fi

      if ((in_case == 0)); then
        [[ "$clean_line" =~ ^case[[:space:]]+ ]] && in_case=1
        continue
      fi

      if [[ "$clean_line" == "esac"* ]]; then
        break
      fi

      if [[ "$clean_line" =~ ^([0-9]+)\)(.*)$ ]]; then
        current_label="${BASH_REMATCH[1]}"
        clean_line="${BASH_REMATCH[2]}"
        current_script=""
        current_args="98"
      fi

      if [[ -n "$current_label" ]]; then
        if [[ "$clean_line" =~ script_path=\"([^\"]+)\" ]]; then
          current_script="${BASH_REMATCH[1]}"
        elif [[ "$clean_line" =~ (exec|\.)[[:space:]]+(/etc/wptt/[^[:space:]\;]+) ]]; then
          current_script="${BASH_REMATCH[2]}"
        fi

        if [[ "$clean_line" =~ script_args=\"([^\"]+)\" ]]; then
          current_args="${BASH_REMATCH[1]}"
        fi

        if [[ "$clean_line" == *";;"* ]]; then
          idx=$((10#$current_label))
          if ((idx >= 0 && idx < ${#PARSED_OPTIONS[@]})) && [[ -n "$current_script" ]]; then
            opt_title="${PARSED_OPTIONS[$idx]}"
            if [[ -n "$opt_title" && "$opt_title" != *"───"* ]]; then
              feature_key="$category_title > $opt_title"
              if [[ -z "${feature_scripts["$feature_key"]:-}" ]]; then
                feature_scripts["$feature_key"]="$current_script"
                feature_args["$feature_key"]="${current_args:-98}"
                feature_sort_keys["$feature_key"]="${main_menu_priority["$opt_title"]:-99}"

                REPLY_DOC=""
                _extract_huong_dan_flat "$current_script"
                feature_docs["$feature_key"]="$REPLY_DOC"
              fi
            fi
          fi
          current_label=""
        fi
      fi
    done <"$filepath"
  done

  if ((${#feature_scripts[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tính năng nào khả dụng."
    exit 1
  fi

  : >"${CACHE_FILE}.tmp"
  while IFS=$'\t' read -r _ f_key; do
    [[ -z "$f_key" ]] && continue
    f_script="${feature_scripts["$f_key"]}"
    f_arg="${feature_args["$f_key"]:-98}"
    f_doc="${feature_docs["$f_key"]:-}"

    initial_lines+=("${f_key}"$'\t'"${f_key}"$'\t'"${f_script}"$'\t'"${f_arg}")
    printf "%s\t%s\t%s\t%s\n" "$f_key" "$f_script" "$f_arg" "$f_doc" >>"${CACHE_FILE}.tmp"
  done < <(
    for key in "${!feature_scripts[@]}"; do
      printf "%s\t%s\n" "${feature_sort_keys["$key"]:-99}" "$key"
    done | sort -k1,1 -k2,2
  )
  mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null || true
fi

((BUILD_ONLY == 1)) && exit 0

# ==============================================================================
# 3. ENGINE TÌM KIẾM TRỌNG SỐ 5 TẦNG & PREVIEW SẠCH GỌN
# ==============================================================================
wptt_fzf_search() {
  local query="${1:-}"
  [[ -s "$CACHE_FILE" ]] || return 0

  LC_ALL=C.UTF-8 awk -F'\t' -v q="$query" '
    function norm_vn(s) {
      s = tolower(s)
      gsub(/oá/, "óa", s); gsub(/oà/, "òa", s); gsub(/oả/, "ỏa", s); gsub(/oã/, "õa", s); gsub(/oạ/, "ọa", s)
      gsub(/uỷ/, "ủy", s); gsub(/uý/, "úy", s); gsub(/uỳ/, "ùy", s); gsub(/uỹ/, "ũy", s); gsub(/uỵ/, "ụy", s)
      return s
    }
    BEGIN {
      q_norm = norm_vn(q)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", q_norm)
      n_words = split(q_norm, q_words, /[[:space:]]+/)
    }
    {
      title = $1
      script = $2
      arg = ($3 != "" ? $3 : "98")
      doc = $4

      if (n_words == 0) {
        printf "10\t%04d\t%s\t%s\t%s\t%s\n", NR, title, title, script, arg
        next
      }

      t_norm = norm_vn(title)
      d_norm = norm_vn(doc)

      in_title = 0
      in_doc = 0

      for (i = 1; i <= n_words; i++) {
        w = q_words[i]
        if (index(t_norm, w) > 0) {
          in_title++
        } else if (index(d_norm, w) > 0) {
          in_doc++
        } else {
          next
        }
      }

      if (index(t_norm, q_norm) > 0) {
        opt_part = t_norm
        sub(/^.*>[[:space:]]*/, "", opt_part)
        if (index(opt_part, q_norm) == 1) score = 5
        else if (index(opt_part, q_norm) > 0) score = 8
        else score = 10
      } else if (in_title == n_words) {
        score = 20
      } else if (in_title > 0) {
        score = 30 + (n_words - in_title)
      } else if (index(d_norm, q_norm) > 0) {
        score = 50
      } else {
        score = 60
      }

      printf "%02d\t%04d\t%s\t%s\t%s\t%s\n", score, NR, title, title, script, arg
    }
  ' "$CACHE_FILE" | sort -t$'\t' -k1,1n -k2,2n | cut -f3-
}
export -f wptt_fzf_search

wptt_fzf_previewer() {
  local f_title="$1"
  local script_to_preview="$2"
  local search_query="${3:-}"

  printf "\033[1;36m⚡ %s\033[0m\n" "$f_title"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    return 0
  fi

  local alt_regex="" word esc_word i ch
  if [[ -n "$search_query" ]]; then
    for word in $search_query; do
      ((${#word} < 2)) && continue
      esc_word=""
      for ((i = 0; i < ${#word}; i++)); do
        ch="${word:i:1}"
        case "$ch" in
        '\' | '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|') esc_word+="\\$ch" ;;
        *) esc_word+="$ch" ;;
        esac
      done
      esc_word="${esc_word//óa/(óa|oá)}"
      esc_word="${esc_word//oá/(óa|oá)}"
      esc_word="${esc_word//ủy/(ủy|uỷ)}"
      esc_word="${esc_word//uỷ/(ủy|uỷ)}"
      if [[ -n "$alt_regex" ]]; then
        alt_regex+="|${esc_word}"
      else
        alt_regex="${esc_word}"
      fi
    done
  fi

  local active=0 line trimmed
  shopt -s nocasematch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?huong_dan[[:space:]]*\(\)[[:space:]]*\{ ]]; then
        active=1
      fi
      continue
    fi
    [[ "$line" =~ ^[[:space:]]*\} ]] && break
    if [[ "$line" =~ ^[[:space:]]*cat[[:space:]]+\<\<-?[[:space:]]*[\'\"]?EOF[\'\"]? ]] || [[ "$line" =~ ^[[:space:]]*EOF[[:space:]]*$ ]]; then
      continue
    fi
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" ]] && continue
    if [[ "$trimmed" =~ ^echo([[:space:]]+-[eEn]+)?[[:space:]]+(.*)$ ]]; then
      line="${BASH_REMATCH[2]}"
      line="${line#\"}"
      line="${line%\"}"
      line="${line#\'}"
      line="${line%\'}"
    fi
    if [[ -n "$alt_regex" && "$line" =~ ($alt_regex) ]]; then
      local out="" rest="$line" m_str prefix
      while [[ "$rest" =~ ($alt_regex) ]]; do
        m_str="${BASH_REMATCH[1]}"
        [[ -z "$m_str" ]] && break
        prefix="${rest%%"$m_str"*}"
        out+="${prefix}"$'\033[1;33;4m'"${m_str}"$'\033[0m'
        rest="${rest#*"$m_str"}"
      done
      line="${out}${rest}"
    fi
    printf "\033[90m%b\033[0m\n" "$line"
  done <"$script_to_preview"
  shopt -u nocasematch
}
export -f wptt_fzf_previewer

clear

# ==============================================================================
# 4. HIỂN THỊ GIAO DIỆN TÌM KIẾM FZF
# ==============================================================================
selected_line=""
trap '' SIGINT
selected_line=$(
  SHELL=/bin/bash printf "%s\n" "${initial_lines[@]}" | fzf \
    --ansi \
    --disabled \
    --bind 'change:reload:wptt_fzf_search {q}' \
    --prompt="🔍 Tìm kiếm tính năng WPTangToc OLS > " \
    --height='~65%' \
    --border=rounded \
    --color=border:red \
    --layout=reverse \
    --cycle \
    --with-nth=1 \
    --delimiter=$'\t' \
    --header="Tìm thấy ${#initial_lines[@]} tính năng [↑/↓] Di chuyển, ESC hủy, Gõ để lọc, Enter chọn." \
    --preview='wptt_fzf_previewer {2} {3} {q}' \
    --preview-window=up:5:wrap
) || true
trap '_wptt_search_ctrl_c' SIGINT

# ==============================================================================
# 5. ĐIỀU HƯỚNG THỰC THI AN TOÀN
# ==============================================================================
if [[ -n "$selected_line" ]]; then
  IFS=$'\t' read -r _ selected_feature script_to_run script_arguments <<<"$selected_line"
  [[ -z "$script_arguments" ]] && script_arguments="98"

  echo ""
  echoXanhlacay "Bạn đã chọn:"
  echo "$selected_feature"
  echo ""
  echoDo "────────────────────────────────────────────────────────────────────────────────"

  if [[ -n "$script_to_run" && -f "$script_to_run" ]]; then
    chmod +x "$script_to_run" 2>/dev/null || true
    exec "$script_to_run" "$script_arguments"
  else
    _runloi "Lỗi: Không thể thực thi script '$script_to_run'."
    sleep 2
    exec /usr/bin/wptangtoc
  fi
else
  echoVang "Không chọn gì. Đang thoát..."
  if [[ -f /etc/wptt/wptt-status2 ]]; then
    exec /etc/wptt/wptt-status2
  else
    exec /usr/bin/wptangtoc
  fi
fi
