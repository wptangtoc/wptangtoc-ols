#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Real-Time System Dashboard (Enterprise State-Machine & 0-Subshell Zero-Flicker Engine)

if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
  exit 0
fi

# Chỉ nạp thư viện nếu tiến trình cha chưa nạp
if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  # shellcheck source=/dev/null
  [[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null
fi

# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
if [[ -z "${tai_ma_nguon_wordpress:-}" && -f "/etc/wptt/lang/${ngon_ngu}.sh" ]]; then
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
fi
if ! declare -F _runing &>/dev/null; then
  # shellcheck source=/dev/null
  [[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
fi

# Đảm bảo Locale UTF-8 chuẩn xác cho tính toán độ dài chuỗi và số thực (read -t 0.05)
export LC_ALL=en_US.UTF-8 2>/dev/null || true
export LANG=en_US.UTF-8 2>/dev/null || true
shopt -s extglob

# ==============================================================================
# 1. BẪY TÍN HIỆU (TRAP) - BẢO LƯU TUYỆT KỸ DIỆT ALARM, RESIZE & CON TRỎ
# ==============================================================================
prev_lines=0

_wptt_status_cleanup() {
  tput cnorm 2>/dev/null || printf '\033[?25h'
  stty sane 2>/dev/null || true
}

_wptt_status_ctrl_c() {
  trap - SIGINT SIGTERM SIGQUIT WINCH EXIT
  # TUYỆT KỸ DIỆT ALARM: Mượn lệnh read ảo ép Linux hủy đồng hồ cũ ngay lập tức
  read -r -t 1 </dev/null 2>/dev/null || true
  _wptt_status_cleanup

  if [[ ! -t 0 || ! -t 1 || "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    exit 130
  fi
  clear
  echo -e "Đã thoát ra WPTangToc OLS. Nhập lệnh ${C_GREEN}1${C_RESET} để quay lại menu."
  export WPTT_BYPASS=1
  exec bash --login
}

_wptt_status_on_winch() {
  printf '\033[2J\033[H'
  prev_lines=0
}

trap '_wptt_status_cleanup' EXIT
trap '_wptt_status_ctrl_c' SIGINT SIGTERM SIGQUIT
trap '_wptt_status_on_winch' WINCH

clear

# ==============================================================================
# 2. CẤU HÌNH BACKGROUND ALERTS & UPDATE (KHÔNG BLOCK MÀN HÌNH ĐĂNG NHẬP)
# ==============================================================================
if [[ "${thong_bao_login_ssh:-}" == "1" && -n "${SSH_CLIENT:-}" && -z "${_WPTT_SSH_ALERT_SENT:-}" ]]; then
  export _WPTT_SSH_ALERT_SENT=1
  (
    client_ip="${SSH_CLIENT%% *}"
    [[ -z "$client_ip" ]] && exit 0

    # Chống gửi trùng tuyệt đối khi MobaXterm/Termius mở đồng thời nhiều luồng (Shell + SFTP)
    safe_ip="${client_ip//[^a-zA-Z0-9._-]/_}"
    alert_stamp="/run/wptangtoc/.ssh_alert_${safe_ip}"
    alert_lock="/run/wptangtoc/.ssh_lock_${safe_ip}"
    /bin/mkdir -p /run/wptangtoc 2>/dev/null || true

    # Khóa nguyên tử bằng mkdir (Atomic Directory Lock)
    if ! /bin/mkdir "$alert_lock" 2>/dev/null; then
      exit 0
    fi
    trap '/bin/rmdir "$alert_lock" 2>/dev/null || true' EXIT

    now_ssh=0
    printf -v now_ssh '%(%s)T' -1 2>/dev/null || now_ssh="$(date +%s)"
    if [[ -r "$alert_stamp" ]]; then
      last_alert=0
      IFS= read -r last_alert <"$alert_stamp" 2>/dev/null || true
      if [[ "$last_alert" =~ ^[0-9]+$ ]] && ((now_ssh - last_alert < 60)); then
        exit 0
      fi
    fi

    active_sessions=$(who 2>/dev/null | grep -Fc "($client_ip)" || true)
    if ((active_sessions > 1)); then
      exit 0
    fi
    printf '%s\n' "$now_ssh" >"$alert_stamp" 2>/dev/null || true
    /bin/rmdir "$alert_lock" 2>/dev/null || true

    vps_ip=""
    if declare -F wptt_get_public_ip >/dev/null 2>&1; then
      vps_ip="$(wptt_get_public_ip 2>/dev/null || true)"
    fi
    [[ -z "$vps_ip" ]] && vps_ip=$(curl -skf --connect-timeout 3 --max-time 5 "https://ipv4.icanhazip.com" || curl -skf --connect-timeout 3 --max-time 5 "https://checkip.amazonaws.com" || true)
    [[ -z "$vps_ip" ]] && vps_ip=$(curl -sk --connect-timeout 3 --max-time 5 "https://ipv6.icanhazip.com" || true)

    current_date=""
    printf -v current_date '%(%d-%m-%Y %H:%M)T' -1 2>/dev/null || current_date="$(date '+%d-%m-%Y %H:%M')"

    read -r -d '' text <<EOF || true
🚨 <b>CẢNH BÁO ĐĂNG NHẬP SSH</b> 🚨
━━━━━━━━━━━━━━━━━━━━━━
🖥 <b>Máy chủ:</b> <code>${vps_ip}</code>
🕵️ <b>IP Client:</b> <code>${client_ip}</code>
⏰ <b>Thời gian:</b> <code>${current_date}</code>
━━━━━━━━━━━━━━━━━━━━━━
<i>WPTangToc OLS</i>
EOF

    telegram_tmp_api=$(wptt_giai_ma "${telegram_api:-}" 2>/dev/null || true)
    telegram_api="${telegram_tmp_api:-${telegram_api:-}}"
    telegram_tmp_id=$(wptt_giai_ma "${telegram_id:-}" 2>/dev/null || true)
    telegram_id="${telegram_tmp_id:-${telegram_id:-}}"

    if [[ -n "$telegram_api" && -n "$telegram_id" ]]; then
      TG_BASE_URL="https://api.telegram.org"
      if ! curl -s -m 3 -X POST "${TG_BASE_URL}/bot${telegram_api}/sendMessage" \
        -d "chat_id=$telegram_id" \
        -d "parse_mode=HTML" \
        --data-urlencode "text=${text}" >/dev/null 2>&1; then

        API_PROXY=$(curl --tlsv1.3 -sL -m 8 -H "User-Agent: wptangtoc ols get telegram" "https://hub.wptangtoc.com/get-telegram-work" 2>/dev/null || true)
        API_PROXY="${API_PROXY//[$'\r\n\t ']/}"
        if [[ "$API_PROXY" == *"workers.dev"* ]]; then
          curl -s -m 5 -X POST "https://$API_PROXY/bot${telegram_api}/sendMessage" \
            -d "chat_id=$telegram_id" \
            -d "parse_mode=HTML" \
            --data-urlencode "text=${text}" >/dev/null 2>&1 || true
        fi
      fi
    fi
  ) &
  disown 2>/dev/null || true
fi

# --- KIỂM TRA CẬP NHẬT SIÊU TỐC (ĐỌC CACHE RAM & CẬP NHẬT NGẦM ATOMIC) ---
SHOW_UPDATE=0
NEW_VERSION=""
wptangtocols_version=""
VERSION_CACHE_FILE="/etc/wptt/tmp/wptangtoc-ols-version"

if [[ -s "$VERSION_CACHE_FILE" ]]; then
  wptangtocols_version=$(<"$VERSION_CACHE_FILE")
  wptangtocols_version="${wptangtocols_version//[$'\r\n\t ']/}"
fi

(
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
  chmod 700 /etc/wptt/tmp 2>/dev/null || true
  need_fetch=0
  if [[ ! -s "$VERSION_CACHE_FILE" ]]; then
    need_fetch=1
  else
    file_mtime=$(stat -c %Y "$VERSION_CACHE_FILE" 2>/dev/null || echo 0)
    now_ts=0
    printf -v now_ts '%(%s)T' -1 2>/dev/null || now_ts="$(date +%s)"
    ((now_ts - file_mtime > 21600)) && need_fetch=1
  fi

  if ((need_fetch == 1)); then
    remote_ver=$(curl --tlsv1.3 -sf --connect-timeout 2 --max-time 4 "https://wptangtoc.com/share/version-wptangtoc-ols.txt" 2>/dev/null | head -n 1 || curl --tlsv1.2 -sf --connect-timeout 2 --max-time 4 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt" 2>/dev/null | head -n 1 || true)
    remote_ver="${remote_ver//[$'\r\n\t ']/}"
    if [[ "$remote_ver" =~ ^[0-9]+\.[0-9]+ ]]; then
      tmp_ver="${VERSION_CACHE_FILE}.$$.tmp"
      printf '%s\n' "$remote_ver" >"$tmp_ver" 2>/dev/null && /bin/mv -fT -- "$tmp_ver" "$VERSION_CACHE_FILE" 2>/dev/null || /bin/rm -f -- "$tmp_ver" 2>/dev/null || true
    fi
  fi
) &
disown 2>/dev/null || true

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "${version_wptangtoc_ols:-}" ]]; then
  SHOW_UPDATE=1
  NEW_VERSION="$wptangtocols_version"
fi

# ==============================================================================
# 3. ENGINE KIỂM TRA DỊCH VỤ (ĐỒNG BỘ 100% VỚI wptt_smart_reload_lsws & wptt-header-menu)
# ==============================================================================
CACHED_MARIADB_PID=0

# HELPER 1: Kiểm tra PID sống từ file (100% Pure Bash, 0 Subshell)
_wptt_pidfile_alive() {
  local pfile="$1"
  local pid=""
  if [[ -r "$pfile" ]]; then
    IFS= read -r pid <"$pfile" 2>/dev/null || true
    if [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

# HELPER 2: Kiểm tra Circuit Breaker của OLS (/run/wptangtoc/lsws-reload.cb)
_wptt_ols_cb_is_allowed() {
  local cb_file="/run/wptangtoc/lsws-reload.cb"
  [[ -r "$cb_file" ]] || return 0

  local now=0 line="" count=0
  printf -v now '%(%s)T' -1 2>/dev/null || now="$(date +%s)"

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[0-9]+$ ]] || continue
    if ((now - line < 300)); then
      ((count++))
    fi
  done <"$cb_file"

  ((count < 5))
}

# HELPER 3: Ngủ ngắn không tạo tiến trình con (Zero-Fork Micro-Sleep)
_wptt_micro_sleep() {
  local duration="${1:-0.1}"
  local fifo="/run/wptangtoc/.header_wait.fifo"
  if [[ ! -p "$fifo" ]]; then
    /bin/mkdir -p /run/wptangtoc 2>/dev/null || true
    mkfifo -m 600 "$fifo" 2>/dev/null || true
  fi
  if [[ -p "$fifo" ]]; then
    read -r -t "$duration" _ <>"$fifo" 2>/dev/null || true
  else
    sleep "$duration" 2>/dev/null || true
  fi
}

# KIỂM TRA TRẠNG THÁI OPENLITESPEED (ĐỒNG BỘ 100% VỚI wptt_smart_reload_lsws)
_wptt_check_ols_status() {
  local max_ticks="${1:-22}"
  local pid_file="/tmp/lshttpd/lshttpd.pid"
  local worker_pid_file="/run/wptangtoc/lsws-reload.worker.pid"
  local pending_file="/run/wptangtoc/lsws-reload.pending"
  local processing_file="/run/wptangtoc/lsws-reload.processing"
  local i

  # 1. FAST-PATH (0 Subshell, ~0.01ms): Kiểm tra trực tiếp PID file của OLS
  if _wptt_pidfile_alive "$pid_file"; then
    REPLY_OLS_STATE="running"
    return 0
  fi

  # 2. SMART-RELOAD AWARE: Nếu wptt_smart_reload_lsws đang hoạt động ngầm
  if _wptt_pidfile_alive "$worker_pid_file" || [[ -f "$processing_file" || -f "$pending_file" ]]; then
    if pgrep -x "openlitespeed" >/dev/null 2>&1 || pgrep -x "lshttpd" >/dev/null 2>&1; then
      REPLY_OLS_STATE="running"
      return 0
    fi

    for ((i = 0; i < max_ticks; i++)); do
      _wptt_micro_sleep 0.1
      if _wptt_pidfile_alive "$pid_file" || pgrep -x "openlitespeed" >/dev/null 2>&1 || pgrep -x "lshttpd" >/dev/null 2>&1; then
        REPLY_OLS_STATE="running"
        return 0
      fi
      if ! _wptt_pidfile_alive "$worker_pid_file" && [[ ! -f "$processing_file" ]]; then
        break
      fi
    done

    # Nếu đang ở trong vòng lặp live mà Worker vẫn đang tích cực nạp -> giữ trạng thái running để không báo lỗi giả
    if ((max_ticks < 22)) && _wptt_pidfile_alive "$worker_pid_file" && _wptt_ols_cb_is_allowed; then
      REPLY_OLS_STATE="running"
      return 0
    fi
  fi

  # 3. KIỂM TRA LẠI TRONG RAM (Trường hợp file PID bị xóa nhầm nhưng tiến trình vẫn sống)
  if pgrep -x "openlitespeed" >/dev/null 2>&1 || pgrep -x "lshttpd" >/dev/null 2>&1; then
    REPLY_OLS_STATE="running"
    return 0
  fi

  # 4. AUTO-HEALING QUA wptt_smart_reload_lsws (Tôn trọng Circuit Breaker & Non-blocking)
  if ! _wptt_ols_cb_is_allowed; then
    REPLY_OLS_STATE=""
    return 1
  fi

  if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
    wptt_smart_reload_lsws >/dev/null 2>&1 || true
  elif [[ -x /usr/local/lsws/bin/lswsctrl ]]; then
    (systemctl start lsws.service >/dev/null 2>&1 || /usr/local/lsws/bin/lswsctrl start >/dev/null 2>&1 || true) &
    disown 2>/dev/null || true
  fi

  for ((i = 0; i < max_ticks; i++)); do
    _wptt_micro_sleep 0.1
    if _wptt_pidfile_alive "$pid_file" || pgrep -x "openlitespeed" >/dev/null 2>&1 || pgrep -x "lshttpd" >/dev/null 2>&1; then
      REPLY_OLS_STATE="running"
      return 0
    fi
  done

  REPLY_OLS_STATE=""
  return 1
}

# KIỂM TRA TRẠNG THÁI MARIADB (ZERO-FORK FAST-PATH + NON-BLOCKING AUTO-HEAL)
_wptt_check_mariadb_status() {
  local max_ticks="${1:-15}"
  local pf="" state="" now=0 last_fail=0 found_pid="" proc_comm="" i
  local db_cb_file="/run/wptangtoc/mariadb-heal.ts"

  # 1. FAST-PATH (0 Subshell, ~0.01ms): Đọc trực tiếp các đường dẫn PID chuẩn
  for pf in /run/mariadb/mariadb.pid /var/run/mariadb/mariadb.pid /run/mysqld/mysqld.pid /var/run/mysqld/mysqld.pid; do
    if _wptt_pidfile_alive "$pf"; then
      REPLY_MARIADB_STATE="active"
      return 0
    fi
  done

  # 1b. FAST-PATH CACHE (0 Subshell): Nếu MariaDB đặt PID trong /var/lib/mysql
  if ((CACHED_MARIADB_PID > 1)) && kill -0 "$CACHED_MARIADB_PID" 2>/dev/null; then
    if [[ -r "/proc/$CACHED_MARIADB_PID/comm" ]]; then
      IFS= read -r proc_comm <"/proc/$CACHED_MARIADB_PID/comm" 2>/dev/null || true
      if [[ "$proc_comm" == "mariadbd" || "$proc_comm" == "mysqld" ]]; then
        REPLY_MARIADB_STATE="active"
        return 0
      fi
    fi
  fi

  # 2. Kiểm tra nhanh trong RAM và lưu lại CACHED_MARIADB_PID cho các chu kỳ sau
  found_pid="$(pgrep -x "mariadbd" 2>/dev/null | head -n 1 || pgrep -x "mysqld" 2>/dev/null | head -n 1 || true)"
  if [[ "$found_pid" =~ ^[0-9]+$ ]] && ((found_pid > 1)); then
    CACHED_MARIADB_PID=$found_pid
    REPLY_MARIADB_STATE="active"
    return 0
  fi

  # 3. Kiểm tra trạng thái systemd (Nếu đang khởi động/reload thì chờ, không bắn đè restart)
  state="$(systemctl is-active mariadb.service 2>/dev/null || true)"
  if [[ "$state" == "active" ]]; then
    REPLY_MARIADB_STATE="active"
    return 0
  elif [[ "$state" == "activating" || "$state" == "reloading" ]]; then
    for ((i = 0; i < max_ticks; i++)); do
      _wptt_micro_sleep 0.15
      if pgrep -x "mariadbd" >/dev/null 2>&1 || pgrep -x "mysqld" >/dev/null 2>&1; then
        REPLY_MARIADB_STATE="active"
        return 0
      fi
    done
    if ((max_ticks < 15)); then
      REPLY_MARIADB_STATE="active"
      return 0
    fi
  fi

  # 4. Chống bão Auto-Restart nếu MariaDB vừa được kích hoạt cứu hộ trong vòng 30 giây qua
  printf -v now '%(%s)T' -1 2>/dev/null || now="$(date +%s)"
  if [[ -r "$db_cb_file" ]]; then
    IFS= read -r last_fail <"$db_cb_file" 2>/dev/null || true
    if [[ "$last_fail" =~ ^[0-9]+$ ]] && ((now - last_fail < 30)); then
      REPLY_MARIADB_STATE="${state:-inactive}"
      return 1
    fi
  fi

  # 5. NON-BLOCKING AUTO-HEALING: Khởi chạy ngầm để không bao giờ treo cứng giao diện Dashboard
  /bin/mkdir -p /run/wptangtoc 2>/dev/null || true
  printf '%s\n' "$now" >"$db_cb_file" 2>/dev/null || true

  (
    if systemctl start mariadb.service >/dev/null 2>&1 || systemctl start mysql.service >/dev/null 2>&1; then
      /bin/rm -f -- "$db_cb_file" 2>/dev/null || true
    fi
  ) &
  disown 2>/dev/null || true

  for ((i = 0; i < max_ticks; i++)); do
    _wptt_micro_sleep 0.1
    if pgrep -x "mariadbd" >/dev/null 2>&1 || pgrep -x "mysqld" >/dev/null 2>&1; then
      /bin/rm -f -- "$db_cb_file" 2>/dev/null || true
      REPLY_MARIADB_STATE="active"
      return 0
    fi
  done

  REPLY_MARIADB_STATE="${state:-inactive}"
  return 1
}

# ==============================================================================
# 4. CÁC HÀM VẼ COMPONENT ĐẶC THÙ CHO DASHBOARD (100% 0-SUBSHELL & PIXEL-PERFECT)
# ==============================================================================
DASHBOARD_BUFFER=""
DASHBOARD_LINES=0

_append_row() {
  # Thêm \033[K để xóa sạch mọi tàn dư ký tự ở cuối dòng (nếu có)
  DASHBOARD_BUFFER+="$1"$'\033[K\n'
  ((DASHBOARD_LINES++))
}

# Giải mã \033 / \e và lọc sạch mã màu ANSI chỉ bằng 1 phép thế extglob trên RAM (0 Subshell)
_wptt_plain_len() {
  local s=""
  printf -v s '%b' "$1"
  s="${s//[$'\r\n']/}"
  s="${s//$'\x1B'\[*([0-9;])[a-zA-Z]/}"

  local test_char="Đ"
  if ((${#test_char} == 1)); then
    REPLY_LEN=${#s}
  else
    local stripped="${s//[$'\x80'-$'\xbf']/}"
    REPLY_LEN=${#stripped}
  fi
}

# Vẽ thanh tiến trình trực tiếp vào biến REPLY_BAR (0 Subshell)
draw_bar_fast() {
  local percent=$1
  local length=15
  ((percent < 0)) && percent=0
  ((percent > 100)) && percent=100
  local fill=$(((percent * length) / 100))
  ((fill < 0)) && fill=0
  ((fill > length)) && fill=$length
  local empty=$((length - fill))

  local color="$C_GREEN"
  if ((percent >= 80)); then
    color="$C_RED"
  elif ((percent >= 60)); then
    color="$C_YELLOW"
  fi

  local fill_str="" empty_str=""
  if ((fill > 0)); then
    printf -v fill_str "%${fill}s" ""
    fill_str="${fill_str// /|}"
  fi
  if ((empty > 0)); then
    printf -v empty_str "%${empty}s" ""
    empty_str="${empty_str// /.}"
  fi
  REPLY_BAR="${C_CYAN}[${color}${fill_str}${C_RESET}${empty_str}${C_CYAN}]${C_RESET}"
}

# Căn giữa 1 dòng chuẩn khung 78 ký tự (0 Subshell)
buf_center_text() {
  local text="$1"
  local border_color="${2:-$C_CYAN}"
  if [[ -z "$text" ]]; then
    _append_row "${border_color}│${C_RESET}${EMPTY_78}${border_color}│${C_RESET}"
    return 0
  fi
  local REPLY_LEN=0
  _wptt_plain_len "$text"
  local len=$REPLY_LEN
  local pad_l=$(((78 - len) / 2))
  ((pad_l < 0)) && pad_l=0
  local pad_r=$((78 - len - pad_l))
  ((pad_r < 0)) && pad_r=0
  local pad_l_str="" pad_r_str=""
  printf -v pad_l_str '%*s' "$pad_l" ""
  printf -v pad_r_str '%*s' "$pad_r" ""
  _append_row "${border_color}│${C_RESET}${pad_l_str}${text}${pad_r_str}${border_color}│${C_RESET}"
}

# Căn trái 1 dòng chuẩn khung 78 ký tự (0 Subshell)
buf_left_text() {
  local text="$1"
  local indent="${2:-2}"
  local border_color="${3:-$C_CYAN}"
  local REPLY_LEN=0
  _wptt_plain_len "$text"
  local len=$REPLY_LEN
  local pad_r=$((78 - len - indent))
  ((pad_r < 0)) && pad_r=0
  local pad_l_str="" pad_r_str=""
  printf -v pad_l_str '%*s' "$indent" ""
  printf -v pad_r_str '%*s' "$pad_r" ""
  _append_row "${border_color}│${C_RESET}${pad_l_str}${text}${pad_r_str}${border_color}│${C_RESET}"
}

# In 1 dòng tài nguyên tự động fill padding chuẩn 78 ký tự (0 Subshell)
buf_print_line() {
  local text="$1"
  local REPLY_LEN=0
  _wptt_plain_len "$text"
  local text_len=$REPLY_LEN
  local pad=$((78 - text_len - 2))
  ((pad < 0)) && pad=0
  local pad_str=""
  printf -v pad_str '%*s' "$pad" ""
  _append_row "${C_CYAN}│${C_RESET}  ${text}${pad_str}${C_CYAN}│${C_RESET}"
}

# In 2 cột cân đối cho Network & Service chuẩn 78 ký tự (0 Subshell)
buf_print_2col() {
  local col1="$1"
  local col2="$2"
  local REPLY_LEN=0

  _wptt_plain_len "$col1"
  local len1=$REPLY_LEN
  local pad1=$((38 - len1))
  ((pad1 < 0)) && pad1=0

  _wptt_plain_len "$col2"
  local len2=$REPLY_LEN
  local pad2=$((36 - len2))
  ((pad2 < 0)) && pad2=0

  local pad1_str="" pad2_str=""
  printf -v pad1_str '%*s' "$pad1" ""
  printf -v pad2_str '%*s' "$pad2" ""

  _append_row "${C_CYAN}│${C_RESET}  ${col1}${pad1_str}  ${col2}${pad2_str}${C_CYAN}│${C_RESET}"
}

# ==============================================================================
# 5. ENGINE RENDER DASHBOARD CHÍNH (GỘP KHỐI UX MỚI - 0 SUBSHELL)
# ==============================================================================
printf -v EMPTY_78 '%78s' ""
BORDER_TOP="${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
BORDER_MID="${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
BORDER_BOT="${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

OS_NAME_STATIC="Linux Server"
if [[ -r /etc/os-release ]]; then
  while read -r line; do
    if [[ "$line" == PRETTY_NAME=* ]]; then
      tmp_name="${line#*=}"
      tmp_name="${tmp_name//\"/}"
      tmp_name="${tmp_name%%(*}"
      read -r w1 w2 w3 _ <<<"$tmp_name"
      OS_NAME_STATIC="${w1}${w2:+ $w2}${w3:+ $w3}"
      break
    fi
  done </etc/os-release 2>/dev/null
fi

render_dashboard_buffer() {
  local rx_rate_in=$1
  local tx_rate_in=$2
  local cpu_usage_in=$3
  local ols_status_in=$4
  local db_status_in=$5

  DASHBOARD_BUFFER=""
  DASHBOARD_LINES=0

  ((cpu_usage_in < 0)) && cpu_usage_in=0
  ((cpu_usage_in > 100)) && cpu_usage_in=100

  # --- Data Fetching (Pure Bash - 0 Subshell + Fallback cho Kernel cũ) ---
  local name value mem_total=1048576 mem_free=0 mem_buf=0 mem_cached=0 mem_avail=-1
  while read -r name value _; do
    case "$name" in
      MemTotal:) mem_total=$value ;;
      MemFree:) mem_free=$value ;;
      MemAvailable:)
        mem_avail=$value
        break
        ;;
      Buffers:) mem_buf=$value ;;
      Cached:)
        mem_cached=$value
        break
        ;;
    esac
  done </proc/meminfo

  if ((mem_avail < 0)); then
    mem_avail=$((mem_free + mem_buf + mem_cached))
  fi

  local ram_total=$((mem_total / 1024))
  ((ram_total <= 0)) && ram_total=1024
  local ram_used=$(((mem_total - mem_avail) / 1024))
  ((ram_used < 0)) && ram_used=0
  local ram_percent=$((ram_used * 100 / ram_total))
  ((ram_percent < 0)) && ram_percent=0
  ((ram_percent > 100)) && ram_percent=100

  local net_in_display="${rx_rate_in} KB/s"
  local net_out_display="${tx_rate_in} KB/s"
  ((rx_rate_in > 5120)) && net_in_display="${C_RED}${rx_rate_in} KB/s${C_RESET}"
  ((tx_rate_in > 5120)) && net_out_display="${C_RED}${tx_rate_in} KB/s${C_RESET}"

  local l1 l2 l3 _
  read -r l1 l2 l3 _ </proc/loadavg
  local load_avg="$l1, $l2, $l3"

  local uptime_full
  read -r uptime_full _ </proc/uptime
  local up_seconds=${uptime_full%%.*}
  local d=$((up_seconds / 86400))
  local h=$(((up_seconds % 86400) / 3600))
  local m=$(((up_seconds % 3600) / 60))
  local s=$((up_seconds % 60))
  local uptime_display="${d}d ${h}h ${m}m ${s}s"

  # --- BẮT ĐẦU LẮP RÁP KHUNG HÌNH TRÊN RAM ---
  _append_row "$BORDER_TOP"

  # Khối 1: Tên & Phiên bản
  buf_center_text "${C_BOLD_WHITE}WPTANGTOC OLS ${phien_ban:-phiên bản}: ${version_wptangtoc_ols:-}${C_RESET}" "$C_CYAN"
  _append_row "$BORDER_MID"

  # Khối 2: Tác giả & Bản quyền
  buf_center_text "" "$C_CYAN"
  buf_center_text "${C_BOLD_WHITE}${phat_trien_boi_gia_tuan:-Phát triển bởi: Gia Tuấn}${C_RESET}" "$C_CYAN"

  if [[ "${wptangtoc_ols_giatuan:-}" == "1" || -n "${key_activate:-}" ]]; then
    buf_center_text "${C_BOLD_WHITE}Bản Quyền: Enterprise${C_RESET}" "$C_CYAN"
  fi

  [[ "${beta_wptangtoc_ols:-}" == "1" ]] && buf_center_text "${C_BOLD_WHITE}[Phiên bản Beta]${C_RESET}" "$C_CYAN"
  buf_center_text "" "$C_CYAN"
  _append_row "$BORDER_MID"

  # Khối 3: Trạng thái Server Nhúng (Đồng bộ 100% với wptt-header-menu)
  if [[ "$ols_status_in" == *"Hoạt động"* && "$db_status_in" == *"Hoạt động"* ]]; then
    buf_left_text "${C_BOLD_WHITE}${tinh_trang_may_chu:-Tình trạng máy chủ}: ${C_GREEN}${hoat_dong_tot:-Hoạt động tốt}${C_RESET}" 2 "$C_CYAN"
  elif [[ "$ols_status_in" == *"Kiểm tra"* || "$db_status_in" == *"Kiểm tra"* ]]; then
    buf_left_text "${C_BOLD_WHITE}${tinh_trang_may_chu:-Tình trạng máy chủ}: ${C_YELLOW}Đang kiểm tra...${C_RESET}" 2 "$C_CYAN"
  else
    buf_left_text "${C_BOLD_WHITE}${tinh_trang_may_chu:-Tình trạng máy chủ}: ${C_RED}${may_chu_dang_gap_van_de:-Đang gặp sự cố!}${C_RESET}" 2 "$C_CYAN"
    [[ "$ols_status_in" != *"Hoạt động"* && "$ols_status_in" != *"Kiểm tra"* ]] && buf_left_text "${C_YELLOW}↳ Cảnh báo: ${C_RED}Webserver LiteSpeed ngừng hoạt động!${C_RESET}" 5 "$C_CYAN"
    [[ "$db_status_in" != *"Hoạt động"* && "$db_status_in" != *"Kiểm tra"* ]] && buf_left_text "${C_YELLOW}↳ Cảnh báo: ${C_RED}Database MariaDB ngừng hoạt động!${C_RESET}" 5 "$C_CYAN"
  fi
  _append_row "$BORDER_MID"

  # Khối 4: Tài nguyên (CPU, RAM, DISK) - 0 Subshell
  local REPLY_BAR="" line_cpu="" line_ram="" line_disk=""
  draw_bar_fast "$cpu_usage_in"
  printf -v line_cpu "${C_BOLD_WHITE}CPU :${C_RESET} %3s%% %s  %-5s %s" "$cpu_usage_in" "$REPLY_BAR" "Load:" "$load_avg"
  buf_print_line "$line_cpu"

  draw_bar_fast "$ram_percent"
  printf -v line_ram "${C_BOLD_WHITE}RAM :${C_RESET} %3s%% %s  %-5s %s/%s MB" "$ram_percent" "$REPLY_BAR" "Used:" "$ram_used" "$ram_total"
  buf_print_line "$line_ram"

  draw_bar_fast "$cached_disk_percent"
  printf -v line_disk "${C_BOLD_WHITE}Disk:${C_RESET} %3s%% %s  %-5s %s/%s GB" "$cached_disk_percent" "$REPLY_BAR" "Used:" "$cached_disk_used" "$cached_disk_total"
  buf_print_line "$line_disk"
  _append_row "$BORDER_MID"

  # Khối 5: Network & Dịch vụ
  buf_print_2col "${C_BOLD_WHITE}Net In :${C_RESET} $net_in_display" "${C_BOLD_WHITE}OpenLiteSpeed :${C_RESET} $ols_status_in"
  buf_print_2col "${C_BOLD_WHITE}Net Out:${C_RESET} $net_out_display" "${C_BOLD_WHITE}MariaDB       :${C_RESET} $db_status_in"
  buf_print_2col "${C_BOLD_WHITE}Uptime :${C_RESET} $uptime_display" "${C_BOLD_WHITE}OS            :${C_RESET} $OS_NAME_STATIC"
  _append_row "$BORDER_MID"

  # Khối 6: Menu Điều hướng
  local menu_str="${C_GREEN}[ENTER]${C_RESET} Menu | ${C_GREEN}[2]${C_RESET} Menu nhanh"
  [[ "$SHOW_UPDATE" == "1" ]] && menu_str="${menu_str} | ${C_YELLOW}[9] Cập nhật ($NEW_VERSION)${C_RESET}"
  menu_str="${menu_str} | ${C_RED}[0]${C_RESET} Thoát (Bash CLI)"
  buf_center_text "$menu_str" "$C_CYAN"

  # Cảnh báo hệ thống (Nếu có)
  if ((ram_percent > 85 || cached_disk_percent > 90)); then
    _append_row "$BORDER_MID"
    ((ram_percent > 85)) && buf_left_text "${C_RED} Cảnh báo: RAM đang quá tải!${C_RESET}" 2 "$C_CYAN"
    ((cached_disk_percent > 90)) && buf_left_text "${C_RED} Cảnh báo: Ổ cứng sắp đầy!${C_RESET}" 2 "$C_CYAN"
  fi
  _append_row "$BORDER_BOT"
}

# ==============================================================================
# 6. CÁC HÀM LẤY DỮ LIỆU HỆ THỐNG SIÊU NHẸ (ZERO-FORK FAST-PATH)
# ==============================================================================
cached_disk_used=0
cached_disk_total=1
cached_disk_percent=0
SERVICES_ALL_OK=0

_update_disk_usage() {
  local df_out="" _fs="" _sz="" _used="" _avail="" _pct="" _mnt=""
  df_out="$(LC_ALL=C df -BG -P / 2>/dev/null || true)"
  if [[ -n "$df_out" ]]; then
    {
      read -r _ || true
      read -r _fs _sz _used _avail _pct _mnt || true
    } <<<"$df_out"
  fi
  cached_disk_used="${_used%G}"
  cached_disk_total="${_sz%G}"
  cached_disk_percent="${_pct%%%}"
  [[ "$cached_disk_percent" =~ ^[0-9]+$ ]] || cached_disk_percent=0
  ((cached_disk_percent > 100)) && cached_disk_percent=100
  [[ "$cached_disk_used" =~ ^[0-9]+$ ]] || cached_disk_used=0
  [[ "$cached_disk_total" =~ ^[0-9]+$ ]] || cached_disk_total=1
}

_update_services_status() {
  local ols_wait="${1:-4}"
  local db_wait="${2:-4}"
  local REPLY_OLS_STATE="" REPLY_MARIADB_STATE=""
  local ols_ok=0 db_ok=0

  if _wptt_check_ols_status "$ols_wait"; then
    cached_ols_status="${C_GREEN}Hoạt động${C_RESET}"
    ols_ok=1
  else
    cached_ols_status="${C_RED}Tạm dừng${C_RESET}"
  fi

  if _wptt_check_mariadb_status "$db_wait"; then
    cached_db_status="${C_GREEN}Hoạt động${C_RESET}"
    db_ok=1
  else
    cached_db_status="${C_RED}Tạm dừng${C_RESET}"
  fi

  if ((ols_ok == 1 && db_ok == 1)); then
    SERVICES_ALL_OK=1
  else
    SERVICES_ALL_OK=0
  fi
}

_read_cpu_stat() {
  local _cpu u n s idle iowait irq softirq steal _
  read -r _cpu u n s idle iowait irq softirq steal _ </proc/stat
  CPU_IDLE=$((idle + ${iowait:-0}))
  CPU_TOTAL=$((u + n + s + CPU_IDLE + ${irq:-0} + ${softirq:-0} + ${steal:-0}))
}

_read_net_stat() {
  NET_RX=0
  NET_TX=0
  local iface rx _ tx
  # Đưa dấu ':' vào IFS để không bị dính chuỗi "eth0:1048576000" khi băng thông > 100MB
  while IFS=$' \t:' read -r iface rx _ _ _ _ _ _ _ tx _; do
    [[ -z "$iface" || "$iface" == "lo" || "$iface" == *"Inter-"* || "$iface" == *"face"* ]] && continue
    [[ "$rx" =~ ^[0-9]+$ && "$tx" =~ ^[0-9]+$ ]] || continue
    NET_RX=$((NET_RX + rx))
    NET_TX=$((NET_TX + tx))
  done </proc/net/dev
}

# ==============================================================================
# 7. VÒNG LẶP CHÍNH (REAL-TIME REFRESH - 0 SUBSHELL PER TICK)
# ==============================================================================
_read_cpu_stat
prev_total=$CPU_TOTAL
prev_idle=$CPU_IDLE

_read_net_stat
rx_prev=$NET_RX
tx_prev=$NET_TX

tput civis 2>/dev/null || printf '\033[?25l'
ACTION="menu"
counter=0
cached_ols_status="${C_YELLOW}Đang kiểm tra...${C_RESET}"
cached_db_status="${C_YELLOW}Đang kiểm tra...${C_RESET}"
cpu_display_val=0

while true; do
  if ((counter == 0)); then
    # Lần đầu mở màn hình: Chờ tối đa 2.2s nếu dịch vụ đang giữa nhịp Reload/Auto-Heal
    _update_services_status 22 15
    _update_disk_usage
  elif ((SERVICES_ALL_OK == 0)); then
    # Nếu có dịch vụ chưa lên, kiểm tra lại mỗi 1s (giới hạn chờ 0.3s để không lag phím)
    _update_services_status 3 3
  elif ((counter % 5 == 0)); then
    # Khi cả 2 dịch vụ đều khỏe, Fast-Path 0-Subshell chỉ tốn 0.01ms
    _update_services_status 3 3
  fi

  if ((counter > 0 && counter % 10 == 0)); then
    _update_disk_usage
    if ((SHOW_UPDATE == 0)) && [[ -s "$VERSION_CACHE_FILE" ]]; then
      wptangtocols_version=$(<"$VERSION_CACHE_FILE")
      wptangtocols_version="${wptangtocols_version//[$'\r\n\t ']/}"
      if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "${version_wptangtoc_ols:-}" ]]; then
        SHOW_UPDATE=1
        NEW_VERSION="$wptangtocols_version"
      fi
    fi
  fi

  _read_net_stat
  if ((NET_RX < rx_prev)); then
    rx_rate=0
  else
    rx_rate=$(((NET_RX - rx_prev) / 1024))
  fi
  if ((NET_TX < tx_prev)); then
    tx_rate=0
  else
    tx_rate=$(((NET_TX - tx_prev) / 1024))
  fi
  rx_prev=$NET_RX
  tx_prev=$NET_TX

  _read_cpu_stat
  diff_total=$((CPU_TOTAL - prev_total))
  diff_idle=$((CPU_IDLE - prev_idle))
  prev_total=$CPU_TOTAL
  prev_idle=$CPU_IDLE

  if ((diff_total <= 0)); then
    cpu_now=0
  else
    cpu_now=$((100 * (diff_total - diff_idle) / diff_total))
  fi
  if ((counter <= 1)); then
    cpu_display_val=$cpu_now
  else
    cpu_display_val=$(((cpu_display_val + cpu_now) / 2))
  fi
  ((counter++))

  # Render toàn bộ khung hình trên RAM (0 Subshell)
  render_dashboard_buffer "$rx_rate" "$tx_rate" "$cpu_display_val" "$cached_ols_status" "$cached_db_status"

  if ((prev_lines > 0)); then
    printf '\r\033[%dA' "$prev_lines"
  fi
  printf '%b' "$DASHBOARD_BUFFER"

  if ((prev_lines > DASHBOARD_LINES)); then
    printf '\033[J'
  fi
  prev_lines=$DASHBOARD_LINES

  key_input=""
  read -r -t 1 -n 1 -s key_input
  READ_STATUS=$?

  if ((READ_STATUS == 0)); then
    if [[ "$key_input" == $'\e' ]]; then
      read -r -t 0.05 -n 10 -s _ 2>/dev/null || true
      continue
    fi

    if [[ "$key_input" == "0" ]]; then
      ACTION="exit"
    elif [[ "$key_input" == "2" ]]; then
      ACTION="search"
    elif [[ "$key_input" == "9" && "$SHOW_UPDATE" == "1" ]]; then
      ACTION="update"
    else
      ACTION="menu"
    fi
    break
  elif ((READ_STATUS == 1 || READ_STATUS == 255)); then
    echo -e "\n${C_RED}Mất kết nối Terminal (EOF). Đang thoát để bảo vệ CPU...${C_RESET}"
    exit 1
  fi
done

trap - EXIT SIGINT SIGTERM SIGQUIT WINCH
_wptt_status_cleanup

case "$ACTION" in
  "exit")
    clear
    echo -e "Đã thoát ra WPTangToc OLS. Nhập lệnh ${C_GREEN}1${C_RESET} để quay lại menu."
    export WPTT_BYPASS=1
    exec bash --login
    ;;

  "search")
    if [[ -f "/etc/wptt/search-wptangtoc" ]]; then
      exec /etc/wptt/search-wptangtoc
    else
      clear && exec /usr/bin/wptangtoc
    fi
    ;;

  "update")
    if [[ -f "/etc/wptt/wptt-update" ]]; then
      exec /etc/wptt/wptt-update
    else
      clear && exec /usr/bin/wptangtoc
    fi
    ;;

  *)
    clear
    exec /usr/bin/wptangtoc
    ;;
esac
