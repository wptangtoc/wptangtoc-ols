#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Truy cập nhanh mã nguồn website (tách tiến trình con, không cần sửa .bashrc)

set -uo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true

wptt_load_main_conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null || true
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null || true

tinh_nang_ten="Truy cập nhanh mã nguồn website"

printf '%b\n' "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}${quan_ly_ma_nguon:-Quản lý mã nguồn} ➜ ${tinh_nang_ten}${C_RESET}"
printf '%b\n\n' "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

NAME="${1:-}"
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/tenmien
  lua_chon_NAME "$tinh_nang_ten"
fi

_exit_cancel() {
  local code="${1:-1}"
  if [[ -n "${WPTT_CD_FILE:-}" ]]; then
    exit "$code"
  fi
  exec /etc/wptt/wptt-ma-nguon-main 1
}

if [[ "${NAME:-0}" == "0" || -z "${NAME:-}" ]]; then
  _exit_cancel 1
fi

if [[ ! "$NAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$ || "$NAME" == *..* ]]; then
  echoDo "Tên miền '${NAME}' không hợp lệ!"
  [[ -z "${WPTT_CD_FILE:-}" ]] && sleep 2
  _exit_cancel 1
fi

pathcheck="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$pathcheck" ]]; then
  [[ -z "${WPTT_CD_FILE:-}" ]] && clear
  echoDo "Tên miền '${NAME}' không tồn tại trên hệ thống này"
  [[ -z "${WPTT_CD_FILE:-}" ]] && sleep 3
  _exit_cancel 1
fi

target_dir="/usr/local/lsws/${NAME}/html"
if [[ ! -d "$target_dir" ]]; then
  printf 'Lỗi: Không thể truy cập thư mục %s\n' "$target_dir" >&2
  printf 'Vì mã nguồn không tồn tại.\n' >&2
  [[ -z "${WPTT_CD_FILE:-}" ]] && sleep 3
  _exit_cancel 1
fi

# Nhánh 1: Gọi từ CLI (wptt cd-src) -> ghi đường dẫn đích để shell cha tự cd
if [[ -n "${WPTT_CD_FILE:-}" && -f "$WPTT_CD_FILE" && ! -L "$WPTT_CD_FILE" && -w "$WPTT_CD_FILE" ]]; then
  printf '%s\n' "$target_dir" > "$WPTT_CD_FILE"
  exit 0
fi

# Nhánh 2: Gọi từ Menu WPTangToc OLS -> nạp .bashrc rồi tự cd đè lên dòng 'cd /wptangtoc-ols'
rc_tmp="$(mktemp "/etc/wptt/tmp/wptt-rc.XXXXXX")" || exit 1
{
  printf '/bin/rm -f -- %q 2>/dev/null || true\n' "$rc_tmp"
  printf '[[ -r ~/.bashrc ]] && source ~/.bashrc\n'
  printf 'printf "==> Chuyển đến %%s\\n" %q\n' "$target_dir"
  printf 'builtin cd -- %q && ls -al\n' "$target_dir"
} > "$rc_tmp"

export WPTT_BYPASS=1
exec bash --rcfile "$rc_tmp"
