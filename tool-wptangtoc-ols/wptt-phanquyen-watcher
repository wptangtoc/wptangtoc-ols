#!/bin/bash
# @author: Gia Tuấn 
# @website: https://wptangtoc.com 
# @description: Realtime Auto Chmod/Chown Watcher Engine

. /etc/wptt/core-functions

shopt -s nullglob
WATCH_DIRS=()
declare -A DOMAIN_USERS

# 1. NẠP DANH SÁCH USER VÀ THƯ MỤC CẦN GIÁM SÁT VÀO RAM (AN TOÀN BỘ NHỚ)
for conf in /etc/wptt/vhost/.*.conf; do
    domain="${conf##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    
    [[ "$domain" != ?*.?* ]] && continue
    
    html_dir="/usr/local/lsws/$domain/html"
    
    # LỚP KHIÊN 1: Loại trừ tuyệt đối Symlink để tránh bị lừa quét nhầm vùng hệ thống
    if [[ -d "$html_dir" && ! -L "$html_dir" ]]; then
        user=$(grep '^User_name_vhost=' "$conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"'"'")
        lock=$(grep '^lock_down=' "$conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"'"'")
        
        # Chỉ tự động sửa quyền cho các domain KHÔNG bật lock_down
        if [[ -n "$user" && -z "$lock" ]]; then
            DOMAIN_USERS["$domain"]="$user"
            WATCH_DIRS+=("$html_dir")
        fi
    fi
done

if [[ ${#WATCH_DIRS[@]} -eq 0 ]]; then
    sleep 60
    exit 0
fi

mkdir -p /etc/wptt/tmp

# 2. LẮNG NGHE SỰ KIỆN QUA KERNEL INOTIFYWAIT
inotifywait -m -e create,moved_to "${WATCH_DIRS[@]}" --format "%w%f" | while read -r raw_filepath; do
    
    # LỚP KHIÊN 2: Lọc rác siêu tốc bằng Parameter Expansion (Tiết kiệm CPU)
    [[ "$raw_filepath" != *".php" && "$raw_filepath" != *".txt" && "$raw_filepath" != *".htaccess" ]] && continue
    [[ "$raw_filepath" == *"/phpmyadmin"* ]] && continue
    
    # LỚP KHIÊN 3: Realpath để bóc trần sự thật đường dẫn (Chống Symlink/Path Traversal)
    filepath=$(realpath -q "$raw_filepath" 2>/dev/null)
    [[ -z "$filepath" ]] && filepath="$raw_filepath"
    
    # LỚP KHIÊN 4: Dùng [--] để chống Argument Injection nếu tên file bắt đầu bằng dấu trừ (-)
    file_owner=$(stat -c %U -- "$filepath" 2>/dev/null)
    [[ -z "$file_owner" ]] && continue
    
    # LỚP KHIÊN 5: Strict Domain Validation bằng Regex (Thay thế hoàn toàn awk)
    if [[ "$filepath" =~ ^/usr/local/lsws/([a-zA-Z0-9.-]+)/html/ ]]; then
        domain="${BASH_REMATCH[1]}"
        expected_user="${DOMAIN_USERS["$domain"]}"
        
        # LỚP KHIÊN 6: Kiểm chứng chéo - Nếu User/Domain hợp lệ và Owner bị sai
        if [[ -n "$expected_user" && "$file_owner" != "$expected_user" ]]; then
            
            LOCK_FILE="/etc/wptt/tmp/lock_chmod_watcher_${domain}.active"
            
            if [[ ! -f "$LOCK_FILE" ]]; then
                touch "$LOCK_FILE" 2>/dev/null
                
                # Bắn tiến trình dọn dẹp xuống Background để Inotify không bị khựng
                (
                    sleep 5 
                    # Set quyền ưu tiên I/O thấp nhất để Website không bị lag khi phân quyền
                    ionice -c 3 nice -n 19 /etc/wptt/wptt-phanquyen "$domain" >/dev/null 2>&1
                    
                    # Dùng cờ -- bảo vệ đường dẫn biến động
                    rm -f -- "$LOCK_FILE"
                ) &
            fi
            
            # LỚP KHIÊN 7: Debounce nâng cao - Rút sạch rác trong ống dẫn (Pipe)
            sleep 1
            while read -r -t 0.1 discard; do :; done
        fi
    fi
done
