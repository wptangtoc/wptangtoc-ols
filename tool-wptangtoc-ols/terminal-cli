#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
# @author: Gia Tuấn
# @website: https://wptangtoc.com

function huong_dan() {
  cat <<'EOF'
  🖥️ TÍNH NĂNG: THOÁT RA GIAO DIỆN DÒNG LỆNH (TERMINAL CLI)
  Tính năng này giúp bạn tạm thời đóng bảng điều khiển (Menu) của WPTangToc OLS để trở về môi trường dòng lệnh gốc của hệ điều hành Linux (Bash/Shell).

  🚀 ỨNG DỤNG THỰC TẾ:
   ➜ Quản trị nâng cao (Power User): Dành cho các quản trị viên cần thực thi các lệnh Linux thủ công nằm ngoài phạm vi hỗ trợ của Menu (ví dụ: `htop`, `ping`, `systemctl`, `grep`).
   ➜ Khắc phục sự cố linh hoạt: Mở không gian tự do để bạn trực tiếp can thiệp vào các file cấu hình, cài đặt thêm các gói phần mềm tùy chỉnh, hoặc phân tích Log hệ thống bằng các công cụ truyền thống.

  💡 CÁCH QUAY TRỞ LẠI MENU WPTANGTOC:
  Hệ thống đã được thiết lập sẵn các phím tắt (alias) thông minh. Bất cứ khi nào bạn làm việc xong ở môi trường dòng lệnh và muốn mở lại bảng điều khiển, chỉ cần gõ phím `1` rồi ấn Enter, hệ thống sẽ ngay lập tức đưa bạn trở lại Menu.

EOF
}

. /etc/wptt/echo-color
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Bảng màu UI chuẩn WPTangToc
C_RED='\033[1;31m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[1;36m'
C_RESET='\033[0m'
C_BOLD='\033[1m' # Đã bổ sung biến in đậm

box_inner_width=78

print_line() {
  local text="$1"
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}

  local pad_right=$((box_inner_width - text_len - 2))
  [[ $pad_right -lt 0 ]] && pad_right=0
  local spaces=$(printf '%*s' "$pad_right" "")

  echo -e "${C_CYAN}│${C_RESET}  ${text}${spaces}${C_CYAN}│${C_RESET}"
}

# ==============================================================================
# THỰC THI CHẾ ĐỘ CLI (VẼ BANNER CHUẨN UX)
# ==============================================================================
stty sane 2>/dev/null
tput cnorm 2>/dev/null
USER_SHELL_NAME=$(basename "$SHELL" 2>/dev/null)
if [[ -z "$USER_SHELL_NAME" ]]; then
  USER_SHELL_NAME="bash"
  USER_SHELL_PATH="/bin/bash"
else
  USER_SHELL_PATH="$SHELL"
fi

clear
echo -e "\n${C_GREEN}Đang thiết lập môi trường dòng lệnh...${C_RESET}\n"

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
print_line "" # Khoảng thở trên
center_text "${C_GREEN}${C_BOLD}BẠN ĐANG Ở CHẾ ĐỘ TERMINAL CLI (DÒNG LỆNH - $USER_SHELL_NAME)${C_RESET}"
print_line "" # Khoảng thở giữa
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
print_line "" # Khoảng thở trên
print_line "  Để quay lại bảng điều khiển WPTangToc OLS bất cứ lúc nào,"
print_line "  hãy gõ lệnh:${C_BOLD}1${C_RESET} rồi ấn Enter."
print_line "" # Khoảng thở dưới
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""

export WPTT_BYPASS=1            # Cấp lệnh bài miễn tử để không bị .bashrc bắt quay lại Menu
exec "$USER_SHELL_PATH" --login # Mở Shell với đầy đủ biến môi trường (Login Shell)
