#!/bin/bash
function huong_dan() {
  Tính năng Phân quyền trong WPTangToc OLS là một công cụ quan trọng giúp thiết lập và quản lý quyền sở hữu [ownership] cũng như quyền truy cập [permissions] cho các tệp tin và thư mục trên máy chủ, đặc biệt là cho các website WordPress. Việc phân quyền chính xác là yếu tố then chốt để đảm bảo an ninh và hoạt động ổn định của website.

  Mục đích chính của tính năng Phân quyền:
  * Bảo mật: Ngăn chặn các truy cập trái phép hoặc các hành động không mong muốn vào mã nguồn và dữ liệu website. Quyền hạn không đúng có thể tạo lỗ hổng cho hacker khai thác.
  * Đảm bảo hoạt động của website: WordPress và các plugin/theme cần có quyền ghi vào một số thư mục nhất định để hoạt động [ví dụ: tải lên media, cập nhật, tạo cache]. Phân quyền sai có thể gây lỗi chức năng.
  * Đơn giản hóa quản lý: WPTangToc OLS thường cung cấp các lệnh hoặc tùy chọn tự động để thiết lập quyền hạn chuẩn cho WordPress, giúp người dùng không cần phải nhớ các lệnh chown và chmod phức tạp của Linux.

  Lợi ích:
  * Tăng cường bảo mật: Giảm thiểu rủi ro từ các cuộc tấn công dựa trên quyền hạn tệp tin.
  * Đảm bảo website hoạt động ổn định: Các chức năng như cập nhật, tải lên media hoạt động trơn tru.
  * Dễ sử dụng: Ngay cả người dùng ít kinh nghiệm về Linux cũng có thể quản lý quyền hạn một cách chính xác thông qua tính năng wptangtoc ols.

  nếu website của bạn không xoá, thêm được plugin, themes hoặc lỗi phần ghi dữ liệu.
  Bạn hãy phân quyền, tính năng này sẽ phần quyền lại tự động theo chuẩn bảo mật.
  Phần mềm sẽ thay đổi thuộc sở hữu file về đúng username website và phần quyền đúng với bảo mật

  Tóm lại, tính năng Phân quyền trong WPTangToc OLS giúp đơn giản hóa và tự động hóa việc thiết lập quyền sở hữu và quyền truy cập tệp tin/thư mục theo chuẩn bảo mật và hoạt động cho website WordPress trên máy chủ OpenLiteSpeed.
}

. /etc/wptt/.wptt.conf
. /etc/wptt/core-functions 2>/dev/null
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

check_menu_wptangtoc_active=$1

NAME=$1
if [[ $NAME = '98' ]]; then
  NAME=''
fi

if [[ $NAME = '99' ]]; then
  NAME=''
fi

. /etc/wptt/echo-color

if [[ -z $NAME ]]; then
  tinh_nang_ten="$phan_quyen"
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}$tinh_nang_ten Chown & Chmod${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website
  lua_chon_NAME "$phan_quyen"
fi


if [[ $NAME = 'Tất cả website' ]]; then
  echo "Phân quyền toàn bộ website : $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
	tien_do='1'

	if [[ -z "$tong_so_web" ]];then #tình toán tình huống người dùng không dùng thư viên tenmien
		vhosts_path=(/etc/wptt/vhost/*.conf)
		tong_so_web="${#vhosts_path[@]}"
	fi

	print_border_top
	center_text "${C_YELLOW}DASHBOARD THAO TÁC HÀNG LOẠT${C_RESET}"
	print_border_mid
	left_text "▪ Tổng số   : ${C_GREEN}$tong_so_web website${C_RESET}" 2
	left_text "▪ Nhiệm vụ  : ${C_GREEN}Phân quyền${C_RESET}" 2
	print_border_bot

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
      path_html="/usr/local/lsws/$domain/html"
      if [[ -d "$path_html" ]]; then
        _runing "[ $tien_do / $tong_so_web ] $phan_quyen website $domain"
        (/etc/wptt/wptt-phanquyen "$domain" >/dev/null 2>&1) # Sub-shell an toàn
        _rundone "[ $tien_do / $tong_so_web ] $phan_quyen website $domain"
				((tien_do++)) # Tăng tiến độ sau mỗi lần chạy xong
      fi
    fi
  done

  wptt_smart_reload_lsws >/dev/null 2>&1

  if [[ $check_menu_wptangtoc_active = "98" ]]; then #từ menu nhánh
    exec /etc/wptt/wptt-domain-main 1
  fi

  if [[ $check_menu_wptangtoc_active = "99" ]]; then #từ menu gốc chính
    exec /usr/bin/wptangtoc 1
  fi
  return 2>/dev/null
  exit
fi

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  if [[ $check_menu_wptangtoc_active = "98" ]]; then #từ menu nhánh
    exec /etc/wptt/wptt-domain-main 1
  fi

  if [[ $check_menu_wptangtoc_active = "99" ]]; then #từ menu gốc chính
    exec /usr/bin/wptangtoc 1
  fi
  return 2>/dev/null
  exit
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "$ten_mien_nay_khong_ton_tai_tren_he_thong"
  sleep 3
  if [[ $check_menu_wptangtoc_active = "98" ]]; then #từ menu nhánh
    exec /etc/wptt/wptt-domain-main 1
  fi

  if [[ $check_menu_wptangtoc_active = "99" ]]; then #từ menu gốc chính
    exec /usr/bin/wptangtoc 1
  fi
  return 2>/dev/null
  exit
fi

# ==============================================================================
# BẮT ĐẦU CƠ CHẾ LOCKING (CHỐNG ĐỤNG ĐỘ TIẾN TRÌNH PHÂN QUYỀN)
# ==============================================================================
LOCK_FILE="/etc/wptt/tmp/wptt_lock_phan_quyen_${NAME}.lock"
# Gán File Descriptor 201 cho khóa phân quyền
exec 201>"$LOCK_FILE"

# Lấy khóa non-blocking. Nếu có ai đó đang phân quyền website này thì báo lỗi và văng ra.
if ! flock -n 201; then
  echo ""
  echo "========================================================================="
  _runloi "Lỗi Đụng Độ Tiến Trình"
  echoDo "Website $NAME đang được phân quyền bởi một tác vụ khác."
  echoDo "Hệ thống tự động khóa để bảo vệ dữ liệu. Vui lòng chờ lát nữa thử lại!"
  echo "========================================================================="
  sleep 3
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  elif [[ $check_menu_wptangtoc_active = "99" ]]; then
    exec /usr/bin/wptangtoc 1
  fi
  return 2>/dev/null || exit 1
fi
# ==============================================================================

. /etc/wptt/echo-color

_runing "$phan_quyen website $NAME"

unset lock_down User_name_vhost
. /etc/wptt/vhost/."$NAME".conf

if [[ -z "$User_name_vhost" ]]; then
	_runloi "Không xác định được Username website $NAME"
	if [[ $check_menu_wptangtoc_active = "98" ]]; then #từ menu nhánh
		exec /etc/wptt/wptt-domain-main 1
	fi
	if [[ $check_menu_wptangtoc_active = "99" ]]; then #từ menu gốc chính
		exec /usr/bin/wptangtoc 1
	fi
	return >/dev/null 2>&1
	exit
fi

# =================================================================
# BẢO MẬT THIẾT QUÂN LUẬT: Thư mục gốc luôn do root nắm giữ
# =================================================================
chown root:root /usr/local/lsws/"$NAME"
chmod 755 /usr/local/lsws/"$NAME"
# =================================================================

if [[ -f /usr/local/lsws/"$NAME"/.bashrc ]]; then
  chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/.bashrc
  chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/.bash_logout

  #rehat chỉ dùng .bash_profile
  if [[ -f /usr/local/lsws/"$NAME"/.bash_profile ]]; then
    chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/.bash_profile
  fi

  #ubuntu chỉ dùng .profile
  if [[ -f /usr/local/lsws/"$NAME"/.profile ]]; then
    chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/.profile
  fi

fi

chmod 755 /usr/local/lsws/"$NAME"/html

if [[ $lock_down ]]; then

  . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" off
  #Lệnh chown -hR mặc định sẽ đi xuyên qua các file shortcut (Symbolic Links).
  #BẮT BUỘC phải thêm cờ -h (chỉ đổi quyền của bản thân cái symlink, không đổi quyền của file đích mà symlink trỏ tới). nâng cao bảo mật, tránh kỹ thuật hack Symbolic Links
  ionice -c 3 nice -n 19 chown -Rh "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/html
  ionice -c 3 nice -n 19 chown -Rh "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/backup-website

  ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html -user "$User_name_vhost" -type f -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 404
  ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html -user "$User_name_vhost" -type d -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 515
  #lockdown vẫn có thể uploads được dữ liệu wp-uploads
  if [[ -d /usr/local/lsws/"$NAME"/html/wp-content/uploads ]]; then
    ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html/wp-content/uploads -user "$User_name_vhost" -type d -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 755
  fi

  if [[ -f /usr/local/lsws/"$NAME"/html/wp-content/preload-wptangtoc-url.txt ]]; then
    chmod 644 /usr/local/lsws/"$NAME"/html/wp-content/preload-wptangtoc-url.txt
  fi

  if [[ -f /usr/local/lsws/"$NAME"/html/wp-content/preload-wptangtoc.json ]]; then
    chmod 644 /usr/local/lsws/"$NAME"/html/wp-content/preload-wptangtoc.json
  fi

  #lockdown tương thích với một số plugin cache
  if [[ -d /usr/local/lsws/"$NAME"/html/wp-content/cache ]]; then
    chmod 755 /usr/local/lsws/"$NAME"/html/wp-content/cache
    ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html/wp-content/cache -user "$User_name_vhost" -type d -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 755
    ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html/wp-content/cache  -user "$User_name_vhost" -type f -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 644
    chmod 755 /usr/local/lsws/"$NAME"/html/wp-content
  fi

  # Trả lại quyền sống sót cho SQLite sau khi Lockdown, tương thích người dùng SQLite
  if [[ -d /usr/local/lsws/"$NAME"/html/wp-content/database ]]; then
    chmod 755 /usr/local/lsws/"$NAME"/html/wp-content/database
    find /usr/local/lsws/"$NAME"/html/wp-content/database -user "$User_name_vhost" -type f -print0 | xargs -0 chmod 644
    find /usr/local/lsws/"$NAME"/html/wp-content/database -user "$User_name_vhost" -type f -name ".ht.sqlite*" -print0 | xargs -0 chmod 644
  fi

  if [[ -d /usr/local/lsws/"$NAME"/html/wp-content/litespeed ]]; then
    chmod 755 /usr/local/lsws/"$NAME"/html/wp-content/litespeed
    ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html/wp-content/litespeed -user "$User_name_vhost" -type d -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 755
    ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html/wp-content/litespeed -user "$User_name_vhost" -type f -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 644
  fi

  if [[ -f /usr/local/lsws/"$NAME"/html/index.php ]]; then
    chmod 444 /usr/local/lsws/"$NAME"/html/index.php
  fi

  if [[ -f /usr/local/lsws/"$NAME"/html/wp-config.php ]]; then
    chmod 400 /usr/local/lsws/"$NAME"/html/wp-config.php
  fi

  . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" on

else
  #BẮT BUỘC phải thêm cờ -h (chỉ đổi quyền của bản thân cái symlink, không đổi quyền của file đích mà symlink trỏ tới).
  ionice -c 3 nice -n 19 chown -Rh "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/html
  ionice -c 3 nice -n 19 chown -Rh "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/backup-website
  ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html -user "$User_name_vhost" -type f -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 644
  ionice -c 3 nice -n 19 find /usr/local/lsws/"$NAME"/html -user "$User_name_vhost" -type d -print0 | xargs -0 ionice -c 3 nice -n 19 chmod 755
  if [[ -f /usr/local/lsws/"$NAME"/html/index.php ]]; then
    chmod 444 /usr/local/lsws/"$NAME"/html/index.php
  fi

  if [[ -f /usr/local/lsws/"$NAME"/html/wp-config.php ]]; then
    chmod 600 /usr/local/lsws/"$NAME"/html/wp-config.php
    . /etc/wptt/php/php-cli-domain-config "$NAME"
    /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp rewrite flush --allow-root --path=/usr/local/lsws/"$NAME"/html >/dev/null 2>&1
  fi

  if [[ -d /usr/local/lsws/$NAME/.lsns ]];then #phân quyền lại Namespace OLS
	  ionice -c 3 nice -n 19 chown -Rh "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/.lsns
  fi


fi

if [[ -f /usr/local/lsws/"$NAME"/html/wp-config.php ]]; then
  /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp rewrite flush --allow-root --path=/usr/local/lsws/"$NAME"/html >/dev/null 2>&1
fi

#tuong thich ubuntu tuong thich nhom litespeed
if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

if [[ $id_dang_nhap_phpmyadmin && $Website_chinh = $NAME && -d /usr/local/lsws/"$NAME"/html/phpmyadmin ]]; then
  ionice -c 3 nice -n 19 chown -hR nobody:$tuong_thich_nhom_litespeed /usr/local/lsws/"$NAME"/html/phpmyadmin
fi

sleep 3
_rundone "$phan_quyen website $NAME"

# ==============================================================================
# MỞ KHÓA BẢO VỆ TIẾN TRÌNH (RELEASE LOCK)
# ==============================================================================
flock -u 201
exec 201>&-
rm -f "${LOCK_FILE:?}" 2>/dev/null
# ==============================================================================

echo ''
echo ''
if [[ $check_menu_wptangtoc_active = "98" ]]; then #từ menu nhánh
  exec /etc/wptt/wptt-domain-main 1
fi

if [[ $check_menu_wptangtoc_active = "99" ]]; then #từ menu gốc chính
  exec /usr/bin/wptangtoc 1
fi
