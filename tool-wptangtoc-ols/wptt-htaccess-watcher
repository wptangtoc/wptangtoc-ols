#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Realtime OpenLiteSpeed .htaccess Watcher
# @since: 2026

. /etc/wptt/core-functions

shopt -s nullglob
WATCH_DIRS=()

# 1. Quét thư mục an toàn (Bỏ qua Symlink để chống Path Traversal)
for html_dir in /usr/local/lsws/*/html; do
    if [[ -d "$html_dir" && ! -L "$html_dir" ]]; then
        WATCH_DIRS+=("$html_dir")
        [[ -d "$html_dir/wp-content" && ! -L "$html_dir/wp-content" ]] && WATCH_DIRS+=("$html_dir/wp-content")
    fi
done

if [[ ${#WATCH_DIRS[@]} -eq 0 ]]; then
    sleep 60
    exit 0
fi

# 2. Lắng nghe sự kiện (Bỏ -q để có thể debug nếu chạy service status)
inotifywait -m -e close_write,moved_to,create,delete "${WATCH_DIRS[@]}" --format "%w%f" | while read -r raw_filepath; do
    if [[ "$raw_filepath" == *".htaccess" ]]; then
        
        # LỚP KHIÊN 1: Realpath để bóc trần sự thật của đường dẫn (Chống Symlink ảo)
        filepath=$(realpath -q "$raw_filepath" 2>/dev/null)
        # Fallback nếu file vừa bị delete (realpath sẽ rỗng)
        [[ -z "$filepath" ]] && filepath="$raw_filepath" 

        # LỚP KHIÊN 2: Strict Domain Validation bằng Regex (Tuyệt đối không dùng awk -F'/')
        if [[ "$filepath" =~ ^/usr/local/lsws/([a-zA-Z0-9.-]+)/html/ ]]; then
            domain="${BASH_REMATCH[1]}"
            
            # LỚP KHIÊN 3: Domain ↔ Vhost Mapping (Xác thực domain có tồn tại thật trên WPTangToc)
            if [[ -n "$domain" && -f "/etc/wptt/vhost/.$domain.conf" ]]; then
                
                if [[ -f "/etc/wptt/cau-hinh/htaccess-cache-active" ]]; then
                    # LỚP KHIÊN 4: Không Source (.). Ép chạy tiến trình con (Sub-process)
                    /bin/bash "/etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost" "$domain" >/dev/null 2>&1
                else 
                    wptt_smart_reload_lsws >/dev/null 2>&1
                fi
            fi
        fi

        # LỚP KHIÊN 5:
        # Nếu người dùng lưu file liên tục 10 lần trong 1 giây, chỉ xử lý 1 lần.
        sleep 2
        while read -r -t 0.1 discard; do :; done
    fi
done
