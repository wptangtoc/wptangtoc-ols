#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Realtime OpenLiteSpeed .htaccess Watcher & Native Vhost Compiler
# @since: 2026 - Enterprise Standard

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true

# Tự động định vị file thực thi wptt-htaccess-sync
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYNC_BIN="/etc/wptt/wptt-htaccess-sync"
if [[ ! -f "$SYNC_BIN" && -f "${SCRIPT_DIR}/wptt-htaccess-sync" ]]; then
  SYNC_BIN="${SCRIPT_DIR}/wptt-htaccess-sync"
fi

shopt -s nullglob
WATCH_DIRS=()

# 1. Theo dõi thư mục /etc/wptt/vhost để tự động nhận diện khi thêm/xóa Website mới
[[ -d "/etc/wptt/vhost" && ! -L "/etc/wptt/vhost" ]] && WATCH_DIRS+=("/etc/wptt/vhost")

# 2. Quét thư mục an toàn (Bỏ qua Symlink để chống Path Traversal)
for html_dir in /usr/local/lsws/*/html; do
  if [[ -d "$html_dir" && ! -L "$html_dir" ]]; then
    WATCH_DIRS+=("$html_dir")
    if [[ -d "$html_dir/wp-content" && ! -L "$html_dir/wp-content" ]]; then
      WATCH_DIRS+=("$html_dir/wp-content")
    fi
    if [[ -d "$html_dir/wp-content/uploads" && ! -L "$html_dir/wp-content/uploads" ]]; then
      WATCH_DIRS+=("$html_dir/wp-content/uploads")
    fi
  fi
done
shopt -u nullglob

# Nếu chưa có website nào trên máy chủ, nghỉ chờ để không tốn CPU
if ((${#WATCH_DIRS[@]} == 0)) || { ((${#WATCH_DIRS[@]} == 1)) && [[ "${WATCH_DIRS[0]}" == "/etc/wptt/vhost" ]]; }; then
  sleep 60
  exit 0
fi

# Đảm bảo dọn sạch tiến trình con inotifywait khi Systemd dừng hoặc khởi động lại dịch vụ
INOTIFY_PID=""
cleanup_watcher() {
  trap - EXIT INT TERM HUP
  [[ -n "${INOTIFY_PID:-}" ]] && kill -TERM "$INOTIFY_PID" 2>/dev/null || true
}
trap cleanup_watcher EXIT INT TERM HUP

declare -A PENDING_DOMAINS=()

# Hàm kiểm tra xem có Vhost mới hoặc thư mục wp-content/uploads mới xuất hiện không
_check_topology_change() {
  local path="$1"
  local evt="$2"
  local base_name="${path##*/}"

  # Nếu thêm/xóa file cấu hình Vhost -> Thoát để Systemd tự động Restart nạp lại danh sách WATCH_DIRS
  if [[ "$path" == /etc/wptt/vhost/.*.conf ]]; then
    sleep 1
    exit 0
  fi

  # Nếu thư mục wp-content hoặc uploads vừa được tạo mới (khi cài WP hoặc giải nén code)
  if [[ "$evt" == *"ISDIR"* ]] && [[ "$base_name" == "wp-content" || "$base_name" == "uploads" ]]; then
    sleep 1
    exit 0
  fi
}

# Hàm xác thực 3 lớp khiên và đưa domain vào hàng đợi xử lý
_queue_htaccess_event() {
  local raw_path="$1"
  local evt="$2"
  local resolved_path="" parent_dir="" domain=""

  [[ "${raw_path##*/}" == ".htaccess" ]] || return 0

  # LỚP KHIÊN 1: Realpath bóc trần đường dẫn thật (Hỗ trợ cả khi file .htaccess vừa bị DELETE)
  if [[ -e "$raw_path" ]]; then
    resolved_path="$(realpath -q "$raw_path" 2>/dev/null || true)"
  else
    parent_dir="$(realpath -q "${raw_path%/*}" 2>/dev/null || true)"
    [[ -n "$parent_dir" ]] && resolved_path="${parent_dir}/.htaccess"
  fi
  [[ -z "$resolved_path" ]] && resolved_path="$raw_path"

  # LỚP KHIÊN 2: Strict Domain Validation bằng Regex thuần Bash
  if [[ "$resolved_path" =~ ^/usr/local/lsws/([a-zA-Z0-9._-]+)/html/ ]]; then
    domain="${BASH_REMATCH[1]}"

    # LỚP KHIÊN 3: Domain ↔ Vhost Mapping (Xác thực domain có Vhost thật và không chứa ..)
    if [[ -n "$domain" && "$domain" != -* && "$domain" != *..* ]]; then
      if [[ -f "/etc/wptt/vhost/.${domain}.conf" || -f "/usr/local/lsws/conf/vhosts/${domain}/${domain}.conf" ]]; then
        PENDING_DOMAINS["$domain"]=1
      fi
    fi
  fi
}

# 3. Đồng bộ khởi tạo 1 lần khi dịch vụ Watcher bắt đầu khởi chạy
if [[ -f "$SYNC_BIN" ]]; then
  /bin/bash "$SYNC_BIN" --all >/dev/null 2>&1 || true
fi

# 4. Lắng nghe sự kiện Kernel (Định dạng: EVENT|PATH)
exec 3< <(inotifywait -m -e close_write,moved_to,delete,create,attrib "${WATCH_DIRS[@]}" --format "%e|%w%f" 2>/dev/null)
INOTIFY_PID=$!

while IFS='|' read -r -u 3 event_type raw_filepath; do
  _check_topology_change "$raw_filepath" "$event_type"

  if [[ "${raw_filepath##*/}" == ".htaccess" ]]; then
    PENDING_DOMAINS=()
    _queue_htaccess_event "$raw_filepath" "$event_type"

    # LỚP KHIÊN 5 (DEBOUNCE COALESCING CHUẨN):
    # Chờ 0.5s để gom toàn bộ chuỗi ghi liên tiếp từ Plugin (WP Rocket, Wordfence, LSCache...)
    while IFS='|' read -r -u 3 -t 0.5 next_event next_filepath; do
      _check_topology_change "$next_filepath" "$next_event"
      _queue_htaccess_event "$next_filepath" "$next_event"
    done

    # Thực thi sau khi cơn bão ghi file đã hoàn tất 100%
    if ((${#PENDING_DOMAINS[@]} > 0)); then
      # BƯỚC A: Biên dịch tự động các chỉ thị Apache (IP Deny/Allow, Header, PHP, Expires, ErrorDocument) sang Vhost
      if [[ -f "$SYNC_BIN" ]]; then
        /bin/bash "$SYNC_BIN" --no-reload "${!PENDING_DOMAINS[@]}" >/dev/null 2>&1 || true
      fi

      # BƯỚC B: Xử lý chế độ Htaccess Cache hoặc Reload OpenLiteSpeed đúng 1 lần duy nhất
      if [[ -f "/etc/wptt/cau-hinh/htaccess-cache-active" && -f "/etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost" ]]; then
        for target_domain in "${!PENDING_DOMAINS[@]}"; do
          /bin/bash "/etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost" "$target_domain" >/dev/null 2>&1 || true
        done
      else
        if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
          wptt_smart_reload_lsws >/dev/null 2>&1 || true
        else
          /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1 || true
        fi
      fi
    fi
  fi
done
