#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Realtime OpenLiteSpeed .htaccess
# @since: 2026

. /etc/wptt/core-functions

shopt -s nullglob
WATCH_DIRS=()

for html_dir in /usr/local/lsws/*/html; do
    if [[ -d "$html_dir" ]]; then
        WATCH_DIRS+=("$html_dir")
        [[ -d "$html_dir/wp-content" ]] && WATCH_DIRS+=("$html_dir/wp-content")
    fi
done

if [[ ${#WATCH_DIRS[@]} -eq 0 ]]; then
    sleep 60
    exit 0
fi

# Cờ %w%f giúp in ra ĐƯỜNG DẪN TUYỆT ĐỐI của file bị thay đổi (VD: /usr/local/lsws/domain.com/html/.htaccess)
inotifywait -m -q -e close_write,moved_to,create,delete "${WATCH_DIRS[@]}" --format "%w%f" | while read -r filepath; do
    if [[ "$filepath" == *".htaccess" ]]; then
        
        # Kiểm tra xem tính năng Htaccess Cache có đang bật không?
				if [[ -f "/etc/wptt/cau-hinh/htaccess-cache-active" ]]; then
					# Trích xuất chính xác tên domain từ đường dẫn tuyệt đối (Cột thứ 5)
					domain=$(echo "$filepath" | awk -F'/' '{print $5}')

						# Kích hoạt convert .htaccess -> vhost cho riêng domain bị thay đổi
						if [[ -n "$domain" ]]; then
							/bin/bash -c ". /etc/wptt/wptt-htaccess-tat-chuyen-doi-vhost \"$domain\" >/dev/null 2>&1"
						fi
					else #bản thân wptt-htaccess-tat-chuyen-vhost cũng đã có wptt-smart-reload-lsws rồi
						# Nếu không bật Htaccess Cache, chỉ cần báo OLS nạp lại cấu hình thông thường
						wptt_smart_reload_lsws >/dev/null 2>&1
				fi
        sleep 3
        while read -r -t 0.1 discard; do :; done
    fi
done
