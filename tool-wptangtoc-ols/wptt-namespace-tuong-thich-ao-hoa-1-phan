#!/bin/bash

#ghi chú cơ bản: ảo hóa giá rẻ nó không support namespace đâu toàn báo lỗi: 

#xem error 2026-10-05 10:16:19.121826 Namespace mount of none to /newroot/tmp failed: Permission denied
#2026-10-05 10:16:19.122003 Namespace error in bind mount of /oldroot/usr/local/lsws/al8.wptangtoc-ols.com/.lsns/tmp to /newroot/tmp: Permission denied có cách nào giải quyết vấn đề này tự động sửa lỗi không 
#không đủ quyền để dùng namespace

#khi thử lệnh này không tắt namespace với ảo hóa giá rẻ nó treo ngay báo lỗi 503
#curl -s -o /dev/null -w "%{http_code}" -k \
#   -A "WPTangToc OLS preload cache" \
#   --resolve "al8.wptangtoc-ols.com:443:127.0.0.1" \
#   "https://al8.wptangtoc-ols.com/"


#Đây không phải là lỗi (bug) do OpenLiteSpeed viết code kém, mà đây là một sự xung đột về cơ chế bảo mật giữa tính năng của Web Server và môi trường Ảo hóa cấp hệ điều hành (gọi là "ảo hóa 1 phần").
#Tính năng của OpenLiteSpeed (Người đòi quyền): OLS có một tính năng bảo mật tuyệt vời gọi là Namespace Isolation (CGI Jail). Khi chạy PHP, nó muốn tạo ra một không gian ảo độc lập hoàn toàn bằng lệnh bind mount (gắn thư mục /tmp ảo) để nhốt tiến trình PHP lại. Điều này đòi hỏi OLS phải có quyền can thiệp rất sâu vào nhân (Kernel) của hệ điều hành, cụ thể là quyền CAP_SYS_ADMIN.
#Đặc thù của Ảo hóa 1 phần (Kẻ chặn quyền): Các môi trường như LXC, LXD, OpenVZ, hay Docker không có nhân (Kernel) riêng mà phải dùng chung Kernel với máy chủ mẹ (Host). Để giữ an toàn cho máy mẹ, nền tảng ảo hóa sẽ tước bỏ hoàn toàn các đặc quyền nguy hiểm của các máy ảo con, đặc biệt là cấm tiệt lệnh mount sâu vào kernel.
#Kết quả: OLS cố gắng chạy lệnh mount ➜ Nền tảng ảo hóa vung tay gạt đi (báo Permission denied) ➜ OLS dỗi không thèm gọi PHP ➜ Web văng lỗi 503!

    conf_file="/usr/local/lsws/conf/httpd_config.conf"
    
    # Bỏ qua nếu chưa cài đặt xong OpenLiteSpeed
    [[ ! -f "$conf_file" ]] && return 0
    
    virt_type=$(systemd-detect-virt 2>/dev/null || echo "unknown")
    
    # Bổ sung nhận diện Docker và biến môi trường CI/GITHUB_ACTIONS
    if [[ "$virt_type" == "lxc" || "$virt_type" == "lxd" || "$virt_type" == "openvz" || "$virt_type" == "docker" || -f /proc/user_beancounters || "${GITHUB_ACTIONS:-}" == "true" || "${CI:-}" == "true" ]]; then
        
        # Kiểm tra xem cấu hình đã có namespace 0 chưa để tránh ghi đè nhiều lần
        if ! grep -qE "^[[:space:]]*namespace[[:space:]]+0" "$conf_file"; then
            
            # Kịch bản 1: Biến namespace đã tồn tại nhưng mang giá trị khác -> Replace thành 0
            if grep -qE "^[[:space:]]*namespace[[:space:]]+[0-9]+" "$conf_file"; then
                sed -i 's/^[[:space:]]*namespace[[:space:]]*[0-9]*/namespace               0/g' "$conf_file"
            
            # Kịch bản 2: Chưa có biến namespace -> Thêm mới vào dưới dòng bubbleWrap
            else
                if grep -q "^bubbleWrap" "$conf_file"; then
                    sed -i '/^bubbleWrap.*/a namespace               0' "$conf_file"
                else
                    echo -e "\nnamespace               0" >> "$conf_file"
                fi
            fi
            
            wptt_logs "INFO" "Phát hiện môi trường ảo hóa ($virt_type/CI). Đã tự động chèn 'namespace 0' để tránh lỗi 503."
            
            # Restart LiteSpeed (Thêm dấu kiểm tra xem lswsctrl có tồn tại không)
            if [[ -x /usr/local/lsws/bin/lswsctrl ]]; then
                /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
            fi
        fi
    fi
