#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Thư viện bảng chọn tên miền kèm tùy chọn Đồng loạt (0-Subshell Render)
# @since: 2026

# Chỉ nạp thư viện nếu tiến trình cha chưa nạp (Chống nạp chồng tốn I/O)
if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  . /etc/wptt/core-functions 2>/dev/null
fi

if [[ -z "${ngon_ngu:-}" || -z "${tai_ma_nguon_wordpress:-}" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/.wptt.conf 2>/dev/null
  [[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
fi

if ! declare -F _runing &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/echo-color 2>/dev/null
fi

# Hàm đếm số ký tự UTF-8 thuần Bash (0 Subshell, tương thích cả máy chủ thiếu Locale)
_wptt_utf8_len() {
  local str="$1"
  local test_char="Đ"
  if ((${#test_char} == 1)); then
    REPLY_LEN=${#str}
  else
    # Nếu môi trường bị ép LC_ALL=C khiến 1 ký tự UTF-8 bị tính thành nhiều byte:
    # Loại bỏ các byte nối tiếp UTF-8 (0x80..0xBF) để đếm chính xác số ký tự hiển thị
    local stripped
    LC_ALL=C stripped="${str//[$'\x80'-$'\xbf']/}"
    REPLY_LEN=${#stripped}
  fi
}

function lua_chon_NAME() {
  local action_desc="${1:-}"
  unset NAME

  # Nếu chạy tự động trên CI/CD mà không truyền dữ liệu qua Pipe (stdin là TTY) thì thoát ngay
  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]] && [[ -t 0 ]]; then
    return 1
  fi

  local selects=()
  local i=1
  local box_inner_width="${box_inner_width:-78}"
  local filepath domain valid_domain PROMPT_TEXT
  local REPLY_LEN=0

  # Biến toàn cục xuất ra cho các script gọi (dùng để hiển thị tiến độ [ $tien_do / $tong_so_web ])
  tong_so_web=0

  # 1. Quét file siêu tốc trên RAM (0 Subshell)
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* && "$domain" != *..* ]]; then
      if [[ -f "/usr/local/lsws/$domain/html/wp-load.php" && -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
        selects+=("$domain")
        #((tong_so_web++))
      fi
    fi
  done
  shopt -u nullglob

  # 2. Kiểm tra nếu VPS chưa có website nào
  if ((${#selects[@]} == 0)); then
    clear
    echo -e "\n${C_RED}Lỗi: ${khong_co_wordpress_nao_ton_tai_tren_he_thong:-Không có tên miền đang dùng WordPress nào tồn tại trên hệ thống}${C_RESET}"
		exit 1
  fi

  # 3. Sắp xếp mảng chuẩn Version (Tự nhiên) và thêm tùy chọn "Tất cả website"
  if ((${#selects[@]} > 1)); then
    mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
    tong_so_web=${#selects[@]}
    selects+=("Tất cả website")
  fi

  # ============================================================================
  # 4. RENDER KHỐI BO CONG (0 SUBSHELL - THUẦN BUILT-IN BASH)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

  if [[ -n "$action_desc" ]]; then
    local title_text="${lua_chon_website_ban_muon:-Nhập lựa chọn website của bạn muốn} $action_desc:"
    local clean_title="${title_text//[$'\r\n']/}"
    while [[ "$clean_title" =~ $'\x1B'\[[0-9\;]*[a-zA-Z] ]]; do
      clean_title="${clean_title//"${BASH_REMATCH[0]}"/}"
    done

    _wptt_utf8_len "$clean_title"
    local len=$REPLY_LEN

    local pad_r=$((box_inner_width - len - 2))
    ((pad_r < 0)) && pad_r=0

    local pad_r_str=""
    printf -v pad_r_str '%*s' "$pad_r" ""
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}${pad_r_str}${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    ((line_len > box_inner_width)) && line_len=$box_inner_width
    local pad_line_r=$((box_inner_width - line_len))
    ((pad_line_r < 0)) && pad_line_r=0

    local short_line="" pad_line_str=""
    printf -v short_line "%${line_len}s" ""
    short_line="${short_line// /─}"
    printf -v pad_line_str '%*s' "$pad_line_r" ""

    echo -e "${C_CYAN}├${short_line}${pad_line_str}│${C_RESET}"
  fi

  # Vòng lặp in danh sách tên miền vào trong khung (0 Subshell)
  local item_text clean_text action_str len pad pad_str
  for domain in "${selects[@]}"; do
    if [[ "$domain" == "Tất cả website" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      action_str="Thao tác đồng loạt trên toàn bộ hệ thống"
      [[ -n "$action_desc" ]] && action_str="$action_desc toàn bộ hệ thống"

      printf -v item_text "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] %s" "$i" "$action_str"
      printf -v clean_text "  %3d) [ĐỒNG LOẠT] %s" "$i" "$action_str"

      _wptt_utf8_len "$clean_text"
      len=$REPLY_LEN
    else
      printf -v item_text "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain"
      printf -v clean_text "  %3d) %s" "$i" "$domain"

      # Tên miền là ASCII chuẩn nên lấy độ dài trực tiếp cực nhanh
      len=${#clean_text}
    fi

    pad=$((box_inner_width - len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    echo -e "${C_CYAN}│${C_RESET}${item_text}${pad_str}${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # ============================================================================
  # 5. TỐI ƯU UX DÒNG NHẮC LỆNH (PROMPT) THÔNG MINH
  # ============================================================================
  local fzf_installed=false
  if command -v fzf &>/dev/null; then
    fzf_installed=true
  fi

  local prompt_quick_select=""
  if [[ "$fzf_installed" == true && ${#selects[@]} -gt 2 ]]; then
    prompt_quick_select=" [00=${chon_nhanh:-Chọn Nhanh}]"
  fi

  PROMPT_TEXT="${nhap_lua_chon_website_cua_ban:-Nhập lựa chọn của bạn} (1-${#selects[@]})${prompt_quick_select} [0=${exit_thoat:-Thoát}]: "

  # ============================================================================
  # 6. ĐỘNG CƠ NHẬN PHÍM AN TOÀN
  # ============================================================================
  while true; do
    echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"

    if ! read -r REPLY; then
      echo -e "\n${C_RED}⚠️ Đã mất kết nối Terminal (EOF). Tự động thoát Menu để bảo vệ hệ thống...${C_RESET}"
      exit 1
    fi

    REPLY="${REPLY//[[:space:]]/}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0)
      echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
      NAME="0"
      return 0
      ;;

    00)
      if [[ "$fzf_installed" == true && ${#selects[@]} -gt 2 ]]; then
        local fzf_height=$((tong_so_web + 4))
        ((fzf_height > 40)) && fzf_height=40
        local fzf_prompt="${nhap_lua_chon_website_cua_ban:-Tìm kiếm website} (Mũi tên di chuyển, Enter chọn, ESC hủy): "
        local selected_name=""
        local fzf_exit_status=0

        # Cắt mảng lấy đúng danh sách domain (bỏ phần tử "Tất cả website" ở cuối) với 0 vòng lặp
        selected_name=$(printf '%s\n' "${selects[@]:0:tong_so_web}" | nl -w 3 -s ': ' | fzf --prompt="$fzf_prompt" --height="$fzf_height" --border=rounded --color=border:red --cycle --reverse) || fzf_exit_status=$?
        selected_name="${selected_name#*: }"

        if ((fzf_exit_status == 0)) && [[ -n "$selected_name" ]]; then
          NAME="$selected_name"
          return 0
        else
          echo -e "\n${C_YELLOW}Đã hủy chọn. ${vui_long_chon_lai:-Vui lòng chọn lại.}${C_RESET}"
          continue
        fi
      else
        echo -e "\n${C_RED}Lỗi: ${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ} '00'. Tính năng chọn nhanh không khả dụng lúc này.${C_RESET}"
        continue
      fi
      ;;

    *)
      # Dùng 10#$REPLY để ép hệ thập phân, chống lỗi Octal khi nhập 08, 09
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#selects[@]})); then
        local action_index=$((10#$REPLY - 1))
        NAME="${selects[$action_index]}"
        return 0
      elif [[ "$REPLY" == "tatcawebsite" || "$REPLY" == "tấtcảwebsite" || "$REPLY" == "all" ]]; then
        NAME="Tất cả website"
        return 0
      elif [[ "$REPLY" == ?*.?* && "$REPLY" != "." ]]; then
        local found=false
        for valid_domain in "${selects[@]:0:tong_so_web}"; do
          if [[ "$valid_domain" == "$REPLY" ]]; then
            NAME="$valid_domain"
            found=true
            break
          fi
        done

        if [[ "$found" == true ]]; then
          return 0
        else
          echo -e "\n${C_RED}Lỗi: Tên miền '$REPLY' không tồn tại trên hệ thống.${C_RESET}"
          continue
        fi
      else
        echo -e "\n${C_RED}${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ}: '$REPLY'. ${vui_long_chon_lai:-Vui lòng chọn lại.}${C_RESET}"
        continue
      fi
      ;;
    esac
  done
}
