#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null

# ==============================================================================
# 1. NẠP CẤU HÌNH & NGÔN NGỮ
# ==============================================================================
if [[ -f /etc/wptt/.wptt.conf ]]; then
  wptt_load_main_conf
fi

if [[ -z "$ngon_ngu" ]]; then # Tối ưu: Dùng -z kiểm tra biến rỗng an toàn hơn
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

# Tối ưu: Giữ lại $PATH gốc của hệ thống bằng cách nối thêm ($PATH ở cuối)
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


# ==============================================================================
# 2. KHAI BÁO BẢNG MÀU CHUẨN (CHO ECHO)
# ==============================================================================
function echoVang { echo -e "\033[38;5;148m${1}\033[39m"; }
function echoDo { echo -e "\033[38;5;9m${1}\033[39m"; }
function echoBlue { echo -e "\033[38;5;21m${1}\033[39m"; }
function echoXanhlacay { echo -e "\033[38;5;28m${1}\033[39m"; }
function echoDone { echo -e "\033[38;5;41m${1}\033[39m"; }
function echoCam { echo -e "\033[38;5;203m${1}\033[39m"; }
function echoXam { echo -e "\033[1;3;94m${1}\033[0m"; }

# ==============================================================================
# BỘ HÀM TRẠNG THÁI TÁC VỤ ENTERPRISE
# ==============================================================================

#LỆNH TEST xem có sợ bị treo tiến trình không
# bash -c '. /etc/wptt/echo-color; _runing "Test thử Ctrl+C xem có kẹt tiến trình không"; sleep 30; _rundone' ; sleep 0.3 ; echo -e "\n--- KẾT QUẢ KIỂM TRA TIẾN TRÌNH KẸT ---" ; ps -ef | grep -E 'sleep 0\.15|<defunct>' | grep -v grep || echo "✔ SẠCH BÓNG 100%: Không có bất kỳ tiến trình nào bị kẹt!"

# ==============================================================================
# BỘ HÀM TRẠNG THÁI TÁC VỤ (PRODUCTION CORE)
# ZERO-HANG / ZERO-TRAP / HARD-CAPPED LOOP
# ------------------------------------------------------------------------------
# Nguyên tắc bất khả xâm phạm (Zero-Hang Architecture):
#   1. Không dùng `trap`, không bao giờ `wait` tiến trình spinner.
#   2. Spinner tự kiểm tra dấu vân tay của shell cha mỗi 0.15s:
#      (starttime + startstack + cmdline + trạng thái Z/X). Cha chết (Ctrl+C,
#      SSH đứt, kill -9, SIGHUP) hoặc cha `exec` sang chương trình khác ->
#      spinner tự xóa dòng dở dang và tự hủy trong <= 0.15s.
#   3. Chống Loop Vô Tận 2 lớp: Giới hạn theo cả Thời gian (WPTT_SPINNER_MAX_SEC)
#      LẪN Số vòng lặp cứng (max_iter) -> Bất chấp đồng hồ hệ thống nhảy ngược
#      do NTP/Chrony, spinner không bao giờ có thể chạy vô tận.
#   4. Spinner đóng mọi FD thừa kế (>2) -> Tuyệt đối không giữ khóa `flock`
#      hay làm treo pipe `$(...)` của bất kỳ script nào trong WPTangToc OLS.
#   5. Đối chiếu PID của Spinner bằng `starttime` cấp Kernel (/proc/pid/stat) ->
#      Dừng tức thì 100% chính xác mà không bao giờ kill nhầm PID tái sử dụng.
# ==============================================================================
# ==============================================================================
# BỘ HÀM TRẠNG THÁI TÁC VỤ (PRODUCTION CORE)
# ZERO-HANG / ZERO-TRAP / HARD-CAPPED LOOP / FLEXIBLE MANUAL UX
# ==============================================================================
WPTT_LAST_RUN_MSG=""
WPTT_SPINNER_PID=""
WPTT_SPINNER_STIME=""
WPTT_SPINNER_HIDE=0
WPTT_RUN_START_TS=0
WPTT_RESUME_TS=0
WPTT_ALIGNED_LINE=""
WPTT_NOW_VAL=0
WPTT_DUR_STR=""
WPTT_CLEAN_STR=""
WPTT_FP=""
WPTT_PROC_STIME=""
WPTT_TERM_COLS=0
WPTT_TERM_COLS_TS=0
WPTT_ELAPSED=0

# 1. Bảo đảm charset UTF-8 bằng Pure Bash (0-subshell).
_wptt_eff_cs="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "${_wptt_eff_cs,,}" in
  *utf-8* | *utf8*) : ;;
  *)
    if [[ -n "${LC_ALL:-}" ]]; then
      export LC_ALL="C.UTF-8"
    else
      export LC_CTYPE="C.UTF-8"
    fi
    ;;
esac
unset _wptt_eff_cs

# 2. Unix timestamp hiện tại bằng built-in (0-subshell).
_wptt_now_ts() {
  if [[ -n "${EPOCHSECONDS:-}" ]]; then
    WPTT_NOW_VAL="$EPOCHSECONDS"
  else
    printf -v WPTT_NOW_VAL '%(%s)T' -1 2>/dev/null || WPTT_NOW_VAL=$((SECONDS + 1))
  fi
  return 0
}

# 3. Định dạng số giây -> chuỗi hiển thị (8s, 12m 5s, 1h 15m 20s).
_wptt_format_duration() {
  local sec="${1:-0}"
  if ((sec >= 3600)); then
    printf -v WPTT_DUR_STR '%dh %dm %ds' $((sec / 3600)) $(((sec % 3600) / 60)) $((sec % 60))
  elif ((sec >= 60)); then
    printf -v WPTT_DUR_STR '%dm %ds' $((sec / 60)) $((sec % 60))
  else
    printf -v WPTT_DUR_STR '%ds' "$sec"
  fi
  return 0
}

# 4. Lọc mã màu ANSI thuần Bash, có chốt chặn tối đa 200 vòng lặp.
_wptt_strip_ansi() {
  local str="$1"
  local esc=$'\033'
  local re="${esc}\\[[0-9;?]*[a-zA-Z]"
  local guard=0
  while ((guard < 200)) && [[ "$str" =~ $re ]]; do
    str="${str/"${BASH_REMATCH[0]}"/}"
    guard=$((guard + 1))
  done
  WPTT_CLEAN_STR="$str"
  return 0
}

# 5a. Lấy riêng `starttime` bất biến (field 22 trong /proc/pid/stat) cho Spinner PID.
_wptt_get_proc_stime() {
  WPTT_PROC_STIME=""
  local pid="${1:-}" stat="" rest=""
  local -a sfields=()
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  { IFS= read -r stat <"/proc/$pid/stat"; } 2>/dev/null || return 1
  rest="${stat##*) }"
  [[ "$rest" != "$stat" ]] || return 1

  IFS=' ' read -r -a sfields <<<"$rest"
  case "${sfields[0]:-}" in Z | X | x | "") return 1 ;; esac
  [[ -n "${sfields[19]:-}" ]] || return 1
  WPTT_PROC_STIME="${sfields[19]}"
  return 0
}

# 5b. Dấu vân tay đầy đủ của tiến trình Cha (starttime|startstack|cmdline).
_wptt_fingerprint() {
  WPTT_FP=""
  local pid="${1:-}" stat="" rest="" cmd="" chunk="" n=0
  local -a sfields=()
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  { IFS= read -r stat <"/proc/$pid/stat"; } 2>/dev/null || return 1
  rest="${stat##*) }"
  [[ "$rest" != "$stat" ]] || return 1

  IFS=' ' read -r -a sfields <<<"$rest"
  case "${sfields[0]:-}" in Z | X | x | "") return 1 ;; esac
  local stime="${sfields[19]:-}" sstack="${sfields[25]:-}"
  [[ -n "$stime" ]] || return 1
  {
    while ((n < 32)) && IFS= read -r -d '' chunk; do
      cmd+="${chunk} "
      n=$((n + 1))
    done <"/proc/$pid/cmdline"
  } 2>/dev/null || true
  WPTT_FP="${stime}|${sstack}|${cmd}"
  return 0
}

# 5c. Phát hiện tiến trình con của Cha đang vẽ Progress Bar (pv / wget --show-progress).
#     Khi có pv chạy, Spinner tự đứng im nhường TTY, không xóa đè thanh pv!
_wptt_has_active_progress_child() {
  local ppid="$1" spid="$2" kids="" kpid="" gkids="" gkpid="" comm="" cmdline=""
  { IFS= read -r kids <"/proc/$ppid/task/$ppid/children"; } 2>/dev/null || return 1
  [[ -n "$kids" ]] || return 1

  for kpid in $kids; do
    [[ "$kpid" == "$spid" ]] && continue
    comm=""
    { IFS= read -r comm <"/proc/$kpid/comm"; } 2>/dev/null || continue
    case "$comm" in
      pv | dialog | whiptail) return 0 ;;
      wget)
        cmdline=""
        { IFS= read -r -d '' cmdline <"/proc/$kpid/cmdline"; } 2>/dev/null || true
        [[ "$cmdline" == *"show-progress"* ]] && return 0
        ;;
    esac
    gkids=""
    { IFS= read -r gkids <"/proc/$kpid/task/$kpid/children"; } 2>/dev/null || continue
    for gkpid in $gkids; do
      comm=""
      { IFS= read -r comm <"/proc/$gkpid/comm"; } 2>/dev/null || continue
      [[ "$comm" == "pv" ]] && return 0
    done
  done
  return 1
}

# 6. Lấy số cột terminal (Ưu tiên $COLUMNS 0-subshell, cache 5s nếu phải gọi stty).
_wptt_get_cols() {
  if [[ "${COLUMNS:-}" =~ ^[0-9]+$ ]] && ((COLUMNS > 0)); then
    WPTT_TERM_COLS="$COLUMNS"
    return 0
  fi
  _wptt_now_ts
  if ((WPTT_TERM_COLS > 0 && WPTT_NOW_VAL - WPTT_TERM_COLS_TS < 5)); then
    return 0
  fi
  local rows="" cols=""
  read -r -t 1 rows cols < <({ stty size </dev/tty; } 2>/dev/null) || true
  if [[ "$cols" =~ ^[0-9]+$ ]] && ((cols > 0)); then
    WPTT_TERM_COLS="$cols"
    WPTT_TERM_COLS_TS="$WPTT_NOW_VAL"
  fi
  return 0
}

# 7. Dừng spinner: Tức thời, KHÔNG wait, gom sạch cả tiến trình con (sleep).
_wptt_stop_spinner() {
  local spid="${WPTT_SPINNER_PID:-}" sstime="${WPTT_SPINNER_STIME:-}"
  local hide="${WPTT_SPINNER_HIDE:-0}"
  WPTT_SPINNER_PID=""
  WPTT_SPINNER_STIME=""
  WPTT_SPINNER_HIDE=0

  if [[ "$spid" =~ ^[0-9]+$ ]] && kill -0 "$spid" 2>/dev/null; then
    local same=1
    if [[ -n "$sstime" ]]; then
      same=0
      if _wptt_get_proc_stime "$spid" && [[ "$WPTT_PROC_STIME" == "$sstime" ]]; then
        same=1
      fi
    fi
    if ((same)); then
      local kids=""
      { IFS= read -r kids <"/proc/$spid/task/$spid/children"; } 2>/dev/null || true
      kill -KILL "$spid" 2>/dev/null || true
      if [[ "$kids" =~ ^[0-9\ ]+$ ]]; then
        # shellcheck disable=SC2086
        kill -KILL $kids 2>/dev/null || true
      fi
    fi
  fi

  if [[ "$hide" == "1" ]]; then
    { printf '\033[?25h' >/dev/tty; } 2>/dev/null || true
  fi
  return 0
}

# 8. Dựng dòng căn lề phải chuẩn khung 80 cột (box_inner_width + 2).
#    TUYỆT ĐỐI KHÔNG cắt cụt nội dung raw_msg để bảo toàn 100% thông tin.
_wptt_build_aligned_line() {
  local icon_colored="$1"
  local raw_msg="$2"
  local right_plain="$3"
  local right_colored="$4"

  local biw="${box_inner_width:-78}"
  [[ "$biw" =~ ^[0-9]+$ ]] || biw=78
  local total_width=$((biw + 2))
  local cols="${WPTT_TERM_COLS:-0}"
  if ((cols > 0 && total_width > cols)); then
    total_width=$cols
  fi
  if ((total_width < 30)); then
    total_width=30
  fi

  local esc=$'\033'
  local clean_msg="$raw_msg"

  if [[ "$raw_msg" == *'\033'* ]]; then
    raw_msg="${raw_msg//\\033/$esc}"
  fi
  if [[ "$raw_msg" == *'\e['* ]]; then
    raw_msg="${raw_msg//\\e\[/${esc}[}"
  fi
  if [[ "$raw_msg" == *"$esc"* ]]; then
    _wptt_strip_ansi "$raw_msg"
    clean_msg="$WPTT_CLEAN_STR"
  else
    clean_msg="$raw_msg"
  fi

  clean_msg="${clean_msg//$'\n'/ }"
  clean_msg="${clean_msg//$'\r'/}"
  raw_msg="${raw_msg//$'\n'/ }"
  raw_msg="${raw_msg//$'\r'/}"

  local msg_len=${#clean_msg}
  local right_len=${#right_plain}
  local pad_len=$((total_width - 8 - msg_len - right_len))

  if ((pad_len < 2)); then
    pad_len=2
  fi

  local dots=""
  printf -v dots '%*s' "$pad_len" ""
  dots="${dots// /.}"

  printf -v WPTT_ALIGNED_LINE $'  %s %s \033[2;37m%s\033[0m %s' \
    "$icon_colored" "$raw_msg" "$dots" "$right_colored"
  return 0
}

# 9. Bắt đầu tác vụ (_runing).
#    Đặc biệt: Đỗ con trỏ ở đầu dòng (\r) sau mỗi lần in để nếu script xen `echo "ABC"`
#    vào giữa, hoặc gọi `_rundone` cho nhiều tác vụ khác nhau, giao diện vẫn sạch!
function _runing {
  local msg="${1:-Đang xử lý tác vụ...}"
  _wptt_stop_spinner

  _wptt_now_ts
  if [[ "${WPTT_RESUME_TS:-0}" =~ ^[0-9]+$ ]] && ((WPTT_RESUME_TS > 0)); then
    WPTT_RUN_START_TS="$WPTT_RESUME_TS"
    WPTT_RESUME_TS=0
  else
    WPTT_RUN_START_TS="$WPTT_NOW_VAL"
  fi
  WPTT_LAST_RUN_MSG="$msg"

  local label_run="${dang_tien_hanh:-Đang tiến hành}"
  local start_ts="$WPTT_RUN_START_TS"
  local parent_pid="${BASHPID:-$$}"

  local live=0
  if [[ -t 1 && -z "${BATS_TEST_FILENAME:-}" ]]; then
    if { : >/dev/tty; } 2>/dev/null; then
      live=1
    fi
  fi

  local init_plain="[${label_run}...]"
  local init_color=$'[\033[1;33m'"${label_run}"$'\033[1;33m.\033[2;37m..\033[0m]'
  local init_icon=$'\033[1;33m[-]\033[0m'

  if ((live)); then
    _wptt_get_cols
    _wptt_build_aligned_line "$init_icon" "$msg" "$init_plain" "$init_color"
    # Đỗ con trỏ về đầu dòng (\r ở cuối) để nếu người dùng gõ echo "..." ngay sau đó
    # thì không bị nối đuôi vào cột thứ 80 của dòng Spinner!
    { printf '\r\033[2K%s\r' "$WPTT_ALIGNED_LINE" >/dev/tty; } 2>/dev/null || true

    local hide="${WPTT_HIDE_CURSOR:-0}"
    [[ "$hide" == "1" ]] || hide=0
    local max_sec="${WPTT_SPINNER_MAX_SEC:-21600}"
    [[ "$max_sec" =~ ^[0-9]+$ ]] || max_sec=21600
    local max_iter=$((max_sec * 8 + 60))
    local cols="$WPTT_TERM_COLS"

    if [[ "$hide" == "1" ]]; then
      { printf '\033[?25l' >/dev/tty; } 2>/dev/null || true
    fi

    _wptt_fingerprint "$parent_pid" || true
    local parent_fp="$WPTT_FP"

    {
      (
        # --- Subshell Spinner: Cô lập hoàn toàn khỏi tiến trình cha ---
        set +eEu +o pipefail 2>/dev/null
        exec 2>/dev/null
        exec </dev/null >/dev/tty || exit 0

        local _fdp _fdn _fd_guard=0
        for _fdp in /proc/self/fd/*; do
          _fd_guard=$((_fd_guard + 1))
          ((_fd_guard > 64)) && break
          _fdn="${_fdp##*/}"
          if [[ "$_fdn" =~ ^[0-9]+$ ]] && ((_fdn > 2 && _fdn < 250)); then
            eval "exec ${_fdn}>&-" 2>/dev/null
          fi
        done

        local my_spid="${BASHPID:-$$}"
        WPTT_TERM_COLS="$cols"
        local -a frames=('-' '\' '|' '/')
        local -a wave_dots=(
          $'\033[1;33m.\033[2;37m..\033[0m'
          $'\033[1;33m..\033[2;37m.\033[0m'
          $'\033[1;33m...\033[0m'
        )
        local idx=1 elapsed=0 f_char="" d_wave="" sleep_rc=0
        local r_plain="" r_color="" icon_str=""

        while ((idx <= max_iter)); do
          sleep 0.15 2>/dev/null
          sleep_rc=$?
          if ((sleep_rc > 0 && sleep_rc < 128)); then
            sleep 1 2>/dev/null || break
          fi

          # (a) Kiểm tra cha còn sống và đúng dấu vân tay (chưa chết, chưa exec)
          if ! kill -0 "$parent_pid" 2>/dev/null; then
            printf '\r\033[2K' 2>/dev/null || true
            break
          fi
          if [[ -n "$parent_fp" ]]; then
            if ! _wptt_fingerprint "$parent_pid" || [[ "$WPTT_FP" != "$parent_fp" ]]; then
              printf '\r\033[2K' 2>/dev/null || true
              break
            fi
          fi

          _wptt_now_ts
          elapsed=$((WPTT_NOW_VAL - start_ts))
          if ((elapsed < 0)); then
            start_ts="$WPTT_NOW_VAL"
            elapsed=0
          fi
          if ((elapsed >= max_sec)); then
            break
          fi

          # (b) Nếu script đang chạy pv hoặc wget --show-progress, tự đứng im nhường TTY
          if _wptt_has_active_progress_child "$parent_pid" "$my_spid"; then
            idx=$((idx + 1))
            continue
          fi

          f_char="${frames[$((idx % 4))]}"
          d_wave="${wave_dots[$(((idx / 2) % 3))]}"

          if ((elapsed > 0)); then
            _wptt_format_duration "$elapsed"
            r_plain="[${label_run}... (${WPTT_DUR_STR})]"
            r_color=$'[\033[1;33m'"${label_run}${d_wave}"$'\033[1;33m ('"${WPTT_DUR_STR}"$')\033[0m]'
          else
            r_plain="[${label_run}...]"
            r_color=$'[\033[1;33m'"${label_run}${d_wave}"$']'
          fi

          icon_str=$'\033[1;33m['"${f_char}"$']\033[0m'
          _wptt_build_aligned_line "$icon_str" "$msg" "$r_plain" "$r_color"
          printf '\r\033[2K%s\r' "$WPTT_ALIGNED_LINE" || break

          idx=$((idx + 1))
        done

        if [[ "$hide" == "1" ]]; then
          printf '\033[?25h' 2>/dev/null || true
        fi
        exit 0
      ) &
      WPTT_SPINNER_PID=$!
    } 2>/dev/null

    disown "$WPTT_SPINNER_PID" 2>/dev/null || true
    WPTT_SPINNER_HIDE="$hide"
    if _wptt_get_proc_stime "$WPTT_SPINNER_PID"; then
      WPTT_SPINNER_STIME="$WPTT_PROC_STIME"
    else
      WPTT_SPINNER_STIME=""
    fi
  else
    # Chế độ tĩnh (BATS / Cronjob / Pipe): 0 tiến trình nền
    _wptt_build_aligned_line "$init_icon" "$msg" "$init_plain" "$init_color"
    printf '\r\033[2K%s\r' "$WPTT_ALIGNED_LINE"
  fi

  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "START" "$msg" || true
  fi
  return 0
}

# 10. In dòng kết quả cuối (dùng chung cho _rundone / _runloi).
_wptt_emit_final() {
  local color="$1" ch="$2" label="$3" msg="$4"
  local elapsed=0 r_plain="" r_color=""
  local reset=$'\033[0m'

  _wptt_now_ts
  if ((WPTT_RUN_START_TS > 0 && WPTT_NOW_VAL >= WPTT_RUN_START_TS)); then
    elapsed=$((WPTT_NOW_VAL - WPTT_RUN_START_TS))
  fi
  WPTT_ELAPSED="$elapsed"
  WPTT_LAST_RUN_MSG=""
  WPTT_RUN_START_TS=0

  local icon_str="${color}[${ch}]${reset}"
  if ((elapsed >= 2)); then
    _wptt_format_duration "$elapsed"
    r_plain="[${label} (${WPTT_DUR_STR})]"
    r_color="[${color}${label} (${WPTT_DUR_STR})${reset}]"
  else
    r_plain="[${label}]"
    r_color="[${color}${label}${reset}]"
  fi

  if [[ -t 1 ]]; then
    _wptt_get_cols
  else
    WPTT_TERM_COLS=0
  fi
  _wptt_build_aligned_line "$icon_str" "$msg" "$r_plain" "$r_color"
  printf '\r\033[2K%s\033[K\n' "$WPTT_ALIGNED_LINE"
  return 0
}

function _rundone {
  local prev_rc=$?
  _wptt_stop_spinner

  local msg="${1:-$WPTT_LAST_RUN_MSG}"
  [[ -z "$msg" ]] && msg="Hoàn tất tác vụ"

  _wptt_emit_final $'\033[1;32m' '✔' "${hoan_tat:-Hoàn tất}" "$msg"

  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "SUCCESS" "$msg (${WPTT_ELAPSED}s)" || true
  fi
  if [[ -t 1 && -z "${BATS_TEST_FILENAME:-}" ]]; then
    sleep 0.08 2>/dev/null || true
  fi
  return "$prev_rc"
}

function _runloi {
  local prev_rc=$?
  _wptt_stop_spinner

  local msg="${1:-$WPTT_LAST_RUN_MSG}"
  [[ -z "$msg" ]] && msg="Xảy ra sự cố khi thực thi"

  _wptt_emit_final $'\033[1;31m' '✖' "${dang_xay_ra_su_co:-Xảy ra sự cố}" "$msg"

  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "ERROR" "$msg (${WPTT_ELAPSED}s)" || true
  fi
  if [[ -t 1 && -z "${BATS_TEST_FILENAME:-}" ]]; then
    sleep 0.2 2>/dev/null || true
  fi
  return "$prev_rc"
}

# 11. Thay thế an toàn cho `exec` khi liên kết menu.
_wptt_exec() {
  _wptt_stop_spinner
  if [[ -t 1 ]]; then
    { printf '\r\033[2K' >/dev/tty; } 2>/dev/null || true
  fi
  exec "$@"
}

# 12. Khôi phục con trỏ thủ công (idempotent).
_wptt_tty_reset() {
  if [[ -t 1 ]]; then
    { printf '\033[?25h' >/dev/tty; } 2>/dev/null || true
  fi
  return 0
}

# 13. Tạm dừng spinner tại chỗ (Hoàn toàn không tự ý nhảy dòng hay xóa dòng nếu bạn không muốn)
_wptt_pause_spinner() {
  local saved_rc=$?
  _wptt_stop_spinner
  return "$saved_rc"
}

# 14. Chạy lại spinner tại đúng dòng hiện tại (Không tự ý lùi dòng \033[1A)
#     và giữ nguyên mốc thời gian WPTT_RUN_START_TS ban đầu cho cả Spinner lẫn _rundone!
_wptt_resume_spinner() {
  local saved_rc=$?
  local msg="${1:-$WPTT_LAST_RUN_MSG}"
  local keep_ts="${WPTT_RUN_START_TS:-0}"

  WPTT_RESUME_TS="$keep_ts"
  _runing "$msg"
  ((keep_ts > 0)) && WPTT_RUN_START_TS="$keep_ts"
  return "$saved_rc"
}

# ==============================================================================
# 4. KHAI BÁO BIẾN MÀU UI & KÍCH THƯỚC KHUNG (Dùng cho Giao diện bo cong)
# ==============================================================================
C_RED='\033[1;31m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[1;36m'
C_BOLD_WHITE='\033[1;37m'
C_RESET='\033[0m'
box_inner_width=78

# ==============================================================================
# 5. HÀM RENDER KHUNG (TỰ ĐỘNG CĂN GIỮA)
# ==============================================================================
center_text() {
  local text="$1"
  # Tẩy sạch ký tự mã màu ANSI để đếm chiều dài cho chuẩn
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}

  if ((text_len >= box_inner_width)); then
    printf "${C_CYAN}│${C_RESET} %b ${C_CYAN}│${C_RESET}\n" "$text"
    return
  fi

  local pad_left=$(((box_inner_width - text_len) / 2))
  local pad_right=$((box_inner_width - text_len - pad_left))
  printf "${C_CYAN}│${C_RESET}%*s%b%*s${C_CYAN}│${C_RESET}\n" "$pad_left" "" "$text" "$pad_right" ""
}

# ==============================================================================
# 6. HÀM RENDER KHUNG (TỰ ĐỘNG CĂN LỀ TRÁI)
# ==============================================================================
#left_text "${C_YELLOW}Đây là dòng chữ căn trái${C_RESET}"
#left_text "${C_WHITE}Dòng này lùi vào sâu hơn${C_RESET}" 5
left_text() {
  local text="$1"
  local indent=${2:-2} # Thụt lề trái mặc định là 2 dấu cách (có thể truyền tham số thứ 2 để đổi)

  # Tẩy sạch ký tự mã màu ANSI để đếm chiều dài
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")

  # Đếm độ dài chuẩn xác 100% cho tiếng Việt (tránh lỗi lệch viền phải)
  local text_len=$(echo -n "$clean_text" | awk '{print length($0)}')

  # Nếu chữ quá dài so với khung (chống lỗi tính toán âm)
  if ((text_len + indent >= box_inner_width)); then
    printf "${C_CYAN}│${C_RESET}%*s%b ${C_CYAN}│${C_RESET}\n" "$indent" "" "$text"
    return
  fi

  # Tính toán dồn toàn bộ khoảng trắng bù trừ sang lề phải
  local pad_right=$((box_inner_width - text_len - indent))

  # In ra màn hình: Viền trái -> Thụt lề -> Text -> Khoảng trắng bù -> Viền phải
  printf "${C_CYAN}│${C_RESET}%*s%b%*s${C_CYAN}│${C_RESET}\n" "$indent" "" "$text" "$pad_right" ""
}

print_border_top() {
  local color="${1:-$C_CYAN}"
  echo -e "${color}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
}

print_border_mid() {
  local color="${1:-$C_CYAN}"
  echo -e "${color}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
}

print_border_bot() {
  local color="${1:-$C_CYAN}"
  echo -e "${color}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
}

print_spacer() { printf "${C_CYAN}│%78s│${C_RESET}\n" ""; }


print_full_row() {
  local index="$1"
  local text="$2"
  local box_inner_width=78

  if [[ -z "$index" ]]; then
    # --- TIÊU ĐỀ NHÓM (Căn lề chuẩn 3 khoảng trắng khớp với 2 cột) ---
    local raw_title="   ▶ ${text}"
    local clean_len=$(echo -en "$raw_title" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g" | wc -m)
    local pad=$((box_inner_width - clean_len))
    [[ $pad -lt 0 ]] && pad=0

    # In tiêu đề: Chữ trắng in đậm viết hoa trên nền viền Cyan
    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_YELLOW}▶${C_RESET} ${C_BOLD_WHITE}${text^^}${C_RESET}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  else
    # --- DÒNG TÍNH NĂNG (Căn lề chuẩn 3 khoảng trắng) ---
    local formatted_index=$(printf "%2s" "$index")
    local raw_text="   [${formatted_index}] ${text}"
    local clean_len=$(echo -en "$raw_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g" | wc -m)
    local pad=$((box_inner_width - clean_len))
    [[ $pad -lt 0 ]] && pad=0

    # In dòng tính năng: Số màu xanh lá, chữ màu Cyan nhạt
    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_GREEN}[${formatted_index}]${C_RESET} ${C_CYAN}${text}${C_RESET}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  fi
}

