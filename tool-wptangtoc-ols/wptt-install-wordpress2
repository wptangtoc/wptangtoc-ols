	function wptt_nhap_mat_khau_an() {
		local prompt_text="$1"
		local var_name="$2"
		local pass_var=""
		local char

		echo -en "${C_CYAN}${prompt_text} ${C_RESET}"
		while IFS= read -r -s -N 1 char; do
			if [[ -z "$char" || "$char" == $'\n' || "$char" == $'\r' ]]; then
				echo; break
			elif [[ "$char" == $'\x7f' || "$char" == $'\b' ]]; then
				if [[ ${#pass_var} -gt 0 ]]; then
					pass_var="${pass_var%?}"
					echo -ne '\b \b'
