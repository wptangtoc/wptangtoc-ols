				echo -e "\n${C_RED}Đã hủy nhập mật khẩu.${C_RESET}"
				exit 1
			else
				pass_var+="$char"
				echo -n '*'
			fi
		done
		printf -v "$var_name" '%s' "$pass_var"
	}
# ==========================================================================
