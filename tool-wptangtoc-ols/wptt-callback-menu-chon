# ==============================================================================
# 4. ENGINE VẼ GIAO DIỆN (100% NATIVE BASH - 0 SUBSHELL)
# ==============================================================================
MARGIN=""
calc_margin() { MARGIN=""; }

# Hàm khử mã màu ANSI thuần Bash trên RAM (0 Subshell)
_strip_ansi() {
  local s="$1"
  while [[ "$s" =~ $'\x1B'\[[0-9\;]*[a-zA-Z] ]]; do
    s="${s//"${BASH_REMATCH[0]}"/}"
  done
  REPLY_PLAIN="$s"
}

print_row() {
  local l_num="$1" l_text="$2" r_num="$3" r_text="$4"
  local c1_plain="" c1_color="" c2_plain="" c2_color=""
  local num_fmt pad_l pad_r

  if [[ -n "$l_text" ]]; then
    if [[ -z "$l_num" ]]; then
      c1_plain="  ▶ ${l_text}"
      ((${#c1_plain} > 36)) && c1_plain="${c1_plain:0:34}.."
      c1_color="  ${C_YELLOW}▶ ${C_BOLD_WHITE}${c1_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$l_num"
      c1_plain="  [$num_fmt] ${l_text}"
      ((${#c1_plain} > 36)) && c1_plain="${c1_plain:0:34}.."
      c1_color="  ${C_GREEN}[$num_fmt]${C_RESET} ${C_CYAN}${c1_plain:7}${C_RESET}"
    fi
  fi

  if [[ -n "$r_text" ]]; then
    if [[ -z "$r_num" ]]; then
      c2_plain="  ▶ ${r_text}"
      ((${#c2_plain} > 36)) && c2_plain="${c2_plain:0:34}.."
      c2_color="  ${C_YELLOW}▶ ${C_BOLD_WHITE}${c2_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$r_num"
      c2_plain="  [$num_fmt] ${r_text}"
      ((${#c2_plain} > 36)) && c2_plain="${c2_plain:0:34}.."
      c2_color="  ${C_GREEN}[$num_fmt]${C_RESET} ${C_CYAN}${c2_plain:7}${C_RESET}"
    fi
  fi

  pad_l=$((37 - ${#c1_plain}))
  ((pad_l < 0)) && pad_l=0
  pad_r=$((37 - ${#c2_plain}))
  ((pad_r < 0)) && pad_r=0
  printf "${MARGIN}${C_CYAN}│${C_RESET} %b%*s  %b%*s ${C_CYAN}│${C_RESET}\n" "$c1_color" "$pad_l" "" "$c2_color" "$pad_r" ""
}

# ==============================================================================
# HÀM IN DÒNG FULL (DÙNG CHO CÁC MENU PHÂN NHÓM 1 CỘT - 0 SUBSHELL)
# ==============================================================================
print_full_row() {
  local index="$1"
  local text="$2"
  local box_inner_width=78
  local REPLY_PLAIN=""
  local clean_len pad pad_str formatted_index

  _strip_ansi "$text"

  if [[ -z "$index" ]]; then
    clean_len=$((5 + ${#REPLY_PLAIN}))
    pad=$((box_inner_width - clean_len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_YELLOW}▶${C_RESET} ${C_BOLD_WHITE}${text^^}${C_RESET}${pad_str}${C_CYAN}│${C_RESET}"
  else
    printf -v formatted_index "%2s" "$index"
    clean_len=$((3 + ${#formatted_index} + 3 + ${#REPLY_PLAIN}))
    pad=$((box_inner_width - clean_len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_GREEN}[${formatted_index}]${C_RESET} ${C_CYAN}${text}${C_RESET}${pad_str}${C_CYAN}│${C_RESET}"
  fi
}

print_header() {
  local text="${1:-TRUNG TÂM QUẢN TRỊ WPTANGTOC OLS}"
  local REPLY_PLAIN=""
  _strip_ansi "$text"
  local len=${#REPLY_PLAIN}
  local p_left=$(((78 - len) / 2))
  ((p_left < 0)) && p_left=0
  local p_right=$((78 - len - p_left))
  ((p_right < 0)) && p_right=0
  printf "${MARGIN}${C_CYAN}│${C_RESET}%*s${C_BOLD_WHITE}%b${C_RESET}%*s${C_CYAN}│${C_RESET}\n" "$p_left" "" "$text" "$p_right" ""
}

print_spacer() { printf "${MARGIN}${C_CYAN}│%78s│${C_RESET}\n" ""; }

draw_default_grid() {
  local item_count=1
  local opt clean_opt
  for opt in "${options[@]}"; do
    if [[ "$opt" == *"───"* ]]; then
      print_spacer
      clean_opt="${opt//───/}"
      clean_opt="${clean_opt//\[/}"
      clean_opt="${clean_opt//\]/}"
      clean_opt="${clean_opt#"${clean_opt%%[![:space:]]*}"}"
      clean_opt="${clean_opt%"${clean_opt##*[![:space:]]}"}"
      print_row "" "$clean_opt" "" ""
    else
      print_row "$item_count" "$opt" "" ""
      ((item_count++))
    fi
  done
}

# ==============================================================================
# 4B. ENGINE TÌM KIẾM SEO CHO MENU CON (KHÔNG DẤU + SỬA CHÍNH TẢ + PREVIEW)
# ==============================================================================
wptt_sub_fzf_search() {
  local query="${1:-}"
  [[ -s "${SUB_IDX_FILE:-}" ]] || return 0

  LC_ALL=C.UTF-8 awk -F'\t' -v q="$query" -v hits_file="${HITS_FILE:-}" '
    function norm_vn_q(s) {
      s = tolower(s)
      gsub(/À/, "à", s); gsub(/Á/, "á", s); gsub(/Ả/, "ả", s); gsub(/Ã/, "ã", s); gsub(/Ạ/, "ạ", s)
      gsub(/Ă/, "ă", s); gsub(/Ằ/, "ằ", s); gsub(/Ắ/, "ắ", s); gsub(/Ẳ/, "ẳ", s); gsub(/Ẵ/, "ẵ", s); gsub(/Ặ/, "ặ", s)
      gsub(/Â/, "â", s); gsub(/Ầ/, "ầ", s); gsub(/Ấ/, "ấ", s); gsub(/Ẩ/, "ẩ", s); gsub(/Ẫ/, "ẫ", s); gsub(/Ậ/, "ậ", s)
      gsub(/Đ/, "đ", s)
      gsub(/È/, "è", s); gsub(/É/, "é", s); gsub(/Ẻ/, "ẻ", s); gsub(/Ẽ/, "ẽ", s); gsub(/Ẹ/, "ẹ", s)
      gsub(/Ê/, "ê", s); gsub(/Ề/, "ề", s); gsub(/Ế/, "ế", s); gsub(/Ể/, "ể", s); gsub(/Ễ/, "ễ", s); gsub(/Ệ/, "ệ", s)
      gsub(/Ì/, "ì", s); gsub(/Í/, "í", s); gsub(/Ỉ/, "ỉ", s); gsub(/Ĩ/, "ĩ", s); gsub(/Ị/, "ị", s)
      gsub(/Ò/, "ò", s); gsub(/Ó/, "ó", s); gsub(/Ỏ/, "ỏ", s); gsub(/Õ/, "õ", s); gsub(/Ọ/, "ọ", s)
      gsub(/Ô/, "ô", s); gsub(/Ồ/, "ồ", s); gsub(/Ố/, "ố", s); gsub(/Ổ/, "ổ", s); gsub(/Ỗ/, "ỗ", s); gsub(/Ộ/, "ộ", s)
      gsub(/Ơ/, "ơ", s); gsub(/Ờ/, "ờ", s); gsub(/Ớ/, "ớ", s); gsub(/Ở/, "ở", s); gsub(/Ỡ/, "ỡ", s); gsub(/Ợ/, "ợ", s)
      gsub(/Ù/, "ù", s); gsub(/Ú/, "ú", s); gsub(/Ủ/, "ủ", s); gsub(/Ũ/, "ũ", s); gsub(/Ụ/, "ụ", s)
      gsub(/Ư/, "ư", s); gsub(/Ừ/, "ừ", s); gsub(/Ứ/, "ứ", s); gsub(/Ử/, "ử", s); gsub(/Ữ/, "ữ", s); gsub(/Ự/, "ự", s)
      gsub(/Ỳ/, "ỳ", s); gsub(/Ý/, "ý", s); gsub(/Ỷ/, "ỷ", s); gsub(/Ỹ/, "ỹ", s); gsub(/Ỵ/, "ỵ", s)
      gsub(/oá/, "óa", s); gsub(/oà/, "òa", s); gsub(/oả/, "ỏa", s); gsub(/oã/, "õa", s); gsub(/oạ/, "ọa", s)
      gsub(/uỷ/, "ủy", s); gsub(/uý/, "úy", s); gsub(/uỳ/, "ùy", s); gsub(/uỹ/, "ũy", s); gsub(/uỵ/, "ụy", s)
      return s
    }
    function strip_vn_q(s) {
      gsub(/à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ/, "a", s)
      gsub(/đ/, "d", s)
      gsub(/è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ/, "e", s)
      gsub(/ì|í|ỉ|ĩ|ị/, "i", s)
      gsub(/ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ/, "o", s)
      gsub(/ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự/, "u", s)
      gsub(/ỳ|ý|ỷ|ỹ|ỵ/, "y", s)
      return s
    }
    function can_delete_one(long_s, short_s, ll, ls,    i, j, skipped) {
      i = 1; j = 1; skipped = 0
      while (i <= ll && j <= ls) {
        if (substr(long_s, i, 1) == substr(short_s, j, 1)) { i++; j++ }
        else { if (++skipped > 1) return 0; i++ }
      }
      return 1
    }
    function edit_dist_le1(a, b,    la, lb, i, diff, p1, p2) {
      la = length(a); lb = length(b)
      if (la < 4 || lb < 4 || la - lb > 1 || lb - la > 1) return 0
      if (la == lb) {
        diff = 0
        for (i = 1; i <= la; i++) {
          if (substr(a, i, 1) != substr(b, i, 1)) {
            if (++diff == 1) p1 = i
            else if (diff == 2) p2 = i
            else return 0
          }
        }
        if (diff <= 1) return 1
        return (diff == 2 && p2 == p1 + 1 && substr(a, p1, 1) == substr(b, p2, 1) && substr(a, p2, 1) == substr(b, p1, 1))
      }
      return (la > lb) ? can_delete_one(a, b, la, lb) : can_delete_one(b, a, lb, la)
    }
    function check_typo_word(w, opt_ascii, t_words,    c1, c2, n_tw, tw_arr, k) {
      if (length(w) < 2) return 0
      c1 = substr(w, 1, 1); c2 = substr(w, 1, 2)
      if (c1 == "s") { if (index(opt_ascii, "x" substr(w, 2)) > 0) return 1 }
      else if (c1 == "x") { if (index(opt_ascii, "s" substr(w, 2)) > 0) return 1 }
      else if (c2 == "ch") { if (index(opt_ascii, "tr" substr(w, 3)) > 0) return 1 }
      else if (c2 == "tr") { if (index(opt_ascii, "ch" substr(w, 3)) > 0) return 1 }
      else if (c2 == "gi") { if (index(opt_ascii, "d" substr(w, 3)) > 0) return 1 }

      if (length(w) >= 4) {
        n_tw = split(t_words, tw_arr, " ")
        for (k = 1; k <= n_tw; k++) {
          if (edit_dist_le1(w, tw_arr[k])) return 1
        }
      }
      return 0
    }
    BEGIN {
      q_norm = norm_vn_q(q)
      gsub(/^[ \t]+|[ \t]+$/, "", q_norm)
      q_ascii = strip_vn_q(q_norm)
      n_words = split(q_norm, q_words, /[ \t]+/)
      split(q_ascii, q_words_ascii, /[ \t]+/)

      if (n_words > 0 && hits_file != "") {
        while ((getline hline < hits_file) > 0) {
          split(hline, hparts, "\t")
          if (hparts[1] != "") user_hits[hparts[1]] = int(hparts[2])
        }
        close(hits_file)
      }
      m = 0
    }
    {
      # Cột SUB_IDX: 1:disp | 2:num | 3:full_title | 4:script | 5:base_hot | 6:opt_len | 7:opt_norm | 8:opt_ascii | 9:d_ascii | 10:t_words
      if (n_words == 0) {
        print $1 "\t" $2 "\t" $3 "\t" $4
        next
      }

      disp = $1; num = $2; full_title = $3; script = $4
      base_hot = int($5); opt_len = int($6)
      opt_norm = $7; opt_ascii = $8; d_ascii = $9; t_words = $10

      # Nếu người dùng gõ trực tiếp số thứ tự trong fzf (VD: gõ "1", "2")
      if (n_words == 1 && q_ascii ~ /^[0-9]+$/ && int(num) == int(q_ascii)) {
        m++
        keys[m] = sprintf("00000000%04d", NR)
        rows[m] = disp "\t" num "\t" full_title "\t" script
        next
      }

      in_exact = 0; in_ascii = 0; in_doc = 0; in_typo = 0

      for (i = 1; i <= n_words; i++) {
        w = q_words[i]; wa = q_words_ascii[i]
        if (index(opt_norm, w) > 0) {
          in_exact++; in_ascii++
        } else if (index(opt_ascii, wa) > 0) {
          in_ascii++
        } else if (index(d_ascii, wa) > 0) {
          in_doc++
        } else if (check_typo_word(wa, opt_ascii, t_words)) {
          in_typo++
        } else {
          next
        }
      }

      if (in_typo > 0) score = 45 + in_typo
      else if (index(opt_norm, q_norm) == 1) score = 1
      else if (index(opt_ascii, q_ascii) == 1) score = 2
      else if (index(opt_norm, q_norm) > 0) score = 6
      else if (index(opt_ascii, q_ascii) > 0) score = 7
      else if (in_exact == n_words) score = 13
      else if (in_ascii == n_words) score = 15
      else if (in_ascii > 0) score = 30 + (n_words - in_ascii)
      else if (index(d_ascii, q_ascii) > 0) score = 50
      else score = 60

      hot_rank = base_hot
      if (full_title != "" && (full_title in user_hits)) {
        hot_rank -= (user_hits[full_title] * 3)
        if (hot_rank < 1) hot_rank = 1
      }

      m++
      keys[m] = sprintf("%02d%03d%03d%04d", score, hot_rank, opt_len, NR)
      rows[m] = disp "\t" num "\t" full_title "\t" script
    }
    END {
      if (m > 1) {
        gap = int(m / 2)
        while (gap > 0) {
          for (i = gap + 1; i <= m; i++) {
            tk = keys[i]; tr = rows[i]
            j = i
            while (j > gap && keys[j - gap] > tk) {
              keys[j] = keys[j - gap]
              rows[j] = rows[j - gap]
              j -= gap
            }
            keys[j] = tk; rows[j] = tr
          }
          gap = int(gap / 2)
        }
      }
      for (i = 1; i <= m; i++) print rows[i]
    }
  ' "$SUB_IDX_FILE"
}
export -f wptt_sub_fzf_search

wptt_sub_fzf_previewer() {
  local f_title="$1"
  local script_to_preview="$2"
  local search_query="${3:-}"

  printf "\033[1;36m⚡ %s\033[0m\n" "$f_title"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    return 0
  fi

  local alt_regex="" word esc_word i ch
  if [[ -n "$search_query" ]]; then
    for word in $search_query; do
      ((${#word} < 2)) && continue
      esc_word=""
      for ((i = 0; i < ${#word}; i++)); do
        ch="${word:i:1}"
        case "$ch" in
          '\' | '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|') esc_word+="\\$ch" ;;
          'a' | 'A') esc_word+="(a|à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ)" ;;
          'd' | 'D') esc_word+="(d|đ)" ;;
          'e' | 'E') esc_word+="(e|è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ)" ;;
          'i' | 'I') esc_word+="(i|ì|í|ỉ|ĩ|ị)" ;;
          'o' | 'O') esc_word+="(o|ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ)" ;;
          'u' | 'U') esc_word+="(u|ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự)" ;;
          'y' | 'Y') esc_word+="(y|ỳ|ý|ỷ|ỹ|ỵ)" ;;
          *) esc_word+="$ch" ;;
        esac
      done
      if [[ -n "$alt_regex" ]]; then
        alt_regex+="|${esc_word}"
      else
        alt_regex="${esc_word}"
      fi
    done
  fi

  local active=0 line trimmed line_count=0 re=""
  [[ -n "$alt_regex" ]] && re="($alt_regex)"

  shopt -s nocasematch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" == *huong_dan*"("*")"*"{"* ]]; then
        active=1
      fi
      continue
    fi
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ "$trimmed" == "}"* ]] && break
    [[ -z "$trimmed" || "$trimmed" == "EOF"* || "$trimmed" == "cat <<"* ]] && continue

    if [[ "$trimmed" == "echo "* ]]; then
      line="${trimmed#echo }"
      if [[ "$line" == -* ]]; then
        line="${line#-*([eEn]) }"
      fi
      line="${line#\"}"
      line="${line%\"}"
      line="${line#\'}"
      line="${line%\'}"
    fi

    if [[ -n "$re" && "$line" =~ $re ]]; then
      local out="" rest="$line" m_str prefix
      while [[ "$rest" =~ $re ]]; do
        m_str="${BASH_REMATCH[1]}"
        [[ -z "$m_str" ]] && break
        prefix="${rest%%"$m_str"*}"
        out+="${prefix}"$'\033[1;33;4m'"${m_str}"$'\033[0m'
        rest="${rest#*"$m_str"}"
      done
      line="${out}${rest}"
    fi
    printf "\033[90m%b\033[0m\n" "$line"
    ((++line_count >= 5)) && break
  done <"$script_to_preview"
  shopt -u nocasematch
}
export -f wptt_sub_fzf_previewer

# Hàm dựng nhanh Index cho Menu Con (Kết nối với file .idx toàn cục nếu có)
_run_submenu_seo_fzf() {
  mkdir -p /etc/wptt/tmp 2>/dev/null || true
  export SUB_IDX_FILE="/etc/wptt/tmp/wptt_sub_idx_$$.tsv"
  export HITS_FILE="/etc/wptt/tmp/wptt_hits_search.tsv"
  local global_idx="/etc/wptt/tmp/wptt_search_ft_v3_${ngon_ngu:-vi}_${version_wptangtoc_ols:-latest}.idx"

  local -a raw_sub_lines=()
  local count=1 i REPLY_PLAIN=""
  for i in "${valid_indices[@]}"; do
    _strip_ansi "${options[$i]}"
    raw_sub_lines+=("${count}"$'\t'"${REPLY_PLAIN}")
    ((count++))
  done

  LC_ALL=C.UTF-8 awk -F'\t' -v OFS='\t' -v g_idx="$global_idx" '
    function norm_vn(s) {
      s = tolower(s)
      gsub(/À/, "à", s); gsub(/Á/, "á", s); gsub(/Ả/, "ả", s); gsub(/Ã/, "ã", s); gsub(/Ạ/, "ạ", s)
      gsub(/Ă/, "ă", s); gsub(/Ằ/, "ằ", s); gsub(/Ắ/, "ắ", s); gsub(/Ẳ/, "ẳ", s); gsub(/Ẵ/, "ẵ", s); gsub(/Ặ/, "ặ", s)
      gsub(/Â/, "â", s); gsub(/Ầ/, "ầ", s); gsub(/Ấ/, "ấ", s); gsub(/Ẩ/, "ẩ", s); gsub(/Ẫ/, "ẫ", s); gsub(/Ậ/, "ậ", s)
      gsub(/Đ/, "đ", s)
      gsub(/È/, "è", s); gsub(/É/, "é", s); gsub(/Ẻ/, "ẻ", s); gsub(/Ẽ/, "ẽ", s); gsub(/Ẹ/, "ẹ", s)
      gsub(/Ê/, "ê", s); gsub(/Ề/, "ề", s); gsub(/Ế/, "ế", s); gsub(/Ể/, "ể", s); gsub(/Ễ/, "ễ", s); gsub(/Ệ/, "ệ", s)
      gsub(/Ì/, "ì", s); gsub(/Í/, "í", s); gsub(/Ỉ/, "ỉ", s); gsub(/Ĩ/, "ĩ", s); gsub(/Ị/, "ị", s)
      gsub(/Ò/, "ò", s); gsub(/Ó/, "ó", s); gsub(/Ỏ/, "ỏ", s); gsub(/Õ/, "õ", s); gsub(/Ọ/, "ọ", s)
      gsub(/Ô/, "ô", s); gsub(/Ồ/, "ồ", s); gsub(/Ố/, "ố", s); gsub(/Ổ/, "ổ", s); gsub(/Ỗ/, "ỗ", s); gsub(/Ộ/, "ộ", s)
      gsub(/Ơ/, "ơ", s); gsub(/Ờ/, "ờ", s); gsub(/Ớ/, "ớ", s); gsub(/Ở/, "ở", s); gsub(/Ỡ/, "ỡ", s); gsub(/Ợ/, "ợ", s)
      gsub(/Ù/, "ù", s); gsub(/Ú/, "ú", s); gsub(/Ủ/, "ủ", s); gsub(/Ũ/, "ũ", s); gsub(/Ụ/, "ụ", s)
      gsub(/Ư/, "ư", s); gsub(/Ừ/, "ừ", s); gsub(/Ứ/, "ứ", s); gsub(/Ử/, "ử", s); gsub(/Ữ/, "ữ", s); gsub(/Ự/, "ự", s)
      gsub(/Ỳ/, "ỳ", s); gsub(/Ý/, "ý", s); gsub(/Ỷ/, "ỷ", s); gsub(/Ỹ/, "ỹ", s); gsub(/Ỵ/, "ỵ", s)
      gsub(/oá/, "óa", s); gsub(/oà/, "òa", s); gsub(/oả/, "ỏa", s); gsub(/oã/, "õa", s); gsub(/oạ/, "ọa", s)
      gsub(/uỷ/, "ủy", s); gsub(/uý/, "úy", s); gsub(/uỳ/, "ùy", s); gsub(/uỹ/, "ũy", s); gsub(/uỵ/, "ụy", s)
      return s
    }
    function strip_vn(s) {
      s = tolower(s)
      gsub(/à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ|À|Á|Ả|Ã|Ạ|Ă|Ằ|Ắ|Ẳ|Ẵ|Ặ|Â|Ầ|Ấ|Ẩ|Ẫ|Ậ/, "a", s)
      gsub(/đ|Đ/, "d", s)
      gsub(/è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ|È|É|Ẻ|Ẽ|Ẹ|Ê|Ề|Ế|Ể|Ễ|Ệ/, "e", s)
      gsub(/ì|í|ỉ|ĩ|ị|Ì|Í|Ỉ|Ĩ|Ị/, "i", s)
      gsub(/ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ|Ò|Ó|Ỏ|Õ|Ọ|Ô|Ồ|Ố|Ổ|Ỗ|Ộ|Ơ|Ờ|Ớ|Ở|Ỡ|Ợ/, "o", s)
      gsub(/ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự|Ù|Ú|Ủ|Ũ|Ụ|Ư|Ừ|Ứ|Ử|Ữ|Ự/, "u", s)
      gsub(/ỳ|ý|ỷ|ỹ|ỵ|Ỳ|Ý|Ỷ|Ỹ|Ỵ/, "y", s)
      return s
    }
    function calc_base_hot(opt_a,    h) {
      h = 50
      if (opt_a == "them domain && subdomain" || opt_a == "them domain") h = 1
      else if (opt_a == "tai ma nguon wordpress" || index(opt_a, "tai ma nguon wordpress") == 1) h = 2
      else if (index(opt_a, "quet ma doc") == 1 || index(opt_a, "sao luu") == 1 || index(opt_a, "khoi phuc") == 1) h = 5
      else if (index(opt_a, "cai dat ssl") == 1 || index(opt_a, "xoa domain") == 1 || index(opt_a, "phan quyen domain") == 1) h = 8
      else if (index(opt_a, "xoa toan bo cache") == 1 || index(opt_a, "xoa cache") == 1 || index(opt_a, "khoi dong lai") == 1) h = 10
      else if (index(opt_a, "chinh sua vhost") == 1 || index(opt_a, "chinh sua php") == 1 || index(opt_a, "doi mat khau") == 1) h = 12
      else if (index(opt_a, "tao swap") == 1 || index(opt_a, "xoa swap") == 1 || index(opt_a, "nhan ban") == 1) h = 15
      return h
    }
    BEGIN {
      if (g_idx != "") {
        while ((getline gline < g_idx) > 0) {
          split(gline, gp, "\t")
          # gp[8] = opt_part, gp[1] = full_title, gp[2] = script, gp[4] = base_hot, gp[12] = d_ascii
          if (gp[8] != "" && !(gp[8] in map_full)) {
            map_full[gp[8]] = gp[1]
            map_script[gp[8]] = gp[2]
            map_hot[gp[8]] = gp[4]
            map_doc[gp[8]] = gp[12]
          }
        }
        close(g_idx)
      }
    }
    {
      num = $1
      opt_plain = $2
      disp = sprintf("%2d. %s", num, opt_plain)
      opt_norm = norm_vn(opt_plain)
      opt_ascii = strip_vn(opt_norm)

      full_t = (opt_norm in map_full) ? map_full[opt_norm] : opt_plain
      script_p = (opt_norm in map_script) ? map_script[opt_norm] : ""
      base_hot = (opt_norm in map_hot) ? int(map_hot[opt_norm]) : calc_base_hot(opt_ascii)
      d_ascii = (opt_norm in map_doc) ? map_doc[opt_norm] : ""

      opt_len = length(opt_ascii)
      if (opt_len > 999) opt_len = 999

      t_words = opt_ascii
      gsub(/[^a-z0-9]+/, " ", t_words)
      gsub(/^ +| +$/, "", t_words)

      print disp, num, full_t, script_p, base_hot, opt_len, opt_norm, opt_ascii, d_ascii, t_words
    }
  ' < <(printf "%s\n" "${raw_sub_lines[@]}") >"$SUB_IDX_FILE" 2>/dev/null

  local -a sub_init_lines=()
  local f_disp f_num f_full f_script
  while IFS=$'\t' read -r f_disp f_num f_full f_script _; do
    [[ -z "$f_disp" ]] && continue
    sub_init_lines+=("${f_disp}"$'\t'"${f_num}"$'\t'"${f_full}"$'\t'"${f_script}")
  done <"$SUB_IDX_FILE"

  export SHELL=/bin/bash
  REPLY_SUB_SELECTED=""
  trap '' SIGINT
  REPLY_SUB_SELECTED=$(
    printf "%s\n" "${sub_init_lines[@]}" | fzf \
      --ansi \
      --disabled \
      --bind 'change:reload:sleep 0.041; wptt_sub_fzf_search {q}' \
      --prompt="🔍 Tìm kiếm trong Menu này > " \
      --height='~55%' \
      --border=rounded \
      --color=border:cyan \
      --layout=reverse \
      --cycle \
      --with-nth=1 \
      --delimiter=$'\t' \
      --header="Gõ từ khóa | ESC hủy" \
      --preview='wptt_sub_fzf_previewer {3} {4} {q}' \
      --preview-window=up:4:wrap
  ) || true
  trap '_wptt_menu_ctrl_c' SIGINT

  /bin/rm -f -- "$SUB_IDX_FILE" 2>/dev/null || true
  SUB_IDX_FILE=""
}

# ==============================================================================
# 5. TIỀN XỬ LÝ (O(1) MAPPING) - TỐI ƯU SIÊU TỐC
# ==============================================================================
valid_indices=()
for i in "${!options[@]}"; do
  [[ "${options[$i]}" != *"───"* ]] && valid_indices+=("$i")
done
total_valid_opts=${#valid_indices[@]}

# ==============================================================================
# 6. VÒNG LẶP DASHBOARD CHÍNH
# ==============================================================================
while true; do
  calc_margin
  # clear # GIỮ CỐ ĐỊNH COMMENT ĐỂ KHÔNG BỊ TRÔI LOG SAU KHI CHẠY LỆNH

  echo -e "${MARGIN}${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  print_header "${MENU_TITLE:-TRUNG TÂM QUẢN TRỊ WPTANGTOC OLS}"
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  print_spacer

  if declare -F draw_custom_grid >/dev/null; then
    draw_custom_grid
  else
    draw_default_grid
  fi

  print_spacer
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  plain_foot=" Nhập số (1-$total_valid_opts) | [00] Tìm kiếm | [0] $TEXT_BACK "
  color_foot=" ${C_YELLOW}Nhập số (1-$total_valid_opts)${C_RESET} | ${C_GREEN}[00] Tìm kiếm${C_RESET} | ${C_RED}[0] $TEXT_BACK${C_RESET} "

  len_foot=${#plain_foot}
  p_l=$(((78 - len_foot) / 2))
  ((p_l < 0)) && p_l=0
  p_r=$((78 - len_foot - p_l))
  ((p_r < 0)) && p_r=0

  printf "${MARGIN}${C_CYAN}│${C_RESET}%*s%b%*s${C_CYAN}│${C_RESET}\n" "$p_l" "" "$color_foot" "$p_r" ""
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  printf "${MARGIN}${C_CYAN}│${C_RESET}  ${C_GREEN}>>${C_RESET} ${C_BOLD_WHITE}Lựa chọn của bạn: ${C_RESET}%-55s${C_CYAN}│${C_RESET}\n" ""
  echo -e "${MARGIN}${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  margin_len=${#MARGIN}
  cursor_col=$((margin_len + 25))
  echo -en "\033[2A\033[${cursor_col}G"

  # Chống vòng lặp vô tận (100% CPU) nếu phiên Terminal bị ngắt đột ngột (EOF)
  if ! read -r choice; then
    echo -en "\033[2B\n"
    exit 0
  fi
  echo -en "\033[2B"

  choice="${choice#"${choice%%[![:space:]]*}"}"
  choice="${choice%"${choice##*[![:space:]]}"}"

  # ============================================================================
  # ĐIỀU HƯỚNG BẰNG THUẬT TOÁN O(1)
  # ============================================================================
  if [[ -z "$choice" ]]; then
    empty_msg="[!] Bạn chưa nhập gì cả. Vui lòng điền một con số rồi ấn Enter!"
    len_empty=${#empty_msg}
    pad_empty=$(((78 - len_empty) / 2))
    printf -v pad_empty_l '%*s' "$pad_empty" ""
    printf -v pad_empty_r '%*s' "$((78 - len_empty - pad_empty))" ""

    echo -e "\n${MARGIN}${C_YELLOW}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${MARGIN}${C_YELLOW}│${C_RESET}${pad_empty_l}${C_BOLD_WHITE}${empty_msg}${C_RESET}${pad_empty_r}${C_YELLOW}│${C_RESET}"
    echo -e "${MARGIN}${C_YELLOW}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    sleep 1.2
    clear
    continue

  elif [[ "$choice" == "0" ]]; then
    echo -e "\n${MARGIN}${C_YELLOW}Đang $TEXT_BACK...${C_RESET}"
    clear
    exec "$ROUTE_BACK" 1
    exit 0

  elif [[ "$choice" == "00" ]]; then
    # 1. Nếu đang ở Menu Chính -> Gọi thẳng công cụ tìm kiếm toàn cục search-wptangtoc
    if ((IS_MAIN_MENU == 1)); then
      if [[ -f /etc/wptt/search-wptangtoc ]]; then
        chmod +x /etc/wptt/search-wptangtoc 2>/dev/null || true
        exec /etc/wptt/search-wptangtoc
      elif [[ -f /etc/wptt/wptangtoc-search ]]; then
        chmod +x /etc/wptt/wptangtoc-search 2>/dev/null || true
        exec /etc/wptt/wptangtoc-search
      fi
    fi

    # 2. Nếu đang ở Menu Con -> Chạy SEO Search Engine (Không dấu + Sửa chính tả + Preview)
    if command -v fzf &>/dev/null; then
      REPLY_SUB_SELECTED=""
      _run_submenu_seo_fzf

      if [[ -n "$REPLY_SUB_SELECTED" ]]; then
        IFS=$'\t' read -r _ sel_num sel_full_title _ <<<"$REPLY_SUB_SELECTED"
        sel_num="${sel_num//[[:space:]]/}"
        if [[ "$sel_num" =~ ^[0-9]+$ ]]; then
          actual_index="${valid_indices[$((10#$sel_num - 1))]}"

          # Ghi nhận +1 điểm thói quen vào wptt_hits_search.tsv
          if [[ -n "$sel_full_title" ]]; then
            [[ -f "$HITS_FILE" ]] || : >"$HITS_FILE" 2>/dev/null
            hits_tmp="${HITS_FILE}.tmp.$$"
            if awk -F'\t' -v feat="$sel_full_title" '
                BEGIN { OFS="\t"; found=0 }
                NF >= 2 {
                  if ($1 == feat) { $2 = int($2) + 1; found=1 }
                  print $1, $2
                }
                END { if (!found) print feat, 1 }
              ' "$HITS_FILE" >"$hits_tmp" 2>/dev/null; then
              mv -f "$hits_tmp" "$HITS_FILE" 2>/dev/null || rm -f "$hits_tmp"
            else
              rm -f "$hits_tmp"
            fi
          fi

          echo -e "\n${MARGIN}${C_GREEN}>> Đang khởi chạy: ${options[$actual_index]}${C_RESET}\n"
          run_action "$actual_index"
        fi
      else
        clear
      fi
    else
      echo -e "\n${MARGIN}${C_RED}[!] Lỗi: FZF chưa được cài đặt.${C_RESET}"
      sleep 1.5
    fi

  elif [[ "$choice" =~ ^[0-9]+$ ]] && ((10#$choice >= 1 && 10#$choice <= total_valid_opts)); then
    actual_index="${valid_indices[$((10#$choice - 1))]}"
    echo -e "\n${MARGIN}${C_GREEN}>> Đang khởi chạy: ${options[$actual_index]}${C_RESET}\n"
    run_action "$actual_index"

  elif [[ -n "$choice" ]]; then
    f_word="${choice%% *}"
    if command -v "$f_word" >/dev/null 2>&1; then
      _get_cli_menu_num
      echo -e "\n${C_YELLOW}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      text_nhan_dien="Sếp đang muốn chạy lệnh CLI: $choice"
      pad1=$((76 - ${#text_nhan_dien}))
      ((pad1 < 0)) && pad1=0
      printf -v pad1_str '%*s' "$pad1" ""
      echo -e "${C_YELLOW}│${C_RESET}  ${C_BOLD_WHITE}${text_nhan_dien}${C_RESET}${pad1_str}${C_YELLOW}│${C_RESET}"

      text_huong_dan="Để gõ lệnh CLI, vào Menu ➜ $cli_menu_num (Terminal) hoặc nhấn Ctrl + C"
      len_hd=${#text_huong_dan}
      pad2=$((76 - len_hd))
      ((pad2 < 0)) && pad2=0
      printf -v pad2_str '%*s' "$pad2" ""
      echo -e "${C_YELLOW}│${C_RESET}  ${C_CYAN}${text_huong_dan}${C_RESET}${pad2_str}${C_YELLOW}│${C_RESET}"
      echo -e "${C_YELLOW}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

      echo -en "\n${C_GREEN}➜ Nhấn [Enter] để quay lại Menu...${C_RESET}"
      read -r _ || exit 0
    else
      err_msg="[!] Lựa chọn không hợp lệ. Vui lòng nhập từ 1 đến ${total_valid_opts}."
      len_err=${#err_msg}
      pad_err=$(((78 - len_err) / 2))
      printf -v pad_err_l '%*s' "$pad_err" ""
      printf -v pad_err_r '%*s' "$((78 - len_err - pad_err))" ""

      echo -e "\n${MARGIN}${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      echo -e "${MARGIN}${C_RED}│${C_RESET}${pad_err_l}${C_BOLD_WHITE}${err_msg}${C_RESET}${pad_err_r}${C_RED}│${C_RESET}"
      echo -e "${MARGIN}${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      sleep 1.5
    fi
  fi
done
