#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Engine Render & Điều hướng Menu Trung tâm (0-Subshell 2D Spatial Nav ↑↓←→ + WCAG AAA + 0ms Ctrl+C + Active DSR Heartbeat)
# @since: 2026

# ==============================================================================
# 1. KHỞI TẠO BIẾN & NẠP THƯ VIỆN GIAO DIỆN (CHỐNG NẠP CHỒNG & AN TOÀN SET -EU)
# ==============================================================================

if [[ -f "$0" ]]; then
  export WPTT_CURRENT_MENU="$0"
fi

# Lưu trạng thái TTY gốc & thiết bị PTY 1 lần duy nhất trước khi thao tác stty
WPTT_ORIG_STTY=""
WPTT_TTY_DEV=""
if [[ -t 0 && -z "${BATS_TEST_FILENAME:-}" && "${CI:-}" != "true" && "${GITHUB_ACTIONS:-}" != "true" ]]; then
  WPTT_ORIG_STTY="$(stty -g </dev/tty 2>/dev/null || stty -g 2>/dev/null || true)"
  if [[ -L "/proc/$$/fd/0" ]]; then
    WPTT_TTY_DEV="$(readlink "/proc/$$/fd/0" 2>/dev/null || true)"
  fi
fi

if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/core-functions 2>/dev/null || true
fi

if [[ -z "${ngon_ngu:-}" || -z "${tai_ma_nguon_wordpress:-}" ]]; then
  if declare -F wptt_load_main_conf &>/dev/null; then
    wptt_load_main_conf 2>/dev/null || true
  fi
  if [[ -z "${ngon_ngu:-}" ]]; then
    ngon_ngu='vi'
  fi
  # shellcheck source=/dev/null
  if [[ -r "/etc/wptt/lang/${ngon_ngu}.sh" ]]; then
    . "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null || true
  fi
fi

if ! declare -F _runing &>/dev/null; then
  # shellcheck source=/dev/null
  if [[ -r /etc/wptt/echo-color ]]; then
    . /etc/wptt/echo-color 2>/dev/null || true
  fi
fi

# Chuẩn hóa mọi biến màu từ dạng chữ '\033'/'\e' sang byte ESC thật ($'\033') (0-Subshell)
# Gọi lại sau run_action phòng trường hợp script con nạp đè /etc/wptt/echo-color
_wptt_normalize_colors() {
  : "${C_RESET:=$'\033[0m'}" \
    "${C_RED:=$'\033[1;31m'}" \
    "${C_GREEN:=$'\033[1;32m'}" \
    "${C_YELLOW:=$'\033[1;33m'}" \
    "${C_BLUE:=$'\033[1;34m'}" \
    "${C_PURPLE:=$'\033[1;35m'}" \
    "${C_CYAN:=$'\033[1;36m'}" \
    "${C_WHITE:=$'\033[0;37m'}" \
    "${C_BOLD_WHITE:=$'\033[1;97m'}"

  local esc=$'\033' cvar="" cval=""
  for cvar in C_RESET C_RED C_GREEN C_YELLOW C_BLUE C_PURPLE C_CYAN C_WHITE C_BOLD_WHITE; do
    cval="${!cvar:-}"
    if [[ -n "$cval" ]]; then
      if [[ "$cval" == *'\033'* ]]; then
        cval="${cval//\\033/$esc}"
      fi
      if [[ "$cval" == *'\e'* ]]; then
        cval="${cval//\\e/$esc}"
      fi
      printf -v "$cvar" '%s' "$cval"
    fi
  done
}
_wptt_normalize_colors

# Bảo đảm charset UTF-8 bằng Pure Bash (0-Subshell) để ${#var} đếm chuẩn ký tự Tiếng Việt
_wptt_eff_cs="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "${_wptt_eff_cs,,}" in
  *utf-8* | *utf8*) : ;;
  *)
    if [[ -n "${LC_ALL:-}" ]]; then
      export LC_ALL="C.UTF-8"
    else
      export LC_CTYPE="C.UTF-8"
    fi
    ;;
esac
unset _wptt_eff_cs

if [[ -t 0 && -z "${BATS_TEST_FILENAME:-}" && "${CI:-}" != "true" && "${GITHUB_ACTIONS:-}" != "true" ]]; then
  stty iutf8 </dev/tty 2>/dev/null || stty iutf8 2>/dev/null || true
fi
shopt -s extglob
PS3=""

# Cấu hình cầu chì chống treo / chống lặp vô tận (chịu lag SSH quốc tế)
WPTT_MENU_IDLE_SEC="${WPTT_MENU_IDLE_SEC:-3600}"   # Tự thoát nếu treo Menu không thao tác quá 1 giờ
WPTT_MAX_MENU_LOOPS="${WPTT_MAX_MENU_LOOPS:-500}"  # Chốt chặn số vòng lặp tối đa trong 1 phiên
WPTT_DSR_INTERVAL="${WPTT_DSR_INTERVAL:-30}"       # Chu kỳ gửi nhịp tim ANSI DSR khi nhàn rỗi (giây)
WPTT_DSR_TIMEOUT="${WPTT_DSR_TIMEOUT:-3.0}"        # Thời gian chờ phản hồi 1 nhịp tim DSR (giây)
WPTT_DSR_MAX_MISS="${WPTT_DSR_MAX_MISS:-3}"        # Mất 3 nhịp liên tiếp (~9s im lặng) mới kết luận đứt kết nối

# ==============================================================================
# 2. XÁC ĐỊNH ROUTE ĐIỀU HƯỚNG & NHẬN DIỆN MENU CHÍNH / MENU CON
# ==============================================================================
IS_MAIN_MENU=0
if [[ "${0##*/}" == "wptangtoc" || "${MENU_TITLE:-}" == *"WPTANGTOC OLS"* ]]; then
  IS_MAIN_MENU=1
  TEXT_BACK="Quay về Bảng theo dõi trạng thái"
  ROUTE_BACK="/etc/wptt/wptt-status2"
else
  TEXT_BACK="Quay lại Menu Chính"
  ROUTE_BACK="/usr/bin/wptangtoc"
fi

_get_cli_menu_num() {
  if [[ -n "${cli_menu_num:-}" ]]; then
    return 0
  fi
  local line="" last_num=""
  if [[ -r /usr/bin/wptangtoc ]]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*([0-9]+)\) ]]; then
        last_num="${BASH_REMATCH[1]}"
      fi
      if [[ "$line" == *"terminal-cli"* && -n "$last_num" ]]; then
        break
      fi
    done </usr/bin/wptangtoc
  fi
  cli_menu_num=$((${last_num:-36} + 1))
}

# ==============================================================================
# 3. BẪY TÍN HIỆU 0MS, KHÔI PHỤC TTY, CHỐNG MỒ CÔI & ACTIVE ANSI DSR HEARTBEAT
# ==============================================================================
# Đọc PPid và SID sống trực tiếp từ Kernel (/proc/$$/stat) bằng Pure Bash (0-Subshell)
WPTT_LIVE_PPID=0
WPTT_LIVE_SID=0
_wptt_read_proc_ids() {
  local stat_line="" after_comm="" st="" ppid="" pgrp="" sid=""
  WPTT_LIVE_PPID="${PPID:-0}"
  WPTT_LIVE_SID=0
  if [[ -r "/proc/$$/stat" ]]; then
    IFS= read -r stat_line <"/proc/$$/stat" || true
    after_comm="${stat_line##*) }"
    read -r st ppid pgrp sid _ <<<"$after_comm" || true
    if [[ "$ppid" =~ ^[0-9]+$ ]]; then
      WPTT_LIVE_PPID="$ppid"
    fi
    if [[ "$sid" =~ ^[0-9]+$ ]]; then
      WPTT_LIVE_SID="$sid"
    fi
  fi
}

_wptt_read_proc_ids
WPTT_ORIG_PPID="$WPTT_LIVE_PPID"
WPTT_ORIG_SID="$WPTT_LIVE_SID"

WPTT_DSR_CALIBRATED=0
WPTT_DSR_SUPPORTED=0
WPTT_PENDING_BUF=""
WPTT_PENDING_ESC=""
WPTT_PENDING_ENTER=0
WPTT_TTY_RAW=0
WPTT_ON_PROMPT_LINE=0

WPTT_SUB_TMPDIR=""
SUB_IDX_FILE=""
WPTT_SUB_FIFO=""
WPTT_SUB_LAST_Q=""
WPTT_SUB_AWK=""

_wptt_is_interactive_tty() {
  [[ -t 0 && -t 1 && -z "${BATS_TEST_FILENAME:-}" && "${CI:-}" != "true" && "${GITHUB_ACTIONS:-}" != "true" ]]
}

# Xóa màn hình 0-Subshell (không fork /usr/bin/clear)
_wptt_clear_screen() {
  if _wptt_is_interactive_tty; then
    printf '\033[H\033[2J\033[3J'
  fi
}

# Vào chế độ đọc phím trực tiếp: tắt echo + tắt isig để Ctrl+C trả byte 0x03 ngay 0ms
_wptt_tty_enter_raw() {
  if ! _wptt_is_interactive_tty; then
    return 0
  fi
  if ((WPTT_TTY_RAW == 0)); then
    stty -echo -isig </dev/tty 2>/dev/null || stty -echo -isig 2>/dev/null || true
    WPTT_TTY_RAW=1
  fi
}

# Khôi phục nguyên trạng TTY (chỉ chạy stty khi thực sự đang ở raw mode hoặc ép force)
_wptt_restore_tty() {
  local force="${1:-0}"
  if ! _wptt_is_interactive_tty; then
    return 0
  fi
  if ((WPTT_TTY_RAW == 0 && force == 0)); then
    return 0
  fi
  if [[ -n "${WPTT_ORIG_STTY:-}" ]]; then
    stty "$WPTT_ORIG_STTY" </dev/tty 2>/dev/null || stty "$WPTT_ORIG_STTY" 2>/dev/null || true
  else
    stty sane </dev/tty 2>/dev/null || stty sane 2>/dev/null || true
  fi
  # Luôn ép bật lại echo + icanon + isig phòng trường hợp TTY gốc vốn đã bị tắt trước đó
  stty echo icanon isig </dev/tty 2>/dev/null || stty echo icanon isig 2>/dev/null || true
  printf '\033[?25h' 2>/dev/null || true
  WPTT_TTY_RAW=0
}

_wptt_cleanup_sub_search() {
  if [[ -n "${WPTT_SUB_TMPDIR:-}" && -d "$WPTT_SUB_TMPDIR" ]]; then
    case "$WPTT_SUB_TMPDIR" in
      /etc/wptt/tmp/wptt_sub_?*)
        /bin/rm -rf -- "${WPTT_SUB_TMPDIR:?}" 2>/dev/null || true
        ;;
    esac
  fi
  WPTT_SUB_TMPDIR=""
  SUB_IDX_FILE=""
  WPTT_SUB_FIFO=""
  WPTT_SUB_LAST_Q=""
  WPTT_SUB_AWK=""
}

_wptt_on_exit() {
  _wptt_cleanup_sub_search
  _wptt_restore_tty 1
}

# Kiểm tra tiến trình cha, Session Leader và thiết bị PTY (0-subshell trước, chỉ gọi stty sau cùng)
_wptt_tty_alive() {
  if [[ -n "${BATS_TEST_FILENAME:-}" || "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    return 0
  fi

  # 1. Cha trực tiếp (>1, loại trừ LXC exec PPID=0) đã chết -> bị reparent về init/subreaper
  if ((WPTT_ORIG_PPID > 1)); then
    _wptt_read_proc_ids
    if ((WPTT_LIVE_PPID != WPTT_ORIG_PPID || WPTT_LIVE_PPID <= 1)); then
      return 1
    fi
  fi

  # 2. Session Leader (SHLVL=1 gốc) đã chết hoặc thành zombie -> thoát kể cả khi SHLVL=2 còn chờ
  if ((WPTT_ORIG_SID > 1 && WPTT_ORIG_SID != $$)); then
    if [[ ! -r "/proc/${WPTT_ORIG_SID}/stat" ]]; then
      return 1
    fi
    local sid_stat="" sid_state=""
    IFS= read -r sid_stat <"/proc/${WPTT_ORIG_SID}/stat" || return 1
    sid_state="${sid_stat##*) }"
    sid_state="${sid_state%% *}"
    if [[ "$sid_state" == "Z" || "$sid_state" == "X" ]]; then
      return 1
    fi
  fi

  # 3. Kiểm tra nhanh thiết bị PTY đã lưu (0-subshell) + xác thực ioctl TTY sống
  if [[ -n "$WPTT_TTY_DEV" && ! -c "$WPTT_TTY_DEV" ]]; then
    return 1
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    return 1
  fi
  if ! stty -g </dev/tty >/dev/null 2>&1; then
    return 1
  fi

  return 0
}

# Đọc trọn chuỗi Escape Sequence (CSI/SS3) bằng Pure Bash để không rớt byte thừa vào ô nhập
_wptt_read_esc_tail() {
  local timeout_first="${1:-0.03}"
  local c1="" c2="" i=0
  REPLY_ESC_TAIL=""

  IFS= read -rsn1 -t "$timeout_first" c1 2>/dev/null || return 0
  if [[ "$c1" == $'\x03' ]]; then
    _wptt_handle_ctrl_c_exit
  fi

  REPLY_ESC_TAIL="$c1"
  if [[ "$c1" == "[" ]]; then
    for ((i = 0; i < 20; i++)); do
      c2=""
      IFS= read -rsn1 -t 0.03 c2 2>/dev/null || break
      if [[ "$c2" == $'\x03' ]]; then
        _wptt_handle_ctrl_c_exit
      fi
      REPLY_ESC_TAIL+="$c2"
      if [[ "$c2" == [A-Za-z~@] ]]; then
        break
      fi
    done
  elif [[ "$c1" == "O" ]]; then
    IFS= read -rsn1 -t 0.03 c2 2>/dev/null || return 0
    if [[ "$c2" == $'\x03' ]]; then
      _wptt_handle_ctrl_c_exit
    fi
    REPLY_ESC_TAIL+="$c2"
  fi
  return 0
}

# Xả sạch chuỗi phản hồi DSR \033[row;colR nếu nằm kẹt sau phím người dùng vừa bấm
# Đồng thời bảo toàn toàn bộ phím gõ nhanh chen ngang vào hàng đợi WPTT_PENDING_BUF
_wptt_drain_trailing_dsr() {
  local dc="" seq="" i=0 j=0
  local dsr_re=$'^\x1b\\[[0-9]+;[0-9]+R$'

  for ((i = 0; i < 12; i++)); do
    dc=""
    IFS= read -rsn1 -t 0.15 dc </dev/tty 2>/dev/null || break
    if [[ "$dc" == $'\x03' ]]; then
      _wptt_handle_ctrl_c_exit
    fi
    if [[ "$dc" == $'\x1b' ]]; then
      seq="$dc"
      for ((j = 0; j < 24; j++)); do
        dc=""
        IFS= read -rsn1 -t 0.05 dc </dev/tty 2>/dev/null || break
        if [[ "$dc" == $'\x03' ]]; then
          _wptt_handle_ctrl_c_exit
        fi
        seq+="$dc"
        if ((j > 0)) && [[ "$dc" == [A-Za-z~@] ]]; then
          break
        fi
      done
      if [[ "$seq" =~ $dsr_re ]]; then
        return 0
      fi
      if [[ "${#seq}" -gt 1 && -z "$WPTT_PENDING_ESC" ]]; then
        WPTT_PENDING_ESC="${seq:1}"
      fi
    elif [[ -z "$dc" || "$dc" == $'\n' || "$dc" == $'\r' ]]; then
      WPTT_PENDING_ENTER=1
    else
      WPTT_PENDING_BUF+="$dc"
    fi
  done
  return 0
}

# Gửi nhịp tim ANSI DSR (\033[6n) - Pure Bash 0-Subshell, hoàn toàn vô hình khi -echo đang bật
_wptt_dsr_probe() {
  local timeout_first="${1:-$WPTT_DSR_TIMEOUT}"
  local strict_mode="${2:-0}"
  local c="" resp="" i=0 rc=0
  local dsr_re=$'^\x1b\\[[0-9]+;[0-9]+R$'

  printf '\033[6n' >/dev/tty 2>/dev/null || return 1

  IFS= read -rsn1 -t "$timeout_first" c </dev/tty 2>/dev/null || rc=$?
  if ((rc != 0)); then
    return 1
  fi

  # Bắt Ctrl+C tức thì nếu người dùng bấm đúng lúc đang gửi nhịp tim
  if [[ "$c" == $'\x03' ]]; then
    _wptt_handle_ctrl_c_exit
  fi

  if [[ "$c" == $'\x1b' ]]; then
    resp="$c"
    for ((i = 0; i < 24; i++)); do
      c=""
      IFS= read -rsn1 -t 0.15 c </dev/tty 2>/dev/null || break
      if [[ "$c" == $'\x03' ]]; then
        _wptt_handle_ctrl_c_exit
      fi
      resp+="$c"
      if ((i > 0)) && [[ "$c" == [A-Za-z~@] ]]; then
        break
      fi
    done

    if [[ "$resp" =~ $dsr_re ]]; then
      return 0
    fi

    # Không phải DSR mà là phím ESC/mũi tên người dùng bấm chen ngang -> giữ lại phím
    if [[ "${#resp}" -gt 1 ]]; then
      WPTT_PENDING_ESC="${resp:1}"
    else
      WPTT_PENDING_BUF+=$'\x1b'
    fi
    _wptt_drain_trailing_dsr
    if ((strict_mode == 1)); then
      return 2
    fi
    return 0
  fi

  # Người dùng bấm Enter hoặc phím thường đúng lúc probe -> terminal 100% đang sống, giữ lại phím
  if [[ -z "$c" || "$c" == $'\n' || "$c" == $'\r' ]]; then
    WPTT_PENDING_ENTER=1
  else
    WPTT_PENDING_BUF+="$c"
  fi
  _wptt_drain_trailing_dsr
  if ((strict_mode == 1)); then
    return 2
  fi
  return 0
}

# Hiệu chuẩn 1 lần lúc khởi động: chỉ bật DSR Heartbeat nếu terminal thật có hỗ trợ \033[6n
_wptt_dsr_calibrate() {
  if ((WPTT_DSR_CALIBRATED == 1)); then
    return 0
  fi

  if ! _wptt_is_interactive_tty || [[ "${TERM:-dumb}" == "dumb" ]]; then
    WPTT_DSR_CALIBRATED=1
    WPTT_DSR_SUPPORTED=0
    return 0
  fi

  local probe_rc=0
  _wptt_dsr_probe 0.8 1 || probe_rc=$?
  if ((probe_rc == 0)); then
    WPTT_DSR_CALIBRATED=1
    WPTT_DSR_SUPPORTED=1
  elif ((probe_rc == 2)); then
    WPTT_DSR_CALIBRATED=0
    WPTT_DSR_SUPPORTED=0
  else
    WPTT_DSR_CALIBRATED=1
    WPTT_DSR_SUPPORTED=0
  fi
}

_wptt_menu_hangup() {
  trap - SIGINT SIGTERM SIGQUIT SIGHUP SIGPIPE
  exit 129
}

# Chờ phím ngắn nhưng KHÔNG nuốt EOF/EIO khi SSH ngắt kết nối
_wptt_pause_brief() {
  local sec="${1:-1.5}" rc=0 ch=""
  if [[ ! -t 0 ]]; then
    return 0
  fi
  IFS= read -r -s -n 1 -t "$sec" ch 2>/dev/null || rc=$?
  if [[ "$ch" == $'\x03' ]]; then
    _wptt_handle_ctrl_c_exit
  fi
  # rc=0 (đã bấm phím), rc>128 (hết giờ chờ); còn lại là EOF/EIO -> thoát ngay
  if ((rc != 0 && rc <= 128)); then
    _wptt_menu_hangup
  fi
}

# Chờ nhấn Enter có kiểm tra sống TTY + DSR Heartbeat + Ctrl+C 0ms
_wptt_wait_enter() {
  local rc=0 elapsed=0 idle_probe=0 probe_miss=0 poll_sec=5 ch=""
  if ! _wptt_is_interactive_tty; then
    IFS= read -r -t "$WPTT_MENU_IDLE_SEC" _ || return 1
    return 0
  fi

  _wptt_tty_enter_raw
  while ((elapsed < WPTT_MENU_IDLE_SEC)); do
    rc=0
    IFS= read -rsn1 -t "$poll_sec" ch || rc=$?

    if ((rc == 0)); then
      if [[ -z "$ch" || "$ch" == $'\n' || "$ch" == $'\r' ]]; then
        _wptt_restore_tty
        printf '\n'
        return 0
      elif [[ "$ch" == $'\x03' ]]; then
        _wptt_handle_ctrl_c_exit
      elif [[ "$ch" == $'\x04' ]]; then
        _wptt_restore_tty
        return 1
      fi
      idle_probe=0
      probe_miss=0
      continue
    elif ((rc > 128)); then
      if ! _wptt_tty_alive; then
        _wptt_restore_tty
        return 1
      fi
      elapsed=$((elapsed + poll_sec))
      idle_probe=$((idle_probe + poll_sec))
      if ((WPTT_DSR_SUPPORTED == 1)) && ((idle_probe >= WPTT_DSR_INTERVAL || probe_miss > 0)); then
        idle_probe=0
        if _wptt_dsr_probe "$WPTT_DSR_TIMEOUT" 0; then
          probe_miss=0
          if ((WPTT_PENDING_ENTER == 1)); then
            WPTT_PENDING_ENTER=0
            WPTT_PENDING_BUF=""
            WPTT_PENDING_ESC=""
            _wptt_restore_tty
            printf '\n'
            return 0
          fi
          WPTT_PENDING_BUF=""
          WPTT_PENDING_ESC=""
        else
          probe_miss=$((probe_miss + 1))
          if ((probe_miss >= WPTT_DSR_MAX_MISS)); then
            _wptt_restore_tty
            return 1
          fi
        fi
      fi
    else
      _wptt_restore_tty
      return 1
    fi
  done
  _wptt_restore_tty
  return 1
}

_wptt_handle_ctrl_c_exit() {
  trap - SIGINT SIGTERM SIGQUIT SIGHUP SIGPIPE

  # 1. Hủy bỏ ngay bộ đếm ITIMER_REAL còn sót của read -t (chống tuyệt đối SIGALRM(14) sau exec)
  # read -t 1 </dev/null gặp EOF trong 0.05ms và tự chạy reset_alarm() -> falarm(0, 0) (0-subshell)
  trap '' ALRM
  IFS= read -r -t 1 _ </dev/null 2>/dev/null || true
  trap - ALRM

  _wptt_cleanup_sub_search
  if ! _wptt_tty_alive; then
    exit 130
  fi

  if ((WPTT_ON_PROMPT_LINE == 1)); then
    printf '\033[2B\r' 2>/dev/null || true
    WPTT_ON_PROMPT_LINE=0
  fi
  _wptt_restore_tty 1

  # 2. Nhánh SHLVL >= 2: KHÔNG gọi 'trap - EXIT' trước 'exit 0'!
  # Bash chạy unwind_protect (ttyrestore) TRƯỚC rồi mới chạy trap EXIT (_wptt_on_exit -> _wptt_restore_tty 1),
  # đảm bảo echo/icanon/isig luôn được bật lại sau cùng.
  local parent_comm=""
  _wptt_read_proc_ids
  if ((${SHLVL:-1} >= 2 && WPTT_LIVE_PPID > 1)) && [[ -r "/proc/${WPTT_LIVE_PPID}/comm" ]]; then
    IFS= read -r parent_comm <"/proc/${WPTT_LIVE_PPID}/comm" || true
  fi

  case "$parent_comm" in
    bash | sh | zsh | fish | dash | ash | ksh)
      printf '\nĐã thoát về Terminal gốc. Nhập lệnh %s1%s để quay lại.\n' "${C_GREEN}" "${C_RESET}"
      exit 0
      ;;
  esac

  # 3. Nhánh SHLVL == 1: ITIMER_REAL đã về 0, exec bash --login an toàn tuyệt đối
  trap - EXIT
  printf '\nĐã thoát. Nhập lệnh %s1%s để quay lại.\n' "${C_GREEN}" "${C_RESET}"
  export WPTT_BYPASS=1
  exec bash --login
}

_wptt_menu_ctrl_c() {
