wptt_sub_fzf_search() {
  local query="${1:-}"
  if [[ ! -s "${SUB_IDX_FILE:-}" ]]; then
    return 0
  fi

  query="${query#"${query%%[![:space:]]*}"}"
  query="${query%"${query##*[![:space:]]}"}"

  if [[ -z "$query" ]]; then
    /bin/rm -f -- "${WPTT_SUB_LAST_Q:-}" 2>/dev/null || true
    LC_ALL=C.UTF-8 awk -F'\t' '{ print $1 "\t" $2 "\t" $3 "\t" $4 "\t" }' "$SUB_IDX_FILE"
    return 0
  fi

  if [[ -s "${WPTT_SUB_LAST_Q:-}" ]]; then
    local cached_q=""
    IFS= read -r cached_q <"$WPTT_SUB_LAST_Q" || true
    if [[ "$query" == "$cached_q" ]]; then
      tail -n +2 "$WPTT_SUB_LAST_Q" 2>/dev/null || true
      return 0
    fi
  fi

  local delay="0.050"
  if ((${#query} == 1)); then
    delay="0.075"
  fi
  if [[ -p "${WPTT_SUB_FIFO:-}" ]]; then
    read -r -t "$delay" <>"$WPTT_SUB_FIFO" 2>/dev/null || true
  else
    sleep "$delay" 2>/dev/null || true
  fi

  if [[ -n "${WPTT_SUB_LAST_Q:-}" && -f "${WPTT_SUB_AWK:-}" ]]; then
    local last_q_tmp="${WPTT_SUB_LAST_Q}.tmp.$$"
    if {
      printf '%s\n' "$query"
      LC_ALL=C.UTF-8 awk -F'\t' -v q="$query" -v hits_file="${HITS_FILE:-}" -f "$WPTT_SUB_AWK" "$SUB_IDX_FILE"
    } >"$last_q_tmp" 2>/dev/null; then
      /bin/mv -fT -- "$last_q_tmp" "$WPTT_SUB_LAST_Q" 2>/dev/null || /bin/rm -f -- "$last_q_tmp" 2>/dev/null || true
    else
      /bin/rm -f -- "$last_q_tmp" 2>/dev/null || true
    fi
    tail -n +2 "$WPTT_SUB_LAST_Q" 2>/dev/null || true
  elif [[ -f "${WPTT_SUB_AWK:-}" ]]; then
    LC_ALL=C.UTF-8 awk -F'\t' -v q="$query" -v hits_file="${HITS_FILE:-}" -f "$WPTT_SUB_AWK" "$SUB_IDX_FILE"
  fi
}

wptt_sub_fzf_previewer() {
  local f_title="$1"
  local script_to_preview="$2"
  local search_query="${3:-}"

  if [[ -p "${WPTT_SUB_FIFO:-}" ]]; then
    read -r -t 0.015 <>"$WPTT_SUB_FIFO" 2>/dev/null || true
  fi

  printf '\033[1;36m⚡ %s\033[0m\n' "$f_title"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    return 0
  fi

  local alt_regex="" word="" esc_word="" i=0 ch=""
  local -a q_tokens=()
  if [[ -n "$search_query" ]]; then
    read -r -a q_tokens <<<"$search_query" || true
    for word in "${q_tokens[@]+"${q_tokens[@]}"}"; do
      if ((${#word} < 2)); then continue; fi
      esc_word=""
      for ((i = 0; i < ${#word}; i++)); do
        ch="${word:i:1}"
        case "$ch" in
          '\' | '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|') esc_word+="\\$ch" ;;
          'a' | 'A') esc_word+="(a|à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ)" ;;
          'd' | 'D') esc_word+="(d|đ)" ;;
          'e' | 'E') esc_word+="(e|è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ)" ;;
          'i' | 'I') esc_word+="(i|ì|í|ỉ|ĩ|ị)" ;;
          'o' | 'O') esc_word+="(o|ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ)" ;;
          'u' | 'U') esc_word+="(u|ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự)" ;;
          'y' | 'Y') esc_word+="(y|ỳ|ý|ỷ|ỹ|ỵ)" ;;
          *) esc_word+="$ch" ;;
        esac
      done
      if [[ -n "$alt_regex" ]]; then
        alt_regex+="|${esc_word}"
      else
        alt_regex="${esc_word}"
      fi
    done
  fi

  local active=0 line="" trimmed="" line_count=0 re=""
  if [[ -n "$alt_regex" ]]; then
    re="($alt_regex)"
  fi

  shopt -s nocasematch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" == *huong_dan*"("*")"*"{"* ]]; then
        active=1
      fi
      continue
    fi
    trimmed="${line#"${line%%[![:space:]]*}"}"
    if [[ "$trimmed" == "}"* ]]; then break; fi
    if [[ -z "$trimmed" || "$trimmed" == "EOF"* || "$trimmed" == "cat <<"* ]]; then continue; fi

    if [[ "$trimmed" == "echo "* ]]; then
      line="${trimmed#echo }"
      if [[ "$line" == -* ]]; then
        line="${line#-*([eEn]) }"
      fi
      line="${line#\"}"
      line="${line%\"}"
      line="${line#\'}"
      line="${line%\'}"
    fi

    if [[ -n "$re" && "$line" =~ $re ]]; then
      local out="" rest="$line" m_str="" prefix=""
      while [[ "$rest" =~ $re ]]; do
        m_str="${BASH_REMATCH[1]}"
        if [[ -z "$m_str" ]]; then break; fi
        prefix="${rest%%"$m_str"*}"
        out+="${prefix}"$'\033[1;33;4m'"${m_str}"$'\033[0m'
        rest="${rest#*"$m_str"}"
      done
      line="${out}${rest}"
    fi
    printf '\033[90m%s\033[0m\n' "$line"
    line_count=$((line_count + 1))
    if ((line_count >= 5)); then break; fi
  done <"$script_to_preview"
  shopt -u nocasematch
}

