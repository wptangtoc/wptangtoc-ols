# Chỉ tìm số thứ tự menu Terminal khi người dùng thực sự gõ nhầm lệnh CLI vào Menu (0 Subshell)
_get_cli_menu_num() {
  if [[ -n "${cli_menu_num:-}" ]]; then
    return 0
  fi
  local line last_num=""
  if [[ -r /usr/bin/wptangtoc ]]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*([0-9]+)\) ]]; then
        last_num="${BASH_REMATCH[1]}"
      fi
      if [[ "$line" == *"terminal-cli"* && -n "$last_num" ]]; then
        break
      fi
    done </usr/bin/wptangtoc
  fi
  cli_menu_num=$((${last_num:-36} + 1))
}

