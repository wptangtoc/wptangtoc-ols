draw_default_grid() {
  local item_count=1
  local opt="" clean_opt=""
  for opt in "${options[@]+"${options[@]}"}"; do
    if [[ "$opt" == *"───"* ]]; then
      print_spacer
      clean_opt="${opt//───/}"
