# ==============================================================================
# 1. KHỞI TẠO BIẾN & NẠP THƯ VIỆN GIAO DIỆN (CHỐNG NẠP CHỒNG)
# ==============================================================================

[[ -f "$0" ]] && export WPTT_CURRENT_MENU="$0"

if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/core-functions 2>/dev/null
fi

if [[ -z "${ngon_ngu:-}" || -z "${tai_ma_nguon_wordpress:-}" ]]; then
  # shellcheck source=/dev/null
  wptt_load_main_conf 2>/dev/null
  [[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
fi

if ! declare -F _runing &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/echo-color 2>/dev/null
fi

# Chuẩn hóa mọi biến màu từ dạng chữ '\033' sang byte ESC thật ($'\033') một lần duy nhất
_wptt_esc=$'\033'
for _cvar in C_RESET C_RED C_GREEN C_YELLOW C_BLUE C_PURPLE C_CYAN C_WHITE C_BOLD_WHITE; do
  if [[ -n "${!_cvar:-}" ]]; then
    _cval="${!_cvar}"
    _cval="${_cval//\\033/$_wptt_esc}"
    _cval="${_cval//\\e/$_wptt_esc}"
    printf -v "$_cvar" '%s' "$_cval"
  fi
done
unset _wptt_esc _cvar _cval

# Bảo đảm charset UTF-8 bằng Pure Bash (0-Subshell) để ${#var} đếm chuẩn ký tự Tiếng Việt
_wptt_eff_cs="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "${_wptt_eff_cs,,}" in
  *utf-8* | *utf8*) : ;;
  *)
    if [[ -n "${LC_ALL:-}" ]]; then
      export LC_ALL="C.UTF-8"
    else
      export LC_CTYPE="C.UTF-8"
    fi
    ;;
esac
unset _wptt_eff_cs

stty iutf8 2>/dev/null || true
shopt -s extglob
PS3=""

# Cấu hình cầu chì chống treo / chống lặp vô tận
WPTT_MENU_IDLE_SEC="${WPTT_MENU_IDLE_SEC:-3600}"   # Tự thoát nếu treo Menu không thao tác quá 1 giờ
WPTT_MAX_MENU_LOOPS="${WPTT_MAX_MENU_LOOPS:-500}"  # Chốt chặn số vòng lặp tối đa trong 1 phiên

# ==============================================================================
# 2. XÁC ĐỊNH ROUTE ĐIỀU HƯỚNG & NHẬN DIỆN MENU CHÍNH / MENU CON
# ==============================================================================
IS_MAIN_MENU=0
if [[ "${0##*/}" == "wptangtoc" || "${MENU_TITLE:-}" == *"WPTANGTOC OLS"* ]]; then
  IS_MAIN_MENU=1
  TEXT_BACK="Quay về Bảng theo dõi trạng thái"
  ROUTE_BACK="/etc/wptt/wptt-status2"
else
  TEXT_BACK="Quay lại Menu Chính"
  ROUTE_BACK="/usr/bin/wptangtoc"
fi

_get_cli_menu_num() {
  if [[ -n "${cli_menu_num:-}" ]]; then
    return 0
  fi
  local line="" last_num=""
  if [[ -r /usr/bin/wptangtoc ]]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*([0-9]+)\) ]]; then
        last_num="${BASH_REMATCH[1]}"
      fi
      if [[ "$line" == *"terminal-cli"* && -n "$last_num" ]]; then
        break
      fi
    done </usr/bin/wptangtoc
  fi
  cli_menu_num=$((${last_num:-36} + 1))
}

# ==============================================================================
# 3. BẪY TÍN HIỆU AN TOÀN (PHÂN BIỆT CTRL+C VỚI ĐỨT KẾT NỐI SSH / SIGHUP)
# ==============================================================================
SUB_IDX_FILE=""
WPTT_SUB_FIFO=""
WPTT_SUB_LAST_Q=""
WPTT_SUB_AWK=""

_wptt_cleanup_sub_search() {
  /bin/rm -f -- "${SUB_IDX_FILE:-}" "${WPTT_SUB_FIFO:-}" "${WPTT_SUB_LAST_Q:-}" "${WPTT_SUB_AWK:-}" 2>/dev/null || true
  SUB_IDX_FILE=""
  WPTT_SUB_FIFO=""
  WPTT_SUB_LAST_Q=""
  WPTT_SUB_AWK=""
}

# Khi rớt mạng SSH (SIGHUP) hoặc bị kill (SIGTERM): Thoát dứt điểm, KHÔNG gọi bash --login
_wptt_menu_hangup() {
  trap - SIGINT SIGTERM SIGQUIT SIGHUP EXIT
  _wptt_cleanup_sub_search
  exit 129
}

# Khi người dùng chủ động nhấn Ctrl+C (SIGINT): Kiểm tra TTY thật còn sống mới mở bash
_wptt_menu_ctrl_c() {
  trap - SIGINT SIGTERM SIGQUIT SIGHUP EXIT
  _wptt_cleanup_sub_search
  if [[ ! -t 0 || ! -t 1 || "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    exit 130
  fi
  if ! { : >/dev/tty; } 2>/dev/null; then
    exit 130
  fi
  stty sane 2>/dev/null || true
  printf '\033[?25h' 2>/dev/null || true
  tput cnorm 2>/dev/null || true
  echo -e "\n\nĐã thoát. Nhập lệnh ${C_GREEN}1${C_RESET} để quay lại."
  export WPTT_BYPASS=1
  exec bash --login
}
trap '_wptt_cleanup_sub_search' EXIT
trap '_wptt_menu_hangup' SIGHUP SIGTERM SIGQUIT
trap '_wptt_menu_ctrl_c' SIGINT

# ==============================================================================
# 4. ENGINE VẼ GIAO DIỆN & BẢNG MÀU CHUẨN WCAG 2.1 AAA (100% NATIVE BASH - 0 SUBSHELL)
# ==============================================================================
MARGIN=""
calc_margin() { MARGIN=""; }

WPTT_RENDER_LINE=0
WPTT_ACTIVE_HL=0
declare -a WPTT_ITEM_LINE=()
declare -a WPTT_ITEM_COL=()
declare -a WPTT_ITEM_NORM=()
declare -a WPTT_ITEM_HL=()
declare -a WPTT_ITEM_LABEL=()

WPTT_HL_THEME="${WPTT_HL_THEME:-navy}"

case "$WPTT_HL_THEME" in
  amber)
    C_HL_BG=$'\033[48;5;220;38;5;16;1m'
    C_HL_NUM=$'\033[48;5;220;38;5;16;1m'
    ;;
  emerald)
    C_HL_BG=$'\033[48;5;22;48;2;0;58;0;38;5;231;1m'
    C_HL_NUM=$'\033[48;5;22;48;2;0;58;0;38;5;226;1m'
    ;;
  *)
    C_HL_BG=$'\033[48;5;18;48;2;0;43;92;38;5;231;1m'
    C_HL_NUM=$'\033[48;5;18;48;2;0;43;92;38;5;226;1m'
    ;;
esac

C_AAA_WHITE=$'\033[1;97m'          # Trắng tinh khiết (16.5:1)
C_AAA_YELLOW=$'\033[1;38;5;226m'   # Vàng chanh sáng (14.8:1)
C_AAA_GREEN=$'\033[1;38;5;83m'     # Xanh lục bảo sáng (11.4:1)
C_AAA_RED=$'\033[1;38;5;210m'      # Đỏ Coral sáng (7.8:1)
C_AAA_CYAN=$'\033[1;38;5;117m'     # Xanh da trời sáng (10.6:1)

_strip_ansi() {
  local s="$1"
  local esc=$'\x1B'
  [[ "$s" == *'\033'* ]] && s="${s//\\033/$esc}"
  [[ "$s" == *'\e'* ]] && s="${s//\\e/$esc}"
  if [[ "$s" != *"$esc"* ]]; then
    REPLY_PLAIN="$s"
    return 0
  fi
  REPLY_PLAIN="${s//${esc}\[*([0-9;?])[@-~]/}"
}

print_row() {
  local l_num="$1" l_text="$2" r_num="$3" r_text="$4"
  local c1_plain="" c1_color="" c2_plain="" c2_color=""
  local num_fmt="" pad_l=0 pad_r=0 cell_pad=""
  local REPLY_PLAIN=""

  if [[ -n "$l_text" ]]; then
    _strip_ansi "$l_text"
    l_text="$REPLY_PLAIN"
    if [[ -z "$l_num" ]]; then
      c1_plain="  ▶ ${l_text}"
      ((${#c1_plain} > 36)) && c1_plain="${c1_plain:0:34}.."
      c1_color="  ${C_AAA_YELLOW}▶ ${C_AAA_WHITE}${c1_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$l_num"
      c1_plain="  [$num_fmt] ${l_text}"
      ((${#c1_plain} > 36)) && c1_plain="${c1_plain:0:34}.."
      c1_color="  ${C_GREEN}[$num_fmt]${C_RESET} ${C_CYAN}${c1_plain:7}${C_RESET}"
    fi
  fi

  if [[ -n "$r_text" ]]; then
    _strip_ansi "$r_text"
    r_text="$REPLY_PLAIN"
    if [[ -z "$r_num" ]]; then
      c2_plain="  ▶ ${r_text}"
      ((${#c2_plain} > 36)) && c2_plain="${c2_plain:0:34}.."
      c2_color="  ${C_AAA_YELLOW}▶ ${C_AAA_WHITE}${c2_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$r_num"
      c2_plain="  [$num_fmt] ${r_text}"
      ((${#c2_plain} > 36)) && c2_plain="${c2_plain:0:34}.."
      c2_color="  ${C_GREEN}[$num_fmt]${C_RESET} ${C_CYAN}${c2_plain:7}${C_RESET}"
    fi
  fi

  pad_l=$((37 - ${#c1_plain}))
  ((pad_l < 0)) && pad_l=0
  pad_r=$((37 - ${#c2_plain}))
  ((pad_r < 0)) && pad_r=0

  if [[ -n "$l_num" && "$l_num" =~ ^[0-9]+$ ]]; then
    local idx_l=$((10#$l_num))
    printf -v num_fmt "%2s" "$l_num"
    printf -v cell_pad '%*s' "$pad_l" ""
    WPTT_ITEM_LINE[idx_l]=$WPTT_RENDER_LINE
    WPTT_ITEM_COL[idx_l]=$(( ${#MARGIN} + 3 ))
    WPTT_ITEM_NORM[idx_l]="${c1_color}${cell_pad}"
    WPTT_ITEM_HL[idx_l]="${C_HL_NUM} ❯[$num_fmt]${C_HL_BG} ${c1_plain:7}${cell_pad}${C_RESET}"
    WPTT_ITEM_LABEL[idx_l]="${l_text}"
  fi

  if [[ -n "$r_num" && "$r_num" =~ ^[0-9]+$ ]]; then
    local idx_r=$((10#$r_num))
    printf -v num_fmt "%2s" "$r_num"
    printf -v cell_pad '%*s' "$pad_r" ""
    WPTT_ITEM_LINE[idx_r]=$WPTT_RENDER_LINE
    WPTT_ITEM_COL[idx_r]=$(( ${#MARGIN} + 42 ))
    WPTT_ITEM_NORM[idx_r]="${c2_color}${cell_pad}"
    WPTT_ITEM_HL[idx_r]="${C_HL_NUM} ❯[$num_fmt]${C_HL_BG} ${c2_plain:7}${cell_pad}${C_RESET}"
    WPTT_ITEM_LABEL[idx_r]="${r_text}"
  fi

  printf "${MARGIN}${C_CYAN}│${C_RESET} %b%*s  %b%*s ${C_CYAN}│${C_RESET}\n" "$c1_color" "$pad_l" "" "$c2_color" "$pad_r" ""
  ((WPTT_RENDER_LINE++))
}

print_full_row() {
  local index="$1"
  local text="$2"
  local box_inner_width=78
  local REPLY_PLAIN=""
  local clean_len=0 pad=0 pad_str="" formatted_index=""

  _strip_ansi "$text"

  if [[ -z "$index" ]]; then
    clean_len=$((5 + ${#REPLY_PLAIN}))
    pad=$((box_inner_width - clean_len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_AAA_YELLOW}▶${C_RESET} ${C_AAA_WHITE}${REPLY_PLAIN^^}${C_RESET}${pad_str}${C_CYAN}│${C_RESET}"
  else
    printf -v formatted_index "%2s" "$index"
    clean_len=$((3 + ${#formatted_index} + 3 + ${#REPLY_PLAIN}))
    pad=$((box_inner_width - clean_len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    if [[ "$index" =~ ^[0-9]+$ ]]; then
      local idx_f=$((10#$index))
      local norm_str="   ${C_GREEN}[${formatted_index}]${C_RESET} ${C_CYAN}${REPLY_PLAIN}${C_RESET}${pad_str}"
      local hl_pad=$((pad - 1))
      ((hl_pad < 0)) && hl_pad=0
      local hl_pad_str=""
      printf -v hl_pad_str '%*s' "$hl_pad" ""
      WPTT_ITEM_LINE[idx_f]=$WPTT_RENDER_LINE
      WPTT_ITEM_COL[idx_f]=$(( ${#MARGIN} + 2 ))
      WPTT_ITEM_NORM[idx_f]="$norm_str"
      WPTT_ITEM_HL[idx_f]=" ${C_HL_NUM} ❯[${formatted_index}]${C_HL_BG} ${REPLY_PLAIN}${hl_pad_str}${C_RESET} "
      WPTT_ITEM_LABEL[idx_f]="$REPLY_PLAIN"
    fi

    echo -e "${MARGIN}${C_CYAN}│${C_RESET}   ${C_GREEN}[${formatted_index}]${C_RESET} ${C_CYAN}${REPLY_PLAIN}${C_RESET}${pad_str}${C_CYAN}│${C_RESET}"
  fi
  ((WPTT_RENDER_LINE++))
}

print_header() {
  local text="${1:-TRUNG TÂM QUẢN TRỊ WPTANGTOC OLS}"
  local REPLY_PLAIN=""
  _strip_ansi "$text"
  local len=${#REPLY_PLAIN}
  local p_left=$(((78 - len) / 2))
  ((p_left < 0)) && p_left=0
  local p_right=$((78 - len - p_left))
  ((p_right < 0)) && p_right=0
  printf "${MARGIN}${C_CYAN}│${C_RESET}%*s${C_AAA_WHITE}%b${C_RESET}%*s${C_CYAN}│${C_RESET}\n" "$p_left" "" "$text" "$p_right" ""
  ((WPTT_RENDER_LINE++))
}

print_spacer() {
  printf "${MARGIN}${C_CYAN}│%78s│${C_RESET}\n" ""
  ((WPTT_RENDER_LINE++))
}

draw_default_grid() {
  local item_count=1
  local opt="" clean_opt=""
  for opt in "${options[@]}"; do
    if [[ "$opt" == *"───"* ]]; then
      print_spacer
      clean_opt="${opt//───/}"
      clean_opt="${clean_opt//\[/}"
      clean_opt="${clean_opt//\]/}"
      clean_opt="${clean_opt#"${clean_opt%%[![:space:]]*}"}"
      clean_opt="${clean_opt%"${clean_opt##*[![:space:]]}"}"
      print_row "" "$clean_opt" "" ""
    else
      print_row "$item_count" "$opt" "" ""
      ((item_count++))
    fi
  done
}

# ==============================================================================
# 4A. ENGINE NHẬP LIỆU TƯƠNG TÁC TRỰC TIẾP (100% NATIVE TERMINAL CURSOR)
# ==============================================================================
_wptt_update_live_prompt() {
  local buf="$1"
  local prompt_line="$2"
  local prev_hl="$3"
  local new_hl=0
  local status_text=""
  local max_right_cols=45

  if [[ -z "$buf" ]]; then
    status_text="${C_CYAN}← Gõ số hoặc bấm phím ${C_AAA_YELLOW}↑↓${C_CYAN} để chọn${C_RESET}"
  elif [[ "$buf" =~ ^[0-9]+$ ]]; then
    if [[ "$buf" == "0" ]]; then
      local back_lbl="$TEXT_BACK"
      ((${#back_lbl} > 28)) && back_lbl="${back_lbl:0:26}.."
      status_text="${C_AAA_RED}→ [0] ${C_AAA_WHITE}${back_lbl} ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
    elif [[ "$buf" == "00" ]]; then
      status_text="${C_AAA_GREEN}→ [00] ${C_AAA_WHITE}Mở công cụ Tìm kiếm ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
    else
      local num_val=$((10#$buf))
      if ((num_val >= 1 && num_val <= total_valid_opts)); then
        new_hl=$num_val
        local lbl="${WPTT_ITEM_LABEL[num_val]:-}"
        if [[ -z "$lbl" ]]; then
          local act_idx="${valid_indices[$((num_val - 1))]}"
          local REPLY_PLAIN=""
          _strip_ansi "${options[$act_idx]}"
          lbl="$REPLY_PLAIN"
        fi
        local max_lbl=$((max_right_cols - 15 - ${#num_val}))
        if (( ${#lbl} > max_lbl )); then
          lbl="${lbl:0:$((max_lbl - 2))}.."
        fi
        status_text="${C_AAA_GREEN}→ [${num_val}] ${C_AAA_WHITE}${lbl} ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
      else
        status_text="${C_AAA_RED}→ [!] Ngoài phạm vi (1-${total_valid_opts})${C_RESET}"
      fi
    fi
  else
    local short_b="$buf"
    ((${#short_b} > 30)) && short_b="${short_b:0:28}.."
    status_text="${C_AAA_YELLOW}→ Lệnh: ${C_AAA_WHITE}${short_b}${C_RESET}"
  fi

  local out_seq=""

  # 1. Trả lại màu bình thường cho mục cũ
  if ((prev_hl > 0 && prev_hl != new_hl)); then
    local old_line="${WPTT_ITEM_LINE[prev_hl]:-}"
    local old_col="${WPTT_ITEM_COL[prev_hl]:-}"
    local old_norm="${WPTT_ITEM_NORM[prev_hl]:-}"
    if [[ -n "$old_line" && -n "$old_norm" ]]; then
      local up_old=$((prompt_line - old_line))
      out_seq+=$'\033['"${up_old}A"$'\033['"${old_col}G${old_norm}"$'\033['"${up_old}B"
    fi
  fi

  # 2. Tô sáng mục mới chuẩn WCAG AAA trên bảng Menu
  if ((new_hl > 0 && new_hl != prev_hl)); then
    local cur_line="${WPTT_ITEM_LINE[new_hl]:-}"
    local cur_col="${WPTT_ITEM_COL[new_hl]:-}"
    local cur_hl="${WPTT_ITEM_HL[new_hl]:-}"
    if [[ -n "$cur_line" && -n "$cur_hl" ]]; then
      local up_cur=$((prompt_line - cur_line))
      out_seq+=$'\033['"${up_cur}A"$'\033['"${cur_col}G${cur_hl}"$'\033['"${up_cur}B"
    fi
  fi

  # 3. Dựng ô Input [11    ] sạch sẽ và đặt Con trỏ gốc của Terminal vào đúng vị trí
  local disp_buf="$buf"
  ((${#disp_buf} > 6)) && disp_buf="${disp_buf:0:6}"
  local len_b=${#disp_buf}
  local box_val=""
  printf -v box_val "%-6s" "$disp_buf"

  local box_color="${C_AAA_GREEN}"
  [[ "$buf" == "0" || "$buf" == "00" ]] && box_color="${C_AAA_YELLOW}"

  local left_border_col=$(( ${#MARGIN} + 1 ))
  local right_border_col=$(( ${#MARGIN} + 80 ))
  local input_cursor_col=$(( ${#MARGIN} + 26 + len_b ))

  out_seq+=$'\033[2K\033['"${left_border_col}G${C_CYAN}│${C_RESET}  ${C_AAA_GREEN}>>${C_RESET} ${C_AAA_WHITE}Lựa chọn của bạn:${C_RESET} ${box_color}[${C_AAA_YELLOW}${box_val}${box_color}]${C_RESET} ${status_text}"$'\033['"${right_border_col}G${C_CYAN}│${C_RESET}"
  out_seq+=$'\033['"${input_cursor_col}G"$'\033[?25h'

  # Nếu ghi ra TTY thất bại (đứt kết nối EIO), báo lỗi để thoát vòng lặp ngay
  printf '%b' "$out_seq" 2>/dev/null || return 1
  WPTT_ACTIVE_HL=$new_hl
  return 0
}

_wptt_read_interactive_choice() {
  local prompt_line="$1"
  choice=""
  WPTT_ACTIVE_HL=0

  # Nếu không phải TTY tương tác thật (VD: chạy trong BATS test / Pipe), dùng read chuẩn
  if [[ ! -t 0 || ! -t 1 || -n "${BATS_TEST_FILENAME:-}" || "${CI:-}" == "true" ]]; then
    if ! IFS= read -r -t "$WPTT_MENU_IDLE_SEC" choice; then
      return 1
    fi
    return 0
  fi

  # Vẽ ô nhập liệu trống ban đầu; nếu lỗi ghi TTY thì thoát ngay
  _wptt_update_live_prompt "" "$prompt_line" 0 || return 1

  local char="" rest="" key_guard=0
  while ((++key_guard < 4096)); do
    # Có Idle Timeout (mặc định 3600s): nếu treo máy bỏ quên hoặc mất TTY sẽ tự trả về != 0 và thoát
    if ! IFS= read -rsn1 -t "$WPTT_MENU_IDLE_SEC" char; then
      return 1
    fi

    # 1. Phím Enter (Kết thúc nhập)
    if [[ -z "$char" || "$char" == $'\n' || "$char" == $'\r' ]]; then
      return 0
    fi

    # 2. Phím Backspace / Delete
    if [[ "$char" == $'\x7f' || "$char" == $'\x08' || "$char" == $'\b' ]]; then
      if [[ -n "$choice" ]]; then
        choice="${choice%?}"
        _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
      fi
      continue
    fi

    # 3. Ctrl+C hoặc Ctrl+D
    if [[ "$char" == $'\x03' ]]; then
      _wptt_menu_ctrl_c
    elif [[ "$char" == $'\x04' ]]; then
      return 1
    fi

    # 4. Phím Escape / Phím mũi tên ↑ ↓ ← → để di chuyển vùng sáng trực tiếp
    if [[ "$char" == $'\x1b' || "$char" == $'\e' ]]; then
      rest=""
      IFS= read -rsn2 -t 0.03 rest 2>/dev/null || true
      case "$rest" in
        '[B' | '[C')
          local next_n=$((WPTT_ACTIVE_HL + 1))
          ((next_n > total_valid_opts)) && next_n=1
          choice="$next_n"
          _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          ;;
        '[A' | '[D')
          local prev_n=$((WPTT_ACTIVE_HL - 1))
          ((prev_n < 1)) && prev_n=$total_valid_opts
          choice="$prev_n"
          _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          ;;
        '')
          if [[ -n "$choice" ]]; then
            choice=""
            _wptt_update_live_prompt "" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
      esac
      continue
    fi

    # 5. Ký tự in được thông thường (Số hoặc chữ lệnh CLI)
    if (( ${#choice} < 32 )) && [[ "$char" =~ [[:print:]] ]]; then
      choice+="$char"
      _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
    fi
  done

  # Chốt chặn: nếu vượt quá 4096 ký tự trong 1 lần nhập (kẹt phím / flood I/O) -> Báo lỗi thoát
