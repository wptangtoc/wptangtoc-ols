      gsub(/à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ|À|Á|Ả|Ã|Ạ|Ă|Ằ|Ắ|Ẳ|Ẵ|Ặ|Â|Ầ|Ấ|Ẩ|Ẫ|Ậ/, "a", s)
      gsub(/đ|Đ/, "d", s)
      gsub(/è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ|È|É|Ẻ|Ẽ|Ẹ|Ê|Ề|Ế|Ể|Ễ|Ệ/, "e", s)
      gsub(/ì|í|ỉ|ĩ|ị|Ì|Í|Ỉ|Ĩ|Ị/, "i", s)
      gsub(/ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ|Ò|Ó|Ỏ|Õ|Ọ|Ô|Ồ|Ố|Ổ|Ỗ|Ộ|Ơ|Ờ|Ớ|Ở|Ỡ|Ợ/, "o", s)
      gsub(/ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự|Ù|Ú|Ủ|Ũ|Ụ|Ư|Ừ|Ứ|Ử|Ữ|Ự/, "u", s)
      gsub(/ỳ|ý|ỷ|ỹ|ỵ|Ỳ|Ý|Ỷ|Ỹ|Ỵ/, "y", s)
      return s
    }
    function calc_base_hot(opt_a,    h) {
      h = 50
      if (opt_a == "them domain && subdomain" || opt_a == "them domain") h = 1
      else if (opt_a == "tai ma nguon wordpress" || index(opt_a, "tai ma nguon wordpress") == 1) h = 2
      else if (index(opt_a, "quet ma doc") == 1 || index(opt_a, "sao luu") == 1 || index(opt_a, "khoi phuc") == 1) h = 5
      else if (index(opt_a, "cai dat ssl") == 1 || index(opt_a, "xoa domain") == 1 || index(opt_a, "phan quyen domain") == 1) h = 8
      else if (index(opt_a, "xoa toan bo cache") == 1 || index(opt_a, "xoa cache") == 1 || index(opt_a, "khoi dong lai") == 1) h = 10
      else if (index(opt_a, "chinh sua vhost") == 1 || index(opt_a, "chinh sua php") == 1 || index(opt_a, "doi mat khau") == 1) h = 12
      else if (index(opt_a, "tao swap") == 1 || index(opt_a, "xoa swap") == 1 || index(opt_a, "nhan ban") == 1) h = 15
      return h
    }
    BEGIN {
      if (g_idx != "") {
        while ((getline gline < g_idx) > 0) {
          split(gline, gp, "\t")
          if (gp[7] != "" && !(gp[7] in map_full)) {
            map_full[gp[7]] = gp[1]
            map_script[gp[7]] = gp[2]
            map_hot[gp[7]] = gp[3]
            map_doc[gp[7]] = gp[11]
          }
        }
        close(g_idx)
      }
    }
    {
      num = $1
      opt_plain = $2
      disp = sprintf("%2d. %s", num, opt_plain)
      opt_norm = norm_vn(opt_plain)
      opt_ascii = strip_vn(opt_norm)

      full_t = (opt_norm in map_full) ? map_full[opt_norm] : opt_plain
      script_p = (opt_norm in map_script) ? map_script[opt_norm] : ""
      base_hot = (opt_norm in map_hot) ? int(map_hot[opt_norm]) : calc_base_hot(opt_ascii)
      d_ascii = (opt_norm in map_doc) ? map_doc[opt_norm] : ""

      opt_len = length(opt_ascii)
      if (opt_len > 999) opt_len = 999

      t_words = opt_ascii
      gsub(/[^a-z0-9]+/, " ", t_words)
      gsub(/^ +| +$/, "", t_words)

      print disp, num, full_t, script_p, base_hot, opt_len, opt_norm, opt_ascii, d_ascii, t_words
    }
  ' < <(printf '%s\n' "${raw_sub_lines[@]}") >"$SUB_IDX_FILE" 2>/dev/null

  local -a sub_init_lines=()
  local f_disp="" f_num="" f_full="" f_script=""
  while IFS=$'\t' read -r f_disp f_num f_full f_script _; do
    if [[ -z "$f_disp" ]]; then continue; fi
    sub_init_lines+=("${f_disp}"$'\t'"${f_num}"$'\t'"${f_full}"$'\t'"${f_script}"$'\t')
  done <"$SUB_IDX_FILE"

  REPLY_SUB_SELECTED=""
  trap '' SIGINT
  if ((${#sub_init_lines[@]} > 0)); then
    REPLY_SUB_SELECTED="$(
      SHELL=/bin/bash fzf \
        --ansi \
        --disabled \
        --bind 'change:reload:wptt_sub_fzf_search {q}' \
        --prompt="🔍 Tìm kiếm trong Menu này > " \
        --height='~55%' \
        --border=rounded \
        --color=border:cyan \
        --layout=reverse \
        --cycle \
        --with-nth=1 \
        --delimiter=$'\t' \
        --header="Gõ từ khóa | ESC hủy" \
        --preview='wptt_sub_fzf_previewer {3} {4} {5}' \
        --preview-window=up:4:wrap < <(printf '%s\n' "${sub_init_lines[@]}")
    )" || true
  fi
  _wptt_arm_traps

  export -n SUB_IDX_FILE WPTT_SUB_FIFO WPTT_SUB_LAST_Q WPTT_SUB_AWK 2>/dev/null || true
  export -nf wptt_sub_fzf_search wptt_sub_fzf_previewer 2>/dev/null || true
  _wptt_cleanup_sub_search
  _wptt_tty_alive || _wptt_menu_hangup
}

_wptt_record_search_hit() {
  local feat="$1"
  if [[ -z "$feat" ]]; then
    return 0
  fi

  /bin/mkdir -p -m 0700 /etc/wptt/tmp 2>/dev/null || return 0
  local hits_file="/etc/wptt/tmp/wptt_hits_search.tsv"
  if [[ ! -f "$hits_file" ]]; then
    : >"$hits_file" 2>/dev/null || return 0
    /bin/chmod 0600 -- "$hits_file" 2>/dev/null || true
  fi

  local hits_tmp=""
  hits_tmp="$(mktemp -p /etc/wptt/tmp "wptt_hits_XXXXXX.tmp" 2>/dev/null || true)"
  if [[ -z "$hits_tmp" ]]; then
    return 0
  fi

  if awk -F'\t' -v feat="$feat" '
      BEGIN { OFS="\t"; found=0 }
      NF >= 2 {
        if ($1 == feat) { $2 = int($2) + 1; found=1 }
        print $1, $2
      }
      END { if (!found) print feat, 1 }
    ' "$hits_file" >"$hits_tmp" 2>/dev/null; then
    /bin/chmod 0600 -- "$hits_tmp" 2>/dev/null || true
    /bin/mv -fT -- "$hits_tmp" "$hits_file" 2>/dev/null || /bin/rm -f -- "$hits_tmp" 2>/dev/null || true
  else
    /bin/rm -f -- "$hits_tmp" 2>/dev/null || true
  fi
}

# ==============================================================================
# 5. TIỀN XỬ LÝ (O(1) MAPPING) - TỐI ƯU SIÊU TỐC
# ==============================================================================
valid_indices=()
for i in "${!options[@]}"; do
  if [[ "${options[$i]}" != *"───"* ]]; then
    valid_indices+=("$i")
  fi
done
total_valid_opts=${#valid_indices[@]}

# ==============================================================================
# 6. VÒNG LẶP DASHBOARD CHÍNH (HARD-CAPPED LOOP + 0MS CTRL+C + DSR HEARTBEAT)
# ==============================================================================
_wptt_menu_loop_guard=0

while ((_wptt_menu_loop_guard < WPTT_MAX_MENU_LOOPS)); do
  _wptt_menu_loop_guard=$((_wptt_menu_loop_guard + 1))

  _wptt_tty_alive || break
  WPTT_ON_PROMPT_LINE=0
  _wptt_tty_enter_raw
  calc_margin

  WPTT_RENDER_LINE=0
  WPTT_HAS_TWO_COLS=0
  WPTT_ITEM_LINE=()
  WPTT_ITEM_COL=()
  WPTT_ITEM_SIDE=()
  WPTT_ITEM_PEER=()
  WPTT_ITEM_NORM=()
  WPTT_ITEM_HL=()
  WPTT_ITEM_LABEL=()

  printf '%s%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n' "$MARGIN" "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
  print_header "${MENU_TITLE:-TRUNG TÂM QUẢN TRỊ WPTANGTOC OLS}"
  printf '%s%s├──────────────────────────────────────────────────────────────────────────────┤%s\n' "$MARGIN" "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
  print_spacer

  if declare -F draw_custom_grid >/dev/null; then
    draw_custom_grid
  else
    draw_default_grid
  fi

  print_spacer
  printf '%s%s├──────────────────────────────────────────────────────────────────────────────┤%s\n' "$MARGIN" "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))

  plain_foot=" Nhập số (1-${total_valid_opts}) | [00] Tìm kiếm | [0] ${TEXT_BACK} "
  color_foot=" ${C_AAA_WHITE}Nhập số (1-${total_valid_opts})${C_RESET} │ ${C_AAA_GREEN}[00] Tìm kiếm${C_RESET} │ ${C_AAA_RED}[0] ${TEXT_BACK}${C_RESET} "

  len_foot=${#plain_foot}
  p_l=$(((78 - len_foot) / 2))
  if ((p_l < 0)); then p_l=0; fi
  p_r=$((78 - len_foot - p_l))
  if ((p_r < 0)); then p_r=0; fi

  printf '%s%s│%s%*s%s%*s%s│%s\n' "$MARGIN" "$C_CYAN" "$C_RESET" "$p_l" "" "$color_foot" "$p_r" "" "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
  printf '%s%s├──────────────────────────────────────────────────────────────────────────────┤%s\n' "$MARGIN" "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))

  PROMPT_ROW_IDX=$WPTT_RENDER_LINE
  printf '%s%s│%s  %s>>%s %sLựa chọn của bạn:%s %-55s%s│%s\n' \
    "$MARGIN" "$C_CYAN" "$C_RESET" \
    "$C_AAA_GREEN" "$C_RESET" \
    "$C_AAA_WHITE" "$C_RESET" "" \
    "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
  printf '%s%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n' "$MARGIN" "$C_CYAN" "$C_RESET"

  margin_len=${#MARGIN}
  cursor_col=$((margin_len + 26))
  if _wptt_is_interactive_tty; then
    printf '\033[2A\033[%dG' "$cursor_col"
    WPTT_ON_PROMPT_LINE=1
  fi

  # ============================================================================
  # XỬ LÝ TYPEAHEAD BUFFERING, HIỆU CHUẨN DSR & ĐỌC PHÍM 4 CHIỀU (↑ ↓ ← →)
  # ============================================================================
  if declare -F wptt_flush_stdin >/dev/null; then
    wptt_flush_stdin
  fi

  _wptt_dsr_calibrate

  if ! _wptt_read_interactive_choice "$PROMPT_ROW_IDX"; then
    if ((WPTT_ON_PROMPT_LINE == 1)); then
      printf '\033[2B\n' 2>/dev/null || true
      WPTT_ON_PROMPT_LINE=0
    fi
    _wptt_restore_tty
    exit 0
  fi

  if ((WPTT_ON_PROMPT_LINE == 1)); then
    printf '\033[2B\r'
    WPTT_ON_PROMPT_LINE=0
  fi
  _wptt_restore_tty

  choice="${choice#"${choice%%[![:space:]]*}"}"
  choice="${choice%"${choice##*[![:space:]]}"}"

  # ============================================================================
  # ĐIỀU HƯỚNG BẰNG THUẬT TOÁN O(1)
  # ============================================================================
  if [[ -z "$choice" ]]; then
    empty_msg="[!] Bạn chưa nhập gì cả. Vui lòng điền một con số rồi ấn Enter!"
    len_empty=${#empty_msg}
    pad_empty=$(((78 - len_empty) / 2))
    if ((pad_empty < 0)); then pad_empty=0; fi
    pad_empty_r_len=$((78 - len_empty - pad_empty))
    if ((pad_empty_r_len < 0)); then pad_empty_r_len=0; fi
    printf -v pad_empty_l '%*s' "$pad_empty" ""
    printf -v pad_empty_r '%*s' "$pad_empty_r_len" ""

    printf '\n%s%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n' "$MARGIN" "$C_YELLOW" "$C_RESET"
    printf '%s%s│%s%s%s%s%s%s%s│%s\n' "$MARGIN" "$C_YELLOW" "$C_RESET" "$pad_empty_l" "$C_AAA_WHITE" "$empty_msg" "$C_RESET" "$pad_empty_r" "$C_YELLOW" "$C_RESET"
    printf '%s%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n' "$MARGIN" "$C_YELLOW" "$C_RESET"
    _wptt_pause_brief 1.2
    _wptt_clear_screen
    continue

  elif [[ "$choice" == "0" ]]; then
    trap - EXIT
    _wptt_cleanup_sub_search
    _wptt_restore_tty 1
    _wptt_clear_screen
    exec "$ROUTE_BACK" 1
    exit 0

  elif [[ "$choice" == "00" ]]; then
    if ((IS_MAIN_MENU == 1)); then
      if [[ -f /etc/wptt/search-wptangtoc ]]; then
        trap - EXIT
        _wptt_cleanup_sub_search
        _wptt_restore_tty 1
        /bin/chmod +x /etc/wptt/search-wptangtoc 2>/dev/null || true
        exec /etc/wptt/search-wptangtoc
      fi
    fi

    if command -v fzf &>/dev/null; then
      REPLY_SUB_SELECTED=""
      _run_submenu_seo_fzf || true

      if [[ -n "$REPLY_SUB_SELECTED" ]]; then
        IFS=$'\t' read -r _ sel_num sel_full_title _ <<<"$REPLY_SUB_SELECTED"
        sel_num="${sel_num//[[:space:]]/}"
        if [[ "$sel_num" =~ ^[0-9]+$ && "${#sel_num}" -le 6 ]] && ((10#$sel_num >= 1 && 10#$sel_num <= total_valid_opts)); then
          actual_index="${valid_indices[$((10#$sel_num - 1))]}"
          _wptt_record_search_hit "$sel_full_title"
          printf '\n%s%s>> Đang khởi chạy: %s%s\n\n' "$MARGIN" "$C_AAA_GREEN" "${options[$actual_index]}" "$C_RESET"
          _wptt_restore_tty
          run_action "$actual_index"
          _wptt_normalize_colors
          _wptt_arm_traps
        fi
      else
        _wptt_clear_screen
      fi
    else
      printf '\n%s%s[!] Lỗi: FZF chưa được cài đặt.%s\n' "$MARGIN" "$C_AAA_RED" "$C_RESET"
      _wptt_pause_brief 1.5
    fi

  elif [[ "$choice" =~ ^[0-9]+$ && "${#choice}" -le 6 ]] && ((10#$choice >= 1 && 10#$choice <= total_valid_opts)); then
    actual_index="${valid_indices[$((10#$choice - 1))]}"
    printf '\n%s%s>> Đang khởi chạy: %s%s\n\n' "$MARGIN" "$C_AAA_GREEN" "${options[$actual_index]}" "$C_RESET"
    _wptt_restore_tty
    run_action "$actual_index"
    _wptt_normalize_colors
    _wptt_arm_traps

  elif [[ -n "$choice" ]]; then
    f_word="${choice%% *}"
    if [[ "$f_word" != -* ]] && command -v -- "$f_word" >/dev/null 2>&1; then
      _get_cli_menu_num
      text_nhan_dien="Sếp đang muốn chạy lệnh CLI: ${choice}"
      if ((${#text_nhan_dien} > 74)); then
        text_nhan_dien="${text_nhan_dien:0:72}.."
      fi
      pad1=$((76 - ${#text_nhan_dien}))
      if ((pad1 < 0)); then pad1=0; fi
      printf -v pad1_str '%*s' "$pad1" ""

      text_huong_dan="Để gõ lệnh CLI, vào Menu ➜ ${cli_menu_num} (Terminal) hoặc nhấn Ctrl + C"
      pad2=$((76 - ${#text_huong_dan}))
      if ((pad2 < 0)); then pad2=0; fi
      printf -v pad2_str '%*s' "$pad2" ""

      printf '\n%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n' "$C_YELLOW" "$C_RESET"
      printf '%s│%s  %s%s%s%s%s│%s\n' "$C_YELLOW" "$C_RESET" "$C_AAA_WHITE" "$text_nhan_dien" "$C_RESET" "$pad1_str" "$C_YELLOW" "$C_RESET"
      printf '%s│%s  %s%s%s%s%s│%s\n' "$C_YELLOW" "$C_RESET" "$C_AAA_CYAN" "$text_huong_dan" "$C_RESET" "$pad2_str" "$C_YELLOW" "$C_RESET"
      printf '%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n' "$C_YELLOW" "$C_RESET"

      printf '\n%s➜ Nhấn [Enter] để quay lại Menu...%s' "$C_AAA_GREEN" "$C_RESET"
      _wptt_wait_enter || exit 0
    else
      err_msg="[!] Lựa chọn không hợp lệ. Vui lòng nhập từ 1 đến ${total_valid_opts}."
      len_err=${#err_msg}
      pad_err=$(((78 - len_err) / 2))
      if ((pad_err < 0)); then pad_err=0; fi
      pad_err_r_len=$((78 - len_err - pad_err))
      if ((pad_err_r_len < 0)); then pad_err_r_len=0; fi
      printf -v pad_err_l '%*s' "$pad_err" ""
      printf -v pad_err_r '%*s' "$pad_err_r_len" ""

      printf '\n%s%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n' "$MARGIN" "$C_RED" "$C_RESET"
      printf '%s%s│%s%s%s%s%s%s%s│%s\n' "$MARGIN" "$C_RED" "$C_RESET" "$pad_err_l" "$C_AAA_WHITE" "$err_msg" "$C_RESET" "$pad_err_r" "$C_RED" "$C_RESET"
      printf '%s%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n' "$MARGIN" "$C_RED" "$C_RESET"
      _wptt_pause_brief 1.5
    fi
  fi
done
