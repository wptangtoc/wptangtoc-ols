_wptt_find_horizontal_target() {
  local cur="$1"
  local dir="$2" # "right" hoặc "left"
  WPTT_NAV_TARGET=$cur

  if ((total_valid_opts <= 0)); then
    WPTT_NAV_TARGET=0
    return 0
  fi

  if ((cur < 1 || cur > total_valid_opts)); then
    if [[ "$dir" == "right" ]]; then
      WPTT_NAV_TARGET=1
    else
      WPTT_NAV_TARGET=$total_valid_opts
    fi
    return 0
  fi

  # 1. Nếu Menu chỉ có 1 cột duy nhất: Phím ← / → hoạt động như Lùi / Tiến
  if ((WPTT_HAS_TWO_COLS == 0)); then
    if [[ "$dir" == "right" ]]; then
      WPTT_NAV_TARGET=$((cur + 1))
      if ((WPTT_NAV_TARGET > total_valid_opts)); then WPTT_NAV_TARGET=1; fi
    else
      WPTT_NAV_TARGET=$((cur - 1))
      if ((WPTT_NAV_TARGET < 1)); then WPTT_NAV_TARGET=$total_valid_opts; fi
    fi
    return 0
  fi

  # 2. Nếu có sẵn mục đối diện trên cùng dòng ngang (O(1) Lookup) -> Nhảy thẳng sang
  local peer="${WPTT_ITEM_PEER[cur]:-0}"
  if ((peer > 0)); then
    WPTT_NAV_TARGET=$peer
    return 0
  fi

  # 3. Nếu dòng hiện tại bị khuyết mục đối diện, tìm mục gần nhất theo khoảng cách dòng
  local cur_side="${WPTT_ITEM_SIDE[cur]:-1}"
  local target_side=2
  if ((cur_side == 2)); then target_side=1; fi
  local cur_line="${WPTT_ITEM_LINE[cur]:-0}"

  local best_idx=0 best_dist=9999 idx=1 cand_line=0 dist=0
  for ((idx = 1; idx <= total_valid_opts; idx++)); do
    if (( ${WPTT_ITEM_SIDE[idx]:-0} == target_side )); then
      cand_line="${WPTT_ITEM_LINE[idx]:-0}"
      dist=$((cand_line - cur_line))
      if ((dist < 0)); then dist=$((-dist)); fi
      if ((dist < best_dist)); then
        best_dist=$dist
        best_idx=$idx
      fi
    fi
  done

  if ((best_idx > 0)); then
    WPTT_NAV_TARGET=$best_idx
  fi
  return 0
}

_wptt_update_live_prompt() {
  local buf="$1"
  local prompt_line="$2"
  local prev_hl="$3"
  local new_hl=0
  local status_text=""
  local max_right_cols=45

  if [[ -z "$buf" ]]; then
    status_text="${C_CYAN}← Gõ số hoặc bấm phím ${C_AAA_YELLOW}↑↓←→${C_CYAN} để chọn${C_RESET}"
  elif [[ "$buf" =~ ^[0-9]+$ ]]; then
    if [[ "$buf" == "0" ]]; then
      local back_lbl="$TEXT_BACK"
      if ((${#back_lbl} > 28)); then
        back_lbl="${back_lbl:0:26}.."
      fi
      status_text="${C_AAA_RED}→ [0] ${C_AAA_WHITE}${back_lbl} ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
    elif [[ "$buf" == "00" ]]; then
      status_text="${C_AAA_GREEN}→ [00] ${C_AAA_WHITE}Mở công cụ Tìm kiếm ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
    elif (( ${#buf} <= 6 )); then
      local num_val=$((10#$buf))
      if ((num_val >= 1 && num_val <= total_valid_opts)); then
        new_hl=$num_val
        local lbl="${WPTT_ITEM_LABEL[num_val]:-}"
        if [[ -z "$lbl" ]]; then
          local act_idx="${valid_indices[$((num_val - 1))]}"
          local REPLY_PLAIN=""
          _strip_ansi "${options[$act_idx]}"
          lbl="$REPLY_PLAIN"
        fi
        local max_lbl=$((max_right_cols - 15 - ${#num_val}))
        if ((max_lbl < 6)); then max_lbl=6; fi
        if (( ${#lbl} > max_lbl )); then
          lbl="${lbl:0:$((max_lbl - 2))}.."
        fi
        status_text="${C_AAA_GREEN}→ [${num_val}] ${C_AAA_WHITE}${lbl} ${C_AAA_YELLOW}(Enter ↵)${C_RESET}"
      else
        status_text="${C_AAA_RED}→ [!] Ngoài phạm vi (1-${total_valid_opts})${C_RESET}"
      fi
    else
      status_text="${C_AAA_RED}→ [!] Ngoài phạm vi (1-${total_valid_opts})${C_RESET}"
    fi
  else
    local short_b="$buf"
    if ((${#short_b} > 30)); then
      short_b="${short_b:0:28}.."
    fi
    status_text="${C_AAA_YELLOW}→ Lệnh: ${C_AAA_WHITE}${short_b}${C_RESET}"
  fi

  local out_seq=""

  # 1. Trả lại màu bình thường cho mục cũ
  if ((prev_hl > 0 && prev_hl != new_hl)); then
    local old_line="${WPTT_ITEM_LINE[prev_hl]:-}"
    local old_col="${WPTT_ITEM_COL[prev_hl]:-}"
    local old_norm="${WPTT_ITEM_NORM[prev_hl]:-}"
    if [[ -n "$old_line" && -n "$old_norm" ]]; then
      local up_old=$((prompt_line - old_line))
      out_seq+=$'\033['"${up_old}A"$'\033['"${old_col}G${old_norm}"$'\033['"${up_old}B"
    fi
  fi

  # 2. Tô sáng mục mới chuẩn WCAG AAA trên bảng Menu
  if ((new_hl > 0 && new_hl != prev_hl)); then
    local cur_line="${WPTT_ITEM_LINE[new_hl]:-}"
    local cur_col="${WPTT_ITEM_COL[new_hl]:-}"
    local cur_hl="${WPTT_ITEM_HL[new_hl]:-}"
    if [[ -n "$cur_line" && -n "$cur_hl" ]]; then
      local up_cur=$((prompt_line - cur_line))
      out_seq+=$'\033['"${up_cur}A"$'\033['"${cur_col}G${cur_hl}"$'\033['"${up_cur}B"
    fi
  fi

  # 3. Dựng ô Input [11    ] sạch sẽ và đặt Con trỏ gốc của Terminal vào đúng vị trí
  local disp_buf="$buf"
  if ((${#disp_buf} > 6)); then
    disp_buf="${disp_buf:0:6}"
  fi
  local len_b=${#disp_buf}
  local box_val=""
  printf -v box_val "%-6s" "$disp_buf"

  local box_color="${C_AAA_GREEN}"
  if [[ "$buf" == "0" || "$buf" == "00" ]]; then
    box_color="${C_AAA_YELLOW}"
  fi

  local left_border_col=$(( ${#MARGIN} + 1 ))
  local right_border_col=$(( ${#MARGIN} + 80 ))
  local input_cursor_col=$(( ${#MARGIN} + 26 + len_b ))

  out_seq+=$'\033[2K\033['"${left_border_col}G${C_CYAN}│${C_RESET}  ${C_AAA_GREEN}>>${C_RESET} ${C_AAA_WHITE}Lựa chọn của bạn:${C_RESET} ${box_color}[${C_AAA_YELLOW}${box_val}${box_color}]${C_RESET} ${status_text}"$'\033['"${right_border_col}G${C_CYAN}│${C_RESET}"
  out_seq+=$'\033['"${input_cursor_col}G"$'\033[?25h'

  printf '%s' "$out_seq" 2>/dev/null || return 1
  WPTT_ACTIVE_HL=$new_hl
  return 0
}

_wptt_read_interactive_choice() {
  local prompt_line="$1"
  choice=""
  WPTT_ACTIVE_HL=0

  # Nếu không phải TTY tương tác thật (VD: chạy trong BATS test / Pipe), dùng read chuẩn
  if ! _wptt_is_interactive_tty; then
    if ! IFS= read -r -t "$WPTT_MENU_IDLE_SEC" choice; then
      return 1
    fi
    return 0
  fi

  _wptt_update_live_prompt "" "$prompt_line" 0 || return 1

  local char="" rest="" REPLY_ESC_TAIL="" key_guard=0 WPTT_NAV_TARGET=0
  local rc=0 idle_elapsed=0 idle_since_probe=0 probe_miss=0 poll_sec=5

  while ((key_guard < 4096)); do
    key_guard=$((key_guard + 1))

    if [[ -n "$WPTT_PENDING_ESC" ]]; then
      char=$'\x1b'
      rest="$WPTT_PENDING_ESC"
      WPTT_PENDING_ESC=""
      rc=0
    elif [[ -n "$WPTT_PENDING_BUF" ]]; then
      char="${WPTT_PENDING_BUF:0:1}"
      WPTT_PENDING_BUF="${WPTT_PENDING_BUF:1}"
      rest=""
      rc=0
    elif ((WPTT_PENDING_ENTER == 1)); then
      WPTT_PENDING_ENTER=0
      return 0
    else
      rest=""
      rc=0
      IFS= read -rsn1 -t "$poll_sec" char || rc=$?
    fi

    if ((rc > 128)); then
      # Lớp 1 (mỗi 5s): kiểm tra cha, SID, PTY
      _wptt_tty_alive || return 1
      idle_elapsed=$((idle_elapsed + poll_sec))
      if ((idle_elapsed >= WPTT_MENU_IDLE_SEC)); then
        return 1
      fi

      # Nếu lần hiệu chuẩn đầu bị người dùng bấm chen ngang -> hiệu chuẩn lại lúc nhàn rỗi
      if ((WPTT_DSR_CALIBRATED == 0)); then
        _wptt_dsr_calibrate
      fi

      # Lớp 2 (mỗi WPTT_DSR_INTERVAL giây): gửi nhịp tim ANSI DSR \033[6n kiểm tra Terminal thật còn sống
      idle_since_probe=$((idle_since_probe + poll_sec))
      if ((WPTT_DSR_SUPPORTED == 1)) && ((idle_since_probe >= WPTT_DSR_INTERVAL || probe_miss > 0)); then
        idle_since_probe=0
        if _wptt_dsr_probe "$WPTT_DSR_TIMEOUT" 0; then
          probe_miss=0
        else
          probe_miss=$((probe_miss + 1))
          if ((probe_miss >= WPTT_DSR_MAX_MISS)); then
            return 1
          fi
        fi
      fi

      key_guard=$((key_guard - 1))
      continue
    elif ((rc != 0)); then
      # EOF / EIO khi phiên SSH/PTY ngắt kết nối
      return 1
    fi

    idle_elapsed=0
    idle_since_probe=0
    probe_miss=0

    # 1. Phím Enter (Kết thúc nhập)
    if [[ -z "$char" || "$char" == $'\n' || "$char" == $'\r' ]]; then
      return 0
    fi

    # 2. Phím Backspace / Delete
    if [[ "$char" == $'\x7f' || "$char" == $'\x08' || "$char" == $'\b' ]]; then
      if [[ -n "$choice" ]]; then
        choice="${choice%?}"
        _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
      fi
      continue
    fi

    # 3. Ctrl+C (0ms nhờ -isig) hoặc Ctrl+D
    if [[ "$char" == $'\x03' ]]; then
      _wptt_handle_ctrl_c_exit
    elif [[ "$char" == $'\x04' ]]; then
      return 1
    fi

    # 4. Phím Escape / Phím mũi tên 4 chiều ↑ ↓ ← → / Home / End
    if [[ "$char" == $'\x1b' || "$char" == $'\e' ]]; then
      if [[ -z "$rest" ]]; then
        _wptt_read_esc_tail 0.03
        rest="$REPLY_ESC_TAIL"
      fi
      case "$rest" in
        '[B' | 'OB') # Mũi tên Xuống (↓) -> Tiến 1 mục trong cột
          if ((total_valid_opts > 0)); then
            local next_n=$((WPTT_ACTIVE_HL + 1))
            if ((next_n > total_valid_opts)); then next_n=1; fi
            choice="$next_n"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '[A' | 'OA') # Mũi tên Lên (↑) -> Lùi 1 mục trong cột
          if ((total_valid_opts > 0)); then
            local prev_n=$((WPTT_ACTIVE_HL - 1))
            if ((prev_n < 1)); then prev_n=$total_valid_opts; fi
            choice="$prev_n"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '[C' | 'OC') # Mũi tên Phải (→) -> Nhảy ngang sang cột đối diện
          if ((total_valid_opts > 0)); then
            _wptt_find_horizontal_target "$WPTT_ACTIVE_HL" "right"
            choice="$WPTT_NAV_TARGET"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '[D' | 'OD') # Mũi tên Trái (←) -> Nhảy ngang về cột đối diện
          if ((total_valid_opts > 0)); then
            _wptt_find_horizontal_target "$WPTT_ACTIVE_HL" "left"
            choice="$WPTT_NAV_TARGET"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '[H' | 'OH' | '[1~' | '[7~') # Phím Home -> Về mục đầu tiên
          if ((total_valid_opts > 0)); then
            choice="1"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '[F' | 'OF' | '[4~' | '[8~') # Phím End -> Tới mục cuối cùng
          if ((total_valid_opts > 0)); then
            choice="$total_valid_opts"
            _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        '') # Nhấn ESC đơn -> Xóa nhanh ô đang gõ
          if [[ -n "$choice" ]]; then
            choice=""
            _wptt_update_live_prompt "" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
          fi
          ;;
        *) # Nuốt gọn các phím F1-F12 / PgUp / PgDn / Delete / DSR trễ
          ;;
      esac
      continue
    fi

    # 5. Ký tự in được thông thường (Số hoặc chữ lệnh CLI)
    if (( ${#choice} < 32 )) && [[ "$char" =~ [[:print:]] ]]; then
      choice+="$char"
      _wptt_update_live_prompt "$choice" "$prompt_line" "$WPTT_ACTIVE_HL" || return 1
    fi
  done

  return 1
}

