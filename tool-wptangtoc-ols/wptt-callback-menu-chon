_strip_ansi() {
  local s="$1"
  local esc=$'\x1B'
  if [[ "$s" == *'\033'* ]]; then
    s="${s//\\033/$esc}"
  fi
  if [[ "$s" == *'\e'* ]]; then
    s="${s//\\e/$esc}"
  fi
  if [[ "$s" != *"$esc"* ]]; then
    REPLY_PLAIN="$s"
    return 0
  fi
  REPLY_PLAIN="${s//${esc}\[*([0-9;?])[@-~]/}"
}

print_row() {
  local l_num="$1" l_text="$2" r_num="$3" r_text="$4"
  local c1_plain="" c1_color="" c2_plain="" c2_color=""
  local num_fmt="" pad_l=0 pad_r=0 cell_pad=""
  local idx_l=0 idx_r=0
  local REPLY_PLAIN=""

  if [[ -n "$l_text" ]]; then
    _strip_ansi "$l_text"
    l_text="$REPLY_PLAIN"
    if [[ -z "$l_num" ]]; then
      c1_plain="  ▶ ${l_text}"
      if ((${#c1_plain} > 36)); then
        c1_plain="${c1_plain:0:34}.."
      fi
      c1_color="  ${C_AAA_YELLOW}▶ ${C_AAA_WHITE}${c1_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$l_num"
      c1_plain="  [${num_fmt}] ${l_text}"
      if ((${#c1_plain} > 36)); then
        c1_plain="${c1_plain:0:34}.."
      fi
      c1_color="  ${C_GREEN}[${num_fmt}]${C_RESET} ${C_CYAN}${c1_plain:7}${C_RESET}"
    fi
  fi

  if [[ -n "$r_text" ]]; then
    _strip_ansi "$r_text"
    r_text="$REPLY_PLAIN"
    if [[ -z "$r_num" ]]; then
      c2_plain="  ▶ ${r_text}"
      if ((${#c2_plain} > 36)); then
        c2_plain="${c2_plain:0:34}.."
      fi
      c2_color="  ${C_AAA_YELLOW}▶ ${C_AAA_WHITE}${c2_plain:4}${C_RESET}"
    else
      printf -v num_fmt "%2s" "$r_num"
      c2_plain="  [${num_fmt}] ${r_text}"
      if ((${#c2_plain} > 36)); then
        c2_plain="${c2_plain:0:34}.."
      fi
      c2_color="  ${C_GREEN}[${num_fmt}]${C_RESET} ${C_CYAN}${c2_plain:7}${C_RESET}"
    fi
  fi

  pad_l=$((37 - ${#c1_plain}))
  if ((pad_l < 0)); then pad_l=0; fi
  pad_r=$((37 - ${#c2_plain}))
  if ((pad_r < 0)); then pad_r=0; fi

  if [[ -n "$l_num" && "$l_num" =~ ^[0-9]+$ && "${#l_num}" -le 6 ]]; then
    idx_l=$((10#$l_num))
    printf -v num_fmt "%2s" "$l_num"
    printf -v cell_pad '%*s' "$pad_l" ""
    WPTT_ITEM_LINE[idx_l]=$WPTT_RENDER_LINE
    WPTT_ITEM_COL[idx_l]=$(( ${#MARGIN} + 3 ))
    WPTT_ITEM_SIDE[idx_l]=1
    WPTT_ITEM_NORM[idx_l]="${c1_color}${cell_pad}"
    WPTT_ITEM_HL[idx_l]="${C_HL_NUM} ❯[${num_fmt}]${C_HL_BG} ${c1_plain:7}${cell_pad}${C_RESET}"
    WPTT_ITEM_LABEL[idx_l]="${l_text}"
  fi

  if [[ -n "$r_num" && "$r_num" =~ ^[0-9]+$ && "${#r_num}" -le 6 ]]; then
    idx_r=$((10#$r_num))
    WPTT_HAS_TWO_COLS=1
    printf -v num_fmt "%2s" "$r_num"
    printf -v cell_pad '%*s' "$pad_r" ""
    WPTT_ITEM_LINE[idx_r]=$WPTT_RENDER_LINE
    WPTT_ITEM_COL[idx_r]=$(( ${#MARGIN} + 42 ))
    WPTT_ITEM_SIDE[idx_r]=2
    WPTT_ITEM_NORM[idx_r]="${c2_color}${cell_pad}"
    WPTT_ITEM_HL[idx_r]="${C_HL_NUM} ❯[${num_fmt}]${C_HL_BG} ${c2_plain:7}${cell_pad}${C_RESET}"
    WPTT_ITEM_LABEL[idx_r]="${r_text}"
  fi

  # Liên kết ngang trực tiếp O(1) nếu cả 2 cột trên cùng dòng đều có mục chọn
  if ((idx_l > 0 && idx_r > 0)); then
    WPTT_ITEM_PEER[idx_l]=$idx_r
    WPTT_ITEM_PEER[idx_r]=$idx_l
  fi

  printf '%s%s│%s %s%*s  %s%*s %s│%s\n' \
    "$MARGIN" "$C_CYAN" "$C_RESET" \
    "$c1_color" "$pad_l" "" \
    "$c2_color" "$pad_r" "" \
    "$C_CYAN" "$C_RESET"
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
}

print_full_row() {
  local index="$1"
  local text="$2"
  local box_inner_width=78
  local REPLY_PLAIN=""
  local clean_len=0 pad=0 pad_str="" formatted_index=""

  _strip_ansi "$text"

  if [[ -z "$index" ]]; then
    local title_txt="${REPLY_PLAIN^^}"
    if ((${#title_txt} > 72)); then
      title_txt="${title_txt:0:70}.."
    fi
    clean_len=$((5 + ${#title_txt}))
    pad=$((box_inner_width - clean_len))
    if ((pad < 0)); then pad=0; fi
    printf -v pad_str '%*s' "$pad" ""

    printf '%s%s│%s   %s▶%s %s%s%s%s%s│%s\n' \
      "$MARGIN" "$C_CYAN" "$C_RESET" \
      "$C_AAA_YELLOW" "$C_RESET" \
      "$C_AAA_WHITE" "$title_txt" "$C_RESET" \
      "$pad_str" "$C_CYAN" "$C_RESET"
  else
    printf -v formatted_index "%2s" "$index"
    local row_txt="$REPLY_PLAIN"
    local max_txt=$((box_inner_width - 6 - ${#formatted_index}))
    if ((${#row_txt} > max_txt)); then
      row_txt="${row_txt:0:$((max_txt - 2))}.."
    fi
    clean_len=$((3 + ${#formatted_index} + 3 + ${#row_txt}))
    pad=$((box_inner_width - clean_len))
    if ((pad < 0)); then pad=0; fi
    printf -v pad_str '%*s' "$pad" ""

    if [[ "$index" =~ ^[0-9]+$ && "${#index}" -le 6 ]]; then
      local idx_f=$((10#$index))
      local norm_str="   ${C_GREEN}[${formatted_index}]${C_RESET} ${C_CYAN}${row_txt}${C_RESET}${pad_str}"
      local hl_pad=$((pad - 1))
      if ((hl_pad < 0)); then hl_pad=0; fi
      local hl_pad_str=""
      printf -v hl_pad_str '%*s' "$hl_pad" ""
      WPTT_ITEM_LINE[idx_f]=$WPTT_RENDER_LINE
      WPTT_ITEM_COL[idx_f]=$(( ${#MARGIN} + 2 ))
      WPTT_ITEM_SIDE[idx_f]=1
      WPTT_ITEM_NORM[idx_f]="$norm_str"
      WPTT_ITEM_HL[idx_f]=" ${C_HL_NUM} ❯[${formatted_index}]${C_HL_BG} ${row_txt}${hl_pad_str}${C_RESET} "
      WPTT_ITEM_LABEL[idx_f]="$row_txt"
    fi

    printf '%s%s│%s   %s[%s]%s %s%s%s%s%s│%s\n' \
      "$MARGIN" "$C_CYAN" "$C_RESET" \
      "$C_GREEN" "$formatted_index" "$C_RESET" \
      "$C_CYAN" "$row_txt" "$C_RESET" \
      "$pad_str" "$C_CYAN" "$C_RESET"
  fi
  WPTT_RENDER_LINE=$((WPTT_RENDER_LINE + 1))
}

