  while IFS=$'\t' read -r f_disp f_num f_full f_script _; do
    [[ -z "$f_disp" ]] && continue
    sub_init_lines+=("${f_disp}"$'\t'"${f_num}"$'\t'"${f_full}"$'\t'"${f_script}"$'\t')
  done <"$SUB_IDX_FILE"

  export SHELL=/bin/bash
  REPLY_SUB_SELECTED=""
  trap '' SIGINT
  REPLY_SUB_SELECTED=$(
    printf "%s\n" "${sub_init_lines[@]}" | fzf \
      --ansi \
      --disabled \
      --bind 'change:reload:wptt_sub_fzf_search {q}' \
      --prompt="🔍 Tìm kiếm trong Menu này > " \
      --height='~55%' \
      --border=rounded \
      --color=border:cyan \
      --layout=reverse \
      --cycle \
      --with-nth=1 \
      --delimiter=$'\t' \
      --header="Gõ từ khóa | ESC hủy" \
      --preview='wptt_sub_fzf_previewer {3} {4} {5}' \
      --preview-window=up:4:wrap
  ) || true
  trap '_wptt_menu_ctrl_c' SIGINT

  _wptt_cleanup_sub_search
}

# ==============================================================================
# 5. TIỀN XỬ LÝ (O(1) MAPPING) - TỐI ƯU SIÊU TỐC
# ==============================================================================
valid_indices=()
for i in "${!options[@]}"; do
  [[ "${options[$i]}" != *"───"* ]] && valid_indices+=("$i")
done
total_valid_opts=${#valid_indices[@]}

# ==============================================================================
# 6. VÒNG LẶP DASHBOARD CHÍNH (HARD-CAPPED LOOP & TTY GUARD)
# ==============================================================================
_wptt_menu_loop_guard=0

while ((++_wptt_menu_loop_guard <= WPTT_MAX_MENU_LOOPS)); do

  # Nếu đang chạy tương tác mà TTY bị đóng (rớt SSH), lập tức dừng vòng lặp
  if [[ -z "${BATS_TEST_FILENAME:-}" && "${CI:-}" != "true" ]]; then
    if [[ ! -t 0 && ! -t 1 ]]; then
      break
    fi
  fi

  if [[ -t 0 ]]; then stty -echo 2>/dev/null; fi
  calc_margin

  WPTT_RENDER_LINE=0
  WPTT_ITEM_LINE=()
  WPTT_ITEM_COL=()
  WPTT_ITEM_NORM=()
  WPTT_ITEM_HL=()
  WPTT_ITEM_LABEL=()

  echo -e "${MARGIN}${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  ((WPTT_RENDER_LINE++))
  print_header "${MENU_TITLE:-TRUNG TÂM QUẢN TRỊ WPTANGTOC OLS}"
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  ((WPTT_RENDER_LINE++))
  print_spacer

  if declare -F draw_custom_grid >/dev/null; then
    draw_custom_grid
  else
    draw_default_grid
  fi

  print_spacer
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  ((WPTT_RENDER_LINE++))

  plain_foot=" Nhập số (1-$total_valid_opts) | [00] Tìm kiếm | [0] $TEXT_BACK "
  color_foot=" ${C_AAA_WHITE}Nhập số (1-$total_valid_opts)${C_RESET} │ ${C_AAA_GREEN}[00] Tìm kiếm${C_RESET} │ ${C_AAA_RED}[0] $TEXT_BACK${C_RESET} "

  len_foot=${#plain_foot}
  p_l=$(((78 - len_foot) / 2))
  ((p_l < 0)) && p_l=0
  p_r=$((78 - len_foot - p_l))
  ((p_r < 0)) && p_r=0

  printf "${MARGIN}${C_CYAN}│${C_RESET}%*s%b%*s${C_CYAN}│${C_RESET}\n" "$p_l" "" "$color_foot" "$p_r" ""
  ((WPTT_RENDER_LINE++))
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  ((WPTT_RENDER_LINE++))

  PROMPT_ROW_IDX=$WPTT_RENDER_LINE
  printf "${MARGIN}${C_CYAN}│${C_RESET}  ${C_AAA_GREEN}>>${C_RESET} ${C_AAA_WHITE}Lựa chọn của bạn:${C_RESET} %-55s${C_CYAN}│${C_RESET}\n" ""
  ((WPTT_RENDER_LINE++))
  echo -e "${MARGIN}${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  margin_len=${#MARGIN}
  cursor_col=$((margin_len + 26))
  echo -en "\033[2A\033[${cursor_col}G"

  # ============================================================================
  # XỬ LÝ TYPEAHEAD BUFFERING & ĐỌC PHÍM TƯƠNG TÁC (LIVE HIGHLIGHT)
  # ============================================================================
  if declare -F wptt_flush_stdin >/dev/null; then
    wptt_flush_stdin
  fi

  if ! _wptt_read_interactive_choice "$PROMPT_ROW_IDX"; then
    if [[ -t 0 ]]; then stty echo 2>/dev/null; fi
    echo -en "\033[2B\n"
    exit 0
  fi

  if [[ -t 0 ]]; then stty echo 2>/dev/null; fi
  echo -en "\033[2B\r"

  choice="${choice#"${choice%%[![:space:]]*}"}"
  choice="${choice%"${choice##*[![:space:]]}"}"

  # ============================================================================
  # ĐIỀU HƯỚNG BẰNG THUẬT TOÁN O(1)
  # ============================================================================
  if [[ -z "$choice" ]]; then
    empty_msg="[!] Bạn chưa nhập gì cả. Vui lòng điền một con số rồi ấn Enter!"
    len_empty=${#empty_msg}
    pad_empty=$(((78 - len_empty) / 2))
    printf -v pad_empty_l '%*s' "$pad_empty" ""
    printf -v pad_empty_r '%*s' "$((78 - len_empty - pad_empty))" ""

    echo -e "\n${MARGIN}${C_YELLOW}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${MARGIN}${C_YELLOW}│${C_RESET}${pad_empty_l}${C_AAA_WHITE}${empty_msg}${C_RESET}${pad_empty_r}${C_YELLOW}│${C_RESET}"
    echo -e "${MARGIN}${C_YELLOW}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    read -r -s -n 1 -t 1.2 _ 2>/dev/null || true
    clear
    continue

  elif [[ "$choice" == "0" ]]; then
    echo -e "\n${MARGIN}${C_AAA_YELLOW}Đang $TEXT_BACK...${C_RESET}"
    _wptt_cleanup_sub_search
    clear
    exec "$ROUTE_BACK" 1
    exit 0

  elif [[ "$choice" == "00" ]]; then
    if ((IS_MAIN_MENU == 1)); then
      _wptt_cleanup_sub_search
      if [[ -f /etc/wptt/search-wptangtoc ]]; then
        chmod +x /etc/wptt/search-wptangtoc 2>/dev/null || true
        exec /etc/wptt/search-wptangtoc
      fi
    fi

    if command -v fzf &>/dev/null; then
      REPLY_SUB_SELECTED=""
      _run_submenu_seo_fzf

      if [[ -n "$REPLY_SUB_SELECTED" ]]; then
        IFS=$'\t' read -r _ sel_num sel_full_title _ <<<"$REPLY_SUB_SELECTED"
        sel_num="${sel_num//[[:space:]]/}"
        if [[ "$sel_num" =~ ^[0-9]+$ ]]; then
          actual_index="${valid_indices[$((10#$sel_num - 1))]}"

          if [[ -n "$sel_full_title" ]]; then
            [[ -f "$HITS_FILE" ]] || : >"$HITS_FILE" 2>/dev/null
            hits_tmp="${HITS_FILE}.tmp.$$"
            if awk -F'\t' -v feat="$sel_full_title" '
                BEGIN { OFS="\t"; found=0 }
                NF >= 2 {
                  if ($1 == feat) { $2 = int($2) + 1; found=1 }
                  print $1, $2
                }
                END { if (!found) print feat, 1 }
              ' "$HITS_FILE" >"$hits_tmp" 2>/dev/null; then
              /bin/mv -f "$hits_tmp" "$HITS_FILE" 2>/dev/null || /bin/rm -f "$hits_tmp"
            else
              /bin/rm -f "$hits_tmp"
            fi
          fi

          echo -e "\n${MARGIN}${C_AAA_GREEN}>> Đang khởi chạy: ${options[$actual_index]}${C_RESET}\n"
          run_action "$actual_index"
        fi
      else
        clear
      fi
    else
      echo -e "\n${MARGIN}${C_AAA_RED}[!] Lỗi: FZF chưa được cài đặt.${C_RESET}"
      read -r -s -n 1 -t 1.5 _ 2>/dev/null || true
    fi

  elif [[ "$choice" =~ ^[0-9]+$ ]] && ((10#$choice >= 1 && 10#$choice <= total_valid_opts)); then
    actual_index="${valid_indices[$((10#$choice - 1))]}"
    echo -e "\n${MARGIN}${C_AAA_GREEN}>> Đang khởi chạy: ${options[$actual_index]}${C_RESET}\n"
    run_action "$actual_index"

  elif [[ -n "$choice" ]]; then
    f_word="${choice%% *}"
    if command -v "$f_word" >/dev/null 2>&1; then
      _get_cli_menu_num
      echo -e "\n${C_YELLOW}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      text_nhan_dien="Sếp đang muốn chạy lệnh CLI: $choice"
      pad1=$((76 - ${#text_nhan_dien}))
      ((pad1 < 0)) && pad1=0
      printf -v pad1_str '%*s' "$pad1" ""
      echo -e "${C_YELLOW}│${C_RESET}  ${C_AAA_WHITE}${text_nhan_dien}${C_RESET}${pad1_str}${C_YELLOW}│${C_RESET}"

      text_huong_dan="Để gõ lệnh CLI, vào Menu ➜ $cli_menu_num (Terminal) hoặc nhấn Ctrl + C"
      len_hd=${#text_huong_dan}
      pad2=$((76 - len_hd))
      ((pad2 < 0)) && pad2=0
      printf -v pad2_str '%*s' "$pad2" ""
      echo -e "${C_YELLOW}│${C_RESET}  ${C_AAA_CYAN}${text_huong_dan}${C_RESET}${pad2_str}${C_YELLOW}│${C_RESET}"
      echo -e "${C_YELLOW}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

      echo -en "\n${C_AAA_GREEN}➜ Nhấn [Enter] để quay lại Menu...${C_RESET}"
      read -r -t "$WPTT_MENU_IDLE_SEC" _ || exit 0
    else
      err_msg="[!] Lựa chọn không hợp lệ. Vui lòng nhập từ 1 đến ${total_valid_opts}."
      len_err=${#err_msg}
      pad_err=$(((78 - len_err) / 2))
      printf -v pad_err_l '%*s' "$pad_err" ""
      printf -v pad_err_r '%*s' "$((78 - len_err - pad_err))" ""

      echo -e "\n${MARGIN}${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      echo -e "${MARGIN}${C_RED}│${C_RESET}${pad_err_l}${C_AAA_WHITE}${err_msg}${C_RESET}${pad_err_r}${C_RED}│${C_RESET}"
      echo -e "${MARGIN}${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      read -r -s -n 1 -t 1.5 _ 2>/dev/null || true
    fi
  fi
done
