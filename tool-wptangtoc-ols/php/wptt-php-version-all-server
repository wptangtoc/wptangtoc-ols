#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Thay đổi phiên bản PHP mặc định toàn hệ thống (Atomic, Batch-Install & Fail-Safe)

function huong_dan() {
  cat <<'EOF'
  Thay đổi phiên bản PHP toàn bộ website server hệ thống là quá trình nâng cấp hoặc hạ cấp phiên bản PHP mặc định mà máy chủ web sử dụng để xử lý mã PHP cho tất cả các trang web được lưu trữ trên máy chủ đó, trừ khi có cấu hình riêng biệt cho từng tên miền cụ thể.

  Nói một cách đơn giản, đây là việc đặt một phiên bản PHP [ví dụ: PHP 8.3] làm tiêu chuẩn cho toàn bộ máy chủ. Bất kỳ website nào không có cài đặt PHP riêng sẽ tự động chạy bằng phiên bản tiêu chuẩn này.

  Mục đích chính:
  * Nâng cao bảo mật và hiệu suất: Cập nhật lên các phiên bản PHP mới hơn, còn được hỗ trợ, để vá lỗi bảo mật và tận dụng các cải tiến về tốc độ cho tất cả các website.
  * Chuẩn hóa môi trường: Đảm bảo một môi trường phát triển và vận hành đồng nhất trên toàn máy chủ.
  * Loại bỏ phiên bản cũ lỗi thời: Khi một phiên bản PHP cũ đã hết hạn hỗ trợ [End-of-Life], việc nâng cấp toàn hệ thống là cần thiết.
  * Cung cấp tính năng mới: Giúp các nhà phát triển có thể sử dụng các tính năng ngôn ngữ mới nhất của PHP làm mặc định.

  Khác với việc thay đổi PHP cho từng domain riêng lẻ, thay đổi toàn bộ hệ thống ảnh hưởng đến mặc định chung của cả server.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true
umask 022

# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

route_menu="${1:-}"
su_dung_repo_du_phong=0
tmp_work_dir=""

# ==============================================================================
# BẪY DỌN DẸP TÀI NGUYÊN & KHÔI PHỤC /etc/hosts AN TOÀN KHI THOÁT SỚM
# ==============================================================================
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if ((su_dung_repo_du_phong == 1)) && [[ -f /etc/hosts ]]; then
    local hosts_tmp="/etc/wptt/tmp/hosts_clean_$$.tmp"
    if grep -v 'rpms\.litespeedtech\.com' /etc/hosts >"$hosts_tmp" 2>/dev/null; then
      chmod 644 "$hosts_tmp" 2>/dev/null || true
      /bin/mv -fT -- "$hosts_tmp" /etc/hosts 2>/dev/null || /bin/rm -f -- "$hosts_tmp"
    else
      /bin/rm -f -- "$hosts_tmp" 2>/dev/null || true
    fi
  fi
  if [[ -n "${tmp_work_dir:-}" && -d "$tmp_work_dir" ]]; then
    case "$tmp_work_dir" in
      /etc/wptt/tmp/*) /bin/rm -rf -- "${tmp_work_dir:?}" 2>/dev/null || true ;;
    esac
  fi
  /bin/rm -f -- /etc/wptt/tmp/php_extension_call_eol 2>/dev/null || true
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

/bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
chmod 700 /etc/wptt/tmp 2>/dev/null || true
tmp_work_dir="$(mktemp -d /etc/wptt/tmp/php_all_XXXXXX 2>/dev/null || echo "/etc/wptt/tmp/php_all_$$")"
/bin/mkdir -p "$tmp_work_dir" 2>/dev/null || true

# Nhận diện hệ điều hành & Package Manager chuẩn
if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
  OS_FAMILY="DEBIAN"
  PKG_MGR="apt-get"
else
  OS_FAMILY="RHEL"
  if command -v dnf >/dev/null 2>&1; then
    PKG_MGR="dnf"
  else
    PKG_MGR="yum"
  fi
fi

# Hàm trích xuất danh sách phiên bản PHP từ kho EOL (0-Perl, chỉ dùng AWK)
_extract_php_versions() {
  local eol_file="/etc/wptt/tmp/php_extension_call_eol"
  [[ -s "$eol_file" ]] || return 0
  awk '
    {
      line = $0
      while (match(line, /lsphp[0-9][0-9]/)) {
        ver = substr(line, RSTART + 5, 2)
        seen[ver] = 1
        line = substr(line, RSTART + RLENGTH)
      }
    }
    END {
      for (v in seen) print v
    }
  ' "$eol_file" 2>/dev/null | sort -u | awk '{ printf "PHP %s.%s\n", substr($1,1,1), substr($1,2,1) }'
}

# Hàm tải file an toàn với curl / wget
_download_pkg() {
  local url="$1"
  local dest_dir="$2"
  local filename="${url##*/}"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location --max-time 90 --retry 2 -o "${dest_dir}/${filename}" "$url" 2>/dev/null
  else
    wget -q --timeout=90 --tries=2 -P "$dest_dir" "$url" 2>/dev/null
  fi
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ PHP ➜ Thay Đổi Phiên Bản PHP Toàn Hệ Thống${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# 1. QUÉT VÀ LẤY DANH SÁCH PHP TỪ LITESPEED REPO
# ==============================================================================
task_scan="Quét danh sách phiên bản PHP khả dụng từ LiteSpeed"
_runing "$task_scan"

if [[ "$OS_FAMILY" == "RHEL" ]]; then
  "$PKG_MGR" clean all >/dev/null 2>&1 || true
else
  DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
fi

if [[ -x /etc/wptt/php/kho-luu-tru-litespeed || -f /etc/wptt/php/kho-luu-tru-litespeed ]]; then
  (/bin/bash /etc/wptt/php/kho-luu-tru-litespeed >/dev/null 2>&1) || true
fi

x="$(_extract_php_versions)"

# Fallback sang IP Repo dự phòng nếu DNS rpms.litespeedtech.com bị nghẽn
if [[ -z "$x" ]]; then
  hosts_tmp="${tmp_work_dir}/hosts.tmp"
  grep -v 'rpms\.litespeedtech\.com' /etc/hosts >"$hosts_tmp" 2>/dev/null || true
  printf '\n52.55.120.73 rpms.litespeedtech.com\n' >>"$hosts_tmp"
  chmod 644 "$hosts_tmp"
  /bin/mv -fT -- "$hosts_tmp" /etc/hosts
  su_dung_repo_du_phong=1

  if [[ -f /etc/wptt/php/kho-luu-tru-litespeed ]]; then
    (/bin/bash /etc/wptt/php/kho-luu-tru-litespeed >/dev/null 2>&1) || true
  fi
  x="$(_extract_php_versions)"
fi

# Fallback cuối: Nếu kho EOL web không phản hồi, quét trực tiếp từ Package Manager
if [[ -z "$x" ]]; then
  if [[ "$OS_FAMILY" == "DEBIAN" ]]; then
    x="$(apt-cache --names-only search '^lsphp[0-9]{2}$' 2>/dev/null | awk '{ver=substr($1,6,2); if(ver~/^[0-9]{2}$/) print ver}' | sort -u | awk '{printf "PHP %s.%s\n", substr($1,1,1), substr($1,2,1)}')"
  else
    x="$("$PKG_MGR" list available 'lsphp[0-9][0-9]' 2>/dev/null | awk '/^lsphp[0-9][0-9]\./ {ver=substr($1,6,2); print ver}' | sort -u | awk '{printf "PHP %s.%s\n", substr($1,1,1), substr($1,2,1)}')"
  fi
fi

if [[ -z "$x" ]]; then
  _runloi "$task_scan"
  echo -e "\n${C_RED}❌ Không thể kết nối tới kho lưu trữ LiteSpeed. Vui lòng kiểm tra kết nối mạng hoặc DNS!${C_RESET}\n"
  wptt_quay_ve_menu "$route_menu" 1
fi
_rundone "$task_scan"

# ==============================================================================
# 2. MENU CHỌN PHIÊN BẢN PHP
# ==============================================================================
echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}DANH SÁCH PHIÊN BẢN PHP HỖ TRỢ${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

selects=()
while IFS= read -r line; do
  [[ -n "$line" ]] && selects+=("$line")
done <<<"$x"

i=1
for val in "${selects[@]}"; do
  left_text "  ${C_CYAN}$i)${C_RESET} ${C_BOLD_WHITE}$val${C_RESET}" 2
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-${#selects[@]}) [0=Thoát]: ${C_RESET}"
  if ! read -r REPLY; then
    echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    wptt_quay_ve_menu "$route_menu" 0
  fi
  [[ "$REPLY" == "0" || -z "$REPLY" ]] && {
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    wptt_quay_ve_menu "$route_menu" 0
  }

  if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#selects[@]})); then
    php_version="${selects[$((10#$REPLY - 1))]}"
    break
  else
    echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
  fi
done

# ==============================================================================
# 3. HỘP THOẠI CẢNH BÁO TRƯỚC KHI ĐỔI TOÀN MÁY CHỦ
# ==============================================================================
echo ""
if ! wptt_xac_nhan "CẢNH BÁO: Việc này sẽ thay đổi PHP mặc định của TOÀN BỘ máy chủ!" "Các website dùng Source Code quá cũ có thể bị lỗi 500 khi nâng cấp." "Bạn có chắc chắn muốn áp dụng $php_version cho toàn hệ thống không?" "Đồng ý Đổi All" "Hủy thao tác"; then
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
  wptt_quay_ve_menu "$route_menu" 0
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}ĐANG TRIỂN KHAI: ${C_BOLD_WHITE}$php_version${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

php_ver_chon="${php_version//[^0-9]/}"
php_version_name="lsphp${php_ver_chon}"
phien_ban_php_co_cham="${php_ver_chon:0:1}.${php_ver_chon:1:1}"

# ==============================================================================
# 4. CÀI ĐẶT LITE-SPEED PHP VÀ EXTENSIONS (BATCH INSTALL + EOL FALLBACK)
# ==============================================================================
extensions=(common gd process mbstring pdo mysqlnd xml opcache mcrypt imap bcmath intl zip mysql json curl pecl-igbinary igbinary imagick pecl-imagick)

# Kiểm tra thêm Redis / Memcached nếu dịch vụ đang chạy để gộp cài đặt 1 lần
need_redis=0
if systemctl is-active --quiet valkey 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null || systemctl is-active --quiet redis-server 2>/dev/null; then
  need_redis=1
  extensions+=(redis pecl-redis)
fi

need_memcached=0
if systemctl is-active --quiet memcached 2>/dev/null; then
  need_memcached=1
  extensions+=(memcached pecl-memcached msgpack pecl-msgpack)
fi

# Kiểm tra gói có sẵn trên Repo chính thức hay phải lấy từ kho EOL
repo_has_pkg=0
if [[ "$OS_FAMILY" == "DEBIAN" ]]; then
  if apt-cache show "lsphp${php_ver_chon}" >/dev/null 2>&1; then
    repo_has_pkg=1
  fi
else
  if "$PKG_MGR" list available "lsphp${php_ver_chon}*" >/dev/null 2>&1 || rpm -q "lsphp${php_ver_chon}" >/dev/null 2>&1; then
    repo_has_pkg=1
  fi
fi

if ((repo_has_pkg == 1)); then
  task_core="Cài đặt lõi $php_version_name và bộ Extensions tiêu chuẩn"
  _runing "$task_core"

  if [[ "$OS_FAMILY" == "DEBIAN" ]]; then
    # Lọc danh sách gói thực tế có trong apt-cache để cài đặt 1 lần (Tránh lỗi gói không tồn tại)
    avail_apt_pkgs="$(apt-cache --names-only search "^lsphp${php_ver_chon}(-|$)" 2>/dev/null | awk '{print $1}')"
    install_list=("lsphp${php_ver_chon}")
    for ext in "${extensions[@]}"; do
      pkg_candidate="lsphp${php_ver_chon}-${ext}"
      if grep -qxF "$pkg_candidate" <<<"$avail_apt_pkgs"; then
        install_list+=("$pkg_candidate")
      fi
    done
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${install_list[@]}" >/dev/null 2>&1 || true
  else
    install_list=("lsphp${php_ver_chon}")
    for ext in "${extensions[@]}"; do
      install_list+=("lsphp${php_ver_chon}-${ext}")
    done
    if [[ "$PKG_MGR" == "dnf" ]]; then
      dnf install -y --skip-broken --disablerepo="mariadb*" "${install_list[@]}" >/dev/null 2>&1 ||
        dnf install -y --skip-broken "${install_list[@]}" >/dev/null 2>&1 || true
    else
      yum install -y --skip-broken "${install_list[@]}" >/dev/null 2>&1 || true
    fi
  fi
  _rundone "$task_core"

else
  # Cài đặt từ kho lưu trữ EOL (End-of-Life)
  mapfile -t url_repo_litespeed < <(
    awk '
      BEGIN { FS = "/" }
      {
        filename = $NF; split(filename, parts, "-")
        pkg_name = ""; version = ""
        if (parts[2] == "pecl") { pkg_name = parts[1] "-" parts[2] "-" parts[3]; version = parts[4] }
        else if (parts[2] ~ /^[0-9]+\.[0-9]+/) { pkg_name = parts[1]; version = parts[2] }
        else { pkg_name = parts[1] "-" parts[2]; version = parts[3] }

        if (version > versions[pkg_name]) { versions[pkg_name] = version; latest_lines[pkg_name] = $0 }
      }
      END {
        for (pkg in latest_lines) print latest_lines[pkg]
      }
    ' /etc/wptt/tmp/php_extension_call_eol 2>/dev/null |
      grep "lsphp${php_ver_chon}" |
      grep -oP 'href="\K[^"]+' |
      grep -vE 'debuginfo|-devel|-debugsource'
  )

  eol_pkg_dir="${tmp_work_dir}/eol_pkgs"
  /bin/mkdir -p "$eol_pkg_dir"

  # 1. Cài đặt Lõi EOL trước
  task_eol_core="Tải và cài đặt lõi $php_version_name (Kho EOL)"
  _runing "$task_eol_core"
  url_php_eol_install="$(printf "%s\n" "${url_repo_litespeed[@]}" | grep -P "lsphp${php_ver_chon}-\K[0-9]+\.[0-9]+|lsphp${php_ver_chon}_\K[0-9]+\.[0-9]+" | tail -n1)"
  if [[ -n "$url_php_eol_install" ]]; then
    if [[ "$url_php_eol_install" == *.rpm ]]; then
      "$PKG_MGR" install -y "https://rpms.litespeedtech.com${url_php_eol_install}" >/dev/null 2>&1 || true
    elif [[ "$url_php_eol_install" == *.deb ]]; then
      _download_pkg "https://rpms.litespeedtech.com${url_php_eol_install}" "$eol_pkg_dir" &&
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$eol_pkg_dir"/*.deb >/dev/null 2>&1 || true
      /bin/rm -f -- "$eol_pkg_dir"/*.deb 2>/dev/null || true
    fi
  fi
  _rundone "$task_eol_core"

  # 2. Cài đặt các Extension EOL
  for extension in "${extensions[@]}"; do
    task_ext="Cài đặt extension: lsphp${php_ver_chon}-${extension} (Kho EOL)"
    _runing "$task_ext"
    if [[ "$OS_FAMILY" == "RHEL" ]]; then
      rpm_url="$(printf "%s\n" "${url_repo_litespeed[@]}" | grep "lsphp${php_ver_chon}-${extension}-" | grep '\.rpm$' | head -n1)"
      if [[ -n "$rpm_url" ]]; then
        "$PKG_MGR" install -y "https://rpms.litespeedtech.com${rpm_url}" >/dev/null 2>&1 || true
      fi
    else
      deb_url="$(printf "%s\n" "${url_repo_litespeed[@]}" | grep "lsphp${php_ver_chon}-${extension}[-_]" | grep '\.deb$' | head -n1)"
      if [[ -n "$deb_url" ]]; then
        _download_pkg "https://rpms.litespeedtech.com${deb_url}" "$eol_pkg_dir" &&
          DEBIAN_FRONTEND=noninteractive apt-get install -y "$eol_pkg_dir"/*.deb >/dev/null 2>&1 || true
        /bin/rm -f -- "$eol_pkg_dir"/*.deb 2>/dev/null || true
      fi
    fi
    _rundone "$task_ext"
  done
fi

# ==============================================================================
# 5. CHỐT CHẶN AN TOÀN: KIỂM TRA BINARY LSPHP TRƯỚC KHI CHẠM VÀO HỆ THỐNG
# ==============================================================================
lsphp_bin="/usr/local/lsws/lsphp${php_ver_chon}/bin/lsphp"
php_cli_bin="/usr/local/lsws/lsphp${php_ver_chon}/bin/php"

if [[ ! -x "$lsphp_bin" ]]; then
  _runloi "Kiểm tra tệp thực thi $lsphp_bin"
  echo -e "\n${C_RED}❌ CẢNH BÁO AN TOÀN: Gói $php_version_name chưa được cài đặt thành công ($lsphp_bin không tồn tại).${C_RESET}"
  echo -e "${C_YELLOW}➜ Hệ thống đã tự động giữ nguyên phiên bản PHP cũ để bảo vệ toàn bộ Website khỏi lỗi 503!${C_RESET}\n"
  wptt_quay_ve_menu "$route_menu" 1
fi

# ==============================================================================
# 6. TỐI ƯU HÓA PHP.INI DỰA TRÊN RAM (0-SUBSHELL + ATOMIC REPLACE)
# ==============================================================================
task_ini="Tối ưu hóa php.ini theo dung lượng RAM thực tế"
_runing "$task_ini"

if [[ "$OS_FAMILY" == "DEBIAN" ]]; then
  duong_dan_php_ini="/usr/local/lsws/lsphp${php_ver_chon}/etc/php/${phien_ban_php_co_cham}/litespeed/php.ini"
else
  duong_dan_php_ini="/usr/local/lsws/lsphp${php_ver_chon}/etc/php.ini"
fi

# Fallback tìm chính xác đường dẫn php.ini nếu cấu trúc thư mục khác biệt
if [[ ! -f "$duong_dan_php_ini" && -x "$php_cli_bin" ]]; then
  detected_ini="$("$php_cli_bin" --ini 2>/dev/null | awk -F': ' '/Loaded Configuration File/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}')"
  [[ -n "$detected_ini" && -f "$detected_ini" ]] && duong_dan_php_ini="$detected_ini"
fi

# Đọc RAM trực tiếp từ /proc/meminfo (Pure Bash, 0-Subshell)
mem_total_kb=0
if [[ -r /proc/meminfo ]]; then
  while IFS=': ' read -r key val _; do
    if [[ "$key" == "MemTotal" && "$val" =~ ^[0-9]+$ ]]; then
      mem_total_kb="$val"
      break
    fi
  done </proc/meminfo
fi
TOTAL_RAM_MB=$((mem_total_kb / 1024))
((TOTAL_RAM_MB <= 0)) && TOTAL_RAM_MB=1024

if ((TOTAL_RAM_MB <= 1200)); then
  OPCACHE_MEM="64"
  INTERNED_STR="8"
  REALPATH_SIZE="512K"
elif ((TOTAL_RAM_MB <= 2500)); then
  OPCACHE_MEM="128"
  INTERNED_STR="16"
  REALPATH_SIZE="1024K"
elif ((TOTAL_RAM_MB <= 4500)); then
  OPCACHE_MEM="256"
  INTERNED_STR="32"
  REALPATH_SIZE="2048K"
else
  OPCACHE_MEM="512"
  INTERNED_STR="64"
  REALPATH_SIZE="4096K"
fi

if [[ -f "$duong_dan_php_ini" ]]; then
  tmp_php_ini="$(wptt_atomic_begin "$duong_dan_php_ini")"
  if [[ -n "$tmp_php_ini" && -f "$tmp_php_ini" ]]; then
    awk -v r_size="$REALPATH_SIZE" \
        -v op_mem="$OPCACHE_MEM" \
        -v op_str="$INTERNED_STR" \
        -v php_v="$php_ver_chon" \
        -v giatuan="${wptangtoc_ols_giatuan:-0}" '
      /^[ \t]*(realpath_cache_size|realpath_cache_ttl|opcache\.memory_consumption|opcache\.interned_strings_buffer|opcache\.max_accelerated_files|opcache\.revalidate_freq|opcache\.fast_shutdown|opcache\.enable_cli)[ \t]*=/ { next }
      php_v >= 80 && /^[ \t]*(opcache\.jit_buffer_size|opcache\.jit)[ \t]*=/ { next }
      giatuan == "1" && /^[ \t]*(opcache\.validate_timestamps|opcache\.file_update_protection)[ \t]*=/ { next }
      /^[ \t]*expose_php[ \t]*=/ { print "expose_php = Off"; next }
      /^[ \t]*upload_max_filesize[ \t]*=[ \t]*2M/ { print "upload_max_filesize = 8M"; next }
      /^[ \t]*max_execution_time[ \t]*=[ \t]*30/ { print "max_execution_time = 120"; next }
      { print }
      END {
        print "realpath_cache_size = " r_size
        print "realpath_cache_ttl = 7200"
        print "opcache.memory_consumption=" op_mem
        print "opcache.interned_strings_buffer=" op_str
        print "opcache.max_accelerated_files=32531"
        print "opcache.revalidate_freq=100"
        print "opcache.fast_shutdown=1"
        print "opcache.enable_cli=1"
        if (php_v >= 80) {
          print "opcache.jit_buffer_size=0"
        }
        if (giatuan == "1") {
          print "opcache.validate_timestamps=0"
          print "opcache.file_update_protection=0"
        }
      }
    ' "$tmp_php_ini" >"${tmp_php_ini}.new" &&
      /bin/mv -fT -- "${tmp_php_ini}.new" "$tmp_php_ini"
    wptt_atomic_commit "$tmp_php_ini" "$duong_dan_php_ini"
  fi
fi

# Đồng bộ với bộ tối ưu OPcache toàn cục nếu có
[[ -x /etc/wptt/cache/opcache-optimize-tune ]] && /etc/wptt/cache/opcache-optimize-tune >/dev/null 2>&1 || true
_rundone "$task_ini"

# ==============================================================================
# 7. ĐỒNG BỘ ATOMIC SERVER, VHOST, WP-CRON & KIỂM TRA CÚ PHÁP OLS
# ==============================================================================
task_sync="Đồng bộ phiên bản $php_version cho Server và toàn bộ Vhost"
_runing "$task_sync"

php_version_number="$phien_ban_php_co_cham"
wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "php_version_check=$php_version_number"

# Sao lưu cấu hình OLS trước khi chỉnh sửa hàng loạt để Rollback nếu lỗi cú pháp
ols_backup_dir="${tmp_work_dir}/ols_conf_backup"
/bin/mkdir -p "$ols_backup_dir"
/bin/cp -fp /usr/local/lsws/conf/httpd_config.conf "$ols_backup_dir/" 2>/dev/null || true
/bin/cp -rf /usr/local/lsws/conf/vhosts "$ols_backup_dir/" 2>/dev/null || true

OLS_HTTPD_CONF="/usr/local/lsws/conf/httpd_config.conf"
tmp_ols_httpd="$(wptt_atomic_begin "$OLS_HTTPD_CONF")" || {
  _runloi "$task_sync"
  wptt_quay_ve_menu "$route_menu" 1
}
sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "$tmp_ols_httpd"
wptt_atomic_commit "$tmp_ols_httpd" "$OLS_HTTPD_CONF"

cron_needs_restart="no"
shopt -s nullglob
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

  domain="${filepath##*/}"
  domain="${domain%.conf}"
  domain="${domain#.}"

  if [[ "$domain" != ?*.?* ]]; then
    continue
  fi

  path="/usr/local/lsws/$domain/html"
  vhost_conf="/usr/local/lsws/conf/vhosts/$domain/$domain.conf"
  if [[ -d "$path" && -f "$vhost_conf" ]]; then
    tmp_vhost="$(wptt_atomic_begin "$vhost_conf")" || continue
    sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "$tmp_vhost"
    wptt_atomic_commit "$tmp_vhost" "$vhost_conf"

    wptt_atomic_edit_config "/etc/wptt/vhost/.${domain:?}.conf" "phien_ban_php_domain=$php_version_number"

    # Đồng bộ WP-Cron nguyên tử
    cron_file="/etc/cron.d/wp-cron-job-$domain.cron"
    if [[ -f "$cron_file" ]]; then
      tmp_cron="$(wptt_atomic_begin "$cron_file")" || continue
      sed -E -i "s|/usr/local/lsws/lsphp[0-9]+/bin/php|/usr/local/lsws/lsphp${php_ver_chon}/bin/php|g" "$tmp_cron"
      wptt_atomic_commit "$tmp_cron" "$cron_file"
      cron_needs_restart="yes"
    fi
  fi
done
shopt -u nullglob

# Thiết lập Symlink FCGI & PHP CLI nguyên tử (-sfn)
ln -sfn "/usr/local/lsws/lsphp${php_ver_chon}/bin/lsphp" "/usr/local/lsws/fcgi-bin/lsphp${php_ver_chon}"
ln -sfn "/usr/local/lsws/lsphp${php_ver_chon}/bin/lsphp" "/usr/local/lsws/fcgi-bin/lsphp5"
if [[ -x "$php_cli_bin" ]]; then
  ln -sfn "$php_cli_bin" /usr/bin/php
  [[ -L /usr/local/bin/php || ! -e /usr/local/bin/php ]] && ln -sfn "$php_cli_bin" /usr/local/bin/php 2>/dev/null || true
fi

# Validate cú pháp OpenLiteSpeed trước khi Restart; Rollback nếu phát hiện lỗi
if /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
  if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
    wptt_smart_reload_lsws >/dev/null 2>&1 || /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
  else
    /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
  fi
  pkill -9 -f lsphp >/dev/null 2>&1 || true
  _rundone "$task_sync"
else
  /bin/cp -fp "$ols_backup_dir/httpd_config.conf" /usr/local/lsws/conf/ 2>/dev/null || true
  /bin/cp -rf "$ols_backup_dir/vhosts" /usr/local/lsws/conf/ 2>/dev/null || true
  _runloi "$task_sync"
  echo -e "\n${C_RED}❌ Phát hiện lỗi cú pháp OpenLiteSpeed! Đã tự động Rollback cấu hình an toàn.${C_RESET}\n"
  wptt_quay_ve_menu "$route_menu" 1
fi

if [[ "$cron_needs_restart" == "yes" ]]; then
  task_cron="Đồng bộ và khởi động lại dịch vụ WP-Cron toàn máy chủ"
  _runing "$task_cron"
  if [[ "$OS_FAMILY" == "DEBIAN" ]]; then
    systemctl restart cron.service >/dev/null 2>&1 || true
  else
    systemctl restart crond.service >/dev/null 2>&1 || true
  fi
  _rundone "$task_cron"
fi

# ==============================================================================
# 8. BẢNG BÁO CÁO THÀNH CÔNG
# ==============================================================================
clear
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT THAY ĐỔI PHP TOÀN HỆ THỐNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Phiên bản mặc định mới : ${C_YELLOW}$php_version ($php_version_name)${C_RESET}" 2
left_text "Đường dẫn PHP CLI      : ${C_BOLD_WHITE}$(/usr/bin/php -v 2>/dev/null | awk 'NR==1 {print $1, $2}')${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

wptt_quay_ve_menu "$route_menu" 0
