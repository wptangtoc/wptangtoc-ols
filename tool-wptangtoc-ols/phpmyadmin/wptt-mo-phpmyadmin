function huong_dan() {
  Tính năng Kích hoạt phpMyAdmin thường có nghĩa là truy cập và sử dụng công cụ phpMyAdmin, một ứng dụng web phổ biến để quản lý cơ sở dữ liệu MySQL hoặc MariaDB trực tiếp thông qua giao diện đồ họa trên trình duyệt.

  Nói một cách đơn giản, đây là cách bạn mở một cánh cửa có giao diện thân thiện để làm việc với database của website mình, thay vì phải dùng các dòng lệnh phức tạp.

  Mục Đích Chính [Chức năng của phpMyAdmin]
  * Quản lý cơ sở dữ liệu [Database]: Tạo, xóa, sửa đổi database.
  * Quản lý bảng [Table]: Tạo, sửa, xóa bảng quản lý cột, chỉ mục [index].
  * Thao tác dữ liệu: Xem, tìm kiếm, thêm, sửa, xóa các hàng dữ liệu trong bảng.
  * Thực thi lệnh SQL: Cho phép bạn chạy các truy vấn SQL tùy chỉnh.
  * Import/Export dữ liệu: Nhập dữ liệu từ file [SQL, CSV] vào database hoặc xuất database/bảng ra các định dạng khác nhau [quan trọng cho việc sao lưu và di chuyển].
  * Quản lý người dùng database: Tạo và quản lý quyền của người dùng truy cập database [nếu có đủ quyền].

  Sau khi kích hoạt [truy cập], bạn có thể bắt đầu quản lý cơ sở dữ liệu của website một cách trực quan.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. /etc/wptt/lang/$ngon_ngu.sh 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Thư viện Xác nhận

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ PHPMYADMIN ➜ $bat PhpMyAdmin${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

[[ -z "$Website_chinh" ]] && {
  echo -e "${C_RED}❌ Lỗi: Không xác định được website chính của hệ thống này!${C_RESET}"
  echo -e "Không thể bật PhpMyAdmin."
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-phpmyadmin-main 1
  return 2>/dev/null || exit 1
}

if [[ -n "$id_dang_nhap_phpmyadmin" && -d "/usr/local/lsws/$Website_chinh/html/phpmyadmin" ]]; then
  echo -e "${C_YELLOW}⚠️ Bạn đã kích hoạt PhpMyadmin trước đó rồi!${C_RESET}"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-phpmyadmin-main 1
  exit
fi

# ==============================================================================
# KHAI BÁO BIẾN DÙNG CHUNG (FIX LỖI MẤT BIẾN)
# ==============================================================================
phpmyadmin_version="5.2.3"

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

if [[ -f "/usr/local/lsws/admin/fcgi-bin/admin_php" ]]; then
  PHP_Command="/usr/local/lsws/admin/fcgi-bin/admin_php"
else
  PHP_Command="/usr/local/lsws/admin/fcgi-bin/admin_php5"
fi

# ==============================================================================
# TẢI VÀ GIẢI NÉN PHPMYADMIN (UX ĐỘNG CƠ TÀNG HÌNH & CHỐNG NGHẼN MẠNG)
# ==============================================================================
_runing "Đang tải PhpMyadmin $phpmyadmin_version..."
cd "/usr/local/lsws/$Website_chinh/html" || exit 1

pma_zip="/usr/local/lsws/$Website_chinh/html/phpMyAdmin-$phpmyadmin_version-all-languages.zip"
rm -f "$pma_zip" # Dọn rác file cũ nếu có

git_version="${phpmyadmin_version//./_}"
# 1. Trạm gốc phpMyAdmin
URL_1="https://files.phpmyadmin.net/phpMyAdmin/$phpmyadmin_version/phpMyAdmin-$phpmyadmin_version-all-languages.zip"
# 2. Trạm Github Release (Bản Build chuẩn, không phải bản Source thô)
URL_2="https://github.com/phpmyadmin/phpmyadmin/releases/download/RELEASE_${git_version}/phpMyAdmin-$phpmyadmin_version-all-languages.zip"
# 3. Trạm Proxy siêu tốc (Dùng khi cáp quang biển đứt)
URL_3="https://mirror.ghproxy.com/$URL_2"

echo "" # Tạo một dòng trống cho thanh tiến trình PV chạy mượt

function wptt_download_pma_ux() {
  local url="$1"
  
  # Thêm cờ -L để đi theo 302 Redirect và tail -n 1 lấy dung lượng thật
  local fsize=$(curl -sIL --max-time 5 "$url" | grep -i -E "content-length" | tail -n 1 | awk '{print $2}' | tr -d '\r')
  
  if command -v pv &>/dev/null && [[ -n "$fsize" && "$fsize" -gt 0 ]]; then
    # Ép ngắt nếu tốc độ dưới 100KB/s trong 8 giây
    curl -sL --connect-timeout 5 --speed-limit 102400 --speed-time 8 "$url" | pv -s "$fsize" -N "Tải PhpMyAdmin" -p -t -e -r -b -w 90 > "$pma_zip"
    local dl_status=${PIPESTATUS[0]}
    
    # Tàng hình: lùi lên 1 dòng, xóa sạch tiến trình
    echo -en "\033[1A\033[2K\r"
    return $dl_status
  else
    # Phương án dự phòng với Wget (Giao diện chuẩn 1 dòng)
    wget -q --show-progress --timeout=8 --tries=2 "$url" -O "$pma_zip"
    local dl_status=$?
    
    echo -en "\033[1A\033[2K\r"
    return $dl_status
  fi
}

# Vòng lặp tải thông minh (Thử lần lượt từng Link)
success_download=0
for url in "$URL_1" "$URL_2" "$URL_3"; do
  if wptt_download_pma_ux "$url"; then
    # Kiểm tra tính toàn vẹn của File Zip (Tránh giải nén lỗi làm sập phpMyAdmin)
    if unzip -t "$pma_zip" &>/dev/null; then
      success_download=1
      break # Tải hoàn hảo -> Thoát vòng lặp!
    fi
  fi
  rm -f "$pma_zip" # Nếu lỗi hoặc file hỏng, xóa đi để thử link tiếp theo
done

if [[ $success_download -eq 0 ]]; then
  _runloi "Tải PhpMyAdmin thất bại"
  echo -e "${C_RED}Lỗi: Mạng quốc tế nghẽn, không thể tải PhpMyAdmin. Vui lòng thử lại sau!${C_RESET}"
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-phpmyadmin-main 1
  return 2>/dev/null || exit 1
fi

# Xóa nốt dòng trống để UI khít lại
echo -en "\033[1A\033[2K\r"

# ==============================================================================
# BẮT ĐẦU XỬ LÝ FILE VÀ CẤU HÌNH
# ==============================================================================
unzip -oq "$pma_zip"
mv "/usr/local/lsws/$Website_chinh/html/phpMyAdmin-$phpmyadmin_version-all-languages" "/usr/local/lsws/$Website_chinh/html/phpmyadmin"

if [[ ! -d "/usr/local/lsws/$Website_chinh/html/phpmyadmin" ]]; then
  _runloi "Giải nén PhpMyadmin $phpmyadmin_version..."
  exec /etc/wptt/wptt-phpmyadmin-main 1
fi
_rundone "Tải và cài đặt PhpMyadmin $phpmyadmin_version"

rm -f "$pma_zip"

cp -f "/usr/local/lsws/$Website_chinh/html/phpmyadmin/config.sample.inc.php" "/usr/local/lsws/$Website_chinh/html/phpmyadmin/config.inc.php"
mkdir -p /usr/local/lsws/phpmyadmin
echo "\$cfg['TempDir'] = '/usr/local/lsws/phpmyadmin';" >>"/usr/local/lsws/$Website_chinh/html/phpmyadmin/config.inc.php"

secret=$(date | md5sum | cut -c '1-32')
sed -i "s/\$cfg\['blowfish_secret'\] = '';/\$cfg\['blowfish_secret'\] = '$secret';/" "/usr/local/lsws/$Website_chinh/html/phpmyadmin/config.inc.php"

chown -R nobody:$tuong_thich_nhom_litespeed /usr/local/lsws/phpmyadmin
chown -R nobody:$tuong_thich_nhom_litespeed "/usr/local/lsws/$Website_chinh/html/phpmyadmin"
chmod 555 /usr/local/lsws/phpmyadmin

# ==============================================================================
# TẠO TÀI KHOẢN BẢO MẬT 2 LỚP (HTTP BASIC AUTH)
# ==============================================================================
mkdir -p "/usr/local/lsws/$Website_chinh/passwd"
Webadmin_Pass=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 36)
id_ols_admin=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 24)

# Biến $PHP_Command giờ đã được nạp chuẩn xác!
Encrypt_string=$($PHP_Command -q /usr/local/lsws/admin/misc/htpasswd.php "${Webadmin_Pass}")

echo "$id_ols_admin:$Encrypt_string" >"/usr/local/lsws/$Website_chinh/passwd/.phpmyadmin"

# Dọn dẹp cấu hình cũ và tiêm cấu hình mới vào Vhost
sed -i -e "/^realm ${Website_chinh}phpmyadmin/,/^}/d" "/usr/local/lsws/conf/vhosts/$Website_chinh/$Website_chinh.conf" 2>/dev/null
sed -i -e "/^context \/phpmyadmin\//,/^}/d" "/usr/local/lsws/conf/vhosts/$Website_chinh/$Website_chinh.conf" 2>/dev/null

cat <<EOF >>"/usr/local/lsws/conf/vhosts/$Website_chinh/$Website_chinh.conf"
realm ${Website_chinh}phpmyadmin {
  userDB  {
    location              /usr/local/lsws/$Website_chinh/passwd/.phpmyadmin
  }
}
context /phpmyadmin/ {
  location                phpmyadmin/
  allowBrowse             1
  realm                   ${Website_chinh}phpmyadmin

  accessControl  {
    allow                 ALL
  }

  rewrite  {

  }
  addDefaultCharset       off

  phpIniOverride  {
php_value upload_max_filesize 10G
php_value max_file_uploads 10000
php_value post_max_size 10G
php_value max_execution_time 10000
php_admin_value open_basedir ""
  }
}
EOF

# Cập nhật config panel
sed -i "/id_dang_nhap_phpmyadmin/d" /etc/wptt/.wptt.conf
sed -i "/password_dang_nhap_phpmyadmin/d" /etc/wptt/.wptt.conf
echo "id_dang_nhap_phpmyadmin=$id_ols_admin" >>/etc/wptt/.wptt.conf
echo "password_dang_nhap_phpmyadmin=$Webadmin_Pass" >>/etc/wptt/.wptt.conf

chown nobody:$tuong_thich_nhom_litespeed "/usr/local/lsws/$Website_chinh/passwd/.phpmyadmin"
chmod 400 "/usr/local/lsws/$Website_chinh/passwd/.phpmyadmin"

# ==============================================================================
# TƯƠNG THÍCH TƯỜNG LỬA 8G
# ==============================================================================
htaccess_path="/usr/local/lsws/$Website_chinh/html/.htaccess"
if grep -q '#begin-tuong-lua-bao-mat-8g' "$htaccess_path" 2>/dev/null; then
  if ! grep -q 'phpmyadmin/index\\.php' "$htaccess_path" 2>/dev/null; then
    sed -i '/RewriteCond %{QUERY_STRING} \^(%2d|-)/i \ \ \ \ RewriteCond %{REQUEST_URI} !^\/phpmyadmin\/index\\.php$ [NC]' "$htaccess_path"
  fi
fi

# ==============================================================================
# RELOAD SERVICE VÀ BÁO CÁO
# ==============================================================================
_runing "Đang nạp lại cấu hình OpenLiteSpeed..."
wptt_smart_reload_lsws >/dev/null 2>&1

_rundone "Cài đặt và kích hoạt PhpMyadmin $phpmyadmin_version"
echo "Kích hoạt PhpMyAdmin: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

# ==============================================================================
# IN THÔNG TIN TÀI KHOẢN (UX BO CONG - CĂN LỀ CHUẨN XÁC)
# ==============================================================================
box_inner_width=${box_inner_width:-71}

ssl_xac_thuc_kha_dung="false"
. /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$Website_chinh" >/dev/null 2>&1

if [[ "$ssl_xac_thuc_kha_dung" == "true" ]]; then
  url_truy_cap="https://$Website_chinh/phpmyadmin"
else
  url_truy_cap="http://$Website_chinh/phpmyadmin"
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT! HÃY LƯU TRỮ CÁC THÔNG TIN ĐĂNG NHẬP SAU:${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

function in_dong() {
  local raw_text="$1"
  local colored_text="$2"
  # Sửa lỗi đếm byte của bash khi gặp ký tự tiếng việt
  local len=$(echo -n "$raw_text" | awk '{print length($0)}')
  local pad=$((box_inner_width - len))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_GREEN}│${C_RESET}${colored_text}$(printf '%*s' "$pad" "")${C_GREEN}│${C_RESET}"
}

in_dong "  Đường dẫn truy cập : $url_truy_cap" "  ${C_BOLD_WHITE}Đường dẫn truy cập :${C_RESET} ${C_CYAN}$url_truy_cap${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
in_dong "  LỚP 1: BẢO MẬT MÁY CHỦ (Bắt buộc khi truy cập link)" "  ${C_BOLD_WHITE}LỚP 1: BẢO MẬT MÁY CHỦ (Bắt buộc khi truy cập link)${C_RESET}"
in_dong "  User bảo mật       : $id_ols_admin" "  User bảo mật       : ${C_YELLOW}$id_ols_admin${C_RESET}"
in_dong "  Password           : $Webadmin_Pass" "  Password           : ${C_YELLOW}$Webadmin_Pass${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
in_dong "  LỚP 2: TÀI KHOẢN CỦA CÁC DATABASE ĐANG CÓ TRÊN HỆ THỐNG" "  ${C_BOLD_WHITE}LỚP 2: TÀI KHOẢN CỦA CÁC DATABASE ĐANG CÓ TRÊN HỆ THỐNG${C_RESET}"

for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
  domain="${filepath##*/}"
  domain="${domain%.conf}"
  domain="${domain#.}"
  path_html="/usr/local/lsws/$domain/html"

  if [[ -d "$path_html" ]]; then
    DB_User_web=""
    DB_Password_web=""
    . "$filepath"

    in_dong "  ▪ Website  : $domain" "  ${C_BOLD_WHITE}▪ Website  :${C_RESET} ${C_GREEN}$domain${C_RESET}"
    in_dong "    User DB  : ${DB_User_web:-Chưa thiết lập}" "    User DB  : ${C_YELLOW}${DB_User_web:-Chưa thiết lập}${C_RESET}"
    in_dong "    Pass DB  : ${DB_Password_web:-Chưa thiết lập}" "    Pass DB  : ${C_YELLOW}${DB_Password_web:-Chưa thiết lập}${C_RESET}"
