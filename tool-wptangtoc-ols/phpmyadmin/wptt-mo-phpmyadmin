echo -e "${C_CYAN}Ghi chú:${C_RESET} Bạn có thể xem lại tài khoản tại menu: WPTangToc OLS => Quản lý PhpMyAdmin"
echo -en "${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
read -r dummy

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-phpmyadmin-main 1
