. /etc/wptt/core-functions 2>/dev/null

# ==============================================================================
# CHỐT CHẶN HỆ ĐIỀU HÀNH CENTOS 7
# ==============================================================================
if grep -qi 'ID="centos"' /etc/os-release 2>/dev/null && grep -qE 'VERSION_ID="?7"?' /etc/os-release 2>/dev/null; then
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_RED}│${C_RESET} ${C_YELLOW}CẢNH BÁO: HỆ ĐIỀU HÀNH KHÔNG CÒN ĐƯỢC HỖ TRỢ${C_RESET}                               ${C_RED}│${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "${C_RED}│${C_RESET} Tính năng cập nhật này đã chính thức ngừng hoạt động trên ${C_BOLD_WHITE}CentOS 7${C_RESET}.       ${C_RED}│${C_RESET}"
  echo -e "${C_RED}│${C_RESET} Hiện tại CentOS 7 đã hết vòng đời (End-of-Life) và không còn an toàn.       ${C_RED}│${C_RESET}"
  echo -e "${C_RED}│${C_RESET} Vui lòng chuyển qua sử dụng ${C_GREEN}AlmaLinux 9${C_RESET} để tiếp tục nhận bản cập nhật!  ${C_RED}│${C_RESET}"
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  exit 1
fi

. /etc/wptt/.wptt.conf 2>/dev/null

EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
KEY_EMAIL="giatuan@wptangtoc.com"

# ==============================================================================
# HÀM XÁC THỰC CHỮ KÝ GPG CHUẨN ENTERPRISE (VALIDSIG & SUBKEY COMPATIBLE)
# ==============================================================================
verify_gpg_package() {
  local data_file="$1"
  local sig_file="$2"
  local pkg_name="$3"

  if [[ ! -s "$data_file" || ! -s "$sig_file" ]]; then
    _runloi "Gói mã nguồn $pkg_name hoặc file chữ ký bị rỗng/không tải được!"
    return 1
  fi

  local status_out
  status_out=$(gpg --status-fd 1 --batch --verify "$sig_file" "$data_file" 2>/dev/null || true)

  if grep -qE '\[GNUPG:\] (BADSIG|ERRSIG|EXPSIG|EXPKEYSIG|REVKEYSIG)' <<<"$status_out"; then
    return 1
  fi

  if ! grep -q '\[GNUPG:\] GOODSIG' <<<"$status_out"; then
    return 1
  fi

  if grep -q '\[GNUPG:\] VALIDSIG' <<<"$status_out"; then
    if ! grep -qE "${EXPECTED_FP}" <<<"$status_out"; then
      return 1
    fi
  fi

  return 0
}

# ==============================================================================
# KIỂM TRA PHIÊN BẢN MỚI
# ==============================================================================
wptangtocols_version=$(curl --tlsv1.3 -sL --connect-timeout 60 --max-time 60 "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update-tu-dong=${Website_chinh:-}")
[[ -z "$wptangtocols_version" ]] && wptangtocols_version=$(curl --tlsv1.2 -sL --connect-timeout 60 --max-time 60 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt")

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then

  OLD_PWD=$(pwd)
  TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
  cd "$TMP_DIR" || exit 1

  # Nạp Public Key (Nếu chưa có)
  if ! gpg --list-keys "$EXPECTED_FP" >/dev/null 2>&1; then
    curl --tlsv1.3 -sL --connect-timeout 10 "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key

    # Dự phòng Github
    if [[ ! -s wptangtoc-gpg-pub.key ]]; then
      curl --tlsv1.2 -sL --connect-timeout 10 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
    fi

    # Đọc Fingerprint thực tế (Chỉ lấy dòng đầu của Master Key)
    real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

    # Kiểm định khắt khe
    if [[ -n "$real_fp" && "${real_fp^^}" == "${EXPECTED_FP^^}" ]]; then
      gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
    else
      # Bị tráo Key: Dọn dẹp và thoát
      cd "$OLD_PWD" || cd /root || exit 1
      rm -rf "${TMP_DIR:?}"
      exit 1
    fi
    rm -f wptangtoc-gpg-pub.key 2>/dev/null || true
  fi

  # Tải File Core (.zip) và File Chữ Ký (.sig)
  wget -q --timeout=15 --tries=3 "https://wptangtoc.com/share/wptangtoc-ols.zip" -O wptangtoc-ols.zip
  wget -q --timeout=15 --tries=3 "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" -O wptangtoc-ols.zip.sig

  # Dự phòng Github nếu máy chủ gốc sập
  if [[ ! -s wptangtoc-ols.zip || ! -s wptangtoc-ols.zip.sig ]]; then
    wget -q --timeout=15 --tries=3 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" -O wptangtoc-ols.zip
    wget -q --timeout=15 --tries=3 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" -O wptangtoc-ols.zip.sig
  fi

  # Quét xác thực GPG qua hàm verify_gpg_package
  if ! verify_gpg_package "wptangtoc-ols.zip" "wptangtoc-ols.zip.sig" "Core"; then
    cd "$OLD_PWD" || cd /root || exit 1
    rm -rf "${TMP_DIR:?}"
    exit 1
  fi

  # ==========================================================================
  # QUY TRÌNH ROLLBACK & CÀI ĐẶT
  # ==========================================================================
  OLD_UMASK=$(umask)
  umask 077

  mkdir -p /etc/wptt/wptt-backup-system
  timedate=$(date +%Hgio_%d_%m_%Y)
  BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:$version_wptangtoc_ols.zip"

  (
    cd /etc/wptt &&
      zip -r -q "$BACKUP_FILE" . \
        -x "wptt-backup-system/*" \
        -x ".wptt.conf" \
        -x "vhost/*" 2>/dev/null
  )

  # Nối file binary vào backup
  if [ -f "$BACKUP_FILE" ]; then 
    zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop 2>/dev/null || true
  fi

  # Chỉ lưu tối đa 10 bản backup
  ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r rm -f 2>/dev/null || true

  kiem_tra_ton_tai_nhom=$(grep -E '^wptangtoc-ols:' /etc/group 2>/dev/null || true)

  unzip -oq wptangtoc-ols.zip

  # Nếu chép đè thất bại -> Tự động Rollback lại bản cũ
  if ! \cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then 
    umask "$OLD_UMASK"
    unzip -oq "$BACKUP_FILE" -d /etc/wptt/ 2>/dev/null || true
    \cp -f /etc/wptt/wptangtoc /usr/bin
    rm -f /etc/wptt/wptangtoc
    \cp -f /etc/wptt/wptt /usr/bin
    rm -f /etc/wptt/wptt
    \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin 2>/dev/null || true
    cd "$OLD_PWD" || cd /root || exit 1
    rm -rf "${TMP_DIR:?}"
    exit 1
  fi

  umask "$OLD_UMASK"

  rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
  rm -rf tool-wptangtoc-ols

  [[ -d /etc/wptt/wptt-child ]] && \cp -rf /etc/wptt/wptt-child/* /etc/wptt 2>/dev/null || true

  chmod -R 700 /etc/wptt
  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    chown root:wptangtoc-ols /etc/wptt
    chown root:wptangtoc-ols /etc/wptt/vhost
    chmod 750 /etc/wptt
    chmod 750 /etc/wptt/vhost
  else
    chown root:root /etc/wptt
    chown root:root /etc/wptt/vhost
    chmod 700 /etc/wptt
    chmod 700 /etc/wptt/vhost
  fi

  \cp -f /etc/wptt/wptangtoc /usr/bin
  rm -f /etc/wptt/wptangtoc
  \cp -f /etc/wptt/wptt /usr/bin
  rm -f /etc/wptt/wptt
  \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin 2>/dev/null || true

  # ==========================================================================
  # CẬP NHẬT PHÂN QUYỀN VHOST THEO CƠ CHẾ BẢO MẬT (ZERO TRUST)
  # ==========================================================================
  chown root:root /etc/wptt/.wptt.conf
  chmod 600 /etc/wptt/.wptt.conf

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    # 1. Trạng thái mặc định: Đóng băng tuyệt đối (Auto-Healing)
    chown root:root "$filepath"
    chmod 600 "$filepath"

    # 2. Kiểm tra nới lỏng quyền nếu hệ thống có sử dụng Jail
    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      path_site="/usr/local/lsws/$domain"

      # Xác định lồng Jail đang hoạt động (có thư mục /etc của root)
      if [[ -d "$path_site" && -d "$path_site/etc" ]]; then
        if [[ $(stat -c '%U' "$path_site/etc" 2>/dev/null) == "root" ]]; then
          check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"' | tr -d "'")

          if [[ -n "$check_user_vhost" ]]; then
            if grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
              chown root:wptangtoc-ols "$filepath"
              chmod 640 "$filepath"
            fi
          fi
        fi
      fi
    fi
  done

  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure" 2>/dev/null || true
  echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true

  # ==========================================================================
  # Cấu hình phụ trợ (Script Update server & Dự phòng Github bọc GPG)
  # ==========================================================================
  # 1. Tải file update và file chữ ký số
  curl --tlsv1.3 -sO https://wptangtoc.com/share/update --connect-timeout 10 --max-time 15
  curl --tlsv1.3 -sO https://hub.wptangtoc.com/update.sig --connect-timeout 10 --max-time 15 -A "checksum wptangtoc ols"

  # 2. Dự phòng nếu tải thất bại hoặc file trống
  if [[ ! -s update || ! -s update.sig ]]; then
    curl --tlsv1.2 -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update --connect-timeout 10 --max-time 15
    curl --tlsv1.2 -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig --connect-timeout 10 --max-time 15
  fi

  # 3. Quét GPG qua verify_gpg_package và chỉ thực thi khi 100% chính chủ
  if [[ -s update && -s update.sig ]] && verify_gpg_package "update" "update.sig" "UpdateScript"; then
    if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
      bash update >/dev/null 2>&1 || true
    fi
  fi

  # 4. Dọn rác
  rm -f update update.sig 2>/dev/null || true

  cd "$OLD_PWD" || cd /root || exit 0
  rm -rf "${TMP_DIR:?}"
fi
