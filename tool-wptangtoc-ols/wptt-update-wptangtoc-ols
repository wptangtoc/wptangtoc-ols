#!/bin/bash
. /etc/wptt/.wptt.conf

wptangtocols_version=$(curl -sL --connect-timeout 60 --max-time 60 "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update-tu-dong=$Website_chinh")
[[ -z "$wptangtocols_version" ]] && wptangtocols_version=$(curl -sL --connect-timeout 60 --max-time 60 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt")

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then

  OLD_PWD=$(pwd)
  TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
  cd "$TMP_DIR" || exit

  # Nạp Public Key (Nếu chưa có)
  if ! gpg --list-keys "giatuan@wptangtoc.com" >/dev/null 2>&1; then
	  # Tải key về thư mục tạm
	  curl -sL --connect-timeout 10 "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key

  # Dự phòng Github
  if [[ ! -s wptangtoc-gpg-pub.key ]]; then
	  curl -sL --connect-timeout 10 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" -o wptangtoc-gpg-pub.key
  fi

  # Đọc Fingerprint thực tế (Chỉ lấy dòng đầu của Master Key)
  real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

  # Fingerprint "chuẩn" của tác giả
  expected_fp="EE091EEB9A5189BC80837C059AA528D37B902267"

  # Kiểm định khắt khe
  if [[ -n "$real_fp" && "$real_fp" == "$expected_fp" ]]; then
	  gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
  else
	  # Bị tráo Key! Âm thầm dọn dẹp và thoát để không tạo rác log
	  cd /root || exit
	  rm -rf "$TMP_DIR"
	  exit
  fi
  fi


  # Tải File Core (.zip) và File Chữ Ký (.sig)
  wget -q --timeout=15 --tries=3 "https://wptangtoc.com/share/wptangtoc-ols.zip" -O wptangtoc-ols.zip
  wget -q --timeout=15 --tries=3 "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" -O wptangtoc-ols.zip.sig
  
  # Dự phòng Github nếu máy chủ gốc sập
  if [[ ! -s wptangtoc-ols.zip || ! -s wptangtoc-ols.zip.sig ]]; then
      wget -q --timeout=15 --tries=3 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" -O wptangtoc-ols.zip
      wget -q --timeout=15 --tries=3 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" -O wptangtoc-ols.zip.sig
  fi

  # Quét xác thực GPG - Thoát âm thầm nếu phát hiện giả mạo hoặc lỗi file
  if ! gpg --verify wptangtoc-ols.zip.sig wptangtoc-ols.zip 2>/dev/null; then
    cd "$OLD_PWD" || cd /root || exit
    rm -rf "$TMP_DIR"
    exit
  fi

  # ==========================================================================
  # QUY TRÌNH ROLLBACK & CÀI ĐẶT
  # ==========================================================================
  # Backup trước khi update để phục vụ rollback
  mkdir -p /etc/wptt/wptt-backup-system
  timedate=$(date +%Hgio_%d_%m_%Y)
  BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:$version_wptangtoc_ols.zip"

  (
    cd /etc/wptt &&
      zip -r -q "$BACKUP_FILE" . \
        -x "wptt-backup-system/*" \
        -x ".wptt.conf" \
        -x "vhost/*"
  )

  # Nối file /usr/bin/wptangtoc /usr/bin/wptt vào backup
  if [ -f "$BACKUP_FILE" ]; then 
    zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop
  fi

  # Chỉ lưu tối đa 10 bản backup
  ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r rm -f 

  kiem_tra_ton_tai_nhom=$(cat /etc/group | grep '^wptangtoc-ols:')

  unzip -oq wptangtoc-ols.zip

  # Nếu chép đè thất bại -> Tự động Rollback lại bản cũ
  if ! \cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then 
    unzip -oq "$BACKUP_FILE" -d /etc/wptt/
    \cp -f /etc/wptt/wptangtoc /usr/bin
    rm -f /etc/wptt/wptangtoc
    \cp -f /etc/wptt/wptt /usr/bin
    rm -f /etc/wptt/wptt
    cd "$OLD_PWD" || cd /root || exit
    rm -rf "$TMP_DIR"
    exit
  fi

  rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
  rm -rf tool-wptangtoc-ols

  if [[ -d /etc/wptt-child ]]; then
    \cp -rf /etc/wptt-child/* /etc/wptt
  fi

  chmod -R 700 /etc/wptt
  if [[ $kiem_tra_ton_tai_nhom ]]; then
    chown root:wptangtoc-ols /etc/wptt
    chown root:wptangtoc-ols /etc/wptt/vhost
    chmod 750 /etc/wptt
    chmod 750 /etc/wptt/vhost
  else
    chown root:root /etc/wptt
    chown root:root /etc/wptt/vhost
    chmod 700 /etc/wptt
    chmod 700 /etc/wptt/vhost
  fi

  \cp -f /etc/wptt/wptangtoc /usr/bin
  rm -f /etc/wptt/wptangtoc
  \cp -f /etc/wptt/wptt /usr/bin
  rm -f /etc/wptt/wptt

  if [[ $kiem_tra_ton_tai_nhom ]]; then
    for entry in $(ls -A /etc/wptt/vhost | grep -v '^\.\.conf$' | sort -uV); do
      domain=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//')
      path="/usr/local/lsws/$domain/html"
      if [[ -d "$path" && -f /etc/wptt/vhost/.$domain.conf ]]; then
        . /etc/wptt/vhost/."$domain".conf
        # ktra username đó có khởi tạo vào nhom wptangtoc ols không
        if [[ $(cat /etc/group | grep '^wptangtoc-ols:' | grep "$User_name_vhost") ]]; then 
          chown "$User_name_vhost":"$User_name_vhost" /etc/wptt/vhost/."$domain".conf
        fi
      fi
    done
  fi

  sed -i "/version_wptangtoc_ols/d" /etc/wptt/.wptt.conf
  echo "version_wptangtoc_ols=$wptangtocols_version" >>/etc/wptt/.wptt.conf
  echo "$wptangtocols_version" >/tmp/wptangtoc-ols-version

	  # ==========================================================================
	  # Cấu hình phụ trợ (Script Update server & Dự phòng Github bọc GPG)
	  # ==========================================================================
	  # 1. Tải file update và file chữ ký số
	  curl -sO https://wptangtoc.com/share/update --connect-timeout 10 --max-time 15
	  curl -sO https://hub.wptangtoc.com/update.sig --connect-timeout 10 --max-time 15 -A "checksum wptangtoc ols"

	# 2. Dự phòng nếu tải thất bại hoặc file trống
	if [[ ! -s update || ! -s update.sig ]]; then
		curl -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update --connect-timeout 10 --max-time 15
		curl -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig --connect-timeout 10 --max-time 15
	fi

	# 3. Quét GPG và chỉ thực thi khi 100% chính chủ
	if [[ -s update && -s update.sig ]] && gpg --verify update.sig update 2>/dev/null; then
		if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
			bash update >/dev/null 2>&1
		fi
	fi

	# 4. Dọn rác
	rm -f update update.sig

  cd "$OLD_PWD" || cd /root || exit
  rm -rf "$TMP_DIR"
# Hoàn tất auto-update
fi
