# @email: giatuan@wptangtoc.com
# @since: 2026

set -Eeuo pipefail

# ==============================================================================
# 0. QUẢN LÝ KHÓA TIẾN TRÌNH (MUTEX LOCKING CHO CHẠY NGẦM)
# ==============================================================================
LOCK_FILE="/run/lock/wptangtoc-update.lock"
[[ ! -d /run/lock ]] && LOCK_FILE="/tmp/wptangtoc-update.lock"

exec 200>"$LOCK_FILE"

# Không chờ đợi; nếu có tiến trình update khác đang chạy thì âm thầm thoát
if ! flock -n 200; then
  exit 0
fi

# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG & CORE FUNCTIONS
# ==============================================================================
PATH='/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin'

# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true
# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null || true

readonly EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
readonly KEY_EMAIL="giatuan@wptangtoc.com"

# ==============================================================================
# CHỐT CHẶN HỆ ĐIỀU HÀNH CENTOS 7
# ==============================================================================
if grep -qi 'ID="centos"' /etc/os-release 2>/dev/null && grep -qE 'VERSION_ID="?7"?' /etc/os-release 2>/dev/null; then
  exit 1
fi

# ==============================================================================
# HÀM TIỆN ÍCH BẢO MẬT & RETRY LOGIC
# ==============================================================================
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    if curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 45 -A "$user_agent" "$url" -o "$dest"; then
      return 0
    fi
    sleep 3
    attempt=$((attempt + 1))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    local result
    result=$(curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 60 "$url" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo "$result"
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  return 1
}

# Xác thực chữ ký số bằng keyring hệ thống đối soát VALIDSIG
verify_gpg_validsig() {
  local sig_file="$1"
  local target_file="$2"

  [[ ! -s "$sig_file" || ! -s "$target_file" ]] && return 1

  local gpg_output gpg_ec=0
  gpg_output=$(gpg --status-fd 1 --batch --verify "$sig_file" "$target_file" 2>/dev/null) || gpg_ec=$?

  if [[ $gpg_ec -ne 0 ]]; then
    return 1
  fi

  local signer_fp primary_fp is_valid=0
  while IFS= read -r line; do
    if [[ "$line" =~ ^\[GNUPG:\]\ VALIDSIG[[:space:]]+([A-Fa-f0-9]+)[[:space:]]+.*[[:space:]]+([A-Fa-f0-9]+)$ ]]; then
      signer_fp="${BASH_REMATCH[1]}"
      primary_fp="${BASH_REMATCH[2]}"
      if [[ "$signer_fp" == "$EXPECTED_FP" || "$primary_fp" == "$EXPECTED_FP" ]]; then
        is_valid=1
        break
      fi
    fi
  done <<<"$gpg_output"

  [[ $is_valid -eq 1 ]]
}

# ==============================================================================
# KIỂM TRA PHIÊN BẢN TỰ ĐỘNG
# ==============================================================================
wptangtocols_version=$(get_version_safe "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update-tu-dong=${Website_chinh:-}")
[[ -z "$wptangtocols_version" ]] && wptangtocols_version=$(get_version_safe "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt")

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "${version_wptangtoc_ols:-}" ]]; then

  OLD_PWD=$(pwd)
  mkdir -p /etc/wptt/tmp
  chmod 700 /etc/wptt/tmp

  TMP_DIR=$(mktemp -d /etc/wptt/tmp/autoupdate_XXXXXX)
  chmod 700 "$TMP_DIR"

  cleanup_on_exit() {
    local exit_code=$?
    cd "$OLD_PWD" || cd /root || true
    if [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]]; then
      rm -rf "${TMP_DIR:?}"
    fi
    flock -u 200 2>/dev/null || true
    exec 200>&- 2>/dev/null || true
    exit "$exit_code"
  }
  trap cleanup_on_exit EXIT SIGINT SIGTERM

  cd "$TMP_DIR" || exit 0

  # Nạp Public Key (nếu chưa có trong keyring)
  if ! gpg --list-keys "$EXPECTED_FP" 2>/dev/null | grep -qi "$KEY_EMAIL"; then
    PUB_KEY_FETCH="$TMP_DIR/wptangtoc-gpg-pub.key"
    if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "$PUB_KEY_FETCH"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "$PUB_KEY_FETCH" || true
    fi

    real_fp=$(gpg --show-keys --with-colons "$PUB_KEY_FETCH" 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1 || true)

    if [[ -n "$real_fp" && "$real_fp" == "$EXPECTED_FP" ]]; then
      gpg --batch --import "$PUB_KEY_FETCH" >/dev/null 2>&1 || true
    else
      # Khóa giả mạo -> Thoát âm thầm để không tạo rác
      exit 0
    fi
    rm -f "$PUB_KEY_FETCH"
  fi

  # Tải File Core (.zip) và File Chữ Ký (.sig)
  if ! secure_download "https://wptangtoc.com/share/wptangtoc-ols.zip" "wptangtoc-ols.zip"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" "wptangtoc-ols.zip" || true
  fi
  if ! secure_download "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig" "checksum wptangtoc ols"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig" || true
  fi

  # Xác thực nghiêm ngặt bằng VALIDSIG
  if ! verify_gpg_validsig "wptangtoc-ols.zip.sig" "wptangtoc-ols.zip"; then
    exit 0
  fi

  # ==========================================================================
  # QUY TRÌNH ROLLBACK & CÀI ĐẶT
  # ==========================================================================
  has_wptt_group=0
  if grep -q '^wptangtoc-ols:' /etc/group 2>/dev/null; then
    has_wptt_group=1
  fi

  OLD_UMASK=$(umask)
  umask 077

  mkdir -p /etc/wptt/wptt-backup-system
  timedate=$(date +%Hgio_%d_%m_%Y)
  BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:${version_wptangtoc_ols:-old}.zip"

  (
    cd /etc/wptt &&
      zip -r -q "$BACKUP_FILE" . \
        -x "wptt-backup-system/*" \
        -x ".wptt.conf" \
        -x ".ram_hien_tai" \
        -x "vhost/*" \
        -x "tmp/*"
  )

  for bin_file in /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop; do
    [[ -f "$bin_file" ]] && zip -g -j -q "$BACKUP_FILE" "$bin_file"
  done

  # Chỉ lưu tối đa 10 bản backup
  find /etc/wptt/wptt-backup-system/ -maxdepth 1 -name "*.zip" -type f -printf '%T@ %p\n' 2>/dev/null |
    sort -k1,1nr | tail -n +11 | cut -d' ' -f2- | xargs -r rm -f

  unzip -oq wptangtoc-ols.zip

  # Chép đè mã nguồn mới; nếu thất bại tự động hoàn tác
  if ! \cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then
    umask "$OLD_UMASK"
    unzip -oq "$BACKUP_FILE" -d /etc/wptt/
    \cp -f /etc/wptt/wptangtoc /usr/bin/
    rm -f /etc/wptt/wptangtoc
    \cp -f /etc/wptt/wptt /usr/bin/
    rm -f /etc/wptt/wptt
    [[ -f /etc/wptt/tai-nguyen-server/wtop ]] && \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin/
    exit 0
  fi
  umask "$OLD_UMASK"

  rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
  rm -rf tool-wptangtoc-ols

  [[ -d /etc/wptt/wptt-child ]] && \cp -rf /etc/wptt/wptt-child/* /etc/wptt/

  chmod -R 700 /etc/wptt
  if [[ $has_wptt_group -eq 1 ]]; then
    chown root:wptangtoc-ols /etc/wptt /etc/wptt/vhost
    chmod 750 /etc/wptt /etc/wptt/vhost
  else
    chown root:root /etc/wptt /etc/wptt/vhost
    chmod 700 /etc/wptt /etc/wptt/vhost
  fi

  \cp -f /etc/wptt/wptangtoc /usr/bin/
  rm -f /etc/wptt/wptangtoc
  \cp -f /etc/wptt/wptt /usr/bin/
  rm -f /etc/wptt/wptt
  [[ -f /etc/wptt/tai-nguyen-server/wtop ]] && \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin/

  # ==========================================================================
  # CẬP NHẬT PHÂN QUYỀN VHOST (ZERO TRUST)
  # ==========================================================================
  chown root:root /etc/wptt/.wptt.conf
  chmod 600 /etc/wptt/.wptt.conf

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    chown root:root "$filepath"
    chmod 600 "$filepath"

    if [[ $has_wptt_group -eq 1 ]]; then
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"
      path="/usr/local/lsws/$domain"

      if [[ -d "$path" && -d "$path/etc" ]]; then
        if [[ $(stat -c '%U' "$path/etc" 2>/dev/null) == "root" ]]; then
          check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"'"'")
          if [[ -n "$check_user_vhost" ]] && grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
            chown root:wptangtoc-ols "$filepath"
            chmod 640 "$filepath"
          fi
        fi
      fi
    fi
  done

  # Lưu phiên bản mới
  if command -v wptt_atomic_edit_config >/dev/null 2>&1; then
    wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure"
  fi
  echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version

  # ==========================================================================
  # SCRIPT HẬU CẬP NHẬT (POST-UPDATE HOOK BỌC VALIDSIG)
  # ==========================================================================
  if ! secure_download "https://wptangtoc.com/share/update" "update"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update" || true
  fi
  if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig" || true
  fi

  if verify_gpg_validsig "update.sig" "update"; then
    if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
      bash update >/dev/null 2>&1 || true
    fi
  else
    if command -v wptt_logs >/dev/null 2>&1; then
      wptt_logs "INFO" "Auto-update: Script 'update' sai chữ ký VALIDSIG hoặc lỗi tải - Bỏ qua thực thi"
    fi
  fi
  rm -f update update.sig

  if command -v wptt_logs >/dev/null 2>&1; then
    wptt_logs "INFO" "Tự động cập nhật WPTangToc OLS lên bản $wptangtocols_version thành công"
  fi
fi
