#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# Mô tả: Tự động cập nhật WPTangToc OLS ngầm qua Cron định kỳ (Unattended Auto-Update)

PATH='/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin'
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Nạp thư viện cốt lõi
. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

# ==============================================================================
# 1. KHÓA ĐỒNG THỜI TOÀN HỆ THỐNG (CONCURRENCY LOCKING)
# ==============================================================================
/bin/mkdir -p /etc/wptt/tmp 2>/dev/null
/bin/chmod 700 /etc/wptt/tmp 2>/dev/null

LOCK_FILE="/etc/wptt/tmp/wptt_system_update.lock"
exec 200>"$LOCK_FILE"
# Thoát ngay lập tức nếu đang có phiên cập nhật khác đang chạy
if ! flock -n 200; then
  exit 0
fi

# ==============================================================================
# 2. CHỐT CHẶN HỆ ĐIỀU HÀNH CENTOS 7 & MÔI TRƯỜNG
# ==============================================================================
if grep -qi 'ID="centos"' /etc/os-release 2>/dev/null && grep -qE 'VERSION_ID="?7"?' /etc/os-release 2>/dev/null; then
  exit 0
fi

EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
KEY_EMAIL="giatuan@wptangtoc.com"

# ==============================================================================
# 3. HÀM TẢI AN TOÀN CHỐNG TREO MẠNG (FAIL-SAFE RETRY)
# ==============================================================================
secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while ((attempt <= max_attempts)); do
    if curl --tlsv1.2 --proto "=https" -sfL --connect-timeout 8 --max-time 45 -A "$user_agent" "$url" -o "$dest" 2>/dev/null; then
      if [[ -s "$dest" ]]; then
        return 0
      fi
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1
  local result=""

  while ((attempt <= max_attempts)); do
    result=$(curl --tlsv1.2 --proto "=https" -sfL --connect-timeout 5 --max-time 15 "$url" 2>/dev/null || true)
    result="${result//$'\r'/}"
    result="${result//[[:space:]]/}"
    if [[ -n "$result" ]]; then
      printf '%s\n' "$result"
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

# ==============================================================================
# 4. HÀM XÁC THỰC GPG CHUẨN ENTERPRISE (VALIDSIG & SUBKEY COMPATIBLE)
# ==============================================================================
verify_gpg_package() {
  local data_file="$1"
  local sig_file="$2"
  local pkg_name="$3"

  # 1. Kiểm tra tồn tại và dung lượng file
  if [[ ! -s "$data_file" || ! -s "$sig_file" ]]; then
    wptt_logs "ERROR" "Auto-update: Gói $pkg_name hoặc chữ ký bị rỗng/tải thất bại!" 2>/dev/null || true
    return 1
  fi

  # 2. Xác thực trạng thái qua status-fd 1
  local status_out
  status_out=$(gpg --status-fd 1 --batch --verify "$sig_file" "$data_file" 2>/dev/null || true)

  # Bắt các cờ chữ ký hỏng/bị can thiệp
  if grep -qE '\[GNUPG:\] (BADSIG|ERRSIG|EXPSIG|EXPKEYSIG|REVKEYSIG)' <<<"$status_out"; then
    return 1
  fi

  # Bắt buộc có cờ GOODSIG
  if ! grep -q '\[GNUPG:\] GOODSIG' <<<"$status_out"; then
    return 1
  fi

  # 3. Chốt chặn VALIDSIG: Hỗ trợ đối soát cả Primary Key lẫn Subkey
  if grep -q '\[GNUPG:\] VALIDSIG' <<<"$status_out"; then
    if ! grep -qE "${EXPECTED_FP}" <<<"$status_out"; then
      return 1
    fi
  fi

  return 0
}

# ==============================================================================
# 5. KIỂM TRA PHIÊN BẢN MỚI
# ==============================================================================
wptangtocols_version=$(get_version_safe "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update-tu-dong=${Website_chinh:-}" || true)

if [[ -z "$wptangtocols_version" ]]; then
  wptangtocols_version=$(get_version_safe "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt" || true)
fi

# Nếu không lấy được version hoặc hệ thống đã ở bản mới nhất -> Thoát êm đềm
if [[ -z "$wptangtocols_version" || "$wptangtocols_version" == "${version_wptangtoc_ols:-}" ]]; then
  exit 0
fi

# ==============================================================================
# 6. KHỞI TẠO VÙNG LÀM VIỆC CÁCH LY & BẪY DỌN DẸP
# ==============================================================================
TMP_DIR=$(mktemp -d -p "/etc/wptt/tmp" auto_update.XXXXXX) || exit 0
OLD_PWD=$(pwd)

cleanup() {
  local exit_code=$?
  cd "$OLD_PWD" 2>/dev/null || cd /root 2>/dev/null || true
  /bin/rm -rf -- "$TMP_DIR" 2>/dev/null || true
  exec 200>&- 2>/dev/null || true
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

cd "$TMP_DIR" || exit 0

# ==============================================================================
# 7. KIỂM TRA & NẠP PUBLIC KEY GPG CHÍNH HÃNG (PINNED FINGERPRINT)
# ==============================================================================
if ! gpg --list-keys "$EXPECTED_FP" >/dev/null 2>&1; then
  if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"
  fi

  real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

  if [[ -n "$real_fp" && "${real_fp^^}" == "${EXPECTED_FP^^}" ]]; then
    gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
  else
    wptt_logs "SECURITY" "Auto-update: Phát hiện GPG Public Key giả mạo hoặc sai Fingerprint!" 2>/dev/null || true
    exit 0
  fi
  /bin/rm -f wptangtoc-gpg-pub.key 2>/dev/null || true
fi

# ==============================================================================
# 8. TẢI MÃ NGUỒN VÀ CHỮ KÝ SỐ
# ==============================================================================
# Tải Core Stable
secure_download "https://wptangtoc.com/share/wptangtoc-ols.zip" "wptangtoc-ols.zip" ||
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" "wptangtoc-ols.zip"

secure_download "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig" "checksum wptangtoc ols" ||
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig"

# Tải User Stable
secure_download "https://wptangtoc.com/share/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip" ||
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip"

secure_download "https://hub.wptangtoc.com/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig" "checksum wptangtoc ols" ||
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig"

# ==============================================================================
# 9. XÁC THỰC TOÀN VẸN GPG
# ==============================================================================
auth_core=0
auth_user=0

verify_gpg_package "wptangtoc-ols.zip" "wptangtoc-ols.zip.sig" "Core" && auth_core=1
verify_gpg_package "wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip.sig" "User" && auth_user=1

if ((auth_core == 0 || auth_user == 0)); then
  wptt_logs "SECURITY" "Auto-update: Chữ ký GPG không hợp lệ hoặc gói tải về bị hỏng! Đã hủy cập nhật." 2>/dev/null || true
  exit 0
fi

# ==============================================================================
# 10. SAO LƯU HỆ THỐNG TRƯỚC KHI THAY THẾ (FAIL-SAFE SNAPSHOT)
# ==============================================================================
kiem_tra_ton_tai_nhom=$(grep -E '^wptangtoc-ols:' /etc/group 2>/dev/null || true)

OLD_UMASK=$(umask)
umask 077

/bin/mkdir -p /etc/wptt/wptt-backup-system
timedate=$(date +%Hgio_%d_%m_%Y)
BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_auto_backup_${timedate}_version_${version_wptangtoc_ols:-old}.zip"

(
  cd /etc/wptt &&
    zip -r -q "$BACKUP_FILE" . \
      -x "wptt-backup-system/*" \
      -x ".wptt.conf" \
      -x ".ram_hien_tai" \
      -x "vhost/*" \
      -x "tmp/*" 2>/dev/null
)

if [[ -f "$BACKUP_FILE" ]]; then
  zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop 2>/dev/null || true
fi

# Xoay vòng giữ tối đa 10 bản sao lưu
ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r /bin/rm -f 2>/dev/null || true
umask "$OLD_UMASK"

# ==============================================================================
# 11. GIẢI NÉN VÀ THAY THẾ NGUYÊN TỬ (CÓ TỰ ĐỘNG ROLLBACK)
# ==============================================================================
rollback_and_exit() {
  wptt_logs "ERROR" "Auto-update: Lỗi khi giải nén/chép file. Đang tự động rollback..." 2>/dev/null || true
  if [[ -f "$BACKUP_FILE" ]]; then
    unzip -oq "$BACKUP_FILE" -d /etc/wptt/ 2>/dev/null || true
    /bin/cp -fp /etc/wptt/wptangtoc /usr/bin/ 2>/dev/null || true
    /bin/cp -fp /etc/wptt/wptt /usr/bin/ 2>/dev/null || true
    /bin/cp -fp /etc/wptt/tai-nguyen-server/wtop /usr/bin/ 2>/dev/null || true
  fi
  exit 0
}

umask 077
unzip -oq wptangtoc-ols.zip || rollback_and_exit

# Linh hoạt theo cấu trúc zip phẳng hoặc có thư mục con
if [[ -d "tool-wptangtoc-ols" ]]; then
  /bin/cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null || rollback_and_exit
  /bin/rm -rf tool-wptangtoc-ols
else
  for item in *; do
    [[ "$item" == "wptangtoc-ols.zip" || "$item" == "wptangtoc-ols.zip.sig" || "$item" == "wptangtoc-ols-user.zip" || "$item" == "wptangtoc-ols-user.zip.sig" ]] && continue
    /bin/cp -rf "$item" /etc/wptt/ 2>/dev/null || rollback_and_exit
  done
fi
umask "$OLD_UMASK"

/bin/rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig

# Đồng bộ child config nếu có
[[ -d /etc/wptt/wptt-child ]] && /bin/cp -rf /etc/wptt/wptt-child/* /etc/wptt/ 2>/dev/null || true

# Khôi phục phân quyền Core
/bin/chmod -R 700 /etc/wptt
if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
  /bin/chown root:wptangtoc-ols /etc/wptt /etc/wptt/vhost
  /bin/chmod 750 /etc/wptt /etc/wptt/vhost
else
  /bin/chown root:root /etc/wptt /etc/wptt/vhost
fi

[[ -f /etc/wptt/wptangtoc ]] && /bin/cp -fp /etc/wptt/wptangtoc /usr/bin/ && /bin/rm -f /etc/wptt/wptangtoc
[[ -f /etc/wptt/wptt ]] && /bin/cp -fp /etc/wptt/wptt /usr/bin/ && /bin/rm -f /etc/wptt/wptt
[[ -f /etc/wptt/tai-nguyen-server/wtop ]] && /bin/cp -fp /etc/wptt/tai-nguyen-server/wtop /usr/bin/ 2>/dev/null || true

# Bảo vệ file cấu hình bí mật (.wptt.conf)
/bin/chown root:root /etc/wptt/.wptt.conf 2>/dev/null || true
/bin/chmod 600 /etc/wptt/.wptt.conf 2>/dev/null || true

# ==============================================================================
# 12. ĐỒNG BỘ PHÂN QUYỀN VHOST CHUẨN ZERO TRUST
# ==============================================================================
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

  /bin/chown root:root "$filepath"
  /bin/chmod 600 "$filepath"

  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    path_site="/usr/local/lsws/$domain"

    if [[ -d "$path_site" && -d "$path_site/etc" ]]; then
      if [[ $(stat -c '%U' "$path_site/etc" 2>/dev/null) == "root" ]]; then
        check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"' | tr -d "'")
        if [[ -n "$check_user_vhost" ]] && grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
          /bin/chown root:wptangtoc-ols "$filepath"
          /bin/chmod 640 "$filepath"
        fi
      fi
    fi
  fi
done

# ==============================================================================
# 13. CÀI ĐẶT GÓI USER WPTANGTOC-OLS
# ==============================================================================
OLD_UMASK=$(umask)
umask 007
unzip -qo wptangtoc-ols-user.zip 2>/dev/null || true

if [[ -d "tool-wptangtoc-ols-user" ]]; then
  /bin/cp -rf tool-wptangtoc-ols-user/* /etc/wptt-user/ 2>/dev/null || true
  /bin/rm -rf tool-wptangtoc-ols-user
else
  mkdir -p /etc/wptt-user
  for item in *; do
    [[ "$item" == *.zip || "$item" == *.sig ]] && continue
    /bin/cp -rf "$item" /etc/wptt-user/ 2>/dev/null || true
  done
fi
umask "$OLD_UMASK"

/bin/rm -f wptangtoc-ols-user.zip wptangtoc-ols-user.zip.sig

if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
  /bin/chown -hR root:wptangtoc-ols /etc/wptt-user 2>/dev/null || true
  /bin/chmod -R 750 /etc/wptt-user 2>/dev/null || true
  [[ -f /etc/wptt-user/wptangtoc-user ]] && /bin/cp -fp /etc/wptt-user/wptangtoc-user /usr/bin/ && /bin/chmod 750 /usr/bin/wptangtoc-user
else
  /bin/chown -hR root:root /etc/wptt-user 2>/dev/null || true
  /bin/chmod -R 700 /etc/wptt-user 2>/dev/null || true
  [[ -f /etc/wptt-user/wptangtoc-user ]] && /bin/cp -fp /etc/wptt-user/wptangtoc-user /usr/bin/ && /bin/chmod 700 /usr/bin/wptangtoc-user
fi

/bin/chmod 700 /etc/wptt/tmp 2>/dev/null || true

# Khử dấu tiếng Việt nếu hệ thống cấu hình không dấu
if [[ "${khong_dau_vi_ngon_ngu:-}" == '1' ]]; then
  find /etc/wptt -type f ! -path '/etc/wptt/lang/wptt-set-lang-vi' ! -path '/etc/wptt/wptt-update2' ! -path '/etc/wptt/wptt-update' ! -name '.*' \
    -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} + 2>/dev/null || true
  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    find /etc/wptt-user -type f \
      -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} + 2>/dev/null || true
  fi
fi

# ==============================================================================
# 14. SCRIPT PHỤ TRỢ UPDATE (BẢO MẬT GPG STRICT)
# ==============================================================================
if ! secure_download "https://wptangtoc.com/share/update" "update"; then
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update"
fi
if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
  secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig"
fi

if [[ -s update && -s update.sig ]] && verify_gpg_package "update" "update.sig" "UpdateScript"; then
  if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
    bash update >/dev/null 2>&1 || true
  fi
fi
/bin/rm -f update update.sig 2>/dev/null || true

# Lưu cấu hình và ghi log thành công
wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure" 2>/dev/null || true
echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true
echo "${version_wptangtoc_ols:-}" >/etc/wptt/tmp/wptangtoc-ols-version-main 2>/dev/null || true

wptt_logs "INFO" "Tự động cập nhật thành công WPTangToc OLS lên phiên bản $wptangtocols_version" 2>/dev/null || true

exit 0
