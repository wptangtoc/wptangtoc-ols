#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Tự động cập nhật WPTangToc OLS qua Cronjob chuẩn Enterprise (Silent, Atomic & GPG Verified)

# Bọc toàn bộ script trong khối { ... } để Bash nạp 100% vào RAM trước khi thực thi,
# chống lỗi lệch byte (syntax error) khi lệnh cp -rf tự ghi đè chính file đang chạy.
{

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH='/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

unset khong_dau_vi_ngon_ngu wptangtocols_version ngon_ngu beta_wptangtoc_ols
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true
if declare -F wptt_load_main_conf >/dev/null 2>&1; then
  wptt_load_main_conf 2>/dev/null || true
elif [[ -f /etc/wptt/.wptt.conf ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/.wptt.conf 2>/dev/null || true
fi

# ==============================================================================
# 1. CHỐT CHẶN HỆ ĐIỀU HÀNH CENTOS 7 (THOÁT ÂM THẦM TRONG CRON)
# ==============================================================================
if grep -qi 'ID="centos"' /etc/os-release 2>/dev/null && grep -qE 'VERSION_ID="?7"?' /etc/os-release 2>/dev/null; then
  exit 0
fi

# ==============================================================================
# 2. KIỂM TRA NGẦM DISK, INODE, RAM & QUYỀN GHI (SILENT LOGGING)
# ==============================================================================
wptt_check_storage_ready_cron() {
  local check_path="/etc/wptt"
  [[ ! -d "$check_path" ]] && check_path="/"

  local avail_kb=""
  local avail_inodes=""
  avail_kb=$(df -Pk "$check_path" 2>/dev/null | awk 'NR==2 {print $4}')
  avail_inodes=$(df -Pi "$check_path" 2>/dev/null | awk 'NR==2 {print $4}')

  local avail_ram_kb=0
  if [[ -r /proc/meminfo ]]; then
    avail_ram_kb=$(awk '
      /^MemAvailable:/ { avail=$2 }
      /^MemFree:/      { free=$2 }
      /^Buffers:/      { buf=$2 }
      /^Cached:/       { cache=$2 }
      END {
        if (avail > 0) print avail
        else print (free + buf + cache)
      }
    ' /proc/meminfo 2>/dev/null || echo 0)
  fi

  local err_reason=""

  if [[ "$avail_kb" =~ ^[0-9]+$ ]] && ((avail_kb < 153600)); then
    err_reason="Ổ cứng trống dưới 150MB (Còn lại: $((avail_kb / 1024))MB)"
  elif [[ "$avail_inodes" =~ ^[0-9]+$ ]] && ((avail_inodes < 2000)); then
    err_reason="Inode trống dưới 2000 (Còn lại: ${avail_inodes})"
  elif [[ "$avail_ram_kb" =~ ^[0-9]+$ ]] && ((avail_ram_kb > 0 && avail_ram_kb < 30720)); then
    err_reason="RAM khả dụng dưới 30MB (Còn lại: $((avail_ram_kb / 1024))MB)"
  else
    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    local test_inode_file="/etc/wptt/tmp/.wptt_disk_probe_$$"
    if ! ( : >"$test_inode_file" ) 2>/dev/null; then
      err_reason="Ổ cứng bị đầy 100%, hết sạch Inode hoặc đang bị khóa Read-Only"
    else
      /bin/rm -f -- "$test_inode_file" 2>/dev/null || true
    fi
  fi

  if [[ -n "$err_reason" ]]; then
    if declare -F wptt_logs >/dev/null 2>&1; then
      wptt_logs "WARN" "Tự động cập nhật bị hủy để bảo vệ hệ thống: $err_reason" 2>/dev/null || true
    fi
    exit 1
  fi
}
wptt_check_storage_ready_cron

# ==============================================================================
# 3. CÁC HÀM TIỆN ÍCH TẢI FILE AN TOÀN & XÁC THỰC GPG
# ==============================================================================
EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
KEY_EMAIL="giatuan@wptangtoc.com"

secure_download() {
  local url="$1"
  local dest="$2"
  local user_agent="${3:-checksum wptangtoc ols}"
  local max_attempts=3
  local attempt=1

  while ((attempt <= max_attempts)); do
    if curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 45 -A "$user_agent" "$url" -o "$dest" 2>/dev/null; then
      if [[ -s "$dest" ]]; then
        return 0
      fi
    fi
    sleep 3
    ((attempt++))
  done
  return 1
}

get_version_safe() {
  local url="$1"
  local max_attempts=3
  local attempt=1

  while ((attempt <= max_attempts)); do
    local result=""
    result=$(curl --tlsv1.2 -sfL --connect-timeout 10 --max-time 20 "$url" 2>/dev/null || true)
    result="${result//$'\r'/}"
    result="${result//[[:space:]]/}"
    if [[ -n "$result" && "$result" =~ ^[0-9]+(\.[0-9]+)+$ ]]; then
      printf '%s\n' "$result"
      return 0
    fi
    sleep 2
    ((attempt++))
  done
  return 1
}

verify_gpg_package() {
  local data_file="$1"
  local sig_file="$2"

  if [[ ! -s "$data_file" || ! -s "$sig_file" ]]; then
    return 1
  fi

  local status_out=""
  status_out=$(gpg --status-fd 1 --batch --verify "$sig_file" "$data_file" 2>/dev/null || true)

  if grep -qE '\[GNUPG:\] (BADSIG|ERRSIG|EXPSIG|EXPKEYSIG|REVKEYSIG)' <<<"$status_out"; then
    return 1
  fi

  if ! grep -q '\[GNUPG:\] GOODSIG' <<<"$status_out"; then
    return 1
  fi

  if grep -q '\[GNUPG:\] VALIDSIG' <<<"$status_out"; then
    if ! grep -qE "${EXPECTED_FP}" <<<"$status_out"; then
      return 1
    fi
  fi

  return 0
}

# ==============================================================================
# 4. KIỂM TRA PHIÊN BẢN MỚI
# ==============================================================================
if [[ "${beta_wptangtoc_ols:-}" == "1" ]]; then
  exit 0
fi

wptangtocols_version=$(get_version_safe "https://wptangtoc.com/share/version-wptangtoc-ols.txt?domain-update-tu-dong=${Website_chinh:-}")
[[ -z "$wptangtocols_version" ]] && wptangtocols_version=$(get_version_safe "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt")

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "${version_wptangtoc_ols:-}" ]]; then

  OLD_PWD=$(pwd)
  TMP_DIR=$(mktemp -d /etc/wptt/tmp/wptt_cron_up_XXXXXX)
  cd "$TMP_DIR" || exit 1

  # 1. Nạp Public Key (Nếu chưa có)
  if ! gpg --list-keys "$EXPECTED_FP" >/dev/null 2>&1; then
    if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"; then
      secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "wptangtoc-gpg-pub.key"
    fi

    real_fp=$(gpg --show-keys --with-colons wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

    if [[ -n "$real_fp" && "${real_fp^^}" == "${EXPECTED_FP^^}" ]]; then
      gpg --import wptangtoc-gpg-pub.key >/dev/null 2>&1
    else
      if declare -F wptt_logs >/dev/null 2>&1; then
        wptt_logs "ERROR" "Cron Update: Public Key GPG sai lệch Fingerprint!" 2>/dev/null || true
      fi
      cd "$OLD_PWD" || cd /root || exit 1
      rm -rf "${TMP_DIR:?}"
      exit 1
    fi
    rm -f wptangtoc-gpg-pub.key 2>/dev/null || true
  fi

  # 2. Tải File Core (.zip) và File Chữ Ký (.sig)
  if ! secure_download "https://wptangtoc.com/share/wptangtoc-ols.zip" "wptangtoc-ols.zip"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip" "wptangtoc-ols.zip"
  fi
  if ! secure_download "https://hub.wptangtoc.com/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig" "checksum wptangtoc ols"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols.zip.sig" "wptangtoc-ols.zip.sig"
  fi

  # 3. Tải File User (.zip) và File Chữ Ký (.sig)
  if ! secure_download "https://wptangtoc.com/share/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip"
  fi
  if ! secure_download "https://hub.wptangtoc.com/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig" "checksum wptangtoc ols"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-ols-user.zip.sig" "wptangtoc-ols-user.zip.sig"
  fi

  # 4. Quét xác thực GPG cả gói Core & User
  if ! verify_gpg_package "wptangtoc-ols.zip" "wptangtoc-ols.zip.sig" ||
     ! verify_gpg_package "wptangtoc-ols-user.zip" "wptangtoc-ols-user.zip.sig"; then
    if declare -F wptt_logs >/dev/null 2>&1; then
      wptt_logs "ERROR" "Cron Update: Xác thực GPG thất bại cho bản $wptangtocols_version!" 2>/dev/null || true
    fi
    cd "$OLD_PWD" || cd /root || exit 1
    rm -rf "${TMP_DIR:?}"
    exit 1
  fi

  # ==========================================================================
  # 5. QUY TRÌNH BACKUP, ROLLBACK & CÀI ĐẶT
  # ==========================================================================
  OLD_UMASK=$(umask)
  umask 077

  mkdir -p /etc/wptt/wptt-backup-system
  timedate=$(date +%Hgio_%d_%m_%Y)
  BACKUP_FILE="/etc/wptt/wptt-backup-system/wptt_backup_${timedate}_version:${version_wptangtoc_ols:-}.zip"

  (
    cd /etc/wptt &&
      zip -r -q "$BACKUP_FILE" . \
        -x "wptt-backup-system/*" \
        -x ".wptt.conf" \
        -x ".ram_hien_tai" \
        -x "vhost/*" \
        -x "tmp/*" 2>/dev/null
  )

  if [[ -f "$BACKUP_FILE" ]]; then
    zip -g -j -q "$BACKUP_FILE" /usr/bin/wptangtoc /usr/bin/wptt /usr/bin/wtop 2>/dev/null || true
  fi

  ls -dt /etc/wptt/wptt-backup-system/*.zip 2>/dev/null | tail -n +11 | xargs -r rm -f 2>/dev/null || true

  kiem_tra_ton_tai_nhom=$(grep -E '^wptangtoc-ols:' /etc/group 2>/dev/null || true)

  unzip -oq wptangtoc-ols.zip

  if ! \cp -rf tool-wptangtoc-ols/* /etc/wptt/ 2>/dev/null; then
    umask "${OLD_UMASK:-0022}"
    unzip -oq "$BACKUP_FILE" -d /etc/wptt/ 2>/dev/null || true
    \cp -f /etc/wptt/wptangtoc /usr/bin 2>/dev/null || true
    rm -f /etc/wptt/wptangtoc
    \cp -f /etc/wptt/wptt /usr/bin 2>/dev/null || true
    rm -f /etc/wptt/wptt
    \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin 2>/dev/null || true
    cd "$OLD_PWD" || cd /root || exit 1
    rm -rf "${TMP_DIR:?}"
    exit 1
  fi

  umask "${OLD_UMASK:-0022}"

  rm -f wptangtoc-ols.zip wptangtoc-ols.zip.sig
  rm -rf tool-wptangtoc-ols

  [[ -d /etc/wptt/wptt-child ]] && \cp -rf /etc/wptt/wptt-child/* /etc/wptt 2>/dev/null || true

  chmod -R 700 /etc/wptt
  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    chown root:wptangtoc-ols /etc/wptt /etc/wptt/vhost
    chmod 750 /etc/wptt /etc/wptt/vhost
  else
    chown root:root /etc/wptt /etc/wptt/vhost
    chmod 700 /etc/wptt /etc/wptt/vhost
  fi

  \cp -f /etc/wptt/wptangtoc /usr/bin
  rm -f /etc/wptt/wptangtoc
  \cp -f /etc/wptt/wptt /usr/bin
  rm -f /etc/wptt/wptt
  \cp -f /etc/wptt/tai-nguyen-server/wtop /usr/bin 2>/dev/null || true

  # ==========================================================================
  # 6. CẬP NHẬT PHÂN QUYỀN VHOST THEO CƠ CHẾ BẢO MẬT (ZERO TRUST)
  # ==========================================================================
  chown root:root /etc/wptt/.wptt.conf
  chmod 600 /etc/wptt/.wptt.conf

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    chown root:root "$filepath"
    chmod 600 "$filepath"

    if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      path_site="/usr/local/lsws/$domain"

      if [[ -d "$path_site" && -d "$path_site/etc" ]]; then
        if [[ $(stat -c '%U' "$path_site/etc" 2>/dev/null) == "root" ]]; then
          check_user_vhost=$(grep -E '^User_name_vhost=' "$filepath" | cut -d'=' -f2 | tr -d '"' | tr -d "'")

          if [[ -n "$check_user_vhost" ]]; then
            if grep -q "^wptangtoc-ols:.*$check_user_vhost" /etc/group 2>/dev/null; then
              chown root:wptangtoc-ols "$filepath"
              chmod 640 "$filepath"
            fi
          fi
        fi
      fi
    fi
  done

  # ==========================================================================
  # 7. GIẢI NÉN VÀ CẬP NHẬT GÓI USER (/etc/wptt-user)
  # ==========================================================================
  OLD_UMASK=$(umask)
  umask 007
  mkdir -p /etc/wptt-user 2>/dev/null || true
  unzip -qo wptangtoc-ols-user.zip
  \cp -rf tool-wptangtoc-ols-user/* /etc/wptt-user 2>/dev/null || true
  umask "${OLD_UMASK:-0022}"

  rm -f wptangtoc-ols-user.zip wptangtoc-ols-user.zip.sig
  rm -rf tool-wptangtoc-ols-user

  if [[ -n "$kiem_tra_ton_tai_nhom" ]]; then
    chown -hR root:wptangtoc-ols /etc/wptt-user
    chmod -R 750 /etc/wptt-user
    \cp -f /etc/wptt-user/wptangtoc-user /usr/bin
    chown root:wptangtoc-ols /usr/bin/wptangtoc-user
    chmod 750 /usr/bin/wptangtoc-user
  else
    chown -hR root:root /etc/wptt-user
    chmod -R 700 /etc/wptt-user
    \cp -f /etc/wptt-user/wptangtoc-user /usr/bin
    chown root:root /usr/bin/wptangtoc-user
    chmod 700 /usr/bin/wptangtoc-user
  fi

  chmod 700 /etc/wptt/tmp

  if [[ "${khong_dau_vi_ngon_ngu:-}" == '1' ]]; then
    find /etc/wptt -type f ! -path '/etc/wptt/lang/wptt-set-lang-vi' ! -path '/etc/wptt/wptt-update2' ! -path '/etc/wptt/wptt-update' ! -name '.*' -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
    [[ -n "$kiem_tra_ton_tai_nhom" ]] && find /etc/wptt-user -type f -exec sed -i 'y/áàảãạăắằẳẵặâấầẩẫậđéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵÁÀẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỴ/aaaaaaaaaaaaaaaaadeeeeeeeeeeeiiiiiooooooooooooooooouuuuuuuuuuuyyyyyAAAAAAAAAAAAAAAAADEEEEEEEEEEEIIIIIOOOOOOOOOOOOOOOOOUUUUUUUUUUUYYYYY/' {} +
  fi

  # ==========================================================================
  # 8. THỰC THI SCRIPT PHỤ TRỢ UPDATE & LƯU VERSION
  # ==========================================================================
  if ! secure_download "https://wptangtoc.com/share/update" "update"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update" "update" || true
  fi
  if ! secure_download "https://hub.wptangtoc.com/update.sig" "update.sig" "checksum wptangtoc ols"; then
    secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig" "update.sig" || true
  fi

  if [[ -s update && -s update.sig ]] && verify_gpg_package "update" "update.sig"; then
    if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
      bash update >/dev/null 2>&1 || true
    fi
  else
    if declare -F wptt_logs >/dev/null 2>&1; then
      wptt_logs "INFO" "Cron Update: Script 'update' sai chữ ký GPG hoặc rớt mạng - Bỏ qua thực thi" 2>/dev/null || true
    fi
  fi
  rm -f update update.sig 2>/dev/null || true

  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure" 2>/dev/null || true
  echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true
  echo "${version_wptangtoc_ols:-}" >/etc/wptt/tmp/wptangtoc-ols-version-main 2>/dev/null || true

  rm -f -- /etc/wptt/tmp/wptt_search_*.tsv 2>/dev/null || true
  rm -f -- /etc/wptt/tmp/wptt_search_*.idx 2>/dev/null || true
  /etc/wptt/search-wptangtoc --preload-cache </dev/null >/dev/null 2>&1 || true

  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "INFO" "Cập nhật tự động WPTangToc OLS lên bản $wptangtocols_version thành công" 2>/dev/null || true
  fi

  cd "$OLD_PWD" || cd /root || exit 0
  rm -rf "${TMP_DIR:?}"
fi

exit 0
}
