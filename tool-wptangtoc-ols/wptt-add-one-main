MENU_TITLE="TRUNG TÂM QUẢN LÝ TIỆN ÍCH NÂNG CAO"

options=(
  "Bật/Tắt kiểm tra thông báo hạn SSL"                   #0
  "Bật/Tắt kiểm tra thông báo hạn Domain"                #1
  "Backup Uploads lên Telegram Cloud"                    #2
