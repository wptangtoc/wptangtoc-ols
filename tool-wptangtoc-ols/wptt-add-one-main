  "Thiết lập Auto Backup lên Telegram"                   #4
  "Hủy thiết lập Auto Backup lên Telegram"               #5
  "Bật/Tắt Tăng tốc Htaccess Cache"                      #6
  "Hiển thị IP Log Real bypass Cloudflare"               #7
  "Tùy biến X-Powered-By HTTP"                           #8
  "Thiết lập Proxy ngược (Reverse Proxy)"                #9
  "Chặn truy cập trực tiếp HTTP IP"                      #10
  "Factory Reset LiteSpeed Webserver"                    #11
  "Factory Reset Htaccess website"                       #12
)

# ==============================================================================
# 3. LOGIC XỬ LÝ (ÁNH XẠ CHUẨN 100%)
# ==============================================================================
run_action() {
  local index=$1
  local script_path=""
  local script_args="98" # Tham số mặc định của core menu
  local extra_arg=""     

  case $index in
  0) script_path="/etc/wptt/add-one/thiet-lap-check-ssl" ;;
  1) script_path="/etc/wptt/add-one/thiet-lap-check-domain-het-han" ;;
  2) script_path="/etc/wptt/add-one/add-premium"; extra_arg="backup" ;;
  3) script_path="/etc/wptt/add-one/add-premium"; extra_arg="restore" ;;
  4) script_path="/etc/wptt/add-one/add-premium"; extra_arg="auto-backup-setup" ;;
  5) script_path="/etc/wptt/add-one/add-premium"; extra_arg="tat-auto-backup" ;;
  6) script_path="/etc/wptt/add-one/thiet-lap-auto-htaccess-optimize" ;;
  7) script_path="/etc/wptt/cloudflare-cdn-ip-show-real" ;;
  8) script_path="/etc/wptt/add-one/add-premium"; extra_arg="custom-x-powered-by" ;;
  9) script_path="/etc/wptt/proxy-setup";;
  10) script_path="/etc/wptt/ip-scan-block" ;;
  11) script_path="/etc/wptt/wptt-reset" ;;
  12) script_path="/etc/wptt/wptt-htaccess-reset"; extra_arg="premium" ;;
  esac

  # Kiểm tra và chạy script con
  if [[ -x "$script_path" || -f "$script_path" ]]; then
    if [[ -n "$extra_arg" ]]; then
      exec bash "$script_path" "$script_args" "$extra_arg"
    else
      exec bash "$script_path" "$script_args"
    fi
  else
    echo -e "\n\033[1;31m[!] Lỗi: Không tìm thấy hoặc không thể thực thi script '$script_path'.\033[0m"
    sleep 2
    exec /etc/wptt/wptt-add-one-main 1
  fi
}

