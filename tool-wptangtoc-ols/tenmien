# Chỉ nạp thư viện nếu tiến trình cha chưa nạp (Chống nạp chồng tốn I/O)
if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  . /etc/wptt/core-functions 2>/dev/null
fi

if [[ -z "${ngon_ngu:-}" || -z "${tai_ma_nguon_wordpress:-}" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/.wptt.conf 2>/dev/null
  [[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
fi

if ! declare -F _runing &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/echo-color 2>/dev/null
fi

function lua_chon_NAME() {
  local action_desc="${1:-}"
  unset NAME

  # Nếu chạy tự động trên CI/CD mà không truyền dữ liệu qua Pipe (stdin là TTY) thì thoát ngay
  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]] && [[ -t 0 ]]; then
    return 1
  fi

  local selects=()
  local i=1
  local box_inner_width="${box_inner_width:-78}"
  local filepath domain valid_domain PROMPT_TEXT

  # 1. Quét file siêu tốc trên RAM (0 Subshell)
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* && "$domain" != *..* ]]; then
      selects+=("$domain")
    fi
  done
  shopt -u nullglob

  # 2. Kiểm tra nếu VPS chưa có website nào
  if ((${#selects[@]} == 0)); then
    clear
    echo -e "\n${C_RED}Lỗi: ${khong_co_domain_nao_ton_tai_tren_he_thong:-Không có tên miền nào tồn tại trên hệ thống}${C_RESET}"
		exit 1
  fi

  # 3. Sắp xếp mảng chuẩn Version (Tự nhiên) chỉ khi có từ 2 tên miền trở lên
  if ((${#selects[@]} > 1)); then
    mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
  fi

  # ============================================================================
  # 4. RENDER KHỐI BO CONG (0 SUBSHELL - THUẦN BUILT-IN BASH)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

  if [[ -n "$action_desc" ]]; then
    local title_text="${lua_chon_website_ban_muon:-Nhập lựa chọn website của bạn muốn} $action_desc:"
    local clean_title="$title_text"
    # Khử mã màu ANSI (nếu có) bằng Regex thuần Bash thay vì gọi echo | sed
    while [[ "$clean_title" =~ $'\x1B'\[[0-9\;]*[a-zA-Z] ]]; do
      clean_title="${clean_title//"${BASH_REMATCH[0]}"/}"
    done

    local len=${#clean_title}
    local pad_r=$((box_inner_width - len - 2))
    ((pad_r < 0)) && pad_r=0

    local pad_r_str=""
    printf -v pad_r_str '%*s' "$pad_r" ""
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}${pad_r_str}${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    ((line_len > box_inner_width)) && line_len=$box_inner_width
    local pad_line_r=$((box_inner_width - line_len))
    ((pad_line_r < 0)) && pad_line_r=0

    local short_line="" pad_line_str=""
    printf -v short_line "%${line_len}s" ""
    short_line="${short_line// /─}"
    printf -v pad_line_str '%*s' "$pad_line_r" ""

    echo -e "${C_CYAN}├${short_line}${pad_line_str}│${C_RESET}"
  fi

  # Vòng lặp in danh sách tên miền vào trong khung (0 Subshell cho mọi số lượng domain)
  local item_text clean_text len pad pad_str
  for domain in "${selects[@]}"; do
    printf -v item_text "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain"
    printf -v clean_text "  %3d) %s" "$i" "$domain"

    len=${#clean_text}
    pad=$((box_inner_width - len))
    ((pad < 0)) && pad=0
    printf -v pad_str '%*s' "$pad" ""

    echo -e "${C_CYAN}│${C_RESET}${item_text}${pad_str}${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # ============================================================================
  # 5. TỐI ƯU UX DÒNG NHẮC LỆNH (PROMPT)
  # ============================================================================
  local fzf_installed=false
  if command -v fzf &>/dev/null; then
    fzf_installed=true
  fi

  local prompt_quick_select=""
  if [[ "$fzf_installed" == true && ${#selects[@]} -gt 1 ]]; then
    prompt_quick_select=" [00=${chon_nhanh:-Chọn nhanh}]"
  fi

  PROMPT_TEXT="${nhap_lua_chon_website_cua_ban:-Nhập lựa chọn website của bạn} (1-${#selects[@]})${prompt_quick_select} [0=${exit_thoat:-Thoát}]: "

  # ============================================================================
  # 6. ĐỘNG CƠ NHẬN PHÍM AN TOÀN
  # ============================================================================
  while true; do
    echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"

    if ! read -r REPLY; then
      echo -e "\n${C_RED}⚠️ Đã mất kết nối Terminal (EOF). Tự động thoát Menu để bảo vệ hệ thống...${C_RESET}"
      exit 1
    fi

    REPLY="${REPLY//[[:space:]]/}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0)
      echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
      NAME="0"
      return 0
      ;;

    00)
      if [[ "$fzf_installed" == true && ${#selects[@]} -gt 1 ]]; then
        local fzf_height=$((${#selects[@]} + 4))
        ((fzf_height > 40)) && fzf_height=40
        local fzf_prompt="${nhap_lua_chon_website_cua_ban:-Tìm kiếm website} (Mũi tên di chuyển, Enter chọn, ESC hủy): "
        local selected_name=""
        local fzf_exit_status=0

        selected_name=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="$fzf_prompt" --height="$fzf_height" --border=rounded --color=border:red --cycle --reverse) || fzf_exit_status=$?
        selected_name="${selected_name#*: }"

        if ((fzf_exit_status == 0)) && [[ -n "$selected_name" ]]; then
          NAME="$selected_name"
          return 0
        else
          echo -e "\n${C_YELLOW}Đã hủy chọn. ${vui_long_chon_lai:-Vui lòng chọn lại.}${C_RESET}"
          continue
        fi
      else
        echo -e "\n${C_RED}Lỗi: ${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ} '00'. Tính năng chọn nhanh không khả dụng lúc này.${C_RESET}"
        continue
      fi
      ;;

    *)
      # Dùng 10#$REPLY để ép hệ thập phân, chống lỗi Octal khi người dùng nhập 08, 09
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#selects[@]})); then
        local action_index=$((10#$REPLY - 1))
        NAME="${selects[$action_index]}"
        return 0
      elif [[ "$REPLY" == ?*.?* && "$REPLY" != "." ]]; then
        local found=false
        for valid_domain in "${selects[@]}"; do
          if [[ "$valid_domain" == "$REPLY" ]]; then
            NAME="$valid_domain"
            found=true
            break
          fi
        done

        if [[ "$found" == true ]]; then
          return 0
        else
          echo -e "\n${C_RED}Lỗi: Tên miền '$REPLY' không tồn tại trên hệ thống.${C_RESET}"
          continue
        fi
      else
        echo -e "\n${C_RED}${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ}: '$REPLY'. ${vui_long_chon_lai:-Vui lòng chọn lại.}${C_RESET}"
        continue
      fi
      ;;
    esac
  done
}
