#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Thay đổi Port SSH chuẩn Enterprise (Dual-Port Transition & Nftables Set Native)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Nạp thư viện WPTangToc
# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

function huong_dan() {
  cat <<'EOF'
 Việc thay đổi cổng [port] SSH mặc định [thường là cổng 22] là một trong những biện pháp bảo mật cơ bản và hiệu quả cho máy chủ Linux.

 Dưới đây là giới thiệu ngắn gọn về tính năng này:

 Tại sao cần thay đổi cổng SSH?
 * Giảm thiểu tấn công tự động [Automated Attacks]: Rất nhiều bot và script độc hại tự động quét cổng 22. Việc đổi sang cổng khác làm giảm đáng kể các cuộc tấn công này.
 * Tăng cường bảo mật qua việc ẩn náu [Security through obscurity].
 * Tránh xung đột cổng [Port Conflicts].

 Lợi ích chính:
 * Giảm đáng kể log tấn công brute-force.
 * Làm cho máy chủ của bạn ít bị chú ý hơn.
EOF
}

# ==============================================================================
# KHỞI TẠO MÔI TRƯỜNG & DỌN DẸP AN TOÀN (TRAP CLEANUP)
# ==============================================================================
/bin/mkdir -p /etc/wptt/tmp 2>/dev/null
chmod 700 /etc/wptt/tmp 2>/dev/null

TMP_WORKSPACE=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${TMP_WORKSPACE:-}" && -d "$TMP_WORKSPACE" ]]; then
    /bin/rm -rf -- "${TMP_WORKSPACE:?}"
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

TMP_WORKSPACE="$(mktemp -d -p "/etc/wptt/tmp" ssh_port.XXXXXX)" || {
  echo -e "${C_RED}❌ Lỗi: Không thể tạo thư mục tạm an toàn!${C_RESET}"
  exit 1
}

# Khử lỗi terminal 'unknown' trên môi trường CI Runner
if [[ -t 1 ]] && [[ "${TERM:-unknown}" != "unknown" && "${TERM:-}" != "dumb" ]]; then
  clear 2>/dev/null || true
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ SSH ➜ ${thay_doi_port_ssh:-Thay đổi Port SSH}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# Kiểm tra quyền ghi file cấu hình
if [[ ! -w /etc/ssh/sshd_config ]]; then
  echo -e "${C_RED}❌ Lỗi: File /etc/ssh/sshd_config không có quyền ghi!${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# NHẬN DIỆN DỊCH VỤ SSH (TƯƠNG THÍCH CẢ RHEL/ALMA LẪN DEBIAN/UBUNTU 24.04)
# ==============================================================================
SSH_SERVICE="sshd"
if systemctl list-unit-files ssh.service 2>/dev/null | grep -q "^ssh\.service"; then
  SSH_SERVICE="ssh"
fi

ssh_dang_chay=0
if systemctl is-active --quiet "$SSH_SERVICE" 2>/dev/null ||
   systemctl is-active --quiet sshd 2>/dev/null ||
   systemctl is-active --quiet ssh 2>/dev/null ||
   systemctl is-active --quiet ssh.socket 2>/dev/null; then
  ssh_dang_chay=1
fi

if ((ssh_dang_chay == 0)); then
  echo -e "\n${C_RED}❌ Lỗi: Dịch vụ SSH (sshd/ssh/ssh.socket) đang không hoạt động trên hệ thống!${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# LẤY PORT HIỆN TẠI VÀ INPUT
# ==============================================================================
port_checkssh="$(awk '/^[ \t]*[Pp]ort[ \t]+[0-9]+/ {print $2; exit}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null)"
port_checkssh="${port_checkssh:-${port_ssh:-22}}"
port_checkssh="${port_checkssh//[[:space:]]/}"
[[ ! "$port_checkssh" =~ ^[0-9]+$ ]] && port_checkssh=22

port="${1:-}"
[[ "$port" == "98" || "$port" == "99" ]] && port=""

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
left_text "Cổng SSH hiện tại: ${C_GREEN}$port_checkssh${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

if [[ -z "$port" ]]; then
  echo -en "${C_CYAN}Nhập Port SSH mới bạn muốn thay đổi (1-65535) [0=Thoát]: ${C_RESET}"
  read -r port

  if [[ "$port" == "0" || -z "$port" ]]; then
    wptt_quay_ve_menu "${1:-}" 0
  fi
fi

port="${port//[[:space:]]/}"

# ==============================================================================
# VALIDATION ĐIỀU KIỆN (CHỐNG LỖI OCTAL BẰNG 10#)
# ==============================================================================
if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
  echo -e "\n${C_RED}❌ Lỗi: Cổng (Port) không hợp lệ! Vui lòng nhập số nguyên từ 1 đến 65535.${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

# Chuẩn hóa loại bỏ số 0 ở đầu (VD: 0222 -> 222)
port="$((10#$port))"
port_checkssh="$((10#$port_checkssh))"

if ((port == port_checkssh)); then
  echo -e "\n${C_YELLOW}⚠ Cổng $port chính là cổng SSH hiện tại. Không cần thay đổi!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

if ((port == 80 || port == 443)); then
  echo -e "\n${C_RED}❌ Lỗi: Cổng $port dành riêng cho máy chủ web HTTP/HTTPS!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

# Kiểm tra trùng OpenLiteSpeed WebGUI
if [[ ! -f /usr/local/lsws/conf/disablewebconsole ]] && [[ -f /usr/local/lsws/admin/conf/admin_config.conf ]]; then
  port_webgui_ols="$(awk '/address/ {if (match($0, /[0-9]+$/)) print substr($0, RSTART, RLENGTH); exit}' /usr/local/lsws/admin/conf/admin_config.conf 2>/dev/null)"
  if [[ -n "$port_webgui_ols" && "$port" == "$port_webgui_ols" ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Cổng $port đang được gán cho OpenLiteSpeed WebAdmin GUI!${C_RESET}"
    sleep 2
    wptt_quay_ve_menu "${1:-}" 1
  fi
fi

# Kiểm tra trùng Database Remote
duong_dan_cau_hinh_mariadb="/etc/my.cnf.d/server.cnf"
grep -q -i "ubuntu\|debian" /etc/os-release 2>/dev/null && duong_dan_cau_hinh_mariadb="/etc/mysql/my.cnf"

if [[ -f "$duong_dan_cau_hinh_mariadb" ]]; then
  port_mariadb_remote="$(awk -F'=' '/^[ \t]*[Pp]ort[ \t]*=/ {gsub(/[^0-9]/, "", $2); if ($2 != "") {print $2; exit}}' "$duong_dan_cau_hinh_mariadb" 2>/dev/null)"
  if [[ -n "$port_mariadb_remote" && "$port" == "$port_mariadb_remote" ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Cổng $port đang được MariaDB sử dụng!${C_RESET}"
    sleep 2
    wptt_quay_ve_menu "${1:-}" 1
  fi
fi

# ==============================================================================
# HÀM KIỂM TRA PORT LISTEN & TỰ ĐỘNG CÀI ĐẶT SS
# ==============================================================================
check_port_listen() {
  local target_port="$1"

  if ! command -v ss >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
      dnf install -y -q iproute >/dev/null 2>&1 || true
    elif command -v apt-get >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null 2>&1 || true
      DEBIAN_FRONTEND=noninteractive apt-get install -y -q iproute2 >/dev/null 2>&1 || true
    fi
  fi

  if command -v ss >/dev/null 2>&1; then
    if ss -tln 2>/dev/null | grep -qE ":${target_port}\b"; then
      return 0
    fi
    return 1
  fi

  local hex_port=""
  printf -v hex_port '%04X' "$target_port"
  if grep -qE ":${hex_port}[[:space:]]+[0-9A-Fa-f:]+:0000[[:space:]]+0A\b" /proc/net/tcp 2>/dev/null ||
     grep -qE ":${hex_port}[[:space:]]+[0-9A-Fa-f:]+:0000[[:space:]]+0A\b" /proc/net/tcp6 2>/dev/null; then
    return 0
  fi
  return 1
}

# Không cho phép đổi sang một cổng đang có dịch vụ khác lắng nghe (trừ chính sshd)
if check_port_listen "$port"; then
  echo -e "\n${C_RED}❌ Lỗi: Cổng $port hiện đang bị chiếm dụng bởi một tiến trình khác trên hệ thống!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# CÁC HÀM HELPER XỬ LÝ CSF & NFTABLES
# ==============================================================================
csf_has_port() {
  local var_name="$1"
  local target_port="$2"
  local file="$3"
  local line_val
  line_val="$(grep -E "^${var_name}[[:space:]]*=" "$file" 2>/dev/null | head -n 1 | sed -E 's/^[^"]*"([^"]*)".*/\1/' || true)"
  [[ ",$line_val," == *",$target_port,"* ]]
}

csf_add_port() {
  local var_name="$1"
  local target_port="$2"
  local file="$3"
  if ! csf_has_port "$var_name" "$target_port" "$file"; then
    /bin/sed -i -E "/^${var_name}[[:space:]]*=/ s/\"([^\"]*)\"/\"\1,${target_port}\"/" "$file"
    /bin/sed -i -E "/^${var_name}[[:space:]]*=/ s/=\"[,]+/=\"/" "$file"
  fi
}

csf_remove_port() {
  local var_name="$1"
  local target_port="$2"
  local file="$3"
  local line_val
  line_val="$(grep -E "^${var_name}[[:space:]]*=" "$file" 2>/dev/null | head -n 1 | sed -E 's/^[^"]*"([^"]*)".*/\1/' || true)"
  if [[ -n "$line_val" ]]; then
    local new_val
    new_val="$(printf '%s\n' "$line_val" | tr ',' '\n' | grep -v -E "^[[:space:]]*${target_port}[[:space:]]*$" | paste -sd, -)"
    /bin/sed -i -E "/^${var_name}[[:space:]]*=/ s/\"[^\"]*\"/\"${new_val}\"/" "$file"
  fi
}

# Helper mở Port Nftables chuẩn kiến trúc Set (tương thích cả wptt-mo-port lẫn fallback)
wptt_nft_open_ssh_port() {
  local target_p="$1"
  if [[ -f /etc/wptt/bao-mat/nftables/wptt-mo-port ]]; then
    /bin/bash /etc/wptt/bao-mat/nftables/wptt-mo-port "$target_p" tcp >/dev/null 2>&1 && return 0
  fi
  # Fallback nếu không có script wptt-mo-port nhưng có Set tcp_ports trong Kernel
  if nft list set inet filter tcp_ports >/dev/null 2>&1; then
    nft add element inet filter tcp_ports "{ $target_p }" >/dev/null 2>&1 && return 0
  fi
  return 1
}

# Helper đóng Port Nftables chuẩn kiến trúc Set
wptt_nft_close_ssh_port() {
  local target_p="$1"
  if [[ -f /etc/wptt/bao-mat/nftables/wptt-dong-port ]]; then
    /bin/bash /etc/wptt/bao-mat/nftables/wptt-dong-port "$target_p" tcp >/dev/null 2>&1 || true
  elif nft list set inet filter tcp_ports >/dev/null 2>&1; then
    nft delete element inet filter tcp_ports "{ $target_p }" >/dev/null 2>&1 || true
  fi

  # Dọn dẹp tàn dư rule lẻ từ phiên bản cũ (nếu có)
  if [[ -f /etc/nftables.conf ]] && grep -q "tcp dport ${target_p} accept" /etc/nftables.conf 2>/dev/null; then
    /bin/sed -i "/tcp dport ${target_p} accept/d" /etc/nftables.conf 2>/dev/null || true
  fi
}

# ==============================================================================
# HÀM ROLLBACK TOÀN DIỆN (TRANSACTIONAL FAIL-SAFE ROLLBACK)
# ==============================================================================
CURRENT_TASK="Nạp lại dịch vụ SSH và Tường lửa"

thuc_hien_rollback_toan_dien() {
  local ly_do="$1"
  _runloi "$CURRENT_TASK"

  echo -e "\n${C_RED}❌ PHÁT HIỆN SỰ CỐ: $ly_do${C_RESET}"
  echo -e "${C_CYAN}➜ Kích hoạt Rollback: Đang khôi phục cấu hình SSH về cổng $port_checkssh...${C_RESET}"

  # 1. Khôi phục sshd_config nguyên bản & biến cấu hình WPTangToc
  if [[ -f "$TMP_WORKSPACE/sshd_config.bkwptt" ]]; then
    /bin/cp -fp -- "$TMP_WORKSPACE/sshd_config.bkwptt" /etc/ssh/sshd_config
  fi
  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "port_ssh=$port_checkssh" 2>/dev/null || true

  # 2. Hoàn nguyên SELinux
  if command -v semanage >/dev/null 2>&1; then
    ((port != 22)) && semanage port -d -t ssh_port_t -p tcp "$port" >/dev/null 2>&1 || true
    ((port_checkssh != 22)) && semanage port -a -t ssh_port_t -p tcp "$port_checkssh" >/dev/null 2>&1 || true
  fi

  # 3. Hoàn nguyên Firewalld
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    firewall-cmd --permanent --zone=public --add-port="${port_checkssh}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --permanent --zone=public --remove-port="${port}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --reload >/dev/null 2>&1 || true
  fi

  # 4. Hoàn nguyên UFW
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow "${port_checkssh}/tcp" >/dev/null 2>&1 || true
    ufw delete allow "${port}/tcp" >/dev/null 2>&1 || true
  fi

  # 5. Hoàn nguyên CSF
  if [[ -f "$TMP_WORKSPACE/csf.conf.bak" ]]; then
    /bin/cp -fp -- "$TMP_WORKSPACE/csf.conf.bak" /etc/csf/csf.conf
    csf -r >/dev/null 2>&1 || true
  fi

  # 6. Hoàn nguyên Nftables (Đảm bảo mở lại port cũ và đóng port mới lỗi trên Set @tcp_ports)
  if systemctl is-active --quiet nftables 2>/dev/null; then
    wptt_nft_open_ssh_port "$port_checkssh" || true
    wptt_nft_close_ssh_port "$port" || true
  fi

  # 7. Hoàn nguyên Fail2ban (Tương thích ngược với các VPS cũ dùng jail sshd.local)
  if command -v fail2ban-client >/dev/null 2>&1 && [[ -f /etc/fail2ban/jail.d/sshd.local ]]; then
    if [[ -f "$TMP_WORKSPACE/fail2ban_sshd.local.bak" ]]; then
      /bin/cp -fp -- "$TMP_WORKSPACE/fail2ban_sshd.local.bak" /etc/fail2ban/jail.d/sshd.local
    else
      cat >"/etc/fail2ban/jail.d/sshd.local" <<EOF
[sshd]
enabled = true
port = $port_checkssh
backend = systemd
logpath = %(sshd_log)s
maxretry = 5
bantime = 3600
EOF
    fi
    fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1 || true
  fi

  # 8. Restart dịch vụ SSH về cổng cũ
  /bin/mkdir -p /run/sshd 2>/dev/null || true
  if systemctl list-unit-files ssh.socket 2>/dev/null | grep -q 'ssh\.socket'; then
    systemctl stop ssh.socket >/dev/null 2>&1 || true
    systemctl disable ssh.socket >/dev/null 2>&1 || true
  fi
  systemctl unmask "$SSH_SERVICE" >/dev/null 2>&1 || true
  systemctl enable "$SSH_SERVICE" >/dev/null 2>&1 || true
  systemctl restart "$SSH_SERVICE" >/dev/null 2>&1 || systemctl restart sshd >/dev/null 2>&1 || systemctl restart ssh >/dev/null 2>&1 || true

  echo -e "\n${C_GREEN}✔ ĐÃ HOÀN TẤT ROLLBACK AN TOÀN:${C_RESET}"
  echo -e "  - Cổng SSH được duy trì nguyên vẹn ở: ${C_YELLOW}$port_checkssh${C_RESET}"
  echo -e "  - Tường lửa đã khôi phục. Phiên làm việc của bạn không bị gián đoạn."
  sleep 3

  wptt_quay_ve_menu "${1:-}" 1
}

# ==============================================================================
# XÁC NHẬN VÀ THỰC THI GIAO DỊCH CHUYỂN CỔNG
# ==============================================================================
echo ""
msg_title="Xác nhận thay đổi cổng kết nối SSH của máy chủ?"
msg_info1="${C_BOLD_WHITE}Port cũ:${C_RESET} ${C_YELLOW}$port_checkssh${C_RESET}"
msg_info2="${C_BOLD_WHITE}Port mới:${C_RESET} ${C_GREEN}$port${C_RESET}"

if ! wptt_xac_nhan "$msg_title" "$msg_info1" "$msg_info2" "Đồng ý (Lưu cấu hình ngay)" "Không đồng ý (Hủy thao tác)"; then
  echo -e "${C_YELLOW}Đã hủy thao tác đổi cổng SSH.${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 0
fi

echo ""
wptt_logs "INFO" "Bắt đầu chuyển đổi port SSH từ $port_checkssh sang $port"

# ==============================================================================
# BƯỚC 1: SAO LƯU TOÀN DIỆN VÀ CHỈNH SỬA SSHD_CONFIG TRÊN CANDIDATE
# ==============================================================================
CURRENT_TASK="Kiểm tra và tiền xử lý cấu hình SSHD"
_runing "$CURRENT_TASK"

TMP_SSHD_CONF="$TMP_WORKSPACE/sshd_config"
/bin/cp -fp /etc/ssh/sshd_config "$TMP_WORKSPACE/sshd_config.bkwptt" || {
  _runloi "$CURRENT_TASK"
  echo -e "${C_RED}Không thể sao lưu file sshd_config!${C_RESET}"
  exit 1
}
/bin/cp -fp /etc/ssh/sshd_config "$TMP_SSHD_CONF"

# Chỉnh sửa port trên bản candidate
/bin/sed -i '/^[[:space:]]*#\?[[:space:]]*Port[[:space:]]/d' "$TMP_SSHD_CONF"
/bin/sed -i "1 i Port $port" "$TMP_SSHD_CONF"

# Validate cú pháp SSHD bằng binary
if ! /usr/sbin/sshd -t -f "$TMP_SSHD_CONF" >/dev/null 2>&1; then
  _runloi "$CURRENT_TASK"
  echo -e "${C_RED}Lỗi cú pháp SSHD phát hiện trên bản tạm! Đã hủy thao tác.${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi
_rundone "$CURRENT_TASK"

# ==============================================================================
# BƯỚC 2: CHUYỂN TIẾP TƯỜNG LỬA (MỞ CỔNG MỚI, BẢO TOÀN CỔNG CŨ)
# ==============================================================================
CURRENT_TASK="Mở cổng $port trên hệ thống tường lửa (Dual-Port Transition)"
_runing "$CURRENT_TASK"

# 2.1. Cấp phép SELinux trước
if command -v semanage >/dev/null 2>&1 && ((port != 22)); then
  if ! semanage port -a -t ssh_port_t -p tcp "$port" >/dev/null 2>&1; then
    semanage port -m -t ssh_port_t -p tcp "$port" >/dev/null 2>&1 || true
  fi
fi

# 2.2. Firewalld: Mở cổng mới
if systemctl is-active --quiet firewalld 2>/dev/null; then
  if ! firewall-cmd --permanent --zone=public --add-port="${port}/tcp" >/dev/null 2>&1 ||
     ! firewall-cmd --reload >/dev/null 2>&1; then
    thuc_hien_rollback_toan_dien "Firewalld từ chối nạp port mới ($port)"
  fi
fi

# 2.3. UFW: Mở cổng mới nếu UFW đang chạy
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
  ufw allow "${port}/tcp" >/dev/null 2>&1 || true
fi

# 2.4. CSF: Phẫu thuật chính xác TCP_IN & TCP6_IN theo Token
if [[ -f /etc/csf/csf.conf ]] && command -v csf >/dev/null 2>&1; then
  /bin/cp -fp /etc/csf/csf.conf "$TMP_WORKSPACE/csf.conf.bak"
  TMP_CSF="$TMP_WORKSPACE/csf.conf"
  /bin/cp -fp /etc/csf/csf.conf "$TMP_CSF"

  csf_add_port "TCP_IN" "$port" "$TMP_CSF"
  if grep -qE '^TCP6_IN[[:space:]]*=' "$TMP_CSF"; then
    csf_add_port "TCP6_IN" "$port" "$TMP_CSF"
  fi

  if ! csf_has_port "TCP_IN" "$port" "$TMP_CSF"; then
    thuc_hien_rollback_toan_dien "Không thể nạp port $port vào danh sách TCP_IN của CSF"
  fi

  /bin/cp -fp "$TMP_CSF" /etc/csf/csf.conf
  if ! csf -r >/dev/null 2>&1; then
    thuc_hien_rollback_toan_dien "Lệnh nạp lại CSF (csf -r) thất bại!"
  fi
fi

# 2.5. Nftables Thuần: Mở cổng mới trực tiếp vào Set @tcp_ports (Zero-Downtime, bảo toàn SSHGuard)
if systemctl is-active --quiet nftables 2>/dev/null; then
  [[ -f /etc/nftables.conf ]] && /bin/cp -fp /etc/nftables.conf "$TMP_WORKSPACE/nftables.conf.bak"
  if ! wptt_nft_open_ssh_port "$port"; then
    thuc_hien_rollback_toan_dien "Nftables không thể mở cổng mới ($port) trong Set @tcp_ports!"
  fi
fi

# 2.6. Snapshot cấu hình Fail2ban
if [[ -f /etc/fail2ban/jail.d/sshd.local ]]; then
  /bin/cp -fp /etc/fail2ban/jail.d/sshd.local "$TMP_WORKSPACE/fail2ban_sshd.local.bak"
fi

_rundone "$CURRENT_TASK"

# ==============================================================================
# BƯỚC 3: COMMIT CẤU HÌNH SSHD VÀ KIỂM TRA HEALTH CHECK LISTENER THẬT
# ==============================================================================
CURRENT_TASK="Áp dụng cấu hình SSHD và xác thực Socket Listener"
_runing "$CURRENT_TASK"

# Tráo đổi cấu hình sshd_config
/bin/cp -fp "$TMP_SSHD_CONF" /etc/ssh/sshd_config

# Đồng bộ port_ssh vào cấu hình trên các file drop-in nếu cloud image tạo sẵn
if [[ -d /etc/ssh/sshd_config.d ]]; then
  for dropin_file in /etc/ssh/sshd_config.d/*.conf; do
    [[ -f "$dropin_file" ]] || continue
    if grep -qE '^[[:space:]]*[Pp]ort[[:space:]]+[0-9]+' "$dropin_file" 2>/dev/null; then
      /bin/sed -i -E "s/^[[:space:]]*[Pp]ort[[:space:]]+[0-9]+/Port $port/g" "$dropin_file"
    fi
  done
fi

# Bảo đảm thư mục phân tách đặc quyền tồn tại trên Ubuntu/Debian
/bin/mkdir -p /run/sshd 2>/dev/null || true

# XỬ LÝ ĐẶC THÙ UBUNTU 22.10+/24.04:
# Tắt ssh.socket để chuyển sang standalone daemon, nhận cấu hình Port từ sshd_config
if systemctl list-unit-files ssh.socket 2>/dev/null | grep -q 'ssh\.socket'; then
  systemctl stop ssh.socket >/dev/null 2>&1 || true
  systemctl disable ssh.socket >/dev/null 2>&1 || true
fi

# Bật và khởi động service SSH độc lập
systemctl unmask "$SSH_SERVICE" >/dev/null 2>&1 || true
systemctl enable "$SSH_SERVICE" >/dev/null 2>&1 || true

if ! (systemctl restart "$SSH_SERVICE" >/dev/null 2>&1 || systemctl restart sshd >/dev/null 2>&1 || systemctl restart ssh >/dev/null 2>&1); then
  thuc_hien_rollback_toan_dien "Dịch vụ $SSH_SERVICE không thể khởi động với port mới ($port)!"
fi

# HEALTH CHECK: Xác minh cổng thực sự ở trạng thái LISTEN (chờ tối đa 5 giây)
is_listening=0
for ((i = 1; i <= 10; i++)); do
  if check_port_listen "$port"; then
    is_listening=1
    break
  fi
  sleep 0.5
done

if ((is_listening == 0)); then
  thuc_hien_rollback_toan_dien "Dịch vụ SSH đã chạy nhưng không tìm thấy Socket lắng nghe trên cổng $port!"
fi

# Lưu ngay metadata WPTangToc để wptt-dong-port ở Bước 4 nhận diện đúng Port SSH mới
wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "port_ssh=$port" 2>/dev/null || true

_rundone "$CURRENT_TASK"

# ==============================================================================
# BƯỚC 4: DỌN DẸP CỔNG CŨ TRÊN TƯỜNG LỬA (CHỈ CHẠY KHI ĐÃ XÁC THỰC CỔNG MỚI)
# ==============================================================================
CURRENT_TASK="Thu hồi cổng SSH cũ ($port_checkssh) trên tường lửa"
_runing "$CURRENT_TASK"

# 4.1. Gỡ cổng cũ trên Firewalld
if systemctl is-active --quiet firewalld 2>/dev/null; then
  firewall-cmd --permanent --zone=public --remove-port="${port_checkssh}/tcp" >/dev/null 2>&1 || true
  firewall-cmd --reload >/dev/null 2>&1 || true
fi

# 4.2. Gỡ cổng cũ trên UFW
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
  ufw delete allow "${port_checkssh}/tcp" >/dev/null 2>&1 || true
fi

# 4.3. Gỡ cổng cũ khỏi TCP_IN & TCP6_IN trong CSF
if [[ -f /etc/csf/csf.conf ]] && command -v csf >/dev/null 2>&1; then
  TMP_CSF="$TMP_WORKSPACE/csf_clean.conf"
  /bin/cp -fp /etc/csf/csf.conf "$TMP_CSF"

  csf_remove_port "TCP_IN" "$port_checkssh" "$TMP_CSF"
  if grep -qE '^TCP6_IN[[:space:]]*=' "$TMP_CSF"; then
    csf_remove_port "TCP6_IN" "$port_checkssh" "$TMP_CSF"
  fi

  /bin/cp -fp "$TMP_CSF" /etc/csf/csf.conf
  csf -r >/dev/null 2>&1 || true
fi

# 4.4. Thu hồi cổng cũ trong Set @tcp_ports của Nftables (và lưu cấu hình vĩnh viễn)
if systemctl is-active --quiet nftables 2>/dev/null; then
  wptt_nft_close_ssh_port "$port_checkssh"
fi

# 4.5. Thu hồi quyền SELinux của cổng cũ (nếu cổng cũ không phải cổng 22 mặc định)
if command -v semanage >/dev/null 2>&1 && ((port_checkssh != 22)); then
  semanage port -d -t ssh_port_t -p tcp "$port_checkssh" >/dev/null 2>&1 || true
fi

# 4.6. Cập nhật Fail2ban bảo vệ cổng mới (Tương thích ngược với các hệ thống cũ dùng fail2ban sshd)
if command -v fail2ban-client >/dev/null 2>&1 && [[ -f /etc/fail2ban/jail.d/sshd.local ]]; then
  cat >"/etc/fail2ban/jail.d/sshd.local" <<EOF
[sshd]
enabled = true
port = $port
backend = systemd
logpath = %(sshd_log)s
maxretry = 5
bantime = 3600
EOF
  fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1 || true
fi

_rundone "$CURRENT_TASK"
wptt_logs "INFO" "Hoàn tất thay đổi cổng SSH từ $port_checkssh sang $port thành công"

# ==============================================================================
# THÔNG BÁO HOÀN TẤT
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}THAY ĐỔI CỔNG SSH THÀNH CÔNG${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}Cổng SSH Mới:${C_RESET} ${C_YELLOW}$port${C_RESET}" 2
left_text "Dịch vụ SSH đã được xác thực đang lắng nghe trên cổng mới." 2
left_text "Tường lửa đã mở cổng $port và đóng cổng cũ $port_checkssh an toàn." 2
left_text "${C_YELLOW}Lưu ý:${C_RESET} Bạn cần kết nối lại với flag: ${C_GREEN}ssh -p $port user@server_ip${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

wptt_quay_ve_menu "${1:-}" 0 "enter"
