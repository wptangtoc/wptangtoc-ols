#!/bin/bash
# Nạp thư viện WPTangToc
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

mkdir -p /etc/wptt/tmp 2>/dev/null
TMP_WORKSPACE=$(mktemp -d -p "/etc/wptt/tmp" ssh_port.XXXXXX) || {
  echo -e "${C_RED}Lỗi: Không thể tạo thư mục tạm${C_RESET}"
  exit 1
}
trap '/bin/rm -rf "$TMP_WORKSPACE"' EXIT

function huong_dan() {
  cat <<'EOF'
 Việc thay đổi cổng [port] SSH mặc định [thường là cổng 22] là một trong những biện pháp bảo mật cơ bản và hiệu quả cho máy chủ Linux.

 Dưới đây là giới thiệu ngắn gọn về tính năng này:

 Tại sao cần thay đổi cổng SSH?
 * Giảm thiểu tấn công tự động [Automated Attacks]: Rất nhiều bot và script độc hại tự động quét cổng 22. Việc đổi sang cổng khác làm giảm đáng kể các cuộc tấn công này.
 * Tăng cường bảo mật qua việc ẩn náu [Security through obscurity].
 * Tránh xung đột cổng [Port Conflicts].

 Lợi ích chính:
 * Giảm đáng kể log tấn công brute-force.
 * Làm cho máy chủ của bạn ít bị chú ý hơn.
EOF
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ SSH ➜ ${thay_doi_port_ssh:-Thay đổi Port SSH}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# Kiểm tra dịch vụ SSH có hoạt động không
if [[ ! -w /etc/ssh/sshd_config ]] || ! systemctl is-active --quiet sshd; then
  if ! systemctl is-active --quiet ssh; then # Dự phòng cho Ubuntu/Debian
    echo -e "\nHệ thống kiểm tra máy chủ không sử dụng, hoặc service SSH đang không hoạt động!"
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
    return 1 2>/dev/null || exit 1
  fi
fi

# ==============================================================================
# LẤY PORT HIỆN TẠI VÀ LẤY INPUT TỪ NGƯỜI DÙNG
# ==============================================================================
port_checkssh=$(grep -E '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config | awk '{print $2}' | head -n 1)
port_checkssh=${port_checkssh:-22} # Trả về 22 nếu kết quả rỗng

port=$1 # Xác định port đối số
[[ "$port" == '98' ]] && port=''

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
left_text "Cổng SSH hiện tại: ${C_GREEN}$port_checkssh${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

if [[ -z "$port" ]]; then
  echo -en "${C_CYAN}Nhập Port SSH mới bạn muốn thay đổi (1-65535) [0=Thoát]: ${C_RESET}"
  read -r port

  if [[ "$port" == "0" || -z "$port" ]]; then
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
    return 2>/dev/null || exit 0
  fi
fi

# ==============================================================================
# KIỂM TRA ĐIỀU KIỆN (VALIDATION) CHẶT CHẼ
# ==============================================================================
# 1. Kiểm tra định dạng Regex
if ! [[ "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
  echo -e "\n${C_RED}❌ Lỗi: Cổng (Port) không hợp lệ! Vui lòng nhập số nguyên từ 1 đến 65535.${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
  return 1 2>/dev/null || exit 1
fi

# 2. Kiểm tra trùng lặp với Webserver cơ bản
if [[ "$port" == "$port_checkssh" || "$port" == "80" || "$port" == "443" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Bạn vui lòng chọn Port khác! Cổng $port đang được sử dụng bởi hệ thống Webserver.${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
  return 1 2>/dev/null || exit 1
fi

# 3. Kiểm tra trùng lặp với WebGUI OLS
if [[ ! -f /usr/local/lsws/conf/disablewebconsole ]] && [[ -f /usr/local/lsws/admin/conf/admin_config.conf ]]; then
  port_webgui_openlitespeed=$(grep "address" /usr/local/lsws/admin/conf/admin_config.conf | grep -o '[0-9]\+$' || true)
  if [[ "$port" == "$port_webgui_openlitespeed" ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Bạn vui lòng chọn Port khác! Cổng $port đang được sử dụng bởi OpenLiteSpeed WebGUI.${C_RESET}"
    sleep 2
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
    return 1 2>/dev/null || exit 1
  fi
fi

# 4. Kiểm tra trùng lặp Database
if grep -q -i "ubuntu\|debian" /etc/os-release 2>/dev/null; then
  duong_dan_cau_hinh_mariadb="/etc/mysql/my.cnf"
else
  duong_dan_cau_hinh_mariadb="/etc/my.cnf.d/server.cnf"
fi

if [[ -f "$duong_dan_cau_hinh_mariadb" ]]; then
  port_mariadb_remote=$(grep -i 'port=' "$duong_dan_cau_hinh_mariadb" | grep -o '[0-9]\+$' | head -n 1 || true)
  if [[ -n "$port_mariadb_remote" && "$port" == "$port_mariadb_remote" ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Bạn vui lòng chọn Port khác! Cổng $port đang được sử dụng bởi MariaDB Remote.${C_RESET}"
    sleep 2
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
    return 1 2>/dev/null || exit 1
  fi
fi

# ==============================================================================
# HÀM ROLLBACK TOÀN DIỆN (STATEFUL FAIL-SAFE ROLLBACK)
# ==============================================================================
thuc_hien_rollback_toan_dien() {
  local ly_do="$1"
  echo -en "\033[1A\033[2K\r"
  _runloi "Nạp lại dịch vụ SSHD và Fail2ban"

  echo -e "${C_YELLOW}⚠ Phát hiện sự cố: $ly_do${C_RESET}"
  echo -e "${C_CYAN}➜ Đang kích hoạt Rollback an toàn: Khôi phục SSHD và mở lại cổng $port_checkssh trên tường lửa...${C_RESET}"

  # 1. Phục hồi cấu hình sshd_config về port cũ
  if [[ -f "$TMP_WORKSPACE/sshd_config.bkwptt" ]]; then
    /bin/mv -fT "$TMP_WORKSPACE/sshd_config.bkwptt" /etc/ssh/sshd_config
  fi

  # 2. Hoàn nguyên SELinux (Gỡ port mới, bảo đảm port cũ được cấp phép)
  if command -v semanage >/dev/null 2>&1; then
    semanage port -d -t ssh_port_t -p tcp "$port" >/dev/null 2>&1 || true
    semanage port -a -t ssh_port_t -p tcp "$port_checkssh" >/dev/null 2>&1 || true
  fi

  # 3. Hoàn nguyên Firewalld: Đóng port mới, mở lại port cũ
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    firewall-cmd --permanent --zone=public --remove-port="$port"/tcp >/dev/null 2>&1 || true
    firewall-cmd --permanent --zone=public --add-port="$port_checkssh"/tcp >/dev/null 2>&1 || true
    firewall-cmd --reload >/dev/null 2>&1 || true
  fi

  # 4. Hoàn nguyên CSF: Khôi phục từ file backup sạch
  if [[ -f "$TMP_WORKSPACE/csf.conf.bak" ]]; then
    /bin/mv -fT "$TMP_WORKSPACE/csf.conf.bak" /etc/csf/csf.conf
    csf -r >/dev/null 2>&1 || true
  fi

  # 5. Hoàn nguyên NFTables: Khôi phục từ file backup sạch
  if [[ -n "$path_nftables_config" && -f "$TMP_WORKSPACE/nftables.conf.bak" ]]; then
    /bin/mv -fT "$TMP_WORKSPACE/nftables.conf.bak" "$path_nftables_config"
    systemctl reload nftables >/dev/null 2>&1 || systemctl restart nftables >/dev/null 2>&1 || true
  fi

  # 6. Hoàn nguyên Fail2ban về port cũ
  if [[ -f "$TMP_WORKSPACE/fail2ban_sshd.local.bak" ]]; then
    /bin/mv -fT "$TMP_WORKSPACE/fail2ban_sshd.local.bak" /etc/fail2ban/jail.d/sshd.local
  else
    cat >"/etc/fail2ban/jail.d/sshd.local" <<EOF
[sshd]
enabled = true
port = $port_checkssh
backend = systemd
logpath = %(sshd_log)s
maxretry = 5
bantime = 3600
EOF
  fi
  fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1 || true

  # 7. Khởi động lại dịch vụ SSH trên port cũ
  systemctl restart sshd >/dev/null 2>&1 || systemctl restart ssh >/dev/null 2>&1 || true
  if systemctl is-active --quiet ssh.socket 2>/dev/null; then
    systemctl restart ssh.socket >/dev/null 2>&1 || true
  fi

  echo -e "\n${C_GREEN}✔ ĐÃ HOÀN TẤT ROLLBACK TOÀN DIỆN:${C_RESET}"
  echo -e "  - Cấu hình SSH đã được khôi phục về cổng cũ: ${C_YELLOW}$port_checkssh${C_RESET}"
  echo -e "  - Tường lửa đã đóng cổng lỗi ($port) và BẢO ĐẢM MỞ CỔNG CŨ ($port_checkssh)."
  echo -e "  - Kết nối SSH của bạn an toàn tuyệt đối, không bị gián đoạn."
  sleep 3

  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssh-main 1
  exit 1
}

# ==============================================================================
# XÁC NHẬN VÀ THỰC THI (ATOMIC EDIT & ROLLBACK)
# ==============================================================================
echo ""
msg_title="Xác nhận thay đổi cổng kết nối SSH của máy chủ?"
msg_info1="${C_BOLD_WHITE}Port cũ:${C_RESET} ${C_YELLOW}$port_checkssh${C_RESET}"
msg_info2="${C_BOLD_WHITE}Port mới:${C_RESET} ${C_GREEN}$port${C_RESET}"

if wptt_xac_nhan "$msg_title" "$msg_info1" "$msg_info2" "Đồng ý (Lưu cấu hình ngay)" "Không đồng ý (Hủy thao tác)"; then
  echo ""
  wptt_logs "INFO" "Thiết lập thay đổi port SSH từ $port_checkssh sang $port"

  _runing "Cập nhật cấu hình và kiểm tra SSHD"

  # 1. Sao lưu cấu hình SSHD nguyên tử
  TMP_SSHD_CONF="$TMP_WORKSPACE/sshd_config"
  /bin/cp -fp /etc/ssh/sshd_config "$TMP_SSHD_CONF"
  /bin/cp -fp /etc/ssh/sshd_config "$TMP_WORKSPACE/sshd_config.bkwptt"

  # Chỉnh sửa trên file tạm
  /bin/sed -i '/^[[:space:]]*#\?[[:space:]]*Port[[:space:]]/d' "$TMP_SSHD_CONF"
  /bin/sed -i "1 i Port $port" "$TMP_SSHD_CONF"

  # Kiểm thử cô lập cú pháp bằng file nháp
  if ! /usr/sbin/sshd -t -f "$TMP_SSHD_CONF" >/dev/null 2>&1; then
    echo -en "\033[1A\033[2K\r"
    _runloi "Cập nhật cấu hình và kiểm tra SSHD"
    echo -e "${C_RED}Lỗi cú pháp bị phát hiện trên file tạm! Quá trình đã bị hủy. Máy chủ an toàn tuyệt đối.${C_RESET}"
    sleep 3

    if [[ "${1:-}" == "98" ]]; then
      exec /etc/wptt/wptt-ssh-main 1
    fi
    exit 1
  fi

  # Ghi đè cấu hình SSHD nguyên tử Zero-Downtime
  /bin/mv -fT "$TMP_SSHD_CONF" /etc/ssh/sshd_config
  _rundone "Cập nhật cấu hình và kiểm tra SSHD"

  # ==============================================================================
  # BƯỚC 1: MỞ THÊM PORT MỚI TRÊN TƯỜNG LỬA (DUAL-PORT TRANSITION)
  # (Giữ nguyên Port cũ để nếu SSHD restart thất bại, người dùng không bị Lockout)
  # ==============================================================================
  _runing "Cấu hình tường lửa cho Port $port"

  # 1.1. SELinux: Cấp phép port mới
  if command -v semanage >/dev/null 2>&1; then
    semanage port -a -t ssh_port_t -p tcp "$port" >/dev/null 2>&1 || true
  fi

  # 1.2. Firewalld: Mở thêm port mới (CHƯA XÓA port cũ)
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    firewall-cmd --permanent --zone=public --add-port="$port"/tcp >/dev/null 2>&1
    firewall-cmd --reload >/dev/null 2>&1
  fi

  # 1.3. CSF: Backup và mở thêm port mới vào TCP_IN (CHƯA XÓA port cũ)
  if [[ -f /etc/csf/csf.conf ]]; then
    /bin/cp -fp /etc/csf/csf.conf "$TMP_WORKSPACE/csf.conf.bak"
    TMP_CSF="$TMP_WORKSPACE/csf.conf"
    /bin/cp -fp /etc/csf/csf.conf "$TMP_CSF"
    if ! grep -qE "(^|[,\"])$port([,\"])" "$TMP_CSF"; then
      /bin/sed -i "s/^TCP_IN = \"/TCP_IN = \"$port,/g" "$TMP_CSF"
      /bin/mv -fT "$TMP_CSF" /etc/csf/csf.conf
      csf -r >/dev/null 2>&1
    fi
  fi

  # 1.4. NFTables: Backup và thêm rule accept port mới (CHƯA XÓA rule port cũ)
  path_nftables_config=""
  if systemctl is-active --quiet nftables 2>/dev/null; then
    if grep -q -i "ubuntu\|debian" /etc/os-release 2>/dev/null; then
      path_nftables_config="/etc/nftables.conf"
    else
      path_nftables_config="/etc/sysconfig/nftables.conf"
    fi
    if [[ -f "$path_nftables_config" ]]; then
      /bin/cp -fp "$path_nftables_config" "$TMP_WORKSPACE/nftables.conf.bak"
      TMP_NFT="$TMP_WORKSPACE/nftables.conf"
      /bin/cp -fp "$path_nftables_config" "$TMP_NFT"
      /bin/sed -i "/chain input /a\    tcp dport $port accept #port ssh new" "$TMP_NFT"
      /bin/mv -fT "$TMP_NFT" "$path_nftables_config"
      systemctl reload nftables >/dev/null 2>&1 || systemctl restart nftables >/dev/null 2>&1
    fi
  fi

  # 1.5. Sao lưu cấu hình Fail2ban hiện tại trước khi thay đổi
  if [[ -f /etc/fail2ban/jail.d/sshd.local ]]; then
    /bin/cp -fp /etc/fail2ban/jail.d/sshd.local "$TMP_WORKSPACE/fail2ban_sshd.local.bak"
  fi

  _rundone "Cấu hình tường lửa cho Port $port"

  # ==============================================================================
  # BƯỚC 2: NẠP LẠI DỊCH VỤ SSH VÀ BẪY ROLLBACK
  # ==============================================================================
  _runing "Nạp lại dịch vụ SSHD và Fail2ban"

  # Khởi động lại dịch vụ SSHD
  if ! (systemctl restart sshd >/dev/null 2>&1 || systemctl restart ssh >/dev/null 2>&1); then
    thuc_hien_rollback_toan_dien "Không thể khởi động dịch vụ SSH trên cổng mới ($port)"
  fi

  # Hỗ trợ socket activation nếu có trên Ubuntu mới
  if systemctl is-active --quiet ssh.socket 2>/dev/null; then
    systemctl restart ssh.socket >/dev/null 2>&1 || true
  fi

  # ==============================================================================
  # BƯỚC 3: DỌN DẸP PORT CŨ TRÊN TƯỜNG LỬA (CHỈ THỰC HIỆN KHI ĐÃ THÀNH CÔNG 100%)
  # ==============================================================================
  # 3.1. Gỡ port cũ trên Firewalld
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    firewall-cmd --permanent --zone=public --remove-port="$port_checkssh"/tcp >/dev/null 2>&1
    firewall-cmd --reload >/dev/null 2>&1
  fi

  # 3.2. Gỡ port cũ khỏi TCP_IN trong CSF
  if [[ -f /etc/csf/csf.conf ]]; then
    TMP_CSF="$TMP_WORKSPACE/csf.conf"
    /bin/cp -fp /etc/csf/csf.conf "$TMP_CSF"
    /bin/sed -i -r '/^TCP_IN /s/([",])'"$port_checkssh"',|,'"$port_checkssh"'([,"])/\1\2/' "$TMP_CSF"
    /bin/mv -fT "$TMP_CSF" /etc/csf/csf.conf
    csf -r >/dev/null 2>&1
  fi

  # 3.3. Dọn dẹp rule cũ trong NFTables
  if [[ -n "$path_nftables_config" && -f "$path_nftables_config" ]]; then
    TMP_NFT="$TMP_WORKSPACE/nftables.conf"
    /bin/cp -fp "$path_nftables_config" "$TMP_NFT"
    /bin/sed -i '/tcp dport [0-9]\+ accept #port ssh$/d' "$TMP_NFT"
    /bin/sed -i 's/#port ssh new/#port ssh/' "$TMP_NFT"
    /bin/mv -fT "$TMP_NFT" "$path_nftables_config"
    systemctl reload nftables >/dev/null 2>&1 || systemctl restart nftables >/dev/null 2>&1
  fi

  # 3.4. Cập nhật cấu hình Fail2ban cho port mới
  cat >"/etc/fail2ban/jail.d/sshd.local" <<EOF
[sshd]
enabled = true
port = $port
backend = systemd
logpath = %(sshd_log)s
maxretry = 5
bantime = 3600
EOF
  fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1

  # Ghi cấu hình thành công vào metadata WPTangToc
  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "port_ssh=$port"

  _rundone "Nạp lại dịch vụ SSHD và Fail2ban"

  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}THAY ĐỔI CỔNG SSH THÀNH CÔNG${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "${C_BOLD_WHITE}Cổng SSH Mới:${C_RESET} ${C_YELLOW}$port${C_RESET}"
  left_text "${C_RESET}  Bạn cần kết nối lại SSH bằng cổng mới ở lần đăng nhập sau."
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

else
  echo -e "${C_YELLOW}Đã hủy thao tác đổi cổng SSH.${C_RESET}"
fi

if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-ssh-main 1
fi
