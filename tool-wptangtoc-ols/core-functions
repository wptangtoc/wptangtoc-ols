#!/bin/bash
# ==============================================================================
# Đường dẫn: . /etc/wptt/core-functions
# Mọi script cần gọi: . /etc/wptt/core-functions để sử dụng
# ==============================================================================


# Bash script wptangtoc ols kế thừa toàn bộ rủi ro từ môi trường bên ngoài và hành xử một cách hên xui từ môi trường ngoài. Việc áp dụng nó mang lại 3 lớp khiên bảo vệ cốt lõi, chuyển đổi mô hình hệ thống từ "Tin tưởng ngầm định" sang "Zero Trust" (Không tin tưởng bất kỳ ai): giảm thiểu ngoại vi tác động đến code.
# BẢO MẬT: LÀM SẠCH MÔI TRƯỜNG THỰC THI (ENVIRONMENT SANITIZATION)
# 1. Tiêu diệt các biến môi trường độc hại (Chống Code Execution & Path Hijacking)
unset LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV CDPATH

# 2. Ép cứng vách ngăn từ ngữ chuẩn của Bash (Tránh tấn công Word-Splitting)
IFS=$' \t\n'

# 3. Đóng đinh đường dẫn PATH (Chống chạy nhầm file thực thi giả mạo)
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# BẢO MẬT END: LÀM SẠCH MÔI TRƯỜNG THỰC THI (ENVIRONMENT SANITIZATION)


# ------------------------------------------------------------------------------
# 1. HÀM NHẬN DIỆN HỆ ĐIỀU HÀNH (OS DETECTION)
# Trả về: "rhel" (Alma/Rocky/RHEL/Oracle) hoặc Ubuntu
# cách dùng 1: if [[ "$(wptt_get_os_family)" == "ubuntu" ]]; then

#cách 2: # Gán kết quả của hàm vào biến OS
#OS=$(wptt_get_os_family)
# Sau đó lấy biến OS ra dùng thoải mái ở mọi nơi
#if [[ "$OS" == "ubuntu" ]]; then
#  echo 'giatuandz ubuntu'
#elif [[ "$OS" == "rhel" ]]; then
#  echo 'almalinux'
#fi
# ------------------------------------------------------------------------------
function wptt_get_os_family() {
  if grep -qi "ubuntu" /etc/*release; then
    echo "ubuntu"
  elif grep -q "AlmaLinux\|Rocky Linux\|Red Hat Enterprise Linux\|Oracle Linux Server" /etc/*release; then
    echo "rhel"
  else
    echo "unknown"
  fi
}

# ------------------------------------------------------------------------------
# 2. HÀM LẤY IP PUBLIC SIÊU TỐC VÀ CHỐNG LỖI MẠNG
# Tự động thử các API khác nhau, có timeout 3s để không làm treo panel
# ------------------------------------------------------------------------------
function wptt_get_public_ip() {
  local ip
  ip=$(curl -sf -m 3 ipv4.icanhazip.com)
  if [[ -z "$ip" ]]; then
    ip=$(curl -sf -m 3 api.ipify.org)
  fi
  if [[ -z "$ip" ]]; then
    ip=$(curl -sf -m 3 ifconfig.me)
  fi
  echo "$ip"
}

# ------------------------------------------------------------------------------
# 3. HÀM LẤY DUNG LƯỢNG RAM THỰC TẾ (Đơn vị: MB)
# Phục vụ cho việc chia RAM cho OLS, MariaDB, Object Cache tự động
# ------------------------------------------------------------------------------
function wptt_get_ram_mb() {
  local ram_bytes
  ram_bytes=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  local ram_mb=$(echo "scale=0;${ram_bytes}/1024" | bc)
  if [[ -z "$ram_mb" ]]; then
    echo "2048" # Fallback an toàn nếu lỗi
  else
    echo "$ram_mb"
  fi
}

# ------------------------------------------------------------------------------
# 4. HÀM BẢO VỆ CHỐNG TỰ HỦY KHI XÓA THƯ MỤC (ANTI RM -RF /)
# Rất quan trọng khi xóa Vhost. Nếu domain rỗng hoặc chứa ký tự nguy hiểm sẽ báo lỗi.
# Cách dùng: if wptt_kha_dung_de_xoa_xac_thuc "$domain"; then ...
# ------------------------------------------------------------------------------
function wptt_kha_dung_de_xoa_xac_thuc() {
  local domain="$1"
  # Kiểm tra rỗng, trùng root, hoặc có wildcard nguy hiểm
  if [[ -z "$domain" || "$domain" == "." || "$domain" == "/" || "$domain" == *"*"* ]]; then
    return 1 # Trả về False (Lỗi)
  fi
  # Kiểm tra đúng chuẩn định dạng domain (có dấu chấm, không ký tự lạ)
  if [[ ! "$domain" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
    return 1
  fi
  return 0 # Trả về True (Hợp lệ)
}

# ------------------------------------------------------------------------------
# HÀM KIỂM TRA QUYỀN ROOT KHỞI CHẠY
# Cách dùng:
# if ! wptt_check_is_root; then
#   echo "Lỗi: Bạn phải chạy script này bằng quyền Root!"; exit 1;
# fi
# ------------------------------------------------------------------------------
function wptt_check_is_root() {
  if [[ $EUID -ne 0 ]]; then
    return 1 # Không phải root
  fi
  return 0
}

wptt_die() {
  local ERROR_MSG="$1"
  echo -e "\e[31m[LỖI CHÍ MẠNG] $ERROR_MSG\e[0m"

  # Kích hoạt tính năng quay đầu nếu đang ở trong Menu
  if [[ "$WPTT_IN_MENU" == "yes" && -n "$WPTT_MENU_BACK" ]]; then
    echo ""
    read -n 1 -s -r -p "Nhấn phím bất kỳ để quay lại Menu..."
    echo ""
    exec $WPTT_MENU_BACK
  else
    # Nếu gọi bằng dòng lệnh trực tiếp thì thoát hẳn
    exit 1
  fi
}

#Hướng dẫn sử dụng: wptt_check_mariadb || wptt_die "MariaDB đang bị sập! Hệ thống từ chối tạo Database mới."
wptt_check_mariadb() {
  # Lớp 1: Kiểm tra Service của Hệ điều hành
  if ! systemctl is-active --quiet mariadb; then
    systemctl start mariadb || {
      return 1 # Trả về lỗi
    }
  fi

  # Lớp 2: Kiểm tra kết nối thực tế (Sát chiêu)
  # Dùng mysqladmin ping để xem DB có thực sự đang lắng nghe hay không, dùng localhost dùng --skip-ssl cũng được
  if ! mariadb-admin --skip-ssl ping >/dev/null 2>&1; then
    return 1 # Trả về lỗi
  fi

  # Lớp 3: Pass qua hết thì OK
  return 0 # Trả về true
}

#Hướng dẫn sử dụng: wptt_check_lsws || wptt_die "OpenLiteSpeed đang bị lỗi hoặc không mở được cổng mạng. Đã hủy thao tác để an toàn!"
#cách hành code kiểu này giải quyết vấn đề: đó chính là người dùng reboot với máy chủ rất nhiều vhost có thể downtime vài giây nhẹ nó đúng lúc người ta thêm website... dùng thư viện này thì đúng là không ổn, cách viết kiểu này sẽ tối ưu hơn tình huống đó
wptt_check_lsws() {
  local max_retries=8
  local wait_time=2
  local attempt=1

  while (( attempt <= max_retries )); do
    # Lớp 1: Kiểm tra Service cấp Hệ điều hành (systemd)
    if ! systemctl is-active --quiet lsws; then
      systemctl start lsws >/dev/null 2>&1
    fi

    # Lớp 2: Kiểm tra bằng công cụ lõi của OpenLiteSpeed
    # Xác minh Master Process (Tiến trình mẹ) thực sự tồn tại và có số PID rõ ràng
    if /usr/local/lsws/bin/lswsctrl status 2>/dev/null | grep -iq "is running"; then
      return 0 # Dịch vụ đã chạy bình thường -> Báo thành công và thoát hàm
    fi

    # Nếu chưa chạy, ngủ (sleep) 2 giây rồi vòng lại thử tiếp
    sleep "$wait_time"
    ((attempt++))
  done

  # Nếu lặp hết 8 lần (6 giây) mà vẫn không thấy "is running" -> Sập thật sự
  return 1
}

