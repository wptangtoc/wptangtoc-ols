# ==============================================================================
# HÀM MÃ HÓA & GIẢI MÃ AES-256-CBC
# ==============================================================================

# Hàm Mã hóa
wptt_ma_hoa() {
# thời gian nữa xoá tuơng thích nguợc
WPTT_AES_DIR="/etc/wptt-aes"
WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

# 1. Xây boong-ke và khóa cửa (Chỉ Root được vào)
if [[ ! -d "$WPTT_AES_DIR" ]]; then
	mkdir -p "$WPTT_AES_DIR"
	chmod 700 "$WPTT_AES_DIR"
fi

# 2. Sinh chìa khóa ngẫu nhiên nếu chưa có
if [[ ! -f "$WPTT_KEY_FILE" ]]; then
	openssl rand -base64 48 > "$WPTT_KEY_FILE"
	chmod 600 "$WPTT_KEY_FILE"
fi
# thời gian nữa xoá tuơng thích nguợc


    local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
    local plaintext="$1"
    
    # Bơm cờ -A để ép OpenSSL xuất Base64 trên 1 dòng duy nhất, không rớt dòng
    echo -n "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
}

# Hàm Giải mã Thông minh
wptt_giai_ma() {

# thời gian nữa xoá tuơng thích nguợc
	WPTT_AES_DIR="/etc/wptt-aes"
	WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

	# 1. Xây boong-ke và khóa cửa (Chỉ Root được vào)
	if [[ ! -d "$WPTT_AES_DIR" ]]; then
		mkdir -p "$WPTT_AES_DIR"
		chmod 700 "$WPTT_AES_DIR"
	fi

	# 2. Sinh chìa khóa ngẫu nhiên nếu chưa có
	if [[ ! -f "$WPTT_KEY_FILE" ]]; then
		openssl rand -base64 48 > "$WPTT_KEY_FILE"
		chmod 600 "$WPTT_KEY_FILE"
	fi
# thời gian nữa xoá tuơng thích nguợc


    local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
    local ciphertext="$1"
    
    # Kiểm tra xem có phải chuỗi đã mã hóa không (Chữ ký U2FsdGVkX1)
    if [[ "$ciphertext" == U2FsdGVkX1* ]]; then
        # Bơm cờ -A để OpenSSL hiểu và đọc được Base64 một dòng
        echo -n "$ciphertext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -d -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
    else
        # Nếu là Pass cũ chưa mã hóa thì nhả ra y nguyên
        echo -n "$ciphertext"
    fi
}

