# ==============================================================================

# Hàm Mã hóa
wptt_ma_hoa() {
  # thời gian nữa xoá tuơng thích nguợc
  WPTT_AES_DIR="/etc/wptt-aes"
  WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

  # 1. Xây boong-ke và khóa cửa (Chỉ Root được vào)
  if [[ ! -d "$WPTT_AES_DIR" ]]; then
    mkdir -p "$WPTT_AES_DIR"
    chmod 700 "$WPTT_AES_DIR"
  fi

  # 2. Sinh chìa khóa ngẫu nhiên nếu chưa có
  if [[ ! -f "$WPTT_KEY_FILE" ]]; then
    openssl rand -base64 48 >"$WPTT_KEY_FILE"
    chmod 600 "$WPTT_KEY_FILE"
  fi
  # thời gian nữa xoá tuơng thích nguợc

  local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
  local plaintext="$1"

  # Bơm cờ -A để ép OpenSSL xuất Base64 trên 1 dòng duy nhất, không rớt dòng
  echo -n "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
}

# Hàm Giải mã Thông minh
wptt_giai_ma() {

  # thời gian nữa xoá tuơng thích nguợc
  WPTT_AES_DIR="/etc/wptt-aes"
  WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

  # 1. Xây boong-ke và khóa cửa (Chỉ Root được vào)
  if [[ ! -d "$WPTT_AES_DIR" ]]; then
    mkdir -p "$WPTT_AES_DIR"
    chmod 700 "$WPTT_AES_DIR"
  fi

  # 2. Sinh chìa khóa ngẫu nhiên nếu chưa có
  if [[ ! -f "$WPTT_KEY_FILE" ]]; then
    openssl rand -base64 48 >"$WPTT_KEY_FILE"
    chmod 600 "$WPTT_KEY_FILE"
  fi
  # thời gian nữa xoá tuơng thích nguợc

  local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
  local ciphertext="$1"

  # Kiểm tra xem có phải chuỗi đã mã hóa không (Chữ ký U2FsdGVkX1)
  if [[ "$ciphertext" == U2FsdGVkX1* ]]; then
    # Bơm cờ -A để OpenSSL hiểu và đọc được Base64 một dòng
    echo -n "$ciphertext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -d -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
  else
    # Nếu là Pass cũ chưa mã hóa thì nhả ra y nguyên
    echo -n "$ciphertext"
  fi
}

WPTT_LOG_FILE="/var/log/wptangtoc-ols.log"
mkdir -p "$(dirname "$WPTT_LOG_FILE")" 2>/dev/null

wptt_logs() {
  local level="$1"
  local message="$2"
  local timestamp=$(date '+%d-%m-%Y %H:%M:%S')

  # Chỉ lấy tên file cho gọn (Ví dụ: wptt-them-domain thay vì /etc/wptt/domain/wptt-them-domain)
  # Việc này giúp file log nằm ở cuối không bị quá dài
  local script_name=$(basename "$0")

  # Dùng printf '%b' thay cho echo -e để xử lý chuỗi an toàn tuyệt đối trước khi tẩy màu
  local clean_msg=$(printf '%b' "$message" | sed -E 's/\x1B\[[0-9;]*[a-zA-Z]//g')

  # Ghi log bằng printf. Đưa file ra phía sau cùng.
  # %s đại diện cho chuỗi, \n là xuống dòng
  printf "[%s] [%s] %s [File: %s]\n" "$timestamp" "$level" "$clean_msg" "$script_name" >>"$WPTT_LOG_FILE"
}

#vị dụ chỉ muốn xóa thì hàm callback: wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "beta_wptangtoc_ols" "delete"
#vị dụ chỉ muốn update giá trị: wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "beta_wptangtoc_ols=1"
#ví dụ để tránh bị biến giá trị gán linh tinh ký tự đặc biệt: wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "version_wptangtoc_ols=$wptangtocols_version" "secure"

wptt_atomic_edit_config() {
  local target_file="$1"
  local input_string="$2"
  local mode="${3:-normal}" # normal, secure, hoặc delete

  # Bẫy lỗi: Đảm bảo file tồn tại và input không rỗng
  [[ ! -f "$target_file" || -z "$input_string" ]] && return 1

  # Tự động bóc tách Key và Value
  local key="${input_string%%=*}"
  local value=""

  # Nếu có dấu '=' thì cắt lấy phần Value phía sau
  if [[ "$input_string" == *"="* ]]; then
    value="${input_string#*=}"
  fi

  local tmp_file
  tmp_file=$(mktemp -p "/etc/wptt/tmp" atomic_edit.XXXXXX) || return 1

  # Dùng đường dẫn tuyệt đối /bin/cp để VÔ HIỆU HÓA HOÀN TOÀN mọi bí danh (Alias)
  /bin/cp -fp "$target_file" "$tmp_file"

  # Xóa dòng cấu hình cũ (nếu có)
  sed -i "/^${key}=/d" "$tmp_file"

  # Xử lý chèn dữ liệu mới nếu không phải là lệnh delete
  if [[ "$mode" != "delete" ]]; then
    if [[ "$mode" == "secure" ]]; then
      # Chế độ bảo mật: Bọc %q cho Value, chặn đứng Command Injection
      printf "%s=%q\n" "$key" "$value" >>"$tmp_file"
    else
      # Chế độ bình thường: Ráp lại nguyên bản
      echo "${key}=${value}" >>"$tmp_file"
    fi
  fi

  # Dùng đường dẫn tuyệt đối /bin/mv để ghi đè automic trong im lặng
  /bin/mv -fT "$tmp_file" "$target_file"
}

# 1. BẮT ĐẦU: Tạo file nháp tập trung
wptt_atomic_begin() {
  local target_file="${1:?Chưa truyền file}"
  local wptt_tmp_dir="/etc/wptt/tmp"

  [[ ! -d "$wptt_tmp_dir" ]] && mkdir -p "$wptt_tmp_dir" 2>/dev/null

  local tmp_file
  tmp_file=$(mktemp -p "$wptt_tmp_dir" ".$(basename "$target_file").tmp.XXXXXX") || return 1

  if [[ -f "$target_file" ]]; then
    /bin/cp -fp "$target_file" "$tmp_file" || {
      /bin/rm -f "$tmp_file" 2>/dev/null
      return 1
    }
  else
    chmod 644 "$tmp_file" 2>/dev/null || true
  fi

  echo "$tmp_file" #echo để print ra hàm gán vào biến ngoài nếu callback nào muốn dùng
}

# 2. XÁC NHẬN: Hoán đổi atomic & tự dọn sạch file tạm
wptt_atomic_commit() {
  local tmp_file="${1:?Chưa truyền file nháp}"
  local target_file="${2:?Chưa truyền file gốc}"

  if [[ -s "$tmp_file" ]]; then
    if /bin/mv -fT "$tmp_file" "$target_file"; then
      return 0
    fi
  fi

  /bin/rm -f "$tmp_file" 2>/dev/null || true
  return 1
}

# ==============================================================================
# HÀM TỰ ĐỘNG QUAY VỀ MENU CHA (DÙNG CHUNG CHO MỌI TÍNH NĂNG)
# Cách dùng:
#   - Thoát ngay khi lỗi:          wptt_quay_ve_menu "$1" 1
#   - Thoát ngay khi hoàn tất:     wptt_quay_ve_menu "$1" 0
#   - Chờ Enter rồi về menu:       wptt_quay_ve_menu "$1" 0 "enter"
#   - Lỗi nhưng chờ đọc thông báo: wptt_quay_ve_menu "$1" 1 "enter"
# ==============================================================================
wptt_quay_ve_menu() {
  local route_arg="${1:-}"
  local exit_code="${2:-0}"
  local wait_enter="${3:-}"

  # Đảm bảo exit_code luôn là số nguyên hợp lệ (0-255)
  [[ "$exit_code" =~ ^[0-9]+$ ]] || exit_code=1

  # Nếu được gọi từ Menu (có cờ 97 hoặc 98 hoặc 99) -> Xác định Menu đích và thực hiện exec
  if [[ "$route_arg" == "98" || "$route_arg" == "99" || "$route_arg" == "97" ]]; then

		if [[ -t 0 ]]; then stty -echo 2>/dev/null; fi


    local target_menu="${WPTT_CURRENT_MENU:-}"

    # 1. Fallback: Nếu chưa có WPTT_CURRENT_MENU, tự động suy luận từ thư mục chứa script
    if [[ -z "$target_menu" || ! -f "$target_menu" ]]; then
      local caller_script="${BASH_SOURCE[1]:-$0}"
      local parent_dir="${caller_script%/*}"
      local folder_name="${parent_dir##*/}"

      case "$folder_name" in
      wordpress) target_menu="/etc/wptt/wptt-wordpress-main" ;;
      domain | vhost) target_menu="/etc/wptt/wptt-domain-main" ;;
      db | database | mariadb) target_menu="/etc/wptt/wptt-db-main" ;;
      cache) target_menu="/etc/wptt/wptt-cache-main" ;;
      ssl) target_menu="/etc/wptt/wptt-ssl-main" ;;
      backup | backup-restore) target_menu="/etc/wptt/wptt-backup-restore-main" ;;
      security | bao-mat) target_menu="/etc/wptt/wptt-bao-mat-main" ;;
      csf) target_menu="/etc/wptt/bao-mat/csf-main" ;;
      fail2ban) target_menu="/etc/wptt/wptt-khoa-ip-main" ;;
      php) target_menu="/etc/wptt/wptt-php-ini-main" ;;
      disk) target_menu="/etc/wptt/wptt-disk-main" ;;
      service | reboot-app) target_menu="/etc/wptt/wptt-service-main" ;;
      add-one) target_menu="/etc/wptt/wptt-add-one-main" ;;
      cau-hinh) target_menu="/etc/wptt/wptt-cau-hinh-websever-main" ;;
      chuyen-web) target_menu="/etc/wptt/wptt-chuyen-web-main" ;;
      gia-lap-website) target_menu="/etc/wptt/wptt-gia-lap-main" ;;
      lang) target_menu="/etc/wptt/lang-main" ;;
      logs) target_menu="/etc/wptt/wptt-logs-main" ;;
      ma-nguon) target_menu="/etc/wptt/wptt-ma-nguon-main" ;;
      phpmyadmin) target_menu="/etc/wptt/wptt-phpmyadmin-main" ;;
      ssh) target_menu="/etc/wptt/wptt-ssh-main" ;;
      swap) target_menu="/etc/wptt/wptt-swap-main" ;;
      tai-nguyen-server) target_menu="/etc/wptt/wptt-tai-nguyen-main" ;;
      bang-thong) target_menu="/etc/wptt/tai-nguyen-server/wptt-bang-thong-main" ;;
      trash) target_menu="/etc/wptt/wptt-thung-rac-main" ;;
      trinh-quan-ly-files) target_menu="/etc/wptt/wptt-quan-ly-files-main" ;;
      update) target_menu="/etc/wptt/wptt-update-main" ;;
      webadmin) target_menu="/etc/wptt/wptt-webadmin-main" ;;
      *)
        if [[ -f "/etc/wptt/wptt-${folder_name}-main" ]]; then
          target_menu="/etc/wptt/wptt-${folder_name}-main"
        else
          target_menu="/usr/bin/wptangtoc"
        fi
        ;;
      esac
    fi

    # 2. Nếu cờ là 99 (quy ước về thẳng Menu chính) và không ép WPTT_CURRENT_MENU
    if [[ "$route_arg" == "99" && -z "${WPTT_CURRENT_MENU:-}" ]]; then
      target_menu="/usr/bin/wptangtoc"
    fi

    # Chốt chặn an toàn: Nếu file đích không tồn tại thì về Menu chính
    [[ -f "$target_menu" ]] || target_menu="/usr/bin/wptangtoc"

    # 3. Ánh xạ đường dẫn file sang tên hiển thị UX tiếng Việt rõ ràng
    local menu_label="Menu Chính WPTangToc OLS"
    case "${target_menu##*/}" in
    wptangtoc) menu_label="Menu Chính WPTangToc OLS" ;;
    wptt-wordpress-main) menu_label="Menu Quản lý WordPress" ;;
    wptt-update-wordpress-main) menu_label="Menu Cập nhật WordPress" ;;
    wptt-domain-main) menu_label="Menu Quản lý Domain" ;;
    wptt-db-main) menu_label="Menu Quản lý Database (MariaDB)" ;;
    wptt-cache-main) menu_label="Menu Quản lý Cache" ;;
    wptt-ssl-main) menu_label="Menu Quản lý SSL" ;;
    cloudflare-api-dns-main) menu_label="Menu Cloudflare API DNS" ;;
    wptt-backup-restore-main) menu_label="Menu Sao lưu & Khôi phục" ;;
    wptt-bao-mat-main) menu_label="Menu Quản lý Bảo mật" ;;
    csf-main) menu_label="Menu Tường lửa CSF Firewall" ;;
    wptt-khoa-ip-main) menu_label="Menu Quản lý Khóa IP" ;;
    wptt-php-ini-main) menu_label="Menu Cấu hình PHP (LSPHP)" ;;
    wptt-disk-main) menu_label="Menu Quản lý Dung lượng Disk" ;;
    wptt-service-main) menu_label="Menu Quản lý Dịch vụ (Services)" ;;
    wptt-add-one-main) menu_label="Menu Công cụ Bổ trợ (Add-on)" ;;
    wptt-cau-hinh-websever-main) menu_label="Menu Cấu hình Webserver" ;;
    wptt-chuyen-web-main) menu_label="Menu Chuyển Website (Migration)" ;;
    wptt-gia-lap-main) menu_label="Menu Giả lập Website (Staging)" ;;
    lang-main) menu_label="Menu Thiết lập Ngôn ngữ" ;;
    wptt-logs-main) menu_label="Menu Quản lý Nhật ký (Logs)" ;;
    wptt-ma-nguon-main) menu_label="Menu Quản lý Mã nguồn" ;;
    wptt-phpmyadmin-main) menu_label="Menu Quản lý phpMyAdmin" ;;
    wptt-ssh-main) menu_label="Menu Quản lý Bảo mật SSH" ;;
    wptt-swap-main) menu_label="Menu Quản lý Bộ nhớ Swap" ;;
    wptt-tai-nguyen-main) menu_label="Menu Giám sát Tài nguyên Server" ;;
    wptt-bang-thong-main) menu_label="Menu Giám sát Băng thông" ;;
    wptt-thung-rac-main) menu_label="Menu Quản lý Thùng rác ảo" ;;
    wptt-quan-ly-files-main) menu_label="Menu Quản lý FileManager" ;;
    wptt-update-main) menu_label="Menu Cập nhật Hệ thống" ;;
    wptt-webadmin-main) menu_label="Menu Quản lý WebAdmin GUI" ;;
    esac

    # 4. Nếu đối số thứ 3 là "enter" -> Hiển thị lời nhắc có màu sắc và tên menu cụ thể
    if [[ "${wait_enter,,}" == "enter" ]]; then
      local c_reset=$'\033[0m'
      local c_bold=$'\033[1m'
      local c_yellow=$'\033[1;33m'
      local c_cyan=$'\033[1;36m'
      local c_green=$'\033[1;32m'
      local c_red=$'\033[1;31m'
      local icon_color="$c_green"

      # Đổi màu biểu tượng mũi tên sang Đỏ nếu tác vụ trước đó trả về mã lỗi != 0
      ((exit_code != 0)) && icon_color="$c_red"

      local prompt_str
      if [[ -n "${nhap_enter_quay_lai_menu:-}" ]]; then
        prompt_str="${icon_color}➜${c_reset} ${c_bold}${nhap_enter_quay_lai_menu}${c_reset} ${c_cyan}[${menu_label}]${c_reset}: "
      else
        prompt_str="${icon_color}➜${c_reset} Nhấn phím ${c_yellow}[Enter]${c_reset} để quay về ${c_cyan}${menu_label}${c_reset}... "
      fi

      printf '\n'

			#cải tiến ux  Khi đó dù người dùng có "đập bàn phím" thì cũng không trên trôi được enter này
			if declare -F wptt_flush_stdin >/dev/null; then
				wptt_flush_stdin
			fi
		  if [[ -t 0 ]]; then stty echo 2>/dev/null; fi
      read -rp "$prompt_str" _ || true
    fi

    # 5. Dọn dẹp trap trước khi exec để giải phóng tiến trình cũ sạch sẽ
    trap - EXIT INT TERM HUP ERR

    exec "$target_menu" 1
  fi

  # Nếu không có cờ 98/99 (chạy qua CLI hoặc Search fzf): thoát tự nhiên với mã lỗi
  if [[ "${BASH_SOURCE[0]}" != "$0" && ${#FUNCNAME[@]} -gt 0 && "${WPTT_ALLOW_RETURN:-}" == "1" ]]; then
    return "$exit_code"
  fi
  exit "$exit_code"
  # return "$exit_code" 2>/dev/null || exit "$exit_code"
}

# ==============================================================================
# HÀM PHỤ DÙNG CHUNG CHO wptt_check_mariadb / wptt_check_lsws: PHÂN TÍCH ĐỐI SỐ
# (gán thẳng vào biến local route_arg, custom_msg, quiet_mode của hàm gọi)
#
# Quy tắc:
#   - 97 | 98 | 99            -> cờ quay về menu (ở bất kỳ vị trí nào)
#   - -q | --quiet | quiet | return -> chế độ im lặng, chỉ trả mã 0/1
#   - Đối số THỨ NHẤT là "ô cờ menu" (kiểu "${1:-}"): chỉ coi là thông báo lỗi
#     khi nó là một câu (có khoảng trắng). Giá trị khác như "", "1", tên miền...
#     sẽ bị bỏ qua, không bị in nhầm thành thông báo lỗi.
#   - Từ đối số thứ 2 trở đi: chuỗi bất kỳ khác rỗng là thông báo lỗi tùy chỉnh.
#   - Không truyền cờ nhưng script gọi có MENU_WPTT_IN=97/98/99 -> tự dùng giá trị đó.
# ==============================================================================
_wptt_check_parse_args() {
  local idx=0 arg
  for arg in "$@"; do
    idx=$((idx + 1))
    case "$arg" in
    97 | 98 | 99)
      route_arg="$arg"
      ;;
    -q | --quiet | quiet | return)
      quiet_mode=1
      ;;
    "")
      ;;
    *)
      if ((idx > 1)) || [[ "$arg" == *[[:space:]]* ]]; then
        custom_msg="$arg"
      fi
      ;;
    esac
  done

  if [[ -z "$route_arg" ]]; then
    case "${MENU_WPTT_IN:-}" in
    97 | 98 | 99) route_arg="$MENU_WPTT_IN" ;;
    esac
  fi
  return 0
}

# ==============================================================================
# HÀM KIỂM TRA & TỰ ĐỘNG CỨU HỘ MARIADB (AUTO-HEALING + AUTO MENU RETURN)
# Cách dùng (giống wptt_quay_ve_menu: đối số đầu là cờ menu "${1:-}"):
#   - Trong tính năng chạy từ menu:  wptt_check_mariadb "${1:-}"
#   - Kèm thông báo tùy chỉnh:       wptt_check_mariadb "${1:-}" "MariaDB đang sập! Không thể khôi phục."
#   - Chạy CLI / không cờ menu:      wptt_check_mariadb
#   - Chỉ lấy mã trả về (0/1):       if wptt_check_mariadb --quiet; then ...
#   - MariaDB sập: có cờ 97/98/99 -> quay về menu cha; không có cờ -> exit 1
# ==============================================================================
wptt_check_mariadb() {
  local route_arg="" custom_msg="" quiet_mode=0
  _wptt_check_parse_args "$@"

  local admin_bin="mariadb-admin"
  command -v mariadb-admin >/dev/null 2>&1 || admin_bin="mysqladmin"

  # 1. FAST-PATH (0ms): Nếu dịch vụ đang chạy và phản hồi ping -> Thoát êm ngay lập tức
  if systemctl is-active --quiet mariadb 2>/dev/null && "$admin_bin" --skip-ssl --connect-timeout=2 ping >/dev/null 2>&1; then
    return 0
  fi

  # 2. AUTO-HEALING: Phát hiện MariaDB ngừng hoạt động -> Tự động mồi lại dịch vụ
  if ((quiet_mode == 0)); then
    declare -F _runing >/dev/null 2>&1 || . /etc/wptt/echo-color 2>/dev/null || true
  fi

  local task_heal="Tự động khởi động lại dịch vụ MariaDB"
  ((quiet_mode == 0)) && declare -F _runing >/dev/null 2>&1 && _runing "$task_heal"

  systemctl start mariadb >/dev/null 2>&1 || systemctl start mysql >/dev/null 2>&1 || true

  local attempt=1
  local max_retries=5
  while ((attempt <= max_retries)); do
    if systemctl is-active --quiet mariadb 2>/dev/null && "$admin_bin" --skip-ssl --connect-timeout=2 ping >/dev/null 2>&1; then
      if ((quiet_mode == 0)); then
        declare -F _rundone >/dev/null 2>&1 && _rundone "$task_heal"
        declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "INFO" "Auto-Healing: Đã tự động khởi động lại MariaDB thành công"
      fi
      return 0
    fi
    sleep 1
    ((attempt++))
  done

  # 3. FAIL-SAFE: Nếu sau 5 giây vẫn sập -> Báo lỗi, hướng dẫn xử lý và quay về Menu
  ((quiet_mode == 1)) && return 1

  declare -F _runloi >/dev/null 2>&1 && _runloi "$task_heal"

  local err_msg="${custom_msg:-MariaDB đang bị sập}"
  declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "ERROR" "$err_msg"

  printf '\n'
  if declare -F print_border_top >/dev/null 2>&1; then
    print_border_top
    center_text "${C_RED:-}CẢNH BÁO: DỊCH VỤ MARIADB ĐANG NGỪNG HOẠT ĐỘNG${C_RESET:-}"
    print_border_mid
    left_text "${C_YELLOW:-}Nguyên nhân:${C_RESET:-} $err_msg" 2
    left_text "${C_CYAN:-}WPTangToc OLS:${C_RESET:-} Hệ thống tạm dừng tác vụ này để bảo vệ dữ liệu.." 2
    print_border_bot
  else
    printf '\033[1;31m[LỖI] %s\033[0m\n' "$err_msg" >&2
  fi

  wptt_quay_ve_menu "$route_arg" 1 "enter"
}

# ==============================================================================
# HÀM KIỂM TRA & TỰ ĐỘNG CỨU HỘ OPENLITESPEED (AUTO-HEALING + AUTO MENU RETURN)
# Cách dùng (giống wptt_quay_ve_menu: đối số đầu là cờ menu "${1:-}"):
#   - Trong tính năng chạy từ menu:  wptt_check_lsws "${1:-}"
#   - Kèm thông báo tùy chỉnh:       wptt_check_lsws "${1:-}" "OpenLiteSpeed đang bị sập!"
#   - Chạy CLI / không cờ menu:      wptt_check_lsws
#   - Chỉ lấy mã trả về (0/1):       if wptt_check_lsws --quiet; then ...
#   - Web server sập: có cờ 97/98/99 -> quay về menu cha; không có cờ -> exit 1
# ==============================================================================
wptt_check_lsws() {
  local route_arg="" custom_msg="" quiet_mode=0
  _wptt_check_parse_args "$@"

  # 1. FAST-PATH: Nếu systemd báo active và lswsctrl báo running -> Thoát êm ngay lập tức
  if systemctl is-active --quiet lsws 2>/dev/null && /usr/local/lsws/bin/lswsctrl status 2>/dev/null | grep -iq "is running"; then
    return 0
  fi

  # 2. AUTO-HEALING: Phát hiện OpenLiteSpeed sập -> Hiển thị trạng thái và thử cứu hộ
  if ((quiet_mode == 0)); then
    declare -F _runing >/dev/null 2>&1 || . /etc/wptt/echo-color 2>/dev/null || true
  fi

  local task_heal="Tự động khởi động lại dịch vụ OpenLiteSpeed"
  ((quiet_mode == 0)) && declare -F _runing >/dev/null 2>&1 && _runing "$task_heal"

  local max_retries=8
  local wait_time=2
  local attempt=1

  while ((attempt <= max_retries)); do
    if ! systemctl is-active --quiet lsws 2>/dev/null; then
      systemctl start lsws >/dev/null 2>&1 || /usr/local/lsws/bin/lswsctrl start >/dev/null 2>&1 || true
    else
      /usr/local/lsws/bin/lswsctrl start >/dev/null 2>&1 || true
    fi

    if /usr/local/lsws/bin/lswsctrl status 2>/dev/null | grep -iq "is running"; then
      if ((quiet_mode == 0)); then
        declare -F _rundone >/dev/null 2>&1 && _rundone "$task_heal"
        declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "INFO" "Auto-Healing: Đã tự động khởi động lại OpenLiteSpeed thành công"
      fi
      return 0
    fi

    sleep "$wait_time"
    ((attempt++))
  done

  # 3. FAIL-SAFE: Lặp hết 8 lần vẫn không lên -> Báo lỗi, hướng dẫn xử lý và quay về Menu
  ((quiet_mode == 1)) && return 1

  declare -F _runloi >/dev/null 2>&1 && _runloi "$task_heal"

  local err_msg="${custom_msg:-OpenLiteSpeed đang bị sập}"
  declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "ERROR" "$err_msg"

  printf '\n'
  if declare -F print_border_top >/dev/null 2>&1; then
    print_border_top
    center_text "${C_RED:-}CẢNH BÁO: WEB SERVER OPENLITESPEED ĐANG NGỪNG HOẠT ĐỘNG${C_RESET:-}"
    print_border_mid
    left_text "${C_YELLOW:-}Nguyên nhân:${C_RESET:-} $err_msg" 2
    left_text "${C_CYAN:-}WPTangToc OLS:${C_RESET:-} Tạm thời tạm ngừng tác vụ này." 2
    print_border_bot
  else
    printf '\033[1;31m[LỖI] %s\033[0m\n' "$err_msg" >&2
  fi

  wptt_quay_ve_menu "$route_arg" 1 "enter"
}

## 1. Dọn dẹp sạch sẽ mọi phím người dùng lỡ bấm trong lúc chờ, tình huống người dùng gõ quá nhanh: màn hình print chưa xong đã gõ rồi
# Dọn dẹp sạch sẽ mọi phím người dùng lỡ bấm tồn đọng trong bộ đệm (Type-ahead buffer)
# Dọn dẹp sạch sẽ bộ đệm bàn phím (Chuẩn bảo mật Zero-Trust)
wptt_flush_stdin() {
  # 1. Chỉ xả khi stdin là Terminal thật (Bảo vệ BATS test & CLI Pipe)
  [[ -t 0 ]] || return 0

  # 2. Tắt tạm thời xtrace (set -x) nếu đang bật để chống lộ mật khẩu khách lỡ paste nhầm
  local _wptt_xtrace_was_on=0
  [[ $- == *x* ]] && {
    _wptt_xtrace_was_on=1
    set +x
  } 2>/dev/null

  local _wptt_trash=""
  local _wptt_iter=0

  # 3. Giới hạn tối đa 10 vòng (100KB) chống Infinite Loop DoS.
  # Lưu ý: Khi bộ đệm có < 10.000 bytes, lệnh read vẫn hút sạch 100% ký tự
  # rồi mới trả mã timeout (142) để thoát ngay chỉ sau đúng 1 vòng (0.01s).
  while ((_wptt_iter++ < 10)) && LC_ALL=C IFS= read -r -s -t 0.01 -d '' -n 10000 _wptt_trash 2>/dev/null; do
    :
  done

  # 4. Xóa sạch dữ liệu nhạy cảm khỏi RAM trước khi thoát hàm
  _wptt_trash=""
  unset -v _wptt_trash _wptt_iter

  ((_wptt_xtrace_was_on == 1)) && set -x
  return 0
}

# Hàm nạp cấu hình Vhost nâng cao bảo mật hơn thay vì dùng source trực tiếp.
# cách dùng: wptt_load_vhost_conf $NAME
# hoặc cách dùng: wptt_load_vhost_conf /etc/wptt/vhost/.$NAME.conf
# Hàm nạp cấu hình Vhost
# Chống RCE (Safe Parser), chống Path Traversal, chống Symlink, tối ưu Zero-Subshell
# Cách dùng: wptt_load_vhost_conf "$NAME" [allow_bk]
wptt_load_vhost_conf() {
  local input="${1:-}"
  local allow_bk="${2:-0}"
  local conf_file=""
  local domain=""

  [[ -z "$input" ]] && return 1

  # 1. Nhận diện thông minh cả đường dẫn file lẫn tên miền
  if [[ "$input" == */* ]]; then
    conf_file="$input"
    domain="${conf_file##*/.}"
    domain="${domain%.conf}"
  else
    domain="$input"
    if [[ -f "/etc/wptt/vhost/.${domain}.conf" ]]; then
      conf_file="/etc/wptt/vhost/.${domain}.conf"
    elif [[ "$allow_bk" == "1" && -f "/etc/wptt/vhost_bk/.${domain}.conf" ]]; then
      conf_file="/etc/wptt/vhost_bk/.${domain}.conf"
    else
      conf_file="/etc/wptt/vhost/.${domain}.conf"
    fi
  fi

  # 2. Validate tên miền và khóa chặt Allowlist thư mục (chỉ cho phép trong /etc/wptt/vhost hoặc vhost_bk)
  if [[ -z "$domain" || ! "$domain" =~ ^[a-zA-Z0-9._-]+$ || "$domain" == -* || "$domain" == *..* ]]; then
    return 1
  fi
  case "$conf_file" in
  "/etc/wptt/vhost/.${domain}.conf" | "/etc/wptt/vhost_bk/.${domain}.conf") ;;
  *) return 1 ;;
  esac

  # 3. Kiểm tra file tồn tại, cấm tuyệt đối Symlink
  if [[ ! -f "$conf_file" || -L "$conf_file" ]]; then
    return 1
  fi

  # 4. Kiểm tra chủ sở hữu phải là root (UID 0) và quyền file an toàn
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    # Khi chạy quyền root: dùng toán tử built-in -O (nhanh tức thì, không tốn subshell)
    if [[ ! -O "$conf_file" ]]; then
      wptt_logs "ERROR" "Bảo mật: File $conf_file không thuộc sở hữu của root!" 2>/dev/null || true
      return 1
    fi
  else
    # Khi chạy quyền user (wptangtoc-user): kiểm tra UID chủ file bằng stat
    local file_uid=""
    file_uid="$(/usr/bin/stat -c '%u' -- "$conf_file" 2>/dev/null || printf '999')"
    if [[ "$file_uid" != "0" ]]; then
      return 1
    fi
  fi

  # 5. Safe Key-Value Parser: Đọc trực tiếp từng biến vào bộ nhớ (Không dùng '.' hay 'eval' -> Miễn nhiễm 100% RCE)
  local line="" key="" val=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Xóa ký tự CR (\r) nếu file từng bị sửa trên Windows và cắt khoảng trắng đầu dòng
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"

    # Bỏ qua dòng trống hoặc comment
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Hỗ trợ cả trường hợp dòng bắt đầu bằng chữ "export "
    if [[ "$line" == export[[:space:]]* ]]; then
      line="${line#export}"
      line="${line#"${line%%[![:space:]]*}"}"
    fi

    # Bỏ qua nếu dòng không có dấu '='
    [[ "$line" != *=* ]] && continue

    key="${line%%=*}"
    val="${line#*=}"

    # Cắt khoảng trắng thừa quanh key và cuối val
    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"

    # Chỉ chấp nhận tên biến hợp lệ của Bash
    [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || continue

    # Gỡ dấu nháy kép "..." hoặc nháy đơn '...' bọc ngoài giá trị (nếu có)
    if [[ "$val" =~ ^\"(.*)\"$ ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$val" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi

    # Gán biến an toàn tuyệt đối vào phạm vi toàn cục của script gọi (không kích hoạt subshell/command substitution)
    printf -v "$key" '%s' "$val"
  done <"$conf_file"

  return 0
}

# Hàm nạp cấu hình tổng (/etc/wptt/.wptt.conf)
# Chống RCE (Safe Parser), chống Symlink, tối ưu Zero-Subshell
# Cách dùng: wptt_load_main_conf
wptt_load_main_conf() {
  local conf_file="/etc/wptt/.wptt.conf"

  # 1. Kiểm tra file tồn tại và cấm tuyệt đối Symlink
  if [[ ! -f "$conf_file" || -L "$conf_file" ]]; then
    return 1
  fi

  # 2. Kiểm tra chủ sở hữu bắt buộc phải là root (UID 0)
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    if [[ ! -O "$conf_file" ]]; then
      wptt_logs "ERROR" "Bảo mật: File $conf_file không thuộc sở hữu của root!" 2>/dev/null || true
      return 1
    fi
  else
    local file_uid=""
    file_uid="$(/usr/bin/stat -c '%u' -- "$conf_file" 2>/dev/null || printf '999')"
    if [[ "$file_uid" != "0" ]]; then
      return 1
    fi
  fi

  # 3. Safe Key-Value Parser: Đọc trực tiếp từng biến vào bộ nhớ (Không dùng '.' hay 'eval')
  local line="" key="" val=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"

    [[ -z "$line" || "$line" == \#* ]] && continue

    if [[ "$line" == export[[:space:]]* ]]; then
      line="${line#export}"
      line="${line#"${line%%[![:space:]]*}"}"
    fi

    [[ "$line" != *=* ]] && continue

    key="${line%%=*}"
    val="${line#*=}"

    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"

    [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || continue

    if [[ "$val" =~ ^\"(.*)\"$ ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$val" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi

    printf -v "$key" '%s' "$val"
  done <"$conf_file"

  # Đảm bảo biến ngôn ngữ luôn có giá trị mặc định nếu file cấu hình trống
  : "${ngon_ngu:=vi}"
  return 0
}
