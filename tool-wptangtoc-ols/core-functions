# ==============================================================================
function wptt_xac_nhan() {

  #nếu là CLI thì trả giá trị báo lỗi về luôn
  if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]]; then
    return 0 # Mặc định tự động bấm Đồng ý
  fi

  local msg_title="${1:-Bạn có chắc chắn muốn thực hiện thao tác này?}"
  local info_1="$2"
  local info_2="$3"
  local opt_1="${4:-Đồng ý}"
  local opt_2="${5:-Không đồng ý}"

  local box_inner_width=${box_inner_width:-78}

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

  # 1. In Tiêu đề
  local clean_title=$(echo -e "$msg_title" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local pad_title=$((box_inner_width - ${#clean_title} - 2))
  [[ $pad_title -lt 0 ]] && pad_title=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${msg_title}${C_RESET}$(printf '%*s' "$pad_title" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  # 2. In Dòng thông tin 1 (Nếu có truyền vào)
  if [[ -n "$info_1" ]]; then
    local clean_info1=$(echo -e "$info_1" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
    local pad_1=$((box_inner_width - ${#clean_info1} - 2))
    [[ $pad_1 -lt 0 ]] && pad_1=0
    echo -e "${C_CYAN}│${C_RESET}  ${info_1}$(printf '%*s' "$pad_1" "")${C_CYAN}│${C_RESET}"
  fi

  # 3. In Dòng thông tin 2 (Nếu có truyền vào)
  if [[ -n "$info_2" ]]; then
    local clean_info2=$(echo -e "$info_2" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
    local pad_2=$((box_inner_width - ${#clean_info2} - 2))
    [[ $pad_2 -lt 0 ]] && pad_2=0
    echo -e "${C_CYAN}│${C_RESET}  ${info_2}$(printf '%*s' "$pad_2" "")${C_CYAN}│${C_RESET}"
  fi

  # Vẽ vách ngăn nếu có chứa thông tin 1 hoặc 2
  if [[ -n "$info_1" || -n "$info_2" ]]; then
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  fi

  # 4. In các nút lựa chọn
  local clean_opt1="1) $opt_1"
  local pad_opt1=$((box_inner_width - ${#clean_opt1} - 2))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_CYAN}1)${C_RESET} ${opt_1}$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

  local clean_opt2="2) $opt_2"
  local pad_opt2=$((box_inner_width - ${#clean_opt2} - 2))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_CYAN}2)${C_RESET} ${opt_2}$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  #dùng while tốt hơn, còn dùng case dễ bị bẫy lỗi biến rỗng
  #nhập sai thì thông báo đỏ chót bắt nhập lại, không bao giờ lo script bị văng lỗi undefined (không xác định).
  while true; do
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"

    # Tắt echo và dọn rác bàn phím (nếu người dùng lỡ bấm phím trong khi chờ)
    if [[ -t 0 ]]; then stty -echo 2>/dev/null; fi
    if declare -F wptt_flush_stdin >/dev/null; then
      wptt_flush_stdin
    fi
    if [[ -t 0 ]]; then stty echo 2>/dev/null; fi

    # read -r confirm

    if ! read -r confirm; then return 1; fi #tính toán tình huống đang xác thực mà bị rớt mạng ssh chả hạn thì từ chối hộ luôn

    case "$confirm" in
    1)
      return 0 # Mã 0 = True (Bấm Đồng ý)
      ;;
    2 | 0)     # Nhập 2 hoặc 0 đều nhảy vào nhánh này
      return 1 # Mã 1 = False (Bấm Không đồng ý / Bấm Thoát)
      ;;
    *)
      echo -e "${C_RED}❌ Bạn nhập sai, vui lòng nhập 1, 2 hoặc 0 để thoát.${C_RESET}"
      ;;
    esac
  done
}

# ============================================================
# WPTangToc OLS - Smart Graceful Reload
# ============================================================
wptt_smart_reload_lsws() {
  local mode="${1:-async}"
  local run_dir="/etc/wptt/tmp/run"

  local lock_file="${run_dir}/lsws-reload.lock"
  local pending_file="${run_dir}/lsws-reload.pending"
  local processing_file="${run_dir}/lsws-reload.processing"
  local worker_pid_file="${run_dir}/lsws-reload.worker.pid"
  local cb_file="${run_dir}/lsws-reload.cb"
  local backoff_file="${run_dir}/lsws-reload.backoff"

  local lswsctrl="/usr/local/lsws/bin/lswsctrl"
  local pid_file="/tmp/lshttpd/lshttpd.pid"
  local cgid_file="/usr/local/lsws/cgid"

  local service="lsws.service"
  local log_file="/var/log/wptangtoc-ols.log"

  local min_reload_interval=15
  local backoff_cap=60
  local reload_timeout=25
  local health_interval=1
  local cb_max=5
  local cb_window=300

  local health_host="${WPTT_LSWS_HEALTH_HOST:-localhost}"
  local health_url="${WPTT_LSWS_HEALTH_URL:-http://127.0.0.1/}"

  # Khởi tạo thư mục runtime an toàn (chống Symlink, khóa quyền 700)
  if [[ -L "$run_dir" ]]; then
    /bin/rm -f -- "$run_dir" 2>/dev/null || return 1
  fi
  if [[ ! -d "$run_dir" ]]; then
    (umask 077 && /bin/mkdir -p -- "$run_dir") 2>/dev/null || return 1
  fi

  # Hỗ trợ chế độ đồng bộ (--sync) khi cần xác nhận kết quả ngay lập tức
  if [[ "$mode" == "--sync" || "${WPTT_RELOAD_SYNC:-0}" == "1" ]]; then
    [[ -x "$lswsctrl" ]] || return 1
    "$lswsctrl" reload >/dev/null 2>&1 || return 1
    return 0
  fi

  # ========================================================
  # 1. XẾP HÀNG SỰ KIỆN
  # ========================================================
  : > "$pending_file" 2>/dev/null || return 1

  # ========================================================
  # 2. TƯỜNG LỬA CHỐNG BÃO TIẾN TRÌNH (Zero-Subshell Read)
  # ========================================================
  if [[ -r "$worker_pid_file" && ! -L "$worker_pid_file" ]]; then
    local existing_pid=""
    existing_pid="$(<"$worker_pid_file")" 2>/dev/null || existing_pid=""
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && ((existing_pid > 1)) && kill -0 "$existing_pid" 2>/dev/null; then
      return 0
    fi
  fi

  # ========================================================
  # 3. FORK LUỒNG NGẦM DUY NHẤT (WORKER)
  # Đóng/tách hoàn toàn stdin, stdout, stderr để không bao giờ làm treo caller/BATS
  # ========================================================
  (
    flock -n 9 || exit 0
    printf '%s\n' "${BASHPID:-$$}" > "$worker_pid_file"

    _worker_cleanup() {
      /bin/rm -f -- "$worker_pid_file" "$processing_file" 2>/dev/null || true
    }

    # --- HELPER FUNCTIONS (Tối ưu Built-in, Zero-Subshell) ---
    _now_epoch() {
      local ts=""
      printf -v ts '%(%s)T' -1 2>/dev/null || ts="$(date +%s)"
      printf '%s' "$ts"
    }

    _log() {
      local ts=""
      printf -v ts '%(%d-%m-%Y %H:%M:%S)T' -1 2>/dev/null || ts="$(date '+%d-%m-%Y %H:%M:%S')"
      printf '[%s] [LSWS-RELOAD] [%s] %s\n' "$ts" "$1" "${*:2}" >> "$log_file" 2>/dev/null || true
    }

    _get_pid() {
      local pid=""
      if [[ -r "$pid_file" ]]; then
        pid="$(<"$pid_file")" 2>/dev/null || pid=""
        pid="${pid%%[![:digit:]]*}"
      fi
      if [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)); then
        printf '%s' "$pid"
        return 0
      fi
      return 1
    }

    # Lấy cả mtime nguyên và phần thập phân (nano-giây) để chống lỗi reload trong cùng 1 giây
    _get_cgid_stamp() {
      /usr/bin/stat -c '%y' -- "$cgid_file" 2>/dev/null || printf '0'
    }

    _alive() {
      [[ "${1:-}" =~ ^[0-9]+$ ]] && (($1 > 1)) && kill -0 "$1" 2>/dev/null
    }

    _http_health() {
      if ! command -v curl >/dev/null 2>&1; then
        return 0
      fi
      local code=""
      code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 4 -H "Host: $health_host" "$health_url" 2>/dev/null || printf '000')"
      # Chấp nhận cả 1xx-4xx; nếu bật ip-scan-block (drop connection -> 000) nhưng cổng 80/443 vẫn mở TCP thì vẫn tính là sống
      if [[ "$code" =~ ^[1-4][0-9][0-9]$ ]]; then
        return 0
      fi
      # Dự phòng khi vhost mặc định chặn IP (drop 444/000): kiểm tra kết nối TCP tới cổng 80 hoặc 443
      if (exec 3<>/dev/tcp/127.0.0.1/80) 2>/dev/null || (exec 3<>/dev/tcp/127.0.0.1/443) 2>/dev/null; then
        exec 3>&- 2>/dev/null || true
        return 0
      fi
      return 1
    }

    _health() {
      local pid="${1:-0}"
      _alive "$pid" || return 1
      _http_health || return 1
      return 0
    }

    _cb_allowed() {
      [[ -f "$cb_file" ]] || return 0
      local now="" line="" count=0 tmp=""
      now="$(_now_epoch)"
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[0-9]+$ ]] || continue
        if ((now - line < cb_window)); then
          count=$((count + 1))
          tmp+="${line}"$'\n'
        fi
      done < "$cb_file"
      printf '%s' "$tmp" > "$cb_file" 2>/dev/null || true
      ((count < cb_max))
    }

    _cb_record() {
      _now_epoch >> "$cb_file" 2>/dev/null || true
      printf '\n' >> "$cb_file" 2>/dev/null || true
    }

    _get_backoff() {
      local fails=0
      if [[ -r "$backoff_file" ]]; then
        fails="$(<"$backoff_file")" 2>/dev/null || fails=0
      fi
      [[ "$fails" =~ ^[0-9]+$ ]] || fails=0
      ((fails > 10)) && fails=10
      local wait=$((8 * (1 << fails)))
      ((wait > backoff_cap)) && wait=$backoff_cap
      printf '%s' "$wait"
    }

    _bump_backoff() {
      local fails=0
      if [[ -r "$backoff_file" ]]; then
        fails="$(<"$backoff_file")" 2>/dev/null || fails=0
      fi
      [[ "$fails" =~ ^[0-9]+$ ]] || fails=0
      printf '%s\n' "$((fails + 1))" > "$backoff_file" 2>/dev/null || true
    }

    _reset_backoff() {
      printf '0\n' > "$backoff_file" 2>/dev/null || true
    }

    if [[ ! -x "$lswsctrl" ]]; then
      _log "ERROR" "Không tìm thấy lswsctrl: $lswsctrl"
      _worker_cleanup
      exit 1
    fi

    local last_reload_time=0

    # ====================================================
    # 4. VÒNG LẶP XỬ LÝ HÀNG ĐỢI (Coalescing Queue)
    # ====================================================
    while [[ -f "$pending_file" ]]; do
      local effective_interval=$min_reload_interval
      local extra_backoff=0
      if [[ -r "$backoff_file" ]] && [[ "$(<"$backoff_file")" != "0" ]]; then
        extra_backoff="$(_get_backoff)"
        ((extra_backoff > effective_interval)) && effective_interval=$extra_backoff
      fi

      if ((last_reload_time > 0)); then
        local now="" diff=0
        now="$(_now_epoch)"
        diff=$((now - last_reload_time))
        if ((diff < effective_interval)); then
          local wait=$((effective_interval - diff))
          _log "INFO" "Gộp lệnh reload, chờ ${wait}s (backoff=${extra_backoff}s)."
          sleep "$wait"
        fi
      fi

      # Gom toàn bộ các lệnh pending phát sinh trong lúc chờ vào đúng 1 lần chạy này
      /bin/mv -f -- "$pending_file" "$processing_file" 2>/dev/null || break

      local old_pid="" old_cgid_stamp=""
      old_pid="$(_get_pid 2>/dev/null || printf '0')"
      old_cgid_stamp="$(_get_cgid_stamp)"

      if [[ "$old_pid" == "0" ]] || ! _alive "$old_pid"; then
        _log "WARN" "OLS không chạy. Kích hoạt systemd start."
        if ! _cb_allowed; then
          _log "CRITICAL" "Circuit breaker OPEN. Ngừng Auto-Heal."
          /bin/rm -f -- "$processing_file"
          continue
        fi

        _cb_record
        # Đóng FD 9 (9>&-) để tiến trình daemon OLS không kế thừa khóa flock của worker
        systemctl start "$service" >/dev/null 2>&1 9>&- || true
        sleep 2

        local new_pid=""
        new_pid="$(_get_pid 2>/dev/null || printf '0')"
        if [[ "$new_pid" != "0" ]] && _health "$new_pid"; then
          _log "INFO" "OLS khởi động lại thành công qua systemd (PID=$new_pid)."
          _reset_backoff
        else
          _log "CRITICAL" "Systemd start nhưng health check thất bại."
          _bump_backoff
        fi
        last_reload_time="$(_now_epoch)"
        /bin/rm -f -- "$processing_file"
        continue
      fi

      # --- GRACEFUL RELOAD CHÍNH THỨC ---
      _log "INFO" "Graceful reload. PID=$old_pid"
      local reload_start="" reload_rc=0
      reload_start="$(_now_epoch)"

      # Đóng FD 9 (9>&-) khi gọi lswsctrl để lshttpd không giữ lock file
      "$lswsctrl" reload >/dev/null 2>&1 9>&- || reload_rc=$?

      if ((reload_rc != 0)); then
        _log "ERROR" "Lệnh lswsctrl reload thất bại, exit code=$reload_rc."
        _bump_backoff
        /bin/rm -f -- "$processing_file"
        continue
      fi

      # --- KIỂM TRA CHUYỂN GIAO TIẾN TRÌNH BẰNG CGID NANO-TIMESTAMP & PID ---
      local success=0 consecutive_ok=0
      while true; do
        local now="" elapsed=0 current_pid="" current_cgid_stamp=""
        now="$(_now_epoch)"
        elapsed=$((now - reload_start))
        current_pid="$(_get_pid 2>/dev/null || printf '0')"
        current_cgid_stamp="$(_get_cgid_stamp)"

        # Xác nhận đã nạp nếu timestamp cgid thay đổi (độ chính xác nano-giây) hoặc PID thay đổi
        if [[ "$current_cgid_stamp" != "$old_cgid_stamp" || ( "$current_pid" != "0" && "$current_pid" != "$old_pid" ) ]]; then
          if [[ "$current_pid" != "0" ]] && _health "$current_pid"; then
            consecutive_ok=$((consecutive_ok + 1))
            if ((consecutive_ok >= 2)); then
              _log "INFO" "Graceful reload hoàn tất (CGID đã nạp). PID=$current_pid."
              success=1
              break
            fi
          else
            consecutive_ok=0
          fi
        fi

        ((elapsed >= reload_timeout)) && break
        sleep "$health_interval"
      done

      last_reload_time="$(_now_epoch)"

      if ((success == 1)); then
        _reset_backoff
        /bin/rm -f -- "$processing_file"
        continue
      fi

      # --- XỬ LÝ TIMEOUT (TRÁNH PHẠT OAN FALSE NEGATIVE) ---
      local final_pid=""
      final_pid="$(_get_pid 2>/dev/null || printf '0')"

      if [[ "$final_pid" != "0" ]] && _health "$final_pid"; then
        _log "WARN" "Timeout ${reload_timeout}s: CGID không đổi, có thể do Bad Config. Tuy nhiên server vẫn Health OK (PID=$final_pid). Bỏ qua lỗi này."
        _reset_backoff
      else
        _bump_backoff
        _log "CRITICAL" "OLS không phản hồi sau reload. Kích hoạt Controlled Recovery."

        if _cb_allowed; then
          _cb_record
          systemctl start "$service" >/dev/null 2>&1 9>&- || true
          sleep 2
          final_pid="$(_get_pid 2>/dev/null || printf '0')"
          if [[ "$final_pid" != "0" ]] && _health "$final_pid"; then
            _log "INFO" "Auto-Heal thành công. PID=$final_pid."
          else
            _log "CRITICAL" "Auto-Heal thất bại."
          fi
        else
          _log "CRITICAL" "Circuit breaker OPEN. Dừng Auto-Heal."
        fi
      fi

      /bin/rm -f -- "$processing_file"
    done

    _worker_cleanup
  ) </dev/null >/dev/null 2>&1 9>"$lock_file" &

  return 0
}

