#!/bin/bash

export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Nạp thư viện lõi; thoát im lặng với mã lỗi nếu thiếu
[[ -r /etc/wptt/core-functions ]] || exit 1
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
NAME=${1:-}
# 1. Validate tên website theo whitelist (chống path traversal & injection)
if [[ -z "$NAME" || ! "$NAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ || "$NAME" == *..* ]]; then
	wptt_logs "ERROR" "Cron speed-api nhận tên website không hợp lệ: ${NAME:-empty}"
	exit 1
fi

if [[ -f /usr/local/lsws/$NAME/html/wp-content/wptangtoc-speed-api.json || -f /usr/local/lsws/$NAME/html/wp-content/cache/wptangtoc/wptangtoc-speed-api.json ]]; then
  wptt_logs "INFO" "wptangtoc-speed-api xoá cache rồi preload cache website $NAME"
  rm -f /usr/local/lsws/"${NAME:?}"/html/wp-content/wptangtoc-speed-api.json
	rm -f /usr/local/lsws/"${NAME:?}"/html/wp-content/cache/wptangtoc/wptangtoc-speed-api.json
  ionice -c 3 nice -n 19 /bin/bash /etc/wptt/wptt-preload-cache2 "$NAME"
fi
