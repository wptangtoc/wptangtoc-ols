#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com

function huong_dan() {
  Cải thiện hiệu suất máy chủ OpenLiteSpeed nâng cao chịu tải máy chủ OpenLiteSpeed.
  OpenLiteSpeed không hỗ trợ htaccess cache nhưng với Litespeed Enterprise thì có hỗ trợ.
  Tính năng này sẽ giúp OpenLiteSpeed hỗ trợ .htaccess cache, cải thiện tốc độ và chịu tải hơn.
}

#/etc/wptt/add-one/thiet-lap-auto-htaccess-optimize on 
# /etc/wptt/add-one/thiet-lap-auto-htaccess-optimize off

# Ép UX chuẩn 78 ký tự cho các khung giao diện
export box_inner_width=78

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

# ==============================================================================
# NHẬN DIỆN THAM SỐ ĐẦU VÀO (CLI PARAMETERS)
# ==============================================================================
ACTION=""
check_menu_wptangtoc_active=""

for arg in "$@"; do
  if [[ "$arg" == "on" || "$arg" == "off" ]]; then
    ACTION="$arg"
  elif [[ "$arg" == "98" ]]; then
    check_menu_wptangtoc_active="98"
  fi
done

if [[ -z "$ACTION" ]]; then
  clear
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}TỐI ƯU HỆ THỐNG ➜ OpenLiteSpeed Htaccess Cache${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

# Dùng File Cờ (Flag File) để nhận diện trạng thái bật/tắt
FLAG_FILE="/etc/wptt/cau-hinh/htaccess-cache-active"

# ==============================================================================
# HÀM THỰC THI (BẬT/TẮT)
# ==============================================================================
kich_hoat_tinh_nang() {
  [[ -z "$ACTION" ]] && echo ""
  _runing "Thiết lập Litespeed webserver htaccess cache"
  
  # 1. Tạo cờ kích hoạt hệ thống Realtime Convert
  mkdir -p /etc/wptt/cau-hinh
  touch "$FLAG_FILE"
  
  # 2. Dọn sạch rác Cronjob cũ
  rm -f /etc/cron.d/optimize-htaccess-wptangtoc-ols-premium* 2>/dev/null
  cat <(crontab -l 2>/dev/null | grep -v 'wptt_smart_reload_lsws') | crontab - 2>/dev/null
  
  # 3. Chạy Convert hàng loạt ngay lập tức
  . /etc/wptt/add-one/optimize-htaccess-run-now.sh >/dev/null 2>&1
  
  # 4. [AUTO-HEALING] Kiểm tra và cài đặt Systemd Service nếu chưa tồn tại
  if [[ ! -f "/etc/systemd/system/wptt-htaccess.service" ]]; then
      if [[ -f "/etc/wptt/cau-hinh/htaccess-apply" ]]; then
          /bin/bash "/etc/wptt/cau-hinh/htaccess-apply" >/dev/null 2>&1
      fi
  fi
  
  # 5. Restart Watcher để nạp trạng thái mới
  systemctl restart wptt-htaccess >/dev/null 2>&1
  
  _rundone "Thiết lập Litespeed webserver htaccess cache hoàn tất"
  
  # BẢNG BÁO CÁO THÀNH CÔNG (Chỉ hiện khi tương tác tay)
  if [[ -z "$ACTION" ]]; then
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}KÍCH HOẠT TÍNH NĂNG THÀNH CÔNG${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Trạng thái : ${C_GREEN}Đã BẬT Htaccess Cache${C_RESET}"
    left_text "Cơ chế     : Realtime Event-Driven (Tự động đồng bộ cấu hình lên Vhost)"
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  fi
}

huy_bo_tinh_nang() {
  [[ -z "$ACTION" ]] && echo ""
  _runing "Huỷ Thiết lập litespeed webserver htaccess cache"
  
  # 1. Xóa cờ kích hoạt hệ thống Realtime Convert
  rm -f "$FLAG_FILE"
  
  # 2. Chạy Revert hàng loạt về mặc định
  . /etc/wptt/add-one/vhost-chuyen-htaccess-ve-mac-dinh.sh >/dev/null 2>&1
  
  _rundone "Huỷ Thiết lập litespeed webserver htaccess cache hoàn tất"
  
  # BẢNG BÁO CÁO THÀNH CÔNG (Chỉ hiện khi tương tác tay)
  if [[ -z "$ACTION" ]]; then
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HỦY TÍNH NĂNG THÀNH CÔNG${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Trạng thái : ${C_RED}Đã TẮT Htaccess Cache${C_RESET}"
    left_text "Cơ chế     : Khôi phục về chuẩn đọc .htaccess mặc định của OLS"
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  fi
}

# ==============================================================================
# LUỒNG XỬ LÝ CHÍNH
# ==============================================================================
if [[ "$ACTION" == "on" ]]; then
  if [[ ! -f "$FLAG_FILE" ]]; then
    kich_hoat_tinh_nang
  else
    echo -e "${C_YELLOW}Tính năng Htaccess Cache đã được BẬT từ trước.${C_RESET}"
  fi

elif [[ "$ACTION" == "off" ]]; then
  if [[ -f "$FLAG_FILE" ]]; then
    huy_bo_tinh_nang
  else
    echo -e "${C_YELLOW}Tính năng Htaccess Cache đã được TẮT từ trước.${C_RESET}"
  fi

else
  # CHẾ ĐỘ TƯƠNG TÁC (INTERACTIVE MODE)
  if [[ ! -f "$FLAG_FILE" ]]; then
    if wptt_xac_nhan "Bạn có muốn BẬT tối ưu hóa Htaccess Cache cho OpenLiteSpeed?" "Giúp cải thiện tốc độ và sức chịu tải hơn" "" "Đồng ý Bật" "Hủy bỏ"; then
      kich_hoat_tinh_nang
    else
      echo -e "\n${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    fi
  else
    if wptt_xac_nhan "Bạn có chắc chắn muốn HỦY tối ưu hóa Htaccess Cache không?" "Trạng thái hiện tại: Đang Bật" "" "Đồng ý Hủy" "Giữ nguyên"; then
      huy_bo_tinh_nang
    else
      echo -e "\n${C_YELLOW}Đã giữ nguyên trạng thái Htaccess Cache.${C_RESET}"
    fi
  fi
fi

[[ -z "$ACTION" ]] && sleep 2

if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wptt-add-one-main 1
fi
