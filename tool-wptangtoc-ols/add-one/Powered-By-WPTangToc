#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/.wptt.conf
. /etc/wptt/echo-color

stty iutf8 2>/dev/null || true
# 1. Dọn sạch rác bàn phím trước khi hiện câu hỏi
if declare -F wptt_flush_stdin >/dev/null 2>&1; then
  wptt_flush_stdin
fi
# 2. Bật lại hiển thị phím (đề phòng trước đó đang bị tắt)
if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi

read -rp "Nhập Tuỳ biến x-powered-by HTTP [0=Thoát]: " hostname_by_wptt
if [[ $hostname_by_wptt = '0' || $hostname_by_wptt = '' ]]; then
  wptt_quay_ve_menu "${1:-}" 1
fi
if ! [[ "$hostname_by_wptt" =~ ^[a-zA-Z0-9-]+$ ]]; then
  echo -e "\e[31m lỗi: x-powered-by HTTP '$hostname_by_wptt' chứa ký tự không hợp lệ.\e[0m"
  echo "     Chỉ sử dụng chữ cái (a-z, A-Z), số (0-9) và dấu gạch ngang (-)."
  wptt_quay_ve_menu "${1:-}" 1
fi

# 4. Kiểm tra hostname có bắt đầu hoặc kết thúc bằng dấu gạch ngang không
#    (Mặc dù regex trên đã loại trừ nhiều trường hợp, kiểm tra này rõ ràng hơn)
if [[ "$hostname_by_wptt" == -* || "$hostname_by_wptt" == *- ]]; then
  echo -e "\e[31m lỗi: x-powered-by HTTP không được bắt đầu hoặc kết thúc bằng dấu gạch ngang (-).\e[0m"
  wptt_quay_ve_menu "${1:-}" 1
fi
_runing "Tuỳ biến x-powered-by HTTP thành ${hostname_by_wptt}"
if /bin/bash /etc/wptt/Powered-By-WPTangToc 0 "${hostname_by_wptt}" >/dev/null 2>&1; then
  _rundone "Tuỳ biến x-powered-by HTTP thành ${hostname_by_wptt}"
else
  _runloi "Tuỳ biến x-powered-by HTTP thành ${hostname_by_wptt}"
  wptt_quay_ve_menu "${1:-}" 1
fi

wptt_quay_ve_menu "${1:-}" 0
