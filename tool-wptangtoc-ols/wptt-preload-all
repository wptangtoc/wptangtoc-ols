#!/bin/bash

echo "Preload Cache ALL thời gian: $(date '+%d-%m-%Y %H:%M')" >> /var/log/wptangtoc-ols.log

if [ "$(ls -A /etc/wptt/vhost| grep -v '^\.\.conf$' | sort -uV)" ]; then
  echo ""
  echo ""
  echo "Dang preload website..."

	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}" #cắt hết / ở phía truớc chỉ dữ giá trị / ở sau còn dữ lại như: .wptangtoc.com.conf
		domain="${domain%.conf}" #cắt .conf ở phía sau => còn: .wptangtoc.com
		domain="${domain#.}" #cắt . ở phía truớc => còn wptangtoc.com

		if [[ "$domain" != ?*.?* ]]; then #yêu cầu phải có dấu . trong domain thì mới gọi là domain đúng, nếu không có . thì continue nhảy qua for 
			continue
		fi
    path="/usr/local/lsws/$domain/html"
    i=1

    if [[ -d "$path" ]]; then
      bash /etc/wptt/wptt-preload-cache2 "$domain"
    fi
  done

fi

clear
echo "==================================================================="
echo "Hoan tat preload cache tat ca website cua ban"
echo "==================================================================="
echo "Preload cache cac website: "

	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}" #cắt hết / ở phía truớc chỉ dữ giá trị / ở sau còn dữ lại như: .wptangtoc.com.conf
		domain="${domain%.conf}" #cắt .conf ở phía sau => còn: .wptangtoc.com
		domain="${domain#.}" #cắt . ở phía truớc => còn wptangtoc.com

		if [[ "$domain" != ?*.?* ]]; then #yêu cầu phải có dấu . trong domain thì mới gọi là domain đúng, nếu không có . thì continue nhảy qua for 
			continue
		fi
  path="/usr/local/lsws/$domain/html"
  i=1

  if [[ -d "$path" ]]; then
    echo "Hoan tat preload cache website: $domain"
  fi
done

echo "==================================================================="
