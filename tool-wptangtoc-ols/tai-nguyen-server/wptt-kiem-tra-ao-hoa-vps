#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Kiểm tra công nghệ ảo hóa VPS là quá trình xác định xem Máy chủ ảo riêng [VPS] của bạn đang được tạo ra và quản lý bằng công nghệ ảo hóa cụ thể nào [ví dụ: KVM, OpenVZ, Xen, VMware, Hyper-V].

  Mục Đích Chính:
  * Hiểu rõ khả năng của VPS:
  - Ảo hóa đầy đủ [KVM, Xen, VMware]: Tùy chỉnh kernel, độ cô lập cao.
  - Ảo hóa cấp độ OS [OpenVZ, LXC]: Chia sẻ kernel, nhẹ hơn nhưng ít cô lập.
  * Khắc phục sự cố: Chẩn đoán các vấn đề về tương thích hoặc hiệu suất.
  * Lựa chọn cấu hình: Hiểu về ảo hóa giúp tối ưu hóa hệ thống tốt hơn.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC CHUẨN
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_YELLOW}Đang phân tích nền tảng máy chủ hệ thống (Vui lòng chờ)...${C_RESET}"
sleep 0.5
clear

# ==============================================================================
# 1. THU THẬP THÔNG TIN ẢO HÓA (Fallback 3 Tầng Siêu An Toàn)
# ==============================================================================
virt=""

# TẦNG 1: Dùng virt-what (Nếu hệ thống có cài)
if command -v virt-what &>/dev/null; then
  virt_raw=$(virt-what 2>/dev/null)
  [[ -n "$virt_raw" ]] && virt=$(echo "$virt_raw" | tr '\n' ' ' | xargs)
fi

# TẦNG 2: Dùng systemd-detect-virt (Có sẵn mặc định trên Ubuntu/CentOS/AlmaLinux)
if [[ -z "$virt" ]] && command -v systemd-detect-virt &>/dev/null; then
  virt_raw=$(systemd-detect-virt 2>/dev/null)
  [[ -n "$virt_raw" && "$virt_raw" != "none" ]] && virt="$virt_raw"
fi

# TẦNG 3: Đọc trực tiếp phần cứng từ Kernel Sysfs (Tuyệt đối không cần lệnh/gói phụ trợ)
if [[ -z "$virt" && -f /sys/class/dmi/id/product_name ]]; then
  sys_prod=$(cat /sys/class/dmi/id/product_name 2>/dev/null | tr '[:upper:]' '[:lower:]')
  case "$sys_prod" in
    *kvm*|*qemu*|*proxmox*) virt="KVM" ;;
    *vmware*) virt="VMware" ;;
    *virtualbox*) virt="VirtualBox" ;;
    *xen*) virt="Xen" ;;
    *droplet*) virt="KVM (DigitalOcean)" ;;
    *openstack*) virt="OpenStack" ;;
    *alibaba*|*amazon*|*google*) virt="Cloud VPS" ;;
  esac
fi

# ==============================================================================
# 2. PHÂN TÍCH & ĐÁNH GIÁ KẾT QUẢ
# ==============================================================================
# Lưới an toàn nếu trượt cả 3 tầng hoặc dính ảo hóa "Bochs" -> Máy chủ vật lý
if [[ -n "$virt" && "$virt" != *"Bochs"* ]]; then
  # Format lại viết hoa chuẩn tên công nghệ
  virt=$(echo "$virt" | sed 's/kvm/KVM/i; s/vmware/VMware/i; s/xen/Xen/i')
  
  virt_status="${C_YELLOW}${virt^^}${C_RESET} (Máy chủ Ảo - VPS)"

  # Đánh giá chất lượng ảo hóa để tư vấn cho người dùng
  if [[ "${virt,,}" =~ "kvm" || "${virt,,}" =~ "vmware" || "${virt,,}" =~ "xen" || "${virt,,}" =~ "qemu" ]]; then
    virt_desc="${C_GREEN}Ảo hóa toàn phần (Full Virtualization). Hiệu năng tốt, cô lập tuyệt đối.${C_RESET}"
  elif [[ "${virt,,}" =~ "openvz" || "${virt,,}" =~ "lxc" ]]; then
    virt_desc="${C_RED}Ảo hóa Container (Shared Kernel). Dễ bị Oversell, không thể can thiệp sâu.${C_RESET}"
  else
    virt_desc="${C_CYAN}Công nghệ ảo hóa tiêu chuẩn.${C_RESET}"
  fi
else
  virt_status="${C_GREEN}DEDICATED SERVER${C_RESET} (Máy chủ vật lý Bare-Metal)"
  virt_desc="${C_GREEN}Phần cứng độc lập, 100% sức mạnh thực tế, không bị chia sẻ tài nguyên.${C_RESET}"
fi

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}KIỂM TRA CÔNG NGHỆ ẢO HÓA - WPTANGTOC OLS${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_GREEN}KẾT QUẢ PHÂN TÍCH${C_RESET}" 1
left_text "Nền tảng hiện tại: $virt_status" 2
left_text "Đánh giá         : $virt_desc" 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""
echo -en "${C_CYAN}Bấm phím [Enter] để quay lại menu...${C_RESET}"
read -r empty_input

if [[ ${1:-} == "98" ]]; then
  exec /etc/wptt/wptt-tai-nguyen-main 1
fi
