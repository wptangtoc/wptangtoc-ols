function huong_dan() {
  cat <<'EOF'
  Tính năng truy cập vào ứng dụng: wptt-top

  wptt-top trong Linux là một công cụ dòng lệnh cung cấp một cái nhìn động, cập nhật theo thời gian thực về các tiến trình [processes] đang chạy và tình hình sử dụng tài nguyên hệ thống chuyên sâu cho webserver lsws của bạn.

  Nói một cách đơn giản, wptt-top giống như bảng điều khiển trung tâm hiển thị trực tiếp những gì đang diễn ra bên trong máy chủ webserver của bạn, đặc biệt là những tiến trình website nào đang ngốn CPU và RAM nhiều nhất.

  Mục Đích Chính
  * Theo dõi hệ thống thời gian thực: Xem ngay lập tức các tiến trình đang hoạt động và tài nguyên đang được sử dụng như thế nào.
  * Xác định tiến trình nặng gánh: Nhanh chóng tìm ra các website ứng dụng hoặc dịch vụ đang chiếm dụng quá nhiều CPU hoặc bộ nhớ, có thể là nguyên nhân gây chậm hệ thống.
  * Gỡ lỗi hiệu suất: Giúp chẩn đoán các vấn đề về hiệu suất, tình trạng treo hoặc phản hồi chậm của hệ thống.
  * Quản lý tiến trình cơ bản: Cho phép bạn thực hiện một số hành động như kill [dừng] một tiến trình hoặc renice [thay đổi độ ưu tiên] một cách tương tác.
  * Hiểu về tải hệ thống: Cung cấp thông tin về mức độ bận rộn của CPU và bộ nhớ.
EOF
}

# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

C_RESET=$'\033[0m'
C_BOLD_WHITE=$'\033[1;37m'
C_GREEN=$'\033[32m'
C_YELLOW=$'\033[33m'
C_RED=$'\033[31m'
C_CYAN=$'\033[36m'
C_CLEAR_LINE=$'\033[K'

if ((${BASH_VERSINFO[0]:-0} < 4)); then
  echo -e "${C_RED}Lỗi: Script yêu cầu Bash phiên bản 4.0 trở lên.${C_RESET}"
  exit 1
fi

export LC_ALL=C
START_ARG="${1:-}"

# Ưu tiên đặt file tạm trên RAM (/dev/shm) để 0 Disk I/O và bảo mật tối đa
if [[ -d /dev/shm && -w /dev/shm ]]; then
  RT_DIR="/dev/shm"
else
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
  chmod 700 /etc/wptt/tmp 2>/dev/null || true
  RT_DIR="/etc/wptt/tmp"
fi

TICK_FILE="${RT_DIR}/.wptt_top_ticks_${EUID:-0}_$$"
TEMP_CNF_ROOT=""

# ==============================================================================
# 1. TẠO FILE CẤU HÌNH TẠM CHO MARIADB TRÊN RAM (UMASK 077 & TỰ HỦY AN TOÀN)
# ==============================================================================
password_database_root="$(wptt_giai_ma "${database_admin_password:-}" 2>/dev/null || true)"
[[ -z "$password_database_root" ]] && password_database_root="${database_admin_password:-}"

old_umask="$(umask)"
umask 077
TEMP_CNF_ROOT="$(mktemp -p "$RT_DIR" wptt_db_XXXXXX.cnf 2>/dev/null || echo "${RT_DIR}/wptt_db_$$.cnf")"
cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username:-root}"
password="${password_database_root}"
host=localhost
connect-timeout=2
default-character-set=utf8mb4
EOF
umask "$old_umask"
unset password_database_root database_admin_password

DB_CLIENT_BIN=""
if command -v mariadb >/dev/null 2>&1; then
  DB_CLIENT_BIN="mariadb"
elif command -v mysql >/dev/null 2>&1; then
  DB_CLIENT_BIN="mysql"
fi

# ==============================================================================
# 2. BẪY TÍN HIỆU & DỌN DẸP TÀI NGUYÊN (CLEANUP)
# ==============================================================================
cleanup() {
  local rc=$?
  trap - SIGINT SIGTERM SIGHUP EXIT
  /bin/rm -f -- "${TEMP_CNF_ROOT:-}" "${TICK_FILE:-}" "${TICK_FILE:-}.tmp" 2>/dev/null || true
  printf '\033[?1049l\033[?25h\033[0m'
  stty sane 2>/dev/null || true
  echo -e "\n${C_GREEN}Đã thoát WPTangToc Dashboard (WTOP)!${C_RESET}\n"
  if [[ "$START_ARG" == "98" && -f /etc/wptt/wptt-tai-nguyen-main ]]; then
    exec /etc/wptt/wptt-tai-nguyen-main 1
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' SIGINT
trap 'exit 143' SIGTERM SIGHUP

# ==============================================================================
# 3. KHỞI TẠO TĨNH (ÁNH XẠ USER <-> DOMAIN 100% PURE BASH, 0 GREP SUBSHELL)
# ==============================================================================
SYS_HZ="$(getconf CLK_TCK 2>/dev/null || echo 100)"
((SYS_HZ <= 0)) && SYS_HZ=100

CPU_CORES=0
if [[ -r /proc/cpuinfo ]]; then
  while IFS= read -r line; do
    [[ "$line" == processor* ]] && ((CPU_CORES++))
  done </proc/cpuinfo
fi
((CPU_CORES <= 0)) && CPU_CORES=1

declare -A SYS_USERS=()
declare -A SYS_UIDS=()
while IFS=: read -r u_name _ u_uid _; do
  [[ -z "$u_name" || -z "$u_uid" ]] && continue
  SYS_USERS["$u_name"]="$u_uid"
  SYS_UIDS["$u_uid"]="$u_name"
done </etc/passwd

KNOWN_UIDS=""
for web_usr in nobody www-data; do
  if [[ -n "${SYS_USERS[$web_usr]:-}" ]]; then
    KNOWN_UIDS+="${KNOWN_UIDS:+ }${SYS_USERS[$web_usr]}"
  fi
done

declare -A MAP_USER_DOMAIN=()
shopt -s nullglob
vhost_confs=(/etc/wptt/vhost/.*.conf /etc/wptt/vhost/*.conf)
shopt -u nullglob

for conf_file in "${vhost_confs[@]}"; do
  [[ -f "$conf_file" && "$conf_file" != *"/..conf" ]] || continue
  u_name=""
  while IFS='=' read -r k v; do
    k="${k//[[:space:]]/}"
    if [[ "$k" == "User_name_vhost" ]]; then
      v="${v#"${v%%[![:space:]]*}"}"
      v="${v%"${v##*[![:space:]]}"}"
      v="${v#\"}"
      v="${v%\"}"
      v="${v#\'}"
      v="${v%\'}"
      u_name="$v"
      break
    fi
  done <"$conf_file"

  [[ -z "$u_name" ]] && continue
  d_name="${conf_file##*/}"
  d_name="${d_name#.}"
  d_name="${d_name%.conf}"
  MAP_USER_DOMAIN["$u_name"]="$d_name"

  u_id="${SYS_USERS[$u_name]:-}"
  if [[ -n "$u_id" ]]; then
    [[ " $KNOWN_UIDS " != *" $u_id "* ]] && KNOWN_UIDS+="${KNOWN_UIDS:+ }$u_id"
  else
    [[ " $KNOWN_UIDS " != *" $u_name "* ]] && KNOWN_UIDS+="${KNOWN_UIDS:+ }$u_name"
  fi
done

draw_htop_bar_fast() {
  local pct_int="${1%%.*}"
  local max_len="$2"
  local color_code="$3"
  [[ -z "$pct_int" || ! "$pct_int" =~ ^[0-9]+$ ]] && pct_int=0
  ((pct_int > 100)) && pct_int=100

  local fill=$(((pct_int * max_len + 50) / 100))
  ((fill < 0)) && fill=0
  ((fill > max_len)) && fill=$max_len
  local empty=$((max_len - fill))

  local fill_str="" empty_str=""
  if ((fill > 0)); then
    printf -v fill_str "%*s" "$fill" ""
    fill_str="${fill_str// /|}"
  fi
  if ((empty > 0)); then
    printf -v empty_str "%*s" "$empty" ""
  fi
  REPLY_BAR="[${color_code}${fill_str}${C_RESET}${empty_str}]"
}

shopt -s checkwinsize
(:;:) 2>/dev/null || true
TERM_LINES="${LINES:-24}"
TERM_COLS="${COLUMNS:-80}"

_update_winsize() {
  (:;:) 2>/dev/null || true
  TERM_LINES="${LINES:-$(tput lines 2>/dev/null || echo 24)}"
  TERM_COLS="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
}
trap '_update_winsize' SIGWINCH
_update_winsize

printf '\033[?1049h\033[?25l\033[2J\033[H'

# ==============================================================================
# 4. LẤY MẪU KHỞI ĐẦU CHO CPU, MẠNG & UPTIME
# ==============================================================================
read -r _ u1 n1 s1 i1 w1 x1 y1 z1 _ </proc/stat

rx_prev=0
tx_prev=0
while read -r iface rx _ _ _ _ _ _ _ tx _; do
  [[ "$iface" == *"Inter-"* || "$iface" == *"face"* || "$iface" == "lo:" ]] && continue
  rx_prev=$((rx_prev + rx))
  tx_prev=$((tx_prev + tx))
done </proc/net/dev

read -r up_raw _ </proc/uptime
up_s="${up_raw%%.*}"
up_f="${up_raw#*.}00"
prev_centis=$((10#$up_s * 100 + 10#${up_f:0:2}))

ps -eo pid= --no-headers 2>/dev/null | awk -v ts="$prev_centis" '
  BEGIN { print "TS", ts }
  {
    pid = $1
    sf = "/proc/" pid "/stat"
    if ((getline sl < sf) > 0) {
      idx = index(sl, ") ")
      if (idx > 0) {
        split(substr(sl, idx + 2), a, " ")
        print pid, (a[12] + a[13])
      }
    }
    close(sf)
  }
' >"$TICK_FILE" 2>/dev/null || true

SHOW_CMD=0
DELAY_SEC=3
LIVE_INDICATOR="●"
tick_count=0
users_logged=1

# ==============================================================================
# 5. VÒNG LẶP CHÍNH (REAL-TIME ENGINE - 1 SINGLE PASS PER TICK)
# ==============================================================================
while true; do
  BUFFER=""
  [[ "$LIVE_INDICATOR" == "●" ]] && LIVE_INDICATOR="○" || LIVE_INDICATOR="●"

  # 1. Đọc Uptime & Tính độ trễ thực tế (chính xác tới 1/100 giây) - 0 Subshell
  read -r up_raw _ </proc/uptime
  up_seconds="${up_raw%%.*}"
  up_f="${up_raw#*.}00"
  now_centis=$((10#$up_seconds * 100 + 10#${up_f:0:2}))

  delta_centis=$((now_centis - prev_centis))
  ((delta_centis <= 0)) && delta_centis=$((DELAY_SEC * 100))
  prev_centis=$now_centis

  up_days=$((up_seconds / 86400))
  up_rem=$((up_seconds % 86400))
  up_hours=$((up_rem / 3600))
  up_rem=$((up_rem % 3600))
  up_mins=$((up_rem / 60))
  up_secs=$((up_rem % 60))
  if ((up_days > 0)); then
    printf -v uptime_info "%d days, %02d:%02d:%02d" "$up_days" "$up_hours" "$up_mins" "$up_secs"
  else
    printf -v uptime_info "%02d:%02d:%02d" "$up_hours" "$up_mins" "$up_secs"
  fi

  # 2. Đọc Load Average & Thời gian hệ thống - 0 Subshell
  read -r l1 l2 l3 _ </proc/loadavg
  load_avg="$l1, $l2, $l3"
  printf -v current_time "%(%H:%M:%S)T" -1 2>/dev/null || current_time="00:00:00"

  if ((tick_count % 5 == 0)); then
    read -r -a logged_array < <(users 2>/dev/null || true)
    users_logged=${#logged_array[@]}
  fi
  ((tick_count++))

  # 3. Đọc /proc/stat & Tính %CPU bằng Toán học Điểm tĩnh Pure Bash (0 AWK, 0 Subshell)
  read -r _ u2 n2 s2 i2 w2 x2 y2 z2 _ </proc/stat
  ud=$((u2 - u1))
  nd=$((n2 - n1))
  sd=$((s2 - s1))
  id=$((i2 - i1))
  wd=$((w2 - w1))
  xd=$((x2 - x1))
  yd=$((y2 - y1))
  zd=$((${z2:-0} - ${z1:-0}))
  u1=$u2; n1=$n2; s1=$s2; i1=$i2; w1=$w2; x1=$x2; y1=$y2; z1=${z2:-0}

  tot_cpu=$((ud + nd + sd + id + wd + xd + yd + zd))
  ((tot_cpu <= 0)) && tot_cpu=1

  us_p10=$((ud * 1000 / tot_cpu))
  sy_p10=$((sd * 1000 / tot_cpu))
  ni_p10=$((nd * 1000 / tot_cpu))
  id_p10=$((id * 1000 / tot_cpu))
  wa_p10=$((wd * 1000 / tot_cpu))
  hi_p10=$((xd * 1000 / tot_cpu))
  si_p10=$((yd * 1000 / tot_cpu))
  st_p10=$((zd * 1000 / tot_cpu))
  tot_p10=$(((tot_cpu - id) * 1000 / tot_cpu))

  c_us="$((us_p10 / 10)).$((us_p10 % 10))"
  c_sy="$((sy_p10 / 10)).$((sy_p10 % 10))"
  c_ni="$((ni_p10 / 10)).$((ni_p10 % 10))"
  c_id="$((id_p10 / 10)).$((id_p10 % 10))"
  c_wa="$((wa_p10 / 10)).$((wa_p10 % 10))"
  c_hi="$((hi_p10 / 10)).$((hi_p10 % 10))"
  c_si="$((si_p10 / 10)).$((si_p10 % 10))"
  c_st="$((st_p10 / 10)).$((st_p10 % 10))"
  c_tot="$((tot_p10 / 10))"

  # 4. Đọc /proc/meminfo - 0 Subshell
  RAM_TOT=1; RAM_FREE=0; RAM_AVAIL=0; RAM_BUFF_RAW=0; RAM_CACHE_RAW=0; RAM_SRECLAIM=0; SWAP_TOT=0; SWAP_FREE=0
  while read -r name value _; do
    case "$name" in
      MemTotal:) RAM_TOT=$((value / 1024)) ;;
      MemFree:) RAM_FREE=$((value / 1024)) ;;
      MemAvailable:) RAM_AVAIL=$((value / 1024)) ;;
      Buffers:) RAM_BUFF_RAW=$value ;;
      Cached:) RAM_CACHE_RAW=$value ;;
      SReclaimable:) RAM_SRECLAIM=$value ;;
      SwapTotal:) SWAP_TOT=$((value / 1024)) ;;
      SwapFree:) SWAP_FREE=$((value / 1024)) ;;
    esac
  done </proc/meminfo

  RAM_BUFF=$(((RAM_BUFF_RAW + RAM_CACHE_RAW + RAM_SRECLAIM) / 1024))
  RAM_USE=$((RAM_TOT - RAM_FREE - RAM_BUFF))
  ((RAM_USE < 0)) && RAM_USE=$((RAM_TOT - RAM_AVAIL))
  SWAP_USE=$((SWAP_TOT - SWAP_FREE))
  ((RAM_TOT <= 0)) && RAM_TOT=1
  RAM_PCT=$((RAM_USE * 100 / RAM_TOT))
  if ((SWAP_TOT > 0)); then
    SWAP_PCT=$((SWAP_USE * 100 / SWAP_TOT))
  else
    SWAP_PCT=0
  fi

  # 5. Đọc lưu lượng Network theo thời gian thực tế (`delta_centis`) - 0 Subshell
  rx_now=0
  tx_now=0
  while read -r iface rx _ _ _ _ _ _ _ tx _; do
    [[ "$iface" == *"Inter-"* || "$iface" == *"face"* || "$iface" == "lo:" ]] && continue
    rx_now=$((rx_now + rx))
    tx_now=$((tx_now + tx))
  done </proc/net/dev

  rx_rate=$(((rx_now - rx_prev) * 100 / 1024 / delta_centis))
  tx_rate=$(((tx_now - tx_prev) * 100 / 1024 / delta_centis))
  ((rx_rate < 0)) && rx_rate=0
  ((tx_rate < 0)) && tx_rate=0
  rx_prev=$rx_now
  tx_prev=$tx_now

  net_in_color="${C_RESET}"; ((rx_rate > 5120)) && net_in_color="${C_RED}"
  net_out_color="${C_RESET}"; ((tx_rate > 5120)) && net_out_color="${C_RED}"

  # 6. Tính số dòng hiển thị tối đa
  MAX_ROWS=$((TERM_LINES - 13))
  ((MAX_ROWS < 5)) && MAX_ROWS=5

  # ============================================================================
  # 7. THU THẬP DỮ LIỆU TIẾN TRÌNH TRONG 1 LỆNH PS + 1 AWK DUY NHẤT (SINGLE-PASS)
  #    Tự động nhận diện SSHGuard (mặc định), Fail2Ban (nâng cao) hoặc cả hai
  # ============================================================================
  tasks_total=0; tasks_running=0; tasks_sleeping=0; tasks_stopped=0; tasks_zombie=0
  DB_CPU="0.0"; DB_RAM="0"; OC_CPU="0.0"; OC_RAM="0"; OLS_CPU="0.0"; OLS_RAM="0"
  IDS_LABEL="SSHGuard "; IDS_CPU="0.0"; IDS_RAM="0"
  PS_ROWS=()

  while IFS='|' read -r rec_type f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14; do
    if [[ "$rec_type" == "SUM" ]]; then
      tasks_total="$f1"; tasks_running="$f2"; tasks_sleeping="$f3"; tasks_stopped="$f4"; tasks_zombie="$f5"
      DB_CPU="$f6"; DB_RAM="$f7"; OC_CPU="$f8"; OC_RAM="$f9"; OLS_CPU="$f10"; OLS_RAM="$f11"
      IDS_LABEL="$f12"; IDS_CPU="$f13"; IDS_RAM="$f14"
    elif [[ "$rec_type" == "ROW" ]]; then
      PS_ROWS+=("${f1}|${f2}|${f3}|${f4}|${f5}|${f6}|${f7}")
    fi
  done < <(
    ps -ww -eo pid=,uid=,s=,%cpu=,rsz=,comm=,args= 2>/dev/null |
      awk -v mode="$SHOW_CMD" \
          -v sys_hz="$SYS_HZ" \
          -v now_cs="$now_centis" \
          -v known_uids="$KNOWN_UIDS" \
          -v tick_file="$TICK_FILE" \
          -v max_rows="$MAX_ROWS" '
        BEGIN {
          prev_ts = 0
          while ((getline < tick_file) > 0) {
            if ($1 == "TS") prev_ts = int($2)
            else if ($1 != "") prev_ticks[$1] = $2
          }
          close(tick_file)

          dt_sec = (prev_ts > 0 && now_cs > prev_ts) ? ((now_cs - prev_ts) / 100.0) : 3.0
          if (dt_sec < 0.1) dt_sec = 0.1

          if (mode == 0) {
            n = split(known_uids, ku, " ")
            for (i = 1; i <= n; i++) {
              if (ku[i] != "") {
                count[ku[i]] = 0; total_cpu[ku[i]] = 0; total_ram[ku[i]] = 0
                active[ku[i]] = 0; active_from_cpu[ku[i]] = 0
              }
            }
          }
          m = 0
        }
        {
          pid = $1; uid = $2; st = $3; pcpu = $4; rsz = $5; comm = $6

          # 1. Đếm trạng thái toàn bộ Task trên máy chủ
          tot++
          if (st == "R") r++
          else if (st == "S" || st == "D" || st == "I") sl++
          else if (st == "T") t++
          else if (st == "Z") z++

          # 2. Cộng dồn tài nguyên các dịch vụ cốt lõi (Bắt cả SSHGuard mặc định & Fail2Ban nâng cao)
          if (comm ~ /^(mysqld|mariadbd)$/) { db_c += pcpu; db_r += rsz }
          else if (comm ~ /^(redis-server|valkey-server|keydb-server|memcached)$/) { oc_c += pcpu; oc_r += rsz }
          else if (comm ~ /^(openlitespeed|litespeed|lshttpd)$/) { ols_c += pcpu; ols_r += rsz }
          else if (comm ~ /^(sshguard|sshg-)/) { sg_c += pcpu; sg_r += rsz; sg_cnt++ }
          else if (comm ~ /^fail2ban-server$/) { f2b_c += pcpu; f2b_r += rsz; f2b_cnt++ }

          # 3. Xử lý chuyên sâu cho tiến trình Web / LSPHP
          if (uid == 0 || comm !~ /^(lsphp|lshttpd|openlitespeed|litespeed)$/) next

          ticks = 0; cputime = "0:00.00"
          sf = "/proc/" pid "/stat"
          if ((getline sl_line < sf) > 0) {
            idx = index(sl_line, ") ")
            if (idx > 0) {
              split(substr(sl_line, idx + 2), sa, " ")
              ticks = sa[12] + sa[13]
              if (mode == 1) {
                tc = int((ticks * 100) / sys_hz)
                sc = int(tc / 100); cn = tc % 100
                mn = int(sc / 60); sc = sc % 60
                cputime = sprintf("%d:%02d.%02d", mn, sc, cn)
              }
            }
          }
          close(sf)

          current_ticks[pid] = ticks
          diff = (pid in prev_ticks) ? (ticks - prev_ticks[pid]) : 0
          if (diff < 0) diff = 0
          real_cpu = (diff * 100.0) / (sys_hz * dt_sec)
          ram_mb = rsz / 1024.0

          if (mode == 0) {
            count[uid]++
            total_ram[uid] += ram_mb
            total_cpu[uid] += real_cpu
            if (st == "R" || st == "D") active[uid]++
            else if (real_cpu >= 0.5) active_from_cpu[uid] += int(real_cpu / 40) + 1
          } else if (mode == 1) {
            cmd_str = ""
            cf = "/proc/" pid "/cmdline"
            if ((getline raw_cmd < cf) > 0) {
              gsub(/\0/, " ", raw_cmd)
              gsub(/^[ \t]+|[ \t]+$/, "", raw_cmd)
              cmd_str = raw_cmd
            }
            close(cf)
            if (cmd_str !~ /^lsphp:/) {
              cmd_str = ""
              for (i = 7; i <= NF; i++) cmd_str = cmd_str (i == 7 ? "" : " ") $i
            }
            gsub(/\|/, "/", cmd_str)

            m++
            keys[m] = sprintf("%09.2f%08.2f%07d", real_cpu, ram_mb, 9999999 - pid)
            rows[m] = sprintf("ROW|%s|%s|%.1f|%.1f|%s|%s|%s", pid, uid, real_cpu, ram_mb, st, cputime, cmd_str)
          }
        }
        END {
          # Tự động chọn nhãn IDS (căn chuẩn 9 ký tự khớp với ObjCache)
          if (sg_cnt > 0 && f2b_cnt > 0) {
            ids_lbl = "SSHG+F2B "
          } else if (f2b_cnt > 0) {
            ids_lbl = "Fail2Ban "
          } else {
            ids_lbl = "SSHGuard "
          }
          ids_cpu = sg_c + f2b_c
          ids_ram_mb = (sg_r + f2b_r) / 1024.0
          if (ids_ram_mb > 0 && ids_ram_mb < 10) {
            ids_ram_str = sprintf("%.1f", ids_ram_mb)
          } else {
            ids_ram_str = sprintf("%.0f", ids_ram_mb)
          }

          printf "SUM|%d|%d|%d|%d|%d|%.1f|%.0f|%.1f|%.0f|%.1f|%.0f|%s|%.1f|%s\n", \
            tot+0, r+0, sl+0, t+0, z+0, \
            db_c+0, db_r/1024, oc_c+0, oc_r/1024, ols_c+0, ols_r/1024, \
            ids_lbl, ids_cpu+0, ids_ram_str

          print "TS", now_cs > tick_file
          for (p in current_ticks) print p, current_ticks[p] > tick_file
          close(tick_file)

          if (mode == 0) {
            for (u in count) {
              act = active[u] + active_from_cpu[u]
              if (act > count[u]) act = count[u]
              m++
              keys[m] = sprintf("%09.2f%06d%08.2f", total_cpu[u], count[u], total_ram[u])
              rows[m] = sprintf("ROW|%s|%d|%d|%.1f|%.1f||", u, count[u], act, total_cpu[u], total_ram[u])
            }
          }

          if (m > 1) {
            gap = int(m / 2)
            while (gap > 0) {
              for (i = gap + 1; i <= m; i++) {
                tk = keys[i]; tr = rows[i]
                j = i
                while (j > gap && keys[j - gap] < tk) {
                  keys[j] = keys[j - gap]
                  rows[j] = rows[j - gap]
                  j -= gap
                }
                keys[j] = tk; rows[j] = tr
              }
              gap = int(gap / 2)
            }
          }

          limit = (m < max_rows) ? m : max_rows
          for (i = 1; i <= limit; i++) print rows[i]
        }
      '
  )

  # ============================================================================
  # 8. LẮP RÁP KHUNG HÌNH HEADER TRÊN RAM (0 SUBSHELL)
  # ============================================================================
  BAR_LEN=20
  REPLY_BAR=""
  draw_htop_bar_fast "$c_tot" "$BAR_LEN" "$C_GREEN"
  bar_cpu="$REPLY_BAR"
  draw_htop_bar_fast "$RAM_PCT" "$BAR_LEN" "$C_CYAN"
  bar_mem="$REPLY_BAR"
  draw_htop_bar_fast "$SWAP_PCT" "$BAR_LEN" "$C_RED"
  bar_swp="$REPLY_BAR"

  BUFFER+="wptt-top - $current_time ${C_CYAN}${LIVE_INDICATOR}${C_RESET} | Uptime: ${C_CYAN}$uptime_info${C_RESET} | Cores: ${C_CYAN}$CPU_CORES${C_RESET} | Users: $users_logged | Load: $load_avg${C_CLEAR_LINE}\n"

  if ((SHOW_CMD == 0)); then
    BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Chi tiết Tiến trình | [${C_CYAN}M${C_RESET}] Soi lệnh MariaDB | [${C_GREEN}R${C_RESET}] Làm mới | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
  elif ((SHOW_CMD == 1)); then
    BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Gộp theo Website | [${C_CYAN}M${C_RESET}] Soi lệnh MariaDB | [${C_GREEN}R${C_RESET}] Làm mới | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
  else
    BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Quay lại Tiến trình | ${C_CYAN}Đang soi MariaDB (Real-time)${C_RESET} | [${C_GREEN}R${C_RESET}] Làm mới | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
  fi

  BUFFER+="Tasks: ${C_BOLD_WHITE}$tasks_total${C_RESET} total,   ${C_BOLD_WHITE}$tasks_running${C_RESET} running, ${C_BOLD_WHITE}$tasks_sleeping${C_RESET} sleeping,   ${C_BOLD_WHITE}$tasks_stopped${C_RESET} stopped,   ${C_BOLD_WHITE}$tasks_zombie${C_RESET} zombie${C_CLEAR_LINE}\n"
  BUFFER+="CPU ${bar_cpu} %Cpu(s): ${C_BOLD_WHITE}${c_us}${C_RESET} us, ${C_BOLD_WHITE}${c_sy}${C_RESET} sy, ${C_BOLD_WHITE}${c_ni}${C_RESET} ni, ${C_BOLD_WHITE}${c_id}${C_RESET} id, ${C_BOLD_WHITE}${c_wa}${C_RESET} wa, ${C_BOLD_WHITE}${c_hi}${C_RESET} hi, ${C_BOLD_WHITE}${c_si}${C_RESET} si, ${C_BOLD_WHITE}${c_st}${C_RESET} st${C_CLEAR_LINE}\n"

  printf -v line_mem "Mem %s MiB Mem: %s%7s%s total, %s%7s%s free, %s%7s%s used, %s%7s%s buff/cache%s\n" \
    "$bar_mem" "$C_BOLD_WHITE" "$RAM_TOT" "$C_RESET" "$C_BOLD_WHITE" "$RAM_FREE" "$C_RESET" \
    "$C_BOLD_WHITE" "$RAM_USE" "$C_RESET" "$C_BOLD_WHITE" "$RAM_BUFF" "$C_RESET" "$C_CLEAR_LINE"
  BUFFER+="$line_mem"

  printf -v line_swp "Swp %s MiB Swp: %s%7s%s total, %s%7s%s free, %s%7s%s used. %s%7s%s avail Mem%s\n" \
    "$bar_swp" "$C_BOLD_WHITE" "$SWAP_TOT" "$C_RESET" "$C_BOLD_WHITE" "$SWAP_FREE" "$C_RESET" \
    "$C_BOLD_WHITE" "$SWAP_USE" "$C_RESET" "$C_BOLD_WHITE" "$RAM_AVAIL" "$C_RESET" "$C_CLEAR_LINE"
  BUFFER+="$line_swp"

  printf -v line_svc1 "MariaDB  : %s%5s%s%% CPU, %s%6s%s MiB | ObjCache : %s%5s%s%% CPU, %s%6s%s MiB%s\n" \
    "$C_BOLD_WHITE" "$DB_CPU" "$C_RESET" "$C_BOLD_WHITE" "$DB_RAM" "$C_RESET" \
    "$C_BOLD_WHITE" "$OC_CPU" "$C_RESET" "$C_BOLD_WHITE" "$OC_RAM" "$C_RESET" "$C_CLEAR_LINE"
  BUFFER+="$line_svc1"

  printf -v line_svc2 "LiteSpeed: %s%5s%s%% CPU, %s%6s%s MiB | %-9s: %s%5s%s%% CPU, %s%6s%s MiB%s\n" \
    "$C_BOLD_WHITE" "$OLS_CPU" "$C_RESET" "$C_BOLD_WHITE" "$OLS_RAM" "$C_RESET" \
    "$IDS_LABEL" "$C_BOLD_WHITE" "$IDS_CPU" "$C_RESET" "$C_BOLD_WHITE" "$IDS_RAM" "$C_RESET" "$C_CLEAR_LINE"
  BUFFER+="$line_svc2"

  BUFFER+="Network  : In ${net_in_color}${rx_rate} KB/s${C_RESET}, Out ${net_out_color}${tx_rate} KB/s${C_RESET}${C_CLEAR_LINE}\n\n"
  BUFFER+=$'\033[7m'

  # ============================================================================
  # 9. RENDER BẢNG DỮ LIỆU THEO CHẾ ĐỘ (0 SUBSHELL TRONG VÒNG LẶP DÒNG)
  # ============================================================================
  if ((SHOW_CMD == 0)); then
    printf -v row_header " %-30s | %-24s | %-10s | %-15s " "WEBSITE (DOMAIN)" "PROCESS (Active / Total)" "%CPU" "MEM (MiB)"
    BUFFER+="${row_header}"$'\033[0m'"${C_CLEAR_LINE}\n"

    if ((${#PS_ROWS[@]} == 0)); then
      BUFFER+="  ${C_YELLOW}Hệ thống nhàn rỗi. Không có tiến trình Web/Cache nào đang hoạt động.${C_RESET}${C_CLEAR_LINE}\n"
    else
      for row_item in "${PS_ROWS[@]}"; do
        IFS='|' read -r uid proc_tot proc_act cpu_disp ram_mb _ <<<"$row_item"
        [[ -z "$uid" ]] && continue

        user="${SYS_UIDS[$uid]:-$uid}"
        domain_display="${MAP_USER_DOMAIN[$user]:-$user}"
        if [[ "$user" == "nobody" || "$user" == "www-data" ]]; then
          domain_display="$user (LSCache Worker)"
        fi
        ((${#domain_display} > 29)) && domain_display="${domain_display:0:26}..."

        cpu_int="${cpu_disp%.*}"
        cpu_color="${C_RESET}"
        if ((cpu_int >= 80)); then
          cpu_color="${C_RED}"
        elif ((cpu_int >= 40)); then
          cpu_color="${C_YELLOW}"
        fi

        ram_int="${ram_mb%.*}"
        ram_color="${C_RESET}"
        if ((ram_int >= 1024)); then
          ram_color="${C_RED}"
        elif ((ram_int >= 500)); then
          ram_color="${C_YELLOW}"
        fi

        act_color="${C_BOLD_WHITE}"
        if ((proc_act > 0)); then
          if ((proc_act == proc_tot)); then
            act_color="${C_RED}"
          else
            act_color="${C_GREEN}"
          fi
        fi

        plain_lsphp="${proc_act} Active / ${proc_tot} Total"
        pad_len=$((24 - ${#plain_lsphp}))
        ((pad_len < 0)) && pad_len=0
        printf -v padding "%*s" "$pad_len" ""
        colored_lsphp="${act_color}${proc_act} Active${C_RESET} / ${C_CYAN}${proc_tot} Total${C_RESET}${padding}"

        printf -v row_buf " %-30s | %s | %s%-10s%s | %s%-15s%s%s\n" \
          "$domain_display" "$colored_lsphp" \
          "$cpu_color" "$cpu_disp" "$C_RESET" \
          "$ram_color" "$ram_mb" "$C_RESET" "$C_CLEAR_LINE"
        BUFFER+="$row_buf"
      done
    fi

  elif ((SHOW_CMD == 1)); then
    CMD_WIDTH=$((TERM_COLS - 74))
    ((CMD_WIDTH < 20)) && CMD_WIDTH=20

    printf -v row_header " %-7s | %-16s | %-5s | %-8s | %-4s | %9s | %-s " "PID" "WEBSITE" "%CPU" "MEM(MiB)" "STAT" "TIME+" "COMMAND"
    BUFFER+="${row_header}"$'\033[0m'"${C_CLEAR_LINE}\n"

    if ((${#PS_ROWS[@]} == 0)); then
      BUFFER+="  ${C_YELLOW}Hệ thống nhàn rỗi. Không có tiến trình Web/Cache nào đang hoạt động.${C_RESET}${C_CLEAR_LINE}\n"
    else
      for row_item in "${PS_ROWS[@]}"; do
        IFS='|' read -r pid uid cpu_disp ram_mb stat cputime args <<<"$row_item"
        [[ -z "$pid" ]] && continue

        user="${SYS_UIDS[$uid]:-$uid}"
        domain_display="${MAP_USER_DOMAIN[$user]:-$user}"
        if [[ "$user" == "nobody" || "$user" == "www-data" ]]; then
          domain_display="$user (LSCache)"
        fi
        ((${#domain_display} > 15)) && domain_display="${domain_display:0:12}..."

        cpu_int="${cpu_disp%.*}"
        cpu_color="${C_RESET}"
        if ((cpu_int >= 80)); then
          cpu_color="${C_RED}"
        elif ((cpu_int >= 40)); then
          cpu_color="${C_YELLOW}"
        fi

        ram_int="${ram_mb%.*}"
        ram_color="${C_RESET}"
        if ((ram_int >= 1024)); then
          ram_color="${C_RED}"
        elif ((ram_int >= 500)); then
          ram_color="${C_YELLOW}"
        fi

        stat_color="${C_CYAN}"
        [[ "$stat" == "R" || "$stat" == "D" ]] && stat_color="${C_GREEN}"
        [[ "$stat" == "Z" ]] && stat_color="${C_RED}"
        [[ "$stat" == "T" ]] && stat_color="${C_YELLOW}"

        if ((${#args} > CMD_WIDTH)); then
          args="${args:0:$((CMD_WIDTH - 3))}..."
        fi

        if [[ "$args" == lsphp:* ]]; then
          args="${C_YELLOW}lsphp:${C_RESET}${C_BOLD_WHITE}${args#lsphp:}${C_RESET}"
        elif [[ "$args" == "lsphp" || "$args" == *"lsphp (idle)"* ]]; then
          args="${C_YELLOW}lsphp${C_RESET} (idle)"
        elif [[ "$args" == *"openlitespeed"* || "$args" == *"lshttpd"* || "$args" == *"litespeed"* ]]; then
          args="${C_GREEN}${args}${C_RESET} (Worker)"
        fi

        printf -v row_buf " %s%-7s%s | %-16s | %s%-5s%s | %s%-8s%s | %s%-4s%s | %9s | %-s%s\n" \
          "$C_YELLOW" "$pid" "$C_RESET" \
          "$domain_display" \
          "$cpu_color" "$cpu_disp" "$C_RESET" \
          "$ram_color" "$ram_mb" "$C_RESET" \
          "$stat_color" "$stat" "$C_RESET" \
          "$cputime" "$args" "$C_CLEAR_LINE"
        BUFFER+="$row_buf"
      done
    fi

  elif ((SHOW_CMD == 2)); then
    CMD_WIDTH=$((TERM_COLS - 77))
    ((CMD_WIDTH < 20)) && CMD_WIDTH=20

    printf -v row_header " %-8s | %-26s | %-22s | %-7s | %-s " "QUERY_ID" "DB_USER" "DB_NAME" "TIME(s)" "INFO (COMMAND / QUERY)"
    BUFFER+="${row_header}"$'\033[0m'"${C_CLEAR_LINE}\n"

    DB_ROWS=()
    if [[ -n "$DB_CLIENT_BIN" && -r "$TEMP_CNF_ROOT" ]]; then
      while IFS= read -r db_line; do
        [[ -n "$db_line" ]] && DB_ROWS+=("$db_line")
      done < <(
        "$DB_CLIENT_BIN" --defaults-extra-file="$TEMP_CNF_ROOT" --batch --raw -e "SHOW FULL PROCESSLIST" 2>/dev/null |
          awk -F'\t' -v max_rows="$MAX_ROWS" '
            NR > 1 {
              id = $1; user = $2; db = $4; cmd = $5; time = int($6); info = $8
              if (info == "SHOW FULL PROCESSLIST") next
              if (db == "NULL" || db == "") db = "-"
              if (info == "NULL" || info == "") info = "[" cmd "]"
              gsub(/[\r\n\t|]+/, " ", info)

              weight = (cmd == "Sleep") ? 2 : 1
              m++
              keys[m] = sprintf("%d%09d", weight, 999999999 - time)
              rows[m] = weight "|" id "|" user "|" db "|" time "|" info
            }
            END {
              if (m > 1) {
                gap = int(m / 2)
                while (gap > 0) {
                  for (i = gap + 1; i <= m; i++) {
                    tk = keys[i]; tr = rows[i]
                    j = i
                    while (j > gap && keys[j - gap] > tk) {
                      keys[j] = keys[j - gap]
                      rows[j] = rows[j - gap]
                      j -= gap
                    }
                    keys[j] = tk; rows[j] = tr
                  }
                  gap = int(gap / 2)
                }
              }
              limit = (m < max_rows) ? m : max_rows
              for (i = 1; i <= limit; i++) print rows[i]
            }
          '
      )
    fi

    if ((${#DB_ROWS[@]} == 0)); then
      BUFFER+="  ${C_GREEN}Không có kết nối (Connection) nào tới Database vào lúc này.${C_RESET}${C_CLEAR_LINE}\n"
    else
      for db_row in "${DB_ROWS[@]}"; do
        IFS='|' read -r weight db_id db_user db_name db_time db_info <<<"$db_row"
        [[ -z "$db_id" ]] && continue

        ((${#db_user} > 25)) && db_user="${db_user:0:22}..."
        ((${#db_name} > 21)) && db_name="${db_name:0:18}..."
        ((${#db_info} > CMD_WIDTH)) && db_info="${db_info:0:$((CMD_WIDTH - 3))}..."

        if [[ "$weight" == "2" ]]; then
          time_color="${C_CYAN}"; info_color="${C_CYAN}"
        else
          time_color="${C_GREEN}"
          ((db_time >= 5)) && time_color="${C_YELLOW}"
          ((db_time >= 15)) && time_color="${C_RED}"
          info_color="${C_RESET}"
        fi

        printf -v row_buf " %s%-8s%s | %-26s | %-22s | %s%-7s%s | %s%-s%s%s\n" \
          "$C_YELLOW" "$db_id" "$C_RESET" "$db_user" "$db_name" \
          "$time_color" "$db_time" "$C_RESET" "$info_color" "$db_info" "$C_RESET" "$C_CLEAR_LINE"
        BUFFER+="$row_buf"
      done
    fi
  fi

  # ----------------------------------------------------------------------------
  # 10. XUẤT BUFFER RA MÀN HÌNH BẰNG ANSI ESCAPE (0 LỆNH TPUT, CHỐNG NHẤP NHÁY)
  # ----------------------------------------------------------------------------
  printf '\033[H%b\033[J' "${BUFFER%$'\n'}"

  key=""
  read -r -t "$DELAY_SEC" -n 1 -s key || true
  case "$key" in
    c | C)
      ((SHOW_CMD == 0)) && SHOW_CMD=1 || SHOW_CMD=0
      ;;
    m | M)
      ((SHOW_CMD == 2)) && SHOW_CMD=0 || SHOW_CMD=2
      ;;
    r | R)
      continue
      ;;
    q | Q | 0)
      cleanup
      ;;
  esac
done
