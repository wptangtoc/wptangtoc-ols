#!/bin/bash
function huong_dan() {
  Tính năng truy cập vào ứng dụng: wptt-top

  wptt-top trong Linux là một công cụ dòng lệnh cung cấp một cái nhìn động, cập nhật theo thời gian thực về các tiến trình [processes] đang chạy và tình hình sử dụng tài nguyên hệ thống chuyên sâu cho webserver lsws của bạn.

  Nói một cách đơn giản, wptt-top giống như bảng điều khiển trung tâm hiển thị trực tiếp những gì đang diễn ra bên trong máy chủ webserver của bạn, đặc biệt là những tiến trình website nào đang ngốn CPU và RAM nhiều nhất.

  Mục Đích Chính
  * Theo dõi hệ thống thời gian thực: Xem ngay lập tức các tiến trình đang hoạt động và tài nguyên đang được sử dụng như thế nào.
  * Xác định tiến trình nặng gánh: Nhanh chóng tìm ra các website ứng dụng hoặc dịch vụ đang chiếm dụng quá nhiều CPU hoặc bộ nhớ, có thể là nguyên nhân gây chậm hệ thống.
  * Gỡ lỗi hiệu suất: Giúp chẩn đoán các vấn đề về hiệu suất, tình trạng treo hoặc phản hồi chậm của hệ thống.
  * Quản lý tiến trình cơ bản: Cho phép bạn thực hiện một số hành động như kill [dừng] một tiến trình hoặc renice [thay đổi độ ưu tiên] một cách tương tác.
  * Hiểu về tải hệ thống: Cung cấp thông tin về mức độ bận rộn của CPU và bộ nhớ.
}

. /etc/wptt/echo-color
. /etc/wptt/.wptt.conf 2>/dev/null

C_RESET='\e[0m'
C_BOLD_WHITE='\e[1;37m'
C_GREEN='\e[32m'
C_YELLOW='\e[33m'
C_RED='\e[31m'
C_CYAN='\e[36m'
C_CLEAR_LINE='\e[K'

if ((${BASH_VERSINFO[0]} < 4)); then
    echo -e "${C_RED}Lỗi: Script yêu cầu Bash phiên bản 4.0 trở lên.${C_RESET}"
    exit 1
fi

export LC_ALL=C

START_ARG="${1:-}"

# ==============================================================================
# TẠO FILE CẤU HÌNH TẠM CHO MARIADB (BẢO MẬT & TỰ HỦY)
# ==============================================================================
TEMP_CNF_root=$(mktemp)
chmod 600 "$TEMP_CNF_root"
cat >"$TEMP_CNF_root" <<EOF
[client]
user=${database_admin_username}
password=${database_admin_password}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ TÀI NGUYÊN ➜ Trình Giám Sát Hệ Thống Thời Gian Thực (WTOP)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KHỞI TẠO TĨNH
# ==============================================================================
SYS_HZ=$(getconf CLK_TCK 2>/dev/null || echo 100)
CPU_CORES=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 1)

declare -A SYS_USERS
declare -A SYS_UIDS
while IFS=: read -r u_name _ u_uid _; do
    SYS_USERS["$u_name"]="$u_uid"
    SYS_UIDS["$u_uid"]="$u_name"
done < /etc/passwd

KNOWN_UIDS="${SYS_USERS["nobody"]:-nobody}"
declare -A MAP_USER_DOMAIN

while IFS=: read -r conf_file u_name; do
    [[ -z "$u_name" ]] && continue
    d_name="${conf_file##*/.}"
    d_name="${d_name##*/}"
    d_name="${d_name%.conf}"
    MAP_USER_DOMAIN["$u_name"]="$d_name"
    
    u_id="${SYS_USERS["$u_name"]}"
    [[ -n "$u_id" ]] && KNOWN_UIDS+=" $u_id" || KNOWN_UIDS+=" $u_name"
done < <(grep -H -oP "^[ \t]*User_name_vhost=['\"]?\K[^'\"]+" /etc/wptt/vhost/.*.conf /etc/wptt/vhost/*.conf 2>/dev/null)

cleanup() {
    rm -f "$TEMP_CNF_root"
    tput rmcup
    tput cnorm
    echo -e "\n${C_GREEN}Đã thoát WPTangToc Dashboard!${C_RESET}\n"
    if [[ "$START_ARG" == "98" ]]; then
        exec /etc/wptt/wptt-tai-nguyen-main 1
    fi
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

draw_htop_bar() {
    local percent=$1; local max_len=$2; local color_code=$3
    [[ -z "$percent" ]] && percent=0
    local fill=$(awk -v p="$percent" -v l="$max_len" 'BEGIN { printf "%d", (p * l) / 100 }')
    local empty=$((max_len - fill))
    local bar="[${color_code}"
    for ((i=0; i<fill; i++)); do bar+="|"; done
    bar+="${C_RESET}"
    for ((i=0; i<empty; i++)); do bar+=" "; done
    bar+="]"
    echo "$bar"
}

tput smcup
tput civis
clear

while read -r name u s n i w x y z _; do
    if [[ "$name" == "cpu" ]]; then
        u1=$u; s1=$s; n1=$n; i1=$i; w1=$w; x1=$x; y1=$y; z1=$z
        break
    fi
done < /proc/stat

rx_prev=0; tx_prev=0
while read -r iface rx _ _ _ _ _ _ _ tx _; do
    [[ "$iface" == *"Inter-"* || "$iface" == *"face"* || "$iface" == *"lo:"* ]] && continue
    rx_prev=$((rx_prev + rx)); tx_prev=$((tx_prev + tx))
done </proc/net/dev

> /tmp/.wptt_top_ticks

SHOW_CMD=0
DELAY_SEC=3
LIVE_INDICATOR="●"

# ==============================================================================
# VÒNG LẶP CHÍNH
# ==============================================================================
while true; do
    BUFFER=""
    
    [[ "$LIVE_INDICATOR" == "●" ]] && LIVE_INDICATOR="○" || LIVE_INDICATOR="●"
    
    read -r up_seconds _ < /proc/uptime
    up_seconds=${up_seconds%%.*}
    up_days=$((up_seconds / 86400)); up_rem=$((up_seconds % 86400))
    up_hours=$((up_rem / 3600)); up_rem=$((up_rem % 3600))
    up_mins=$((up_rem / 60)); up_secs=$((up_rem % 60))
    if [[ $up_days -gt 0 ]]; then
        uptime_info=$(printf "%d days, %02d:%02d:%02d" "$up_days" "$up_hours" "$up_mins" "$up_secs")
    else
        uptime_info=$(printf "%02d:%02d:%02d" "$up_hours" "$up_mins" "$up_secs")
    fi

    read -r l1 l2 l3 _ < /proc/loadavg
    load_avg="$l1, $l2, $l3"
    
    logged_array=($(users 2>/dev/null))
    users_logged=${#logged_array[@]}
    printf -v current_time "%(%H:%M:%S)T" -1 2>/dev/null || current_time=$(date +"%H:%M:%S")

    read -r tasks_total tasks_running tasks_sleeping tasks_stopped tasks_zombie <<< $(ps -A -o state= 2>/dev/null | awk '{
        tot++; s=$1;
        if(s=="R") { r++; } else if(s=="S"||s=="D"||s=="I") { sl++; } else if(s=="T") { t++; } else if(s=="Z") { z++; }
    } END { print tot+0, r+0, sl+0, t+0, z+0; }' 2>/dev/null)

    while read -r name u s n i w x y z _; do
        if [[ "$name" == "cpu" ]]; then
            u2=$u; s2=$s; n2=$n; i2=$i; w2=$w; x2=$x; y2=$y; z2=$z
            break
        fi
    done < /proc/stat
    
    ud=$((u2 - u1)); sd=$((s2 - s1)); nd=$((n2 - n1)); id=$((i2 - i1))
    wd=$((w2 - w1)); xd=$((x2 - x1)); yd=$((y2 - y1)); zd=$((z2 - z1))
    cpu_pcts=$(awk -v ud=$ud -v sd=$sd -v nd=$nd -v id=$id -v wd=$wd -v xd=$xd -v yd=$yd -v zd=$zd 'BEGIN { tot = ud + sd + nd + id + wd + xd + yd + zd; if(tot == 0) { tot = 1; } printf "%.1f|%.1f|%.1f|%.1f|%.1f|%.1f|%.1f|%.1f|%.1f", 100*ud/tot, 100*sd/tot, 100*nd/tot, 100*id/tot, 100*wd/tot, 100*xd/tot, 100*yd/tot, 100*zd/tot, 100*(tot-id)/tot; }')
    IFS='|' read -r c_us c_sy c_ni c_id c_wa c_hi c_si c_st c_tot <<< "$cpu_pcts"
    u1=$u2; s1=$s2; n1=$n2; i1=$i2; w1=$w2; x1=$x2; y1=$y2; z1=$z2

    while read -r name value _; do
        case $name in
            MemTotal:) RAM_TOT=$((value/1024)) ;;
            MemFree:) RAM_FREE=$((value/1024)) ;;
            MemAvailable:) RAM_AVAIL=$((value/1024)) ;;
            Buffers:) RAM_BUFF_RAW=$value ;;
            Cached:) RAM_CACHE_RAW=$value ;;
            SwapTotal:) SWAP_TOT=$((value/1024)) ;;
            SwapFree:) SWAP_FREE=$((value/1024)) ;;
        esac
    done < /proc/meminfo
    RAM_BUFF=$(( (RAM_BUFF_RAW + RAM_CACHE_RAW) / 1024 ))
    RAM_USE=$(( RAM_TOT - RAM_FREE - RAM_BUFF ))
    SWAP_USE=$(( SWAP_TOT - SWAP_FREE ))
    [[ "$RAM_TOT" -eq 0 ]] && RAM_TOT=1; [[ "$SWAP_TOT" -eq 0 ]] && SWAP_TOT=1
    RAM_PCT=$(( RAM_USE * 100 / RAM_TOT ))
    SWAP_PCT=$(( SWAP_USE * 100 / SWAP_TOT ))

    read -r DB_CPU DB_RAM OC_CPU OC_RAM OLS_CPU OLS_RAM F2B_CPU F2B_RAM <<< $(ps -A -o comm,%cpu,rsz --no-headers 2>/dev/null | awk '
    {
        cmd=$1; cpu=$2; ram=$3
        if(cmd ~ /^(mysqld|mariadbd)$/) { db_c+=cpu; db_r+=ram }
        else if(cmd ~ /^(redis-server|valkey-server|keydb-server|memcached)$/) { oc_c+=cpu; oc_r+=ram }
        else if(cmd ~ /^(openlitespeed|litespeed|lshttpd)$/) { ols_c+=cpu; ols_r+=ram }
        else if(cmd ~ /^fail2ban-server$/) { f2b_c+=cpu; f2b_r+=ram }
    }
    END {
        printf "%.1f %.0f %.1f %.0f %.1f %.0f %.1f %.0f\n", db_c+0, db_r/1024, oc_c+0, oc_r/1024, ols_c+0, ols_r/1024, f2b_c+0, f2b_r/1024
    }')

    [[ -z "$DB_CPU" ]] && DB_CPU="0.0"; [[ -z "$DB_RAM" ]] && DB_RAM="0"
    [[ -z "$OC_CPU" ]] && OC_CPU="0.0"; [[ -z "$OC_RAM" ]] && OC_RAM="0"
    [[ -z "$OLS_CPU" ]] && OLS_CPU="0.0"; [[ -z "$OLS_RAM" ]] && OLS_RAM="0"
    [[ -z "$F2B_CPU" ]] && F2B_CPU="0.0"; [[ -z "$F2B_RAM" ]] && F2B_RAM="0"

    rx_now=0; tx_now=0
    while read -r iface rx _ _ _ _ _ _ _ tx _; do
        [[ "$iface" == *"Inter-"* || "$iface" == *"face"* || "$iface" == *"lo:"* ]] && continue
        rx_now=$((rx_now + rx)); tx_now=$((tx_now + tx))
    done </proc/net/dev
    rx_rate=$(((rx_now - rx_prev) / 1024 / DELAY_SEC))
    tx_rate=$(((tx_now - tx_prev) / 1024 / DELAY_SEC))
    rx_prev=$rx_now; tx_prev=$tx_now

    net_in_color="${C_RESET}"; [[ "$rx_rate" -gt 5120 ]] && net_in_color="${C_RED}"
    net_out_color="${C_RESET}"; [[ "$tx_rate" -gt 5120 ]] && net_out_color="${C_RED}"

    # --- RENDER HEADER ---
    BAR_LEN=20
    BUFFER+="wptt-top - $current_time ${C_CYAN}${LIVE_INDICATOR}${C_RESET} | Uptime: ${C_CYAN}$uptime_info${C_RESET} | Cores: ${C_CYAN}$CPU_CORES${C_RESET} | Users: $users_logged | Load: $load_avg${C_CLEAR_LINE}\n"
    
    if [[ $SHOW_CMD -eq 0 ]]; then
        BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Xem chi tiết Tiến trình | [${C_CYAN}M${C_RESET}] Soi lệnh MariaDB | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
    elif [[ $SHOW_CMD -eq 1 ]]; then
        BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Xem dạng Gộp Tiến trình | [${C_CYAN}M${C_RESET}] Soi lệnh MariaDB | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
    else
        BUFFER+="Phím tắt: [${C_YELLOW}C${C_RESET}] Quay lại xem Tiến trình | ${C_CYAN}Đang soi MariaDB (Real-time)${C_RESET} | [${C_RED}Q${C_RESET}] Thoát${C_CLEAR_LINE}\n"
    fi

    BUFFER+="Tasks: ${C_BOLD_WHITE}$tasks_total${C_RESET} total,   ${C_BOLD_WHITE}$tasks_running${C_RESET} running, ${C_BOLD_WHITE}$tasks_sleeping${C_RESET} sleeping,   ${C_BOLD_WHITE}$tasks_stopped${C_RESET} stopped,   ${C_BOLD_WHITE}$tasks_zombie${C_RESET} zombie${C_CLEAR_LINE}\n"
    
    BUFFER+="CPU $(draw_htop_bar "$c_tot" "$BAR_LEN" "$C_GREEN") %Cpu(s): ${C_BOLD_WHITE}${c_us}${C_RESET} us, ${C_BOLD_WHITE}${c_sy}${C_RESET} sy, ${C_BOLD_WHITE}${c_ni}${C_RESET} ni, ${C_BOLD_WHITE}${c_id}${C_RESET} id, ${C_BOLD_WHITE}${c_wa}${C_RESET} wa, ${C_BOLD_WHITE}${c_hi}${C_RESET} hi, ${C_BOLD_WHITE}${c_si}${C_RESET} si, ${C_BOLD_WHITE}${c_st}${C_RESET} st${C_CLEAR_LINE}\n"
    BUFFER+="Mem $(draw_htop_bar "$RAM_PCT" "$BAR_LEN" "$C_CYAN") MiB Mem: ${C_BOLD_WHITE}$(printf "%7s" "$RAM_TOT")${C_RESET} total, ${C_BOLD_WHITE}$(printf "%7s" "$RAM_FREE")${C_RESET} free, ${C_BOLD_WHITE}$(printf "%7s" $RAM_USE)${C_RESET} used, ${C_BOLD_WHITE}$(printf "%7s" $RAM_BUFF)${C_RESET} buff/cache${C_CLEAR_LINE}\n"
    BUFFER+="Swp $(draw_htop_bar "$SWAP_PCT" "$BAR_LEN" "$C_RED") MiB Swp: ${C_BOLD_WHITE}$(printf "%7s" "$SWAP_TOT")${C_RESET} total, ${C_BOLD_WHITE}$(printf "%7s" "$SWAP_FREE")${C_RESET} free, ${C_BOLD_WHITE}$(printf "%7s" $SWAP_USE)${C_RESET} used. ${C_BOLD_WHITE}$(printf "%7s" "$RAM_AVAIL")${C_RESET} avail Mem${C_CLEAR_LINE}\n"
    
    BUFFER+="MariaDB  : ${C_BOLD_WHITE}$(printf "%5s" "$DB_CPU")${C_RESET}% CPU, ${C_BOLD_WHITE}$(printf "%6s" "$DB_RAM")${C_RESET} MiB | ObjCache : ${C_BOLD_WHITE}$(printf "%5s" "$OC_CPU")${C_RESET}% CPU, ${C_BOLD_WHITE}$(printf "%6s" "$OC_RAM")${C_RESET} MiB${C_CLEAR_LINE}\n"
    BUFFER+="LiteSpeed: ${C_BOLD_WHITE}$(printf "%5s" "$OLS_CPU")${C_RESET}% CPU, ${C_BOLD_WHITE}$(printf "%6s" "$OLS_RAM")${C_RESET} MiB | Fail2Ban : ${C_BOLD_WHITE}$(printf "%5s" "$F2B_CPU")${C_RESET}% CPU, ${C_BOLD_WHITE}$(printf "%6s" "$F2B_RAM")${C_RESET} MiB${C_CLEAR_LINE}\n"
    BUFFER+="Network  : In ${net_in_color}${rx_rate} KB/s${C_RESET}, Out ${net_out_color}${tx_rate} KB/s${C_RESET}${C_CLEAR_LINE}\n\n"
    
    # -------------------------------------------------------------------------
    # GIẢI QUYẾT LỖI MẤT DÒNG ĐẦU TIÊN: GIẢM MAX_ROWS ĐỂ LÀM ĐỆM AN TOÀN
    # -------------------------------------------------------------------------
    TERM_LINES=$(tput lines)
    TERM_COLS=$(tput cols)
    MAX_ROWS=$((TERM_LINES - 13)) # Đã đổi từ 12 thành 13
    [[ $MAX_ROWS -lt 5 ]] && MAX_ROWS=5
    ROW_COUNT=0

    BUFFER+="\033[7m"
    
    # -------------------------------------------------------------------------
    # RENDER BẢNG
    # -------------------------------------------------------------------------
    if [[ $SHOW_CMD -eq 0 ]]; then
        PS_DATA=$(ps -ww -eo pid,uid,rsz,s,comm,cmd --no-headers 2>/dev/null | grep -E -i "(lsphp|lshttpd|openlitespeed|litespeed)" | awk -v mode=0 -v sys_hz="$SYS_HZ" -v delay="$DELAY_SEC" -v known_uids="$KNOWN_UIDS" '
        BEGIN {
            tick_file = "/tmp/.wptt_top_ticks";
            while ( (getline < tick_file) > 0 ) { if ($1 != "") { prev_ticks[$1] = $2; } }
            close(tick_file);
            
            n = split(known_uids, ku, " ");
            for(i=1; i<=n; i++) {
                if(ku[i] != "") { count[ku[i]] = 0; total_cpu[ku[i]] = 0; total_ram[ku[i]] = 0; active[ku[i]] = 0; active_from_cpu[ku[i]] = 0; }
            }
        }
        {
            if ($0 ~ /grep -E -i/) { next; }
            
            pid=$1; uid=$2; ram=$3/1024; state=$4; comm=$5;
            if (uid == 0 || comm !~ /^(lsphp|lshttpd|openlitespeed|litespeed)$/) { next; }
            
            ticks = 0;
            stat_file = "/proc/" pid "/stat";
            if ( (getline stat_line < stat_file) > 0 ) {
                idx = index(stat_line, ") ");
                if (idx > 0) {
                    substr_stat = substr(stat_line, idx + 2);
                    split(substr_stat, stat_arr, " ");
                    ticks = stat_arr[12] + stat_arr[13];
                }
            }
            close(stat_file);
            
            current_ticks[pid] = ticks;
            diff = (pid in prev_ticks) ? (ticks - prev_ticks[pid]) : 0;
            if (diff < 0) { diff = 0; }
            real_cpu = (diff * 100.0) / (sys_hz * delay);
            
            count[uid]++;
            total_ram[uid] += ram;
            total_cpu[uid] += real_cpu;
            if (state == "R" || state == "D") { active[uid]++; }
            else if (real_cpu >= 0.5) { active_from_cpu[uid] += int(real_cpu / 40) + 1; }
        }
        END {
            out_file = "/tmp/.wptt_top_ticks_new";
            for (p in current_ticks) { print p, current_ticks[p] > out_file; }
            close(out_file);
            system("mv " out_file " " tick_file " 2>/dev/null");
            
            for (u in count) {
                act = active[u] + active_from_cpu[u];
                if (act > count[u]) { act = count[u]; }
                printf "%s|%d|%d|%.1f|%.1f\n", u, count[u], act, total_cpu[u], total_ram[u];
            }
        }' 2>/dev/null | sort -t'|' -k4,4nr -k2,2nr -k1,1)
        
        printf -v row_header " %-30s | %-24s | %-10s | %-15s " "WEBSITE (DOMAIN)" "PROCESS (Active / Total)" "%CPU" "MEM (MiB)"
        BUFFER+="${row_header}\033[0m${C_CLEAR_LINE}\n"

        if [[ -z "$PS_DATA" ]]; then
            BUFFER+="  ${C_YELLOW}Hệ thống nhàn rỗi. Không có tiến trình Web/Cache nào đang hoạt động.${C_RESET}${C_CLEAR_LINE}\n"
        else
            while IFS='|' read -r uid proc_tot proc_act cpu ram; do
                [[ -z "$uid" ]] && continue
                
                user="${SYS_UIDS["$uid"]}"; [[ -z "$user" ]] && user="$uid"

                if [[ $ROW_COUNT -lt $MAX_ROWS ]]; then
                    domain_display="${MAP_USER_DOMAIN["$user"]}"; [[ -z "$domain_display" ]] && domain_display="$user"
                    if [[ "$user" == "nobody" ]]; then domain_display="nobody (LSCache Worker)"; fi
                    [[ ${#domain_display} -gt 29 ]] && domain_display="${domain_display:0:26}..."
                    
                    cpu_disp=$(printf "%.1f" "$cpu" 2>/dev/null || echo "0.0")
                    cpu_int=${cpu_disp%.*}; cpu_color="${C_RESET}"
                    [[ -n "$cpu_int" && "$cpu_int" -ge 80 ]] && cpu_color="${C_RED}" || { [[ -n "$cpu_int" && "$cpu_int" -ge 40 ]] && cpu_color="${C_YELLOW}"; }
                    
                    ram_mb=$(printf "%.1f" "$ram" 2>/dev/null || echo "0.0")
                    ram_int=${ram_mb%.*}; ram_color="${C_RESET}"
                    [[ -n "$ram_int" && "$ram_int" -ge 1024 ]] && ram_color="${C_RED}" || { [[ -n "$ram_int" && "$ram_int" -ge 500 ]] && ram_color="${C_YELLOW}"; }
                    
                    act_color="${C_BOLD_WHITE}"
                    if [[ "$proc_act" -gt 0 ]]; then
                        if [[ "$proc_act" -eq "$proc_tot" ]]; then act_color="${C_RED}"; else act_color="${C_GREEN}"; fi
                    fi

                    plain_lsphp="${proc_act} Active / ${proc_tot} Total"
                    pad_len=$(( 24 - ${#plain_lsphp} ))
                    [[ $pad_len -lt 0 ]] && pad_len=0
                    padding=$(printf "%*s" $pad_len "")
                    colored_lsphp="${act_color}${proc_act} Active${C_RESET} / ${C_CYAN}${proc_tot} Total${C_RESET}${padding}"
                    
                    printf -v row_buf " %-30s | %b | %b%-10s%b | %b%-15s%b${C_CLEAR_LINE}" "$domain_display" "$colored_lsphp" "$cpu_color" "$cpu_disp" "${C_RESET}" "$ram_color" "$ram_mb" "${C_RESET}"
                    BUFFER+="${row_buf}\n"
                    ((ROW_COUNT++))
                fi
            done <<< "$PS_DATA"
        fi

    elif [[ $SHOW_CMD -eq 1 ]]; then
        PS_DATA=$(ps -ww -eo pid,uid,rsz,s,comm,cmd --no-headers 2>/dev/null | grep -E -i "(lsphp|lshttpd|openlitespeed|litespeed)" | awk -v mode=1 -v sys_hz="$SYS_HZ" -v delay="$DELAY_SEC" '
        BEGIN {
            tick_file = "/tmp/.wptt_top_ticks";
            while ( (getline < tick_file) > 0 ) { if ($1 != "") { prev_ticks[$1] = $2; } }
            close(tick_file);
        }
        {
            if ($0 ~ /grep -E -i/) { next; }
            
            pid=$1; uid=$2; ram=$3/1024; state=$4; comm=$5;
            if (uid == 0 || comm !~ /^(lsphp|lshttpd|openlitespeed|litespeed)$/) { next; }
            
            orig_args="";
            for(i=6; i<=NF; i++) { orig_args = orig_args (i==6?"":" ") $i; }
            
            ticks = 0; cputime = "0:00.00";
            stat_file = "/proc/" pid "/stat";
            if ( (getline stat_line < stat_file) > 0 ) {
                idx = index(stat_line, ") ");
                if (idx > 0) {
                    substr_stat = substr(stat_line, idx + 2);
                    split(substr_stat, stat_arr, " ");
                    ticks = stat_arr[12] + stat_arr[13];
                    
                    total_cents = int((ticks * 100) / sys_hz);
                    sec = int(total_cents / 100); cen = total_cents % 100;
                    min = int(sec / 60); sec = sec % 60;
                    cputime = sprintf("%d:%02d.%02d", min, sec, cen);
                }
            }
            close(stat_file);
            
            current_ticks[pid] = ticks;
            diff = (pid in prev_ticks) ? (ticks - prev_ticks[pid]) : 0;
            if (diff < 0) { diff = 0; }
            real_cpu = (diff * 100.0) / (sys_hz * delay);
            
            print pid"|"uid"|"real_cpu"|"ram"|"state"|"cputime"|"orig_args;
        }
        END {
            out_file = "/tmp/.wptt_top_ticks_new";
            for (p in current_ticks) { print p, current_ticks[p] > out_file; }
            close(out_file);
            system("mv " out_file " " tick_file " 2>/dev/null");
        }' 2>/dev/null | sort -t'|' -k3 -nr)

        CMD_WIDTH=$((TERM_COLS - 74))
        [[ $CMD_WIDTH -lt 20 ]] && CMD_WIDTH=20
        
        printf -v row_header " %-7s | %-16s | %-5s | %-8s | %-4s | %9s | %-s " "PID" "WEBSITE" "%CPU" "MEM(MiB)" "STAT" "TIME+" "COMMAND"
        BUFFER+="${row_header}\033[0m${C_CLEAR_LINE}\n"

        if [[ -z "$PS_DATA" ]]; then
            BUFFER+="  ${C_YELLOW}Hệ thống nhàn rỗi. Không có tiến trình Web/Cache nào đang hoạt động.${C_RESET}${C_CLEAR_LINE}\n"
        else
            while IFS='|' read -r pid uid cpu ram stat cputime orig_args; do
                [[ -z "$pid" ]] && continue
                
                user="${SYS_UIDS["$uid"]}"; [[ -z "$user" ]] && user="$uid"

                if [[ $ROW_COUNT -lt $MAX_ROWS ]]; then
                    domain_display="${MAP_USER_DOMAIN["$user"]}"; [[ -z "$domain_display" ]] && domain_display="$user"
                    if [[ "$user" == "nobody" ]]; then domain_display="nobody (LSCache)"; fi
                    [[ ${#domain_display} -gt 15 ]] && domain_display="${domain_display:0:12}..."
                    
                    cpu_disp=$(printf "%.1f" "$cpu" 2>/dev/null || echo "0.0")
                    cpu_int=${cpu_disp%.*}; cpu_color="${C_RESET}"
                    [[ -n "$cpu_int" && "$cpu_int" -ge 80 ]] && cpu_color="${C_RED}" || { [[ -n "$cpu_int" && "$cpu_int" -ge 40 ]] && cpu_color="${C_YELLOW}"; }
                    
                    ram_mb=$(printf "%.1f" "$ram" 2>/dev/null || echo "0.0")
                    ram_int=${ram_mb%.*}; ram_color="${C_RESET}"
                    [[ -n "$ram_int" && "$ram_int" -ge 1024 ]] && ram_color="${C_RED}" || { [[ -n "$ram_int" && "$ram_int" -ge 500 ]] && ram_color="${C_YELLOW}"; }
                    
                    stat_color="${C_CYAN}"
                    [[ "$stat" == "R" || "$stat" == "D" ]] && stat_color="${C_GREEN}"
                    [[ "$stat" == "Z" ]] && stat_color="${C_RED}"
                    [[ "$stat" == "T" ]] && stat_color="${C_YELLOW}"

                    args=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                    if [[ "$args" != lsphp:* ]]; then
                        args="$orig_args"
                    fi

                    if [[ ${#args} -gt $CMD_WIDTH ]]; then 
                        args="${args:0:$((CMD_WIDTH - 3))}..."
                    fi

                    if [[ "$args" == lsphp:* ]]; then
                        args="${C_YELLOW}lsphp:${C_RESET}${C_BOLD_WHITE}${args#lsphp:}${C_RESET}"
                    elif [[ "$args" == "lsphp" || "$args" == *"lsphp (idle)"* ]]; then
                        args="${C_YELLOW}lsphp${C_RESET} (idle)"
                    elif [[ "$args" == *"openlitespeed"* || "$args" == *"lshttpd"* || "$args" == *"litespeed"* ]]; then
                        args="${C_GREEN}${args}${C_RESET} (Worker)"
                    fi
                    
                    printf -v row_buf " %b%-7s%b | %-16s | %b%-5s%b | %b%-8s%b | %b%-4s%b | %9s | %-s${C_CLEAR_LINE}" \
                        "${C_YELLOW}" "$pid" "${C_RESET}" \
                        "$domain_display" \
                        "$cpu_color" "$cpu_disp" "${C_RESET}" \
                        "$ram_color" "$ram_mb" "${C_RESET}" \
                        "$stat_color" "$stat" "${C_RESET}" \
                        "$cputime" \
                        "$args"
                    BUFFER+="${row_buf}\n"
                    ((ROW_COUNT++))
                fi
            done <<< "$PS_DATA"
        fi

    elif [[ $SHOW_CMD -eq 2 ]]; then
        # Đã bóp lại - 77 để chống lố viền 1 ký tự trên terminal 80 cột
        CMD_WIDTH=$((TERM_COLS - 77))
        [[ $CMD_WIDTH -lt 20 ]] && CMD_WIDTH=20
        
        printf -v row_header " %-8s | %-26s | %-22s | %-7s | %-s " "QUERY_ID" "DB_USER" "DB_NAME" "TIME(s)" "INFO (COMMAND / QUERY)"
        BUFFER+="${row_header}\033[0m${C_CLEAR_LINE}\n"

        DB_DATA=$(mariadb --defaults-extra-file="$TEMP_CNF_root" -e "SHOW FULL PROCESSLIST" 2>/dev/null | awk -F'\t' 'NR>1 {
            id=$1; user=$2; host=$3; db=$4; cmd=$5; time=$6; state=$7; info=$8;
            
            if(info == "SHOW FULL PROCESSLIST") { next; }
            if(db == "NULL") { db="-"; }
            if(info == "NULL" || info == "") { info="["cmd"]"; }
            
            weight = (cmd == "Sleep") ? 2 : 1;
            print weight"|"id"|"user"|"db"|"time"|"info;
        }' | sort -t'|' -k1,1n -k5,5nr)

        if [[ -z "$DB_DATA" ]]; then
            BUFFER+="  ${C_GREEN}Không có kết nối (Connection) nào tới Database vào lúc này.${C_RESET}${C_CLEAR_LINE}\n"
        else
            while IFS='|' read -r weight db_id db_user db_name db_time db_info; do
                [[ -z "$db_id" ]] && continue
                if [[ $ROW_COUNT -lt $MAX_ROWS ]]; then
                    [[ ${#db_user} -gt 25 ]] && db_user="${db_user:0:22}..."
                    [[ ${#db_name} -gt 21 ]] && db_name="${db_name:0:18}..."
                    
                    db_info=$(echo "$db_info" | tr -d '\r\n')
                    [[ ${#db_info} -gt $CMD_WIDTH ]] && db_info="${db_info:0:$((CMD_WIDTH - 3))}..."
                    
                    if [[ "$weight" == "2" ]]; then
                        time_color="${C_CYAN}"; info_color="${C_CYAN}"
                    else
                        time_color="${C_GREEN}"
                        [[ "$db_time" -ge 5 ]] && time_color="${C_YELLOW}"
                        [[ "$db_time" -ge 15 ]] && time_color="${C_RED}"
                        info_color="${C_RESET}"
                    fi
                    
                    printf -v row_buf " %b%-8s%b | %-26s | %-22s | %b%-7s%b | %b%-s%b${C_CLEAR_LINE}" \
                        "${C_YELLOW}" "$db_id" "${C_RESET}" "$db_user" "$db_name" \
                        "$time_color" "$db_time" "${C_RESET}" "$info_color" "$db_info" "${C_RESET}"
                    BUFFER+="${row_buf}\n"
                    ((ROW_COUNT++))
                fi
            done <<< "$DB_DATA"
        fi
    fi

    # -------------------------------------------------------------------------
    # ÉP CẮT BỎ KÝ TỰ \n Ở DÒNG CUỐI CÙNG ĐỂ CHỐNG LỖI TERMINAL SCROLLING
    # -------------------------------------------------------------------------
    tput cup 0 0
    echo -ne "${BUFFER%\\n}"
    tput ed

    read -t $DELAY_SEC -n 1 -s key
    if [[ "$key" == "c" || "$key" == "C" ]]; then
        [[ $SHOW_CMD -eq 0 ]] && SHOW_CMD=1 || SHOW_CMD=0
        clear
    elif [[ "$key" == "m" || "$key" == "M" ]]; then
        SHOW_CMD=2
        clear
    elif [[ "$key" == "q" || "$key" == "Q" ]]; then
        cleanup
    fi
done

if [[ "$START_ARG" == "98" ]]; then
  exec /etc/wptt/wptt-tai-nguyen-main 1
fi
