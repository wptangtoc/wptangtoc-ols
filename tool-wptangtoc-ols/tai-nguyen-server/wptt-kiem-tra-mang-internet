preflight_check() {
  local task_pre="Kiểm tra công cụ mạng và khởi tạo bộ đệm đo lường"
  _runing "$task_pre"

  if ! command -v curl >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    _runloi "$task_pre"
    printf '%b\n' "${C_RED:-}Lỗi: Hệ thống thiếu công cụ 'curl' hoặc 'awk' để thực hiện kiểm tra mạng!${C_RESET:-}"
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
  fi

  /bin/mkdir -p -m 700 /etc/wptt/tmp
  tmp_dir="$(/bin/mktemp -d /etc/wptt/tmp/wptt_net_XXXXXX)" || {
    _runloi "$task_pre"
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
  }

  local ram_mb=1024
  if declare -F wptt_get_ram_mb >/dev/null 2>&1; then
    ram_mb="$(wptt_get_ram_mb)"
  else
    local mem_kb=0
    mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || printf '1048576')"
    ram_mb=$(( mem_kb / 1024 ))
  fi

  local upload_mb=6
  (( ram_mb <= 512 )) && upload_mb=3
  (( ram_mb >= 2048 )) && upload_mb=8

  payload_file="${tmp_dir}/upload_payload.bin"
  if ! dd if=/dev/zero of="$payload_file" bs=1M count="$upload_mb" status=none 2>/dev/null; then
    _runloi "$task_pre"
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
  fi
  /bin/chmod 600 -- "$payload_file"

  _rundone "$task_pre"
}

gather_network_info() {
  local task_info="Thu thập thông tin định tuyến, IPv4/IPv6 và Nhà mạng (ISP)"
  _runing "$task_info"

  NET_IPV4="Không có"
  NET_IPV6="Không hỗ trợ"
  NET_ISP="Không xác định"
  NET_LOC="Không xác định"
  NET_COLO="N/A"
  NET_TCP_CC="unknown"

  if [[ -r /proc/sys/net/ipv4/tcp_congestion_control ]]; then
    read -r NET_TCP_CC < /proc/sys/net/ipv4/tcp_congestion_control || NET_TCP_CC="unknown"
  fi

  local cf_meta=""
  cf_meta="$(curl -4 -fsSL --connect-timeout 3 --max-time 5 "https://speed.cloudflare.com/meta" 2>/dev/null || true)"

  if [[ -n "$cf_meta" ]]; then
    NET_IPV4="$(printf '%s' "$cf_meta" | awk -F'"' '{for(i=1;i<=NF;i++) if($i=="clientIp") print $(i+2)}')"
    NET_ISP="$(printf '%s' "$cf_meta" | awk -F'"' '{for(i=1;i<=NF;i++) if($i=="asOrganization") print $(i+2)}')"
    local city country
    city="$(printf '%s' "$cf_meta" | awk -F'"' '{for(i=1;i<=NF;i++) if($i=="city") print $(i+2)}')"
    country="$(printf '%s' "$cf_meta" | awk -F'"' '{for(i=1;i<=NF;i++) if($i=="country") print $(i+2)}')"
    NET_COLO="$(printf '%s' "$cf_meta" | awk -F'"' '{for(i=1;i<=NF;i++) if($i=="colo") print $(i+2)}')"
    [[ -n "$city" || -n "$country" ]] && NET_LOC="${city:+$city, }${country}"
  fi

  if [[ -z "$NET_IPV4" || "$NET_IPV4" == "Không có" ]]; then
    local ipinfo_json=""
    ipinfo_json="$(curl -4 -fsSL --connect-timeout 3 --max-time 5 "https://ipinfo.io/json" 2>/dev/null || true)"
    if [[ -n "$ipinfo_json" ]]; then
      NET_IPV4="$(printf '%s' "$ipinfo_json" | awk -F'"' '/"ip":/ {print $4; exit}')"
      NET_ISP="$(printf '%s' "$ipinfo_json" | awk -F'"' '/"org":/ {print $4; exit}')"
      local city2 country2
      city2="$(printf '%s' "$ipinfo_json" | awk -F'"' '/"city":/ {print $4; exit}')"
      country2="$(printf '%s' "$ipinfo_json" | awk -F'"' '/"country":/ {print $4; exit}')"
      [[ -n "$city2" || -n "$country2" ]] && NET_LOC="${city2:+$city2, }${country2}"
    fi
  fi

  local v6_res=""
  v6_res="$(curl -6 -fsSL --connect-timeout 2 --max-time 3 "https://ipv6.icanhazip.com" 2>/dev/null || true)"
  v6_res="${v6_res//[[:space:]]/}"
  if [[ -n "$v6_res" ]]; then
    NET_IPV6="Đã kích hoạt ($v6_res)"
  fi

  if [[ -z "$NET_IPV4" || "$NET_IPV4" == "Không có" ]]; then
    if [[ "$NET_IPV6" == "Không hỗ trợ" ]]; then
      _runloi "$task_info"
      printf '%b\n' "${C_RED:-}Cảnh báo: Máy chủ không có kết nối Internet (Cả IPv4 và IPv6 đều mất kết nối)!${C_RESET:-}"
      wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
    fi
  fi

  _rundone "$task_info"
}

measure_ping_icmp() {
  local host="${1:?}"
  local ping_avg="--"

  if command -v ping >/dev/null 2>&1; then
    local ping_out=""
    ping_out="$(LC_ALL=C ping -4 -c 3 -i 0.2 -W 1 "$host" 2>/dev/null || true)"
    if [[ -n "$ping_out" ]]; then
      ping_avg="$(printf '%s\n' "$ping_out" | LC_ALL=C awk -F'/' '/^(rtt|round-trip)/ {printf "%.1f ms", $5}')"
    fi
  fi

  [[ -z "$ping_avg" ]] && ping_avg="--"
  printf '%s' "$ping_avg"
}

measure_tcp_latency() {
  local url="${1:?}"
  local tcp_ms="--"
  local raw_time=""

  raw_time="$(LC_ALL=C curl -4 -o /dev/null -s -w '%{time_connect}' --connect-timeout 3 --max-time 4 "$url" 2>/dev/null || true)"
  if [[ -n "$raw_time" ]]; then
    tcp_ms="$(LC_ALL=C awk -v t="$raw_time" 'BEGIN {
      ms = t * 1000;
      if (ms > 0.1 && ms < 3900) printf "%.1f ms", ms;
      else print "--";
    }')"
  fi

  printf '%s' "$tcp_ms"
}

measure_download_mbps() {
  local dl_url="${1:?}"
  local dl_res=""

  dl_res="$(LC_ALL=C nice -n 10 curl -4 -L -o /dev/null -s \
    -A "Mozilla/5.0 (X11; Linux x86_64) WPTangTocOLS-SpeedTest/2.0" \
    --range 0-26214399 \
    --connect-timeout 4 --max-time 8 \
    -w '%{speed_download}|%{size_download}' \
    "$dl_url" 2>/dev/null || true)"

  if [[ -z "$dl_res" ]]; then
    printf 'Nghẽn/Lỗi'
    return 0
  fi

  local speed_bps="${dl_res%%|*}"
  local size_bytes="${dl_res#*|}"

  LC_ALL=C awk -v spd="$speed_bps" -v sz="$size_bytes" 'BEGIN {
    if (sz < 65536 || spd <= 0) {
      print "Nghẽn/Lỗi";
    } else {
      mbps = (spd * 8) / 1000000;
      printf "%.2f Mbps", mbps;
    }
  }'
}

measure_upload_mbps() {
  local ul_url="${1:?}"
  local ul_res=""

  ul_res="$(LC_ALL=C nice -n 10 curl -4 -L -o /dev/null -s \
    -A "Mozilla/5.0 (X11; Linux x86_64) WPTangTocOLS-SpeedTest/2.0" \
    -H "Expect:" \
    -H "Content-Type: application/octet-stream" \
    --connect-timeout 4 --max-time 8 \
    -X POST --data-binary @"${payload_file:?}" \
    -w '%{speed_upload}|%{size_upload}|%{time_total}' \
    "$ul_url" 2>/dev/null || true)"

  if [[ -z "$ul_res" ]]; then
    printf 'Nghẽn/Lỗi'
    return 0
  fi

  local speed_bps="" rest="" size_bytes="" time_total=""
  speed_bps="${ul_res%%|*}"
  rest="${ul_res#*|}"
  size_bytes="${rest%%|*}"
  time_total="${rest#*|}"

  LC_ALL=C awk -v spd="$speed_bps" -v sz="$size_bytes" -v tm="$time_total" 'BEGIN {
    if (sz < 131072 || spd <= 0 || tm < 0.02) {
      print "Nghẽn/Lỗi";
    } else {
      mbps = (spd * 8) / 1000000;
      printf "%.2f Mbps", mbps;
    }
  }'
}

