# đồng thời giữ LC_NUMERIC=C để số thập phân luôn dùng dấu chấm (.)
unset LC_ALL
_utf8_locale="$(locale -a 2>/dev/null | grep -iE '^(C|en_US)\.utf-?8$' | head -n 1 || true)"
[[ -z "$_utf8_locale" ]] && _utf8_locale="$(locale -a 2>/dev/null | grep -iE '\.utf-?8$' | head -n 1 || true)"
