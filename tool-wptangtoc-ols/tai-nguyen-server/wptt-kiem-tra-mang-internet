# ==============================================================================
# THỰC THI ĐO LƯỜNG VÀ RENDER BẢNG KẾT QUẢ TRỰC TIẾP
# ==============================================================================
wptt_logs "INFO" "Thực thi kiểm tra tốc độ mạng Internet (Chế độ: $TEST_MODE)" 2>/dev/null || true

printf '\n'
_ui_table_top
_ui_table_row \
  "${C_BOLD_WHITE:-}Trạm Máy Chủ (Location)${C_RESET:-}" \
  "${C_YELLOW:-}Ping ICMP${C_RESET:-}" \
  "${C_YELLOW:-}Độ trễ TCP${C_RESET:-}" \
  "${C_GREEN:-}Download${C_RESET:-}" \
  "${C_CYAN:-}Upload${C_RESET:-}"
_ui_table_mid

printf '\033[?25l' 2>/dev/null || true

total_dl_sum="0"
total_ul_sum="0"
peak_dl="0"
peak_ul="0"
dl_count=0
ul_count=0

for node_entry in "${BENCH_NODES[@]}"; do
  IFS='|' read -r loc_name ping_host dl_url ul_url <<< "$node_entry"

  printf '\r\033[0K%b[*] Đang đo trạm: %s...%b' "${C_YELLOW:-}" "$loc_name" "${C_RESET:-}"

  ping_val="$(measure_ping_icmp "$ping_host")"
  tcp_val="$(measure_tcp_latency "$dl_url")"

  if [[ "$TEST_MODE" == "ping" ]]; then
    dl_val="Bỏ qua"
    ul_val="Bỏ qua"
  else
    dl_val="$(measure_download_mbps "$dl_url")"
    if [[ "$dl_val" == "Nghẽn/Lỗi" && "$dl_url" != *"speed.cloudflare.com"* ]]; then
      dl_val="$(measure_download_mbps "https://speed.cloudflare.com/__down?bytes=25000000")"
    fi

    ul_val="$(measure_upload_mbps "$ul_url")"
    if [[ "$ul_val" == "Nghẽn/Lỗi" && "$ul_url" != *"speed.cloudflare.com"* ]]; then
      ul_val="$(measure_upload_mbps "https://speed.cloudflare.com/__up")"
    fi
  fi

  if [[ "$dl_val" == *"Mbps"* ]]; then
    dl_num="${dl_val% Mbps}"
    total_dl_sum="$(LC_ALL=C awk -v a="$total_dl_sum" -v b="$dl_num" 'BEGIN {printf "%.2f", a + b}')"
    peak_dl="$(LC_ALL=C awk -v p="$peak_dl" -v b="$dl_num" 'BEGIN {print (b > p) ? b : p}')"
    ((dl_count += 1))
  fi

  if [[ "$ul_val" == *"Mbps"* ]]; then
    ul_num="${ul_val% Mbps}"
    total_ul_sum="$(LC_ALL=C awk -v a="$total_ul_sum" -v b="$ul_num" 'BEGIN {printf "%.2f", a + b}')"
    peak_ul="$(LC_ALL=C awk -v p="$peak_ul" -v b="$ul_num" 'BEGIN {print (b > p) ? b : p}')"
    ((ul_count += 1))
  fi

  dl_color="${C_GREEN:-}"
  [[ "$dl_val" == "Nghẽn/Lỗi" ]] && dl_color="${C_RED:-}"
  [[ "$dl_val" == "Bỏ qua" ]] && dl_color="${C_YELLOW:-}"

  ul_color="${C_CYAN:-}"
  [[ "$ul_val" == "Nghẽn/Lỗi" ]] && ul_color="${C_RED:-}"
  [[ "$ul_val" == "Bỏ qua" ]] && ul_color="${C_YELLOW:-}"

  printf '\r\033[0K'
  _ui_table_row \
    "$loc_name" \
    "${C_YELLOW:-}${ping_val}${C_RESET:-}" \
    "${C_BOLD_WHITE:-}${tcp_val}${C_RESET:-}" \
    "${dl_color}${dl_val}${C_RESET:-}" \
    "${ul_color}${ul_val}${C_RESET:-}"
done

printf '\033[?25h' 2>/dev/null || true
_ui_table_bot

# ==============================================================================
# TỔNG HỢP KẾT QUẢ & ĐÁNH GIÁ CHẤT LƯỢNG ĐƯỜNG TRUYỀN
# ==============================================================================
if [[ "$TEST_MODE" != "ping" ]]; then
  avg_dl="0.00"
  avg_ul="0.00"
  (( dl_count > 0 )) && avg_dl="$(LC_ALL=C awk -v s="$total_dl_sum" -v c="$dl_count" 'BEGIN {printf "%.2f", s / c}')"
  (( ul_count > 0 )) && avg_ul="$(LC_ALL=C awk -v s="$total_ul_sum" -v c="$ul_count" 'BEGIN {printf "%.2f", s / c}')"

  verdict="$(LC_ALL=C awk -v d="$avg_dl" -v u="$avg_ul" 'BEGIN {
    if (d >= 500 && u >= 300) print "Xuất sắc (Cổng mạng 1Gbps - 10Gbps tốc độ cao, tối ưu cho hệ thống lớn)";
    else if (d >= 150 && u >= 100) print "Tốt (Đường truyền ổn định, đáp ứng mượt mà cho WordPress & Cloud Backup)";
    else if (d >= 50) print "Trung bình (Đủ dùng cơ bản, nhưng tuyến quốc tế có dấu hiệu giới hạn)";
    else print "Yếu / Đang nghẽn băng thông quốc tế (Cần kiểm tra lại nhà cung cấp VPS)";
  }')"

  printf '\n'
  _ui_box_top
  _ui_box_center "${C_BOLD_WHITE:-}BÁO CÁO TỔNG KẾT HIỆU SUẤT MẠNG${C_RESET:-}"
  _ui_box_mid
  _ui_box_left "Download Trung bình / Đỉnh : ${C_GREEN:-}${avg_dl} Mbps${C_RESET:-} (Peak: ${C_BOLD_WHITE:-}${peak_dl} Mbps${C_RESET:-})"
  _ui_box_left "Upload Trung bình / Đỉnh   : ${C_CYAN:-}${avg_ul} Mbps${C_RESET:-} (Peak: ${C_BOLD_WHITE:-}${peak_ul} Mbps${C_RESET:-})"
  _ui_box_left "Đánh giá Đường truyền      : ${C_YELLOW:-}${verdict}${C_RESET:-}"
  _ui_box_bot
fi

wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0 "enter"
