# ==============================================================================
# BỘ DỰNG KHUNG UI CHUẨN UTF-8 (KHÔNG LỆCH VIỀN PHẢI VỚI TIẾNG VIỆT & MÃ MÀU)
# Tổng độ rộng trong lòng khung = 86 ký tự (Khớp 1:1 giữa Box và Bảng 5 cột:
# 22 + 1 + 15 + 1 + 15 + 1 + 16 + 1 + 14 = 86)
# ==============================================================================
readonly UI_BOX_WIDTH=86
readonly UI_LINE_86="──────────────────────────────────────────────────────────────────────────────────────"

_ui_pad_cell() {
  local raw_text="${1:-}"
  local target_width="${2:-30}"
  local rendered_text=""
  local clean_text=""
  local esc=$'\033'

  printf -v rendered_text '%b' "$raw_text"
  clean_text="${rendered_text//${esc}\[*([0-9;])[a-zA-Z]/}"

  local vis_len=${#clean_text}
  if (( vis_len > target_width )); then
    local cut_len=$(( target_width - 2 ))
    (( cut_len < 1 )) && cut_len=1
    printf '%s..' "${clean_text:0:$cut_len}"
    return 0
  fi

  local pad_len=$(( target_width - vis_len ))
  printf '%s%*s' "$rendered_text" "$pad_len" ""
}

_ui_box_top() {
  printf '%b╭%s╮%b\n' "${C_CYAN:-}" "$UI_LINE_86" "${C_RESET:-}"
}

_ui_box_mid() {
  printf '%b├%s┤%b\n' "${C_CYAN:-}" "$UI_LINE_86" "${C_RESET:-}"
}

_ui_box_bot() {
  printf '%b╰%s╯%b\n' "${C_CYAN:-}" "$UI_LINE_86" "${C_RESET:-}"
}

_ui_box_center() {
  local raw_text="${1:-}"
  local rendered_text=""
  local clean_text=""
  local esc=$'\033'

  printf -v rendered_text '%b' "$raw_text"
  clean_text="${rendered_text//${esc}\[*([0-9;])[a-zA-Z]/}"

  local vis_len=${#clean_text}
  local total_pad=$(( UI_BOX_WIDTH - vis_len ))
  (( total_pad < 0 )) && total_pad=0
  local left_pad=$(( total_pad / 2 ))
  local right_pad=$(( total_pad - left_pad ))

  printf '%b│%b%*s%s%*s%b│%b\n' \
    "${C_CYAN:-}" "${C_RESET:-}" \
    "$left_pad" "" "$rendered_text" "$right_pad" "" \
    "${C_CYAN:-}" "${C_RESET:-}"
}

_ui_box_left() {
  local raw_text="${1:-}"
  local cell_content=""
  cell_content="$(_ui_pad_cell "$raw_text" $(( UI_BOX_WIDTH - 2 )))"
  printf '%b│%b  %s%b│%b\n' "${C_CYAN:-}" "${C_RESET:-}" "$cell_content" "${C_CYAN:-}" "${C_RESET:-}"
}

_ui_table_top() {
  printf '%b╭──────────────────────┬───────────────┬───────────────┬────────────────┬──────────────╮%b\n' "${C_CYAN:-}" "${C_RESET:-}"
}

_ui_table_mid() {
  printf '%b├──────────────────────┼───────────────┼───────────────┼────────────────┼──────────────┤%b\n' "${C_CYAN:-}" "${C_RESET:-}"
}

_ui_table_bot() {
  printf '%b╰──────────────────────┴───────────────┴───────────────┴────────────────┴──────────────╯%b\n' "${C_CYAN:-}" "${C_RESET:-}"
}

_ui_table_row() {
  local c1 c2 c3 c4 c5
  c1="$(_ui_pad_cell "${1:-}" 20)"
  c2="$(_ui_pad_cell "${2:-}" 13)"
  c3="$(_ui_pad_cell "${3:-}" 13)"
  c4="$(_ui_pad_cell "${4:-}" 14)"
  c5="$(_ui_pad_cell "${5:-}" 12)"

  printf '%b│%b %s %b│%b %s %b│%b %s %b│%b %s %b│%b %s %b│%b\n' \
    "${C_CYAN:-}" "${C_RESET:-}" "$c1" \
    "${C_CYAN:-}" "${C_RESET:-}" "$c2" \
    "${C_CYAN:-}" "${C_RESET:-}" "$c3" \
    "${C_CYAN:-}" "${C_RESET:-}" "$c4" \
    "${C_CYAN:-}" "${C_RESET:-}" "$c5" \
    "${C_CYAN:-}" "${C_RESET:-}"
}

# ==============================================================================
# KHỞI TẠO KHÔNG GIAN TẠM & BẪY DỌN DẸP AN TOÀN (TRAP)
# ==============================================================================
tmp_dir=""

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP ERR
  printf '\033[?25h' 2>/dev/null || true

  if [[ -n "${tmp_dir:-}" && -d "$tmp_dir" ]]; then
    case "$tmp_dir" in
      /etc/wptt/tmp/wptt_disk_*)
        /bin/rm -rf -- "${tmp_dir:?}" 2>/dev/null || true
        ;;
    esac
  fi
  exit "$rc"
}

on_interrupt() {
  trap - EXIT INT TERM HUP ERR
  printf '\033[?25h\n' 2>/dev/null || true
  if [[ -n "${tmp_dir:-}" && -d "$tmp_dir" ]]; then
    case "$tmp_dir" in
      /etc/wptt/tmp/wptt_disk_*)
        /bin/rm -rf -- "${tmp_dir:?}" 2>/dev/null || true
        ;;
    esac
  fi
  printf '\n%b\n' "${C_YELLOW:-}Đã hủy tiến trình kiểm tra ổ cứng và dọn sạch file nháp an toàn.${C_RESET:-}"
  if declare -F wptt_quay_ve_menu >/dev/null 2>&1; then
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 130 "enter"
  fi
  exit 130
}

trap cleanup EXIT
trap on_interrupt INT TERM HUP

# ==============================================================================
# CÁC HÀM THU THẬP THÔNG TIN & CHUẨN BỊ MÔI TRƯỜNG (PREFLIGHT & AUTO-HEALING)
# ==============================================================================

gather_storage_profile() {
  local task_info="Phân tích cấu trúc phân vùng, Inodes và phần cứng lưu trữ"
  _runing "$task_info"

  DISK_DEV="Unknown"
  DISK_FS="ext4"
  DISK_TOTAL="0G"
  DISK_USED="0G"
  DISK_AVAIL="0G"
  DISK_PCT="0%"
  DISK_AVAIL_KB=0
  INODE_PCT="0%"
  INODE_USED="0"
  INODE_TOTAL="0"
  DISK_TYPE="Virtual Disk / SSD"
  DISK_SCHED="none"
  DISK_MOUNT_OPTS="defaults"

  # Đọc thông tin phân vùng chứa /usr/local (nơi đặt OpenLiteSpeed & WordPress)
  local target_check_path="/usr/local"
  [[ -d "$target_check_path" ]] || target_check_path="/"

  local df_line=""
  df_line="$(LC_ALL=C df -PT "$target_check_path" 2>/dev/null | awk 'NR==2 {print $1"|"$2"|"$3"|"$4"|"$5"|"$6"|"$7}')"
  if [[ -n "$df_line" ]]; then
    local mount_pt=""
    IFS='|' read -r DISK_DEV DISK_FS _ _ DISK_AVAIL_KB DISK_PCT mount_pt <<< "$df_line"
  fi

  local df_human=""
  df_human="$(LC_ALL=C df -Ph "$target_check_path" 2>/dev/null | awk 'NR==2 {print $2"|"$3"|"$4}')"
  if [[ -n "$df_human" ]]; then
    IFS='|' read -r DISK_TOTAL DISK_USED DISK_AVAIL <<< "$df_human"
  fi

  local df_inode=""
  df_inode="$(LC_ALL=C df -Pi "$target_check_path" 2>/dev/null | awk 'NR==2 {print $2"|"$3"|"$5}')"
  if [[ -n "$df_inode" ]]; then
    IFS='|' read -r INODE_TOTAL INODE_USED INODE_PCT <<< "$df_inode"
  fi

  # Trích xuất cờ mount (noatime, fast_commit...) từ /proc/mounts
  DISK_MOUNT_OPTS="$(awk -v dev="$DISK_DEV" '$1 == dev || $2 == "/" {print $4; exit}' /proc/mounts 2>/dev/null || printf 'defaults')"

  # Nhận diện thiết bị khối vật lý (vda, sda, nvme0n1...) trong /sys/block
  local base_dev="${DISK_DEV##*/}"
  base_dev="${base_dev%%[0-9]*}"
  # [[ "$ DISK_DEV" == *"nvme"* ]] && base_dev="$(printf '%s' "${DISK_DEV##*/}" | sed -E 's/p[0-9]+$//')"
	[[ "$DISK_DEV" == *nvme* ]] && base_dev="$(printf '%s' "${DISK_DEV##*/}" | sed -E 's/p[0-9]+$//')"

  if [[ -z "$base_dev" || ! -d "/sys/block/$base_dev" ]]; then
    for blk in /sys/block/nvme* /sys/block/vd* /sys/block/sd* /sys/block/xvd* /sys/block/mmcblk*; do
      if [[ -d "$blk" ]]; then
        base_dev="${blk##*/}"
        break
      fi
    done
  fi

  if [[ -n "$base_dev" && -d "/sys/block/$base_dev" ]]; then
    local rota="0"
    [[ -r "/sys/block/$base_dev/queue/rotational" ]] && read -r rota < "/sys/block/$base_dev/queue/rotational"
    local model=""
    if [[ -r "/sys/block/$base_dev/device/model" ]]; then
      read -r model < "/sys/block/$base_dev/device/model" || true
      model="${model//+([[:space:]])/ }"
    fi


		local virt="none"
		if command -v systemd-detect-virt >/dev/null 2>&1; then
			virt="$(systemd-detect-virt 2>/dev/null || true)"
			[[ -z "$virt" ]] && virt="none"
		fi

		if [[ "$base_dev" == nvme* ]]; then
			DISK_TYPE="NVMe SSD (${model:-PCIe High-Speed})"
		elif [[ "$rota" == "0" ]]; then
			DISK_TYPE="Solid State Drive - SSD (${model:-Virtual/SATA})"
		elif [[ "$virt" != "none" || "$base_dev" == vd* || "$base_dev" == xvd* ]]; then
			# VirtIO/Xen thường báo rotational=1 dù phần cứng nền là SSD/NVMe
			DISK_TYPE="Virtual Disk ${virt^^} (${model:-VirtIO}) - xem IOPS để biết loại thật"
		else
			DISK_TYPE="Hard Disk Drive - HDD (${model:-SATA})"
		fi

    # if [[ "$base_dev" == nvme* ]]; then
    #   DISK_TYPE="NVMe SSD (${model:-PCIe High-Speed})"
    # elif [[ "$rota" == "0" ]]; then
    #   DISK_TYPE="Solid State Drive - SSD (${model:-Virtual/SATA})"
    # else
    #   DISK_TYPE="Hard Disk Drive - (${model:-VirtIO})"
    # fi

    if [[ -r "/sys/block/$base_dev/queue/scheduler" ]]; then
      local raw_sched=""
      read -r raw_sched < "/sys/block/$base_dev/queue/scheduler" || true
      if [[ "$raw_sched" =~ \[([a-zA-Z0-9_-]+)\] ]]; then
        DISK_SCHED="${BASH_REMATCH[1]}"
      else
        DISK_SCHED="$raw_sched"
      fi
    fi
  fi

  _rundone "$task_info"
}

preflight_and_engine_setup() {
  local task_pre="Kiểm tra dung lượng trống và chuẩn bị công cụ đo I/O"
  _runing "$task_pre"

  /bin/mkdir -p -m 700 /etc/wptt/tmp

  # Kiểm tra dung lượng trống tại /etc/wptt/tmp
  local free_kb=0
  free_kb="$(LC_ALL=C df -Pk /etc/wptt/tmp 2>/dev/null | awk 'NR==2 {print $4}' || printf '0')"

  # Tự động chọn kích thước file test an toàn theo dung lượng trống và RAM
  BENCH_SIZE_MB=256
  if (( free_kb < 409600 )); then
    _runloi "$task_pre"
    printf '\n%b\n' "${C_RED:-}Cảnh báo an toàn: Ổ cứng còn trống dưới 400MB (Hiện tại: $((free_kb / 1024))MB)!${C_RESET:-}"
    printf '%b\n' "${C_YELLOW:-}Hệ thống từ chối ghi file benchmark để tránh làm đầy 100% ổ cứng gây sập MariaDB.${C_RESET:-}"
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
  elif (( free_kb < 1048576 )); then
    BENCH_SIZE_MB=128
  fi

  tmp_dir="$(/bin/mktemp -d /etc/wptt/tmp/wptt_disk_XXXXXX)" || {
    _runloi "$task_pre"
    wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 1 "enter"
  }

  # Auto-Healing: Ưu tiên dùng fio chính thống từ OS Repository (Không tải binary trôi nổi)
  BENCH_ENGINE="dd"
  if command -v fio >/dev/null 2>&1; then
    BENCH_ENGINE="fio"
  else
    local os_fam=""
    if declare -F wptt_get_os_family >/dev/null 2>&1; then
      os_fam="$(wptt_get_os_family)"
    elif [[ -f /etc/debian_version ]]; then
      os_fam="debian"
    else
      os_fam="rhel"
    fi

    if [[ "$os_fam" == "debian" ]] && command -v apt-get >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fio >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null 2>&1; then
      dnf install -y -q fio >/dev/null 2>&1 || true
    elif command -v yum >/dev/null 2>&1; then
      yum install -y -q fio >/dev/null 2>&1 || true
    fi

    if command -v fio >/dev/null 2>&1; then
      BENCH_ENGINE="fio"
    fi
  fi

  _rundone "$task_pre"
}

# ==============================================================================
# HÀM ĐỊNH DẠNG ĐƠN VỊ (KB/s -> MB/s, GB/s | IOPS -> k | Latency -> µs, ms)
# ==============================================================================

format_bw_speed() {
  local raw_kbps="${1:-0}"
  LC_ALL=C awk -v kb="$raw_kbps" 'BEGIN {
    if (kb <= 0) { print "0.00 MB/s"; }
    else if (kb >= 1048576) { printf "%.2f GB/s", kb / 1048576; }
    else if (kb >= 1024) { printf "%.2f MB/s", kb / 1024; }
    else { printf "%.1f KB/s", kb; }
  }'
}

format_iops_val() {
  local raw_iops="${1:-0}"
  LC_ALL=C awk -v io="$raw_iops" 'BEGIN {
    if (io <= 0) { print "0"; }
    else if (io >= 1000) { printf "%.1fk", io / 1000; }
    else { printf "%.0f", io; }
  }'
}

format_lat_val() {
  local raw_us="${1:-0}"
  LC_ALL=C awk -v us="$raw_us" 'BEGIN {
    if (us <= 0) { print "--"; }
    else if (us >= 1000) { printf "%.2f ms", us / 1000; }
    else { printf "%.0f us", us; }
  }'
}

# Thực thi 1 bài test FIO với block size chỉ định (Trả về: r_bw|w_bw|t_bw|t_iops|avg_lat_us)
run_fio_block_test() {
  local bs="${1:?}"
  local size_mb="${2:-256}"
  local runtime="${3:-5}"
  local test_file="${tmp_dir}/bench_${bs}.fio"

  # Tự động kiểm tra xem filesystem có hỗ trợ direct=1 không (tránh lỗi trên ZFS/tmpfs/OpenVZ)
  local direct_flag=1
  if ! fio --name=check_direct --filename="$test_file" --rw=read --bs=4k --size=1m --direct=1 --runtime=1 --minimal >/dev/null 2>&1; then
    direct_flag=0
  fi

  local io_engine="libaio"
  local iodepth=32
  [[ "$bs" == "1m" || "$bs" == "512k" ]] && iodepth=16

  local fio_out=""
  fio_out="$(LC_ALL=C ionice -c 3 nice -n 19 timeout 25 fio \
    --name="wptt_${bs}" \
    --filename="$test_file" \
    --ioengine="$io_engine" \
    --rw=randrw \
    --rwmixread=50 \
    --bs="$bs" \
    --iodepth="$iodepth" \
    --numjobs=1 \
    --size="${size_mb}m" \
    --runtime="$runtime" \
    --time_based \
    --gtod_reduce=0 \
    --direct="$direct_flag" \
    --group_reporting \
    --minimal 2>/dev/null | grep "wptt_${bs}" || true)"

  # Nếu libaio không được kernel hỗ trợ, fallback ngay về psync
  if [[ -z "$fio_out" ]]; then
    fio_out="$(LC_ALL=C ionice -c 3 nice -n 19 timeout 25 fio \
      --name="wptt_${bs}" \
      --filename="$test_file" \
      --ioengine=psync \
      --rw=randrw \
      --rwmixread=50 \
      --bs="$bs" \
      --size="${size_mb}m" \
      --runtime="$runtime" \
      --time_based \
      --direct="$direct_flag" \
      --group_reporting \
      --minimal 2>/dev/null | grep "wptt_${bs}" || true)"
  fi

  /bin/rm -f -- "$test_file" 2>/dev/null || true

  if [[ -z "$fio_out" ]]; then
    printf '0|0|0|0|0'
    return 0
  fi

  # Trong định dạng --minimal của fio (terse version 3):
  # $7 = Read BW (KB/s), $8 = Read IOPS, $16 = Read lat mean (us)
  # $48 = Write BW (KB/s), $49 = Write IOPS, $57 = Write lat mean (us)
  printf '%s\n' "$fio_out" | LC_ALL=C awk -F';' '{
    r_bw = $7 + 0;
    r_iops = $8 + 0;
    r_lat = $16 + 0;
    w_bw = $48 + 0;
    w_iops = $49 + 0;
    w_lat = $57 + 0;
    t_bw = r_bw + w_bw;
    t_iops = r_iops + w_iops;
    avg_lat = (r_lat > 0 && w_lat > 0) ? ((r_lat + w_lat) / 2) : (r_lat + w_lat);
    printf "%.2f|%.2f|%.2f|%.0f|%.1f", r_bw, w_bw, t_bw, t_iops, avg_lat;
  }'
}

# Chế độ dự phòng bằng dd (Graceful Degradation khi máy chủ không có/không cài được fio)
run_dd_fallback_test() {
  local label="${1:?}"
  local bs="${2:?}"
  local count="${3:?}"
  local test_file="${tmp_dir}/dd_bench.bin"

  # 1. Đo tốc độ Ghi (Write) với cờ fdatasync/direct
  local t_start t_end w_kbps=0 r_kbps=0
  t_start="$(LC_ALL=C awk '{print $1}' /proc/uptime)"
  if ! LC_ALL=C ionice -c 3 nice -n 19 dd if=/dev/zero of="$test_file" bs="$bs" count="$count" oflag=direct conv=fdatasync status=none 2>/dev/null; then
    LC_ALL=C ionice -c 3 nice -n 19 dd if=/dev/zero of="$test_file" bs="$bs" count="$count" conv=fdatasync status=none 2>/dev/null || true
  fi
  t_end="$(LC_ALL=C awk '{print $1}' /proc/uptime)"

  local total_kb=$(( ( ${bs%[kKmM]} * count ) ))
  [[ "$bs" == *[mM] ]] && total_kb=$(( ${bs%[mM]} * 1024 * count ))

  w_kbps="$(LC_ALL=C awk -v kb="$total_kb" -v s="$t_start" -v e="$t_end" 'BEGIN {
    dt = e - s;
    if (dt <= 0.005) dt = 0.005;
    printf "%.2f", kb / dt;
  }')"

  # 2. Đo tốc độ Đọc (Read)
  t_start="$(LC_ALL=C awk '{print $1}' /proc/uptime)"
  if ! LC_ALL=C ionice -c 3 nice -n 19 dd if="$test_file" of=/dev/null bs="$bs" count="$count" iflag=direct status=none 2>/dev/null; then
    LC_ALL=C ionice -c 3 nice -n 19 dd if="$test_file" of=/dev/null bs="$bs" count="$count" status=none 2>/dev/null || true
  fi
  t_end="$(LC_ALL=C awk '{print $1}' /proc/uptime)"
  /bin/rm -f -- "$test_file" 2>/dev/null || true

  r_kbps="$(LC_ALL=C awk -v kb="$total_kb" -v s="$t_start" -v e="$t_end" 'BEGIN {
    dt = e - s;
    if (dt <= 0.005) dt = 0.005;
    printf "%.2f", kb / dt;
  }')"

  local block_kb=${bs%[kKmM]}
  [[ "$bs" == *[mM] ]] && block_kb=$(( ${bs%[mM]} * 1024 ))

  LC_ALL=C awk -v r="$r_kbps" -v w="$w_kbps" -v bkb="$block_kb" 'BEGIN {
    t_bw = (r + w) / 2;
    iops = t_bw / bkb;
    lat = (iops > 0) ? (1000000 / iops) : 0;
    printf "%.2f|%.2f|%.2f|%.0f|%.1f", r, w, t_bw, iops, lat;
  }'
}

# ==============================================================================
# GIAO DIỆN CHÍNH & XỬ LÝ THAM SỐ ĐẦU VÀO
# ==============================================================================
TEST_MODE="full"
DRY_RUN=0

for arg in "$@"; do
  case "$arg" in
    --quick | -q)       TEST_MODE="quick" ;;
    --health-only | -s) TEST_MODE="health" ;;
    --full | -a)        TEST_MODE="full" ;;
    --dry-run)          DRY_RUN=1 ;;
  esac
done

clear
_ui_box_top
_ui_box_center "${C_YELLOW:-}${quan_ly_tai_nguyen:-Quản lý tài nguyên server} ➜ Kiểm tra Sức khỏe & Tốc độ Ổ cứng (Disk I/O)${C_RESET:-}"
_ui_box_bot
printf '\n'

if (( DRY_RUN == 1 )); then
  printf '%b\n' "${C_CYAN:-}[DRY-RUN] Sẽ kiểm tra thông số phân vùng, Inodes, loại đĩa vật lý (NVMe/SSD/HDD) và đo tốc độ Đọc/Ghi/IOPS trong /etc/wptt/tmp mà không ảnh hưởng dữ liệu hệ thống.${C_RESET:-}"
  wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0
fi

gather_storage_profile
preflight_and_engine_setup

# Đánh giá trạng thái tối ưu hóa mount options
mount_status="${C_YELLOW:-}Mặc định (${DISK_MOUNT_OPTS})${C_RESET:-}"
if [[ "$DISK_MOUNT_OPTS" == *"noatime"* ]]; then
  mount_status="${C_GREEN:-}Đã tối ưu noatime (${DISK_MOUNT_OPTS})${C_RESET:-}"
fi

printf '\n'
_ui_box_top
_ui_box_center "${C_BOLD_WHITE:-}THÔNG TIN HẠ TẦNG LƯU TRỮ MÁY CHỦ (STORAGE PROFILE)${C_RESET:-}"
_ui_box_mid
_ui_box_left "Thiết bị / Định dạng : ${C_BOLD_WHITE:-}${DISK_DEV}${C_RESET:-} (Filesystem: ${C_CYAN:-}${DISK_FS}${C_RESET:-})"
_ui_box_left "Công nghệ Phần cứng  : ${C_GREEN:-}${DISK_TYPE}${C_RESET:-}"
_ui_box_left "Dung lượng Ổ cứng    : Đã dùng ${C_YELLOW:-}${DISK_USED}${C_RESET:-} / ${C_BOLD_WHITE:-}${DISK_TOTAL}${C_RESET:-} (Còn trống: ${C_GREEN:-}${DISK_AVAIL}${C_RESET:-} - ${DISK_PCT})"
_ui_box_left "Chỉ số File (Inodes) : Đã dùng ${C_CYAN:-}${INODE_USED}${C_RESET:-} / ${INODE_TOTAL} (${INODE_PCT})"
_ui_box_left "Điều phối I/O & Cờ   : Scheduler [${C_CYAN:-}${DISK_SCHED}${C_RESET:-}] | Mount: ${mount_status}"
_ui_box_bot

# Nếu gọi tương tác từ Menu hoặc không truyền tham số CLI -> Hiển thị bảng chọn chế độ
if [[ "${1:-}" == "98" || "${1:-}" == "99" || "${1:-}" == "97" || -z "${1:-}" ]]; then
  printf '\n'
  _ui_box_top
  _ui_box_center "${C_YELLOW:-}CHỌN CHẾ ĐỘ KIỂM TRA Ổ CỨNG (DISK BENCHMARK)${C_RESET:-}"
  _ui_box_mid
  _ui_box_left "${C_CYAN:-}1)${C_RESET:-} Đo Toàn Diện 4 Cấp Độ (4K Database, 64K Cache, 512K Backup, 1M Tuần tự)"
  _ui_box_left "${C_CYAN:-}2)${C_RESET:-} Đo Nhanh Trọng Điểm (Chỉ đo 4K Random Database & 1M Sequential - 10 giây)"
  _ui_box_left "${C_CYAN:-}3)${C_RESET:-} Chỉ Kiểm Tra Sức Khỏe Phân Vùng & Top Thư Mục Nặng Nhất (0 Byte ghi đĩa)"
  _ui_box_bot

  while true; do
    printf '\n%b' "${C_CYAN:-}Nhập lựa chọn (1-3) [Mặc định=1] [0=Thoát]: ${C_RESET:-}"
    if ! read -r mode_reply; then
      wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0
    fi
    mode_reply="${mode_reply//[[:space:]]/}"
    [[ -z "$mode_reply" ]] && mode_reply="1"

    case "$mode_reply" in
      0)
        wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0
        ;;
      1)
        TEST_MODE="full"
        break
        ;;
      2)
        TEST_MODE="quick"
        break
        ;;
      3)
        TEST_MODE="health"
        break
        ;;
      *)
        printf '%b\n' "${C_RED:-}Lựa chọn không hợp lệ! Vui lòng nhập 1, 2, 3 hoặc 0.${C_RESET:-}"
        ;;
    esac
  done
fi

wptt_logs "INFO" "Thực thi kiểm tra ổ cứng (Chế độ: $TEST_MODE, Engine: $BENCH_ENGINE)" 2>/dev/null || true

# ==============================================================================
# NHÁNH 1: CHỈ KIỂM TRA SỨC KHỎE & THỐNG KÊ THƯ MỤC (0 BYTE GHI ĐĨA)
# ==============================================================================
if [[ "$TEST_MODE" == "health" ]]; then
  printf '\n'
  _ui_box_top
  _ui_box_center "${C_BOLD_WHITE:-}THỐNG KÊ DUNG LƯỢNG CÁC PHÂN KHU QUAN TRỌNG${C_RESET:-}"
  _ui_box_mid

  for check_dir in "/usr/local/lsws" "/var/lib/mysql" "/usr/local/backup-website" "/var/log"; do
    if [[ -d "$check_dir" ]]; then
      dir_sz="$(LC_ALL=C ionice -c 3 nice -n 19 du -sh "$check_dir" 2>/dev/null | awk '{print $1}' || printf '0B')"
      _ui_box_left "Thư mục $(printf '%-26s' "$check_dir") : ${C_YELLOW:-}${dir_sz}${C_RESET:-}"
    fi
  done

  _ui_box_bot
  wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0 "enter"
fi

# ==============================================================================
# NHÁNH 2: ĐO HIỆU NĂNG ĐỌC/GHI Ổ CỨNG (FIO / DD ENGINE)
# ==============================================================================
declare -a TEST_PROFILES=()

if [[ "$TEST_MODE" == "quick" ]]; then
  BENCH_SIZE_MB=128
  TEST_PROFILES=(
    "4K (MariaDB/SQL)|4k|4"
    "1M (Sao lưu/Nén)|1m|4"
  )
else
  TEST_PROFILES=(
    "4K (MariaDB/SQL)|4k|5"
    "64K (PHP/LSCache)|64k|5"
    "512K (Upload/Media)|512k|5"
    "1M (Sao lưu/Nén)|1m|5"
  )
fi

printf '\n'
_ui_table_top
_ui_table_row \
  "${C_BOLD_WHITE:-}Cấp độ Block Size${C_RESET:-}" \
  "${C_GREEN:-}Tốc độ Đọc${C_RESET:-}" \
  "${C_CYAN:-}Tốc độ Ghi${C_RESET:-}" \
  "${C_YELLOW:-}Tổng IOPS${C_RESET:-}" \
  "${C_BOLD_WHITE:-}Độ trễ I/O${C_RESET:-}"
_ui_table_mid

printf '\033[?25l' 2>/dev/null || true

iops_4k_raw=0
lat_4k_raw=0
bw_1m_raw=0

for prof in "${TEST_PROFILES[@]}"; do
  IFS='|' read -r label bs runtime <<< "$prof"

  printf '\r\033[0K%b[*] Đang đo hiệu năng I/O ở mức: %s (Engine: %s)...%b' \
    "${C_YELLOW:-}" "$label" "${BENCH_ENGINE^^}" "${C_RESET:-}"

  res_line=""
  if [[ "$BENCH_ENGINE" == "fio" ]]; then
    res_line="$(run_fio_block_test "$bs" "$BENCH_SIZE_MB" "$runtime")"
  fi

  # Fallback sang dd nếu máy không có fio hoặc fio trả về 0
  if [[ -z "$res_line" || "$res_line" == "0|0|0|0|0" ]]; then
    dd_count=64
    [[ "$bs" == "4k" ]] && dd_count=4096
    [[ "$bs" == "64k" ]] && dd_count=1024
    [[ "$bs" == "512k" ]] && dd_count=128
    res_line="$(run_dd_fallback_test "$label" "$bs" "$dd_count")"
  fi

  IFS='|' read -r r_bw w_bw t_bw t_iops avg_lat <<< "$res_line"

  # Lưu thông số 4K và 1M để chấm điểm tổng kết
  if [[ "$bs" == "4k" ]]; then
    iops_4k_raw="${t_iops:-0}"
    lat_4k_raw="${avg_lat:-0}"
  elif [[ "$bs" == "1m" ]]; then
    bw_1m_raw="${t_bw:-0}"
  fi

  str_read="$(format_bw_speed "$r_bw")"
  str_write="$(format_bw_speed "$w_bw")"
  str_t_bw="$(format_bw_speed "$t_bw")"
  str_iops="$(format_iops_val "$t_iops") (${str_t_bw})"
  str_lat="$(format_lat_val "$avg_lat")"

  printf '\r\033[0K'
  _ui_table_row \
    "$label" \
    "${C_GREEN:-}${str_read}${C_RESET:-}" \
    "${C_CYAN:-}${str_write}${C_RESET:-}" \
    "${C_YELLOW:-}${str_iops}${C_RESET:-}" \
    "${C_BOLD_WHITE:-}${str_lat}${C_RESET:-}"
done

printf '\033[?25h' 2>/dev/null || true
_ui_table_bot

# ==============================================================================
# ĐÁNH GIÁ CHẤT LƯỢNG Ổ CỨNG CHO WORDPRESS
# ==============================================================================
str_4k_iops="$(format_iops_val "$iops_4k_raw")"
str_1m_bw="$(format_bw_speed "$bw_1m_raw")"

verdict_raw="$(LC_ALL=C awk -v iops="$iops_4k_raw" 'BEGIN {
  if (iops >= 15000) {
    print "Rất cao (mức NVMe)|Phù hợp WooCommerce, MariaDB tải lớn";
  } else if (iops >= 3000) {
    print "Tốt (mức SSD)|Phù hợp hầu hết website WordPress";
  } else if (iops >= 500) {
    print "Trung bình|SSD bị giới hạn IOPS hoặc storage mạng (Ceph)";
  } else {
    print "Thấp|Ổ chậm hoặc nhà cung cấp bóp IOPS, nên bật LSCache/Redis";
  }
}')"
IFS='|' read -r verdict_label verdict_note <<< "$verdict_raw"

if [[ "$BENCH_ENGINE" == "dd" ]]; then
  verdict_label="${verdict_label} - ước lượng bằng dd"
fi

printf '\n'
_ui_box_top
_ui_box_center "${C_BOLD_WHITE:-}BÁO CÁO ĐÁNH GIÁ HIỆU SUẤT LƯU TRỮ (STORAGE VERDICT)${C_RESET:-}"
_ui_box_mid
_ui_box_left "Hiệu năng Database (4K) : ${C_YELLOW:-}${str_4k_iops} IOPS${C_RESET:-} (Độ trễ trung bình: ${C_BOLD_WHITE:-}$(format_lat_val "$lat_4k_raw")${C_RESET:-})"
_ui_box_left "Băng thông Tuần tự (1M) : ${C_GREEN:-}${str_1m_bw}${C_RESET:-} (Engine đo lường: ${C_CYAN:-}${BENCH_ENGINE^^}${C_RESET:-})"
_ui_box_left "Mức hiệu năng Ổ cứng    : ${C_YELLOW:-}${verdict_label}${C_RESET:-}"
_ui_box_left "Nhận định               : ${verdict_note}"
_ui_box_bot

wptt_quay_ve_menu "${MENU_WPTT_IN:-}" 0 "enter"
