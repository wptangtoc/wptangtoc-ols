#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2025
# @email: giatuan@wptangtoc.com
# @description: Thiết lập WordPress Multisite (Subdomain / Sub-directory) 

function huong_dan() {
  cat <<'EOF'
  Tính năng Multisite [đa trang web] là một chức năng mạnh mẽ được tích hợp sẵn trong WordPress, cho phép bạn tạo và quản lý một mạng lưới nhiều website khác nhau từ một lần cài đặt WordPress duy nhất.

  🎯 Mục đích sử dụng phổ biến:
  * Tạo một mạng lưới blog cá nhân.
  * Các trường đại học, tổ chức cung cấp website cho các khoa, phòng ban, hoặc dự án.
  * Doanh nghiệp có nhiều chi nhánh hoặc thương hiệu con muốn có website riêng nhưng quản lý tập trung.
  * Cung cấp nền tảng cho người dùng tự tạo website [tương tự WordPress.com].

  Tính năng thiết lập multisite WordPress bạn có thể dễ dàng thiết lập multisite
  Với dạng: subdomain hoặc subfolder
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true

# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null


route_flag="${1:-}"
chuyen_web="${2:-}"
domain="${1:-}"

if [[ "$domain" == "98" || "$domain" == "99" ]]; then
  domain=""
fi

# Validate định dạng domain nếu truyền trực tiếp qua CLI
if [[ -n "$domain" ]]; then
  if [[ ! "$domain" =~ ^[a-zA-Z0-9]+([a-zA-Z0-9.-]*[a-zA-Z0-9]+)?\.[a-zA-Z]{2,}$ ]]; then
    echo -e "\n${C_RED}Lỗi: ${domain_nhap_khong_dung_dinh_dang:-Tên miền nhập không đúng định dạng!}${C_RESET}"
    wptt_quay_ve_menu "$route_flag" 1 "enter"
  fi
fi

# ==============================================================================
# 1. KHỞI TẠO GIAO DIỆN & LỰA CHỌN TÊN MIỀN
# ==============================================================================
tinh_nang_ten="Thiết lập WordPress Multisite"

if [[ -z "$domain" ]]; then
  clear
  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_BOLD_WHITE}${quan_ly_wordpress:-Quản lý WordPress} ➜ ${C_YELLOW}${tinh_nang_ten}${C_RESET}" "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""

  # shellcheck source=/dev/null
  . /etc/wptt/tenmien-only-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
  domain="${NAME:-}"
fi

# Đồng bộ cả 2 biến NAME và domain để không bị lệch khi truyền qua đối số $1
NAME="$domain"

if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "$route_flag" 0
fi

path_vhost_env="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$path_vhost_env" ]]; then
  clear
  echoDo "${ten_mien_nay_khong_ton_tai_tren_he_thong:-Domain không tồn tại trên hệ thống, vui lòng thêm website trước!}"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

# Tương thích cả thư mục html tiêu chuẩn lẫn html_clean
wp_dir="/usr/local/lsws/${NAME}/html"
[[ -d "/usr/local/lsws/${NAME}/html_clean" ]] && wp_dir="/usr/local/lsws/${NAME}/html_clean"
wp_config="${wp_dir}/wp-config.php"
htaccess_file="${wp_dir}/.htaccess"

if [[ ! -f "$wp_config" ]]; then
  clear
  echoDo "Hệ thống xác nhận website ${NAME} không sử dụng mã nguồn WordPress (thiếu wp-config.php)."
  if [[ -n "$chuyen_web" ]]; then
    return 1 2>/dev/null || exit 1
  fi
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

# shellcheck source=/dev/null
. "$path_vhost_env"
# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null

# ==============================================================================
# 2. KIỂM TRA TRẠNG THÁI MULTISITE HIỆN TẠI (0 SUBSHELL - PURE BASH)
# ==============================================================================
kiemtra_multisite=""
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ "$line" =~ ^[[:space:]]*(//|#) ]] && continue
  if [[ "$line" =~ define[[:space:]]*\([[:space:]]*[\'\"]SUBDOMAIN_INSTALL[\'\"][[:space:]]*,[[:space:]]*(true|false|TRUE|FALSE) ]]; then
    kiemtra_multisite="${BASH_REMATCH[1],,}"
    break
  fi
done <"$wp_config"

multisite_tuy_chon=""

if [[ "$kiemtra_multisite" == "true" ]]; then
  echo -e "\n${C_GREEN}✔ Hệ thống xác nhận website ${C_BOLD_WHITE}${NAME}${C_GREEN} đang sử dụng Multisite dạng: ${C_YELLOW}Subdomain (*.${NAME})${C_RESET}"
  multisite_tuy_chon="1"
elif [[ "$kiemtra_multisite" == "false" ]]; then
  echo -e "\n${C_GREEN}✔ Hệ thống xác nhận website ${C_BOLD_WHITE}${NAME}${C_GREEN} đang sử dụng Multisite dạng: ${C_YELLOW}Sub-directory (${NAME}/subsite)${C_RESET}"
  multisite_tuy_chon="2"
else
  if [[ -n "$chuyen_web" ]]; then
    return 0 2>/dev/null || exit 0
  fi

  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}LỰA CHỌN MÔ HÌNH WORDPRESS MULTISITE CHO: ${C_BOLD_WHITE}${NAME}${C_RESET}" "$C_CYAN"
  print_border_mid "$C_CYAN"
  left_text "${C_BOLD_WHITE}1.${C_RESET} Multisite Subdomain      ${C_CYAN}(Ví dụ: site1.${NAME}, site2.${NAME})${C_RESET}" 2 "$C_CYAN"
  left_text "${C_BOLD_WHITE}2.${C_RESET} Multisite Sub-directory  ${C_CYAN}(Ví dụ: ${NAME}/site1, ${NAME}/site2)${C_RESET}" 2 "$C_CYAN"
  left_text "${C_BOLD_WHITE}0.${C_RESET} Hủy bỏ / Quay lại Menu" 2 "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""

  read -rp "➜ Nhập lựa chọn của bạn [0-2]: " reply_choice
  case "${reply_choice:-}" in
    1) multisite_tuy_chon="1" ;;
    2) multisite_tuy_chon="2" ;;
    0 | "")
      echo -e "${C_YELLOW}Đã hủy thiết lập Multisite.${C_RESET}"
      wptt_quay_ve_menu "$route_flag" 0
      ;;
    *)
      echoDo "Lựa chọn không hợp lệ! Hủy thao tác."
      wptt_quay_ve_menu "$route_flag" 1 "enter"
      ;;
  esac
fi

if [[ "$multisite_tuy_chon" != "1" && "$multisite_tuy_chon" != "2" ]]; then
  wptt_quay_ve_menu "$route_flag" 0
fi

# ==============================================================================
# 3. KIỂM TRA PHP-CLI & TẠM MỞ KHÓA FILE LOCK (NẾU CÓ)
# ==============================================================================
if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP cho $NAME"
  if [[ -n "$chuyen_web" ]]; then
    return 1 2>/dev/null || exit 1
  fi
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

PHP_BIN="/usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php"
if [[ ! -x "$PHP_BIN" ]]; then
  PHP_BIN="$(command -v php || echo "/usr/local/lsws/lsphp83/bin/php")"
fi

if [[ -n "${User_name_vhost:-}" ]]; then
  WP_EXEC=(/sbin/runuser -u "$User_name_vhost" -- "$PHP_BIN" /usr/local/bin/wp)
else
  WP_EXEC=("$PHP_BIN" /usr/local/bin/wp --allow-root)
fi

# Tạm gỡ khóa bảo vệ file (chattr +i) nếu website đang bật lock_down
restore_lock_down=0
if [[ -n "${lock_down:-}" ]]; then
  restore_lock_down=1
  # shellcheck source=/dev/null
  . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" off >/dev/null 2>&1 || true
fi
chattr -i "$wp_config" "$htaccess_file" 2>/dev/null || true

# ==============================================================================
# 4. HÀM CẬP NHẬT .HTACCESS AN TOÀN (DÙNG ENVIRON TRONG AWK TRÁNH ESCAPE WARNING)
# ==============================================================================
wptt_update_multisite_htaccess() {
  local mode="$1" # "subdomain" hoặc "subdir"
  local target_ht="$2"

  mkdir -p /etc/wptt/tmp 2>/dev/null || true
  local tmp_ht
  tmp_ht="$(mktemp -p /etc/wptt/tmp htaccess_ms_XXXXXX)" || return 1

  local ms_rules=""
  if [[ "$mode" == "subdir" ]]; then
    read -r -d '' ms_rules <<'EOF' || true
# BEGIN WordPress Multisite (WPTangToc OLS - Sub-directory)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]

# Add a trailing slash to /wp-admin
RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ $1wp-admin/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(wp-(content|admin|includes).*) $2 [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(.*\.php)$ $2 [L]
RewriteRule . index.php [L]
</IfModule>
# END WordPress
EOF
  else
    read -r -d '' ms_rules <<'EOF' || true
# BEGIN WordPress Multisite (WPTangToc OLS - Subdomain)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]

# Add a trailing slash to /wp-admin
RewriteRule ^wp-admin$ wp-admin/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(wp-(content|admin|includes).*) $1 [L]
RewriteRule ^(.*\.php)$ $1 [L]
RewriteRule . index.php [L]
</IfModule>
# END WordPress
EOF
  fi

  if [[ -s "$target_ht" ]]; then
    # [ĐÃ FIX]: Truyền qua ENVIRON["MS_RULES"] thay vì -v để awk giữ nguyên ký tự \. mà không báo warning!
    MS_RULES="$ms_rules" awk '
      BEGIN {
        new_block = ENVIRON["MS_RULES"]
        replaced = 0
        in_wp = 0
      }
      /^### thiet lap multisite ###/ { next }
      /^# BEGIN WordPress/ {
        if (!replaced) {
          print new_block
          replaced = 1
        }
        in_wp = 1
        next
      }
      in_wp && /^# END WordPress/ {
        in_wp = 0
        next
      }
      !in_wp { print }
      END {
        if (!replaced) {
          print new_block
        }
      }
    ' "$target_ht" >"$tmp_ht"
  else
    printf '%s\n' "$ms_rules" >"$tmp_ht"
  fi

  if [[ -s "$tmp_ht" ]]; then
    chmod 644 "$tmp_ht"
    if [[ -n "${User_name_vhost:-}" ]]; then
      chown "${User_name_vhost}:${User_name_vhost}" "$tmp_ht" 2>/dev/null || true
    fi
    /bin/mv -f -T -- "$tmp_ht" "$target_ht"
    return 0
  else
    /bin/rm -f -- "$tmp_ht"
    return 1
  fi
}

if grep -q -i "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

# ==============================================================================
# 5. HÀM THÊM WILDCARD DOMAIN (*.$NAME) VÀO HTTPD_CONFIG.CONF AN TOÀN (ATOMIC)
# ==============================================================================
wptt_enable_wildcard_listener_ols() {
  local dom="$1"
  local httpd_conf="/usr/local/lsws/conf/httpd_config.conf"
  [[ -f "$httpd_conf" ]] || return 1

  if grep -qF "*.${dom}" "$httpd_conf" 2>/dev/null; then
    return 0
  fi

  mkdir -p /etc/wptt/tmp 2>/dev/null || true
  local tmp_httpd bak_httpd
  tmp_httpd="$(mktemp -p /etc/wptt/tmp httpd_ms_XXXXXX.conf)" || return 1
  bak_httpd="/etc/wptt/tmp/httpd_config.conf.bak_ms_$(date +%s)"
  /bin/cp -a -- "$httpd_conf" "$bak_httpd"

  if DOM="$dom" awk '
    BEGIN { d = ENVIRON["DOM"] }
    $1 == "map" && $2 == d {
      if (index($0, "*." d) == 0) {
        $0 = $0 ", *." d
      }
    }
    { print }
  ' "$httpd_conf" >"$tmp_httpd" && [[ -s "$tmp_httpd" ]]; then
    chmod --reference="$httpd_conf" "$tmp_httpd" 2>/dev/null || chmod 750 "$tmp_httpd"
    chown --reference="$httpd_conf" "$tmp_httpd" 2>/dev/null || chown lsadm:"$tuong_thich_nhom_litespeed" "$tmp_httpd" 2>/dev/null || true
    /bin/mv -f -T -- "$tmp_httpd" "$httpd_conf"

    if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
      /bin/cp -af -- "$bak_httpd" "$httpd_conf"
      /bin/rm -f -- "$bak_httpd"
      return 1
    fi
    /bin/rm -f -- "$bak_httpd"
    return 0
  else
    /bin/rm -f -- "$tmp_httpd" "$bak_httpd"
    return 1
  fi
}

# ==============================================================================
# 6. THỰC THI CHUYỂN ĐỔI MULTISITE (SUB-DIRECTORY HOẶC SUBDOMAIN)
# ==============================================================================
if [[ "$multisite_tuy_chon" == "2" ]]; then
  task_msg="Thiết lập WordPress Multisite Sub-directory cho $NAME"
  _runing "$task_msg"

  convert_ok=1
  if [[ -z "$chuyen_web" && -z "$kiemtra_multisite" ]]; then
    if ! "${WP_EXEC[@]}" core multisite-convert --path="$wp_dir" >/dev/null 2>&1; then
      convert_ok=0
    fi
  fi

  if ((convert_ok == 1)) && wptt_update_multisite_htaccess "subdir" "$htaccess_file"; then
    _rundone "$task_msg"
    wptt_logs "INFO" "Đã thiết lập WordPress Multisite Sub-directory cho $NAME"
  else
    _runloi "$task_msg"
    [[ "$restore_lock_down" -eq 1 ]] && . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" on >/dev/null 2>&1
    [[ -n "$chuyen_web" ]] && { return 1 2>/dev/null || exit 1; }
    wptt_quay_ve_menu "$route_flag" 1 "enter"
  fi

elif [[ "$multisite_tuy_chon" == "1" ]]; then
  task_msg="Thiết lập WordPress Multisite Subdomain cho $NAME"
  _runing "$task_msg"

  convert_ok=1
  if [[ -z "$chuyen_web" && -z "$kiemtra_multisite" ]]; then
    if ! "${WP_EXEC[@]}" core multisite-convert --subdomains --path="$wp_dir" >/dev/null 2>&1; then
      convert_ok=0
    fi
  fi

  if ((convert_ok == 1)) && wptt_enable_wildcard_listener_ols "$NAME" && wptt_update_multisite_htaccess "subdomain" "$htaccess_file"; then
    _rundone "$task_msg"
    wptt_logs "INFO" "Đã thiết lập WordPress Multisite Subdomain (*.$NAME) cho $NAME"
  else
    _runloi "$task_msg"
    [[ "$restore_lock_down" -eq 1 ]] && . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" on >/dev/null 2>&1
    [[ -n "$chuyen_web" ]] && { return 1 2>/dev/null || exit 1; }
    wptt_quay_ve_menu "$route_flag" 1 "enter"
  fi

  # Kiểm tra bản ghi Wildcard DNS (*.domain)
  wildcard_probe="wptt-wildcard-check.${NAME}"
  checkdns=""
  if command -v getent >/dev/null 2>&1; then
    checkdns="$(getent ahostsv4 "$wildcard_probe" 2>/dev/null | awk 'NR==1 {print $1}')"
  elif command -v host >/dev/null 2>&1; then
    checkdns="$(host -t A "$wildcard_probe" 2>/dev/null | grep -Eo -m 1 '([0-9]{1,3}\.){3}[0-9]{1,3}' || true)"
  elif command -v nslookup >/dev/null 2>&1; then
    checkdns="$(nslookup "$wildcard_probe" 2>/dev/null | awk '/^Address: / { print $2; exit }')"
  fi

  if [[ -z "$checkdns" && -z "$chuyen_web" ]]; then
    server_ip="${IP_SERVER:-}"
    if [[ -z "$server_ip" ]]; then
      server_ip="$(curl -sLf --connect-timeout 4 --max-time 8 https://ipv4.icanhazip.com 2>/dev/null | tr -d '[:space:]' || curl -sLf --connect-timeout 4 --max-time 8 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]' || echo "IP_VPS_CUA_BAN")"
    fi

    echo ""
    print_border_top "$C_YELLOW"
    center_text "${C_BOLD_WHITE}LƯU Ý QUAN TRỌNG: CẦN TRỎ WILDCARD DNS VÀ CẤP WILDCARD SSL${C_RESET}" "$C_YELLOW"
    print_border_mid "$C_YELLOW"
    left_text "Hệ thống phát hiện tên miền ${C_BOLD_WHITE}*.${NAME}${C_RESET} chưa được trỏ Wildcard DNS." 2 "$C_YELLOW"
    left_text "Để các site con dạng Subdomain hoạt động, bạn vui lòng thêm bản ghi DNS:" 2 "$C_YELLOW"
    left_text "  • Loại (Type)    : ${C_GREEN}A${C_RESET}" 2 "$C_YELLOW"
    left_text "  • Tên (Name/Host): ${C_GREEN}*${C_RESET}" 2 "$C_YELLOW"
    left_text "  • Giá trị (Value): ${C_GREEN}${server_ip}${C_RESET}" 2 "$C_YELLOW"
    print_border_bot "$C_YELLOW"
  fi
fi

# Khôi phục trạng thái khóa file bảo mật nếu trước đó website có bật lock_down
if [[ "$restore_lock_down" -eq 1 ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" on >/dev/null 2>&1 || true
fi

# Reload OpenLiteSpeed Graceful (Zero-Downtime)
if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
  wptt_smart_reload_lsws >/dev/null 2>&1
else
  /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1 || true
fi

if [[ -n "$chuyen_web" ]]; then
  return 0 2>/dev/null || exit 0
fi

wptt_quay_ve_menu "$route_flag" 0 "enter"
