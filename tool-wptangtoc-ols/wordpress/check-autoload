function huong_dan {
  Tính năng kiểm tra Autoload trong WordPress là một công cụ chẩn đoán hiệu suất chuyên sâu, giúp đo lường dung lượng dữ liệu tự động tải từ bảng wp_options mỗi khi có người truy cập vào website.

  Giải thích ngắn gọn:

  Trong WordPress, các plugin và theme thường lưu cài đặt với chế độ autoload=yes. Nghĩa là dù khách truy cập bất kỳ trang nào, toàn bộ lượng dữ liệu này cũng bị ép tải vào RAM. Theo thời gian, rác từ các plugin cũ bị xóa bỏ vẫn nằm lại đây và làm phình to Autoload.

  Tác hại khi Autoload quá lớn [vượt mốc 900 KB]:

  * Làm tăng vọt thời gian chờ phản hồi máy chủ [TTFB].
  * Vắt kiệt tài nguyên RAM và làm chậm toàn bộ website.

  Tính năng này là công cụ thiết yếu giúp bạn phát hiện sớm nút thắt cổ chai Database, từ đó có phương án dọn dẹp để website WordPress luôn giữ được tốc độ phản hồi chớp nhoáng.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. /etc/wptt/lang/$ngon_ngu.sh 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}$quan_ly_cap_nhat_wordpress ➜ Kiểm tra Autoload WP_OPTIONS${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE ĐỂ KIỂM TRA
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -A /etc/wptt/vhost 2>/dev/null)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        local path_html="/usr/local/lsws/$domain/html"
        if [[ -f "$path_html/wp-config.php" ]]; then
          selects+=("$domain")
        fi
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: $khong_co_domain_nao_ton_tai_tren_he_thong${C_RESET}"
    exit
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Kiểm tra đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="${lua_chon_website_ban_muon:-Nhập lựa chọn website cần kiểm tra}:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Kiểm tra đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Kiểm tra Database toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Kiểm tra Database toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      local clean_row=$(printf "  %3d) %-34s [Sẵn sàng]" "$i" "$val")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${C_GREEN}[Sẵn sàng]${C_RESET}" "$i" "$val")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-wordpress-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Kiểm tra đồng loạt)" ]]; then
            fzf_list+=("$val")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        NAME="$val"
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE)
# ==============================================================================
if [[ "${1:-}" == "all" ]]; then
  NAME="TẤT CẢ WEBSITE (Kiểm tra đồng loạt)"
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
else
  lua_chon_NAME
fi

# ==============================================================================
# LẤY DANH SÁCH DOMAIN ĐỂ KIỂM TRA
# ==============================================================================
DOMAIN_LIST=()
echo ""

if [[ "$NAME" == "TẤT CẢ WEBSITE (Kiểm tra đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all" ]]; then
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done
  
  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không có website WordPress nào trên hệ thống!${C_RESET}" && sleep 2 && exit 1
  fi
else
  path_html="/usr/local/lsws/$NAME/html"
  [[ ! -d "$path_html" ]] && echo -e "\n${C_RED}❌ Không tìm thấy thư mục chứa mã nguồn của $NAME${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-wordpress-main 1
  DOMAIN_LIST=("$NAME")
fi

# ==============================================================================
# THỰC THI TRUY VẤN RAW SQL (KHÔNG DÙNG WP DOCTOR)
# ==============================================================================
for DOMAIN in "${DOMAIN_LIST[@]}"; do
  path_html="/usr/local/lsws/$DOMAIN/html"
  
  . /etc/wptt/vhost/.$DOMAIN.conf 2>/dev/null
  . /etc/wptt/php/php-cli-domain-config $DOMAIN 2>/dev/null
  
  WP_EXEC="/sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp"

  # Lấy tiền tố bảng động từ wp-config.php để chống lỗi khi user đổi tiền tố bảo mật
  db_prefix=$($WP_EXEC db prefix --allow-root --path="$path_html" 2>/dev/null)

  if [[ -z "$db_prefix" ]]; then
    echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}❌ LỖI TRUY VẤN CƠ SỞ DỮ LIỆU${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Website : ${C_BOLD_WHITE}$DOMAIN${C_RESET}" 2
    left_text "  Chi tiết: Không thể lấy được tiền tố Database từ wp-config.php." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
    continue
  fi

  table_options="${db_prefix}options"

  # Truy vấn tính tổng Bytes bằng tên bảng động siêu tốc
  autoload_bytes=$($WP_EXEC db query "SELECT SUM(LENGTH(option_value)) FROM ${table_options} WHERE autoload = 'yes' OR autoload = 'on';" --skip-column-names --allow-root --path="$path_html" 2>/dev/null)

  # Xử lý trường hợp DB rỗng hoặc trả về NULL (Tránh lỗi phép tính bc)
  if [[ -z "$autoload_bytes" || "$autoload_bytes" == "NULL" ]]; then
    autoload_bytes=0
  fi

  # Kiểm tra kết quả trả về có phải là số hợp lệ không
  if [[ "$autoload_bytes" =~ ^[0-9]+$ ]]; then
    # Ép kiểu tính toán sang Kilobytes (KB) với 2 số thập phân
    autoload_kb=$(echo "scale=2; $autoload_bytes / 1024" | bc)

    # Đánh giá cảnh báo (Mốc 900KB là tiêu chuẩn an toàn)
    if (($(echo "$autoload_kb > 900" | bc -l))); then
      echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_YELLOW}CẢNH BÁO: KÍCH THƯỚC AUTOLOAD VƯỢT NGƯỠNG AN TOÀN${C_RESET}"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "  Website : ${C_BOLD_WHITE}$DOMAIN${C_RESET}" 2
      left_text "  Autoload: ${C_RED}${autoload_kb} KB${C_RESET} (Ngưỡng an toàn: < 900 KB)" 2
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "   Lời khuyên: Hãy vào Database dọn dẹp các table rác của Plugin cũ" 2
      left_text "  để giải phóng RAM và tăng tốc độ phản hồi máy chủ (TTFB)." 2
      echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
    else
      echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_GREEN}TỐT: KÍCH THƯỚC AUTOLOAD TRONG MỨC LÝ TƯỞNG${C_RESET}"
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "  Website : ${C_BOLD_WHITE}$DOMAIN${C_RESET}" 2
      left_text "  Autoload: ${C_GREEN}${autoload_kb} KB${C_RESET} (Ngưỡng an toàn: < 900 KB)" 2
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
    fi
  else
    echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}LỖI ĐỌC DỮ LIỆU TỪ BẢNG OPTIONS${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Website : ${C_BOLD_WHITE}$DOMAIN${C_RESET}" 2
    left_text "  Chi tiết: Bảng ${table_options} không tồn tại hoặc bị lỗi." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  fi
done

echo -en "${C_CYAN}Bấm phím Enter để quay trở lại menu...${C_RESET}"
read -r empty_input

if [[ ${1:-} == "98" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi
