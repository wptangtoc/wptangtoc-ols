function huong_dan() {
  Kể từ WordPress 3.3 trở đi WordPress đã tính hợp một tính năng cực kì mạnh mẽ, WP-Cron là hệ thống tích hợp sẵn của WordPress để thực hiện các công việc tự động theo lịch như đăng bài đã hẹn giờ, kiểm tra cập nhật, gửi email thông báo, hoặc các tác vụ do plugin lên lịch [ví dụ: sao lưu, quét bảo mật].

  Tại Sao Cần Tối Ưu Hóa WP-Cron?
  * Hoạt động mặc định của WP-Cron: Theo mặc định, WP-Cron được kích hoạt mỗi khi có người dùng truy cập vào website của bạn.
  * Trên website lưu lượng cao: Việc này có thể kích hoạt wp-cron.php quá thường xuyên, gây thêm tải không cần thiết cho máy chủ.
  * Trên website lưu lượng thấp: Các tác vụ có thể bị trễ hoặc bỏ lỡ nếu không có ai truy cập website vào thời điểm tác vụ đó được lên lịch.
  * Đảm bảo tác vụ chạy đúng giờ: Giúp các công việc quan trọng như đăng bài, gửi email được thực hiện đúng theo lịch trình.

  Lợi Ích Của Việc Tối Ưu Hóa WP Cron
  * Cải thiện hiệu suất website: Đặc biệt trên các trang có nhiều truy cập, giảm tải cho server.
  * Tăng độ tin cậy: Đảm bảo các tác vụ theo lịch được thực thi đúng giờ, kể cả trên các trang ít truy cập.
  * Quản lý tài nguyên tốt hơn: Các tác vụ nền chạy một cách có kiểm soát hơn.
  Tối ưu hóa WP-Cron là một bước quan trọng để website WordPress của bạn hoạt động mượt mà và ổn định hơn.
}

#cli
# /etc/wptt/wordpress/wp-cron-job all on 5 (Bật tối ưu toàn Server với chu kỳ 5 phút).
# /etc/wptt/wordpress/wp-cron-job all off

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78
MASTER_CRON_FILE="/etc/cron.d/wptt-master-cron"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}$quan_ly_wordpress ➜ Tối ưu hệ thống WP-Cron (Hẹn giờ)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE KÈM TRẠNG THÁI CRON
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -A /etc/wptt/vhost 2>/dev/null | grep -v '^\.\.conf$' | sort -uV)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        local wp_load="/usr/local/lsws/$domain/html/wp-load.php"
        local wp_config="/usr/local/lsws/$domain/html/wp-config.php"
        if [[ -f "$wp_load" && -f "$wp_config" ]]; then
          local status_text=""
          local status_color=""
          local cron_file="/etc/cron.d/wp-cron-job-$domain.cron"

          local has_cron=false
          # Kiểm tra xem có file cron lẻ hoặc file Master Cron không
          [[ -f "$cron_file" || -f "$MASTER_CRON_FILE" ]] && has_cron=true

          local has_config=false
          if grep -qiE "define\s*\(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*true\s*\)" "$wp_config" 2>/dev/null; then
            has_config=true
          fi

          if $has_cron && $has_config; then
            status_text="[Đã TỐI ƯU WP-CLI]"
            status_color=$C_GREEN
          elif ! $has_cron && ! $has_config; then
            status_text="[Chưa Tối Ưu - Mặc định]"
            status_color=$C_YELLOW
          else
            status_text="[LỖI - Mất đồng bộ cấu hình]"
            status_color=$C_RED
          fi

          selects+=("$domain|$status_text|$status_color")
        fi
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}Lỗi: Hệ thống chưa có website WordPress nào được khởi tạo!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-wordpress-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
  local num_domains=${#selects[@]}

  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Trạng thái hiện tại & Chọn Website muốn thao tác:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"
  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Tối ưu / Hủy Tối ưu WP-Cron cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Tối ưu / Hủy Tối ưu WP-Cron cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
    case "$REPLY" in
    0) exec /etc/wptt/wptt-wordpress-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""
CLI_MINS=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
  CLI_ACTION="bat"
  CLI_MINS="${3:-10}"
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
  CLI_ACTION="tat"
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
    CLI_MINS="${3:-10}"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""
phut=""

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="TỐI ƯU WP-CRON"
    phut="$CLI_MINS"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="HỦY TỐI ƯU (Trả về mặc định)"
  else
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH WP-CRON${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác quản lý lịch trình WP-Cron cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    str_opt1="  1) TỐI ƯU WP-CRON (Kiểm soát hẹn giờ qua hệ thống Cron Server)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}TỐI ƯU WP-CRON${C_RESET} (Kiểm soát hẹn giờ qua hệ thống Cron Server)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

    str_opt2="  2) HỦY TỐI ƯU (Xóa lịch Server, trả mọi thứ về cơ chế mặc định)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}HỦY TỐI ƯU${C_RESET} (Xóa lịch Server, trả mọi thứ về cơ chế mặc định)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice

    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="TỐI ƯU WP-CRON"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="HỦY TỐI ƯU (Trả về mặc định)"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-wordpress-main 1
    fi
  fi

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done
else
  pathcheck="/usr/local/lsws/$NAME/html/wp-config.php"
  [[ ! -f "$pathcheck" ]] && echo -e "\n${C_RED}❌ Tên miền không tồn tại hoặc chưa cài WordPress!${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-wordpress-main 1
  DOMAIN_LIST=("$NAME")

  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "bat" ]]; then
      action_text="TỐI ƯU WP-CRON"
      phut="$CLI_MINS"
    else
      action_text="HỦY TỐI ƯU (Trả về mặc định)"
    fi
  else
    has_cron=false
    cron_file="/etc/cron.d/wp-cron-job-$NAME.cron"
    [[ -f "$cron_file" || -f "$MASTER_CRON_FILE" ]] && has_cron=true

    has_config=false
    if grep -qiE "define\s*\(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*true\s*\)" "$pathcheck" 2>/dev/null; then
      has_config=true
    fi

    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH WP-CRON${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if $has_cron && $has_config; then
      left_text "  Website ${NAME} hiện ĐÃ ĐƯỢC TỐI ƯU WP-CRON." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      str_opt1="  1) HỦY TỐI ƯU (Gỡ bỏ lập lịch Server, trả về cơ chế Mặc định)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}HỦY TỐI ƯU${C_RESET} (Gỡ bỏ lập lịch Server, trả về cơ chế Mặc định)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên khóa bảo vệ)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên cấu hình)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      if [[ "$single_choice" == "1" ]]; then wp_action="tat"; action_text="HỦY TỐI ƯU (Trả về mặc định)"; else exec /etc/wptt/wptt-wordpress-main 1; fi
    elif ! $has_cron && ! $has_config; then
      left_text "  Website ${NAME} đang dùng WP-Cron mặc định (Chưa tối ưu)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      str_opt1="  1) TỐI ƯU WP-CRON (Kích hoạt điều hướng lịch trình qua Server)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}TỐI ƯU WP-CRON${C_RESET} (Kích hoạt điều hướng lịch trình qua Server)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      if [[ "$single_choice" == "1" ]]; then wp_action="bat"; action_text="TỐI ƯU WP-CRON"; else exec /etc/wptt/wptt-wordpress-main 1; fi
    else
      left_text "  ${C_RED}PHÁT HIỆN LỖI ĐỒNG BỘ CẤU HÌNH WP-CRON!${C_RESET}" 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      str_opt1="  1) TỐI ƯU WP-CRON LẠI (Sửa lỗi, đồng bộ lại lịch trình chuẩn)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}TỐI ƯU WP-CRON LẠI${C_RESET} (Sửa lỗi, đồng bộ lại lịch trình chuẩn)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      str_opt2="  2) HỦY HOÀN TOÀN (Dọn dẹp tàn dư, trả về cơ chế mặc định)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}HỦY HOÀN TOÀN${C_RESET} (Dọn dẹp tàn dư, trả về cơ chế mặc định)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      if [[ "$single_choice" == "1" ]]; then wp_action="bat"; action_text="SỬA LỖI & TỐI ƯU"; elif [[ "$single_choice" == "2" ]]; then wp_action="tat"; action_text="HỦY HOÀN TOÀN"; else exec /etc/wptt/wptt-wordpress-main 1; fi
    fi
  fi
fi

if [[ "$wp_action" == "bat" && -z "$phut" ]]; then
  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}THIẾT LẬP THỜI GIAN THỰC THI (CHU KỲ)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Nhập khoảng thời gian (phút) để máy chủ tự động kích hoạt WP-Cron." 2
  left_text "  Chỉ nhận số từ ${C_GREEN}1${C_RESET} đến ${C_GREEN}59${C_RESET}." 2
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  echo -en "${C_CYAN}Nhập số phút [Enter = Mặc định 10 phút]: ${C_RESET}"
  read -r phut
  if [[ ! $phut =~ ^[0-9]+$ ]] || (("$phut" > 59)) || [[ "$phut" == "0" || -z "$phut" ]]; then
    echo -e "${C_YELLOW}Nhập sai hoặc để trống, hệ thống sẽ lấy giá trị an toàn là 10 phút.${C_RESET}"
    phut="10"
  fi
fi

# ==============================================================================
# CÀI ĐẶT GÓI PHỤ THUỘC & THỰC THI
# ==============================================================================
echo ""
thao_tac_thanh_cong=false
PRIORITY_CMD="/usr/bin/ionice -c 3 /usr/bin/nice -n 19"
TOTAL_WP_SITES=$(ls -1 /etc/wptt/vhost/.*.conf 2>/dev/null | grep -v '^\.\.conf$' | wc -l)
mkdir -p /etc/wptt-auto
WORKER_FILE="/etc/wptt-auto/wptt-cron-worker.sh"

for DOMAIN in "${DOMAIN_LIST[@]}"; do
  _runing "$action_text cấu hình wp-config cho website $DOMAIN..."
  . /etc/wptt/php/php-cli-domain-config "$DOMAIN" 2>/dev/null
  . /etc/wptt/vhost/."$DOMAIN".conf 2>/dev/null
  if [[ -z "$User_name_vhost" ]]; then _rundone "Bỏ qua: Không tìm thấy Username cấu hình cho $DOMAIN"; continue; fi
  WP_EXEC="runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp"
  wp_config_path="/usr/local/lsws/$DOMAIN/html/wp-config.php"

  if [[ "$lock_down" == "1" ]]; then chattr -i "$wp_config_path" >/dev/null 2>&1; chmod 644 "$wp_config_path" >/dev/null 2>&1; fi

  if [[ "$wp_action" == "bat" ]]; then
    $WP_EXEC config set DISABLE_WP_CRON true --raw --path="/usr/local/lsws/$DOMAIN/html" >/dev/null 2>&1
    
    # CHỈ TẠO FILE CRON LẺ NẾU SERVER < 50 WEB
    if [[ "$TOTAL_WP_SITES" -lt 30 ]]; then
      cron_file="/etc/cron.d/wp-cron-job-$DOMAIN.cron"
      ubuntu_cron_file="/etc/cron.d/wp-cron-job-${DOMAIN//[.]/_}_cron"
      
      offset_minute=$(( RANDOM % phut ))
      if [[ "$offset_minute" -eq 0 ]]; then cron_time="*/$phut"; else cron_time="${offset_minute}-59/${phut}"; fi
      if [[ "$TOTAL_WP_SITES" -ge 10 ]]; then offset_second=$(( RANDOM % 60 )); sleep_cmd="/usr/bin/sleep $offset_second && "; else sleep_cmd=""; fi

      cat >"$cron_file" <<END
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
$cron_time * * * * root $sleep_cmd$PRIORITY_CMD /usr/bin/flock -n /tmp/wptt_cron_${DOMAIN}.lock /sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp cron event run --due-now --path="/usr/local/lsws/$DOMAIN/html" --quiet >/dev/null 2>&1
END
      if grep -qi "Ubuntu" /etc/*release 2>/dev/null; then ln -sf "$cron_file" "$ubuntu_cron_file"; fi
    fi
  else
    # HỦY TỐI ƯU
    $WP_EXEC config delete DISABLE_WP_CRON --path="/usr/local/lsws/$DOMAIN/html" >/dev/null 2>&1
    cron_file="/etc/cron.d/wp-cron-job-$DOMAIN.cron"
    ubuntu_cron_file="/etc/cron.d/wp-cron-job-${DOMAIN//[.]/_}_cron"
    rm -f "$cron_file" "$ubuntu_cron_file" 2>/dev/null
  fi

  if [[ "$lock_down" == "1" ]]; then chmod 404 "$wp_config_path" >/dev/null 2>&1; chattr +i "$wp_config_path" >/dev/null 2>&1; fi
  echo "$action_text website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cấu hình cho website $DOMAIN"
  thao_tac_thanh_cong=true
  sleep 0.5
done

# ==============================================================================
# XỬ LÝ MÔ HÌNH MASTER CRON (XẾP HÀNG DỌC) CHO VPS >= 30 WEBSITE
# ==============================================================================
if [[ "$TOTAL_WP_SITES" -ge 30 && "$wp_action" == "bat" ]]; then
  _runing "VPS cõng >= 30 Website. Đang kích hoạt mô hình Master Cron (Xếp Hàng Dọc)..."
  
  # Dọn dẹp sạch sẽ cron cá nhân để nhường chỗ cho Master Cron
  rm -f /etc/cron.d/wp-cron-job-*.cron 2>/dev/null
  rm -f /etc/cron.d/wp-cron-job-*_cron 2>/dev/null

  # Sinh file Worker đọc linh hoạt wp-config
  cat >"$WORKER_FILE" <<'EOF'
#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
  DOMAIN="${filepath##*/}"
  DOMAIN="${DOMAIN%.conf}"
  DOMAIN="${DOMAIN#.}"

  wp_config="/usr/local/lsws/$DOMAIN/html/wp-config.php"
  if [[ -f "$wp_config" ]] && grep -qiE "define\s*\(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*true\s*\)" "$wp_config" 2>/dev/null; then
    . "$filepath" 2>/dev/null
    [[ -z "$User_name_vhost" ]] && continue
    phien_ban_php_domain_thuc_thi=${phien_ban_php_domain//[-._]/}
    [[ -z "$phien_ban_php_domain_thuc_thi" ]] && phien_ban_php_domain_thuc_thi=$(ls -d /usr/local/lsws/lsphp[0-9]* 2>/dev/null | grep -Eo '[0-9]+$' | sort -rn | head -n 1)

    /usr/bin/ionice -c 3 /usr/bin/nice -n 19 /sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp cron event run --due-now --path="/usr/local/lsws/$DOMAIN/html" --quiet >/dev/null 2>&1
    
    # Nghỉ 1 giây để nhả CPU cho khách thật truy cập web
    /usr/bin/sleep 1
  fi
done
EOF
  chmod +x "$WORKER_FILE"

  # Ghi file Master Cron
  cat >"$MASTER_CRON_FILE" <<END
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
*/$phut * * * * root /usr/bin/flock -n /tmp/wptt_master_cron.lock /bin/bash $WORKER_FILE >/dev/null 2>&1
END
  _rundone "Kích hoạt mô hình Master Cron thành công!"
fi

# Dọn dẹp Master Cron nếu Hủy toàn bộ Server
if [[ "$wp_action" == "tat" && "$NAME" == "all_off" ]]; then
  rm -f "$MASTER_CRON_FILE" "$WORKER_FILE" 2>/dev/null
fi

# ==============================================================================
# KHỞI ĐỘNG LẠI DỊCH VỤ CRON VÀ HIỂN THỊ KẾT QUẢ
# ==============================================================================
if $thao_tac_thanh_cong; then
  if grep -qi "Ubuntu" /etc/*release 2>/dev/null; then
    systemctl restart cron.service >/dev/null 2>&1
  else
    systemctl restart crond.service >/dev/null 2>&1
  fi

  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HOÀN TẤT CẤU HÌNH WP-CRON${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
    left_text "Phạm vi tác động : ${C_YELLOW}Tất cả ${#DOMAIN_LIST[@]} website${C_RESET}" 2
  else
    left_text "Website thao tác : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
  fi

  if [[ "$wp_action" == "bat" ]]; then
    left_text "Chu kỳ Cronjob   : ${C_GREEN}Chạy $phut phút / Lần${C_RESET}" 2
    if [[ "$TOTAL_WP_SITES" -ge 30 ]]; then
      left_text "Trạng thái mới   : ${C_GREEN}Đã TỐI ƯU (Master Cron - Xếp hàng dọc)${C_RESET}" 2
    elif [[ "$TOTAL_WP_SITES" -ge 10 ]]; then
      left_text "Trạng thái mới   : ${C_GREEN}Đã TỐI ƯU (WP-CLI + Tản tải Giây)${C_RESET}" 2
    else
      left_text "Trạng thái mới   : ${C_GREEN}Đã TỐI ƯU (WP-CLI + Tản tải Phút)${C_RESET}" 2
    fi
  else
    left_text "Trạng thái mới   : ${C_RED}Đã HỦY TỐI ƯU. Trả về WP-Cron mặc định.${C_RESET}" 2
  fi
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi
