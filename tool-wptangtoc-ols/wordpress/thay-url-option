#!/bin/bash

function huong_dan() {
  cat <<'EOF'
  🌐 TÍNH NĂNG: CẬP NHẬT HOME URL & SITE URL CHO WORDPRESS
  Trong WordPress, "Home URL" (địa chỉ trang chủ) và "Site URL" (địa chỉ 
  cài đặt mã nguồn) là hai thông số sống còn quyết định việc website có 
  hiển thị đúng giao diện và truy cập được hay không. 

  Tính năng này giúp bạn tự động chuẩn hóa và cập nhật lại chính xác 
  địa chỉ tên miền vào cơ sở dữ liệu của WordPress chỉ trong 1 giây.

  🚀 KHI NÀO BẠN CẦN DÙNG TÍNH NĂNG NÀY?
   ➜ Clone/Chuyển nhà website: Khi bạn chuyển dữ liệu từ Localhost 
      (máy tính cá nhân) lên Server thực tế, hoặc nhân bản từ tên miền cũ 
      sang tên miền mới, bạn bắt buộc phải cập nhật lại URL để web không 
      bị vỡ giao diện hoặc chuyển hướng (redirect) nhầm về web cũ.
   ➜ Lỗi "Too many redirects": Khi website bị lỗi vòng lặp chuyển hướng, 
      thường do thiết lập sai URL trong database. Công cụ này sẽ "nắn" lại.
   ➜ Kích hoạt SSL (HTTPS): Sau khi cài chứng chỉ SSL, bạn cần đổi 
      toàn bộ URL từ HTTP sang HTTPS để có ổ khóa xanh.

  🧠 SỰ THÔNG MINH CỦA CÔNG CỤ (SMART DETECTION):
   - Tự động nhận diện HTTPS: Hệ thống tự kiểm tra xem chứng chỉ SSL 
     (Let's Encrypt, ZeroSSL...) của bạn còn hạn không, nếu có sẽ tự 
     động thiết lập URL là `https://`, ngược lại dùng `http://`.
   - Giữ nguyên cấu trúc WWW: Nếu website cũ đang chạy `www.domain.com`, 
     hệ thống sẽ tôn trọng tùy chọn này và cập nhật URL có chứa `www`.
   - Tự động xóa Object Cache ngay sau khi cập nhật (Valkey/Redis) để 
     thay đổi có hiệu lực ngay lập tức.
EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh"

. /etc/wptt/echo-color
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_wordpress ➜ $cap_nhat Url home && siteurl${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

. /etc/wptt/tenmien-only-website-by-wordpress
lua_chon_NAME "$cap_nhat home && siteurl"

# --- CHỐT CHẶN THOÁT HIỂM (VỊ TRÍ BẮT BUỘC) ---
[[ "$NAME" == "0" || -z "$NAME" ]] && wptt_quay_ve_menu "${1:-}" 1

path_conf="/etc/wptt/vhost/.$NAME.conf"
[[ ! -f "$path_conf" ]] && {
  echoDo "$ten_mien_nay_khong_ton_tai_tren_he_thong"
	wptt_quay_ve_menu "${1:-}" 1 "enter"
}

path="/usr/local/lsws/$NAME/html"
[[ ! -f "$path/wp-load.php" ]] && {
  echoDo "$he_thong_xac_nhan_ban_khong_su_ma_nguon"
  echoDo "$tinh_nang_nay_chi_danh_cho_ma_nguon_wordpress"
	wptt_quay_ve_menu "${1:-}" 1 "enter"
}

[[ ! -f "$path/wp-config.php" ]] && {
  echoDo "$he_thong_xac_nhan_ban_khong_su_ma_nguon"
  sleep 2
	wptt_quay_ve_menu "${1:-}" 1 "enter"
}

. "$path_conf"
if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
	wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# Khai báo WP_EXEC chuẩn quyền
WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

# --- BƯỚC 1: XÁC ĐỊNH PROTOCOL (HTTP hay HTTPS) ---
protocol="http"
if [[ -f /etc/wptt/ssl/check-ssl-cert-con-kha-dung ]]; then
  if /bin/bash /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$NAME" >/dev/null 2>&1; then
    protocol="https"
  fi
fi


# --- BƯỚC 2: XÁC ĐỊNH PREFIX (có www hay không) ---
current_home=$("${WP_EXEC[@]}" option get home --path="$path" 2>/dev/null)
prefix=""
if echo "$current_home" | grep -q '://www.'; then
  prefix="www."
fi

if [[ -z "$current_home" ]];then
	echo "Lỗi mã nguồn Wordpress của bạn đang bị sự cố không thể tương tác được"
	wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# --- BƯỚC 3: GHÉP CHUỖI VÀ THỰC THI (1 LẦN DUY NHẤT) ---
final_url="${protocol}://${prefix}${NAME}"

UI_STRING=("$cap_nhat Home URL" "website $NAME: $final_url")

_runing "${UI_STRING[@]}"

# Kiểm tra đồng thời cả 2 lệnh. Nếu lệnh 1 thất bại, lệnh 2 sẽ tự động bị hủy (nhờ &&)
if "${WP_EXEC[@]}" option update home "$final_url" --path="$path" >/dev/null 2>&1 && \
	"${WP_EXEC[@]}" option update siteurl "$final_url" --path="$path" >/dev/null 2>&1; then
	"${WP_EXEC[@]}" cache flush --path="$path" >/dev/null 2>&1 #xóa object cache, vì update database mà xóa object cache
	_rundone "${UI_STRING[@]}"
else
	_runloi "${UI_STRING[@]}"
	wptt_quay_ve_menu "${1:-}" 1 "enter"
fi


wptt_logs "INFO" "Update home - siteurl Wordpress website $NAME ($final_url)"
wptt_quay_ve_menu "${1:-}" 0
