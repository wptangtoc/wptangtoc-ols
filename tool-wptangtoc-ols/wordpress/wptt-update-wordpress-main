function huong_dan() {
    cat << 'EOF'
  Tính năng quản lý cập nhật WordPress là một hệ thống toàn diện được tích hợp trong wptangtoc ols để phục vụ hỗ trợ việc quản lý cập nhật của riêng WordPress, giúp người quản trị website dễ dàng theo dõi, kiểm soát và thực hiện việc nâng cấp cho tất cả các thành phần cốt lõi của website, bao gồm: lõi WordPress [core], [themes], và các [plugins].

  Tại sao quản lý cập nhật hiệu quả lại quan trọng?
  * Bảo mật Vững chắc: Giữ cho mọi thành phần của website luôn được vá lỗi bảo mật mới nhất.
  * Ổn định và Tương thích: Đảm bảo các thành phần hoạt động hài hòa với nhau, giảm thiểu xung đột.
  * Tiếp cận Tính năng Mới: Giúp bạn tận dụng được những cải tiến và chức năng mới nhất.
  * Quy trình Làm việc Tối ưu: Đơn giản hóa và hợp lý hóa công việc bảo trì website.

  Tóm lại: Tính năng quản lý cập nhật của WordPress là một công cụ mạnh mẽ và thân thiện, giúp người quản trị website duy trì một trang web an toàn, ổn định, hiện đại và hoạt động hiệu quả bằng cách đơn giản hóa việc theo dõi và áp dụng các bản nâng cấp cần thiết cho toàn bộ hệ thống.
EOF
}

. /etc/wptt/core-functions 2>/dev/null
if [[ -z "${1:-}" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/wptt-header-menu
  header_menu
else
  clear
  # shellcheck source=/dev/null
  . /etc/wptt/echo-color 2>/dev/null
  printf '%b\n' "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"

  # Vẽ tiêu đề phụ lọt lòng 78 ký tự (chống lệch UTF-8)
  center_tmp() {
    local text="$1"
    local clean_len="" len=0 pad_left=0 pad_right=0
    clean_len="$(printf '%b' "$text" | sed 's/\x1B\[[0-9;]*[a-zA-Z]//g' | tr -d '\r\n')"
    len="$(LC_ALL=C.UTF-8 printf '%s' "$clean_len" | wc -m | tr -d ' ' 2>/dev/null)"
    [[ -z "$len" || "$len" == "0" ]] && len="${#clean_len}"

    pad_left=$(((78 - len) / 2))
    ((pad_left < 0)) && pad_left=0
    pad_right=$((78 - len - pad_left))
    ((pad_right < 0)) && pad_right=0
    printf '%b%*s%b%*s%b\n' "${C_CYAN}│${C_RESET}" "$pad_left" "" "$text" "$pad_right" "" "${C_CYAN}│${C_RESET}"
  }

  center_tmp "${C_YELLOW}TRUNG TÂM QUẢN LÝ CẬP NHẬT (WORDPRESS UPDATE)${C_RESET}"
  printf '%b\n' "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
fi

wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null

printf '\n'
echo "${quan_ly_cap_nhat_wordpress:-}" >/dev/null # Dữ liệu ẩn cho bộ tìm kiếm WPTangToc

# ==============================================================================
# TẠO MENU 2 CỘT (TRÁI 1-5: CẬP NHẬT & KIỂM TRA | PHẢI 6-9: HẠ CẤP & CÀI LẠI)
# ==============================================================================
MENU_TITLE="TRUNG TÂM QUẢN LÝ CẬP NHẬT WORDPRESS"

options=(
  "${cap_nhat:-Cập nhật} WordPress Core"                      # 0 (Hiện: 1)
  "${cap_nhat:-Cập nhật} Plugins"                             # 1 (Hiện: 2)
  "${cap_nhat:-Cập nhật} Themes"                              # 2 (Hiện: 3)
  "${cap_nhat:-Cập nhật} WordPress (ALL)"                     # 3 (Hiện: 4)
  "${kiem_tra:-Kiểm tra} ${phien_ban:-phiên bản} WordPress"   # 4 (Hiện: 5)
  "Hạ cấp WordPress Core"                                     # 5 (Hiện: 6)
  "Hạ cấp Plugins"                                            # 6 (Hiện: 7)
  "${cai_lai:-Cài lại} WordPress Core"                        # 7 (Hiện: 8)
  "${cai_lai:-Cài lại} WordPress (ALL)"                       # 8 (Hiện: 9)
)

# Hàm thực thi hành động (khớp tuyệt đối 1-1 với chỉ số mảng options)
run_action() {
  local index="$1"
  local script_path=""
  local script_args="98"

  case "$index" in
    0) script_path="/etc/wptt/wordpress/update-core" ;;
    1) script_path="/etc/wptt/wordpress/update-plugin" ;;
    2) script_path="/etc/wptt/wordpress/update-theme" ;;
    3) script_path="/etc/wptt/wordpress/update-full" ;;
    4) script_path="/etc/wptt/wordpress/kiem-tra-version-wp" ;;
    5) script_path="/etc/wptt/wordpress/ha-cap-phien-ban-wordpress-core" ;;
    6) script_path="/etc/wptt/wordpress/ha-cap-phien-ban-plugins" ;;
    7) script_path="/etc/wptt/wordpress/ghi-de-wordpress-core" ;;
    8) script_path="/etc/wptt/wordpress/wptt-update-reinstall-wordpress" ;;
    *)
      printf '\n%b[!] %s: Index %s.%b\n' "${C_RED}" "${lua_chon_khong_hop_le:-Lựa chọn không hợp lệ}" "$index" "${C_RESET}"
      return 1
      ;;
  esac

  if [[ -x "$script_path" || -f "$script_path" ]]; then
    exec bash "$script_path" "$script_args"
  else
    printf '\n%b[!] Lỗi: Không tìm thấy kịch bản '\''%s'\''.%b\n' "${C_RED}" "$script_path" "${C_RESET}"
    sleep 2
    exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
  fi
}

# ==============================================================================
# BỐ CỤC 2 CỘT CHUẨN UX (TUẦN TỰ 1-5 TRÁI | 6-9 PHẢI, ĐỐI XỨNG THEO NGHIỆP VỤ)
# ==============================================================================
draw_custom_grid() {
  print_row "" "CẬP NHẬT & KIỂM TRA" "" "HẠ CẤP & CÀI LẠI"
  print_row "1" "${options[0]}" "6" "${options[5]}"
  print_row "2" "${options[1]}" "7" "${options[6]}"
  print_row "3" "${options[2]}" "8" "${options[7]}"
  print_row "4" "${options[3]}" "9" "${options[8]}"
  print_row "5" "${options[4]}" ""  ""
}

