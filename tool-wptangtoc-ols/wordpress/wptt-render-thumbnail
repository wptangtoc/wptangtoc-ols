function huong_dan() {
  Tính năng tái tạo thumbnail [hay còn gọi là tái tạo hình ảnh thu nhỏ/ảnh đại diện] trong WordPress là một công cụ hữu ích để tạo lại các phiên bản ảnh với kích thước khác nhau cho những hình ảnh đã được tải lên Thư viện [Media Library] trước đó.

  Thumbnail trong WordPress là gì?
  Khi bạn tải một hình ảnh lên WordPress, hệ thống [cùng với giao diện [theme] và một số plugin] sẽ tự động tạo ra nhiều bản sao của hình ảnh đó với các kích thước khác nhau [ví dụ: ảnh thu nhỏ, ảnh trung bình, ảnh lớn, và các kích thước tùy chỉnh khác do theme/plugin định nghĩa]. Các phiên bản này được sử dụng ở những vị trí khác nhau trên website để tối ưu hiển thị và tốc độ tải trang.

  Tại sao cần tái tạo thumbnail [tính năng/lợi ích]:

  Khi Thay đổi Giao diện [Theme]:
  * Giao diện mới có thể định nghĩa các kích thước ảnh thumbnail khác với giao diện cũ. Những hình ảnh đã tải lên trước đó sẽ không có các kích thước mới này, dẫn đến việc chúng có thể bị hiển thị sai, mờ, hoặc không khớp với bố cục mới. Tái tạo thumbnail sẽ tạo ra các kích thước ảnh cần thiết cho giao diện mới.

  Sau khi Cài đặt/Thay đổi Plugin:
  * Một số plugin [ví dụ: plugin thư viện ảnh, WooCommerce] có thể thêm các kích thước ảnh mới. Bạn cần tái tạo thumbnail để các hình ảnh cũ cũng có những kích thước này.

  Khi Thay đổi Kích thước Ảnh trong Cài đặt:
  * Nếu bạn thay đổi kích thước mặc định của WordPress [trong Cài đặt phương tiện] hoặc một lập trình viên thay đổi các kích thước ảnh tùy chỉnh trong code.

  Khắc phục Sự cố Hiển thị Ảnh:
  * Đôi khi hình ảnh không hiển thị đúng kích thước mong muốn, việc tái tạo thumbnail có thể giúp khắc phục.

  Trong một số trường hợp, các phiên bản ảnh có thể không được chuyển đi đầy đủ hoặc chính xác.

  Tính năng tái tạo thumbnail là một công cụ bảo trì quan trọng cho website WordPress, giúp đảm bảo tất cả hình ảnh của bạn được hiển thị đúng cách và tối ưu trên toàn bộ website, đặc biệt sau khi có những thay đổi liên quan đến giao diện hoặc các plugin xử lý hình ảnh.
}

#render thumbnail bằng cli
#wptt-render-thumbnail all missing, wptt-render-thumbnail domain.com all
# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. /etc/wptt/lang/$ngon_ngu.sh 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}$quan_ly_wordpress ➜ Tái tạo lại Thumbnails (Regenerate)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# XÁC ĐỊNH ĐẦU VÀO TỪ FILE GỌI HOẶC COMMAND LINE
# ==============================================================================
NAME=$1
MODE=$2
CLI_MODE=0

# Xử lý trường hợp Menu chính truyền "98"
if [[ "$NAME" == "98" ]]; then
  NAME=""
  CLI_MODE=0
fi

# Nhận diện CLI: all missing, all all, domain.com missing...
if [[ "${1:-}" == "all" ]]; then
  NAME="Tất cả website"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  CLI_MODE=1
fi

if [[ -n "${2:-}" ]]; then
  if [[ "${2:-}" == "missing" || "${2:-}" == "all" ]]; then
    MODE="${2:-}"
  fi
fi

# ==============================================================================
# NẾU CHƯA CÓ TÊN MIỀN -> GỌI THƯ VIỆN CHỌN DOMAIN
# ==============================================================================
if [[ -z "$NAME" ]]; then
  tinh_nang_ten="Tái tạo Thumbnails"
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# --- CHỐT CHẶN THOÁT HIỂM ---
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi

# ==============================================================================
# HỎI CHẾ ĐỘ TÁI TẠO NẾU CHƯA TRUYỀN VÀO (UX BO CONG 78PX)
# ==============================================================================
if [[ -z "$MODE" && $CLI_MODE -eq 0 ]]; then
  echo ""
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}TÙY CHỌN TÁI TẠO THUMBNAIL${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Bạn đang thao tác cho: ${C_BOLD_WHITE}$NAME${C_RESET}" 2
  left_text "  Vui lòng chọn chế độ tái tạo hình ảnh:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  str_opt1="  1) CÒN THIẾU (Khuyên dùng - Nhanh, chỉ tái tạo ảnh chưa có size)"
  pad_opt1=$((box_inner_width - ${#str_opt1}))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}CÒN THIẾU${C_RESET} (Khuyên dùng - Nhanh, chỉ tái tạo ảnh chưa có size)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

  str_opt2="  2) TẤT CẢ (Chậm - Xóa toàn bộ thumbnail cũ và tạo mới lại từ đầu)"
  pad_opt2=$((box_inner_width - ${#str_opt2}))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} ${C_BOLD_WHITE}TẤT CẢ${C_RESET} (Chậm - Xóa toàn bộ thumbnail cũ và tạo mới lại từ đầu)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  while true; do
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mode_input
    case "$mode_input" in
    0) echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1 && exec /etc/wptt/wptt-wordpress-main 1 ;;
    1)
      MODE="missing"
      break
      ;;
    2)
      MODE="all"
      break
      ;;
    *) echo -e "${C_RED}Nhập sai, vui lòng chọn 1 hoặc 2.${C_RESET}" ;;
    esac
  done
fi

# Fallback mặc định
[[ -z "$MODE" ]] && MODE="missing"

# ==============================================================================
# HÀM XỬ LÝ TÁI TẠO CHO 1 DOMAIN CỤ THỂ
# ==============================================================================
function regenerate_domain() {
  local domain=$1
  local mode=$2

  local path_root="/usr/local/lsws/$domain/html"
  [[ ! -f "$path_root/wp-load.php" ]] && return

  echo -e "\n${C_CYAN}▶ Đang xử lý Website:${C_RESET} ${C_BOLD_WHITE}$domain${C_RESET} ${C_CYAN}(Chế độ: ${mode^^})${C_RESET}"

  # --------------------------------------------------------------------------
  # CƠ CHẾ LOCKING (CHỐNG ĐỤNG ĐỘ TIẾN TRÌNH XỬ LÝ ẢNH)
  # --------------------------------------------------------------------------
  local LOCK_FILE="/tmp/wptt_lock_regenerate_thumb_${domain}.lock"
  exec 200>"$LOCK_FILE"

  if ! flock -n 200; then
    echo -e "  ${C_RED}Lỗi Đụng Độ Tiến Trình:${C_RESET} Website đang được xử lý ảnh bởi một luồng khác."
    echo -e "  ${C_YELLOW}Vui lòng chờ tiến trình đó hoàn tất rồi thử lại để tránh quá tải CPU!${C_RESET}"
    echo "Tái tạo ảnh website $domain nhưng bị xung đột tiến trình: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    return
  fi
  # --------------------------------------------------------------------------

  # --- BẪY LỖI AN TOÀN (TRAP CTRL+C CÓ TÍCH HỢP MỞ KHÓA) ---
  trap 'tput cnorm; kill 0 2>/dev/null; flock -u 200 2>/dev/null; exec 200>&- 2>/dev/null; rm -f "$LOCK_FILE" 2>/dev/null; echo -e "\n${C_RED}[!] Đã huỷ thao tác ngang.${C_RESET}"; exit 1' SIGINT SIGTERM

  # Nạp thông số PHP và Vhost
  . /etc/wptt/php/php-cli-domain-config "$domain"
  . /etc/wptt/vhost/."$domain".conf

  # --- THỰC THI WP-CLI ---
  if [[ "$mode" == "all" ]]; then
    sudo -u "$User_name_vhost" /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp media regenerate --yes --path="$path_root" --allow-root
  else
    sudo -u "$User_name_vhost" /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp media regenerate --only-missing --yes --path="$path_root" --allow-root
  fi

  # --- XÓA CACHE ---
  _runing "Đang xóa Cache cho website $domain..."
  . /etc/wptt/cache/wptt-xoacache "$domain" >/dev/null 2>&1
  _rundone "Xóa Cache thành công."

  echo -e "  ${C_GREEN}✓ Xong!${C_RESET} Đã hoàn thành Regenerate Thumbnail cho website."
  echo "Tái tạo ảnh website $domain: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

  # Gỡ bẫy lỗi và mở khóa
  trap - SIGINT SIGTERM
  flock -u 200
  exec 200>&-
  rm -f "$LOCK_FILE" 2>/dev/null
}

# ==============================================================================
# XÁC ĐỊNH MẢNG THỰC THI (1 HAY ĐỒNG LOẠT)
# ==============================================================================
DOMAIN_LIST=()

# Bao quát toàn bộ các biến thể của chữ "Tất cả" do thư viện hoặc CLI truyền vào
if [[ "$NAME" == "Tất cả website" || "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all" ]]; then
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done
else
  path_root="/usr/local/lsws/$NAME/html"
  [[ ! -f "$path_root/wp-load.php" ]] && echo -e "\n${C_RED}Tên miền không tồn tại hoặc không phải WordPress!${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-wordpress-main 1
  DOMAIN_LIST=("$NAME")
fi

if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
  echo -e "\n${C_RED}Không có website WordPress nào hợp lệ để thao tác!${C_RESET}" && sleep 2 && exit 1
fi

# ==============================================================================
# BẮT ĐẦU VÒNG LẶP THỰC THI
# ==============================================================================
echo ""
_runing "Đang nạp tiến trình Tái tạo Hình ảnh (WP-CLI)..."

for DOMAIN in "${DOMAIN_LIST[@]}"; do
  regenerate_domain "$DOMAIN" "$MODE"
done

# ==============================================================================
# IN BÁO CÁO TỔNG QUAN
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT TÁI TẠO THUMBNAIL${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
  left_text "Phạm vi   : ${C_YELLOW}Toàn bộ ${#DOMAIN_LIST[@]} website${C_RESET}" 2
else
  left_text "Website   : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
fi
left_text "Chế độ    : ${C_GREEN}${MODE^^}${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi
