#!/bin/bash
function huong_dan() {
  Công cụ tối ưu hóa hình ảnh với 2 chế độ:
  1. Lossy: Giảm dung lượng nhiều, giảm chất lượng nhẹ [Khuyên dùng cho Blog/Tin tức].
  2. Lossless: Giữ nguyên 100% chất lượng [Khuyên dùng cho Web ảnh]
}

#Hỗ trợ CLI Mode (Auto): Cho phép gọi lệnh siêu tốc từ bên ngoài.
#wptt-image all lossy (Nén Lossy toàn bộ Server)
#wptt-image domain.com lossless (Nén Lossless cho 1 domain)
# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

# --- 1. SETUP MOI TRUONG ---
if [ -f /etc/redhat-release ]; then
  OS_TYPE="rhel"
elif [ -f /etc/debian_version ]; then
  OS_TYPE="debian"
fi

function install_tools() {
  _runing "Đang kiểm tra và cài đặt công cụ nén ảnh (jpegoptim, pngquant)..."
  if [[ "$OS_TYPE" == "rhel" ]]; then
    if ! rpm -q epel-release >/dev/null 2>&1; then yum install epel-release -y -q; fi
    yum install jpegoptim pngquant optipng pv -y -q >/dev/null 2>&1
  elif [[ "$OS_TYPE" == "debian" ]]; then
    apt-get update -y -q >/dev/null 2>&1
    apt-get install jpegoptim pngquant optipng pv -y -q >/dev/null 2>&1
  fi
  _rundone "Cài đặt công cụ nén ảnh hoàn tất"
}

if ! command -v jpegoptim &>/dev/null || ! command -v pngquant &>/dev/null || ! command -v optipng &>/dev/null || ! command -v pv &>/dev/null; then
  install_tools
fi

# ==============================================================================
# XÁC ĐỊNH ĐẦU VÀO TỪ FILE GỌI HOẶC COMMAND LINE
# ==============================================================================
NAME=$1
MODE=$2
CLI_MODE=0

# Xử lý trường hợp Menu chính truyền "98"
if [[ "$NAME" == "98" ]]; then
  NAME=""
  CLI_MODE=0
fi

# Nhận diện CLI: all lossy, all lossless, domain.com lossy...
if [[ "${1:-}" == "all" ]]; then
  NAME="Tất cả website"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  CLI_MODE=1
fi

if [[ -n "${2:-}" ]]; then
  if [[ "${2:-}" == "lossy" || "${2:-}" == "lossless" ]]; then
    MODE="${2:-}"
  fi
fi

# ==============================================================================
# NẾU CHƯA CÓ TÊN MIỀN -> GỌI THƯ VIỆN CHỌN DOMAIN
# ==============================================================================
if [[ -z "$NAME" ]]; then
  clear
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}$quan_ly_wordpress ➜ Tối ưu hóa dung lượng Hình Ảnh${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  tinh_nang_ten="Tối ưu ảnh"
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# --- CHỐT CHẶN THOÁT HIỂM ---
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi

# ==============================================================================
# HỎI CHẾ ĐỘ NÉN NẾU CHƯA TRUYỀN VÀO (UX BO CONG 78PX)
# ==============================================================================
if [[ -z "$MODE" && $CLI_MODE -eq 0 ]]; then
  echo ""
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}CẤU HÌNH MỨC ĐỘ NÉN ẢNH (JPG & PNG)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  Bạn đang thao tác cho: ${C_BOLD_WHITE}$NAME${C_RESET}" 2
  left_text "  Vui lòng chọn thuật toán nén ảnh bạn muốn sử dụng:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  str_opt1="  1) LOSSY (Khuyên dùng - Nén siêu nhỏ, giảm nhẹ chất lượng)"
  pad_opt1=$((box_inner_width - ${#str_opt1}))
  [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}LOSSY${C_RESET} (Khuyên dùng - Nén siêu nhỏ, giảm nhẹ chất lượng)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

  str_opt2="  2) LOSSLESS (Chỉ nén metadata, giữ nguyên 100% chất lượng gốc)"
  pad_opt2=$((box_inner_width - ${#str_opt2}))
  [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} ${C_BOLD_WHITE}LOSSLESS${C_RESET} (Chỉ nén metadata, giữ nguyên 100% chất lượng gốc)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  while true; do
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mode_input
    case "$mode_input" in
    0) echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1 && exec /etc/wptt/wptt-wordpress-main 1 ;;
    1)
      MODE="lossy"
      break
      ;;
    2)
      MODE="lossless"
      break
      ;;
    *) echo -e "${C_RED}Nhập sai, vui lòng chọn 1 hoặc 2.${C_RESET}" ;;
    esac
  done
fi

# Fallback mặc định
[[ -z "$MODE" ]] && MODE="lossy"

# ==============================================================================
# HÀM XỬ LÝ NÉN ẢNH CHO 1 DOMAIN CỤ THỂ
# ==============================================================================
function optimize_domain() {
  local domain=$1
  local mode=$2

  local path_root="/usr/local/lsws/$domain/html"
  local path_uploads="$path_root/wp-content/uploads"

  [[ ! -d "$path_uploads" ]] && return

  echo -e "\n${C_CYAN}▶ Đang xử lý Website:${C_RESET} ${C_BOLD_WHITE}$domain${C_RESET} ${C_CYAN}(Chế độ: ${mode^^})${C_RESET}"

  # --------------------------------------------------------------------------
  # CƠ CHẾ LOCKING (CHỐNG ĐỤNG ĐỘ TIẾN TRÌNH TỐI ƯU ẢNH)
  # --------------------------------------------------------------------------
  local LOCK_FILE="/tmp/wptt_lock_toi_uu_anh_${domain}.lock"
  exec 200>"$LOCK_FILE"

  if ! flock -n 200; then
    echo -e "  ${C_RED}Lỗi Đụng Độ Tiến Trình:${C_RESET} Website đang được tối ưu ảnh bởi một luồng khác."
    echo -e "  ${C_YELLOW}Vui lòng chờ tiến trình đó hoàn tất rồi thử lại để tránh quá tải CPU!${C_RESET}"
    echo "Tối ưu ảnh website $domain nhưng bị xung đột tiến trình: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
    return # Bỏ qua website này và đi tiếp
  fi
  # --------------------------------------------------------------------------

  local SIZE_BEFORE=$(du -s "$path_uploads" 2>/dev/null | awk '{print $1}')
  local TOTAL_FILES=$(find "$path_uploads" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) 2>/dev/null | wc -l)

  if [[ "$TOTAL_FILES" -eq 0 ]]; then
    echo -e "  ${C_YELLOW}Không tìm thấy hình ảnh nào (JPG/PNG) trong Uploads.${C_RESET}"
    # Giải phóng ổ khóa trước khi thoát
    flock -u 200 && exec 200>&- && rm -f "$LOCK_FILE" 2>/dev/null
    return
  fi

  echo -e "  ${C_YELLOW}Tìm thấy $TOTAL_FILES hình ảnh. Bắt đầu tiến trình nén...${C_RESET}"

  # --- BẪY LỖI AN TOÀN (TRAP CTRL+C CÓ TÍCH HỢP MỞ KHÓA) ---
  trap 'tput cnorm; kill 0 2>/dev/null; flock -u 200 2>/dev/null; exec 200>&- 2>/dev/null; rm -f "$LOCK_FILE" 2>/dev/null; echo -e "\n${C_RED}[!] Đã huỷ thao tác ngang.${C_RESET}"; exit 1' SIGINT SIGTERM

  # --- THỰC THI NÉN ---
  if [[ "$mode" == "lossless" ]]; then
    find "$path_uploads" -type f \( -iname "*.jpg" -o -iname "*.jpeg" \) -print0 2>/dev/null |
      pv -0 -s "$TOTAL_FILES" -N "  [Lossless] JPG" |
      xargs -0 -n 1 -r jpegoptim --strip-all --all-progressive --quiet

    find "$path_uploads" -type f -iname "*.png" -print0 2>/dev/null |
      pv -0 -s "$TOTAL_FILES" -N "  [Lossless] PNG" |
      xargs -0 -n 1 -r optipng -o2 -strip all -quiet
  else
    find "$path_uploads" -type f \( -iname "*.jpg" -o -iname "*.jpeg" \) -print0 2>/dev/null |
      pv -0 -s "$TOTAL_FILES" -N "  [Lossy] JPG   " |
      xargs -0 -n 1 -r jpegoptim --strip-all --all-progressive -m76 --quiet

    find "$path_uploads" -type f -iname "*.png" -print0 2>/dev/null |
      pv -0 -s "$TOTAL_FILES" -N "  [Lossy] PNG   " |
      xargs -0 -n 1 -r pngquant --quality=80-95 --skip-if-larger --strip --force --ext .png
  fi

  # Gỡ bẫy lỗi
  trap - SIGINT SIGTERM
  tput cnorm # Hiện lại con trỏ chuột an toàn

  # --- PHỤC HỒI QUYỀN ---
  . /etc/wptt/vhost/."$domain".conf 2>/dev/null
  if [[ -n "$User_name_vhost" ]]; then
    chown -R "$User_name_vhost":"$User_name_vhost" "$path_uploads" 2>/dev/null
    find "$path_uploads" -type d -print0 2>/dev/null | xargs -0 -r chmod 755
    find "$path_uploads" -type f -print0 2>/dev/null | xargs -0 -r chmod 644
  fi

  local SIZE_AFTER=$(du -s "$path_uploads" 2>/dev/null | awk '{print $1}')
  local SAVED_KB=$((SIZE_BEFORE - SIZE_AFTER))

  # Chỉ tính % nếu SIZE_BEFORE lớn hơn 0
  if [[ $SIZE_BEFORE -gt 0 ]]; then
    local SAVED_MB=$(echo "scale=2; $SAVED_KB / 1024" | bc 2>/dev/null)
    local PERCENT=$(echo "scale=1; ($SAVED_KB / $SIZE_BEFORE) * 100" | bc 2>/dev/null)
    echo -e "  ${C_GREEN}✓ Xong!${C_RESET} Tiết kiệm được: ${C_GREEN}${SAVED_MB} MB${C_RESET} (${C_YELLOW}Giảm ${PERCENT}%${C_RESET})"
  else
    echo -e "  ${C_GREEN}✓ Xong!${C_RESET} Kích thước không thay đổi."
  fi

  # --------------------------------------------------------------------------
  # MỞ KHÓA TIẾN TRÌNH KHI HOÀN TẤT
  # --------------------------------------------------------------------------
  flock -u 200
  exec 200>&-
  rm -f "$LOCK_FILE" 2>/dev/null
}

# ==============================================================================
# XÁC ĐỊNH MẢNG THỰC THI (1 HAY ĐỒNG LOẠT)
# ==============================================================================
DOMAIN_LIST=()

# Bao quát toàn bộ các biến thể của chữ "Tất cả" do thư viện hoặc CLI truyền vào
if [[ "$NAME" == "Tất cả website" || "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all" ]]; then
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done
else
  path_root="/usr/local/lsws/$NAME/html"
  [[ ! -f "$path_root/wp-load.php" ]] && echo -e "\n${C_RED}Tên miền không tồn tại hoặc không phải WordPress!${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-wordpress-main 1
  DOMAIN_LIST=("$NAME")
fi

if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
  echo -e "\n${C_RED}Không có website WordPress nào hợp lệ để thao tác!${C_RESET}" && sleep 2 && exit 1
fi

# ==============================================================================
# BẮT ĐẦU VÒNG LẶP THỰC THI
# ==============================================================================
echo ""
_runing "Đang nạp tiến trình Tối ưu Hình ảnh (Không nên tắt Terminal)..."

for DOMAIN in "${DOMAIN_LIST[@]}"; do
  optimize_domain "$DOMAIN" "$MODE"
done

# ==============================================================================
# IN BÁO CÁO TỔNG QUAN
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT TỐI ƯU HÓA HÌNH ẢNH${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
  left_text "Phạm vi    : ${C_YELLOW}Toàn bộ ${#DOMAIN_LIST[@]} website${C_RESET}" 2
else
  left_text "Website    : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
fi
left_text "Chế độ nén : ${C_GREEN}${MODE^^}${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi
