#!/bin/bash

function huong_dan() {
  cat <<'EOF'
  💡 TÍNH NĂNG: TRUY VẤN VÀ THAY THẾ DỮ LIỆU HÀNG LOẠT (SEARCH & REPLACE)
  Đây là công cụ cực kỳ mạnh mẽ giúp bạn tự động tìm kiếm và thay thế dữ
  liệu trực tiếp bên trong cơ sở dữ liệu (Database) của WordPress.

  🎯 TẠI SAO TÍNH NĂNG NÀY LẠI ĐÁNG GIÁ?
  Hãy tưởng tượng bạn cần đổi một số điện thoại, email hay tên thương hiệu 
  đang nằm rải rác ở hàng trăm, hàng ngàn bài viết và trang sản phẩm. 
  Việc mở từng bài ra để sửa thủ công là "nhiệm vụ bất khả thi" và rất dễ 
  sai sót. Công cụ này sẽ thay bạn làm điều đó chỉ trong vài giây, quét 
  sâu vào database và thay thế chính xác tuyệt đối.

  🚀 CÁC ỨNG DỤNG THỰC TẾ TUYỆT VỜI:
   ➜ Đổi thông tin liên hệ: Thay số điện thoại, email, địa chỉ cũ thành mới.
   ➜ Cập nhật thương hiệu: Đổi tên công ty, tên sản phẩm trên toàn bộ web.
   ➜ Đổi tên miền: Chuyển toàn bộ link từ domain cũ sang domain mới, 
      hoặc cập nhật hàng loạt link từ http sang https.
   ➜ Sửa lỗi chính tả hàng loạt hoặc thay thế mã shortcode cũ.

  🛡️ AN TOÀN TUYỆT ĐỐI (DRY RUN):
  Hệ thống được thiết kế thông minh: luôn quét và "Chạy thử" trước để báo 
  cáo có bao nhiêu kết quả được tìm thấy. Chỉ khi bạn xác nhận "Đồng ý", 
  dữ liệu mới thực sự được thay thế. Không lo thao tác nhầm!

EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8 #từ latin1 sang utf8, nhiều khi anh em dùng bộ gõ tiếng việt: dùng à â nó thêm \xc3 hay \xa9 ... tương thích với bộ gõ tiếng việt telex khi nhập domain

. /etc/wptt/core-functions
wptt_load_main_conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"
. /etc/wptt/echo-color
echo ""
echo ""
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_wordpress ➜ $truy_van_va_thay_the database${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

wptt_check_mariadb "${1:-}" "MariaDB đang bị sập! Hệ thống từ chối không cho phép tối ưu database."

. /etc/wptt/tenmien-only-website-by-wordpress
lua_chon_NAME "$truy_van_va_thay_the database"

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "${1:-}" 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echoDo "Tên miền không tồn tại trên hệ thống này"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  echoDo "Hệ thống xác nhận bạn không sử dụng WordPress"
  echoDo "Tính năng này chỉcó thể hoạt động trên WordPress"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

unset check check2
read -rp "Nhập từ khoá dữ liệu cũ bạn cần thay thế [0=Thoát]: " check
if [[ "$check" = "0" || -z "$check" ]]; then
  wptt_quay_ve_menu "${1:-}" 1
fi

read -rp "Nhập từ khoá dữ liệu mới bạn muốn thay thế vào [0=Thoát]: " check2
if [[ "$check2" = "0" || -z "$check2" ]]; then
  wptt_quay_ve_menu "${1:-}" 1
fi

unset dongy
echo -e "$xac_nhan Bạn có muốn $check thay bằng $check2 trong database của website $NAME không?: "
prompt="$nhap_lua_chon_cua_ban [1-2]: "
dongy="n"
options=("$dong_y" "$khong_dong_y")
PS3="$prompt"
select opt in "${options[@]}"; do
  case "$REPLY" in
  1)
    dongy="y"
    break
    ;;

  2)
    dongy="n"
    break
    ;;

  $((${#options[@]} + 1)))
    printf "\n$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"
    break
    ;;
  *)
    printf "$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"
    break
    ;;
  esac
done

if [[ "$dongy" = 'y' ]]; then
  wptt_load_vhost_conf "$NAME"
  if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
    wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
    _runloi "Không xác định được phiên bản PHP"
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi
  path="/usr/local/lsws/$NAME/html"
  echo "Đang chạy thử (Dry Run)..."
  echo "Thay thế $check thay bằng $check2 trong database website $NAME"
  sleep 2
  if /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp search-replace "${check}" "${check2}" --path="$path" --allow-root --dry-run >/dev/null 2>&1; then #phải chạy thành công thì mới được phép hỏi

    read -rp "Bạn có chắc chắn muốn thay thế thật không? (y/n): " confirm
    if [[ "$confirm" == "y" ]]; then
      _runing "Thay thế $check thay bằng $check2 trong database website $NAME"
      if /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp search-replace "${check}" "${check2}" --path="$path" --allow-root >/dev/null 2>&1; then
        (/bin/bash /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1)
        _rundone "Thay thế $check thay bằng $check2 trong database website $NAME"
      else
        _runloi "Thay thế $check thay bằng $check2 trong database website $NAME"
        wptt_quay_ve_menu "${1:-}" 1 "enter"
      fi
    fi
  else
    echo 'Chạy thử thất bại'
    _runloi "Chạy thử Thay thế $check thay bằng $check2 trong database website $NAME"
    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi
fi

wptt_quay_ve_menu "${1:-}" 0
