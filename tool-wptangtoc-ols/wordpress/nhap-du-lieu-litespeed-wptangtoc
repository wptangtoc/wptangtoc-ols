#!/bin/bash

function huong_dan() {
  Tính năng giúp cài đặt plugin litespeed Cache [Nếu chưa có]
  và đồng thời sẽ import tối ưu litespeed cache theo khuyến nghị của wptangtoc.com
  giúp cải thiện hiệu suất website
}

. /etc/wptt/echo-color
. /etc/wptt/core-functions 2>/dev/null

. /etc/wptt/.wptt.conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

NAME=$1
#chạy từ menu quản lý WordPress
if [[ $NAME = "98" ]]; then
  NAME=""
fi


#chạy từ menu quản lý cache
if [[ $NAME = "99" ]]; then
  NAME=""
fi

tinh_nang_ten="auto import tối ưu plugin LiteSpeed Cache"

check_menu_wptangtoc_active=$1
if [[ $check_menu_wptangtoc_active = "98" ]]; then
	echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
	center_text "${C_BOLD_WHITE}$quan_ly_wordpress ➜ $tinh_nang_ten${C_RESET}"
	echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
fi

if [[ $check_menu_wptangtoc_active = "99" ]]; then
	echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
	center_text "${C_BOLD_WHITE}$quan_ly_cache ➜ $tinh_nang_ten${C_RESET}"
	echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
fi

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

if [[ $NAME = 'Tất cả website' ]]; then
	tien_do='1'
	#tong_so_web biến trong đó đuợc nạp từ thư viện tenmien

	if [[ -z "$tong_so_web" ]]; then
	tong_so_web=0
	for filepath in /etc/wptt/vhost/.*.conf; do
		# Chỉ đếm nếu là file thực sự và không phải là file rác ..conf
		[[ -f "$filepath" && "$filepath" != *"/..conf" ]] && ((tong_so_web++))
	done
fi


	print_border_top
	center_text "${C_YELLOW}DASHBOARD THAO TÁC HÀNG LOẠT${C_RESET}"
	print_border_mid
	left_text "▪ Tổng số   : ${C_GREEN}$tong_so_web website${C_RESET}" 2
	left_text "▪ Nhiệm vụ  : ${C_GREEN}${tinh_nang_ten}${C_RESET}" 2
	print_border_bot


	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}"
		domain="${domain%.conf}"
		domain="${domain#.}"

		if [[ "$domain" == ?*.?* ]]; then
			path="/usr/local/lsws/$domain/html/wp-config.php"
			if [[ -f "$path" ]]; then


				_runing "[ $tien_do / $tong_so_web ] cấu hình LSCache WP cho: $domain"
				wptt_logs "START" "Thao tác hàng loạt: LSCACHE WP cho $domain"
				( /etc/wptt/wordpress/nhap-du-lieu-litespeed-wptangtoc "$domain" >/dev/null 2>&1 )
				exit_status=$?
				if [ "$exit_status" -eq 0 ]; then
					_rundone "[ $tien_do / $tong_so_web ] cấu hình LSCache WP cho: $domain"
					wptt_logs "INFO" "Thao tác hàng loạt: Đã LSCACHE WP thành công cho $domain"
				else
					_runloi "[ $tien_do / $tong_so_web ] cấu hình LSCache WP cho: $domain"
					wptt_logs "ERROR" "Thao tác hàng loạt: Lỗi khi LSCACHE WP cho $domain (Mã lỗi: $exit_status)"
				fi
				((tien_do++))
			fi
		fi
	done


	[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
	[[ ${1:-} == "99" ]] && exec /etc/wptt/wptt-cache-main 1
	exit
fi

. /etc/wptt/echo-color
. /etc/wptt/core-functions 2>/dev/null
if [[ "$NAME" = "0" || -z "$NAME" ]]; then
	[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
	[[ ${1:-} == "99" ]] && exec /etc/wptt/wptt-cache-main 1
	exit;
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "Tên miền không tồn tại trên hệ thống này"
  sleep 3
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-wordpress-main 1
  fi
  return 1 2>/dev/null || exit 1
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Hệ thống xác nhận bạn không sử dụng WordPress"
  echoDo "Tính năng này chỉcó thể hoạt động trên WordPress"
  sleep 3
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-wordpress-main 1
  fi
  return 1 2>/dev/null || exit 1
fi

wptt_logs "INFO" "Import Litespeed By WPTANGTOC file cho website $NAME"

redis_check=$(systemctl status redis.service 2>/dev/null | grep 'Active' | cut -f2 -d':' | xargs | cut -f1 -d' ' | xargs)
if [[ $redis_check = 'active' ]]; then
  data_wptangtoc="wptangtoc-rs.data"
else
  data_wptangtoc="wptangtoc.data"
fi

path="/usr/local/lsws/$NAME/html"

pluginsspeed=(
  wp-rocket
  w3-total-cache
  wp-super-cache
  wp2speed
  nitropack
  wp-fastest-cache
  hummingbird-performance
  swift-performance-lite
  swift-performance-pro
  cache-enabler
  sg-cachepress
  breeze
  wp-meteor
  phastpress
  flying-press
  comet-cache
  powered-cache
  borlabs-cache
  hyper-cache
  wp-speed-of-light
  surge
  nginx-helper
)

for plugintt in ${pluginsspeed[@]}; do
  pathcheckplugin3="/usr/local/lsws/$NAME/html/wp-content/plugins/$plugintt"
  if [[ -d "$pathcheckplugin3" ]]; then
    echo "Bạn đã sử dụng plugin $plugintt WordPress thì không nên kích hoạt LScache để tránh bị xung đột"
    echo "Nếu bạn muốn sử dụng Lscache thì hãy vui lòng xoá plugin $plugintt đi"
    check_menu_wptangtoc_active=$1
    if [[ $check_menu_wptangtoc_active = "98" ]]; then
      exec /etc/wptt/wptt-wordpress-main 1
    fi
  return 1 2>/dev/null || exit 1
  fi
done

. /etc/wptt/vhost/."$NAME".conf

#Bắt buộc file thư viện phải chạy thành công (trả về exit code 0)
if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
  return 1 2>/dev/null || exit 1
fi

#DOUBLE CHECK SAU KHI NẠP THƯ VIỆN
if [[ -z "${phien_ban_php_domain_thuc_thi:-}" ]]; then
  wptt_logs "ERROR" "Biến phien_ban_php_domain_thuc_thi trả về rỗng sau khi nạp thư viện."
  return 1 2>/dev/null || exit 1
fi

pathcheckplugin="/usr/local/lsws/$NAME/html/wp-content/plugins/litespeed-cache"
# Đóng gói lệnh WP-CLI thành một biến để tái sử dụng nhiều lần cho code sạch sẽ
wp_cli=( /sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp --path=$path )

# ====================================================================
# TRƯỜNG HỢP 1: CHƯA CÓ PLUGIN TRÊN Ổ CỨNG (Cần Tải + Kích hoạt)
# ====================================================================
if [[ ! -d "$pathcheckplugin" ]]; then
  _runing "Cài đặt & kích hoạt LiteSpeed Cache"

  # Thêm cờ --activate để tải xong là bật luôn
  if "${wp_cli[@]}" plugin install litespeed-cache --activate >/dev/null 2>&1; then
    
    if [[ -d "$pathcheckplugin" ]]; then
      _rundone "Cài đặt & kích hoạt LiteSpeed Cache"
    else
      _runloi "Cài đặt & kích hoạt LiteSpeed Cache"
      wptt_logs "ERROR" "Lỗi ảo: WP-CLI báo thành công nhưng không có thư mục tại $NAME"
    fi

  else
    _runloi "Cài đặt & kích hoạt LiteSpeed Cache"
    wptt_logs "ERROR" "Lệnh tải LiteSpeed Cache thất bại cho website $NAME"
    [[ -d "$pathcheckplugin" ]] && rm -rf "$pathcheckplugin" # Dọn rác nếu có
  fi

# ====================================================================
# TRƯỜNG HỢP 2: PLUGIN ĐÃ NẰM TRÊN Ổ CỨNG (Cần kiểm tra trạng thái Bật/Tắt)
# ====================================================================
else
  # Lệnh wp plugin is-active trả về 0 nếu đang bật, trả về 1 nếu đang tắt
  if ! "${wp_cli[@]}" plugin is-active litespeed-cache >/dev/null 2>&1; then
    _runing "Bật lại plugin LiteSpeed Cache (đang bị tắt)"
    
    # Ép kích hoạt lại plugin
    if "${wp_cli[@]}" plugin activate litespeed-cache >/dev/null 2>&1; then
      _rundone "Bật lại plugin LiteSpeed Cache (đang bị tắt)"
      wptt_logs "INFO" "Đã kích hoạt thành công LiteSpeed Cache cho $NAME (trước đó bị tắt)"
    else
      _runloi "Bật lại plugin LiteSpeed Cache (đang bị tắt)"
      wptt_logs "ERROR" "Không thể kích hoạt LiteSpeed Cache cho $NAME. Mã nguồn plugin có thể bị hỏng!"
    fi
    
  else
    # Mọi thứ hoàn hảo: Đã có thư mục + Đang Active
    wptt_logs "INFO" "Plugin LiteSpeed Cache đã cài và ĐANG BẬT trên $NAME. Bỏ qua."
  fi
fi


_runing "Cấu hình tối ưu theo cách khuyến nghị của Gia Tuấn"

if [[ -d "$pathcheckplugin" ]]; then
  ip=$(curl -skf --connect-timeout 5 --max-time 10 https://ipv4.icanhazip.com | grep -E -o '(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)' || curl -skf --connect-timeout 5 --max-time 10 https://checkip.amazonaws.com | grep -E -o '(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)')


	if [[ ! -L /usr/local/lsws/"${NAME:?}"/html/wp-config.php ]];then #tránh thực thi nếu wp config.php là symlink
		[[ -f /usr/local/lsws/"${NAME:?}"/html/wp-config.php ]] || "${wp_cli[@]}" config delete WP_CACHE --path="/usr/local/lsws/${NAME:?}/html" --quiet
	fi

  rm -rf /usr/local/lsws/"${NAME:?}"/html/wp-content/cache
  [[ -f /usr/local/lsws/"${NAME:?}"/html/wp-content/object-cache.php ]] && rm -f /usr/local/lsws/"${NAME:?}"/html/wp-content/object-cache.php

  cd "$path" && wget -q --timeout=15 --tries=3 https://wptangtoc.com/share/$data_wptangtoc

  if [[ ! -f $path/$data_wptangtoc ]]; then
	  URL_GITHUB_DATA_Litespeed_cache_plugin="https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/main/$data_wptangtoc"
	  cd "$path" && wget -q --timeout=15 --tries=3 "$URL_GITHUB_DATA_Litespeed_cache_plugin"
  fi



  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp plugin activate litespeed-cache --allow-root --path="$path" >/dev/null 2>&1
  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option import $data_wptangtoc --path="$path" --allow-root >/dev/null 2>&1
  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp option patch update litespeed.conf.server_ip "$ip" --path="$path" --allow-root >/dev/null 2>&1

  if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
    duong_dan_config_redis="/etc/redis/redis.conf"
    duong_path_memcached_config="/etc/memcached.conf"
  else
    duong_dan_config_redis="/etc/redis.conf"
    duong_path_memcached_config="/etc/sysconfig/memcached"
  fi

	# ==============================================================================
  # NHẬN DIỆN ENGINE & CHUẨN BỊ LỆNH PING CÓ ACL
  # ==============================================================================
  # Giải mã Master Pass để dùng cho lệnh PING vượt ải bảo mật
	raw_master_pass=""
	[[ -n "$REDIS_MASTER_PASS" ]] && raw_master_pass=$(wptt_giai_ma "$REDIS_MASTER_PASS")

	# Tối ưu: Bổ sung check cả hậu tố -server cho chính xác tuyệt đối
	if systemctl is-active --quiet valkey-server 2>/dev/null || systemctl is-active --quiet valkey 2>/dev/null; then
		ACTIVE_CACHE="Valkey"
		CLI_TOOL="valkey-cli"
		SOCKET_PATH="/var/run/valkey/valkey.sock"
	elif systemctl is-active --quiet keydb-server 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null; then
		ACTIVE_CACHE="KeyDB"
		CLI_TOOL="keydb-cli"
		SOCKET_PATH="/var/run/keydb/keydb.sock"
	elif systemctl is-active --quiet redis-server 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null; then
		ACTIVE_CACHE="Redis"
		CLI_TOOL="redis-cli"
		SOCKET_PATH="/var/run/redis/redis.sock"
	fi

	# SỬ DỤNG MẢNG (ARRAY) CHO LỆNH PING: Tránh lỗi rớt biến nếu mật khẩu có ký tự đặc biệt
	if [[ -S "$SOCKET_PATH" ]]; then
		if [[ -n "$raw_master_pass" ]]; then
			PING_CMD=("$CLI_TOOL" "-s" "$SOCKET_PATH" "-a" "$raw_master_pass" "--no-auth-warning" "ping")
		else
			PING_CMD=("$CLI_TOOL" "-s" "$SOCKET_PATH" "ping")
		fi
	else
		# Fallback nếu ai đó lỡ cấu hình TCP thủ công
		if [[ -n "$raw_master_pass" ]]; then
			PING_CMD=("$CLI_TOOL" "-a" "$raw_master_pass" "--no-auth-warning" "ping")
		else
			PING_CMD=("$CLI_TOOL" "ping")
		fi
	fi

	# KÍCH HOẠT VÀ NẠP CẤU HÌNH LSCache
	# Lưu ý: Bọc thêm tr -d '\r' để dọn dẹp ký tự xuống dòng rác (nếu có) từ kết quả PONG
	if [ "$("${PING_CMD[@]}" 2>/dev/null | tr -d '\r')" = "PONG" ]; then 
		if [[ -f "$path"/wp-content/.litespeed_conf.dat ]];then
			rm -f "$path"/wp-content/.litespeed_conf.dat #phải xóa cái này nếu có để tạo lại object cache, file cũ có thể userr nó khg chuẩn phải clear tái tạo chuẩn xác
		fi
		/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-port 0 --allow-root --path="$path" >/dev/null 2>&1
		/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object true --allow-root --path="$path" >/dev/null 2>&1
		/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-kind 1 --allow-root --path="$path" >/dev/null 2>&1
		/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-host "$SOCKET_PATH" --allow-root --path="$path" >/dev/null 2>&1

		if [[ -n "$REDIS_MASTER_PASS" ]]; then # Xác định có sử dụng ACL
			pass_show=$(wptt_giai_ma "$redis_acl_pass")
			if [[ -n "$redis_acl_user" && -n "$pass_show" ]]; then
				/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-user "$redis_acl_user" --allow-root --path="$path" >/dev/null 2>&1
				/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-pswd "$pass_show" --allow-root --path="$path" >/dev/null 2>&1
				/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-db_id "$redis_db_id" --allow-root --path="$path" >/dev/null 2>&1
			fi
		fi

  else
    if [[ -f $duong_path_memcached_config ]]; then #nếu như memcached đã được cài, mà redis/valkey/keydb không support thì sẽ triển khai memcached
      /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-port 0 --allow-root --path="$path" >/dev/null 2>&1
      /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object true --allow-root --path="$path" >/dev/null 2>&1
      /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-host /var/run/memcached/memcached.sock --allow-root --path="$path" >/dev/null 2>&1
      /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-kind '' --allow-root --path="$path" >/dev/null 2>&1
    fi
  fi

  if [ "$("${PING_CMD[@]}" 2>/dev/null | tr -d '\r')" = "PONG" ] || [[ -f $duong_path_memcached_config ]]; then        #kiểm tra xem thưc redis/valkey/keydb có hoạt động cái nào không
    if [[ -f /usr/local/lsws/$NAME/html/wp-config.php ]]; then                                     #file wp-config.php tồn tại, xác định
      if [[ $(cat /usr/local/lsws/"$NAME"/html/wp-config.php | grep WP_CACHE_KEY_SALT) = '' ]]; then #không có cấu hình WP_CACHE_KEY_SALT, xác định
        sed -i "/define( 'WP_CACHE_KEY_SALT'/d" /usr/local/lsws/"$NAME"/html/wp-config.php && sed -i "/^define( 'NONCE_SALT'/a define( 'WP_CACHE_KEY_SALT', '$NAME' );" /usr/local/lsws/"$NAME"/html/wp-config.php
        /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp config shuffle-salts WP_CACHE_KEY_SALT --force --path=/usr/local/lsws/"$NAME"/html --allow-root >/dev/null 2>&1
      fi
    fi
  fi

  if [ ! "$("${PING_CMD[@]}" 2>/dev/null | tr -d '\r')" = "PONG" ] && [[ ! -f $duong_path_memcached_config ]]; then
    /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object false --allow-root --path="$path" >/dev/null 2>&1
    /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object-host '' --allow-root --path="$path" >/dev/null 2>&1
  fi

  if [[ -d /usr/local/lsws/$NAME/html/wp-content/plugins/redis-cache || -d /usr/local/lsws/$NAME/html/wp-content/plugins/wp-redis ]]; then
    /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp litespeed-option set object false --allow-root --path="$path" >/dev/null 2>&1
  fi

  if [[ -d /usr/local/lsws/$NAME/html/wp-content/plugins/wptangtoc && ! -L /usr/local/lsws/"$NAME"/html/wp-config.php ]]; then
    sed -i "/LITESPEED_NO_PAGEOPTM/d" /usr/local/lsws/"$NAME"/html/wp-config.php
    sed -i "/<?php/a define('LITESPEED_NO_PAGEOPTM', true);" /usr/local/lsws/"$NAME"/html/wp-config.php
    sed -i "/LITESPEED_NO_LAZY/d" /usr/local/lsws/"$NAME"/html/wp-config.php
    sed -i "/<?php/a define('LITESPEED_NO_LAZY', true);" /usr/local/lsws/"$NAME"/html/wp-config.php
    sed -i "/LITESPEED_NO_OPTM/d" /usr/local/lsws/"$NAME"/html/wp-config.php
    sed -i "/<?php/a define('LITESPEED_NO_OPTM', true);" /usr/local/lsws/"$NAME"/html/wp-config.php
    /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp option patch update litespeed.conf.media-iframe_lazy '' --path=/usr/local/lsws/"$NAME"/html --allow-root 2>/dev/null
  fi

  rm -f ${data_wptangtoc:?}
  /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp rewrite flush --allow-root --path="$path" >/dev/null 2>&1

  #xoá opcache
. /etc/wptt/cache/lib-opcache-clear
wptt_xoa_opcache "$NAME"

  wptt_smart_reload_lsws >/dev/null 2>&1
  _rundone "Cấu hình tối ưu theo cách khuyến nghị của Gia Tuấn"
fi

