#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null

function huong_dan() {
  cat <<'EOF'
  🔍 TÍNH NĂNG: KIỂM TRA PHIÊN BẢN WORDPRESS (CORE, PLUGINS, THEMES)
  Thay vì phải đăng nhập vào trang quản trị (wp-admin) rườm rà và chờ đợi 
  tải trang, công cụ này sẽ giao tiếp trực tiếp với hệ sinh thái WordPress 
  thông qua WP-CLI để xuất báo cáo toàn diện chỉ trong vài giây.

  🚀 NHỮNG GÌ CÔNG CỤ NÀY SẼ BÁO CÁO?
   ➜ WordPress Core: Kiểm tra chính xác phiên bản mã nguồn nền tảng.
   ➜ Danh sách Plugins: Liệt kê toàn bộ Plugin đang có trên website, hiển thị 
      rõ phiên bản đang dùng và BÁO CÁO PHIÊN BẢN MỚI (nếu có bản cập nhật).
   ➜ Danh sách Themes: Hiển thị chi tiết các giao diện (Themes) đang cài đặt 
      và tình trạng cập nhật của chúng.

  🛡️ TẠI SAO TÍNH NĂNG NÀY RẤT QUAN TRỌNG?
   - Rà soát bảo mật: Plugin/Theme cũ, không được cập nhật là nguyên nhân 
     số 1 (chiếm 90%) khiến website bị dính mã độc. Bảng báo cáo này giúp 
     bạn "nhìn thấu" ngay lập tức thành phần nào đang lỗi thời.
   - Siêu tốc & Tiện lợi: Chạy hoàn toàn dưới nền dòng lệnh, không tiêu tốn 
     tài nguyên Web Server. Giúp bạn kiểm tra nhanh trước khi quyết định 
     có nên bấm nút "Cập nhật tất cả" hay không.
   - Chuẩn quyền (Isolated): Tự động nhận diện phiên bản PHP riêng biệt của 
     từng website để thực thi lệnh an toàn.
EOF
}

wptt_load_main_conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

. /etc/wptt/echo-color

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_cap_nhat_wordpress ➜ Kiểm tra phiên bản WordPress${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
if [[ $NAME = "98" ]]; then
	NAME=''
fi

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-only-website-by-wordpress
  lua_chon_NAME "Kiểm tra phiên bản WordPress"
fi

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "${1:-}" 0
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "Tên miền không tồn tại trên hệ thống này"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  echo "He thong xac nhan ban chua kich hoat su dung WordPress"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi
unset path version
path="/usr/local/lsws/$NAME/html"
wptt_load_vhost_conf "$NAME"

version=$(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp core version --allow-root --path="$path")
echo "website $NAME Đang sử dụng Core WordPress $phien_ban: $version               "
echo "Phiên bản Plugins website $NAME:"
/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp plugin list --fields=name,version,update_version --allow-root --path="$path"
echo "Phiên bản Themes website $NAME:"
/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp theme list --fields=name,version,update_version --allow-root --path="$path"
check_menu_wptangtoc_active=$1
if [[ $check_menu_wptangtoc_active = "98" ]]; then
  wptt_quay_ve_menu "${1:-}" 0 "enter"
fi
