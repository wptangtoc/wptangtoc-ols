#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null

function huong_dan() {
  tính năng thay đổi salt WordPress đề cập đến việc cập nhật các Khóa bảo mật và Salt [Security Keys and Salts] trong file wp-config.php của website WordPress. Đây là một biện pháp quan trọng để tăng cường bảo mật cho website của bạn.

  Salt WordPress là gì?
  Đó là một tập hợp các chuỗi ký tự ngẫu nhiên, dài và phức tạp được WordPress sử dụng để mã hóa thông tin nhạy cảm, đặc biệt là mật khẩu người dùng và cookies [dữ liệu lưu trữ phiên đăng nhập]. Chúng thêm một lớp gia vị [salt] vào quá trình mã hóa, làm cho việc giải mã mật khẩu hoặc giả mạo phiên đăng nhập trở nên khó khăn hơn rất nhiều, ngay cả khi kẻ tấn công có được bản sao cơ sở dữ liệu.

  Có 8 khóa và salt: AUTH_KEY, SECURE_AUTH_KEY, LOGGED_IN_KEY, NONCE_KEY, AUTH_SALT, SECURE_AUTH_SALT, LOGGED_IN_SALT, và NONCE_SALT.

  Tại sao cần thay đổi [tính năng/lợi ích]:

  Tăng cường Bảo mật Nghiêm ngặt:
  * Vô hiệu hóa các phiên đăng nhập hiện tại: Khi bạn thay đổi các salt này, tất cả các cookies đăng nhập hiện tại của người dùng sẽ trở nên vô hiệu. Điều này buộc tất cả người dùng [bao gồm cả admin] phải đăng nhập lại.
  * Quan trọng sau sự cố bảo mật: Nếu bạn nghi ngờ website đã bị xâm nhập hoặc có khả năng bị lộ thông tin đăng nhập, việc thay đổi salt ngay lập tức sẽ giúp ngăn chặn kẻ tấn công tiếp tục sử dụng các phiên đăng nhập đã bị đánh cắp.
  * Khi tiếp quản website: Nếu bạn mới tiếp quản một website WordPress từ người khác, việc thay đổi salt là một bước bảo mật tốt để đảm bảo không có cửa hậu nào tồn tại.

  Làm Khó khăn cho Kẻ tấn công:
  * Các salt độc nhất làm cho việc sử dụng các kỹ thuật tấn công dựa trên bảng tra cầu vồng [rainbow table attacks] để dò mật khẩu trở nên kém hiệu quả hơn nhiều.

  Thay đổi salt WordPress là một tính năng bảo mật quan trọng, giúp bảo vệ thông tin đăng nhập và phiên làm việc của người dùng bằng cách làm cho quá trình mã hóa trở nên mạnh mẽ hơn. Đây là một hành động nên thực hiện định kỳ hoặc ngay khi có dấu hiệu bất thường về bảo mật.
}

. /etc/wptt/.wptt.conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"
. /etc/wptt/echo-color
tinh_nang_ten="Thay đổi salt cookie"

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_wordpress ➜ $tinh_nang_ten${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
[[ $NAME == '98' ]] && NAME=''
if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

if [[ "$NAME" == 'Tất cả website' ]]; then
	tien_do='1'

	if [[ -z "$tong_so_web" ]]; then
	tong_so_web=0
	for filepath in /etc/wptt/vhost/.*.conf; do
		# Chỉ đếm nếu là file thực sự và không phải là file rác ..conf
		[[ -f "$filepath" && "$filepath" != *"/..conf" ]] && ((tong_so_web++))
	done
fi


	print_border_top
	center_text "${C_YELLOW}DASHBOARD THAO TÁC HÀNG LOẠT${C_RESET}"
	print_border_mid
	left_text "▪ Tổng số   : ${C_GREEN}$tong_so_web website${C_RESET}" 2
	left_text "▪ Nhiệm vụ  : ${C_GREEN}Thay đổi salt cookie${C_RESET}" 2
	print_border_bot

	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}"
		domain="${domain%.conf}"
		domain="${domain#.}"

		if [[ "$domain" == ?*.?* ]]; then
			path="/usr/local/lsws/$domain/html"
			if [[ -f "$path/wp-config.php" ]]; then

				if [[ -L "$path/wp-config.php" ]]; then #nếu wp-config.php chỉ là symlink thì không được triển khai thực thi tránh theo thang đặc quyền
					continue
				fi

				_runing "[ $tien_do / $tong_so_web ] Thay đổi salt cookie cho $domain"
				# Gọi chính file này để xử lý cho từng domain
				(/etc/wptt/wordpress/thay-salt "$domain" >/dev/null 2>&1)
				_rundone "[ $tien_do / $tong_so_web ] Thay đổi salt cookie cho $domain"
				((tien_do++)) # Tăng tiến độ sau mỗi lần chạy xong
			fi
		fi
	done

	[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
	exit
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt/wptt-wordpress-main 1

path_conf="/etc/wptt/vhost/.$NAME.conf"
[[ ! -f "$path_conf" ]] && echoDo "Domain không tồn tại trên hệ thống." && exec /etc/wptt/wptt-wordpress-main 1

path="/usr/local/lsws/$NAME/html"

if [[ -d /usr/local/lsws/$NAME/html_clean ]];then #làm tương thích với clean mã nguồn 
	path="/usr/local/lsws/$NAME/html_clean"
fi

pathcheckwp="$path/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Hệ thống xác nhận bạn không sử dụng WordPress"
  echoDo "Tính năng này chỉcó thể hoạt động trên WordPress"
  sleep 3
  return 2>/dev/null
  exec /etc/wptt/wptt-wordpress-main 1
  exit
fi

wptt_logs "INFO" "Thay đổi salt cookie WordPress website $NAME"
_runing "Thay đổi salt cookie cho $NAME"

. "$path_conf"
wp_config_path="$path/wp-config.php"

# Gỡ bỏ chattr nếu đang lock_down
[[ $lock_down ]] && chattr -i "$wp_config_path"

# KIỂM TRA LỚP 1: Đảm bảo wp-config.php có quyền ghi trước khi thao tác
if [[ ! -w "$wp_config_path" ]]; then
  echo -en "\033[1A\033[2K\r"
  _runloi "Lỗi: File wp-config.php không có quyền ghi. Không thể thay đổi salt!"
  [[ $lock_down ]] && chattr +i "$wp_config_path"
  [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
  return 1 2>/dev/null || exit 1
fi


if [[ -L "$wp_config_path" ]]; then #xách định wp-config.php có phải symlink không?
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_RED}│   CẢNH BÁO BẢO MẬT: PHÁT HIỆN SYMLINK TẠI WP-CONFIG.PHP                   │${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "  Hệ thống nhận thấy tệp ${C_YELLOW}wp-config.php${C_RESET} là một liên kết ảo (Symlink)."
  echo -e "  Để ngăn chặn rủi ro hacker lợi dụng Symlink đánh lừa máy chủ ghi đè"
  echo -e "  các tệp tin hệ điều hành, tiến trình này đã bị chặn tự động an toàn."
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "${C_CYAN}  HƯỚNG DẪN CÁCH KHẮC PHỤC:${C_RESET}"
  echo -e "  1. Truy cập thư mục: ${C_YELLOW}$path${C_RESET}"
  echo -e "  2. Xóa liên kết ảo wp-config.php hiện tại đi."
  echo -e "  3. Copy/Tạo lại một file wp-config.php vật lý (file thật) vào đó."
  echo -e "  4. Chạy lại tính năng này sau khi đã xử lý xong."
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  sleep 4
  [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
  return 2>/dev/null || exit 1
fi


. /etc/wptt/php/php-cli-domain-config "$NAME"

# FIX LỖI Ở ĐÂY: Khai báo WP_EXEC dưới dạng Mảng (Array) để tương thích với "${WP_EXEC[@]}"
WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

# KIỂM TRA LỚP 2: Bắt lỗi trực tiếp từ tiến trình WP-CLI khi Shuffle Salts
if ! "${WP_EXEC[@]}" config shuffle-salts --path="$path" >/dev/null 2>&1; then
  _runloi "Lỗi WP-CLI: Cập nhật salt thất bại (Kiểm tra lại cú pháp wp-config.php)"
  [[ $lock_down ]] && chattr +i "$wp_config_path"
  [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
  return 1 2>/dev/null || exit 1
fi

# Xử lý WP_CACHE_KEY_SALT (Đảm bảo chỉ tồn tại 1 dòng duy nhất)
# Xóa các dòng trùng lặp nếu có
for line_num in $(grep -n "define( 'WP_CACHE_KEY_SALT'" "$wp_config_path" | head -n -1 | cut -d: -f1 | tac); do
  sed -i "${line_num}d" "$wp_config_path"
done

# Kiểm tra nếu chưa có thì thêm mới
if ! grep -q "WP_CACHE_KEY_SALT" "$wp_config_path"; then
  # Tối ưu dùng Regex chèn an toàn tránh lỗi extra characters
  sed -i "s|^define( 'NONCE_SALT'.*|&\ndefine( 'WP_CACHE_KEY_SALT', '$NAME' );|" "$wp_config_path"
fi

if ! "${WP_EXEC[@]}" config shuffle-salts WP_CACHE_KEY_SALT --force --path="$path" >/dev/null 2>&1; then
  _runloi "Lỗi WP-CLI: Không thể thay đổi WP_CACHE_KEY_SALT"
  [[ $lock_down ]] && chattr +i "$wp_config_path"
  [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
  return 1 2>/dev/null || exit 1
fi

# KIỂM TRA LỚP 3: Sanity check - Đảm bảo file cấu hình không bị hỏng sau khi xử lý
if ! grep -q "AUTH_KEY" "$wp_config_path"; then
  _runloi "Lỗi Nghiêm Trọng: Cấu trúc Salt trong wp-config.php bị hỏng!"
  [[ $lock_down ]] && chattr +i "$wp_config_path"
  [[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1
  return 1 2>/dev/null || exit 1
fi

# Xóa opcache cache
. /etc/wptt/cache/lib-opcache-clear
wptt_xoa_opcache "$NAME"

# Đóng giáp chattr lại
[[ $lock_down ]] && chattr +i "$wp_config_path"

_rundone "Thay đổi salt cookie cho $NAME"

[[ ${1:-} == "98" ]] && exec /etc/wptt/wptt-wordpress-main 1 #để trở về menu
