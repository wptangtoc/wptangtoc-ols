#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  THAY ĐỔI TIỀN TỐ DATABASE WORDPRESS (DATABASE PREFIX)

  WordPress mặc định sử dụng tiền tố bảng Database là wp_.
  Tính năng này cho phép tự động thay đổi tiền tố mặc định thành
  một chuỗi ngẫu nhiên riêng biệt, giúp tăng cường bảo mật cho website.

  Việc thay đổi tiền tố giúp giảm khả năng các công cụ khai thác tự động
  dựa trên cấu trúc Database mặc định của WordPress.

  TÍNH NĂNG NỔI BẬT:
  * Tự động tạo tiền tố ngẫu nhiên:
    Hệ thống sinh tiền tố mới gồm các ký tự chữ thường và số,
    hạn chế sử dụng tiền tố mặc định wp_.

  * Tự động đổi tên bảng Database:
    Chuyển đổi các bảng WordPress từ tiền tố cũ sang tiền tố mới
    mà không cần thao tác thủ công trên MariaDB/MySQL.

  * Cập nhật dữ liệu WordPress:
    Tự động điều chỉnh các khóa option_name và meta_key liên quan
    đến tiền tố cũ trong các bảng Options và Usermeta.

  * Cập nhật cấu hình WordPress:
    Tự động sửa biến $table_prefix trong wp-config.php
    để WordPress tiếp tục nhận diện đúng các bảng Database.

  * Tự động làm sạch Cache:
    Hỗ trợ xóa OPcache, Object Cache
    nhằm hạn chế sử dụng dữ liệu cấu hình cũ sau khi thay đổi.

  * Xác thực kết quả:
    Hệ thống kiểm tra lại tiền tố Database sau khi thực hiện,
    giúp phát hiện trường hợp thay đổi chưa thành công.

  * Bảo vệ cấu hình:
    Kiểm tra wp-config.php có phải Symlink hay không
    để hạn chế nguy cơ ghi đè tệp tin ngoài ý muốn.

  LỢI ÍCH KHI SỬ DỤNG:
  * Hạn chế việc sử dụng tiền tố Database mặc định wp_.
  * Giảm khả năng bị khai thác bởi các công cụ tấn công tự động
    nhắm vào cấu trúc Database WordPress phổ biến.
  * Tăng tính riêng biệt trong cấu trúc Database của từng website.
  * Tự động hóa quá trình thay đổi tiền tố, giảm thao tác thủ công.
  * Hạn chế lỗi cấu hình nhờ tự động cập nhật wp-config.php.
  * Phù hợp với website WordPress đơn lẻ cần tăng cường bảo mật.

  CÁCH SỬ DỤNG:
  1. Chọn website WordPress cần thay đổi tiền tố Database.
  2. Hệ thống kiểm tra website và cấu hình PHP hiện tại.
  3. Kiểm tra tiền tố Database đang sử dụng.
  4. Xác nhận thay đổi tiền tố cũ sang tiền tố ngẫu nhiên mới.
  5. Chờ hệ thống đổi tên bảng, cập nhật cấu hình và làm sạch Cache.
  6. Kiểm tra lại website sau khi hoàn tất.

  ⚠️ LƯU Ý QUAN TRỌNG
  * BẮT BUỘC sao lưu Database và mã nguồn trước khi thực hiện.
  * Không nên thực hiện trên website đang có lưu lượng truy cập cao
    nếu chưa có kế hoạch bảo trì phù hợp.
  * Nếu quá trình đổi tên bảng hoặc cập nhật cấu hình bị gián đoạn,
    website có thể gặp lỗi kết nối Database hoặc lỗi hiển thị.
  * Hãy kiểm tra website sau khi hoàn tất, bao gồm trang chủ,
    trang quản trị WordPress, bài viết và các Plugin quan trọng.
  * Tính năng hiện không hỗ trợ WordPress Multisite.
  * Tính năng sẽ từ chối thực hiện nếu phát hiện wp-config.php là Symlink.
  * Việc thay đổi tiền tố Database KHÔNG thay thế các biện pháp bảo mật
    quan trọng như cập nhật WordPress, Plugin, Theme và sử dụng mật khẩu mạnh.
  * Tiền tố Database không phải cơ chế bảo mật tuyệt đối.
    Đây chỉ là một lớp tăng cường bảo mật bổ sung.

  Khuyến nghị:
  Hãy sao lưu đầy đủ trước khi thay đổi tiền tố Database.
  Chỉ thực hiện khi bạn hiểu rõ thao tác và có khả năng khôi phục
  website nếu xảy ra sự cố.

EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh"

. /etc/wptt/echo-color

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_wordpress ➜ $thay_doi $tien_to database${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

. /etc/wptt/tenmien-only-website-by-wordpress
lua_chon_NAME "$thay_doi $tien_to database"

[[ "$NAME" == "0" || -z "$NAME" ]] && wptt_quay_ve_menu "${1:-}" 1

path_conf="/etc/wptt/vhost/.$NAME.conf"

# Kiểm tra an toàn bằng khối { ... }
[[ ! -f "$path_conf" ]] && {
  echoDo "Tên miền không tồn tại trên hệ thống này"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
}

path="/usr/local/lsws/$NAME/html"

# Kiểm tra an toàn bằng khối { ... }
[[ ! -f "$path/wp-load.php" ]] && {
  echoDo "Hệ thống xác nhận bạn không sử dụng WordPress"
  echoDo "Tính năng này chỉ có thể hoạt động trên WordPress"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
}

# Kiểm tra Multisite bằng Regex an toàn xuyên comment
check_multisite=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]MULTISITE['\"]" "$path/wp-config.php" 2>/dev/null | awk -F"['\"]" '{print $4}')
if [[ "$check_multisite" == 'true' ]]; then
  echoDo "Tính năng này không hỗ trợ website WordPress Multisite"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

wptt_check_mariadb "${1:-}"
#chạy lệnh [[ -L "/usr/local/lsws/$NAME/html/wp-config.php" ]], Bash sẽ chỉ kiểm tra chính cái điểm cuối cùng (tức là file wp-config.php). Nó không bận tâm việc các thư mục cha (như $NAME hay html) có phải là symlink hay không.
# Chống tấn công Symlink (Ghi đè file hệ thống /etc/shadow)
if [[ -L "$path/wp-config.php" ]]; then #xách định wp-config.php có phải symlink không?
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_RED}│   CẢNH BÁO BẢO MẬT: PHÁT HIỆN SYMLINK TẠI WP-CONFIG.PHP                   │${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "  Hệ thống nhận thấy tệp ${C_YELLOW}wp-config.php${C_RESET} là một liên kết ảo (Symlink)."
  echo -e "  Để ngăn chặn rủi ro hacker lợi dụng Symlink đánh lừa máy chủ ghi đè"
  echo -e "  các tệp tin hệ điều hành, tiến trình này đã bị chặn tự động an toàn."
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "${C_CYAN}  HƯỚNG DẪN CÁCH KHẮC PHỤC:${C_RESET}"
  echo -e "  1. Truy cập thư mục: ${C_YELLOW}$path${C_RESET}"
  echo -e "  2. Xóa liên kết ảo wp-config.php hiện tại đi."
  echo -e "  3. Copy/Tạo lại một file wp-config.php vật lý (file thật) vào đó."
  echo -e "  4. Chạy lại tính năng này sau khi đã xử lý xong."
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

. "$path_conf"
if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# Khai báo WP_EXEC chuẩn quyền User
WP_EXEC=(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp)

unset NEW_PREFIX OLD_PREFIX dongy

# Sinh tiền tố mới (Sử dụng chữ thường a-z và số để an toàn tuyệt đối với mọi hệ điều hành MySQL)
ramdom_db=$(openssl rand -base64 32 | tr -dc 'a-z0-9' | head -c 5)
NEW_PREFIX="${ramdom_db}_"

# Lấy tiền tố cũ
OLD_PREFIX=$("${WP_EXEC[@]}" db prefix --path="$path" 2>/dev/null)
tien_to_cu="$OLD_PREFIX"

# ==============================================================================
# SỬ DỤNG HÀM XÁC NHẬN CHUẨN UX WPTANGTOC OLS
# ==============================================================================
echo ""
if ! wptt_xac_nhan "Bạn có chắc chắn muốn thay đổi tiền tố DB cho $NAME không?" "Tiền tố sẽ được đổi từ ${C_YELLOW}$tien_to_cu${C_RESET} thành ${C_GREEN}${NEW_PREFIX}${C_RESET}" "Lưu ý: Hãy BACKUP website trước khi sử dụng tính năng này! " "Đồng ý (Thay đổi)" "Hủy thao tác"; then
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
  wptt_quay_ve_menu "${1:-}" 1
fi

echo ""
wp_config_path="$path/wp-config.php"

# Mở khóa chattr
[[ $lock_down ]] && chattr -i "$wp_config_path"

UI_STRING="$thay_doi $tien_to website $NAME từ $tien_to_cu thành ${NEW_PREFIX}"
_runing "$UI_STRING"

# 1. Lấy danh sách các bảng hiện tại với tiền tố cũ
TABLES=$("${WP_EXEC[@]}" db query "SHOW TABLES LIKE '${OLD_PREFIX}%'" --skip-column-names --path="$path" 2>/dev/null)

if [[ -n "$TABLES" ]]; then
  # 2. Đổi tên từng bảng một cách mượt mà (Bịt kín Output)
  for TABLE in $TABLES; do
    NEW_TABLE="${NEW_PREFIX}${TABLE#"$OLD_PREFIX"}"
    "${WP_EXEC[@]}" db query "RENAME TABLE \`$TABLE\` TO \`$NEW_TABLE\`;" --path="$path" >/dev/null 2>&1
  done

  # 3. Cập nhật bảng Options và Usermeta bằng logic SQL chuẩn xác (Bịt kín Output chống rác màn hình)
  "${WP_EXEC[@]}" db query "UPDATE \`${NEW_PREFIX}options\` SET option_name = CONCAT('${NEW_PREFIX}', SUBSTRING(option_name, CHAR_LENGTH('${OLD_PREFIX}') + 1)) WHERE option_name LIKE '${OLD_PREFIX}%';" --path="$path" >/dev/null 2>&1
  "${WP_EXEC[@]}" db query "UPDATE \`${NEW_PREFIX}usermeta\` SET meta_key = CONCAT('${NEW_PREFIX}', SUBSTRING(meta_key, CHAR_LENGTH('${OLD_PREFIX}') + 1)) WHERE meta_key LIKE '${OLD_PREFIX}%';" --path="$path" >/dev/null 2>&1

  # 4. Sửa file wp-config.php cực an toàn bằng Regex
  sed -i -e "s/\$table_prefix[[:space:]]*=[[:space:]]*['\"][^'\"]*['\"]/\$table_prefix = '${NEW_PREFIX}'/" "$wp_config_path"

  # ================== XÓA CACHE TOÀN DIỆN ==================
  #xoá opcache cache
  if ! declare -F wptt_xoa_opcache >/dev/null 2>&1; then
    . /etc/wptt/cache/lib-opcache-clear
  fi

  wptt_xoa_opcache "$NAME"
  #xoá opcache cache

  #xoá object cache
  "${WP_EXEC[@]}" cache flush --path="$path" >/dev/null 2>&1

  if [ "$(systemctl is-active memcached.service)" == "active" ]; then
    echo "flush_all" | socat - UNIX-CONNECT:/var/run/memcached/memcached.sock >/dev/null 2>&1
  fi

  # Xác thực lại kết quả
  tien_to_moi=$("${WP_EXEC[@]}" db prefix --path="$path" 2>/dev/null)

  if [[ "$tien_to_moi" == "$tien_to_cu" || -z "$tien_to_moi" ]]; then
    _runloi "$UI_STRING"
    [[ $lock_down ]] && chattr +i "$wp_config_path"
    wptt_quay_ve_menu "${1:-}" 1 #trả về lỗi ngừng luôn
  else
    _rundone "$UI_STRING"
  fi
else
  _runloi "$UI_STRING (Không tìm thấy Table)"
  [[ $lock_down ]] && chattr +i "$wp_config_path"
  wptt_quay_ve_menu "${1:-}" 1 "enter" #trả về lỗi ngừng luôn
fi

wptt_logs "INFO" "Thay đổi tiền tố website $NAME"

# Đóng khóa chattr
[[ $lock_down ]] && chattr +i "$wp_config_path"

wptt_quay_ve_menu "${1:-}" 0
