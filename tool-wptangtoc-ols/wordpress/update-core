#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null

function huong_dan() {
  Tính năng cập nhật core WordPress [hay cập nhật lõi WordPress] là một chức năng cực kỳ quan trọng, được tích hợp sẵn trong wptangtoc ols, cho phép người dùng nâng cấp toàn bộ phần mềm WordPress chính [các file và mã nguồn cốt lõi] lên phiên bản mới nhất do đội ngũ phát triển WordPress phát hành.

  Tại sao cần cập nhật core WordPress [lợi ích chính]:
  * Bảo mật Tối thượng: Đây là lý do quan trọng nhất. Các bản cập nhật lõi WordPress thường xuyên vá các lỗ hổng bảo mật được phát hiện. Sử dụng phiên bản WordPress lỗi thời là một rủi ro bảo mật nghiêm trọng, có thể khiến website của bạn dễ dàng bị tấn công.
  * Tính năng Mới và Cải tiến Lớn: Các phiên bản WordPress mới [đặc biệt là các bản phát hành chính] thường giới thiệu nhiều tính năng mới, cải tiến giao diện người dùng [ví dụ: trình soạn thảo block], nâng cao hiệu suất và mang lại trải nghiệm người dùng tốt hơn.
  * Sửa lỗi [Bug Fixes]: Các bản cập nhật sửa các lỗi đã biết từ những phiên bản trước, giúp WordPress hoạt động ổn định, đáng tin cậy hơn và giảm thiểu sự cố.
  * Cải thiện Hiệu suất: Các phiên bản mới thường đi kèm với những tối ưu hóa về mã nguồn, giúp website của bạn tải nhanh hơn và hoạt động hiệu quả hơn.
  * Đảm bảo Tương thích: Giữ cho WordPress tương thích với các công nghệ web mới nhất, phiên bản PHP mới, đồng thời tạo nền tảng ổn định cho các giao diện [theme] và plugin hoạt động.

  Tính năng cập nhật core WordPress là một phần không thể thiếu để đảm bảo website của bạn luôn an toàn, ổn định, có đầy đủ các tính năng mới nhất và hoạt động với hiệu suất tối ưu. Việc cập nhật WordPress core thường xuyên là một trong những trách nhiệm quan trọng nhất của người quản trị website.
}

. /etc/wptt/.wptt.conf 2>/dev/null
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

. /etc/wptt/echo-color 2>/dev/null
tinh_nang_ten="$cap_nhat WordPress core"
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_cap_nhat_wordpress ➜ $tinh_nang_ten${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
if [[ "$NAME" = "98" ]]; then
  NAME=""
fi

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# ==============================================================================
# XỬ LÝ HÀNG LOẠT (TẤT CẢ WEBSITE) - BẮT LỖI SUBSHELL
# ==============================================================================
if [[ "$NAME" = 'Tất cả website' ]]; then
  tien_do=1
  # Đếm tổng số website hợp lệ để hiển thị tiến độ (UI)
  tong_so_web=$(find /etc/wptt/vhost/ -maxdepth 1 -name ".*.conf" ! -name "..conf" 2>/dev/null | wc -l)

  for filepath in /etc/wptt/vhost/.*.conf; do 
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}" 
    domain="${domain%.conf}" 
    domain="${domain#.}"     

    if [[ "$domain" == ?*.?* ]]; then 
      if [[ -f /usr/local/lsws/$domain/html/wp-config.php ]]; then
        _runing "[ $tien_do / $tong_so_web ] Đang cập nhật Core WordPress cho: $domain"
        
        # Chạy Sub-process và bắt mã thoát để kiểm soát lỗi
        ( /bin/bash /etc/wptt/wordpress/update-core "$domain" >/dev/null 2>&1 )
        exit_status=$?
        
        if [ "$exit_status" -eq 0 ]; then
            _rundone "[ $tien_do / $tong_so_web ] Cập nhật hoàn tất cho: $domain"
        else
            _runloi "[ $tien_do / $tong_so_web ] Lỗi khi cập nhật Core cho: $domain (Mã lỗi: $exit_status)"
        fi
        ((tien_do++))
      fi
    fi
  done

  check_menu_wptangtoc_active=$1
  if [[ "$check_menu_wptangtoc_active" = "98" ]]; then
    exec /etc/wptt/wptt-wordpress-main 1
  fi
  exit 0
fi

# ==============================================================================
# XỬ LÝ ĐƠN LẺ MỘT WEBSITE
# ==============================================================================
if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "Lỗi: Tên miền '$NAME' không tồn tại trên hệ thống này!"
  sleep 3
  exec /etc/wptt/wptt-wordpress-main 1
  exit 1
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Lỗi: Hệ thống xác nhận tên miền '$NAME' không sử dụng WordPress!"
  echoDo "Tính năng này chỉ có thể hoạt động trên mã nguồn WordPress."
  sleep 3
  exec /etc/wptt/wptt-wordpress-main 1
  exit 1
fi

. /etc/wptt/vhost/."$NAME".conf 2>/dev/null
if ! . /etc/wptt/php/php-cli-domain-config "$NAME" 2>/dev/null; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
  exit 1
fi
path="/usr/local/lsws/$NAME/html"

WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

# ==============================================================================
# THỰC THI CẬP NHẬT THEO CHUỖI LOGIC (CHAINING) CHỐNG LỖI DÂY CHUYỀN
# ==============================================================================
_runing "Đang cập nhật Core WordPress cho website $NAME..."
exit_status_final=0

# 1. Cập nhật mã nguồn Core ĐẦU TIÊN
if "${WP_EXEC[@]}" core update --path="$path" >/dev/null 2>&1; then
    
    # 2. Chỉ cập nhật DB nếu Core đã update thành công
    if ! "${WP_EXEC[@]}" core update-db --path="$path" >/dev/null 2>&1; then
        wptt_logs "WARNING" "Update Core thành công nhưng lỗi khi update Database Schema cho $NAME"
        _runloi "Cập nhật Core thành công, nhưng lỗi khi nâng cấp CSDL!"
        exit_status_final=1
    fi

    # 3. Cập nhật Ngôn ngữ (Không quá nghiêm trọng nếu lỗi mạng nhẹ, vẫn cho qua)
    "${WP_EXEC[@]}" language core update --path="$path" >/dev/null 2>&1
    
    if [ "$exit_status_final" -eq 0 ]; then
        _rundone "Cập nhật Core WordPress thành công cho website $NAME"
        wptt_logs "INFO" "Thành công: Update Core WordPress website $NAME"
    fi
else
    # Thất bại ngay từ bước tải Core
    _runloi "Cập nhật Core thất bại! Vui lòng kiểm tra quyền thư mục hoặc mạng máy chủ."
    wptt_logs "ERROR" "Thất bại: Lỗi update Core WordPress website $NAME"
    exit_status_final=1
fi

# ==============================================================================
# DỌN DẸP HẬU KỲ CHUẨN MỰC (Chỉ thực hiện khi không có lỗi nghiêm trọng)
# ==============================================================================
if [[ "$exit_status_final" -eq 0 ]]; then
    _runing "Đang dọn dẹp các lớp Cache cho website $NAME..."
    
    # Chạy lệnh xóa cache trong subshell để cách ly môi trường
    ( . /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1 )
    
    _rundone "Dọn dẹp Cache hoàn tất."
else
    echoDo "Bỏ qua dọn dẹp hệ thống do quá trình cập nhật gặp lỗi."
fi

check_menu_wptangtoc_active=$1
if [[ "$check_menu_wptangtoc_active" = "98" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi

exit "$exit_status_final"
