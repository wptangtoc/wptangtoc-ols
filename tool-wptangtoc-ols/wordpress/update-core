#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: WordPress Core Updater
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  Tính năng cập nhật core WordPress nâng cấp toàn bộ mã nguồn lõi WordPress và cấu trúc
  CSDL (update-db) lên phiên bản mới nhất, tự động xử lý khóa file (Lockdown) và dọn cache.
EOF
}

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null

MENU_ARG="${1:-}"
BATCH_CHILD=0
if [[ "${2:-}" == "--batch" ]]; then
  BATCH_CHILD=1
fi

RUNUSER_BIN="$(command -v runuser 2>/dev/null || printf '/sbin/runuser')"
LOG_FILE="/var/log/wptangtoc-ols.log"

_wptt_calc_wpcli_mem() {
  local mem_kb=0 k="" v=""
  while IFS=': ' read -r k v _; do
    if [[ "$k" == "MemTotal" ]]; then
      mem_kb="$v"
      break
    fi
  done </proc/meminfo 2>/dev/null
  if [[ "$mem_kb" =~ ^[0-9]+$ ]] && ((mem_kb > 0 && mem_kb <= 786432)); then
    printf '256M'
  else
    printf '512M'
  fi
}

CURRENT_DOMAIN=""
CURRENT_IS_LOCKED=0
CURRENT_WPCLI_HOME=""

_wptt_cleanup_state() {
  if ((CURRENT_IS_LOCKED == 1)) && [[ -n "$CURRENT_DOMAIN" ]]; then
    if [[ -f /etc/wptt/bao-mat/wptt-chattr-file-lock ]]; then
      /bin/bash /etc/wptt/bao-mat/wptt-chattr-file-lock "$CURRENT_DOMAIN" on >/dev/null 2>&1 || true
    fi
    CURRENT_IS_LOCKED=0
  fi
  if [[ -n "$CURRENT_WPCLI_HOME" && -d "$CURRENT_WPCLI_HOME" ]]; then
    case "$CURRENT_WPCLI_HOME" in
      /tmp/wptt_wpcli_?*) /bin/rm -rf -- "${CURRENT_WPCLI_HOME:?}" 2>/dev/null || true ;;
    esac
    CURRENT_WPCLI_HOME=""
  fi
}

_wptt_trap_exit() {
  local rc=$?
  trap - EXIT INT TERM HUP
  _wptt_cleanup_state
  exit "$rc"
}
trap _wptt_trap_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

_wptt_exit() {
  local code="${1:-0}"
  local pause="${2:-}"
  _wptt_cleanup_state
  trap - EXIT INT TERM HUP
  if ((BATCH_CHILD == 1)); then
    exit "$code"
  fi
  if [[ -n "$pause" ]]; then
    wptt_quay_ve_menu "$MENU_ARG" "$code" "$pause"
  else
    wptt_quay_ve_menu "$MENU_ARG" "$code"
  fi
  exit "$code"
}

tinh_nang_ten="${cap_nhat:-Cập nhật} WordPress core"
if ((BATCH_CHILD == 0)); then
  printf '%b\n' "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}${quan_ly_cap_nhat_wordpress:-Quản lý cập nhật WordPress} ➜ ${tinh_nang_ten}${C_RESET}"
  printf '%b\n\n' "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
fi

NAME="${1:-}"
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# ==============================================================================
# XỬ LÝ HÀNG LOẠT (TẤT CẢ WEBSITE)
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  wp_domains=()
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" =~ ^[a-zA-Z0-9._-]+$ && "$domain" == ?*.?* && "$domain" != *..* ]]; then
      if [[ -f "/usr/local/lsws/${domain}/html/wp-load.php" ]]; then
        wp_domains+=("$domain")
      fi
    fi
  done
  shopt -u nullglob

  tong_so_web="${#wp_domains[@]}"
  if ((tong_so_web == 0)); then
    echoDo "Hệ thống hiện chưa có website WordPress nào!"
    _wptt_exit 1 "enter"
  fi

  tien_do=1
  for domain in "${wp_domains[@]}"; do
    batch_task="[ ${tien_do} / ${tong_so_web} ] Cập nhật Core WordPress cho: ${domain}"
    _runing "$batch_task"

    /bin/bash /etc/wptt/wordpress/update-core "$domain" --batch </dev/null >>"$LOG_FILE" 2>&1
    exit_status=$?

    if ((exit_status == 0)); then
      _rundone "$batch_task"
    else
      _runloi "$batch_task"
    fi
    ((tien_do++))
  done

  _wptt_exit 0 "enter"
fi

# ==============================================================================
# XỬ LÝ ĐƠN LẺ MỘT WEBSITE
# ==============================================================================
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  _wptt_exit 1
fi

if [[ ! "$NAME" =~ ^[a-zA-Z0-9._-]+$ || "$NAME" == -* || "$NAME" == *..* ]]; then
  echoDo "Lỗi: Tên miền '${NAME}' không hợp lệ!"
  _wptt_exit 1 "enter"
fi

pathcheck="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$pathcheck" ]]; then
  ((BATCH_CHILD == 0)) && clear
  echoDo "Lỗi: Tên miền '${NAME}' không tồn tại trên hệ thống này!"
  _wptt_exit 1 "enter"
fi

path="/usr/local/lsws/${NAME}/html"
if [[ ! -f "${path}/wp-load.php" ]]; then
  ((BATCH_CHILD == 0)) && clear
  echoDo "Lỗi: Hệ thống xác nhận tên miền '${NAME}' không sử dụng WordPress!"
  _wptt_exit 1 "enter"
fi

if [[ ! -f /usr/local/bin/wp || ! -x "$RUNUSER_BIN" ]]; then
  echoDo "Lỗi: Thiếu WP-CLI hoặc runuser trên hệ thống!"
  _wptt_exit 1 "enter"
fi

unset User_name_vhost phien_ban_php_domain_thuc_thi lock_down
wptt_load_vhost_conf "$NAME" 2>/dev/null
# shellcheck source=/dev/null
if ! . /etc/wptt/php/php-cli-domain-config "$NAME" >/dev/null 2>&1; then
  declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME"
  echoDo "Lỗi: Không xác định được phiên bản PHP cho website ${NAME}!"
  _wptt_exit 1 "enter"
fi

php_bin="/usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php"
if [[ -z "${User_name_vhost:-}" || ! -x "$php_bin" ]]; then
  echoDo "Lỗi: Không tìm thấy user hoặc binary PHP (${php_bin}) cho website ${NAME}!"
  _wptt_exit 1 "enter"
fi

WP_MEM_LIMIT="$(_wptt_calc_wpcli_mem)"
CURRENT_DOMAIN="$NAME"
CURRENT_WPCLI_HOME="$(mktemp -d /etc/wptt/tmp/wptt_wpcli_XXXXXX)" || _wptt_exit 1
/bin/mkdir -p "${CURRENT_WPCLI_HOME}/cache"
/bin/chown -R "${User_name_vhost}:${User_name_vhost}" "$CURRENT_WPCLI_HOME" 2>/dev/null || true
/bin/chmod 0700 "$CURRENT_WPCLI_HOME" "${CURRENT_WPCLI_HOME}/cache" 2>/dev/null || true
wp_err_file="${CURRENT_WPCLI_HOME}/wp_err.log"

WP_EXEC=(
  nice -n 10
  "$RUNUSER_BIN" -u "$User_name_vhost" --
  env "HOME=${CURRENT_WPCLI_HOME}" "WP_CLI_CACHE_DIR=${CURRENT_WPCLI_HOME}/cache"
  "$php_bin" -d "disable_functions=" -d "memory_limit=${WP_MEM_LIMIT}"
  /usr/local/bin/wp
)

# ==============================================================================
# TẠM TẮT LOCKDOWN -> CẬP NHẬT CORE + DB + NGÔN NGỮ -> KHÔI PHỤC LOCKDOWN
# ==============================================================================
if [[ -n "${lock_down:-}" ]]; then
  CURRENT_IS_LOCKED=1
  if [[ -f /etc/wptt/bao-mat/wptt-chattr-file-lock ]]; then
    /bin/bash /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" off >/dev/null 2>&1 || true
  fi
fi

task_core="Cập nhật Core WordPress cho website ${NAME}"
((BATCH_CHILD == 0)) && _runing "$task_core"
exit_status_final=0

if timeout 180 "${WP_EXEC[@]}" core update --path="$path" </dev/null >"$wp_err_file" 2>&1; then
  if ! timeout 60 "${WP_EXEC[@]}" core update-db --path="$path" </dev/null >>"$wp_err_file" 2>&1; then
    declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "WARNING" "Update Core thành công nhưng lỗi update-db cho $NAME"
    exit_status_final=1
  fi

  timeout 60 "${WP_EXEC[@]}" language core update --path="$path" </dev/null >/dev/null 2>&1 || true

  if ((exit_status_final == 0)); then
    ((BATCH_CHILD == 0)) && _rundone "$task_core"
    declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "INFO" "Thành công: Update Core WordPress website $NAME"
  else
    ((BATCH_CHILD == 0)) && _runloi "$task_core"
    err_detail="$(tail -n 3 "$wp_err_file" 2>/dev/null || true)"
    ((BATCH_CHILD == 0)) && [[ -n "$err_detail" ]] && printf '%bChi tiết:%b %s\n' "${C_YELLOW}" "${C_RESET}" "$err_detail"
    printf '[ERROR] update-core-db (%s): %s\n' "$NAME" "$err_detail" >>"$LOG_FILE" 2>/dev/null || true
  fi
else
  ((BATCH_CHILD == 0)) && _runloi "$task_core"
  err_detail="$(tail -n 3 "$wp_err_file" 2>/dev/null || true)"
  ((BATCH_CHILD == 0)) && [[ -n "$err_detail" ]] && printf '%bChi tiết:%b %s\n' "${C_YELLOW}" "${C_RESET}" "$err_detail"
  printf '[ERROR] update-core (%s): %s\n' "$NAME" "$err_detail" >>"$LOG_FILE" 2>/dev/null || true
  declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "ERROR" "Thất bại: Lỗi update Core WordPress website $NAME: $err_detail"
  exit_status_final=1
fi

if ((CURRENT_IS_LOCKED == 1)); then
  if [[ -f /etc/wptt/bao-mat/wptt-chattr-file-lock ]]; then
    /bin/bash /etc/wptt/bao-mat/wptt-chattr-file-lock "$NAME" on >/dev/null 2>&1 || true
  fi
  CURRENT_IS_LOCKED=0
fi

# Dọn dẹp Cache khi cập nhật thành công
if ((exit_status_final == 0)); then
  task_clean="Dọn dẹp các lớp Cache cho website ${NAME}"
  ((BATCH_CHILD == 0)) && _runing "$task_clean"
  if [[ -f /etc/wptt/cache/wptt-xoacache ]]; then
    if /bin/bash /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1; then
      ((BATCH_CHILD == 0)) && _rundone "$task_clean"
    else
      ((BATCH_CHILD == 0)) && _runloi "$task_clean"
    fi
  else
    ((BATCH_CHILD == 0)) && _rundone "$task_clean"
  fi
else
  ((BATCH_CHILD == 0)) && echoDo "Bỏ qua dọn dẹp hệ thống do quá trình cập nhật gặp lỗi."
fi

_wptt_exit "$exit_status_final"
