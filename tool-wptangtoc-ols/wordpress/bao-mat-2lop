# @since: 2026

function huong_dan() {
  Tính năng này thiết lập một lớp bảo mật thứ 2 [HTTP Basic Auth] khi truy cập vào wp-admin hoặc wp-login.php.

  Tính năng Kích hoạt bảo mật 2 lớp đăng nhập WordPress [Two-Factor Authentication - 2FA] là việc thiết lập một lớp bảo vệ bổ sung cho quá trình đăng nhập vào trang quản trị WordPress, yêu cầu người dùng phải qua một lớp xác thực của máy chủ trước khi vào tới màn hình đăng nhập của WordPress.

  Mục Đích Chính [Cực Kỳ Quan Trọng]:
  * Tăng cường bảo mật mạnh mẽ: Ngay cả khi hacker có mật khẩu WordPress của bạn, họ cũng không thể truy cập nếu không qua được lớp khiên này.
  * Chống tấn công Brute-Force [dò mật khẩu]: Chặn đứng mọi bot quét tự động ngay từ tầng Server [OpenLiteSpeed], giúp tiết kiệm tài nguyên CPU tuyệt đối.
  * Bảo vệ tài khoản quản trị [Admin]: Một rào chắn vững chắc cho các website đặc biệt quan trọng.

  Bạn có thể dễ dàng Bật/Tắt tính năng này tùy theo nhu cầu vận hành thực tế.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BẢO MẬT ➜ Bật / Tắt Bảo mật wp-admin 2 lớp (2FA)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# BIẾN MÔI TRƯỜNG PHP VÀ QUYỀN LITESPEED
# ==============================================================================
if [[ -f "/usr/local/lsws/admin/fcgi-bin/admin_php" ]]; then
  PHP_Command="/usr/local/lsws/admin/fcgi-bin/admin_php"
else
  PHP_Command="/usr/local/lsws/admin/fcgi-bin/admin_php5"
fi

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

# ==============================================================================
# HÀM CHỌN WEBSITE CÓ HIỂN THỊ TRẠNG THÁI 2FA
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  # Quét vòng lặp siêu tốc
  if [ "$(ls -A /etc/wptt/vhost 2>/dev/null)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      # Chỉ quét các domain có định dạng chuẩn và có nhân WordPress
      if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
        local check_mk="/usr/local/lsws/$domain/passwd/.mk"
        local status_text=""
        local status_color=""

        if [[ -f "$check_mk" ]]; then
          status_text="[Đang BẬT - An toàn]"
          status_color=$C_GREEN
        else
          status_text="[Đang TẮT - Chưa bảo vệ]"
          status_color=$C_RED
        fi

        selects+=("$domain|$status_text|$status_color")
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Hệ thống chưa có Website WordPress nào để cấu hình 2FA!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-bao-mat-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Trạng thái hiện tại & Chọn Website muốn thao tác:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Bật / Tắt Bảo mật 2 lớp cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Bật / Tắt Bảo mật 2 lớp cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-bao-mat-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ truyền đối số cho 1 domain cụ thể
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""
thao_tac_thanh_cong=false
CREDENTIALS_LIST=()

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  
  # NẾU DÙNG CLI ĐỐI SỐ -> BỎ QUA HỎI ĐÁP
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="BẬT Bảo mật 2 lớp"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="TẮT Bảo mật 2 lớp"
  else
    # NẾU CHỌN TỪ MENU UI -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH BẢO MẬT 2FA${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác cấu hình Bảo mật wp-admin 2 lớp cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) BẬT Bảo mật 2 lớp (Bảo vệ an toàn đồng loạt)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Bảo mật 2 lớp${C_RESET} (Bảo vệ an toàn đồng loạt)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) TẮT Bảo mật 2 lớp (Gỡ bỏ bảo vệ đồng loạt)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẮT Bảo mật 2 lớp${C_RESET} (Gỡ bỏ bảo vệ đồng loạt)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice
    
    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="BẬT Bảo mật 2 lớp"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="TẮT Bảo mật 2 lớp"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-bao-mat-main 1
    fi
  fi

  # Quét toàn bộ danh sách domain để thực thi
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-load.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  pathcheck="/etc/wptt/vhost/.$NAME.conf"

  [[ ! -f "$pathcheck" ]] && echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-bao-mat-main 1

  DOMAIN_LIST=("$NAME")
  check_mk="/usr/local/lsws/$NAME/passwd/.mk"

  # NẾU TRUYỀN CLI_MODE -> BỎ QUA BOX UI
  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "bat" ]]; then
      action_text="BẬT Bảo mật 2 lớp"
    else
      action_text="TẮT Bảo mật 2 lớp"
    fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN CẤU HÌNH BẢO MẬT 2FA${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if [[ -f "$check_mk" ]]; then
      left_text "  Website ${NAME} hiện ĐANG BẬT Bảo mật 2 lớp." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) TẮT Bảo mật 2 lớp (Gỡ bỏ bảo vệ - Kém an toàn)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẮT Bảo mật 2 lớp${C_RESET} (Gỡ bỏ bảo vệ - Kém an toàn)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên khóa bảo vệ)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên khóa bảo vệ)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="tat"
        action_text="TẮT Bảo mật 2 lớp"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
      fi
    else
      left_text "  Website ${NAME} hiện ĐANG TẮT (Chưa được bảo vệ)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) BẬT Bảo mật 2 lớp (Kích hoạt khóa bảo vệ wp-admin)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT Bảo mật 2 lớp${C_RESET} (Kích hoạt khóa bảo vệ wp-admin)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="bat"
        action_text="BẬT Bảo mật 2 lớp"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-bao-mat-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# THỰC THI SỬA FILE CẤU HÌNH VÀ SINH PASSWD
# ==============================================================================
echo ""

for DOMAIN in "${DOMAIN_LIST[@]}"; do
  mk_path="/usr/local/lsws/$DOMAIN/passwd/.mk"
  vhost_conf="/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf"
  wptt_vhost="/etc/wptt/vhost/.$DOMAIN.conf"
  
  _runing "$action_text cho website $DOMAIN..."

  if [[ "$wp_action" == "bat" ]]; then
    if [[ ! -f "$mk_path" ]]; then
      # 1. Tạo thư mục và sinh mật khẩu
      mkdir -p "/usr/local/lsws/$DOMAIN/passwd"
      Webadmin_Pass=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 36)
      id_ols_admin=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 24)
      Encrypt_string=$($PHP_Command -q /usr/local/lsws/admin/misc/htpasswd.php "${Webadmin_Pass}")

      echo "$id_ols_admin:$Encrypt_string" >"$mk_path"
      chown nobody:$tuong_thich_nhom_litespeed "$mk_path"
      chmod 400 "$mk_path"

      # 2. Xóa cấu hình cũ (nếu sót) và Tiêm cấu hình Vhost mới bằng EOF
      sed -i "/^realm ${DOMAIN}wp/,/^}/d" "$vhost_conf" 2>/dev/null
      sed -i "/^context exp:wp-login\.php/,/^}/d" "$vhost_conf" 2>/dev/null

      cat <<EOF >>"$vhost_conf"

realm ${DOMAIN}wp {
  userDB  {
    location              /usr/local/lsws/${DOMAIN}/passwd/.mk
  }
}

context exp:wp-login.php {
  location                \$DOC_ROOT/\$0
  allowBrowse             1
  realm                   ${DOMAIN}wp

  accessControl  {
    allow                 ALL
  }
  addDefaultCharset       off
}
EOF

      # 3. Lưu mật khẩu vào config của WPTangToc
      sed -i "/id_dang_nhap_wordpress_2/d" "$wptt_vhost" 2>/dev/null
      sed -i "/password_dang_nhap_wordpress_2/d" "$wptt_vhost" 2>/dev/null
      echo "id_dang_nhap_wordpress_2=$id_ols_admin" >>"$wptt_vhost"
      echo "password_dang_nhap_wordpress_2=$Webadmin_Pass" >>"$wptt_vhost"

      CREDENTIALS_LIST+=("$DOMAIN|$id_ols_admin|$Webadmin_Pass")
    fi
  else
    if [[ -f "$mk_path" ]]; then
      # 1. Xóa cấu hình Vhost bằng SED an toàn
      sed -i "/^realm ${DOMAIN}wp/,/^}/d" "$vhost_conf" 2>/dev/null
      sed -i "/^context exp:wp-login\.php/,/^}/d" "$vhost_conf" 2>/dev/null

      # 2. Xóa file passwd và thông tin trong config
      rm -rf "/usr/local/lsws/${DOMAIN:?}/passwd/.mk"
      sed -i "/id_dang_nhap_wordpress_2/d" "$wptt_vhost" 2>/dev/null
      sed -i "/password_dang_nhap_wordpress_2/d" "$wptt_vhost" 2>/dev/null
    fi
  fi

  echo "$action_text WordPress cho website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cho website $DOMAIN"
  thao_tac_thanh_cong=true
done

# ==============================================================================
# RELOAD LITESPEED VÀ HIỂN THỊ KẾT QUẢ ĐĂNG NHẬP
# ==============================================================================
if $thao_tac_thanh_cong; then
  wptt_smart_reload_lsws >/dev/null 2>&1

  # NẾU CÓ SINH TÀI KHOẢN MỚI -> IN RA BOX GIAO DIỆN
  if [[ ${#CREDENTIALS_LIST[@]} -gt 0 ]]; then
    echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HOÀN TẤT! HÃY LƯU LẠI THÔNG TIN ĐĂNG NHẬP SAU:${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    for item in "${CREDENTIALS_LIST[@]}"; do
      dom=$(echo "$item" | cut -d'|' -f1)
      usr=$(echo "$item" | cut -d'|' -f2)
      pwd=$(echo "$item" | cut -d'|' -f3)

      left_text "  ▪ Website  : ${C_GREEN}$dom${C_RESET}" 2
      left_text "    User     : ${C_YELLOW}$usr${C_RESET}" 2
      left_text "    Mật khẩu : ${C_YELLOW}$pwd${C_RESET}" 2
      left_text "  ------------------------------------------------------------------------" 2
    done
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "${C_CYAN}Mẹo:${C_RESET} Sếp có thể xem lại tài khoản bất cứ lúc nào tại menu: Bảo mật => Xem tài khoản 2 lớp\n"
    
    if [[ $CLI_MODE -eq 0 ]]; then
      echo -en "${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
      read -r _
    fi
  fi
fi

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-bao-mat-main 1
fi
