#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Plugin Updater
# @since: 2026

function huong_dan() {
  Tính năng cập nhật plugin WordPress là một chức năng cốt lõi của WordPress, cho phép người dùng dễ dàng nâng cấp các plugin đã cài đặt trên website của họ lên phiên bản mới nhất do nhà phát triển plugin cung cấp.

  Tại sao cần cập nhật plugin [lợi ích chính]:
  * Bảo mật: Đây là lý do quan trọng hàng đầu. Các bản cập nhật plugin thường xuyên vá các lỗ hổng bảo mật đã được phát hiện. Plugin lỗi thời là một trong những nguyên nhân phổ biến nhất khiến website WordPress bị tấn công.
  * Thêm Tính năng Mới và Cải tiến: Nhà phát triển liên tục cải thiện plugin bằng cách thêm các chức năng mới, tối ưu hóa hiệu suất, hoặc cải thiện giao diện người dùng.
  * Sửa lỗi [Bug Fixes]: Các phiên bản cập nhật khắc phục các lỗi còn tồn tại ở phiên bản trước, giúp plugin hoạt động ổn định và chính xác hơn.
  * Đảm bảo Tương thích: Giúp plugin hoạt động tốt với phiên bản WordPress mới nhất, cũng như với các theme và plugin khác, tránh xung đột gây lỗi website.
  * Tăng hiệu suất: Đôi khi các bản cập nhật bao gồm việc tối ưu mã nguồn, giúp plugin chạy nhanh hơn và nhẹ hơn.

  Tính năng cập nhật plugin WordPress đóng vai trò cực kỳ quan trọng trong việc duy trì một website an toàn, ổn định, đầy đủ tính năng và tương thích tốt. Việc thường xuyên kiểm tra và thực hiện cập nhật là một phần không thể thiếu trong quản trị website WordPress.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

tinh_nang_ten="$cap_nhat WordPress Plugins"
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_cap_nhat_wordpress ➜ $tinh_nang_ten${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# ==============================================================================
# XỬ LÝ HÀNG LOẠT (TẤT CẢ WEBSITE) - CHUẨN XÁC TIẾN ĐỘ & CÁCH LY
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
    tien_do=1
    # FIX BUG: Đếm tổng số website hợp lệ để hiển thị tiến độ (UI) không bị lỗi khuyết số
    tong_so_web=$(find /etc/wptt/vhost/ -maxdepth 1 -name ".*.conf" ! -name "..conf" 2>/dev/null | wc -l)

    shopt -s nullglob
    for filepath in /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
        
        # Kỹ thuật Parameter Expansion (Xử lý cắt chuỗi trực tiếp trên RAM)
        domain="${filepath##*/}" 
        domain="${domain%.conf}" 
        domain="${domain#.}"     

        if [[ "$domain" == ?*.?* ]]; then
            if [[ -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
                _runing "[ $tien_do / $tong_so_web ] Đang cập nhật TẤT CẢ plugins cho: $domain"
                
                # Gọi Sub-process và chặn Output rác để bảo vệ màn hình Terminal
                ( /bin/bash /etc/wptt/wordpress/update-plugin "$domain" >/dev/null 2>&1 )
                
                _rundone "[ $tien_do / $tong_so_web ] Cập nhật hoàn tất cho: $domain"
                ((tien_do++)) 
            fi
        fi
    done

    check_menu_wptangtoc_active=$1
    if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
        exec /etc/wptt/wptt-wordpress-main 1
    fi
    exit 0
fi

# ==============================================================================
# XỬ LÝ ĐƠN LẺ MỘT WEBSITE
# ==============================================================================
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "Tên miền không tồn tại trên hệ thống này"
  sleep 3
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
  exit 1
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Hệ thống xác nhận bạn chưa kích hoạt sử dụng WordPress"
  sleep 3
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
  exit 1
fi

path="/usr/local/lsws/$NAME/html"
. /etc/wptt/php/php-cli-domain-config "$NAME" 2>/dev/null
. "$pathcheck" 2>/dev/null

# Khai báo mảng thực thi WP-CLI chuẩn bảo mật (Drop Privilege)
WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

echo "Đang quét các bản cập nhật plugin cho website $NAME..."

# ==============================================================================
# ANTI DATA POLLUTION (CHỐNG Ô NHIỄM DỮ LIỆU)
# Ép wp-cli chạy --skip-plugins --skip-themes để chặn các Plugin rác in log ra màn hình
# Dùng mapfile đưa thẳng vào mảng RAM an toàn, thay thế cho vòng lặp while read cũ
# ==============================================================================
mapfile -t selects < <("${WP_EXEC[@]}" plugin list --update=available --field=name --skip-plugins --skip-themes --quiet --path="$path" 2>/dev/null)

if [[ ${#selects[@]} -eq 0 ]]; then
  echo ""
  echoDone "Tuyệt vời! Tất cả plugin trên website $NAME đều đã ở phiên bản mới nhất."
	sleep 2
  echo ""
else
  echo ""
  echo "========================================================================="
  echo " Danh sách plugin CẦN CẬP NHẬT trên website $NAME:"
  echo "-------------------------------------------------------------------------"
  # Gắn khiên skip-plugins để bảng UI không bị vỡ bởi log debug
  "${WP_EXEC[@]}" plugin list --update=available --fields=name,version,update_version --skip-plugins --skip-themes --path="$path" 2>/dev/null
  echo "========================================================================="
  echo ""

  # Khởi tạo Menu Lựa chọn động
  options=("Cập nhật TẤT CẢ plugin đang có bản mới")
  for p in "${selects[@]}"; do
    options+=("Chỉ cập nhật plugin: $p")
  done

  PS3="$(tput setab 0)-//- Chọn thao tác bạn muốn thực hiện (1-$((${#options[@]}))) [0=Thoát]:$(tput sgr0) "

  plugin_target=""
  select opt in "${options[@]}"; do
    if [[ "$REPLY" == "0" ]]; then
      exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
    elif [[ "$REPLY" == "1" ]]; then
      plugin_target="all"
      break
    elif [[ "$REPLY" -gt 1 && "$REPLY" -le ${#options[@]} ]]; then
      idx=$((REPLY - 2))
      plugin_target="${selects[$idx]}"
      break
    else
      echoDo "Lựa chọn không hợp lệ, vui lòng chọn lại."
    fi
  done

  echo ""
  
  # ==============================================================================
  # THỰC THI CẬP NHẬT (Trút bỏ khiên chặn để Plugin chạy đủ Hook database)
  # ==============================================================================
  if [[ "$plugin_target" == "all" ]]; then
    _runing "Đang cập nhật TẤT CẢ plugins cho website $NAME"
    "${WP_EXEC[@]}" plugin update --all --path="$path" >/dev/null 2>&1
    "${WP_EXEC[@]}" language plugin update --all --path="$path" >/dev/null 2>&1
    _rundone "Cập nhật TẤT CẢ plugins cho website $NAME"
  else
    _runing "Đang cập nhật riêng plugin: $plugin_target"
    "${WP_EXEC[@]}" plugin update "$plugin_target" --path="$path" >/dev/null 2>&1
    "${WP_EXEC[@]}" language plugin update "$plugin_target" --path="$path" >/dev/null 2>&1
    _rundone "Cập nhật riêng plugin: $plugin_target"
  fi

  # ==============================================================================
  # DỌN DẸP HẬU KỲ CHUẨN MỰC
  # ==============================================================================
  _runing "Đang dọn dẹp hệ thống sau khi cập nhật..."
  "${WP_EXEC[@]}" rewrite flush --path="$path" >/dev/null 2>&1
  . /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1 
  # 4. Cấp lại Rewrite Rules (Phòng trường hợp Plugin CPT sinh Rule mới)
  _rundone "Hoàn tất dọn dẹp Cache và Rewrite Rules."
fi

check_menu_wptangtoc_active=${1:-}
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
fi
