#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Theme Updater
# @since: 2026

function huong_dan() {
  Tính năng cập nhật theme WordPress là một chức năng cho phép người dùng dễ dàng nâng cấp giao diện [theme] website của họ lên phiên bản mới nhất do nhà phát triển theme cung cấp.

  Tại sao cần cập nhật theme [lợi ích chính]:
  * Bảo mật: Đây là lý do quan trọng nhất. Các bản cập nhật theme thường xuyên vá các lỗ hổng bảo mật được phát hiện. Việc không cập nhật có thể khiến website của bạn dễ bị tấn công.
  * Thêm Tính năng Mới: Nhà phát triển thường bổ sung các tính năng, tùy chọn tùy chỉnh, hoặc cải tiến thiết kế trong các phiên bản mới, giúp website của bạn hiện đại và tiện dụng hơn.
  * Sửa lỗi [Bug Fixes]: Các phiên bản cập nhật sửa các lỗi đã biết từ phiên bản trước, giúp theme hoạt động ổn định và mượt mà hơn.
  * Đảm bảo Tương thích: Giúp theme tương thích tốt hơn với phiên bản WordPress mới nhất cũng như các plugin khác, tránh xung đột và lỗi không mong muốn.

  Tính năng cập nhật theme WordPress là một phần thiết yếu để duy trì một website an toàn, ổn định, và hiện đại. Việc thường xuyên kiểm tra và áp dụng các bản cập nhật là một thói quen tốt cho mọi chủ sở hữu website WordPress.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

tinh_nang_ten="$cap_nhat WordPress Themes"
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$quan_ly_cap_nhat_wordpress ➜ $tinh_nang_ten${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$tinh_nang_ten"
fi

# ==============================================================================
# XỬ LÝ HÀNG LOẠT (TẤT CẢ WEBSITE) - NON-BLOCKING & UX OPTIMIZED
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
    tien_do=1
    # Đếm tổng số website hợp lệ bằng find (Siêu tốc, chính xác)
    tong_so_web=$(find /etc/wptt/vhost/ -maxdepth 1 -name ".*.conf" ! -name "..conf" 2>/dev/null | wc -l)

    shopt -s nullglob
    for filepath in /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

        # Parameter Expansion: Xử lý chuỗi trực tiếp trên RAM, không gọi sed/awk
        domain="${filepath##*/}" 
        domain="${domain%.conf}" 
        domain="${domain#.}"     

        if [[ "$domain" == ?*.?* ]]; then
            if [[ -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
                _runing "[ $tien_do / $tong_so_web ] Đang cập nhật themes cho: $domain"
                
                # Gọi Sub-process và chặn toàn bộ Output rác để không làm nát màn hình Terminal
                ( /bin/bash /etc/wptt/wordpress/update-theme "$domain" >/dev/null 2>&1 )
                
                _rundone "[ $tien_do / $tong_so_web ] Cập nhật hoàn tất cho: $domain"
                ((tien_do++))
            fi
        fi
    done

    check_menu_wptangtoc_active=$1
    if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
        exec /etc/wptt/wptt-wordpress-main 1
    fi
    exit 0
fi

# ==============================================================================
# XỬ LÝ ĐƠN LẺ MỘT WEBSITE
# ==============================================================================
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "Tên miền không tồn tại trên hệ thống này"
  sleep 3
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
  exit 1
fi

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Hệ thống xác nhận bạn chưa kích hoạt sử dụng WordPress"
  sleep 3
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
  exit 1
fi

path="/usr/local/lsws/$NAME/html"
. /etc/wptt/php/php-cli-domain-config "$NAME" 2>/dev/null
. "$pathcheck" 2>/dev/null

# Khai báo mảng thực thi WP-CLI chuẩn bảo mật (Drop Privilege)
WP_EXEC=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp )

echo "Đang kiểm tra các bản cập nhật theme cho website $NAME..."

# ==============================================================================
# ANTI DATA POLLUTION (CHỐNG Ô NHIỄM DỮ LIỆU)
# Sử dụng cờ --skip-plugins --skip-themes để cô lập môi trường WP-CLI.
# Đảm bảo lệnh wp theme list chỉ trả về ĐÚNG CẤU TRÚC, không bị lẫn log debug từ Elementor. Plugin hay gây ô nhiễm log
# MAPFILE (Tránh rò rỉ bộ nhớ thay vì vòng lặp while read, support ngon có dấu cách theme mà chả ai dùng theme có dấu cách nhưng cứ vẫn làm biết đâu có ai đó tự code themes mà cho dấu cách làm thên thư mục themes)
# ==============================================================================
mapfile -t selects < <("${WP_EXEC[@]}" theme list --update=available --field=name --skip-plugins --skip-themes --quiet --path="$path" 2>/dev/null)

if [[ ${#selects[@]} -eq 0 ]]; then
  echo ""
  echoDone "Website $NAME đã sử dụng các phiên bản theme mới nhất."
	sleep 2
  echo ""
else
  echo ""
  echo "========================================================================="
  echo " Danh sách theme CẦN CẬP NHẬT của website $NAME:"
  echo "-------------------------------------------------------------------------"
  # Hiển thị cho người dùng xem cũng phải kèm --skip-plugins để bảng không bị vỡ khung
  "${WP_EXEC[@]}" theme list --update=available --fields=name,version,update_version --skip-plugins --skip-themes --path="$path" 2>/dev/null
  echo "========================================================================="
  echo ""

  # Khởi tạo menu động an toàn
  options=("Cập nhật TẤT CẢ các theme trên")
  for t in "${selects[@]}"; do
    options+=("Chỉ cập nhật theme: $t")
  done

  PS3="$(tput setab 0)-//- Chọn thao tác cập nhật (1-$((${#options[@]}))) [0=Thoát]:$(tput sgr0) "

  theme_target=""
  select opt in "${options[@]}"; do
    if [[ "$REPLY" == "0" ]]; then
      exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
    elif [[ "$REPLY" == "1" ]]; then
      theme_target="all"
      break
    elif [[ "$REPLY" -gt 1 && "$REPLY" -le ${#options[@]} ]]; then
      idx=$((REPLY - 2))
      theme_target="${selects[$idx]}"
      break
    else
      echoDo "Lựa chọn không hợp lệ."
    fi
  done

  echo ""
  
  # ==============================================================================
  # THỰC THI CẬP NHẬT
  # Lưu ý: Ở bước thực thi cập nhật (update), KHÔNG dùng --skip-plugins nữa, vì 
  # một số theme/plugin cần tương tác với nhau trong quá trình chạy hook cập nhật.
  # ==============================================================================
  if [[ "$theme_target" == "all" ]]; then
    _runing "Đang cập nhật TẤT CẢ themes cho website $NAME"
    "${WP_EXEC[@]}" theme update --all --path="$path" >/dev/null 2>&1
    "${WP_EXEC[@]}" language theme update --all --path="$path" >/dev/null 2>&1
    _rundone "Cập nhật TẤT CẢ themes cho website $NAME"
  else
    _runing "Đang cập nhật theme: $theme_target"
    "${WP_EXEC[@]}" theme update "$theme_target" --path="$path" >/dev/null 2>&1
    "${WP_EXEC[@]}" language theme update "$theme_target" --path="$path" >/dev/null 2>&1
    _rundone "Cập nhật theme: $theme_target"
  fi

  # Dọn dẹp Cache (Kích hoạt Non-blocking I/O từ file xóa cache)
  _runing "Đang dọn dẹp các lớp Cache cho website $NAME..."
  . /etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1
  _rundone "Dọn dẹp Cache hoàn tất."
fi

check_menu_wptangtoc_active=${1:-}
if [[ "$check_menu_wptangtoc_active" == "98" ]]; then
  exec /etc/wptt/wordpress/wptt-update-wordpress-main 1
fi
