#!/bin/bash

function huong_dan() {
  1: Khi bật tính năng chỉnh sửa code trong dashboard wp-admin:
  Mục đích chính [Tăng cường bảo mật]:
  * Vô hiệu hóa Trình sửa Theme và Plugin: Tính năng này sẽ tắt hoàn toàn các trình soạn thảo mã nguồn cho theme [Giao diện File Editor] và plugin [Plugins File Editor] ngay trong trang quản trị WordPress. >Theme >Plugin
  * Ngăn chặn sửa code trực tiếp từ Dashboard: Điều này cản trở việc chỉnh sửa trực tiếp các tệp PHP của theme và plugin thông qua giao diện quản trị.
  * Giảm thiểu rủi ro bảo mật: Nếu một tài khoản quản trị viên bị xâm nhập, kẻ tấn công sẽ không thể dễ dàng chèn mã độc vào website thông qua các trình soạn thảo này.
  * Tránh lỗi do vô tình sửa code: Ngăn người dùng [kể cả quản trị viên ít kinh nghiệm] vô tình làm hỏng website khi cố gắng sửa code trực tiếp.

  2: Khi tắt tính năng chỉnh sửa code trong dashboard wp-admin:
  Mục đích chính:
  * Kích hoạt lại Trình sửa Theme và Plugin: Cho phép quản trị viên có thể chỉnh sửa tệp theme và plugin trực tiếp từ trang quản trị WordPress.
  * Tiện lợi cho việc sửa đổi nhanh [CẨN TRỌNG]: Một số người có thể tạm thời bật lại để thực hiện các chỉnh sửa nhỏ nhanh chóng, đặc biệt nếu không tiện truy cập qua FTP/SFTP.
  * Tại sao thường KHÔNG được khuyến nghị cho website đang chạy thật [live site]:
  * Tăng rủi ro bảo mật: Mở lại một vectơ tấn công tiềm ẩn nếu tài khoản admin bị lộ.
  * Nguy cơ làm hỏng website cao hơn: Sửa code trực tiếp trên live site rất dễ gây lỗi.
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
if [[ -z "$ngon_ngu" ]]; then ngon_ngu='vi'; fi
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/cache/lib-opcache-clear 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}$quan_ly_wordpress ➜ Khóa/Mở sửa code trực tiếp wp-admin${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE CÓ HIỂN THỊ TRẠNG THÁI KHÓA/MỞ
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  if [ "$(ls -A /etc/wptt/vhost 2>/dev/null)" ]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        local wp_config="/usr/local/lsws/$domain/html/wp-config.php"
        if [[ -f "$wp_config" ]]; then
          local status_text=""
          local status_color=""

          # Kiểm tra xem có đang khóa chỉnh sửa (DISALLOW_FILE_EDIT = true) không
          if grep -iqE "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DISALLOW_FILE_EDIT['\"][[:space:]]*,[[:space:]]*true" "$wp_config" 2>/dev/null; then
            status_text="[Đang KHÓA - An toàn]"
            status_color=$C_GREEN
          else
            status_text="[Đang MỞ - Nguy hiểm]"
            status_color=$C_RED
          fi

          selects+=("$domain|$status_text|$status_color")
        fi
      fi
    done
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: $khong_co_domain_nao_ton_tai_tren_he_thong${C_RESET}"
    exit
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}
  
  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="${lua_chon_website_ban_muon:-Nhập lựa chọn website của bạn}:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      # Giao diện cắt lớp cho tùy chọn cuối cùng (Đồng loạt)
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Khóa / Mở Khóa Code cho toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Khóa / Mở Khóa Code cho toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      # Dòng website bình thường
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  # Dòng nhắc lệnh (Prompt) siêu sạch
  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}
  
  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-wordpress-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE) TRÁNH HỎI ĐÁP
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ truyền đối số cho 1 domain cụ thể
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="set" # KHÓA
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="delete" # MỞ KHÓA
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then
  
  # NẾU DÙNG CLI ĐỐI SỐ -> BỎ QUA HỎI ĐÁP
  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="set"
    action_text="KHÓA (Ngăn chặn sửa code)"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="delete"
    action_text="MỞ KHÓA (Cho phép sửa code)"
  else
    # NẾU CHỌN TỪ MENU UI (SỐ TÙY CHỌN CUỐI CÙNG) -> MỞ SUB-MENU BOX UI
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: KHÓA/MỞ SỬA CODE ADMIN${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác quản lý quyền sửa Code cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    
    str_opt1="  1) KHÓA ĐỒNG LOẠT (Tăng cường bảo mật)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}KHÓA ĐỒNG LOẠT${C_RESET} (Tăng cường bảo mật)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
    
    str_opt2="  2) MỞ KHÓA ĐỒNG LOẠT (Cảnh báo: Kém an toàn)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}MỞ KHÓA ĐỒNG LOẠT${C_RESET} (Cảnh báo: Kém an toàn)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
    
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice
    
    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="set"
      action_text="KHÓA (Ngăn chặn sửa code)"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="delete"
      action_text="MỞ KHÓA (Cho phép sửa code)"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-wordpress-main 1
    fi
  fi

  # Quét toàn bộ danh sách domain để thực thi
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* && -f "/usr/local/lsws/$domain/html/wp-config.php" ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  path_html="/usr/local/lsws/$NAME/html"
  wp_config="$path_html/wp-config.php"

  [[ ! -f "$wp_config" ]] && echo -e "\n${C_RED}❌ Không tìm thấy wp-config.php cho $NAME${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-wordpress-main 1

  DOMAIN_LIST=("$NAME")

  # NẾU TRUYỀN CLI_MODE -> BỎ QUA BOX UI
  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "set" ]]; then
      action_text="KHÓA (Ngăn chặn sửa code)"
    else
      action_text="MỞ KHÓA (Cho phép sửa code)"
    fi
  else
    # HIỂN THỊ BOX UI NẾU CHẠY THỦ CÔNG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN KHÓA / MỞ KHÓA ADMIN CODE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    # Kiểm tra trạng thái hiện tại (Kiểm tra DISALLOW_FILE_EDIT)
    if grep -iqE "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DISALLOW_FILE_EDIT['\"][[:space:]]*,[[:space:]]*true" "$wp_config" 2>/dev/null; then
      left_text "  Website ${NAME} hiện ĐANG KHÓA sửa code (Bảo mật tốt)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) MỞ KHÓA (Cho phép sửa code trực tiếp trên wp-admin)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}MỞ KHÓA${C_RESET} (Cho phép sửa code trực tiếp trên wp-admin)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Giữ nguyên khóa)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên khóa)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="delete"
        action_text="MỞ KHÓA (Cho phép sửa code)"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-wordpress-main 1
      fi
    else
      left_text "  Website ${NAME} hiện ĐANG MỞ (Nguy cơ bảo mật)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      
      str_opt1="  1) KHÓA LẠI (Tăng cường bảo mật)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}KHÓA LẠI${C_RESET} (Tăng cường bảo mật)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"
      
      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"
      
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice
      
      if [[ "$single_choice" == "1" ]]; then
        wp_action="set"
        action_text="KHÓA (Ngăn chặn sửa code)"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-wordpress-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# THỰC THI WP-CLI VÀ XÓA OPCACHE
# ==============================================================================
echo ""
for DOMAIN in "${DOMAIN_LIST[@]}"; do
  path_html="/usr/local/lsws/$DOMAIN/html"
  wp_config="$path_html/wp-config.php"
  
  [[ ! -f "$wp_config" ]] && continue
  _runing "$action_text trên wp-admin cho $DOMAIN"

  . /etc/wptt/vhost/.$DOMAIN.conf
  . /etc/wptt/php/php-cli-domain-config $DOMAIN

  WP_EXEC="/sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp"

  # Thực thi cấu hình bằng WP-CLI (An toàn nhất)
  if [[ "$wp_action" == "set" ]]; then
    # Bật tính năng KHÓA (An toàn)
    $WP_EXEC config set DISALLOW_FILE_EDIT true --raw --path="$path_html" >/dev/null 2>&1
    $WP_EXEC config set DISALLOW_FILE_MODS true --raw --path="$path_html" >/dev/null 2>&1
  else
    # MỞ KHÓA (Xóa rule để cho phép sửa)
    $WP_EXEC config delete DISALLOW_FILE_EDIT --path="$path_html" >/dev/null 2>&1
    $WP_EXEC config delete DISALLOW_FILE_MODS --path="$path_html" >/dev/null 2>&1
  fi

  # Reset OPcache để áp dụng ngay lập tức
  wptt_xoa_opcache "$DOMAIN"

  echo "$action_text wp-admin website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cho website $DOMAIN"
done

if [[ ${1:-} == "98" ]]; then
  exec /etc/wptt/wptt-wordpress-main 1
fi
