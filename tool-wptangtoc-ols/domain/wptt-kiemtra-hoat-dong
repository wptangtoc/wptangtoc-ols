#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Kiểm tra hoạt động và đo tốc độ phản hồi Website thời gian thực (Realtime Dashboard)

function huong_dan() {
  cat << 'EOF'
  Tính năng Kiểm tra Hoạt động Website thời gian thực (Realtime Uptime & TTFB Monitor):
  * Theo dõi liên tục trạng thái Online/Offline, chẩn đoán DNS và độ trễ phản hồi (TTFB) của toàn bộ website.
  * Mỗi website cập nhật ngay khi quét xong, kèm biểu đồ lịch sử 10 lần quét gần nhất và % Uptime.
  * Vẽ lại tại chỗ trên màn hình riêng (Alternate Screen), thoát ra Terminal vẫn sạch như cũ.
  * Phím tắt: [q] thoát | [r] quét ngay | [s] đổi cách sắp xếp | [i] bật/tắt chú thích
              [d] chế độ gọn | [Space] tạm dừng | [←][→] đổi trang. [Ctrl+C] cũng thoát an toàn.
EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. "/etc/wptt/echo-color" 2>/dev/null

# ==============================================================================
# CẤU HÌNH HỆ THỐNG
# ==============================================================================
BOX_W_MIN=78            # Độ rộng phần ruột của khung khi 1 cột (tổng phủ bì 80 cột)
BOX_W=$BOX_W_MIN        # Độ rộng thực tế (tự tính lại theo số cột trong _layout)
CELL_W=76               # Độ rộng của 1 ô website (1 cột dữ liệu)
COL_GAP=3               # Độ rộng dải phân cách giữa 2 cột " │ "
MAX_COLS=4              # Số cột tối đa khi Terminal rất rộng
REFRESH_SEC=5           # Nghỉ bao nhiêu giây giữa 2 chu kỳ quét
MAX_JOBS=10             # Số website quét song song (an toàn cho cả VPS 512MB)
FAST_MS=300             # TTFB <= ngưỡng này: Nhanh (Xanh)
SLOW_MS=800             # TTFB <= ngưỡng này: Ổn (Vàng), lớn hơn: Chậm (Đỏ)
HIST_LEN=10             # Số lần quét lưu trong biểu đồ lịch sử Sparkline
MAX_SESSION_SEC=7200    # Chốt chặn an toàn: Tự thoát sau tối đa 2 giờ treo máy
SPARK='▁▂▃▄▅▆▇█'
SPIN=('-' '\' '|' '/')  # Ký tự ASCII chuẩn 100% mọi SSH Client (PuTTY/Bitvise/macOS)
SORT_NAMES=("Tên" "Chậm" "Lỗi")

# Bảo đảm charset UTF-8 bằng Pure Bash (0-subshell) để ${#var} đếm chuẩn ký tự Tiếng Việt
_wptt_eff_cs="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "${_wptt_eff_cs,,}" in
  *utf-8* | *utf8*) : ;;
  *)
    if [[ -n "${LC_ALL:-}" ]]; then
      export LC_ALL="C.UTF-8"
    else
      export LC_CTYPE="C.UTF-8"
    fi
    ;;
esac
unset _wptt_eff_cs

INTERACTIVE=0
if [[ -t 0 && -t 1 && -z "${BATS_TEST_FILENAME:-}" ]]; then
  if { : >/dev/tty; } 2>/dev/null; then
    INTERACTIVE=1
  fi
fi

if [[ -t 1 ]]; then
  U_RST=$'\033[0m'; U_BOLD=$'\033[1m'; U_DIM=$'\033[2m'
  U_RED=$'\033[31m'; U_GRN=$'\033[32m'; U_YEL=$'\033[33m'
  U_CYN=$'\033[36m'; U_WHT=$'\033[97m'
else
  U_RST=""; U_BOLD=""; U_DIM=""; U_RED=""; U_GRN=""; U_YEL=""; U_CYN=""; U_WHT=""
fi
EOL=""
((INTERACTIVE)) && EOL=$'\033[K'

HL=""
HL_W=0
printf -v HL '%*s' "$BOX_W" ""
HL="${HL// /─}"
HL_W=$BOX_W

# ==============================================================================
# QUẢN LÝ TIẾN TRÌNH CON & DỌN DẸP TỨC THỜI (ZERO-HANG / ZERO-TRAP)
# ==============================================================================
PROBE_TMP_DIR=""
scan_pid=""
stty_saved=""

# Khởi tạo thư mục tạm bảo mật tuyệt đối (Root-only 0700, chống Symlink):
# - Ưu tiên 1: /run/wptt (RAM tmpfs chỉ root mới có quyền ghi, không phải world-writable như /dev/shm)
# - Ưu tiên 2: /etc/wptt/tmp (Thư mục nội bộ của WPTangToc với quyền 0700)
_wptt_init_secure_tmp() {
  local base="" candidate=""
  local old_umask
  old_umask="$(umask)"
  umask 077

  for candidate in "/run/wptt" "/etc/wptt/tmp"; do
    # Chặn đứng nếu đường dẫn bị gắn Symlink giả mạo
    [[ -L "$candidate" ]] && continue
    if [[ ! -d "$candidate" ]]; then
      /bin/mkdir -p -m 0700 "$candidate" 2>/dev/null || continue
    else
      /bin/chmod 0700 "$candidate" 2>/dev/null || true
      /bin/chown 0:0 "$candidate" 2>/dev/null || true
    fi
    if [[ -d "$candidate" && ! -L "$candidate" && -w "$candidate" ]]; then
      base="$candidate"
      break
    fi
  done

  if [[ -n "$base" ]]; then
    find "$base" -maxdepth 1 -type d -name 'wptt_uptime_*' -mmin +60 -exec rm -rf -- {} + 2>/dev/null || true
    PROBE_TMP_DIR="$(mktemp -d -p "$base" "wptt_uptime_XXXXXX" 2>/dev/null || true)"
  fi

  if [[ -z "$PROBE_TMP_DIR" || ! -d "$PROBE_TMP_DIR" || -L "$PROBE_TMP_DIR" ]]; then
    /bin/mkdir -p -m 0700 /etc/wptt/tmp 2>/dev/null || true
    PROBE_TMP_DIR="$(mktemp -d -p /etc/wptt/tmp "wptt_uptime_XXXXXX" 2>/dev/null || true)"
  fi

  [[ -n "$PROBE_TMP_DIR" && -d "$PROBE_TMP_DIR" ]] && /bin/chmod 0700 "$PROBE_TMP_DIR" 2>/dev/null || true
  umask "$old_umask"
}

# Dừng toàn bộ cây tiến trình quét ngầm (cả subshell con lẫn tiến trình cháu `curl`)
# ngay lập tức mà KHÔNG cần wait, chống rò rỉ tiến trình mồ côi.
_wptt_kill_scan_tree() {
  local spid="${scan_pid:-}"
  scan_pid=""
  scan_running=0
  if [[ "$spid" =~ ^[0-9]+$ ]] && kill -0 "$spid" 2>/dev/null; then
    local kids="" kpid="" gkids="" all_goners=""
    { IFS= read -r kids <"/proc/$spid/task/$spid/children"; } 2>/dev/null || true
    for kpid in $kids; do
      all_goners+="$kpid "
      gkids=""
      { IFS= read -r gkids <"/proc/$kpid/task/$kpid/children"; } 2>/dev/null || true
      [[ -n "$gkids" ]] && all_goners+="$gkids "
    done
    kill -KILL "$spid" 2>/dev/null || true
    if [[ "$all_goners" =~ ^[0-9\ ]+$ ]]; then
      # shellcheck disable=SC2086
      kill -KILL $all_goners 2>/dev/null || true
    fi
  fi
}

_wptt_cleanup() {
  _wptt_kill_scan_tree
  case "$PROBE_TMP_DIR" in
    /run/wptt/wptt_uptime_?* | /etc/wptt/tmp/wptt_uptime_?*)
      [[ -d "$PROBE_TMP_DIR" && ! -L "$PROBE_TMP_DIR" ]] && rm -rf -- "${PROBE_TMP_DIR:?}" 2>/dev/null || true
      ;;
  esac
  if ((INTERACTIVE)); then
    [[ -n "$stty_saved" ]] && stty "$stty_saved" </dev/tty 2>/dev/null || stty echo isig </dev/tty 2>/dev/null || true
    printf '\033[?25h\033[?1049l' >/dev/tty 2>/dev/null || true
  fi
  return 0
}

# ==============================================================================
# ENGINE DỰNG KHUNG THEO CỘT (PIXEL-PERFECT 80 COLS + PRE-CACHED SPACES)
# ==============================================================================
LINE=""; VLEN=0; OUT=""

# Cache sẵn chuỗi 320 khoảng trắng để cắt chuỗi `${_SPACES:0:len}` (0-syscall, nhanh gấp 10 lần printf)
_SPACES=""
printf -v _SPACES '%*s' 320 ""

# _put "chữ" độ_rộng [l|r|c] [màu] -> Chèn ô có độ rộng cố định
_put() {
  local t="$1" w="$2" a="${3:-l}" c="${4:-}" n=${#1} pad l=0 r=0 sl="" sr=""
  if ((n > w)); then
    t="${t:0:w-1}…"
    n=$w
  fi
  pad=$((w - n))
  case "$a" in
    r) l=$pad ;;
    c) l=$((pad / 2)); r=$((pad - l)) ;;
    *) r=$pad ;;
  esac
  ((l > 0)) && sl="${_SPACES:0:l}"
  ((r > 0)) && sr="${_SPACES:0:r}"
  LINE+="${sl}${c}${t}${U_RST}${sr}"
  VLEN=$((VLEN + w))
}

_seg() {
  local t="$1"
  LINE+="${2:-}${t}${U_RST}"
  VLEN=$((VLEN + ${#t}))
}

_gap() {
  local n="$1"
  ((n > 0)) || return 0
  if ((n <= 320)); then
    LINE+="${_SPACES:0:n}"
  else
    local s=""
    printf -v s '%*s' "$n" ""
    LINE+="$s"
  fi
  VLEN=$((VLEN + n))
}

_sepv() { _seg " │ " "$U_DIM"; }

_flush_row() {
  local pad sp=""
  pad=$((BOX_W - VLEN))
  ((pad < 0)) && pad=0
  if ((pad > 0)); then
    if ((pad <= 320)); then
      sp="${_SPACES:0:pad}"
    else
      printf -v sp '%*s' "$pad" ""
    fi
  fi
  OUT+="${U_CYN}│${U_RST}${LINE}${sp}${U_CYN}│${U_RST}${EOL}"$'\n'
  LINE=""
  VLEN=0
}

_hline() { OUT+="${U_CYN}$1${HL}$2${U_RST}${EOL}"$'\n'; }

# ==============================================================================
# TIỆN ÍCH SỐ & THỜI GIAN (100% 0-SUBSHELL)
# ==============================================================================
MS_VAL=0
_wptt_sec_to_ms() {
  local raw="${1:-0}"
  raw="${raw//,/.}"
  local sec_part="${raw%%.*}"
  local dec_part="${raw#*.}"
  [[ "$sec_part" == "$raw" ]] && dec_part="000"
  dec_part="${dec_part}000"
  dec_part="${dec_part:0:3}"
  sec_part="${sec_part//[^0-9]/}"
  dec_part="${dec_part//[^0-9]/}"
  [[ -z "$sec_part" ]] && sec_part=0
  [[ -z "$dec_part" ]] && dec_part=0
  MS_VAL=$((10#$sec_part * 1000 + 10#$dec_part))
}

_fmt_ms() {
  local ms="$1"
  if ((ms >= 10000)); then
    MS_TXT="$((ms / 1000))s"
  else
    MS_TXT="${ms}ms"
  fi
}

_ms_color() {
  local ms="$1"
  if ((ms <= FAST_MS)); then MC="$U_GRN"
  elif ((ms <= SLOW_MS)); then MC="$U_YEL"
  else MC="$U_RED"; fi
}

_ms_level() {
  local ms="$1"
  if ((ms <= 50)); then LVL=0
  elif ((ms <= 100)); then LVL=1
  elif ((ms <= 200)); then LVL=2
  elif ((ms <= 300)); then LVL=3
  elif ((ms <= 500)); then LVL=4
  elif ((ms <= 800)); then LVL=5
  elif ((ms <= 1500)); then LVL=6
  else LVL=7; fi
}

_fmt_pct() {
  local ok="$1" tot="$2" p
  if ((tot == 0)); then
    PCT_TXT="--"
    PCT_COL="$U_DIM"
    return 0
  fi
  p=$((ok * 1000 / tot))
  PCT_TXT="$((p / 10)).$((p % 10))%"
  if ((p >= 999)); then PCT_COL="$U_GRN"
  elif ((p >= 950)); then PCT_COL="$U_YEL"
  else PCT_COL="$U_RED"; fi
}

_fmt_dur() {
  local s="$1"
  ((s < 0)) && s=0
  if ((s >= 3600)); then
    printf -v DUR_TXT '%d:%02d:%02d' $((s / 3600)) $((s / 60 % 60)) $((s % 60))
  else
    printf -v DUR_TXT '%02d:%02d' $((s / 60)) $((s % 60))
  fi
}

_now() {
  if [[ -n "${EPOCHSECONDS:-}" ]]; then
    NOW="$EPOCHSECONDS"
  else
    printf -v NOW '%(%s)T' -1 2>/dev/null || NOW=$((SECONDS + 1))
  fi
}

term_size_ts=0
_term_size() {
  if ((INTERACTIVE)); then
    _now
    if ((term_cols > 0 && NOW - term_size_ts < 2)); then
      return 0
    fi
    term_size_ts=$NOW
    local rows="" cols=""
    read -r -t 1 rows cols < <({ stty size </dev/tty; } 2>/dev/null) || true
    if [[ "$rows" =~ ^[0-9]+$ && "$cols" =~ ^[0-9]+$ ]]; then
      term_rows="$rows"
      term_cols="$cols"
    else
      term_rows="${LINES:-24}"
      term_cols="${COLUMNS:-80}"
    fi
  else
    term_rows=9999
    term_cols=80
    [[ "${WPTT_UPTIME_ROWS:-}" =~ ^[0-9]+$ ]] && term_rows="$WPTT_UPTIME_ROWS"
    [[ "${WPTT_UPTIME_COLS:-}" =~ ^[0-9]+$ ]] && term_cols="$WPTT_UPTIME_COLS"
  fi
}

# ==============================================================================
# QUÉT DANH SÁCH VHOST
# ==============================================================================
vhost_list=()
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
  domain="${filepath##*/}"
  domain="${domain%.conf}"
  domain="${domain#.}"

  if [[ "$domain" == ?*.?* ]]; then
    if [[ -d "/usr/local/lsws/$domain/html" || -f "/usr/local/lsws/conf/vhosts/$domain/$domain.conf.bkwptt" ]]; then
      vhost_list+=("$domain")
    fi
  fi
done

total_domains="${#vhost_list[@]}"
if ((total_domains == 0)); then
  echo -e "${C_YELLOW:-}Không có website nào trên hệ thống để kiểm tra!${C_RESET:-}"
  sleep 2
  if declare -F wptt_quay_ve_menu >/dev/null 2>&1; then
    wptt_quay_ve_menu "${1:-}" 0
  fi
  exit 0
fi

mapfile -t vhost_list < <(printf "%s\n" "${vhost_list[@]}" | sort -uV)
total_domains="${#vhost_list[@]}"

# ==============================================================================
# ĐỘNG CƠ ĐO LƯỜNG 1 WEBSITE (ATOMIC WRITE + LOCAL LOOPBACK DNS DIAGNOSTIC)
# ==============================================================================
_wptt_probe_write() {
  [[ -L "$1" || -L "$1.tmp" ]] && return 1
  printf '%s|%s|%s|%s|%s\n' "$2" "$3" "$4" "$5" "$6" > "$1.tmp" 2>/dev/null
  mv -f -- "$1.tmp" "$1" 2>/dev/null
}

_wptt_curl_once() {
  local ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
  local -a c_args=(-ksL --max-redirs 3 --connect-timeout 2 --max-time 4 -A "$ua" -o /dev/null -w '%{http_code}|%{time_starttransfer}|%{time_total}')
  [[ "${2:-}" != "get" ]] && c_args=(-I "${c_args[@]}")
  curl "${c_args[@]}" "$1" 2>/dev/null || true
}

_wptt_probe_domain() {
  local dom="$1" out_file="$2"
  local code="000" t_ttfb="0" t_total="0" res="" url ttfb_ms=0 total_ms=0
  local best_code="000" best_ttfb=0 best_total=0

  if [[ -f "/usr/local/lsws/conf/vhosts/$dom/$dom.conf.bkwptt" && ! -f "/usr/local/lsws/conf/vhosts/$dom/$dom.conf" ]]; then
    _wptt_probe_write "$out_file" "$dom" disabled 000 0 0
    return 0
  fi

  for url in "https://${dom}" "http://${dom}" "https://www.${dom}" "http://www.${dom}"; do
    res="$(_wptt_curl_once "$url")"
    IFS='|' read -r code t_ttfb t_total <<<"$res"
    [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"

    if [[ "$code" == "405" || "$code" == "501" || "$code" == "403" ]]; then
      res="$(_wptt_curl_once "$url" get)"
      IFS='|' read -r code t_ttfb t_total <<<"$res"
      [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
    fi

    _wptt_sec_to_ms "$t_ttfb"; ttfb_ms=$MS_VAL
    _wptt_sec_to_ms "$t_total"; total_ms=$MS_VAL

    if [[ "$code" =~ ^(2[0-9]{2}|3[0-9]{2}|401|403)$ ]]; then
      _wptt_probe_write "$out_file" "$dom" online "$code" "$ttfb_ms" "$total_ms"
      return 0
    fi
    if [[ "$code" != "000" && "$best_code" == "000" ]]; then
      best_code="$code"
      best_ttfb="$ttfb_ms"
      best_total="$total_ms"
    fi
  done

  if [[ "$best_code" != "000" ]]; then
    _wptt_probe_write "$out_file" "$dom" http_err "$best_code" "$best_ttfb" "$best_total"
    return 0
  fi

  # Chẩn đoán thông minh: Nếu bên ngoài không vào được (000), kiểm tra nội bộ 127.0.0.1
  # trên cả HTTPS lẫn HTTP để phân biệt chính xác lỗi DNS với lỗi sập Webserver.
  local local_res="" l_code="000" l_ttfb="0" l_tot="0" l_url
  for l_url in "https://${dom}/" "http://${dom}/"; do
    local_res=$(curl -Iks --connect-timeout 1 --max-time 2 \
      --resolve "${dom}:443:127.0.0.1" --resolve "${dom}:80:127.0.0.1" -o /dev/null \
      -w '%{http_code}|%{time_starttransfer}|%{time_total}' "$l_url" 2>/dev/null || true)
    IFS='|' read -r l_code l_ttfb l_tot <<<"$local_res"
    if [[ "$l_code" =~ ^(2[0-9]{2}|3[0-9]{2}|401|403|405)$ ]]; then
      _wptt_sec_to_ms "$l_ttfb"; ttfb_ms=$MS_VAL
      _wptt_sec_to_ms "$l_tot"; total_ms=$MS_VAL
      _wptt_probe_write "$out_file" "$dom" dns_err "$l_code" "$ttfb_ms" "$total_ms"
      return 0
    fi
  done

  _wptt_probe_write "$out_file" "$dom" offline 000 0 0
  return 0
}

# ==============================================================================
# TRẠNG THÁI TRONG BỘ NHỚ
# ==============================================================================
R_STATUS=(); R_CODE=(); R_TTFB=(); R_TOTAL=()
H_HIST=(); H_OK=(); H_TOT=(); SCAN_OF=(); ORDER=()
for ((i = 0; i < total_domains; i++)); do
  R_STATUS[i]="pending"; R_CODE[i]="000"; R_TTFB[i]=0; R_TOTAL[i]=0
  H_HIST[i]=""; H_OK[i]=0; H_TOT[i]=0; SCAN_OF[i]=0; ORDER[i]=$i
done

scan_no=0; scan_running=0; scan_done=0; ingested_n=0
scan_t0=0; scan_dur=0; next_scan_at=0
last_time=""; paused=0; sort_mode=0; order_dirty=0
legend_on=1; page=0; spin_i=0; t_start=0
term_rows=24; term_cols=80; legend_mode=2; per_page=$total_domains; pages=1
dense=0; ncols=1; rows_pp=$total_domains

_wptt_init_secure_tmp

_start_scan() {
  local j active=0
  [[ -n "$PROBE_TMP_DIR" && -d "$PROBE_TMP_DIR" && ! -L "$PROBE_TMP_DIR" ]] || return 1
  _wptt_kill_scan_tree
  scan_no=$((scan_no + 1))
  rm -f -- "${PROBE_TMP_DIR:?}"/res_*.txt "${PROBE_TMP_DIR:?}"/res_*.txt.tmp "${PROBE_TMP_DIR:?}/scan.done" 2>/dev/null
  _now
  scan_t0=$NOW
  scan_done=0
  ingested_n=0
  (
    umask 077
    exec </dev/null >/dev/null 2>&1
    for ((j = 0; j < total_domains; j++)); do
      _wptt_probe_domain "${vhost_list[$j]}" "$PROBE_TMP_DIR/res_${j}.txt" &
      active=$((active + 1))
      if ((active >= MAX_JOBS)); then
        wait -n 2>/dev/null || wait
        active=$((active - 1))
      fi
    done
    wait 2>/dev/null || true
    : > "$PROBE_TMP_DIR/scan.done"
  ) &
  scan_pid=$!
  disown "$scan_pid" 2>/dev/null || true
  scan_running=1
}

_ingest_ready() {
  local i f st code tt tot tok
  for ((i = 0; i < total_domains; i++)); do
    ((SCAN_OF[i] == scan_no)) && continue
    f="$PROBE_TMP_DIR/res_${i}.txt"
    if [[ -f "$f" && ! -L "$f" ]]; then
      IFS='|' read -r _ st code tt tot < "$f"
    elif ((scan_done)); then
      st="offline"; code="000"; tt=0; tot=0
    else
      continue
    fi
    [[ "$st" =~ ^(online|http_err|dns_err|offline|disabled)$ ]] || st="offline"
    [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
    [[ "$tt" =~ ^[0-9]+$ ]] || tt=0
    [[ "$tot" =~ ^[0-9]+$ ]] || tot=0

    R_STATUS[i]="$st"; R_CODE[i]="$code"; R_TTFB[i]="$tt"; R_TOTAL[i]="$tot"
    case "$st" in
      online)
        _ms_level "$tt"; tok="$LVL"
        H_OK[i]=$((H_OK[i] + 1)); H_TOT[i]=$((H_TOT[i] + 1)) ;;
      http_err | dns_err) tok="E"; H_TOT[i]=$((H_TOT[i] + 1)) ;;
      offline) tok="X"; H_TOT[i]=$((H_TOT[i] + 1)) ;;
      *) tok="D" ;;
    esac
    tok="${H_HIST[i]}${tok}"
    ((${#tok} > HIST_LEN)) && tok="${tok:${#tok}-HIST_LEN}"
    H_HIST[i]="$tok"
    SCAN_OF[i]=$scan_no
    ingested_n=$((ingested_n + 1))
  done
}

_finish_scan() {
  _wptt_kill_scan_tree
  _now
  scan_dur=$((NOW - scan_t0))
  ((scan_dur < 0)) && scan_dur=0
  next_scan_at=$((NOW + REFRESH_SEC))
  printf -v last_time '%(%H:%M:%S)T' -1
  order_dirty=1
}

# Sắp xếp danh sách hoàn toàn trong RAM bằng Insertion Sort (0-subshell, không gọi sort/cut bên ngoài)
_build_order() {
  local i j key cur_idx cur_key
  local -a keys=()
  order_dirty=0
  ORDER=()
  for ((i = 0; i < total_domains; i++)); do
    ORDER[i]=$i
  done
  ((sort_mode == 0)) && return 0

  for ((i = 0; i < total_domains; i++)); do
    if ((sort_mode == 1)); then
      case "${R_STATUS[$i]}" in
        offline) key=999999 ;;
        http_err | dns_err) key=$((900000 + R_TTFB[i])) ;;
        disabled | pending) key=-1 ;;
        *) key="${R_TTFB[$i]}" ;;
      esac
    else
      case "${R_STATUS[$i]}" in
        offline) key=6 ;;
        http_err) key=5 ;;
        dns_err) key=4 ;;
        online) ((R_TTFB[i] > SLOW_MS)) && key=3 || key=2 ;;
        pending) key=1 ;;
        *) key=0 ;;
      esac
      key=$((key * 1000000 + R_TTFB[i]))
    fi
    keys[i]=$key
  done

  # Sắp xếp giảm dần theo key, nếu bằng nhau thì giữ nguyên thứ tự index tăng dần
  for ((i = 1; i < total_domains; i++)); do
    cur_idx=${ORDER[i]}
    cur_key=${keys[cur_idx]}
    j=$((i - 1))
    while ((j >= 0 && keys[ORDER[j]] < cur_key)); do
      ORDER[j + 1]=${ORDER[j]}
      j=$((j - 1))
    done
    ORDER[j + 1]=$cur_idx
  done
}

# ==============================================================================
# VẼ KHUNG GIAO DIỆN
# ==============================================================================
_layout() {
  local full_need="$total_domains" overhead=12 dd=0 rows_avail ncols_max need_cols
  _term_size
  ((dense)) && dd=3
  ((full_need > 8)) && full_need=8
  legend_mode=0
  if ((legend_on)); then
    if ((term_rows - 1 - (19 - dd) >= full_need)); then
      legend_mode=2
    elif ((term_rows - 1 - (14 - dd) >= 3)); then
      legend_mode=1
    fi
  fi
  case "$legend_mode" in 2) overhead=19 ;; 1) overhead=14 ;; esac
  overhead=$((overhead - dd))

  rows_avail=$((term_rows - 1 - overhead))
  ((rows_avail < 3)) && rows_avail=3

  ncols_max=$((term_cols / (CELL_W + COL_GAP)))
  ((ncols_max < 1)) && ncols_max=1
  ((ncols_max > MAX_COLS)) && ncols_max=$MAX_COLS

  need_cols=$(((total_domains + rows_avail - 1) / rows_avail))
  ncols=$need_cols
  ((ncols > ncols_max)) && ncols=$ncols_max
  ((ncols < 1)) && ncols=1

  rows_pp=$(((total_domains + ncols - 1) / ncols))
  ((rows_pp > rows_avail)) && rows_pp=$rows_avail
  per_page=$((rows_pp * ncols))
  pages=$(((total_domains + per_page - 1) / per_page))
  ((page >= pages)) && page=$((pages - 1))
  ((page < 0)) && page=0

  if ((ncols > 1)); then
    BOX_W=$((ncols * CELL_W + (ncols - 1) * COL_GAP + 1))
  else
    BOX_W=$BOX_W_MIN
  fi
  if ((BOX_W != HL_W)); then
    printf -v HL '%*s' "$BOX_W" ""
    HL="${HL// /─}"
    HL_W=$BOX_W
  fi
}

_render_hist() {
  local h="${H_HIST[$1]}" n k ch out=""
  n=${#h}
  for ((k = n; k < HIST_LEN; k++)); do out+="${U_DIM}·${U_RST}"; done
  for ((k = 0; k < n; k++)); do
    ch="${h:k:1}"
    case "$ch" in
      [0-3]) out+="${U_GRN}${SPARK:ch:1}${U_RST}" ;;
      [45]) out+="${U_YEL}${SPARK:ch:1}${U_RST}" ;;
      [67]) out+="${U_RED}${SPARK:ch:1}${U_RST}" ;;
      E) out+="${U_RED}▲${U_RST}" ;;
      X) out+="${U_RED}×${U_RST}" ;;
      *) out+="${U_DIM}–${U_RST}" ;;
    esac
  done
  LINE+="$out"
  VLEN=$((VLEN + HIST_LEN))
}

_render_row() {
  local i="$1" n="$2" st code tt tot ncol="$U_DIM"
  st="${R_STATUS[$i]}"; code="${R_CODE[$i]}"; tt="${R_TTFB[$i]}"; tot="${R_TOTAL[$i]}"
  ((scan_running && SCAN_OF[i] != scan_no)) && ncol="$U_CYN"

  _gap 1
  _put "$n" 3 r "$ncol"
  _gap 1
  _put "${vhost_list[$i]}" 22 l "${U_BOLD}${U_WHT}"
  _gap 1

  case "$st" in
    online)
      if ((tt > SLOW_MS)); then _put "● Chậm" 11 l "$U_YEL"; else _put "● Online" 11 l "$U_GRN"; fi
      _gap 1
      case "$code" in
        2*) _put "$code" 4 r "$U_GRN" ;;
        3*) _put "$code" 4 r "$U_YEL" ;;
        *) _put "$code" 4 r "$U_RED" ;;
      esac
      _gap 1
      _ms_color "$tt"; _fmt_ms "$tt"; _put "$MS_TXT" 6 r "$MC"
      _gap 1
      _fmt_ms "$tot"; _put "$MS_TXT" 6 r "$U_DIM" ;;
    http_err)
      _put "▲ Lỗi HTTP" 11 l "$U_RED"
      _gap 1
      _put "$code" 4 r "${U_BOLD}${U_RED}"
      _gap 1
      _fmt_ms "$tt"; _put "$MS_TXT" 6 r "$U_DIM"
      _gap 1
      _fmt_ms "$tot"; _put "$MS_TXT" 6 r "$U_DIM" ;;
    dns_err)
      _put "▲ Lỗi DNS" 11 l "$U_YEL"
      _gap 1
      _put "$code" 4 r "$U_YEL"
      _gap 1
      _fmt_ms "$tt"; _put "$MS_TXT" 6 r "$U_DIM"
      _gap 1
      _fmt_ms "$tot"; _put "$MS_TXT" 6 r "$U_DIM" ;;
    offline)
      _put "✖ Offline" 11 l "${U_BOLD}${U_RED}"
      _gap 1; _put "---" 4 r "$U_DIM"
      _gap 1; _put "---" 6 r "$U_DIM"
      _gap 1; _put "---" 6 r "$U_DIM" ;;
    disabled)
      _put "○ Tạm khóa" 11 l "$U_YEL"
      _gap 1; _put "---" 4 r "$U_DIM"
      _gap 1; _put "---" 6 r "$U_DIM"
      _gap 1; _put "---" 6 r "$U_DIM" ;;
    *)
      _put "◌ Đang quét" 11 l "$U_CYN"
      _gap 1; _put "···" 4 r "$U_DIM"
      _gap 1; _put "···" 6 r "$U_DIM"
      _gap 1; _put "···" 6 r "$U_DIM" ;;
  esac
  _gap 1
  _render_hist "$i"
  _gap 1
  _fmt_pct "${H_OK[$i]}" "${H_TOT[$i]}"
  _put "$PCT_TXT" 6 r "$PCT_COL"
}

_render_colhead() {
  _gap 1; _put "#" 3 r "$U_DIM"; _gap 1
  _put "Domain" 22 l "${U_BOLD}${U_CYN}"; _gap 1
  _put "Trạng thái" 11 l "${U_BOLD}${U_CYN}"; _gap 1
  _put "HTTP" 4 r "${U_BOLD}${U_CYN}"; _gap 1
  _put "TTFB" 6 r "${U_BOLD}${U_CYN}"; _gap 1
  _put "Tổng" 6 r "${U_BOLD}${U_CYN}"; _gap 1
  _put "Lịch sử" "$HIST_LEN" l "${U_BOLD}${U_CYN}"; _gap 1
  _put "Uptime" 6 r "${U_BOLD}${U_CYN}"
}

_render_legend_full() {
  _gap 1; _put "TTFB" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "Thời gian chờ phản hồi đầu tiên: DNS + kết nối + SSL + PHP xử lý"; _flush_row
  _gap 1; _put "Tổng" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "Tổng thời gian hoàn tất 1 yêu cầu (chỉ lấy header, không tải trang)"; _flush_row
  _gap 1; _put "Lịch sử" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "10 lần quét gần nhất: "
  _seg "▁" "$U_GRN"; _seg " nhanh → "; _seg "█" "$U_RED"; _seg " chậm"; _sepv
  _seg "×" "$U_RED"; _seg " lỗi"; _sepv; _seg "–" "$U_DIM"; _seg " khóa"; _flush_row
  _gap 1; _put "Uptime" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "% lần Online trên tổng số lần quét kể từ lúc mở màn hình này"; _flush_row
  _gap 1; _put "Màu" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "■" "$U_GRN"; _seg " xanh ≤${FAST_MS}ms nhanh"; _sepv
  _seg "■" "$U_YEL"; _seg " vàng ≤${SLOW_MS}ms ổn"; _sepv
  _seg "■" "$U_RED"; _seg " đỏ >${SLOW_MS}ms chậm"; _flush_row
  _gap 1; _put "Lưu ý" 7 l "${U_BOLD}${U_CYN}"; _gap 1
  _seg "Lỗi DNS = OLS nội bộ vẫn chạy tốt nhưng tên miền chưa trỏ đúng IP VPS"; _flush_row
}

_render_legend_compact() {
  _gap 1
  _seg "TTFB:" "${U_BOLD}${U_CYN}"; _seg " chờ phản hồi đầu tiên"; _sepv
  _seg "Tổng:" "${U_BOLD}${U_CYN}"; _seg " cả yêu cầu"; _sepv
  _seg "Màu:" "${U_BOLD}${U_CYN}"
  _seg " ≤${FAST_MS}" "$U_GRN"; _seg " ≤${SLOW_MS}" "$U_YEL"; _seg " >${SLOW_MS}ms" "$U_RED"
  _flush_row
}

_key() {
  _seg "[$1]" "${U_BOLD}${U_YEL}"
  _seg " $2"
}

_render() {
  local i c r idx base c_on=0 c_slow=0 c_err=0 c_off=0 c_dis=0 s_ttfb=0 n_ttfb=0 mn=-1 mx=0 s_ok=0 s_tot=0
  local remain pg_txt
  OUT=""; LINE=""; VLEN=0
  _layout

  if ((INTERACTIVE && term_cols < BOX_W + 2)); then
    OUT="Cửa sổ Terminal quá hẹp (cần tối thiểu $((BOX_W + 2)) cột, hiện có ${term_cols}). Hãy mở rộng cửa sổ hoặc nhấn [q] để thoát.${EOL}"$'\n'
    return 0
  fi

  for ((i = 0; i < total_domains; i++)); do
    case "${R_STATUS[$i]}" in
      online)
        c_on=$((c_on + 1))
        s_ttfb=$((s_ttfb + R_TTFB[i])); n_ttfb=$((n_ttfb + 1))
        ((mn < 0 || R_TTFB[i] < mn)) && mn="${R_TTFB[$i]}"
        ((R_TTFB[i] > mx)) && mx="${R_TTFB[$i]}"
        ((R_TTFB[i] > SLOW_MS)) && c_slow=$((c_slow + 1)) ;;
      http_err | dns_err) c_err=$((c_err + 1)) ;;
      offline) c_off=$((c_off + 1)) ;;
      disabled) c_dis=$((c_dis + 1)) ;;
    esac
    s_ok=$((s_ok + H_OK[i])); s_tot=$((s_tot + H_TOT[i]))
  done

  _hline "╭" "╮"
  if ((!dense)); then
    _put "BẢNG TRẠNG THÁI HOẠT ĐỘNG WEBSITE (REALTIME UPTIME)" "$BOX_W" c "${U_BOLD}${U_YEL}"; _flush_row
    _hline "├" "┤"
  fi

  # --- Tổng quan ---
  _gap 1
  _seg "Tổng " "$U_DIM"; _seg "$total_domains" "${U_BOLD}${U_WHT}"; _sepv
  _seg "● Online " "$U_GRN"; _seg "$c_on" "${U_BOLD}${U_GRN}"
  if ((c_slow > 0)); then _seg " ($c_slow chậm)" "$U_YEL"; fi
  _sepv
  _seg "▲ Lỗi " "$U_RED"; _seg "$c_err" "${U_BOLD}${U_RED}"; _sepv
  _seg "✖ Offline " "$U_RED"; _seg "$c_off" "${U_BOLD}${U_RED}"; _sepv
  _seg "○ Tạm khóa " "$U_YEL"; _seg "$c_dis" "${U_BOLD}${U_YEL}"
  _flush_row

  _gap 1
  _seg "TTFB trung bình " "$U_DIM"
  if ((n_ttfb > 0)); then
    _ms_color $((s_ttfb / n_ttfb)); _fmt_ms $((s_ttfb / n_ttfb)); _seg "$MS_TXT" "${U_BOLD}${MC}"
    _sepv; _seg "Nhanh nhất " "$U_DIM"; _ms_color "$mn"; _fmt_ms "$mn"; _seg "$MS_TXT" "$MC"
    _sepv; _seg "Chậm nhất " "$U_DIM"; _ms_color "$mx"; _fmt_ms "$mx"; _seg "$MS_TXT" "$MC"
  else
    _seg "--" "$U_DIM"
  fi
  _sepv; _seg "Uptime " "$U_DIM"
  _fmt_pct "$s_ok" "$s_tot"; _seg "$PCT_TXT" "${U_BOLD}${PCT_COL}"
  _flush_row

  # --- Dòng trạng thái quét ---
  _now
  _gap 1
  if ((scan_running)); then
    spin_i=$(((spin_i + 1) % ${#SPIN[@]}))
    _seg "[${SPIN[$spin_i]}] Đang quét " "${U_BOLD}${U_CYN}"
    _seg "${ingested_n}/${total_domains}" "${U_BOLD}${U_WHT}"
  elif ((paused)); then
    _seg "‖ TẠM DỪNG" "${U_BOLD}${U_YEL}"
    _seg " (nhấn Space để tiếp tục)" "$U_DIM"
  else
    remain=$((next_scan_at - NOW))
    ((remain < 0)) && remain=0
    _seg "✓ ${last_time}" "${U_BOLD}${U_GRN}"
    _sepv; _seg "Quét lại sau " "$U_DIM"; _seg "${remain}s" "$U_WHT"
    ((scan_dur > 0)) && { _sepv; _seg "Mất " "$U_DIM"; _seg "${scan_dur}s" "$U_WHT"; }
  fi
  _sepv; _seg "Lần " "$U_DIM"; _seg "#${scan_no}" "$U_WHT"
  _fmt_dur $((NOW - t_start))
  _sepv; _seg "Chạy " "$U_DIM"; _seg "$DUR_TXT" "$U_WHT"
  if ((pages > 1)); then
    pg_txt="Trang $((page + 1))/${pages} [←→]"
    _gap $((BOX_W - VLEN - ${#pg_txt} - 1))
    _seg "$pg_txt" "$U_CYN"
  fi
  _flush_row

  _hline "├" "┤"
  # --- Tiêu đề cột (lặp lại cho mỗi cột) ---
  for ((c = 0; c < ncols; c++)); do
    ((c > 0)) && _sepv
    _render_colhead
  done
  _flush_row
  ((!dense)) && _hline "├" "┤"

  # --- Danh sách website: xếp theo cột dọc, rows_pp dòng x ncols cột ---
  base=$((page * per_page))
  for ((r = 0; r < rows_pp; r++)); do
    for ((c = 0; c < ncols; c++)); do
      ((c > 0)) && _sepv
      idx=$((base + c * rows_pp + r))
      if ((idx < total_domains)); then
        _render_row "${ORDER[$idx]}" $((idx + 1))
      else
        _gap "$CELL_W"
      fi
    done
    _flush_row
  done

  _hline "├" "┤"
  case "$legend_mode" in
    2) _render_legend_full; _hline "├" "┤" ;;
    1) _render_legend_compact; _hline "├" "┤" ;;
  esac

  # --- Phím tắt ---
  _gap 1
  _key "q" "Thoát"; _gap 2
  _key "r" "Quét lại"; _gap 2
  _key "s" "Xếp: ${SORT_NAMES[$sort_mode]}"; _gap 2
  _key "i" "Chú thích"; _gap 2
  _key "Space" "Dừng"; _gap 2
  _key "d" "Gọn"
  _flush_row
  _hline "╰" "╯"
}

_paint() {
  if ((INTERACTIVE)); then
    printf '\033[H%s\033[J' "$OUT" >/dev/tty 2>/dev/null || return 1
  else
    printf '%s' "$OUT"
  fi
}

# ==============================================================================
# KHỞI CHẠY CHÍNH
# ==============================================================================
declare -F wptt_logs >/dev/null 2>&1 && wptt_logs "INFO" "Khởi chạy chế độ kiểm tra hoạt động Realtime"
_now
t_start=$NOW

# --- Chế độ không có TTY (Cron, Pipe, BATS Test): Quét 1 lần rồi in bảng tĩnh ---
if ((!INTERACTIVE)); then
  _start_scan
  waited=0
  while [[ ! -f "$PROBE_TMP_DIR/scan.done" ]] && ((waited < 120)); do
    sleep 0.25
    waited=$((waited + 1))
  done
  scan_done=1
  _ingest_ready
  _finish_scan
  _build_order
  _render
  _paint
  _wptt_cleanup
  exit 0
fi

# --- Chế độ tương tác Realtime ---
stty_saved="$(stty -g </dev/tty 2>/dev/null || true)"
stty -echo -isig </dev/tty 2>/dev/null || true
printf '\033[?1049h\033[?25l\033[2J' >/dev/tty 2>/dev/null || true

while :; do
  # 1. Chốt chặn chống Loop vô tận khi rớt SSH hoặc treo máy quá lâu
  [[ -t 0 && -t 1 ]] || break
  _now
  if ((NOW - t_start >= MAX_SESSION_SEC)); then
    break
  fi

  if ((scan_running)); then
    [[ -f "$PROBE_TMP_DIR/scan.done" ]] && scan_done=1
    _ingest_ready
    ((scan_done)) && _finish_scan
  elif ((!paused && NOW >= next_scan_at)); then
    _start_scan
  fi

  ((order_dirty)) && _build_order
  _render
  _paint || break

  if ((scan_running)); then tmo=0.2; else tmo=1; fi
  key=""
  IFS= read -rsn1 -t "$tmo" key </dev/tty 2>/dev/null
  rc=$?
  # Trong Bash, read -t hết giờ trả về rc > 128 (thường là 142 = SIGALRM).
  # Nếu rc >= 1 và rc < 128 (tức là EOF / đóng TTY / lỗi I/O), thoát ngay lập tức!
  if ((rc > 0 && rc < 128)); then
    break
  fi
  [[ -z "$key" ]] && continue

  case "$key" in
    q | Q | $'\003' | $'\004') break ;;
    r | R) ((!scan_running)) && next_scan_at=0 && paused=0 ;;
    s | S) sort_mode=$(((sort_mode + 1) % 3)); order_dirty=1 ;;
    i | I) legend_on=$((1 - legend_on)) ;;
    d | D) dense=$((1 - dense)) ;;
    n | N) page=$((page + 1)) ;;
    b | B) page=$((page - 1)) ;;
    ' ') paused=$((1 - paused)); ((!paused)) && next_scan_at=0 ;;
    $'\e')
      rest=""
      IFS= read -rsn2 -t 0.05 rest </dev/tty 2>/dev/null || true
      case "$rest" in
        '[C' | '[B') page=$((page + 1)) ;;
        '[D' | '[A') page=$((page - 1)) ;;
      esac
      ;;
  esac
done

_wptt_cleanup
if declare -F wptt_quay_ve_menu >/dev/null 2>&1; then
  wptt_quay_ve_menu "${1:-}" 0
fi
