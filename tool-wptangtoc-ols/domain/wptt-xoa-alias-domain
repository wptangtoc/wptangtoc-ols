#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  Xoá thiết lập domain alias đã thiết lập trước đó
EOF
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DOMAIN ➜ Xóa Tên Miền Phụ (Parked/Alias Domain)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "${1:-}" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-domain-main 1"
fi

. /etc/wptt/tenmien 2>/dev/null
lua_chon_NAME "Xóa Alias"

if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 0
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền $NAME không tồn tại trên hệ thống!${C_RESET}"
  sleep 3
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
httpd_conf="/usr/local/lsws/conf/httpd_config.conf"

if [[ ! -f "$vhost_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file cấu hình Vhost của $NAME!${C_RESET}"
  sleep 3
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

if [[ ! -f "$httpd_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file cấu hình máy chủ OpenLiteSpeed ($httpd_conf)!${C_RESET}"
  sleep 3
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# ==============================================================================
# KHÓA ĐỒNG THỜI TOÀN HỆ THỐNG (GLOBAL & DOMAIN CONCURRENCY CONTROL)
# ==============================================================================
/bin/mkdir -p "/etc/wptt/tmp"

# 1. Khóa riêng biệt theo domain
LOCK_DOMAIN="/etc/wptt/tmp/wptt_lock_vhost_${NAME}.lock"
exec 200>"$LOCK_DOMAIN"
if ! flock -n 200; then
  _runloi "Website $NAME đang có một tác vụ khác can thiệp. Vui lòng thử lại sau!"
  sleep 2
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# 2. Khóa toàn cục cho httpd_config.conf (Chống ghi đè giữa các domain chạy song song)
LOCK_GLOBAL="/etc/wptt/tmp/wptt_lock_httpd_config.lock"
exec 201>"$LOCK_GLOBAL"
if ! flock -x -w 10 201; then
  _runloi "Hệ thống đang bận cập nhật file máy chủ httpd_config.conf. Vui lòng thử lại sau!"
  sleep 2
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# ==============================================================================
# TRÍCH XUẤT DANH SÁCH ALIAS (TỐI ƯU BASH THUẦN - HẠN CHẾ SUBSHELL)
# ==============================================================================
raw_alias_line=$(grep "^[[:space:]]*vhAliases[[:space:]]" "$vhost_conf" 2>/dev/null || true)

if [[ -z "$raw_alias_line" ]]; then
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}KHÔNG TÌM THẤY ALIAS DOMAIN${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website ${C_YELLOW}$NAME${C_RESET} hiện tại chưa được thiết lập" 2
  left_text "bất kỳ tên miền Alias (Parked Domain) nào!" 2
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  sleep 3
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# Cắt bỏ tiền tố vhAliases và khoảng trắng
clean_alias_str="${raw_alias_line#*vhAliases}"
clean_alias_str="${clean_alias_str// /}"

selects=()
while IFS= read -r line; do
  [[ -n "$line" ]] && selects+=("$line")
done < <(tr ',' '\n' <<<"$clean_alias_str")

total=${#selects[@]}

if [[ $total -eq 0 ]]; then
  echo -e "\n${C_RED}Lỗi: Danh sách Alias rỗng!${C_RESET}"
  sleep 2
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# ==============================================================================
# BƯỚC 3: IN DANH SÁCH VÀ CHỌN ALIAS ĐỂ XÓA
# ==============================================================================
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}DANH SÁCH ALIAS CỦA: ${C_YELLOW}$NAME${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
i=1
for val in "${selects[@]}"; do
  left_text "  ${C_CYAN}$i)${C_RESET} ${C_BOLD_WHITE}$val${C_RESET}" 2
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập số thứ tự Alias bạn muốn xóa (1-$total) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  if [[ "$REPLY" == "0" || -z "$REPLY" ]]; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    if [[ "${1:-}" == "98" ]]; then
      exec /etc/wptt/wptt-domain-main 1
    fi
    exit 0
  fi

  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "$total" ]; then
    domain_xoa="${selects[$((REPLY - 1))]}"
    break
  else
    echo -e "${C_RED}Lựa chọn không hợp lệ! Vui lòng nhập số từ 1 đến $total.${C_RESET}"
  fi
done

if ! wptt_xac_nhan "Bạn có chắc chắn muốn XÓA Alias Domain này không?" \
  "Tên miền bị xóa: ${C_RED}$domain_xoa${C_RESET}" \
  "Tên miền gốc   : ${C_GREEN}$NAME${C_RESET}" \
  "Đồng ý Xóa" "Hủy thao tác"; then
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 0
fi

_runing "Gỡ bỏ Alias $domain_xoa khỏi Vhost $NAME"

# ==============================================================================
# GIAO DỊCH 2 TỆP NGUYÊN TỬ (TÁCH BIỆT BẢN BACKUP VÀ BẢN CANDIDATE)
# ==============================================================================
# Tạo 2 tệp backup nguyên trạng (Clean Backup)
bak_vhost=$(/bin/mktemp -p "/etc/wptt/tmp" "vhost_${NAME}_bak_XXXXXX.conf")
bak_httpd=$(/bin/mktemp -p "/etc/wptt/tmp" "httpd_bak_XXXXXX.conf")

# Tạo 2 tệp candidate dùng để chỉnh sửa thử nghiệm (Working Copy)
tmp_vhost=$(/bin/mktemp -p "/etc/wptt/tmp" "vhost_${NAME}_cand_XXXXXX.conf")
tmp_httpd=$(/bin/mktemp -p "/etc/wptt/tmp" "httpd_cand_XXXXXX.conf")

# Đăng ký bẫy dọn dẹp file nháp
trap '/bin/rm -f -- "$bak_vhost" "$bak_httpd" "$tmp_vhost" "$tmp_httpd" 2>/dev/null || true' EXIT INT TERM

# Sao chép nguyên trạng và bảo toàn tuyệt đối thuộc tính/quyền tệp (-fp)
/bin/cp -fp -- "$vhost_conf" "$bak_vhost" || {
  _runloi "Không thể tạo file backup vhost"
  exit 1
}
/bin/cp -fp -- "$httpd_conf" "$bak_httpd" || {
  _runloi "Không thể tạo file backup httpd_config"
  exit 1
}
/bin/cp -fp -- "$vhost_conf" "$tmp_vhost" || {
  _runloi "Không thể chuẩn bị file candidate vhost"
  exit 1
}
/bin/cp -fp -- "$httpd_conf" "$tmp_httpd" || {
  _runloi "Không thể chuẩn bị file candidate httpd"
  exit 1
}

# Thực hiện sửa trên bản candidate
if [[ $total -eq 1 ]]; then
  /bin/sed -i -E "/^[[:space:]]*map[[:space:]]+${NAME}[[:space:]]+/d" "$tmp_httpd"
  /bin/sed -i "/listener.*http/a \  map                     $NAME $NAME" "$tmp_httpd"
  /bin/sed -i "/^[[:space:]]*vhAliases[[:space:]]/d" "$tmp_vhost"
else
  new_aliases=()
  for a in "${selects[@]}"; do
    [[ "$a" != "$domain_xoa" ]] && new_aliases+=("$a")
  done

  printf -v domain_alias_con_lai "%s," "${new_aliases[@]}"
  domain_alias_con_lai="${domain_alias_con_lai%,}"

  /bin/sed -i -E "/^[[:space:]]*map[[:space:]]+${NAME}[[:space:]]+/d" "$tmp_httpd"
  /bin/sed -i "/listener.*http/a \  map                     $NAME $NAME,$domain_alias_con_lai" "$tmp_httpd"
  /bin/sed -i -E "s|^([[:space:]]*vhAliases[[:space:]]+).*|\1$domain_alias_con_lai|" "$tmp_vhost"
fi

# ==============================================================================
# COMMIT GIAO DỊCH VÀ KIỂM TRA TỰ HOÀN NGUYÊN (REVERT ON ERROR)
# ==============================================================================
# Ghi cấu hình candidate vào file thật (giữ nguyên quyền sở hữu và phân quyền)
/bin/cp -fp -- "$tmp_vhost" "$vhost_conf"
/bin/cp -fp -- "$tmp_httpd" "$httpd_conf"

# Kiểm tra cú pháp bằng nhị phân OpenLiteSpeed
if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
  _runloi "Lỗi cú pháp OpenLiteSpeed! Đang khôi phục lại cấu hình gốc từ bản backup sạch..."

  # ROLLBACK CHUẨN: Chép lại từ bản backup nguyên trạng (bak_*), KHÔNG chép từ tmp_*
  /bin/cp -fp -- "$bak_vhost" "$vhost_conf"
  /bin/cp -fp -- "$bak_httpd" "$httpd_conf"

  # Kiểm tra lại cú pháp sau khi đã rollback để đảm bảo máy chủ không bị chết
  if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
    _runloi "CẢNH BÁO NGUY HIỂM: Cấu hình gốc vẫn không qua được kiểm tra cú pháp!"
  else
    _runloi "Đã hoàn nguyên hệ thống về trạng thái ban đầu an toàn 100%."
  fi

  wptt_logs "ERROR" "Lỗi kiểm tra cú pháp OpenLiteSpeed khi xóa alias $domain_xoa trên $NAME. Đã tự động rollback."

  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

# CHỈ THỰC THI RELOAD KHI ĐÃ VƯỢT QUA BÀI TEST VALIDATION CÚ PHÁP
if ! wptt_smart_reload_lsws >/dev/null 2>&1; then
  _runloi "Không thể reload OpenLiteSpeed! Đang hoàn nguyên cấu hình cũ..."
  /bin/cp -fp -- "$bak_vhost" "$vhost_conf"
  /bin/cp -fp -- "$bak_httpd" "$httpd_conf"
  wptt_smart_reload_lsws >/dev/null 2>&1 || true

  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi

_rundone "Gỡ bỏ Alias $domain_xoa khỏi Vhost $NAME"
wptt_logs "INFO" "Xóa alias domain $domain_xoa khỏi $NAME thành công"

echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT XÓA ALIAS DOMAIN${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website gốc        : ${C_YELLOW}$NAME${C_RESET}" 2
left_text "Alias đã gỡ bỏ     : ${C_RED}$domain_xoa${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

sleep 2
if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi
