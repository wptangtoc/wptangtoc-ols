#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  XÓA TÊN MIỀN PHỤ (PARKED DOMAIN / ALIAS DOMAIN)

  Chức năng này cho phép gỡ bỏ một tên miền Alias đã được
  thiết lập trước đó khỏi website WordPress trên OpenLiteSpeed.

  Alias Domain là tên miền bổ sung sử dụng chung mã nguồn,
  Document Root và Database với website gốc.

  Ví dụ:
  ➜ Website gốc : wptangtoc.com
  ➜ Alias 1      : wptangtoc.vn
  ➜ Alias 2      : wptangtoc.net

  Khi xóa Alias wptangtoc.vn, tên miền này sẽ được gỡ khỏi
  cấu hình Virtual Host và Listener của OpenLiteSpeed.
  Website gốc và Alias còn lại vẫn được giữ nguyên.

  1. CHỨC NĂNG CHÍNH

  ➜ Hiển thị danh sách Alias Domain đang được cấu hình.
  ➜ Cho phép chọn chính xác Alias cần xóa theo số thứ tự.
  ➜ Yêu cầu xác nhận trước khi thực hiện thao tác.
  ➜ Gỡ Alias khỏi cấu hình Virtual Host của website gốc.
  ➜ Cập nhật lại Domain Mapping trên Listener máy chủ.
  ➜ Tự động xử lý cấu hình khi xóa Alias cuối cùng.
  ➜ Giữ nguyên các Alias khác chưa được chọn xóa.
  ➜ Kiểm tra cú pháp cấu hình OpenLiteSpeed trước khi reload.
  ➜ Tự động sao lưu cấu hình trước khi chỉnh sửa.
  ➜ Tự động hoàn nguyên cấu hình nếu kiểm tra hoặc reload thất bại.
  ➜ Ghi nhật ký thao tác để hỗ trợ quản trị và xử lý sự cố.

  2. QUY TRÌNH XÓA ALIAS DOMAIN

  Bước 1:
  ➜ Chọn website gốc muốn quản lý Alias Domain.

  Bước 2:
  ➜ Hệ thống hiển thị danh sách Alias đang được thiết lập.

  Bước 3:
  ➜ Nhập số thứ tự Alias muốn xóa.
  ➜ Nhập 0 để thoát hoặc hủy thao tác.

  Bước 4:
  ➜ Kiểm tra lại tên miền Alias và website gốc.
  ➜ Xác nhận đồng ý xóa Alias.

  Bước 5:
  ➜ Hệ thống sao lưu cấu hình hiện tại.
  ➜ Cập nhật cấu hình Virtual Host và Listener.
  ➜ Kiểm tra cú pháp bằng OpenLiteSpeed.

  Bước 6:
  ➜ Nếu cấu hình hợp lệ, hệ thống reload OpenLiteSpeed.
  ➜ Nếu phát sinh lỗi, hệ thống sẽ cố gắng hoàn nguyên cấu hình
    trước đó để hạn chế ảnh hưởng đến các website đang hoạt động.

  3. LƯU Ý QUAN TRỌNG TRƯỚC KHI XÓA

  ⚠️ Xóa Alias không đồng nghĩa với xóa website WordPress.

  ➜ Chỉ gỡ tên miền Alias khỏi cấu hình máy chủ.
  ➜ Không xóa mã nguồn WordPress của website gốc.
  ➜ Không xóa Database WordPress.
  ➜ Không xóa dữ liệu, bài viết, tài khoản hoặc Media.
  ➜ Không xóa website gốc.
  ➜ Không chủ động xóa chứng chỉ SSL Let's Encrypt hiện có.
  ➜ Các Alias khác của website gốc vẫn được giữ lại.

  LƯU Ý:
  Sau khi xóa Alias, tên miền đó sẽ không còn được ánh xạ
  đến website gốc thông qua cấu hình OpenLiteSpeed đã cập nhật.

  Nếu DNS vẫn trỏ về VPS, tên miền có thể không còn hiển thị
  website này hoặc có thể được phục vụ bởi cấu hình khác
  tùy thuộc vào cấu hình máy chủ.

  4. TRƯỜNG HỢP XÓA ALIAS CUỐI CÙNG

  Nếu website chỉ có một Alias Domain:

  ➜ Hệ thống gỡ dòng vhAliases khỏi Virtual Host.
  ➜ Domain Mapping được đưa về trạng thái chỉ sử dụng
    tên miền gốc.
  ➜ Website gốc tiếp tục hoạt động bình thường nếu cấu hình
    còn lại hợp lệ.

  Nếu website còn nhiều Alias:

  ➜ Chỉ Alias được chọn mới bị loại bỏ.
  ➜ Danh sách Alias còn lại được cập nhật.
  ➜ Không chủ động thay đổi các Alias khác.

  5. KHUYẾN NGHỊ SAU KHI XÓA
  ➜ Kiểm tra website gốc vẫn truy cập bình thường.
  ➜ Kiểm tra các Alias còn lại vẫn hoạt động.
  ➜ Nếu không còn sử dụng tên miền đã xóa, hãy cân nhắc
    cập nhật hoặc xóa bản ghi DNS tương ứng tại nhà cung cấp.
  ➜ Nếu Alias được sử dụng trong chiến dịch SEO hoặc quảng cáo,
    hãy kiểm tra các liên kết và cấu hình Redirect liên quan.
  ➜ Nếu cần sử dụng lại Alias, có thể thiết lập lại sau khi
    đảm bảo tên miền không bị xung đột với website khác.

EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ DOMAIN ➜ Xóa Tên Miền Phụ (Parked/Alias Domain)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt/tenmien 2>/dev/null
lua_chon_NAME "Xóa Alias"

if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "${1:-}" 0
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền $NAME không tồn tại trên hệ thống!${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
httpd_conf="/usr/local/lsws/conf/httpd_config.conf"

if [[ ! -f "$vhost_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file cấu hình Vhost của $NAME!${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

if [[ ! -f "$httpd_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file cấu hình máy chủ OpenLiteSpeed ($httpd_conf)!${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# KHÓA ĐỒNG THỜI TOÀN HỆ THỐNG (GLOBAL & DOMAIN CONCURRENCY CONTROL)
# ==============================================================================
/bin/mkdir -p "/etc/wptt/tmp"

# 2. Khóa toàn cục tài nguyên máy chủ httpd_config.conf (chống xung đột giữa các domain)
# ==============================================================================
# TRÍCH XUẤT DANH SÁCH ALIAS (TỐI ƯU BASH THUẦN - HẠN CHẾ SUBSHELL)
# ==============================================================================
raw_alias_line=$(grep "^[[:space:]]*vhAliases[[:space:]]" "$vhost_conf" 2>/dev/null || true)

if [[ -z "$raw_alias_line" ]]; then
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}KHÔNG TÌM THẤY ALIAS DOMAIN${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website ${C_YELLOW}$NAME${C_RESET} hiện tại chưa được thiết lập" 2
  left_text "bất kỳ tên miền Alias (Parked Domain) nào!" 2
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

clean_alias_str="${raw_alias_line#*vhAliases}"
clean_alias_str="${clean_alias_str// /}"

selects=()
while IFS= read -r line; do
  [[ -n "$line" ]] && selects+=("$line")
done < <(tr ',' '\n' <<<"$clean_alias_str")

total=${#selects[@]}

if [[ $total -eq 0 ]]; then
  echo -e "\n${C_RED}Lỗi: Danh sách Alias rỗng!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# IN DANH SÁCH VÀ CHỌN ALIAS ĐỂ XÓA
# ==============================================================================
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}DANH SÁCH ALIAS CỦA: ${C_YELLOW}$NAME${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
i=1
for val in "${selects[@]}"; do
  left_text "  ${C_CYAN}$i)${C_RESET} ${C_BOLD_WHITE}$val${C_RESET}" 2
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập số thứ tự Alias bạn muốn xóa (1-$total) [0=Thoát]: ${C_RESET}"
  read -r REPLY

  if [[ "$REPLY" == "0" || -z "$REPLY" ]]; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    wptt_quay_ve_menu "${1:-}" 0
  fi

  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "$total" ]; then
    domain_xoa="${selects[$((REPLY - 1))]}"
    break
  else
    echo -e "${C_RED}Lựa chọn không hợp lệ! Vui lòng nhập số từ 1 đến $total.${C_RESET}"
  fi
done

if ! wptt_xac_nhan "Bạn có chắc chắn muốn XÓA Alias Domain này không?" \
  "Tên miền bị xóa: ${C_RED}$domain_xoa${C_RESET}" \
  "Tên miền gốc   : ${C_GREEN}$NAME${C_RESET}" \
  "Đồng ý Xóa" "Hủy thao tác"; then
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
  wptt_quay_ve_menu "${1:-}" 0
fi

_runing "Gỡ bỏ Alias $domain_xoa khỏi Vhost $NAME"

# ==============================================================================
# GIAO DỊCH NGUYÊN TỬ: TÁCH BẢN BACKUP SẠCH VÀ BẢN CANDIDATE CHỈNH SỬA
# ==============================================================================
bak_vhost=$(/bin/mktemp -p "/etc/wptt/tmp" "vhost_${NAME}_bak_XXXXXX.conf")
bak_httpd=$(/bin/mktemp -p "/etc/wptt/tmp" "httpd_bak_XXXXXX.conf")
tmp_vhost=$(/bin/mktemp -p "/etc/wptt/tmp" "vhost_${NAME}_cand_XXXXXX.conf")
tmp_httpd=$(/bin/mktemp -p "/etc/wptt/tmp" "httpd_cand_XXXXXX.conf")

# Tự động dọn sạch các tệp tạm khi kết thúc hoặc gặp lỗi
trap '/bin/rm -f -- "$bak_vhost" "$bak_httpd" "$tmp_vhost" "$tmp_httpd" 2>/dev/null || true' EXIT INT TERM

# Sao chép bảo toàn quyền và thuộc tính file (-fp)
/bin/cp -fp -- "$vhost_conf" "$bak_vhost" || {
  _runloi "Không thể tạo bản sao lưu vhost"
  exit 1
}
/bin/cp -fp -- "$httpd_conf" "$bak_httpd" || {
  _runloi "Không thể tạo bản sao lưu httpd_config"
  exit 1
}
/bin/cp -fp -- "$vhost_conf" "$tmp_vhost" || {
  _runloi "Không thể tạo bản thử nghiệm vhost"
  exit 1
}
/bin/cp -fp -- "$httpd_conf" "$tmp_httpd" || {
  _runloi "Không thể tạo bản thử nghiệm httpd"
  exit 1
}

# Escape ký tự đặc biệt trong domain để an toàn tuyệt đối khi dùng regex trong sed
escaped_name=$(printf '%s\n' "$NAME" | sed 's/[.[\*^$()+?{|]/\\&/g')

# ==============================================================================
# PHẪU THUẬT CẤU HÌNH TẠI CHỖ (CHỐNG XÓA NHẦM DOMAIN KHÁC)
# ==============================================================================
if [[ $total -eq 1 ]]; then
  # 1. Trường hợp xóa alias duy nhất: Trả mapping về gốc: map <NAME> <NAME>
  /bin/sed -i -E "s|^([[:space:]]*map[[:space:]]+)${escaped_name}([[:space:]]+).*|\1${NAME}\2${NAME}|" "$tmp_httpd"

  # Dọn dẹp dòng vhAliases trong vhost conf
  /bin/sed -i -E "/^[[:space:]]*vhAliases[[:space:]]/d" "$tmp_vhost"
else
  # 2. Trường hợp vẫn còn các alias khác: Lọc bỏ alias cần xóa
  new_aliases=()
  for a in "${selects[@]}"; do
    [[ "$a" != "$domain_xoa" ]] && new_aliases+=("$a")
  done

  # Nối mảng an toàn bằng printf (không đụng chạm tới biến toàn cục IFS)
  printf -v domain_alias_con_lai "%s," "${new_aliases[@]}"
  domain_alias_con_lai="${domain_alias_con_lai%,}"

  # Cập nhật danh sách mới đúng dòng map của VirtualHost $NAME
  /bin/sed -i -E "s|^([[:space:]]*map[[:space:]]+)${escaped_name}([[:space:]]+).*|\1${NAME}\2${NAME},${domain_alias_con_lai}|" "$tmp_httpd"

  # Cập nhật lại dòng vhAliases
  /bin/sed -i -E "s|^([[:space:]]*vhAliases[[:space:]]+).*|\1${domain_alias_con_lai}|" "$tmp_vhost"
fi

# ==============================================================================
# COMMIT GIAO DỊCH VÀ KIỂM TRA CÚ PHÁP
# ==============================================================================
/bin/cp -fp -- "$tmp_vhost" "$vhost_conf"
/bin/cp -fp -- "$tmp_httpd" "$httpd_conf"

# Kiểm tra cú pháp bằng chính nhị phân của OpenLiteSpeed
if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
  _runloi "Lỗi cú pháp OpenLiteSpeed! Đang hoàn nguyên về bản sao lưu sạch..."

  # PHỤC HỒI CHÍNH XÁC TỪ BẢN GỐC NGUYÊN BẢN (bak_*), KHÔNG CHÉP TỪ CANDIDATE LỖI
  /bin/cp -fp -- "$bak_vhost" "$vhost_conf"
  /bin/cp -fp -- "$bak_httpd" "$httpd_conf"

  if ! /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
    _runloi "CẢNH BÁO NGUY HIỂM: Cấu hình gốc đã có lỗi từ trước!"
  else
    _runloi "Hệ thống đã được tự động hoàn nguyên an toàn 100%."
  fi

  wptt_logs "ERROR" "Lỗi cú pháp OpenLiteSpeed khi gỡ alias $domain_xoa của $NAME. Đã rollback thành công."

  wptt_quay_ve_menu "${1:-}" 1
fi

# CHỈ THỰC HIỆN RELOAD KHI ĐÃ VƯỢT QUA KIỂM TRA CÚ PHÁP
if ! wptt_smart_reload_lsws >/dev/null 2>&1; then
  _runloi "Không thể reload OpenLiteSpeed! Đang hoàn nguyên cấu hình cũ..."
  /bin/cp -fp -- "$bak_vhost" "$vhost_conf"
  /bin/cp -fp -- "$bak_httpd" "$httpd_conf"
  wptt_smart_reload_lsws >/dev/null 2>&1 || true

  wptt_quay_ve_menu "${1:-}" 1
fi

_rundone "Gỡ bỏ Alias $domain_xoa khỏi Vhost $NAME"
wptt_logs "INFO" "Xóa alias domain $domain_xoa khỏi $NAME thành công"

echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT XÓA ALIAS DOMAIN${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Website gốc        : ${C_YELLOW}$NAME${C_RESET}" 2
left_text "Alias đã gỡ bỏ     : ${C_RED}$domain_xoa${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

sleep 2
wptt_quay_ve_menu "${1:-}" 0
