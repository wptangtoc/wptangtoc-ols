function huong_dan() {
  cat <<'EOF'
  🔒 TÍNH NĂNG: BẬT / TẮT ĐĂNG NHẬP USERNAME RIÊNG (CHROOT JAIL)

  Mặc định, trên các hệ thống Linux, tài khoản Root nắm giữ toàn quyền sinh sát. Nếu bạn có 10 website trên VPS và thuê lập trình viên ngoài (Freelancer) để sửa lỗi cho 1 website duy nhất, việc giao tài khoản Root cho họ là CỰC KỲ NGUY HIỂM. Họ có thể vô tình hoặc cố ý can thiệp, đánh cắp dữ liệu của 9 website còn lại.

  Công cụ này giải quyết triệt để bài toán đó bằng công nghệ "Nhà giam Chroot" (Chroot Jail) chuẩn Enterprise.

  🚀 KHI BẠN BẬT TÍNH NĂNG NÀY:
   ➜ Cấp quyền độc lập: Cấp cho lập trình viên một bộ Username/Password riêng biệt, chỉ có quyền đăng nhập SSH/SFTP vào ĐÚNG MỘT WEBSITE duy nhất.
   ➜ Giam lỏng bảo mật (Chroot Isolation): Hệ thống sẽ tự động "đúc" một hệ điều hành thu nhỏ ảo ngay bên trong thư mục gốc của website. Khi Lập trình viên đăng nhập qua SSH, họ sẽ bị "giam" trong thư mục này, không thể lùi lại thư mục cha (`cd ..`) và hoàn toàn mù tịt về sự tồn tại của các website khác trên VPS.
   ➜ Công cụ tích hợp: Trong nhà giam đó, hệ thống vẫn "bơm" đầy đủ các bộ công cụ dòng lệnh cơ bản (WP-CLI, ls, mysql, zip, vi...) để họ làm việc bình thường.

  🔄 KHI BẠN TẮT TÍNH NĂNG NÀY:
  Khi Freelancer hoàn thành công việc, bạn chỉ cần 1 click để TẮT tính năng này đi. Hệ thống sẽ lập tức "khóa mõm" Username đó, đá (kick) họ văng khỏi máy chủ, dọn dẹp nhà giam ảo và trả website về trạng thái hoạt động cô lập tiêu chuẩn.

  ⚠️ LƯU Ý PHẦN CỨNG:
  Công nghệ bảo mật Chroot Jail yêu cầu VPS phải được ảo hóa cấp phần cứng (KVM, VMware...). Tính năng này sẽ KHÔNG HOẠT ĐỘNG trên các VPS ảo hóa phần mềm (như LXC, OpenVZ, Docker) vì hệ điều hành sẽ từ chối cấp quyền Mount độc lập. Hệ thống WPTangToc OLS sẽ tự động kiểm tra và khóa chức năng này nếu phát hiện VPS của bạn dùng công nghệ ảo hóa không tương thích.
EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"


# =================================================================
# CHỐT CHẶN: KIỂM TRA MÔI TRƯỜNG ẢO HÓA (CHẶN LXC/OPENVZ/DOCKER)
# =================================================================
virt_type=$(systemd-detect-virt 2>/dev/null || echo "unknown")
if [[ "$virt_type" == "lxc" || "$virt_type" == "lxd" || "$virt_type" == "openvz" || "$virt_type" == "docker" || -f /proc/user_beancounters || -f /.dockerenv ]]; then
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_RED}│${C_RESET} ${C_YELLOW}LỖI: MÔI TRƯỜNG KHÔNG HỖ TRỢ BẢO MẬT CHROOT JAIL${C_RESET}                           ${C_RED}│${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  echo -e "${C_RED}│${C_RESET} VPS của bạn đang dùng ảo hóa cấp hệ điều hành (LXC, OpenVZ, Docker...).    ${C_RED}│${C_RESET}"
  echo -e "${C_RED}│${C_RESET} Tính năng Username riêng yêu cầu đặc quyền Mount và Kernel độc lập (KVM).  ${C_RED}│${C_RESET}"
  echo -e "${C_RED}│${C_RESET} Thao tác đã bị HỦY BỎ để tránh gây lỗi cho Website của bạn!                ${C_RED}│${C_RESET}"
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  
  sleep 4
  check_menu_wptangtoc_active=$1
  if [[ "$check_menu_wptangtoc_active" = "98" ]]; then
    exec /etc/wptt/wptt-domain-main 1
  fi
  exit 1
fi
# =================================================================

. /etc/wptt/echo-color 2>/dev/null

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_domain} ➜ $bat_tat_dang_nhap_username_rieng_domain${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt/tenmien
lua_chon_NAME "$bat_tat_dang_nhap_username_rieng_domain"

. /etc/wptt/echo-color

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi

# ROOT PATH
pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echoDo "$ten_mien_nay_khong_ton_tai_tren_he_thong"
  sleep 3
  exec /etc/wptt/wptt-domain-main 1
  exit
fi
wptt_load_vhost_conf "$NAME"

check=$(cat /etc/passwd | grep "${User_name_vhost}:x" | grep 'nologin')

if [[ $check ]]; then
  if ! wptt_xac_nhan "$xac_nhan $ban_muon $thiet_lap $dang_nhap username của website $NAME" "" "" "Đồng ý (Khởi tạo Username đăng nhập)" "Không đồng ý (Hủy thao tác)"; then
    wptt_quay_ve_menu "${1:-}" 0
  fi

  wptt_logs "INFO" "Bật đăng nhập username domain $NAME"

  . /etc/wptt/echo-color

  temp_user=$(mktemp -p "/etc/wptt/tmp" wptt_user_XXXXXX.cnf)
  check_thay_doi=$(md5sum /etc/shadow | cut -f1 -d ' ' >$temp_user)
  passwd "$User_name_vhost"

  if [[ $(cat $temp_user) != $(md5sum /etc/shadow | cut -f1 -d ' ') ]]; then
    _rundone "$thiet_lap PassWord cho username $User_name_vhost"

    kiem_tra_ton_tai_nhom=$(cat /etc/group | grep '^wptangtoc-ols:')
    if [[ -z "$kiem_tra_ton_tai_nhom" ]]; then
      groupadd wptangtoc-ols >/dev/null 2>&1
    fi

    pkill -9 -u "$User_name_vhost" >/dev/null 2>&1
    usermod -a -G wptangtoc-ols "$User_name_vhost"

    # Copy file gốc của hệ thống
    cp -rf /etc/skel/. /usr/local/lsws/"$NAME"
    find /usr/local/lsws/"$NAME" -maxdepth 1 -name ".*" ! -name "." ! -name ".." -exec chown "$User_name_vhost":"$User_name_vhost" {} +

    chown -hR root:wptangtoc-ols /etc/wptt-user
    chmod -R 750 /etc/wptt-user
    chown root:wptangtoc-ols /usr/bin/wptangtoc-user
    chmod 750 /usr/bin/wptangtoc-user

    echo 'PS1="\[\e[37;40m\][\[\e[31;40m\]\u\[\e[37;40m\]@\h \[\e[35;40m\]\W\[\e[0m\]]\\$ "
HISTSIZE=5000
HISTTIMEFORMAT="%F %T $(whoami) "' >>/usr/local/lsws/"$NAME"/.bashrc
    sed -i '/wptangtoc/d' /usr/local/lsws/"$NAME"/.bashrc
    sed -i '/wptt/d' /usr/local/lsws/"$NAME"/.bashrc
    sed -i '/return/d' /usr/local/lsws/"$NAME"/.bashrc
    echo '[[ $- != *i* ]] && return' >>/usr/local/lsws/"$NAME"/.bashrc
    echo "alias 1='exec /etc/wptt-user/wptt-status'" >>/usr/local/lsws/"$NAME"/.bashrc
    echo ". /etc/wptt-user/wptt-status" >>/usr/local/lsws/"$NAME"/.bashrc
    echo "export EDITOR=vi" >>/usr/local/lsws/"$NAME"/.bashrc
    echo "export LANG=en_US.UTF-8" >>/usr/local/lsws/"$NAME"/.bashrc
    echo "export LC_ALL=en_US.UTF-8" >>/usr/local/lsws/"$NAME"/.bashrc
    
    # Bơm biến môi trường PATH vào lồng
    echo 'export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"' >>/usr/local/lsws/"$NAME"/.bashrc

    # -----------------------------------------------------------------
    # SÁT CHIÊU ENTERPRISE: XÂY DỰNG CHROOT JAIL
    # -----------------------------------------------------------------
    JAIL_PATH="/usr/local/lsws/$NAME"
    echo "Đang đúc hệ điều hành thu nhỏ (Chroot Jail) cho $User_name_vhost..."

    # Nắn quyền chuỗi thư mục cha (Bọc thép OpenSSH)
    chown root:root /usr
    chmod 755 /usr
    chown root:root /usr/local
    chmod 755 /usr/local
    chown root:root /usr/local/lsws
    chmod 755 /usr/local/lsws
    chown root:root "$JAIL_PATH"
    chmod 755 "$JAIL_PATH"

    # =================================================================
    # Phá Namespace trước khi đập bỏ lồng cũ
    # =================================================================
    OLS_NS_PATH="/var/lsns/*/$NAME"
    if ls "$OLS_NS_PATH" 1>/dev/null 2>&1; then
      fuser -k -9 "$OLS_NS_PATH"/* "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
      umount -fl "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
      umount -fl "$OLS_NS_PATH"/* 2>/dev/null || true
      rm -rf /var/lsns/*/"${NAME:?}" 2>/dev/null || true
    fi

    grep "$JAIL_PATH" /proc/mounts | awk '{print $2}' | sort -r | while read -r mp; do
      umount -fl "$mp" 2>/dev/null || true
    done
    # =================================================================

    # 1. Dọn dẹp nhà giam cũ (nếu có)
    rm -rf "${JAIL_PATH:?}"/{bin,lib,lib64,sbin,usr,dev,etc,tmp,logs}

    # 2. Đổ móng chuẩn kiến trúc AlmaLinux 9 / Ubuntu
    mkdir -p "$JAIL_PATH"/usr/{bin,sbin,lib,lib64}
    mkdir -p "$JAIL_PATH"/{dev,etc,tmp,dev/pts,logs}
    
    # Ép quyền cho các thư mục base bên trong Jail
    chmod 755 "$JAIL_PATH"/usr "$JAIL_PATH"/usr/bin "$JAIL_PATH"/usr/sbin "$JAIL_PATH"/usr/lib "$JAIL_PATH"/usr/lib64
    chmod 755 "$JAIL_PATH"/dev "$JAIL_PATH"/dev/pts "$JAIL_PATH"/etc
    chmod 1777 "$JAIL_PATH"/tmp

    if grep -q '^accesslog' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf; then
      mkdir -p "$JAIL_PATH"/logs
      chown nobody:"$User_name_vhost" "$JAIL_PATH"/logs
      chmod 750 "$JAIL_PATH"/logs
    fi

    ln -s usr/bin "$JAIL_PATH"/bin
    ln -s usr/sbin "$JAIL_PATH"/sbin
    ln -s usr/lib "$JAIL_PATH"/lib
    ln -s usr/lib64 "$JAIL_PATH"/lib64

    # Rèn phần cứng ảo
    mknod -m 666 "$JAIL_PATH"/dev/null c 1 3 >/dev/null 2>&1 || true
    mknod -m 666 "$JAIL_PATH"/dev/zero c 1 5 >/dev/null 2>&1 || true
    mknod -m 666 "$JAIL_PATH"/dev/urandom c 1 9 >/dev/null 2>&1 || true
    mknod -m 666 "$JAIL_PATH"/dev/tty c 5 0 >/dev/null 2>&1 || true
    mknod -m 666 "$JAIL_PATH"/dev/ptmx c 5 2 >/dev/null 2>&1 || true

    # 3. Hàm Bốc Thuốc (Đã vá quyền)
    copy_to_jail() {
      local src="$1"
      local dest="$src"
      if [[ "$dest" == /lib64/* ]]; then dest="/usr/lib64/${dest#/lib64/}"; fi
      if [[ "$dest" == /lib/* ]]; then dest="/usr/lib/${dest#/lib/}"; fi
      if [[ "$dest" == /bin/* ]]; then dest="/usr/bin/${dest#/bin/}"; fi
      if [[ "$dest" == /sbin/* ]]; then dest="/usr/sbin/${dest#/sbin/}"; fi

      local dir="$JAIL_PATH$(dirname "$dest")"
      mkdir -p "$dir"
      chmod 755 "$dir" 2>/dev/null
      cp -L "$src" "$JAIL_PATH$dest" 2>/dev/null
      chmod 755 "$JAIL_PATH$dest" 2>/dev/null
    }

    # Bơm PHP Binary chuẩn xác để giữ nguyên đường dẫn php.ini
    REAL_PHP=$(readlink -f /usr/bin/php 2>/dev/null)
    if [[ -n "$REAL_PHP" && -f "$REAL_PHP" ]]; then
      copy_to_jail "$REAL_PHP"
      LIBS=$(ldd "$REAL_PHP" 2>/dev/null | grep -oE '/[^ ]+')
      for LIB in $LIBS; do copy_to_jail "$LIB"; done
      
      mkdir -p "$JAIL_PATH/usr/bin" "$JAIL_PATH/bin"
      ln -sf "$REAL_PHP" "$JAIL_PATH/usr/bin/php"
      ln -sf "$REAL_PHP" "$JAIL_PATH/bin/php"
    fi

    # 4. Bơm công cụ cho IT
    COMMANDS=(
      "/bin/bash" "/bin/ls" "/bin/mkdir" "/bin/cat" "/bin/rm" "/bin/cp" "/bin/mv" "/usr/bin/zip" "/usr/bin/unzip"
      "/usr/bin/mysql" "/usr/bin/mariadb" "/usr/bin/curl" "/usr/bin/clear" "/usr/bin/touch" "/bin/touch"
      "/usr/bin/grep" "/usr/bin/tail" "/usr/bin/vi" "/usr/bin/nano" "/usr/bin/stat" "/usr/bin/tar" "/usr/bin/head" "/usr/bin/openssl"
      "/usr/bin/sed" "/usr/bin/awk" "/usr/bin/cut" "/usr/bin/tr" "/usr/bin/wc" "/usr/bin/gzip" "/usr/bin/du" "/usr/bin/nice" "/usr/bin/ionice"
      "/usr/bin/tput" "/usr/bin/find" "/usr/bin/xargs" "/usr/bin/chmod" "/usr/bin/mktemp" "/usr/bin/sleep" "/usr/bin/chown" "/usr/bin/nl"
      "/usr/bin/wget" "/usr/bin/env" "/usr/bin/date" "/usr/bin/which" "/usr/bin/mysqldump" "/usr/bin/mariadb-dump" "/usr/bin/stty" "/usr/bin/zcat" "/usr/bin/top"
      "/usr/bin/less" "/usr/bin/more" "/usr/bin/jq" "/usr/bin/base64" "/usr/bin/bc" "/usr/bin/sha256sum" "/usr/bin/printf"
    )
    if [ -f "/usr/local/bin/wp" ]; then COMMANDS+=("/usr/local/bin/wp"); fi
    if [ -f "/usr/bin/vim" ]; then COMMANDS+=("/usr/bin/vim"); fi
    if [ -f "/usr/bin/rsync" ]; then COMMANDS+=("/usr/bin/rsync"); fi
    if [ -f "/usr/bin/rclone" ]; then COMMANDS+=("/usr/bin/rclone"); fi
    if [ -f "/usr/bin/fzf" ]; then COMMANDS+=("/usr/bin/fzf"); fi
    if [ -f "/usr/bin/zstd" ]; then COMMANDS+=("/usr/bin/zstd"); fi
    if [ -f "/usr/bin/pv" ]; then COMMANDS+=("/usr/bin/pv"); fi

    for CMD in "${COMMANDS[@]}"; do
      if [ -x "$(readlink -f "$CMD" 2>/dev/null || echo "$CMD")" ]; then
        copy_to_jail "$CMD"
        LIBS=$(ldd "$CMD" 2>/dev/null | grep -oE '/[^ ]+')
        for LIB in $LIBS; do
          copy_to_jail "$LIB"
        done
      fi
    done

    # Bơm thông điệp lỗi và ngôn ngữ của MariaDB để tránh cảnh báo rác
    mkdir -p "$JAIL_PATH"/usr/share/mariadb "$JAIL_PATH"/usr/share/mysql
    cp -a /usr/share/mariadb/* "$JAIL_PATH"/usr/share/mariadb/ 2>/dev/null || true
    cp -a /usr/share/mysql/* "$JAIL_PATH"/usr/share/mysql/ 2>/dev/null || true
    chmod -R 755 "$JAIL_PATH"/usr/share/mariadb "$JAIL_PATH"/usr/share/mysql 2>/dev/null || true

    # Tước bỏ quyền SUID/SGID khỏi lồng
    chmod -R a-s "$JAIL_PATH"/bin "$JAIL_PATH"/sbin "$JAIL_PATH"/usr "$JAIL_PATH"/lib "$JAIL_PATH"/lib64 2>/dev/null || true

    # Bơm Cấu hình & Modules PHP
    PHP_INI=$(php -i 2>/dev/null | grep 'Loaded Configuration File' | awk '{print $NF}')
    PHP_SCAN_DIR=$(php -i 2>/dev/null | grep 'Scan this dir for additional .ini files' | awk '{print $NF}')
    PHP_EXT_DIR=$(php -i 2>/dev/null | grep '^extension_dir' | awk '{print $3}')

    if [[ -f "$PHP_INI" ]]; then copy_to_jail "$PHP_INI"; fi
    if [[ -d "$PHP_SCAN_DIR" ]]; then
      mkdir -p "$JAIL_PATH$PHP_SCAN_DIR"
      cp -a "$PHP_SCAN_DIR"/* "$JAIL_PATH$PHP_SCAN_DIR/" 2>/dev/null || true
    fi
    if [[ -d "$PHP_EXT_DIR" ]]; then
      mkdir -p "$JAIL_PATH$PHP_EXT_DIR"
      cp -a "$PHP_EXT_DIR"/* "$JAIL_PATH$PHP_EXT_DIR/" 2>/dev/null || true
      for ext in "$PHP_EXT_DIR"/*.so; do
        if [[ -f "$ext" ]]; then
          LIBS=$(ldd "$ext" 2>/dev/null | grep -oE '/[^ ]+')
          for LIB in $LIBS; do
            copy_to_jail "$LIB"
          done
        fi
      done
    fi

    copy_to_jail "/lib64/libtinfo.so.6"
    copy_to_jail "/lib64/libncursesw.so.6"
    ln -s bash "$JAIL_PATH"/usr/bin/sh 2>/dev/null || true

    copy_to_jail "/lib64/libnss_files.so.2"
    copy_to_jail "/lib64/libnss_dns.so.2"
    copy_to_jail "/lib64/libresolv.so.2"

    cp -L /etc/resolv.conf "$JAIL_PATH"/etc/ >/dev/null 2>&1 || true
    cp -L /etc/nsswitch.conf "$JAIL_PATH"/etc/ >/dev/null 2>&1 || true
    
    cp -L /etc/hosts "$JAIL_PATH"/etc/ >/dev/null 2>&1 || true
    cp -L /etc/my.cnf "$JAIL_PATH"/etc/ >/dev/null 2>&1 || true
    cp -Lr /etc/my.cnf.d "$JAIL_PATH"/etc/ >/dev/null 2>&1 || true
    
    chmod 644 "$JAIL_PATH"/etc/resolv.conf "$JAIL_PATH"/etc/nsswitch.conf "$JAIL_PATH"/etc/hosts "$JAIL_PATH"/etc/my.cnf 2>/dev/null || true
    chmod -R 755 "$JAIL_PATH"/etc/my.cnf.d 2>/dev/null || true

    # BƠM CHỨNG CHỈ BẢO MẬT (CA CERTIFICATES)
    mkdir -p "$JAIL_PATH"/etc/pki/tls/certs "$JAIL_PATH"/etc/ssl/certs "$JAIL_PATH"/etc/pki/ca-trust/extracted/pem
    cp -Lr /etc/pki/tls/certs/* "$JAIL_PATH"/etc/pki/tls/certs/ 2>/dev/null || true
    cp -Lr /etc/ssl/certs/* "$JAIL_PATH"/etc/ssl/certs/ 2>/dev/null || true
    cp -Lr /etc/pki/ca-trust/extracted/pem/* "$JAIL_PATH"/etc/pki/ca-trust/extracted/pem/ 2>/dev/null || true
    cp -L /etc/pki/tls/openssl.cnf "$JAIL_PATH"/etc/pki/tls/ 2>/dev/null || true
    cp -L /etc/ssl/openssl.cnf "$JAIL_PATH"/etc/ssl/ 2>/dev/null || true
    chmod -R a+rX "$JAIL_PATH"/etc/pki "$JAIL_PATH"/etc/ssl 2>/dev/null || true

    mkdir -p "$JAIL_PATH"/usr/share/terminfo
    chmod 755 "$JAIL_PATH"/usr/share "$JAIL_PATH"/usr/share/terminfo 2>/dev/null || true
    cp -a /usr/share/terminfo/* "$JAIL_PATH"/usr/share/terminfo/ 2>/dev/null || true
    echo 'export TERM=xterm-256color' >>"$JAIL_PATH"/.bashrc

    # Bơm dữ liệu múi giờ để PHP không văng lỗi
    mkdir -p "$JAIL_PATH"/usr/share/zoneinfo
    chmod 755 "$JAIL_PATH"/usr/share/zoneinfo 2>/dev/null || true
    cp -a /usr/share/zoneinfo/* "$JAIL_PATH"/usr/share/zoneinfo/ 2>/dev/null || true
    cp -L /etc/localtime "$JAIL_PATH"/etc/ 2>/dev/null || true

    # Từ điển
    mkdir -p "$JAIL_PATH"/usr/lib/locale "$JAIL_PATH"/usr/share/locale "$JAIL_PATH"/usr/lib64/gconv
    chmod 755 "$JAIL_PATH"/usr/lib/locale "$JAIL_PATH"/usr/share/locale "$JAIL_PATH"/usr/lib64/gconv 2>/dev/null || true
    cp -a /usr/lib/locale/* "$JAIL_PATH"/usr/lib/locale/ 2>/dev/null || true
    cp -a /usr/share/locale/en_US* "$JAIL_PATH"/usr/share/locale/ 2>/dev/null || true
    cp -a /usr/lib64/gconv/* "$JAIL_PATH"/usr/lib64/gconv/ 2>/dev/null || true

    # [BẢN VÁ TRỌNG TÂM: MỞ ĐƯỜNG MÁU CHO WP-CLI]
    find "$JAIL_PATH/usr" -type d -exec chmod 755 {} + 2>/dev/null || true
    find "$JAIL_PATH/opt" -type d -exec chmod 755 {} + 2>/dev/null || true

    # Nối ống nước Database và khoan thủng quyền đọc socket
    if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
      DEFAULT_SOCK="/run/mysqld/mysqld.sock"
    else
      DEFAULT_SOCK="/var/lib/mysql/mysql.sock"
    fi
    REAL_SOCK=$(mariadb -N -e "select @@socket;" 2>/dev/null || echo "$DEFAULT_SOCK")

    if [ -S "$REAL_SOCK" ]; then
      SOCK_DIR=$(dirname "$REAL_SOCK")
      mkdir -p "$JAIL_PATH$SOCK_DIR"
      
      chmod 755 "$JAIL_PATH/var" "$JAIL_PATH/var/lib" "$JAIL_PATH/run" 2>/dev/null || true
      chmod 755 "$JAIL_PATH$SOCK_DIR" 2>/dev/null || true
      
      touch "$JAIL_PATH$REAL_SOCK"
      mount --bind "$REAL_SOCK" "$JAIL_PATH$REAL_SOCK"
      
      ln -sf "$REAL_SOCK" "$JAIL_PATH/tmp/mysql.sock" 2>/dev/null || true
    fi

    # Phân quyền User (Đảm bảo ai cũng đọc được)
    grep "^root:" /etc/passwd >"$JAIL_PATH"/etc/passwd
    grep "^$User_name_vhost:" /etc/passwd | sed "s|$JAIL_PATH|/|g" >>"$JAIL_PATH"/etc/passwd
    chmod 644 "$JAIL_PATH"/etc/passwd

    grep "^root:" /etc/group >"$JAIL_PATH"/etc/group
    grep "^wptangtoc-ols:" /etc/group >>"$JAIL_PATH"/etc/group
    grep "^$User_name_vhost:" /etc/group >>"$JAIL_PATH"/etc/group
    chmod 644 "$JAIL_PATH"/etc/group

    # =======================================================
    # BƠM HỆ SINH THÁI MENU (KỸ THUẬT MOUNT FILE ĐƠN LẺ)
    # =======================================================
    mkdir -p "$JAIL_PATH"/etc/wptt-user
    chmod 755 "$JAIL_PATH"/etc

    # Ngăn chặn user ghi đè vào file Vhost .conf của Root
    chown root:wptangtoc-ols /etc/wptt/vhost/."$NAME".conf
    chmod 640 /etc/wptt/vhost/."$NAME".conf

    # KỸ THUẬT ĐIÊU KHẮC: MOUNT FILE VHOST RA NÔNG HƠN
    touch "$JAIL_PATH"/etc/."$NAME".conf
    mount --bind /etc/wptt/vhost/."$NAME".conf "$JAIL_PATH"/etc/."$NAME".conf

    # Copy chìa khóa AES
    mkdir -p "$JAIL_PATH"/etc/wptt-aes
    if [[ -f /etc/wptt-aes/.wptt_salt.bin ]]; then
      cp -f /etc/wptt-aes/.wptt_salt.bin "$JAIL_PATH"/etc/wptt-aes/
      chown root:wptangtoc-ols "$JAIL_PATH"/etc/wptt-aes/.wptt_salt.bin
      chmod 440 "$JAIL_PATH"/etc/wptt-aes/.wptt_salt.bin
    fi

    chown root:wptangtoc-ols "$JAIL_PATH"/etc/wptt-aes
    chmod 755 "$JAIL_PATH"/etc/wptt-aes

    # Mount Menu User
    mount --bind /etc/wptt-user "$JAIL_PATH"/etc/wptt-user
    touch "$JAIL_PATH"/usr/bin/wptangtoc-user 2>/dev/null || true
    mount --bind /usr/bin/wptangtoc-user "$JAIL_PATH"/usr/bin/wptangtoc-user

    # Inception OpenSSH (Vá quyền đọc chéo trong lồng)
    mkdir -p "$JAIL_PATH"/usr/local/lsws
    chmod 755 "$JAIL_PATH"/usr/local "$JAIL_PATH"/usr/local/lsws 2>/dev/null || true
    ln -s / "$JAIL_PATH"/usr/local/lsws/"$NAME" 2>/dev/null || true

    # -----------------------------------------------------------------
    # NỐI ỐNG CRON TỰ ĐỘNG ĐỒNG BỘ (CHỐNG JAILBREAK + AUTO-HEAL SOCKET/MOUNT)
    # -----------------------------------------------------------------
    CRON_JAIL_FILE="$JAIL_PATH/.cron_spool"
    touch "$CRON_JAIL_FILE"
    chown "$User_name_vhost":"$User_name_vhost" "$CRON_JAIL_FILE"
    chmod 600 "$CRON_JAIL_FILE"

    # Đúc lệnh Fake Crontab
    cat <<'EOF' >"$JAIL_PATH"/usr/bin/crontab
#!/bin/bash
USER_CRON="/.cron_spool"
[[ -L "$USER_CRON" || -p "$USER_CRON" ]] && exit 1
touch "$USER_CRON" 2>/dev/null || exit 1
if [[ "$1" == "-e" ]]; then
    TMP_FILE=$(mktemp)
    cat "$USER_CRON" > "$TMP_FILE" 2>/dev/null
    ${EDITOR:-vi} "$TMP_FILE"
    cat "$TMP_FILE" > "$USER_CRON"
    rm -f "${TMP_FILE:?}"
    echo "crontab: installing new crontab (Sẽ được đồng bộ trong vòng 1 phút)"
elif [[ "$1" == "-l" ]]; then
    cat "$USER_CRON" 2>/dev/null
elif [[ "$1" == "-r" ]]; then
    > "$USER_CRON"
    echo "crontab: removing crontab"
elif [[ "$1" == "-" ]] || [[ ! -t 0 && -z "$1" ]]; then
    cat > "$USER_CRON"
    echo "crontab: installing new crontab (Sẽ được đồng bộ trong vòng 1 phút)"
else
    echo "crontab: usage error: unrecognized option"
    echo "usage: crontab [-e | -l | -r | -]"
fi
EOF
    chmod 755 "$JAIL_PATH"/usr/bin/crontab

    # Khởi tạo Script đồng bộ Cron bọc thép + Auto-Healing Inode Socket & Mounts sau Reboot
    SYNC_SCRIPT="/etc/wptt/wptt-cron-jail-sync.sh"
    cat <<'EOF' >"$SYNC_SCRIPT"
#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# Dọn dẹp file cron lỗi tên (chứa dấu chấm) và symlink trùng lặp trên Ubuntu
/bin/rm -f -- /etc/cron.d/wpttjail_*.* /etc/cron.d/wptt-cron-jail-sync_cron 2>/dev/null || true
/bin/mkdir -p -m 0700 /etc/wptt/tmp 2>/dev/null || true

_is_mounted() {
    awk -v t="$1" '$2 == t {f=1; exit} END {exit !f}' /proc/mounts 2>/dev/null
}

# Nhận diện Socket MariaDB thực tế (0-auth, chạy được cả khi root đặt mật khẩu)
REAL_SOCK=""
for cand in /run/mysqld/mysqld.sock /var/lib/mysql/mysql.sock /var/run/mysqld/mysqld.sock /tmp/mysql.sock; do
    if [[ -S "$cand" ]]; then
        REAL_SOCK="$cand"
        break
    fi
done
HOST_SOCK_INO=""
[[ -n "$REAL_SOCK" && -S "$REAL_SOCK" ]] && HOST_SOCK_INO="$(stat -c %i "$REAL_SOCK" 2>/dev/null || true)"

HAS_ACTIVE_JAILS=0

for path in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$path" || "$path" == *"/..conf" ]] && continue
    domain="${path##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    [[ "$domain" == ?*.?* && "$domain" =~ ^[a-zA-Z0-9._-]+$ && "$domain" != *..* ]] || continue

    JAIL="/usr/local/lsws/$domain"
    SPOOL="$JAIL/.cron_spool"
    domain_safe="${domain//./_}"
    CRON_D="/etc/cron.d/wpttjail_${domain_safe}"

    # Chỉ nhận file thường (chặn Symlink / FIFO)
    if [[ -f "$SPOOL" && ! -L "$SPOOL" && ! -p "$SPOOL" ]]; then
        HAS_ACTIVE_JAILS=1
        User_name_vhost="$(awk -F'=' '/^User_name_vhost=/ {gsub(/["\047\r ]/, "", $2); print $2; exit}' "$path")"
        [[ -n "$User_name_vhost" && "$User_name_vhost" =~ ^[a-zA-Z0-9_-]+$ ]] || continue
        id -u "$User_name_vhost" >/dev/null 2>&1 || continue

        # ------------------------------------------------------------------
        # 1. AUTO-HEALING SOCKET INODE (MariaDB Restart) & MOUNTS (VPS Reboot)
        # ------------------------------------------------------------------
        if [[ -n "$REAL_SOCK" && -n "$HOST_SOCK_INO" ]]; then
            JAIL_SOCK="$JAIL$REAL_SOCK"
            JAIL_SOCK_INO="$(stat -c %i "$JAIL_SOCK" 2>/dev/null || true)"
            if [[ "$HOST_SOCK_INO" != "$JAIL_SOCK_INO" ]] || ! _is_mounted "$JAIL_SOCK"; then
                /bin/mkdir -p "${JAIL_SOCK%/*}" 2>/dev/null || true
                /bin/chmod 755 "$JAIL/var" "$JAIL/var/lib" "$JAIL/run" "${JAIL_SOCK%/*}" 2>/dev/null || true
                umount -fl "$JAIL_SOCK" 2>/dev/null || true
                touch "$JAIL_SOCK" 2>/dev/null || true
                mount --bind "$REAL_SOCK" "$JAIL_SOCK" 2>/dev/null || true
                ln -sf "$REAL_SOCK" "$JAIL/tmp/mysql.sock" 2>/dev/null || true
            fi
        fi

        if [[ -f "$JAIL/etc/.$domain.conf" ]] && ! _is_mounted "$JAIL/etc/.$domain.conf"; then
            mount --bind "$path" "$JAIL/etc/.$domain.conf" 2>/dev/null || true
        fi
        if [[ -d /etc/wptt-user && -d "$JAIL/etc/wptt-user" ]] && ! _is_mounted "$JAIL/etc/wptt-user"; then
            mount --bind /etc/wptt-user "$JAIL/etc/wptt-user" 2>/dev/null || true
        fi
        if [[ -f /usr/bin/wptangtoc-user && -f "$JAIL/usr/bin/wptangtoc-user" ]] && ! _is_mounted "$JAIL/usr/bin/wptangtoc-user"; then
            mount --bind /usr/bin/wptangtoc-user "$JAIL/usr/bin/wptangtoc-user" 2>/dev/null || true
        fi

        # ------------------------------------------------------------------
        # 2. ĐỒNG BỘ CRON BỌC THÉP (CHỐNG LEO THANG ĐẶC QUYỀN ROOT / RCE)
        # ------------------------------------------------------------------
        spool_size="$(stat -c %s "$SPOOL" 2>/dev/null || echo 999999)"
        if ((spool_size <= 32768)) && { [[ "$SPOOL" -nt "$CRON_D" ]] || [[ ! -f "$CRON_D" ]]; }; then
            tmp_cron="$(mktemp -p /etc/wptt/tmp "wpttcron_${domain_safe}_XXXXXX")" || continue
            printf 'SHELL=/bin/bash\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' > "$tmp_cron"
            line_cnt=0
            cron_rx='^[0-9*,/-]{1,32}$'

            while IFS= read -r line || [[ -n "$line" ]]; do
                ((++line_cnt > 100)) && break
                line="${line//$'\r'/}"
                line="${line//$'\t'/ }"
                line="${line#"${line%%[![:space:]]*}"}"
                [[ -z "$line" || "$line" == \#* ]] && continue
                [[ "$line" == *[[:cntrl:]]* ]] && continue

                # Chuyển macro hợp lệ sang 5 cột số; chặn mọi macro lạ (@reboot, ...)
                case "$line" in
                    @hourly\ *)              line="0 * * * * ${line#@hourly }" ;;
                    @daily\ *|@midnight\ *)  line="0 0 * * * ${line#* }" ;;
                    @weekly\ *)              line="0 0 * * 0 ${line#@weekly }" ;;
                    @monthly\ *)             line="0 0 1 * * ${line#@monthly }" ;;
                    @yearly\ *|@annually\ *) line="0 0 1 1 * ${line#* }" ;;
                    @*)                      continue ;;
                esac

                IFS=' ' read -r f1 f2 f3 f4 f5 cmd <<< "$line"
                [[ -z "$cmd" ]] && continue

                # Whitelist bắt buộc 5 cột thời gian chỉ gồm số và ký tự lịch trình hợp lệ
                if [[ "$f1" =~ $cron_rx && "$f2" =~ $cron_rx && "$f3" =~ $cron_rx && "$f4" =~ $cron_rx && "$f5" =~ $cron_rx ]]; then
                    # Thoát nháy đơn cho bash -c và thoát dấu % (Cron dịch % không thoát thành xuống dòng)
                    cmd_escaped="$(printf '%s\n' "$cmd" | sed -e "s/'/'\\\\''/g" -e 's/\\%/%/g' -e 's/%/\\%/g')"
                    printf '%s %s %s %s %s root /usr/sbin/chroot --userspec=%s:%s %s /usr/bin/env HOME=/ PATH=/usr/local/bin:/usr/bin:/bin /bin/bash -c '\''%s'\'' >/dev/null 2>&1\n' \
                        "$f1" "$f2" "$f3" "$f4" "$f5" "$User_name_vhost" "$User_name_vhost" "$JAIL" "$cmd_escaped" >> "$tmp_cron"
                fi
            done < "$SPOOL"

            /bin/chown root:root "$tmp_cron" 2>/dev/null || true
            /bin/chmod 644 "$tmp_cron" 2>/dev/null || true
            /bin/mv -fT -- "$tmp_cron" "$CRON_D" 2>/dev/null || /bin/mv -f -- "$tmp_cron" "$CRON_D" 2>/dev/null || /bin/rm -f -- "$tmp_cron"
        fi
    else
        /bin/rm -f -- "${CRON_D:?}" 2>/dev/null || true
    fi
done

if ((HAS_ACTIVE_JAILS == 0)); then
    /bin/rm -f -- /etc/cron.d/wptt-cron-jail-sync /etc/cron.d/wptt-cron-jail-sync_cron /etc/wptt/wptt-cron-jail-sync.sh 2>/dev/null || true
    systemctl reload cron.service 2>/dev/null || systemctl reload crond.service 2>/dev/null || \
        systemctl restart cron.service 2>/dev/null || systemctl restart crond.service 2>/dev/null || true
fi
EOF
    chmod 700 "$SYNC_SCRIPT"

    # Ghi 1 file cron duy nhất kèm @reboot (hợp lệ trên cả Ubuntu lẫn AlmaLinux/RHEL)
    /bin/rm -f -- /etc/cron.d/wptt-cron-jail-sync_cron 2>/dev/null || true
    cat <<EOF >/etc/cron.d/wptt-cron-jail-sync
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
@reboot root /bin/bash $SYNC_SCRIPT >/dev/null 2>&1
* * * * * root /bin/bash $SYNC_SCRIPT >/dev/null 2>&1
EOF
    chmod 644 /etc/cron.d/wptt-cron-jail-sync

    if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
      systemctl reload cron.service 2>/dev/null || systemctl restart cron.service 2>/dev/null || true
    else
      systemctl reload crond.service 2>/dev/null || systemctl restart crond.service 2>/dev/null || true
    fi
    # -----------------------------------------------------------------

    # Mở khóa niêm phong (-U) và cấp lại quyền Shell bash (-s)
    usermod -U -s /bin/bash "$User_name_vhost" >/dev/null 2>&1
    sed -i -e "/^#begin-WPTT_JAIL_$User_name_vhost/,/^#end-WPTT_JAIL_$User_name_vhost$/d" /etc/ssh/sshd_config 2>/dev/null || true

    cat <<EOF >>/etc/ssh/sshd_config
#begin-WPTT_JAIL_$User_name_vhost
Match User $User_name_vhost
    ChrootDirectory $JAIL_PATH
    AllowTcpForwarding no
    X11Forwarding no
#end-WPTT_JAIL_$User_name_vhost
EOF
    systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null
    rm -f "$temp_user"
  else
    _runloi "$thiet_lap PassWord cho username $User_name_vhost"
    check_menu_wptangtoc_active=$1
    if [[ $check_menu_wptangtoc_active = "98" ]]; then
      exec /etc/wptt/wptt-domain-main 1
    fi
    exit
  fi

  /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
  clear

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "Thông tin đăng nhập website $NAME"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Tài khoản USERNAME: $User_name_vhost"
  left_text "PassWord: ***************** (bạn vừa thiết lập vừa nãy)"
  port_ssh=$(grep -E '^\s*Port\s+[0-9]+' /etc/ssh/sshd_config | awk '{print $2}' | head -n 1)
  port_ssh=${port_ssh:-22}

  ip=$(curl -sf --connect-timeout 5 --max-time 10 https://ipv4.icanhazip.com || curl -sf --connect-timeout 5 --max-time 10 https://checkip.amazonaws.com)
  left_text "Truy cập vào ssh  : ssh -p $port_ssh $User_name_vhost@$ip"
  left_text "Truy cập vào sftp : sftp -oPort=$port_ssh $User_name_vhost@$ip"
  left_text "Ghi chú: Môi trường hoạt động của tài khoản này đã được bảo vệ tuyệt đối (Chroot)."
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

# =================================================================
# TẮT ĐĂNG NHẬP (Khóa mõm, Rút Ống, Xóa lồng)
# =================================================================
if [[ -z "$check" ]]; then
  if ! wptt_xac_nhan "Xác nhận bạn muốn tắt đăng nhập username của website $NAME" "Mã nguồn, DB đều được giữ nguyên" "Username của website $NAME không được phép trực tiếp login nữa" "Đồng ý (tắt đăng nhập riêng)" "Không đồng ý (Hủy thao tác)"; then
    wptt_quay_ve_menu "${1:-}" 0
  fi

  wptt_logs "INFO" "Tắt đăng nhập username domain $NAME"
  _runing "$tat $dang_nhap domain user"

  usermod -L -s /sbin/nologin "$User_name_vhost" >/dev/null 2>&1
  pkill -9 -u "$User_name_vhost" >/dev/null 2>&1 || true
  usermod -R wptangtoc-ols "$User_name_vhost" >/dev/null 2>&1

  chmod 600 /etc/wptt/vhost/."$NAME".conf
  chown root:root /etc/wptt/vhost/."$NAME".conf

  kiem_tra_ton_tai_nhom_con_thanh_vien_khac_khong=$(cat /etc/group | grep '^wptangtoc-ols:' | grep ',')
  if [[ -z "$kiem_tra_ton_tai_nhom_con_thanh_vien_khac_khong" ]]; then
    groupdel wptangtoc-ols >/dev/null 2>&1
    chown -hR root:root /etc/wptt-user
    chmod -R 700 /etc/wptt-user
    chown root:root /usr/bin/wptangtoc-user
    chmod 700 /usr/bin/wptangtoc-user
  fi

  sed -i -e "/^#begin-WPTT_JAIL_$User_name_vhost/,/^#end-WPTT_JAIL_$User_name_vhost$/d" /etc/ssh/sshd_config 2>/dev/null || true
  sed -i "/# WPTT_JAIL_$User_name_vhost/,+6d" /etc/ssh/sshd_config 2>/dev/null || true
  systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null

  JAIL_PATH="/usr/local/lsws/$NAME"

  # Xóa ngay cờ .cron_spool và cron riêng TRƯỚC khi umount để chặn daemon Auto-Heal remount ngược
  domain_safe="${NAME//./_}"
  rm -f "/etc/cron.d/wpttjail_${domain_safe:?}" "$JAIL_PATH/.cron_spool" 2>/dev/null || true

  OLS_NS_PATH="/var/lsns/*/$NAME"
  if ls "$OLS_NS_PATH" 1>/dev/null 2>&1; then
    fuser -k -9 "$OLS_NS_PATH"/* "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
    umount -fl "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
    umount -fl "$OLS_NS_PATH"/* 2>/dev/null || true
    rm -rf /var/lsns/*/"${NAME:?}" 2>/dev/null || true
  fi

  if [[ -d "$JAIL_PATH" ]]; then
    umount -fl "$JAIL_PATH/etc/.$NAME.conf" 2>/dev/null || true
    umount -fl "$JAIL_PATH/etc/wptt-user" 2>/dev/null || true
    umount -fl "$JAIL_PATH/usr/bin/wptangtoc-user" 2>/dev/null || true
    umount -fl "$JAIL_PATH/.cron_spool" 2>/dev/null || true

    if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
      DEFAULT_SOCK="/run/mysqld/mysqld.sock"
    else
      DEFAULT_SOCK="/var/lib/mysql/mysql.sock"
    fi
    REAL_SOCK=$(mariadb -N -e "select @@socket;" 2>/dev/null || echo "$DEFAULT_SOCK")

    umount -fl "$JAIL_PATH$REAL_SOCK" 2>/dev/null || true
  fi

  grep "$JAIL_PATH" /proc/mounts | awk '{print $2}' | sort -r | while read -r mp; do
    umount -fl "$mp" 2>/dev/null || true
  done

  rm -rf "${JAIL_PATH:?}"/{bin,lib,lib64,sbin,usr,dev,etc,tmp,var}

  tuong_thich_nhom_litespeed="nobody"
  if cat /etc/*release 2>/dev/null | grep -qi "ubuntu"; then
    tuong_thich_nhom_litespeed="nogroup"
  fi

  if grep -q '^accesslog' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf; then
    mkdir -p "$JAIL_PATH"/logs
    chown nobody:"$tuong_thich_nhom_litespeed" "$JAIL_PATH"/logs
    chmod 750 "$JAIL_PATH"/logs
  fi

  # Tự dọn sạch daemon nếu không còn Jail nào hoạt động
  [[ -x /etc/wptt/wptt-cron-jail-sync.sh ]] && /bin/bash /etc/wptt/wptt-cron-jail-sync.sh >/dev/null 2>&1 || true

  /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1

  _rundone "$tat $dang_nhap domain user"
fi

check_menu_wptangtoc_active=$1
if [[ $check_menu_wptangtoc_active = "98" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi
