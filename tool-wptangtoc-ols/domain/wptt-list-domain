#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Xem danh sách toàn bộ Domain trên hệ thống (Clean Enterprise Layout)

function huong_dan() {
  cat << 'EOF'
  Đây là tính năng xem danh sách toàn bộ domain có trong hệ thống của bạn.
  Hiển thị trạng thái hoạt động, phiên bản PHP, chứng chỉ SSL và các nhãn bảo mật của từng website.
EOF
}

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

export box_inner_width=78


# Hàm đọc nhanh thông tin Vhost thuần Bash (0-subshell)
_wptt_read_vhost_meta() {
  local conf_file="$1"
  META_PHP=""
  META_LOCKDOWN=""
  META_HSTS=""
  [[ ! -f "$conf_file" ]] && return 0

  local line="" key="" val=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == *=* ]]; then
      key="${line%%=*}"
      val="${line#*=}"
      val="${val#\"}"
      val="${val%\"}"
      val="${val#\'}"
      val="${val%\'}"
      val="${val//$'\r'/}"
      case "$key" in
        phien_ban_php_domain) META_PHP="$val" ;;
        lock_down)            META_LOCKDOWN="$val" ;;
        hsts)                 META_HSTS="$val" ;;
      esac
    fi
  done < "$conf_file"
}

_wptt_fmt_php() {
  local raw="${1//[^0-9]/}"
  if [[ "${#raw}" -eq 2 ]]; then
    printf '%s.%s' "${raw:0:1}" "${raw:1:1}"
  elif [[ -n "$raw" ]]; then
    printf '%s' "$raw"
  else
    printf '8.1'
  fi
}

_wptt_has_ssl() {
  local dom="$1"
  local vconf="/usr/local/lsws/conf/vhosts/$dom/$dom.conf"
  [[ ! -f "$vconf" ]] && vconf="/usr/local/lsws/conf/vhosts/$dom/$dom.conf.bkwptt"
  [[ -s "/etc/letsencrypt/live/$dom/cert.pem" || -s "/usr/local/lsws/$dom/ssl/cert.crt" ]] && return 0
  [[ -f "$vconf" ]] && grep -qE '^[[:space:]]*vhssl[[:space:]]*\{' "$vconf" 2>/dev/null && return 0
  return 1
}

# Hàm in dòng trong Box khóa cứng viền phải ở cột 78 (Không bao giờ lệch viền)
_wptt_box_line() {
  local raw_str="$1"
  local clean_str=""
  if declare -F _wptt_strip_ansi >/dev/null 2>&1; then
    _wptt_strip_ansi "$raw_str"
    clean_str="$WPTT_CLEAN_STR"
  else
    clean_str=$(printf '%s' "$raw_str" | sed 's/\x1B\[[0-9;]*[a-zA-Z]//g')
  fi
  local len=${#clean_str}
  local pad=$((box_inner_width - len))
  ((pad < 0)) && pad=0
  local sp=""
  printf -v sp '%*s' "$pad" ""
  echo -e "${C_CYAN}│${C_RESET}${raw_str}${sp}${C_CYAN}│${C_RESET}"
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_domain:-Quản lý Domain} ➜ ${danh_sach_domain:-Danh sách toàn bộ Domain}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

valid_domains=()
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
  domain="${filepath##*/}"
  domain="${domain%.conf}"
  domain="${domain#.}"

  if [[ "$domain" == ?*.?* ]]; then
    if [[ -d "/usr/local/lsws/$domain/html" || -f "/usr/local/lsws/conf/vhosts/$domain/$domain.conf.bkwptt" ]]; then
      valid_domains+=("$domain")
    fi
  fi
done

so_luong_website="${#valid_domains[@]}"
if ((so_luong_website > 0)); then
  mapfile -t valid_domains < <(printf "%s\n" "${valid_domains[@]}" | sort -uV)
fi

default_php="$(_wptt_fmt_php "${php_version_default:-81}")"

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}TỔNG QUAN: ĐANG CÓ ${C_YELLOW}${so_luong_website}${C_BOLD_WHITE} WEBSITE TRÊN HỆ THỐNG${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

if ((so_luong_website > 0)); then
  i=1
  for domain in "${valid_domains[@]}"; do
    _wptt_read_vhost_meta "/etc/wptt/vhost/.$domain.conf"

    # 1. Phiên bản PHP
    if [[ -n "$META_PHP" ]]; then
      php_ver="$(_wptt_fmt_php "$META_PHP")"
    else
      php_ver="$default_php"
    fi

    # 2. Hệ thống Nhãn trạng thái (Chỉ dùng ký tự ASCII chuẩn 1-width để không bao giờ lệch cột)
    tags="${C_CYAN}[PHP ${php_ver}]${C_RESET}"

    if _wptt_has_ssl "$domain"; then
      tags+=" ${C_GREEN}[SSL]${C_RESET}"
    else
      tags+=" ${C_RED}[No-SSL]${C_RESET}"
    fi

    if [[ -f "/usr/local/lsws/conf/vhosts/$domain/$domain.conf.bkwptt" ]]; then
      tags+=" ${C_RED}[Tạm khóa]${C_RESET}"
    fi

    if [[ "$domain" == "${Website_chinh:-}" ]]; then
      tags+=" ${C_YELLOW}[Website Chính]${C_RESET}"
    fi

    if [[ -n "$META_LOCKDOWN" ]]; then
      tags+=" ${C_YELLOW}[LockDown]${C_RESET}"
    fi

    if [[ "$META_HSTS" == "1" ]]; then
      tags+=" ${C_GREEN}[HSTS]${C_RESET}"
    fi

    # Cắt gọn nếu tên miền quá dài (> 30 ký tự)
    disp_dom="$domain"
    if (( ${#disp_dom} > 30 )); then
      disp_dom="${disp_dom:0:27}..."
    fi

    printf -v stt_str '%3d)' "$i"
    printf -v dom_padded '%-30s' "$disp_dom"

    _wptt_box_line "  ${C_CYAN}${stt_str}${C_RESET} ${C_BOLD_WHITE}${dom_padded}${C_RESET} ${tags}"
    ((i++))
  done
else
  center_text "${C_YELLOW}Hệ thống hiện chưa có website nào.${C_RESET}"
fi

echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

wptt_logs "INFO" "Xem list danh sách domain trên webserver"

wptt_quay_ve_menu "${1:-}" 0 "enter"
