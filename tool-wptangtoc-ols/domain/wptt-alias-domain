#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# shellcheck disable=SC1090,SC1091
function huong_dan() {
  cat <<'EOF'
  Alias domain [hay còn gọi là Parked Domain, Tên miền bí danh] là một tên miền bổ sung được sử dụng để trỏ về một tên miền chính [domain chính]. Khi người dùng truy cập vào Parked domain, họ sẽ tự động được chuyển hướng đến tên miền chính. Nói một cách đơn giản: Tên miền chính: Giống như địa chỉ nhà chính của bạn.
EOF
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
print_border_top "$C_CYAN"
center_text "${C_YELLOW}QUẢN LÝ DOMAIN ➜ THIẾT LẬP PARKED / ALIAS DOMAIN${C_RESET}" "$C_CYAN"
print_border_bot "$C_CYAN"

. /etc/wptt/tenmien 2>/dev/null || true
if declare -f lua_chon_NAME >/dev/null 2>&1; then
  lua_chon_NAME "Gốc muốn gán Alias vào"
fi

domain="${NAME:-}"
path_conf="/etc/wptt/vhost/.${domain}.conf"

[[ "$NAME" == "0" || -z "$NAME" ]] && exec /etc/wptt/wptt-domain-main 1

if [[ ! -f "$path_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Website không tồn tại trên hệ thống hoặc chưa được chọn.${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 1
fi

vhost_conf="/usr/local/lsws/conf/vhosts/${domain}/${domain}.conf"
if [[ ! -f "$vhost_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: File cấu hình Virtual Host của $domain không tồn tại!${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 1
fi

# ==============================================================================
# 2. TRÍCH XUẤT VÀ HIỂN THỊ DANH SÁCH ALIAS HIỆN TẠI
# ==============================================================================
# Trích xuất danh sách alias dạng mảng sạch sẽ (bỏ khoảng trắng và dấu phẩy thừa)
raw_aliases=$(grep -E "^[[:space:]]*vhAliases[[:space:]]+" "$vhost_conf" | sed -E 's/^[[:space:]]*vhAliases[[:space:]]+//' | tr ',' '\n' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^$' || true)

echo ""
if [[ -n "$raw_aliases" ]]; then
  print_border_top "$C_YELLOW"
  center_text "${C_BOLD_WHITE}CÁC ALIAS ĐANG HOẠT ĐỘNG TRÊN: $domain${C_RESET}" "$C_YELLOW"
  print_border_mid "$C_YELLOW"
  while read -r alias_name; do
    left_text "➜ ${C_CYAN}$alias_name${C_RESET}" 4 "$C_YELLOW"
  done <<<"$raw_aliases"
  print_border_bot "$C_YELLOW"
else
  print_border_top "$C_YELLOW"
  center_text "Website $domain hiện chưa có Alias nào." "$C_YELLOW"
  print_border_bot "$C_YELLOW"
fi

# ==============================================================================
# 3. NHẬP VÀ KIỂM TRA ĐỊNH DẠNG TÊN MIỀN ALIAS MỚI
# ==============================================================================
echo -e "\n${C_CYAN}➜ Nhập tên miền muốn gán làm Alias (Ví dụ: alias.com):${C_RESET}"
read -rp " Lựa chọn [0 = thoát]: " NAME2

[[ "$NAME2" == "0" || -z "$NAME2" ]] && {
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 1.5
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 0
}

# Vệ sinh biến đầu vào
NAME2="${NAME2//$'\r'/}"
NAME2="${NAME2// /}"
NAME2="${NAME2//[[:space:]]/}"
NAME2="${NAME2,,}"
[[ "$NAME2" == *"://"* ]] && NAME2="${NAME2#*://}"
[[ "$NAME2" == */* ]] && NAME2="${NAME2%%/*}"
[[ "$NAME2" == www.* ]] && NAME2="${NAME2#www.}"

if [[ "$NAME2" != *.* ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền '$NAME2' không hợp lệ (thiếu dấu chấm).${C_RESET}"
  sleep 2
  exec "$0" "${1:-}"
fi

if [[ "$NAME2" == "$domain" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền Alias không được trùng với tên miền gốc ($domain)!${C_RESET}"
  sleep 2
  exec "$0" "${1:-}"
fi

# Kiểm tra nếu trùng với Website độc lập khác trên hệ thống
if [[ -f "/etc/wptt/vhost/.${NAME2}.conf" ]]; then
  echo ""
  print_border_top "$C_RED"
  center_text "${C_BOLD_WHITE}XUNG ĐỘT HỆ THỐNG${C_RESET}" "$C_RED"
  print_border_mid "$C_RED"
  left_text "${C_YELLOW}Tên miền ${C_BOLD_WHITE}$NAME2${C_RESET}${C_YELLOW} đã tồn tại như một Website độc lập.${C_RESET}" 2 "$C_RED"
  left_text "Không thể gán website chính làm Alias cho website khác." 2 "$C_RED"
  print_border_bot "$C_RED"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 1
fi

# Kiểm tra xung đột nếu Alias đã bị Vhost khác chiếm dụng
_runing "Đang kiểm tra xung đột Alias trên toàn bộ Server..."
conflict_domain=""
for vh_file in /usr/local/lsws/conf/vhosts/*/*.conf; do
  [[ ! -f "$vh_file" || "$vh_file" == "$vhost_conf" ]] && continue
  if grep -E "^[[:space:]]*vhAliases[[:space:]]+" "$vh_file" | grep -qw "$NAME2"; then
    conflict_domain=$(basename "$(dirname "$vh_file")")
    break
  fi
done
_rundone "Đang kiểm tra xung đột Alias trên toàn bộ Server..."

if [[ -n "$conflict_domain" ]]; then
  echo ""
  print_border_top "$C_RED"
  center_text "${C_BOLD_WHITE}XUNG ĐỘT ALIAS XUYÊN VHOST${C_RESET}" "$C_RED"
  print_border_mid "$C_RED"
  left_text "${C_YELLOW}Tên miền ${C_BOLD_WHITE}$NAME2${C_RESET}${C_YELLOW} đang là Alias của website: ${C_BOLD_WHITE}$conflict_domain${C_RESET}" 2 "$C_RED"
  left_text "➜ Vui lòng xóa Alias này bên website '$conflict_domain' trước." 2 "$C_RED"
  print_border_bot "$C_RED"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 1
fi

# ==============================================================================
# 4. THUẬT TOÁN HỢP NHẤT VÀ LÀM SẠCH DANH SÁCH (SET DEDUPLICATION)
# ==============================================================================
# Đưa danh sách cũ và domain mới vào một mảng duy nhất, loại bỏ trùng lặp
declare -A alias_map=()
new_alias_list=()

# Nạp các alias cũ
while read -r a_item; do
  [[ -z "$a_item" || "$a_item" == "$domain" ]] && continue
  if [[ -z "${alias_map["$a_item"]:-}" ]]; then
    alias_map["$a_item"]=1
    new_alias_list+=("$a_item")
  fi
done <<<"$raw_aliases"

is_already_exist=0
if [[ -n "${alias_map["$NAME2"]:-}" ]]; then
  is_already_exist=1
else
  alias_map["$NAME2"]=1
  new_alias_list+=("$NAME2")
fi

# Chuỗi định dạng cho vhAliases: "alias1.com, alias2.com"
vh_aliases_str=$(
  IFS=", "
  echo "${new_alias_list[*]}"
)

# ==============================================================================
# 5. XỬ LÝ SSL & KIỂM TRA DNS
# ==============================================================================
xacnhan_da_tro_dns='0'
if [[ -f "/etc/letsencrypt/live/${domain}/cert.pem" ]]; then
  echo ""
  # Nếu alias đã có từ trước (Self-healing), hỏi cấp lại SSL cho nó
  prompt_text="Sếp có muốn cấp đặt SSL cho Alias Domain này không?"
  ((is_already_exist == 1)) && prompt_text="Alias này đã có trong VHost. Sếp có muốn cấp lại/mở rộng SSL cho nó không?"

  if wptt_xac_nhan "$prompt_text" "Website gốc đã có SSL Let's Encrypt." "Yêu cầu bản ghi A của Alias đã trỏ về IP máy chủ." "Cài đặt SSL ngay" "Bỏ qua, cài sau"; then

    checkdns=$(host "$NAME2" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
    [[ -z "$checkdns" ]] && checkdns=$(nslookup "$NAME2" 2>/dev/null | awk '/Address: / {print $2}' | tail -n 1)
    ip_vps=$(curl -sf --connect-timeout 2 --max-time 4 https://ipv4.icanhazip.com 2>/dev/null || curl -sf --connect-timeout 2 --max-time 4 https://checkip.amazonaws.com 2>/dev/null || true)

    if [[ -n "$ip_vps" && "$checkdns" != "$ip_vps" ]]; then
      echo ""
      print_border_top "$C_RED"
      center_text "${C_BOLD_WHITE}DNS CHƯA TRỎ VỀ VPS${C_RESET}" "$C_RED"
      print_border_mid "$C_RED"
      left_text "Alias mới     : ${C_YELLOW}$NAME2${C_RESET}" 2 "$C_RED"
      left_text "IP Hiện tại   : ${C_RED}${checkdns:-Chưa trỏ}${C_RESET}" 2 "$C_RED"
      left_text "IP Yêu cầu    : ${C_GREEN}$ip_vps${C_RESET} (IP máy chủ này)" 2 "$C_RED"
      print_border_bot "$C_RED"
      sleep 2
    else
      xacnhan_da_tro_dns='1'
    fi
  fi
fi

# ==============================================================================
# 6. THỰC THI CẤU HÌNH LŨY ĐẲNG NGUYÊN TỬ (ATOMIC & IDEMPOTENT)
# ==============================================================================
echo ""
_runing "Đang cấu hình Alias Domain $NAME2 trỏ về $domain..."

# --- A. CẬP NHẬT FILE VHOST ($vhost_conf) ---
tmp_vhost=$(wptt_atomic_begin "$vhost_conf") || exit 1

# 1. Xóa sạch dòng vhAliases cũ (dù có bao nhiêu dòng hay khoảng trắng)
sed -i -E '/^[[:space:]]*vhAliases[[:space:]]+/d' "$tmp_vhost"

# 2. Ghi lại 1 dòng vhAliases duy nhất chứa toàn bộ danh sách đã lọc trùng
if [[ -n "$vh_aliases_str" ]]; then
  sed -i -E "/^[[:space:]]*vhDomain[[:space:]]+/a \vhAliases                     $vh_aliases_str" "$tmp_vhost"
fi

wptt_atomic_commit "$tmp_vhost" "$vhost_conf"

# --- B. CẬP NHẬT LISTENER TOÀN CỤC (httpd_config.conf) ---
ols_conf="/usr/local/lsws/conf/httpd_config.conf"
tmp_ols=$(wptt_atomic_begin "$ols_conf") || exit 1

# Xây dựng danh sách domain đầy đủ cho dòng map của Listener
# Chuẩn: "map <domain_goc> <domain_goc>[, <all_aliases>]"
listener_map_targets="$domain"
[[ -n "$vh_aliases_str" ]] && listener_map_targets+=", $vh_aliases_str"

domain_esc="${domain//./\\.}"

# 1. XÓA SẠCH mọi dòng mapping cũ của VHost này trong toàn bộ Listener
sed -i -E "/^[[:space:]]*map[[:space:]]+${domain_esc}[[:space:]]+/d" "$tmp_ols"

# 2. BƠM LẠI dòng map mới nhất và duy nhất vào cả HTTP và HTTPS
sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS)[[:space:]]*\{/a \  map                     '"$domain $listener_map_targets" "$tmp_ols"

wptt_atomic_commit "$tmp_ols" "$ols_conf"

# --- C. CẤP PHÁT / MỞ RỘNG SSL CHO ALIAS ---
if [[ "$xacnhan_da_tro_dns" == "1" ]]; then
  wptt_smart_reload_lsws >/dev/null 2>&1
  sleep 1

  # Danh sách domain gửi lên Let's Encrypt: "domain.com,alias1.com,alias2.com"
  cert_domains_flag="$domain"
  for al in "${new_alias_list[@]}"; do
    cert_domains_flag+=",$al"
  done

  _runing "Đang cấp chứng chỉ SSL mở rộng: $cert_domains_flag"
  docroot=$(awk '/^[[:space:]]*docRoot[[:space:]]+/ {print $2; exit}' "$vhost_conf")
  [[ -z "$docroot" ]] && docroot="/usr/local/lsws/${domain}/html"

  if certbot certonly --non-interactive --agree-tos --register-unsafely-without-email \
    --webroot -w "${docroot}" --expand -d "$cert_domains_flag" >/dev/null 2>&1; then
    _rundone "Hoàn tất cài đặt SSL mở rộng cho Alias Domain."
  else
    _runloi "Cài đặt SSL thất bại! VHost vẫn hoạt động qua HTTP thông thường."
  fi
fi

wptt_smart_reload_lsws >/dev/null 2>&1
_rundone "Cấu hình Alias Domain hoàn tất."

# ==============================================================================
# 7. THÔNG BÁO HOÀN TẤT
# ==============================================================================
print_border_top "$C_GREEN"
center_text "${C_BOLD_WHITE}THIẾT LẬP ALIAS HOÀN TẤT!${C_RESET}" "$C_GREEN"
print_border_mid "$C_GREEN"
left_text "Tên miền bí danh : ${C_YELLOW}$NAME2${C_RESET}" 2 "$C_GREEN"
left_text "Website gốc      : ${C_GREEN}$domain${C_RESET}" 2 "$C_GREEN"
left_text "Tổng số Alias    : ${C_CYAN}${#new_alias_list[@]}${C_RESET}" 2 "$C_GREEN"
print_border_bot "$C_GREEN"

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
exit 0
