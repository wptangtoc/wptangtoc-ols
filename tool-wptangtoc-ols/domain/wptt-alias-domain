#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# shellcheck disable=SC1090,SC1091

function huong_dan() {
  cat <<'EOF'
  THIẾT LẬP PARKED DOMAIN / ALIAS DOMAIN (TÊN MIỀN BÍ DANH)

  Alias Domain (Parked Domain) là tên miền phụ được gán vào một
  website đã tồn tại trên hệ thống. Nhiều tên miền có thể cùng
  truy cập một website và sử dụng chung mã nguồn, dữ liệu,
  Database WordPress của tên miền chính.

  Ví dụ:
  ➜ Website gốc : wptangtoc.com
  ➜ Alias Domain: wptangtoc.vn
  ➜ Alias Domain: wptangtoc.net
  ➜ Alias Domain: 123.wptangtoc.com

  Khi thiết lập thành công, cả 4 tên miền đều truy cập vào cùng
  một website WordPress của wptangtoc.com.

  1. CHỨC NĂNG CỦA ALIAS DOMAIN
  ➜ Gán thêm tên miền vào một website WordPress đang hoạt động.
  ➜ Sử dụng chung Document Root, mã nguồn và Database của website gốc.
  ➜ Quản lý nhiều tên miền trên cùng một Virtual Host OpenLiteSpeed.
  ➜ Tự động cập nhật cấu hình vhAliases của Virtual Host.
  ➜ Tự động đồng bộ Domain Mapping trên Listener HTTP và HTTPS.
  ➜ Hỗ trợ kiểm tra xung đột tên miền Alias trên toàn bộ Server.
  ➜ Hỗ trợ cấp mới hoặc mở rộng chứng chỉ SSL Let's Encrypt.
  ➜ Tự động phát hiện DNS IPv4, IPv6 và tên miền www.
  ➜ Giữ lại danh sách Alias cũ khi bổ sung tên miền mới.
  ➜ Tự động loại bỏ Alias trùng lặp trong cấu hình.

  2. CHUẨN BỊ DNS TRƯỚC KHI THIẾT LẬP
  Trước khi thêm Alias Domain, hãy đăng nhập trang quản lý DNS
  của nhà cung cấp tên miền và cấu hình bản ghi trỏ về VPS.

  Ví dụ với Alias Domain: wptangtoc.vn

  Bản ghi A:
  ➜ Host: @
  ➜ Value: IP IPv4 của VPS

  Bản ghi A cho www (nếu muốn sử dụng):
  ➜ Host: www
  ➜ Value: IP IPv4 của VPS

  LƯU Ý:
  ➜ DNS cần được cập nhật và phân giải về đúng IP máy chủ.
  ➜ Nếu sử dụng IPv6, bản ghi AAAA phải trỏ đúng IPv6 của VPS.
  ➜ Nếu IPv6 đang trỏ sai máy chủ, hãy chỉnh sửa hoặc xóa AAAA.
  ➜ Có thể cần chờ DNS cập nhật sau khi thay đổi bản ghi.
  ➜ Không bật Proxy/CDN nếu chưa hiểu rõ cách xác thực SSL
    và cấu hình DNS tương ứng.

  3. QUY TRÌNH THIẾT LẬP ALIAS DOMAIN
  Bước 1:
  ➜ Chọn website gốc muốn gán thêm tên miền Alias.

  Bước 2:
  ➜ Nhập tên miền Alias mới, ví dụ: wptangtoc.vn

  Bước 3:
  ➜ Hệ thống kiểm tra định dạng tên miền.
  ➜ Kiểm tra tên miền có bị trùng với website độc lập hay không.
  ➜ Kiểm tra Alias có đang được Virtual Host khác sử dụng hay không.

  Bước 4:
  ➜ Nếu website gốc đã có SSL Let's Encrypt, hệ thống sẽ hỏi
    người dùng có muốn cấp hoặc mở rộng SSL cho Alias không.

  Bước 5:
  ➜ Hệ thống cập nhật cấu hình Virtual Host và Listener.
  ➜ Tự động reload OpenLiteSpeed để áp dụng cấu hình.

  Bước 6:
  ➜ Nếu DNS đã trỏ đúng, hệ thống tiến hành mở rộng SSL.
  ➜ Nếu DNS chưa trỏ đúng, Alias vẫn được cấu hình nhưng SSL
    sẽ được bỏ qua để người dùng thiết lập DNS sau.

  4. CẤU HÌNH SSL LET'S ENCRYPT
  Hệ thống hỗ trợ mở rộng chứng chỉ SSL cho Alias Domain.

  ➜ Giữ lại các tên miền SAN đang có trong chứng chỉ hiện tại.
  ➜ Bổ sung tên miền Alias mới vào chứng chỉ.
  ➜ Tự động kiểm tra DNS IPv4 và IPv6 trước khi cấp SSL.
  ➜ Kiểm tra riêng bản ghi www của Alias Domain.
  ➜ Nếu www đã trỏ đúng VPS, có thể đưa www vào chứng chỉ.
  ➜ Sử dụng cert-name theo tên miền gốc để hạn chế phát sinh
    nhánh chứng chỉ trùng lặp như -0001.

  LƯU Ý:
  SSL chỉ được cấp khi điều kiện xác thực DNS phù hợp.
  Nếu DNS chưa chính xác, hãy xử lý DNS rồi thực hiện cấp SSL
  sau. Không nên cố cấp chứng chỉ khi tên miền đang trỏ sai VPS.

  5. NHỮNG ĐIỀU CẦN BIẾT
  ⚠️ Alias Domain không tạo ra một website WordPress độc lập.

  ➜ Các Alias dùng chung mã nguồn và Database với website gốc.
  ➜ Nội dung, tài khoản, plugin, theme và cấu hình WordPress
    đều thuộc cùng một website.
  ➜ Nếu muốn tạo website riêng biệt, hãy sử dụng chức năng
    thêm website mới thay vì Alias Domain.
  ➜ Một tên miền không thể đồng thời làm Alias cho nhiều
    Virtual Host trên cùng hệ thống.
  ➜ Nếu Alias đang tồn tại dưới dạng website độc lập, cần xử lý
    website đó trước khi gán làm Alias.
  ➜ Việc thêm Alias không tự động thay đổi URL chính trong
    WordPress Database.
  ➜ Nếu muốn Alias chuyển hướng về tên miền chính, cần cấu hình
    Redirect/Canonical URL riêng phù hợp với nhu cầu SEO.

  6. KIỂM TRA SAU KHI THIẾT LẬP
  Sau khi hoàn tất, hãy kiểm tra:

  ➜ Alias Domain đã phân giải DNS về đúng VPS.
  ➜ Website có truy cập được qua Alias Domain hay không.
  ➜ HTTPS có hoạt động và chứng chỉ SSL hợp lệ hay không.
  ➜ Bản ghi www có hoạt động nếu đã cấu hình.
  ➜ Nội dung website có hiển thị đúng như tên miền gốc.
  ➜ Không có lỗi redirect vòng lặp hoặc lỗi Mixed Content.

  MẸO:
  Nếu Alias truy cập được nhưng SSL chưa hoạt động, hãy kiểm tra
  DNS A/AAAA, trạng thái chứng chỉ và thực hiện cấp SSL lại.

EOF
}

# Chuyển về thư mục an toàn
cd /root 2>/dev/null || cd /

. /etc/wptt/core-functions 2>/dev/null
wptt_load_main_conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

clear
print_border_top "$C_CYAN"
center_text "${C_YELLOW}QUẢN LÝ DOMAIN ➜ THIẾT LẬP PARKED / ALIAS DOMAIN${C_RESET}" "$C_CYAN"
print_border_bot "$C_CYAN"

# ==============================================================================
# 1. CHỌN VÀ XÁC THỰC WEBSITE GỐC
# ==============================================================================
. /etc/wptt/tenmien 2>/dev/null || true
if declare -f lua_chon_NAME >/dev/null 2>&1; then
  lua_chon_NAME "Gốc muốn gán Alias vào"
fi

domain="${NAME:-}"
path_conf="/etc/wptt/vhost/.${domain}.conf"

[[ "$NAME" == "0" || -z "$NAME" ]] && wptt_quay_ve_menu "${1:-}" 1

if [[ ! -f "$path_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Website không tồn tại trên hệ thống hoặc chưa được chọn.${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

vhost_conf="/usr/local/lsws/conf/vhosts/${domain}/${domain}.conf"
if [[ ! -f "$vhost_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: File cấu hình Virtual Host của $domain không tồn tại!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# 2. TRÍCH XUẤT VÀ HIỂN THỊ DANH SÁCH ALIAS HIỆN TẠI
# ==============================================================================
raw_aliases=$(grep -E "^[[:space:]]*vhAliases[[:space:]]+" "$vhost_conf" 2>/dev/null |
  sed -E 's/^[[:space:]]*vhAliases[[:space:]]+//' |
  tr ',' '\n' |
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' |
  grep -v '^$' || true)

echo ""
if [[ -n "$raw_aliases" ]]; then
  print_border_top "$C_YELLOW"
  center_text "${C_BOLD_WHITE}CÁC ALIAS ĐANG HOẠT ĐỘNG TRÊN: $domain${C_RESET}" "$C_YELLOW"
  print_border_mid "$C_YELLOW"
  while read -r alias_name; do
    left_text "➜ ${C_CYAN}$alias_name${C_RESET}" 4 "$C_YELLOW"
  done <<<"$raw_aliases"
  print_border_bot "$C_YELLOW"
else
  print_border_top "$C_YELLOW"
  center_text "Website $domain hiện chưa có Alias nào." "$C_YELLOW"
  print_border_bot "$C_YELLOW"
fi

# ==============================================================================
# 3. NHẬP VÀ KIỂM TRA ĐỊNH DẠNG TÊN MIỀN ALIAS MỚI
# ==============================================================================
echo -e "\n${C_CYAN}➜ Nhập tên miền muốn gán làm Alias (Ví dụ: alias.com):${C_RESET}"
read -rp " Lựa chọn [0 = thoát]: " NAME2

[[ "$NAME2" == "0" || -z "$NAME2" ]] && {
  echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
  sleep 1.5
  wptt_quay_ve_menu "${1:-}" 0
}

# Vệ sinh biến đầu vào
NAME2="${NAME2//$'\r'/}"
NAME2="${NAME2// /}"
NAME2="${NAME2//[[:space:]]/}"
NAME2="${NAME2,,}"
[[ "$NAME2" == *"://"* ]] && NAME2="${NAME2#*://}"
[[ "$NAME2" == */* ]] && NAME2="${NAME2%%/*}"
[[ "$NAME2" == www.* ]] && NAME2="${NAME2#www.}"

if [[ "$NAME2" != *.* || "$NAME2" =~ [^a-z0-9.-] ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền '$NAME2' không hợp lệ (sai định dạng hoặc chứa ký tự đặc biệt).${C_RESET}"
  sleep 2
  exec "$0" "${1:-}"
fi

if [[ "$NAME2" == "$domain" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Tên miền Alias không được trùng với tên miền gốc ($domain)!${C_RESET}"
  sleep 2
  exec "$0" "${1:-}"
fi

# Kiểm tra nếu trùng với Website độc lập khác trên hệ thống
if [[ -f "/etc/wptt/vhost/.${NAME2}.conf" ]]; then
  echo ""
  print_border_top "$C_RED"
  center_text "${C_BOLD_WHITE}XUNG ĐỘT HỆ THỐNG${C_RESET}" "$C_RED"
  print_border_mid "$C_RED"
  left_text "${C_YELLOW}Tên miền ${C_BOLD_WHITE}$NAME2${C_RESET}${C_YELLOW} đã tồn tại như một Website độc lập.${C_RESET}" 2 "$C_RED"
  left_text "Không thể gán website chính làm Alias cho website khác." 2 "$C_RED"
  left_text "➜ Hướng giải quyết: Vui lòng xóa website '$NAME2' trước." 2 "$C_RED"
  print_border_bot "$C_RED"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

# Kiểm tra xung đột nếu Alias đã bị Vhost khác chiếm dụng
_runing "Đang kiểm tra xung đột Alias trên toàn bộ Server..."
conflict_domain=""
for vh_file in /usr/local/lsws/conf/vhosts/*/*.conf; do
  [[ ! -f "$vh_file" || "$vh_file" == "$vhost_conf" ]] && continue
  if grep -E "^[[:space:]]*vhAliases[[:space:]]+" "$vh_file" 2>/dev/null | grep -qw "$NAME2"; then
    conflict_domain=$(basename "$(dirname "$vh_file")")
    break
  fi
done
_rundone "Đang kiểm tra xung đột Alias trên toàn bộ Server..."

if [[ -n "$conflict_domain" ]]; then
  echo ""
  print_border_top "$C_RED"
  center_text "${C_BOLD_WHITE}XUNG ĐỘT ALIAS XUYÊN VHOST${C_RESET}" "$C_RED"
  print_border_mid "$C_RED"
  left_text "${C_YELLOW}Tên miền ${C_BOLD_WHITE}$NAME2${C_RESET}${C_YELLOW} đang là Alias của website: ${C_BOLD_WHITE}$conflict_domain${C_RESET}" 2 "$C_RED"
  left_text "Một Alias không thể phục vụ cùng lúc 2 website." 2 "$C_RED"
  left_text "➜ Hướng giải quyết: Hãy xóa Alias này bên website '$conflict_domain' trước." 2 "$C_RED"
  print_border_bot "$C_RED"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1
fi

# ==============================================================================
# 4. HỢP NHẤT VÀ LÀM SẠCH DANH SÁCH ALIAS (DEDUPLICATION)
# ==============================================================================
declare -A alias_map=()
new_alias_list=()

while read -r a_item; do
  [[ -z "$a_item" || "$a_item" == "$domain" ]] && continue
  if [[ -z "${alias_map["$a_item"]:-}" ]]; then
    alias_map["$a_item"]=1
    new_alias_list+=("$a_item")
  fi
done <<<"$raw_aliases"

is_already_exist=0
if [[ -n "${alias_map["$NAME2"]:-}" ]]; then
  is_already_exist=1
else
  alias_map["$NAME2"]=1
  new_alias_list+=("$NAME2")
fi

vh_aliases_str=""
for a in "${new_alias_list[@]}"; do
  vh_aliases_str+="${vh_aliases_str:+, }$a"
done

# ==============================================================================
# 5. RÒ DNS ĐA TẦNG & KIỂM TRA BẪY LETS ENCRYPT (CHUẨN WPTANGTOC SSL)
# ==============================================================================
xacnhan_da_tro_dns='0'
include_alias_www='0'
cert_live_file="/etc/letsencrypt/live/${domain}/cert.pem"

if [[ -f "$cert_live_file" ]]; then
  echo ""
  prompt_text="Sếp có muốn cấp đặt SSL Let's Encrypt cho Alias Domain này không?"
  ((is_already_exist == 1)) && prompt_text="Alias này đã có trong VHost. Sếp có muốn cấp lại/mở rộng SSL cho nó không?"

  if wptt_xac_nhan "$prompt_text" "Website gốc đã có SSL Let's Encrypt." "Hệ thống sẽ tự động rò DNS đa tầng trước khi cấp." "Cài đặt SSL ngay" "Bỏ qua, cài sau"; then

    _runing "Đang rò quét phân giải DNS cho Alias $NAME2..."

    # 1. Thu thập danh sách IP của máy chủ hiện tại
    server_ips=$(ip a 2>/dev/null | grep -Eo '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | sed '/127.0.0.1/d' | sed '/192.168/d' | sort -u || true)
    public_ip=$(curl -sf --connect-timeout 4 https://ipv4.icanhazip.com || curl -sf --connect-timeout 4 https://checkip.amazonaws.com | grep -Eo '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' || true)
    server_ips="$server_ips $public_ip"
    server_ipv6=$(curl -s --connect-timeout 4 https://ipv6.icanhazip.com 2>/dev/null || true)

    # 2. Bắt bẫy IPv6 (AAAA record trap): Let's Encrypt luôn ưu tiên IPv6 trước
    checkdns_v6=$(host -t AAAA "$NAME2" 2>/dev/null | grep "has IPv6 address" | awk '{print $5}' | head -1 || true)
    has_ipv6_conflict=0

    if [[ -n "$checkdns_v6" ]]; then
      if [[ -z "$server_ipv6" ]] || ! echo "$server_ipv6" | grep -qiw "$checkdns_v6"; then
        has_ipv6_conflict=1
        _runloi "Phát hiện xung đột DNS IPv6 (Bản ghi AAAA) trên $NAME2"
        echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
        center_text "${C_RED}CẢNH BÁO: ALIAS ĐANG TRỎ SAI BẢN GHI IPV6 (AAAA)${C_RESET}"
        echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        left_text " Let's Encrypt luôn ${C_RED}ƯU TIÊN TUYỆT ĐỐI${C_RESET} xác thực qua IPv6 nếu có AAAA." 2
        left_text " - IPv6 (AAAA) đang trỏ : ${C_RED}$checkdns_v6${C_RESET}" 2
        left_text " - IPv6 VPS hiện tại    : ${C_YELLOW}${server_ipv6:-Không có IPv6}${C_RESET}" 2
        left_text " ➜ SSL tạm thời bỏ qua để tránh lỗi. Hãy xóa bản ghi AAAA trên DNS." 2
        echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
        sleep 3
      fi
    fi

    # 3. Rò DNS IPv4 qua 4 kênh độc lập (host, nslookup, Google DoH, Cloudflare DoH)
    if [[ "$has_ipv6_conflict" -eq 0 ]]; then
      checkdns=$(host "$NAME2" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' || true)
      checkdns2=$(nslookup "$NAME2" 2>/dev/null | grep Address | cut -d':' -f2 | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' || true)
      checkdns3=$(curl -s --connect-timeout 4 "https://dns.google/resolve?name=${NAME2}&type=A" 2>/dev/null | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1 || true)
      checkdns4=$(curl -s --connect-timeout 4 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=${NAME2}&type=A" 2>/dev/null | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1 || true)

      for resolved_ip in "$checkdns" "$checkdns2" "$checkdns3" "$checkdns4"; do
        if [[ -n "$resolved_ip" ]] && echo "$server_ips" | grep -q "\b$resolved_ip\b"; then
          xacnhan_da_tro_dns='1'
          break
        fi
      done

      if [[ "$xacnhan_da_tro_dns" == "1" ]]; then
        _rundone "Xác thực DNS Alias thành công (Đã trỏ đúng IP máy chủ)"

        # 4. Rò riêng DNS www qua Google DoH: Trỏ thì gộp vào, không trỏ thì bỏ qua
        checkdns_www=$(curl -s --connect-timeout 4 "https://dns.google/resolve?name=www.${NAME2}&type=A" 2>/dev/null | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1 || true)
        if [[ -n "$checkdns_www" ]] && echo "$server_ips" | grep -q "\b$checkdns_www\b"; then
          include_alias_www='1'
        fi
      else
        _runloi "Alias $NAME2 chưa trỏ bản ghi A về máy chủ"
        echo -e "\n${C_RED}❌ DNS CHƯA TRỎ VỀ VPS:${C_RESET} Tên miền ${C_YELLOW}$NAME2${C_RESET} chưa trỏ về IP ${C_GREEN}$public_ip${C_RESET}."
        echo -e "${C_YELLOW}Cài đặt SSL tạm thời bỏ qua. VHost vẫn hoạt động qua HTTP.${C_RESET}\n"
        sleep 2
      fi
    fi
  fi
fi

# ==============================================================================
# 6. THỰC THI CẤU HÌNH LŨY ĐẲNG NGUYÊN TỬ (ATOMIC & IDEMPOTENT)
# ==============================================================================
echo ""
_runing "Đang cấu hình Alias Domain $NAME2 trỏ về $domain..."

# --- A. CẬP NHẬT FILE VHOST ($vhost_conf) ---
tmp_vhost=$(wptt_atomic_begin "$vhost_conf") || exit 1

# Xóa sạch dòng vhAliases cũ và ghi dòng duy nhất đã deduplicate
sed -i -E '/^[[:space:]]*vhAliases[[:space:]]+/d' "$tmp_vhost"
if [[ -n "$vh_aliases_str" ]]; then
  sed -i -E "/^[[:space:]]*vhDomain[[:space:]]+/a \vhAliases                     $vh_aliases_str" "$tmp_vhost"
fi

wptt_atomic_commit "$tmp_vhost" "$vhost_conf"

# --- B. CẬP NHẬT LISTENER TOÀN CỤC (httpd_config.conf) ---
ols_conf="/usr/local/lsws/conf/httpd_config.conf"
tmp_ols=$(wptt_atomic_begin "$ols_conf") || exit 1

listener_map_targets="$domain"
[[ -n "$vh_aliases_str" ]] && listener_map_targets+=", $vh_aliases_str"

domain_esc="${domain//./\\.}"

# Clean-Before-Insert: Xóa sạch map cũ và bơm lại dòng duy nhất vào HTTP & HTTPS
sed -i -E "/^[[:space:]]*map[[:space:]]+${domain_esc}[[:space:]]+/d" "$tmp_ols"
sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS)[[:space:]]*\{/a \  map                     '"$domain $listener_map_targets" "$tmp_ols"

wptt_atomic_commit "$tmp_ols" "$ols_conf"

# --- C. MỞ RỘNG SSL AN TOÀN CHO ALIAS ---
if [[ "$xacnhan_da_tro_dns" == "1" ]]; then
  wptt_smart_reload_lsws >/dev/null 2>&1
  sleep 1

  _runing "Đang đồng bộ SAN và cấp chứng chỉ SSL mở rộng..."

  declare -A active_ssl_domains=()

  # 1. Bảo tồn 100% các domain đang có trong chứng chỉ (giữ www.$domain và alias cũ)
  if [[ -f "$cert_live_file" ]]; then
    while read -r d_san; do
      [[ -n "$d_san" ]] && active_ssl_domains["$d_san"]=1
    done < <(openssl x509 -in "$cert_live_file" -noout -ext subjectAltName 2>/dev/null | grep -o 'DNS:[^, ]*' | sed 's/DNS://')
  fi

  active_ssl_domains["$domain"]=1
  active_ssl_domains["$NAME2"]=1
  ((include_alias_www == 1)) && active_ssl_domains["www.$NAME2"]=1

  # 2. Gom danh sách domain gửi lên Certbot
  cert_domains_flag=""
  for d_target in "${!active_ssl_domains[@]}"; do
    cert_domains_flag+="${cert_domains_flag:+,}$d_target"
  done

  docroot=$(awk '/^[[:space:]]*docRoot[[:space:]]+/ {print $2; exit}' "$vhost_conf")
  [[ -z "$docroot" ]] && docroot="/usr/local/lsws/${domain}/html"

  # 3. Chốt cứng --cert-name để triệt tiêu vĩnh viễn bug sinh nhánh -0001
  if certbot certonly --non-interactive --agree-tos --register-unsafely-without-email --key-type ecdsa --elliptic-curve secp256r1 \
    --webroot -w "${docroot}" \
    --cert-name "${domain}" \
    --expand -d "$cert_domains_flag" >/dev/null 2>&1; then
    _rundone "Hoàn tất cấp chứng chỉ SSL mở rộng cho Alias Domain."
  else
    _runloi "Cấp phát SSL mở rộng thất bại! Alias vẫn hoạt động an toàn qua HTTP."
  fi
fi

wptt_smart_reload_lsws >/dev/null 2>&1
_rundone "Cấu hình Alias Domain hoàn tất."

