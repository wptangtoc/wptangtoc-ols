function huong_dan() {
  cat <<'EOF'
  Tính năng Chuyển hướng domain [Domain Redirection] là một kỹ thuật tự động điều hướng người dùng và các công cụ tìm kiếm từ một địa chỉ tên miền này sang một địa chỉ tên miền khác.

  Nói một cách đơn giản, khi ai đó gõ vào hoặc nhấp vào một tên miền A, thay vì hiển thị nội dung của tên miền A, trình duyệt của họ sẽ tự động được chuyển đến tên miền B [hoặc một trang cụ thể trên tên miền B].

  Mục Đích Chính
  * Trỏ nhiều tên miền về một website: Nếu bạn sở hữu nhiều biến thể tên miền [ví dụ: tencongty.com, tencongty.vn, ten-cong-ty.com], bạn có thể chuyển hướng tất cả chúng về một tên miền chính duy nhất.
  * Sau khi đổi tên miền website: Chuyển hướng từ tên miền cũ sang tên miền mới để không mất khách truy cập và duy trì giá trị SEO.
  * Chuyển hướng tên miền phụ [subdomain]: Ví dụ, chuyển blog.tenmien.com sang blog-tenmien.com.
  * URL thân thiện/Rút gọn link: Tạo các đường link ngắn, dễ nhớ để chuyển hướng đến các URL dài hơn, phức tạp hơn.
  * Thông báo bảo trì website: Tạm thời chuyển hướng người dùng đến một trang thông báo khi website đang được bảo trì.

  Tính năng chuyển hướng domain rất quan trọng để quản lý truy cập, đảm bảo trải nghiệm người dùng tốt và duy trì hiệu quả SEO cho website của bạn.
EOF
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
stty iutf8 2>/dev/null || true

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_domain:-Quản lý Domain} ➜ ${chuyen_huong_domain:-Chuyển hướng Domain}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME="${1:-}"
NAME2="${2:-}"
[[ "$NAME" == "98" ]] && NAME=""

# ==============================================================================
# BƯỚC 1: NHẬP VÀ KIỂM TRA DOMAIN GỐC (NGUỒN)
# ==============================================================================
if [[ -z "$NAME" ]]; then
  echo -e "${C_YELLOW}Nhập domain bạn muốn chuyển hướng đi (Ví dụ: cu.com, old.vn)${C_RESET}"
  echo -en "${C_CYAN}Tên miền Nguồn [0=${exit_thoat:-Thoát}]: ${C_RESET}"
  read -r NAME
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  return 2 2>/dev/null || exit 0
}

# Vệ sinh biến đầu vào
NAME="${NAME//$'\r'/}"
NAME="${NAME// /}"
NAME="${NAME//[[:space:]]/}"
NAME="${NAME,,}"

[[ "$NAME" == *"://"* ]] && NAME=$(echo "$NAME" | cut -f3 -d '/')
[[ "$NAME" == www.* ]] && NAME="${NAME#www.}"

if [[ "$NAME" == "${NAME/./}" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Domain $NAME nhập không đúng định dạng (thiếu dấu chấm)!${C_RESET}"
  [[ "${1:-}" == "98" ]] && {
    echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-domain-main 1
  }
  return 1 2>/dev/null || exit 1
fi

REGEX_DOMAIN="^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z]{2,}$"
REGEX_IP="^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"

if [[ ! "$NAME" =~ $REGEX_DOMAIN && ! "$NAME" =~ $REGEX_IP ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Domain Nguồn $NAME chứa ký tự không hợp lệ hoặc sai cấu trúc.${C_RESET}"
  [[ "${1:-}" == "98" ]] && {
    echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-domain-main 1
  }
  return 1 2>/dev/null || exit 1
fi

# ==============================================================================
# BƯỚC 2: NHẬP VÀ KIỂM TRA DOMAIN ĐÍCH
# ==============================================================================
echo ""
if [[ -z "$NAME2" ]]; then
  echo -e "${C_YELLOW}Nhập domain bạn muốn chuyển hướng tới (Ví dụ: moi.com, www.moi.vn)${C_RESET}"
  echo -en "${C_CYAN}Tên miền Đích [0=${exit_thoat:-Thoát}]: ${C_RESET}"
  read -r NAME2
fi

[[ "$NAME2" == "0" || -z "$NAME2" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  return 1 2>/dev/null || exit 1
}

NAME2="${NAME2//$'\r'/}"
NAME2="${NAME2// /}"
NAME2="${NAME2//[[:space:]]/}"
NAME2="${NAME2,,}"

[[ "$NAME2" == *"://"* ]] && NAME2=$(echo "$NAME2" | cut -f3 -d '/')

NAME2www=""
if [[ "$NAME2" == www.* ]]; then
  NAME2="${NAME2#www.}"
  NAME2www='www.'
fi

if [[ ! "$NAME2" =~ $REGEX_DOMAIN && ! "$NAME2" =~ $REGEX_IP ]]; then
  echo -e "\n${C_RED}Lỗi: Domain Đích chứa ký tự không hợp lệ hoặc sai cấu trúc.${C_RESET}"
  [[ "${1:-}" == "98" ]] && {
    echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-domain-main 1
  }
  return 1 2>/dev/null || exit 1
fi

if [[ "$NAME" == "$NAME2" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Bạn không thể chuyển hướng vòng lặp từ $NAME sang chính nó!${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && {
    echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-domain-main 1
  }
  return 1 2>/dev/null || exit 1
fi

# ==============================================================================
# BƯỚC 3: KIỂM TRA TRẠNG THÁI VÀ XÁC NHẬN GHI ĐÈ
# ==============================================================================
pathcheck_chuyen_huong="/etc/wptt/chuyen-huong/.${NAME}.conf"
USER="${NAME//[-._]/}"

if [[ -f "$pathcheck_chuyen_huong" ]]; then
  current_target=$(awk '/RewriteRule/ {for(i=1;i<=NF;i++) if($i ~ /^https?:\/\//) print $i}' "/usr/local/lsws/$NAME/html/.htaccess" 2>/dev/null | tail -n 1)

  echo -e "\n${C_YELLOW}CHÚ Ý: Domain ${C_BOLD_WHITE}$NAME${C_YELLOW} ĐÃ ĐƯỢC CHUYỂN HƯỚNG TRƯỚC ĐÓ!${C_RESET}"
  echo -e "Đang chuyển hướng tới: ${C_CYAN}${current_target:-Không xác định}${C_RESET}\n"

  if ! wptt_xac_nhan "Bạn có muốn XÓA thiết lập cũ và tạo chuyển hướng MỚI sang $NAME2 không?" "" "" "Đồng ý Ghi đè" "Hủy bỏ"; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    sleep 2
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
    return 1 2>/dev/null || exit 1
  fi
fi

# ==============================================================================
# HÀM THAY THẾ WEBSITE CHÍNH (ĐẢM BẢO AN TOÀN TUYỆT ĐỐI)
# ==============================================================================
thay_name_domain_chinh() {
  local NAME_OLD="$1"
  local NAME_NEW="$2"

  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "Website_chinh=$NAME_NEW" 2>/dev/null || true

  # Tạo chứng chỉ tự ký dự phòng nếu chưa có
  if [[ ! -s "/etc/wptt-ssl-tu-ky/${NAME_NEW}/${NAME_NEW}.key" ]]; then
    mkdir -p "/etc/wptt-ssl-tu-ky/$NAME_NEW"
    openssl req -new -newkey rsa:2048 -nodes \
      -keyout "/etc/wptt-ssl-tu-ky/$NAME_NEW/$NAME_NEW.key" \
      -out "/etc/wptt-ssl-tu-ky/$NAME_NEW/$NAME_NEW.csr" \
      -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTangToc OLS/OU=IT/CN=$NAME_NEW/emailAddress=admin@$NAME_NEW" >/dev/null 2>&1
    openssl x509 -req -in "/etc/wptt-ssl-tu-ky/$NAME_NEW/$NAME_NEW.csr" \
      -signkey "/etc/wptt-ssl-tu-ky/$NAME_NEW/$NAME_NEW.key" \
      -out "/etc/wptt-ssl-tu-ky/$NAME_NEW/cert.crt" -days 3650 >/dev/null 2>&1
  fi

  # Cập nhật SSL Listener đại diện máy chủ bằng Atomic Commit (Chỉ sửa trong block listener HTTPS/SSL)
  local ols_conf="/usr/local/lsws/conf/httpd_config.conf"
  local tmp_ols
  tmp_ols=$(wptt_atomic_begin "$ols_conf") || return 1

  sed -i -E '/^[[:space:]]*listener[[:space:]]+(https|HTTPS|ssl|SSL)[[:space:]]*\{/,/^[[:space:]]*}[[:space:]]*$/ {
    /^[[:space:]]*(keyFile|certFile|CACertFile)[[:space:]]+/d
  }' "$tmp_ols"

  sed -i -E '/^[[:space:]]*listener[[:space:]]+(https|HTTPS|ssl|SSL)[[:space:]]*\{/a \  certFile                /etc/wptt-ssl-tu-ky/'"$NAME_NEW"'/cert.crt\n  keyFile                 /etc/wptt-ssl-tu-ky/'"$NAME_NEW"'/'"$NAME_NEW"'.key' "$tmp_ols"

  wptt_atomic_commit "$tmp_ols" "$ols_conf"

  # Di dời phpMyAdmin sang Website chính mới nếu có
  if [[ -n "${id_dang_nhap_phpmyadmin:-}" && -d "/usr/local/lsws/$NAME_OLD/html/phpmyadmin" ]]; then
    mkdir -p "/usr/local/lsws/$NAME_NEW/html" "/usr/local/lsws/$NAME_NEW/passwd"
    cp -rf "/usr/local/lsws/$NAME_OLD/html/phpmyadmin" "/usr/local/lsws/$NAME_NEW/html/"
    rm -rf "/usr/local/lsws/${NAME_OLD:?}/html/phpmyadmin"
    cp -f "/usr/local/lsws/$NAME_OLD/passwd/.phpmyadmin" "/usr/local/lsws/$NAME_NEW/passwd/" 2>/dev/null || true

    local group_ols="nobody"
    grep -qi "ubuntu" /etc/*release 2>/dev/null && group_ols="nogroup"
    chown -hR nobody:"$group_ols" "/usr/local/lsws/$NAME_NEW/passwd"

    sed -i -e '/^realm '"${NAME_OLD}"'phpphpmyadmin/,/^}$/d' "/usr/local/lsws/conf/vhosts/$NAME_OLD/$NAME_OLD.conf" 2>/dev/null || true
    sed -i -e '/^context \/phpmyadmin\//,/^}$/d' "/usr/local/lsws/conf/vhosts/$NAME_OLD/$NAME_OLD.conf" 2>/dev/null || true

    cat <<EOF >>"/usr/local/lsws/conf/vhosts/$NAME_NEW/$NAME_NEW.conf"
realm ${NAME_NEW}phpphpmyadmin {
  userDB  {
    location              /usr/local/lsws/${NAME_NEW}/passwd/.phpmyadmin
  }
}
context /phpmyadmin/ {
  location                phpmyadmin/
  allowBrowse             1
  realm                   ${NAME_NEW}phpphpmyadmin
  accessControl  {
    allow                 ALL
  }
  rewrite  {
  }
  addDefaultCharset       off
  phpIniOverride  {
  }
}
EOF
  fi
}

# Điều phối chuyển giao Website chính
if [[ "${Website_chinh:-}" == "$NAME" ]]; then
  if [[ -d "/usr/local/lsws/$NAME2/html" ]]; then
    thay_name_domain_chinh "$NAME" "$NAME2"
  else
    vhost_count=$(find /etc/wptt/vhost -maxdepth 1 -name ".*.conf" ! -name "..conf" 2>/dev/null | wc -l)
    if ((vhost_count >= 2)) && [[ "${1:-}" == "98" ]]; then
      echo -e "\n${C_YELLOW}CẢNH BÁO: Tên miền bạn đang chuyển hướng ($NAME) hiện đang là WEBSITE CHÍNH của hệ thống!${C_RESET}"
      echo -e "Bạn cần phải chọn một tên miền KHÁC đang tồn tại để thay thế làm Website Chính."

      box_inner_width=${box_inner_width:-71}
      selects=()

      for filepath in /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
        opt="${filepath##*/}"
        opt="${opt%.conf}"
        opt="${opt#.}"
        if [[ "$opt" == ?*.?* && "$opt" != "$Website_chinh" ]]; then
          selects+=("$opt")
        fi
      done

      if [[ ${#selects[@]} -eq 0 ]]; then
        echo -e "\n${C_RED}Hệ thống không còn website nào khác để gán làm Website chính!${C_RESET}"
        exec /etc/wptt/wptt-domain-main 1
      fi

      echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_YELLOW}CHỌN DOMAIN LÀM WEBSITE CHÍNH MỚI${C_RESET}"
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      i=1
      for domain in "${selects[@]}"; do
        item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain")
        clean_text=$(printf "  %3d) %s" "$i" "$domain")
        pad=$((box_inner_width - ${#clean_text}))
        ((pad < 0)) && pad=0
        echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
        ((i++))
      done
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

      while true; do
        echo -en "${C_CYAN}Nhập lựa chọn (1-${#selects[@]}) [0=Hủy bỏ]: ${C_RESET}"
        read -r REPLY
        [[ "$REPLY" == "0" ]] && exec /etc/wptt/wptt-domain-main 1
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((REPLY >= 1 && REPLY <= ${#selects[@]})); then
          NAME_CHINH_OPTION="${selects[$((REPLY - 1))]}"
          break
        else
          echo -e "${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
      done
      thay_name_domain_chinh "$NAME" "$NAME_CHINH_OPTION"
    fi
  fi
fi

wptt_logs "INFO" "Chuyển hướng website $NAME về website $NAME2" 2>/dev/null || true

# ==============================================================================
# TỰ CHỮA LÀNH LOCK USER (MULTI-TERMINAL RESILIENT)
# ==============================================================================
wptt_heal_user_locks() {
  local lock_files=(
    "/etc/passwd.lock"
    "/etc/shadow.lock"
    "/etc/group.lock"
    "/etc/gshadow.lock"
    "/etc/subuid.lock"
    "/etc/subgid.lock"
  )
  local has_any=0
  for l in "${lock_files[@]}"; do
    [[ -f "$l" ]] && {
      has_any=1
      break
    }
  done
  ((has_any == 0)) && return 0

  local proc_regex="useradd|usermod|userdel|groupadd|groupdel|chage|passwd|vipw|pwck"
  local btime=0
  btime=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null || echo 0)

  for lock in "${lock_files[@]}"; do
    [[ -f "$lock" ]] || continue
    local lock_mtime=0
    lock_mtime=$(stat -c %Y "$lock" 2>/dev/null || echo 0)

    if ((btime > 0 && lock_mtime < btime)); then
      /bin/rm -f -- "$lock" 2>/dev/null || true
      continue
    fi

    if pgrep -x "$proc_regex" >/dev/null 2>&1; then
      local wait_count=0
      while pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]] && ((wait_count < 15)); do
        sleep 0.2
        ((wait_count++))
      done
      if ! pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]]; then
        /bin/rm -f -- "$lock" 2>/dev/null || true
      fi
    else
      sleep 0.3
      if ! pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]]; then
        /bin/rm -f -- "$lock" 2>/dev/null || true
      fi
    fi
  done
  return 0
}

# ==============================================================================
# THỰC THI CHUYỂN HƯỚNG
# ==============================================================================
echo ""
_runing "Đang thiết lập chuyển hướng $NAME sang $NAME2..."

GOTO_FINISH=""

# ------------------------------------------------------------------------------
# NHÁNH 1: WEBSITE ĐÃ TỒN TẠI (CHỈ CẦN TIÊM HTACCESS & DỌN DẸP CACHE)
# ------------------------------------------------------------------------------
if [[ -d "/usr/local/lsws/$NAME/html" ]]; then
  if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
    # shellcheck disable=SC1090
    . "/etc/wptt/vhost/.$NAME.conf"
    if [[ -n "${vhost_chuyen_htaccess:-}" ]]; then
      . /etc/wptt/wptt-vhost-chuyen-ve-htaccess "$NAME" >/dev/null 2>&1 || true
    fi
  fi

  # Tiêm luật Rewrite 301 không chứa dấu cách thừa trong flag [L,R=301,NC]
  cat <<EOF >"/usr/local/lsws/$NAME/html/.htaccess"
#begin-chuyen-huong-domain-wptangtoc
RewriteEngine On
RewriteCond %{HTTP_HOST} ^${NAME}$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.${NAME}$ [NC]
RewriteCond %{REQUEST_URI} !.*well-known.*$ [NC]
RewriteRule ^(.*)$ https://${NAME2www}${NAME2}/\$1 [L,R=301,NC]
#end-chuyen-huong-domain-wptangtoc
EOF

  mkdir -p /etc/wptt/chuyen-huong
  touch "/etc/wptt/chuyen-huong/.${NAME}.conf"

  # Dọn sạch Cache nền để không bị kẹt cache HTML cũ
  if wptt_kha_dung_de_xoa_xac_thuc "$NAME"; then
    CACHE_DIR_LOCAL="/usr/local/lsws/$NAME/luucache"
    [[ ! -d "$CACHE_DIR_LOCAL" ]] && CACHE_DIR_LOCAL="/usr/local/lsws/$NAME/lscache"

    if [[ -d "$CACHE_DIR_LOCAL" ]]; then
      TRASH_DIR="${CACHE_DIR_LOCAL}_trash_$(date +%s)_${RANDOM}"
      if mv -T -- "$CACHE_DIR_LOCAL" "$TRASH_DIR" 2>/dev/null; then
        (ionice -c 3 nice -n 19 rm -rf -- "${TRASH_DIR:?}") &
      fi
    fi
  fi

  if [[ -f "/etc/wptt/vhost/.${NAME}.conf" ]]; then
    mkdir -p /etc/wptt/vhost_bk
    mv -f "/etc/wptt/vhost/.${NAME}.conf" "/etc/wptt/vhost_bk/" 2>/dev/null || true
  fi

  _rundone "Cập nhật luật chuyển hướng thành công"
  wptt_smart_reload_lsws >/dev/null 2>&1 || true
  GOTO_FINISH="yes"
fi

# ------------------------------------------------------------------------------
# NHÁNH 2: TẠO VIRTUALHOST MỚI ĐỂ HỨNG CHUYỂN HƯỚNG
# ------------------------------------------------------------------------------
if [[ -z "$GOTO_FINISH" ]]; then
  # 1. Khởi tạo User Linux an toàn
  ((${#USER} > 30)) && USER="${USER:0:30}"

  user_created=0
  for attempt in 1 2 3; do
    wptt_heal_user_locks
    if useradd -m -d "/usr/local/lsws/$NAME" -s /sbin/nologin "$USER" >/dev/null 2>&1; then
      user_created=1
      break
    fi
    random_suffix=$(openssl rand -hex 2)
    base_name=$(echo "$NAME" | tr -d '[-._]' | tr '[:upper:]' '[:lower:]')
    USER="${base_name:0:25}_${random_suffix}"
    sleep 0.3
  done

  if ((user_created == 0)); then
    _runloi "Thêm domain chuyển hướng $NAME thất bại"
    echo -e "\n${C_RED}Lỗi: Hệ điều hành không thể tạo user mới!${C_RESET}"
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
    return 1 2>/dev/null || exit 1
  fi
  usermod -L "$USER" >/dev/null 2>&1

  # 2. Đọc RAM Native Zero-Fork
  TOTAL_RAM_MB=0
  while read -r m_name m_val _; do
    if [[ "$m_name" == "MemTotal:" ]]; then
      TOTAL_RAM_MB=$((m_val / 1024))
      break
    fi
  done </proc/meminfo
  ((TOTAL_RAM_MB == 0)) && TOTAL_RAM_MB=2048

  # 3. Giao dịch nguyên tử đăng ký Vhost vào httpd_config.conf
  ols_main_conf="/usr/local/lsws/conf/httpd_config.conf"
  tmp_httpd=$(wptt_atomic_begin "$ols_main_conf") || exit 1

  cat <<EOF >>"$tmp_httpd"
virtualhost $NAME {
vhRoot                  /usr/local/lsws/$NAME/
configFile              /usr/local/lsws/conf/vhosts/$NAME/$NAME.conf
allowSymbolLink         1
enableScript            1
restrained              1
maxKeepAliveReq         1000
setUIDMode              2
user                    $USER
group                   $USER
}
EOF

  # Map CẢ 2 Listener HTTP (80) VÀ HTTPS (443)
  sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS|ssl|SSL)[[:space:]]*\{/a \  map                     '"$NAME $NAME" "$tmp_httpd"
  wptt_atomic_commit "$tmp_httpd" "$ols_main_conf"

  # 4. Tạo thư mục và Vhost Config
  mkdir -p "/usr/local/lsws/conf/vhosts/$NAME"
  NAMEPHP="${NAME//[-._]/}"

  cat <<EOF >"/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
docRoot                   /usr/local/lsws/$NAME/html
vhDomain                  $NAME
enableGzip                1
cgroups                   0
index  {
  useServer               0
  indexFiles              index.html index.php
  autoIndex               0
}
scripthandler  {
  add                     lsapi:$NAMEPHP php
}
accessControl  {
  allow                   *
}
lsrecaptcha  {
  enabled                 1
  type                    0
}
namespace                 2
extprocessor $NAMEPHP {
  type                    lsapi
  address                 uds://tmp/lshttpd/$NAMEPHP.sock
  maxConns                30
  env                     PHP_LSAPI_CHILDREN=30
  env                     LSAPI_AVOID_FORK=200M
  initTimeout             60
  retryTimeout            0
  pcKeepAliveTimeout      5
  respBuffer              0
  autoStart               1
  path                    /usr/local/lsws/lsphp83/bin/lsphp
  backlog                 100
  instances               1
  extUser                 $USER
  extGroup                $USER
  runOnStartUp            2
  priority                0
  memSoftLimit            ${TOTAL_RAM_MB}M
  memHardLimit            ${TOTAL_RAM_MB}M
  procSoftLimit           400
  procHardLimit           400
}
context / {
  location                /usr/local/lsws/$NAME/html
  allowBrowse             1
  extraHeaders            <<<END_extraHeaders
X-XSS-Protection 1;mode=block
X-Frame-Options SAMEORIGIN
Referrer-Policy strict-origin-when-cross-origin
X-Content-Type-Options nosniff
X-Powered-By WPTangTocOLS
  END_extraHeaders
  rewrite  {
  }
  addDefaultCharset       off
  phpIniOverride  {
  }
}
rewrite  {
  enable                  1
  autoLoadHtaccess        1
  /usr/local/lsws/$NAME/html/.htaccess
}
vhssl  {
  keyFile                 /etc/wptt-ssl-tu-ky/$NAME/$NAME.key
  certFile                /etc/wptt-ssl-tu-ky/$NAME/cert.crt
  certChain               0
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
context /.well-known/acme-challenge {
  location                /usr/local/lsws/$NAME/html/.well-known/acme-challenge
  allowBrowse             1
  rewrite  {
    enable                0
  }
}
EOF

  # 5. Khởi tạo chứng chỉ SSL Tự ký cho Vhost
  mkdir -p "/etc/wptt-ssl-tu-ky/$NAME"
  openssl req -new -newkey rsa:2048 -nodes \
    -keyout "/etc/wptt-ssl-tu-ky/$NAME/$NAME.key" \
    -out "/etc/wptt-ssl-tu-ky/$NAME/$NAME.csr" \
    -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTangToc OLS/OU=IT/CN=$NAME/emailAddress=admin@$NAME" >/dev/null 2>&1
  openssl x509 -req -in "/etc/wptt-ssl-tu-ky/$NAME/$NAME.csr" \
    -signkey "/etc/wptt-ssl-tu-ky/$NAME/$NAME.key" \
    -out "/etc/wptt-ssl-tu-ky/$NAME/cert.crt" -days 3650 >/dev/null 2>&1

  # 6. Gán bản PHP hiện có trên hệ thống
  php_ver_chon=$(find /usr/local/lsws -mindepth 1 -maxdepth 1 -type d -name 'lsphp[0-9]*' -printf '%f\n' 2>/dev/null | sed -n 's/^lsphp\([0-9]\+\)$/\1/p' | sort -rn | head -n 1)
  [[ -z "$php_ver_chon" ]] && php_ver_chon="83"
  sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

  # 7. Phân quyền và tạo cấu trúc thư mục
  local group_litespeed="nobody"
  grep -qi "ubuntu" /etc/*release 2>/dev/null && group_litespeed="nogroup"
  chown -hR lsadm:"$group_litespeed" "/usr/local/lsws/conf/vhosts/$NAME"
  chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME"

  mkdir -p "/usr/local/lsws/$NAME/html/.well-known/acme-challenge" "/usr/local/lsws/$NAME/luucache"
  chmod 755 "/usr/local/lsws/$NAME" "/usr/local/lsws/$NAME/html"
  chown -hR "$USER:$USER" "/usr/local/lsws/$NAME/html"

  # 8. Tiêm file .htaccess chuyển hướng chuẩn
  cat <<EOF >"/usr/local/lsws/$NAME/html/.htaccess"
#begin-chuyen-huong-domain-wptangtoc
RewriteEngine On
RewriteCond %{HTTP_HOST} ^${NAME}$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.${NAME}$ [NC]
RewriteCond %{REQUEST_URI} !.*well-known.*$ [NC]
RewriteRule ^(.*)$ https://${NAME2www}${NAME2}/\$1 [L,R=301,NC]
#end-chuyen-huong-domain-wptangtoc
EOF
  chown "$USER:$USER" "/usr/local/lsws/$NAME/html/.htaccess"

  mkdir -p /etc/wptt/chuyen-huong
  touch "/etc/wptt/chuyen-huong/.${NAME}.conf"

  _rundone "Khởi tạo Virtual Host chuyển hướng thành công"
  wptt_smart_reload_lsws >/dev/null 2>&1 || true
fi

# ==============================================================================
# KIỂM TRA BẢN GHI DNS VÀ IN BÁO CÁO BO CONG
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT THIẾT LẬP CHUYỂN HƯỚNG TÊN MIỀN${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Tên miền Nguồn : ${C_YELLOW}$NAME${C_RESET}" 2
left_text "Chuyển hướng về : ${C_GREEN}https://${NAME2www}${NAME2}${C_RESET}" 2
left_text "Loại điều hướng : ${C_CYAN}301 Permanent Redirect${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# Kiểm tra DNS
checkdns=$(host "$NAME" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
[[ -z "$checkdns" ]] && checkdns=$(nslookup "$NAME" 2>/dev/null | awk '/Address: / {print $2}' | tail -n 1)

ip=$(curl -sf --connect-timeout 2 --max-time 4 https://ipv4.icanhazip.com 2>/dev/null || curl -sf --connect-timeout 2 --max-time 4 https://checkip.amazonaws.com 2>/dev/null || true)

if [[ -n "$ip" && "$checkdns" != "$ip" ]]; then
  echo -e "${C_YELLOW}CHÚ Ý QUAN TRỌNG VỀ DNS:${C_RESET}"
  if [[ -z "$checkdns" ]]; then
    echo -e "Tên miền ${C_BOLD_WHITE}$NAME${C_RESET} hiện chưa được trỏ IP."
    echo -e "Vui lòng trỏ bản ghi A về IP: ${C_GREEN}$ip${C_RESET} để luật chuyển hướng hoạt động."
  else
    echo -e "Tên miền ${C_BOLD_WHITE}$NAME${C_RESET} đang trỏ đến IP: $checkdns"
    echo -e "Hãy đổi lại bản ghi A về IP máy chủ hiện tại: ${C_GREEN}$ip${C_RESET}"
  fi
  echo ""
fi

if [[ "${1:-}" == "98" ]]; then
  echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
  read -r _
  exec /etc/wptt/wptt-domain-main 1
fi
