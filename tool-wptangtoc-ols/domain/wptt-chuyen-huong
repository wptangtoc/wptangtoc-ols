function huong_dan() {
  cat <<'EOF'
  Tính năng Chuyển hướng domain [Domain Redirection] là một kỹ thuật tự động điều hướng người dùng và các công cụ tìm kiếm từ một địa chỉ tên miền này sang một địa chỉ tên miền khác.

  Nói một cách đơn giản, khi ai đó gõ vào hoặc nhấp vào một tên miền A, thay vì hiển thị nội dung của tên miền A, trình duyệt của họ sẽ tự động được chuyển đến tên miền B [hoặc một trang cụ thể trên tên miền B].

  Mục Đích Chính
  * Trỏ nhiều tên miền về một website: Nếu bạn sở hữu nhiều biến thể tên miền [ví dụ: tencongty.com, tencongty.vn, ten-cong-ty.com], bạn có thể chuyển hướng tất cả chúng về một tên miền chính duy nhất.
  * Sau khi đổi tên miền website: Chuyển hướng từ tên miền cũ sang tên miền mới để không mất khách truy cập và duy trì giá trị SEO.
  * Chuyển hướng tên miền phụ [subdomain]: Ví dụ, chuyển blog.tenmien.com sang blog-tenmien.com.
  * URL thân thiện/Rút gọn link: Tạo các đường link ngắn, dễ nhớ để chuyển hướng đến các URL dài hơn, phức tạp hơn.
  * Thông báo bảo trì website: Tạm thời chuyển hướng người dùng đến một trang thông báo khi website đang được bảo trì.

  Tính năng chuyển hướng domain rất quan trọng để quản lý truy cập, đảm bảo trải nghiệm người dùng tốt và duy trì hiệu quả SEO cho website của bạn.
EOF
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện UI Xác nhận

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_domain} ➜ ${chuyen_huong_domain}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

wptt_check_lsws "${1:-}"

NAME=$1
NAME2=$2
[[ "$NAME" == "98" ]] && NAME=""

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
stty iutf8

# ==============================================================================
# BƯỚC 1: NHẬP VÀ KIỂM TRA DOMAIN GỐC (NGUỒN)
# ==============================================================================
if [[ -z "$NAME" ]]; then
  echo -e "${C_YELLOW}Nhập domain bạn muốn chuyển hướng đi (Ví dụ: cu.com, old.vn)${C_RESET}"
  echo -en "${C_CYAN}Tên miền Nguồn [0=${exit_thoat:-Thoát}]: ${C_RESET}"
  read -r NAME
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  wptt_quay_ve_menu "${1:-}" 0
}

NAME="${NAME,,}" # biến viết hoa thành viết thuờng

if [[ "$NAME" == *"://"* ]]; then
  NAME=$(echo "$NAME" | cut -f3 -d '/')
fi

if [[ "$NAME" == www.* ]]; then
  NAME="${NAME#www.}" #loại bỏ www. ở đầu
fi

# BỘ LỌC VỆ SINH BIẾN ĐẦU VÀO (CHỐNG LỖI WINDOWS CLIPBOARD)
NAME="${NAME//$'\r'/}"       # Lọc tận gốc ký tự CRLF (Windows)
NAME="${NAME// /}"           # Xóa toàn bộ khoảng trắng thừa
NAME="${NAME//[[:space:]]/}" # Xóa các ký tự Tab hoặc khoảng trắng đặc biệt khác

if [ "$(echo "$NAME" | wc -w)" -gt 1 ] || [[ "$NAME" == "${NAME/./}" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Domain $NAME nhập không đúng định dạng (có khoảng trắng hoặc thiếu dấu chấm)!${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

if [[ ! "$NAME" =~ ^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z]{2,}$ ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Domain $NAME chứa ký tự không hợp lệ hoặc sai cấu trúc.${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

# ==============================================================================
# BƯỚC 2: NHẬP VÀ KIỂM TRA DOMAIN ĐÍCH
# ==============================================================================
echo ""
if [[ -z "$NAME2" ]]; then
  echo -e "${C_YELLOW}Nhập domain bạn muốn chuyển hướng tới (Ví dụ: moi.com, www.moi.vn)${C_RESET}"
  echo -en "${C_CYAN}Tên miền Đích [0=${exit_thoat:-Thoát}]: ${C_RESET}"
  read -r NAME2
fi

[[ "$NAME2" == "0" || -z "$NAME2" ]] && {
  wptt_quay_ve_menu "${1:-}" 1
}

NAME2=$(echo "$NAME2" | tr '[:upper:]' '[:lower:]' | xargs)

if [[ "$NAME2" == *"://"* ]]; then
  NAME2=$(echo "$NAME2" | cut -f3 -d '/')
fi

# BỘ LỌC VỆ SINH BIẾN ĐẦU VÀO (CHỐNG LỖI WINDOWS CLIPBOARD)
NAME2="${NAME2//$'\r'/}"       # Lọc tận gốc ký tự CRLF (Windows)
NAME2="${NAME2// /}"           # Xóa toàn bộ khoảng trắng thừa
NAME2="${NAME2//[[:space:]]/}" # Xóa các ký tự Tab hoặc khoảng trắng đặc biệt khác

NAME2www=""

if [[ "$NAME2" == www.* ]]; then
  NAME2="${NAME2#www.}" #loại bỏ www. ở đầu
  NAME2www='www.'
fi

if [[ ! "$NAME2" =~ ^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z]{2,}$ ]]; then
  echo -e "\n${C_RED}Lỗi: Domain Đích chứa ký tự không hợp lệ hoặc sai cấu trúc.${C_RESET}"
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

if [[ "$NAME" == "$NAME2" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: Bạn không thể chuyển hướng vòng lặp từ $NAME sang chính nó!${C_RESET}"
  sleep 3
  wptt_quay_ve_menu "${1:-}" 1 "enter"
fi

wptt_check_lsws "${1:-}"

# ==============================================================================
# BƯỚC 3: KIỂM TRA TRẠNG THÁI VÀ XÁC NHẬN GHI ĐÈ
# ==============================================================================
path="/etc/wptt/vhost/.$NAME.conf"
pathcheck_chuyen_huong="/etc/wptt/chuyen-huong/.$NAME.conf"
USER=${NAME//[-._]/}

if [[ -f "$pathcheck_chuyen_huong" ]]; then
  current_target=$(sed '/^#begin-chuyen-huong-domain-wptangtoc/,/^#end-chuyen-huong-domain-wptangtoc$/!d' "/usr/local/lsws/$NAME/html/.htaccess" | grep '301' | grep -o -E '([a-zA-Z0-9-]+\.)+[a-zA-Z0-9-]{2,}' | tail -n 1)

  echo -e "\n${C_YELLOW}CHÚ Ý: Domain ${C_BOLD_WHITE}$NAME${C_YELLOW} ĐÃ ĐƯỢC CHUYỂN HƯỚNG TRƯỚC ĐÓ!${C_RESET}"
  echo -e "Đang chuyển hướng tới: ${C_CYAN}${current_target:-Không xác định}${C_RESET}\n"

  if ! wptt_xac_nhan "Bạn có muốn XÓA thiết lập cũ và tạo chuyển hướng MỚI sang $NAME2 không?" "" "" "Đồng ý Ghi đè" "Hủy bỏ"; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}"
    sleep 2
    wptt_quay_ve_menu "${1:-}" 1
  fi
fi

# ==============================================================================
# HÀM THAY THẾ WEBSITE CHÍNH (NẾU CẦN)
# ==============================================================================
function thay_name_domain_chinh() {
  local NAME_OLD=$1
  local NAME_NEW=$2

  wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "Website_chinh=$NAME_NEW"
  ols_conf="/usr/local/lsws/conf/httpd_config.conf"
  tmp_ols=$(wptt_atomic_begin "$ols_conf")

  sed -i "/keyFile/d" "$tmp_ols"
  sed -i "/certFile/d" "$tmp_ols"
  sed -i "/CACertFile/d" "$tmp_ols"

  if [[ ! -f /etc/wptt-ssl-tu-ky/${NAME_NEW}/${NAME_NEW}.key ]]; then #tính toán tình huống dự phòng giả sử người dùng xóa mất ssl tự ký đi thì không thể có port đại diện được
    ssl_dir="/etc/wptt-ssl-tu-ky/$NAME_NEW"
    key_file="$ssl_dir/$NAME_NEW.key"
    crt_file="$ssl_dir/cert.crt"
    mkdir -p "$ssl_dir"
    if /usr/bin/openssl req -x509 -nodes -days 3650 \
      -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
      -keyout "$key_file" \
      -out "$crt_file" \
      -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTT/CN=$NAME_NEW" \
      -addext "subjectAltName=DNS:$NAME_NEW,DNS:*.$NAME_NEW" \
      >/dev/null 2>&1; then

      /bin/chmod 600 -- "$key_file"
      /bin/chmod 644 -- "$crt_file"
    fi
  fi

  sed -i "/https/a keyFile              \/etc\/wptt-ssl-tu-ky\/$NAME_NEW\/$NAME_NEW.key" "$tmp_ols"
  sed -i "/https/a certFile             \/etc\/wptt-ssl-tu-ky\/$NAME_NEW\/cert.crt" "$tmp_ols"

  wptt_atomic_commit "$tmp_ols" "$ols_conf"

  if [[ -n "$id_dang_nhap_phpmyadmin" ]]; then
    cp -rf "/usr/local/lsws/$NAME_OLD/html/phpmyadmin" "/usr/local/lsws/$NAME_NEW/html/"
    rm -rf "/usr/local/lsws/${NAME_OLD:?}/html/phpmyadmin"
    mkdir -p "/usr/local/lsws/$NAME_NEW/passwd"
    cp -f "/usr/local/lsws/$NAME_OLD/passwd/.phpmyadmin" "/usr/local/lsws/$NAME_NEW/passwd"

    if grep -q "Ubuntu" /etc/*release 2>/dev/null; then tuong_thich_nhom_litespeed="nogroup"; else tuong_thich_nhom_litespeed="nobody"; fi
    chown -hR nobody:$tuong_thich_nhom_litespeed "/usr/local/lsws/$NAME_NEW/passwd"

    sed -i -e '/^realm '"${NAME_OLD}"'phpphpmyadmin/,/^}$/d' "/usr/local/lsws/conf/vhosts/$NAME_OLD/$NAME_OLD.conf"
    sed -i -e '/^context \/phpmyadmin\//,/^}$/d' "/usr/local/lsws/conf/vhosts/$NAME_OLD/$NAME_OLD.conf"

    echo 'realm '"${NAME_NEW}"phpphpmyadmin' {
        userDB  {
        location              /usr/local/lsws/'"$NAME_NEW"'/passwd/.phpmyadmin
    }
}
context /phpmyadmin/ {
location                phpmyadmin/
allowBrowse             1
realm                   '"${NAME_NEW}"phpphpmyadmin'

accessControl  {
allow                 ALL
}

rewrite  {

}
addDefaultCharset     off

phpIniOverride  {

}
}' >>"/usr/local/lsws/conf/vhosts/$NAME_NEW/$NAME_NEW.conf"
  fi
}

# Xử lý Logic Đổi Website Chính bằng UX Bo Cong
if [[ "$Website_chinh" == "$NAME" ]]; then
  if [[ -d "/usr/local/lsws/$NAME2/html" ]]; then
    thay_name_domain_chinh "$NAME" "$NAME2"
  else
    if (("$(ls -At /etc/wptt/vhost 2>/dev/null | wc -l)" >= 2)) && [[ "${1:-}" == "98" ]]; then
      echo -e "\n${C_YELLOW}CẢNH BÁO: Tên miền bạn đang chuyển hướng ($NAME) hiện đang là WEBSITE CHÍNH (Đại diện) của hệ thống!${C_RESET}"
      echo -e "Bạn cần phải chọn một tên miền KHÁC đang tồn tại để thay thế làm Website Chính."

      box_inner_width=${box_inner_width:-71}
      selects=()

      for filepath in /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
        NAME_CHINH_OPTION="${filepath##*/}"            #cắt hết / ở phía truớc chỉ dữ giá trị / ở sau còn dữ lại như: .wptangtoc.com.conf
        NAME_CHINH_OPTION="${NAME_CHINH_OPTION%.conf}" #cắt .conf ở phía sau => còn: .wptangtoc.com
        NAME_CHINH_OPTION="${NAME_CHINH_OPTION#.}"     #cắt . ở phía truớc => còn wptangtoc.com
        if [[ "$NAME_CHINH_OPTION" == ?*.?* && "$NAME_CHINH_OPTION" != "$Website_chinh" ]]; then
          selects+=("$NAME_CHINH_OPTION")
        fi
      done

      if [[ ${#selects[@]} -eq 0 ]]; then
        echo -e "\n${C_RED}Hệ thống không còn website nào khác để gán làm Website chính!${C_RESET}"
        echo -e "Vui lòng thêm một website mới trước khi chuyển hướng website chính hiện tại."
        wptt_quay_ve_menu "${1:-}" 0 "enter"
      fi

      echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_YELLOW}CHỌN DOMAIN LÀM WEBSITE CHÍNH MỚI${C_RESET}"
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      i=1
      for domain in "${selects[@]}"; do
        # 2. Gán giá trị an toàn (Không kẹp chung với local)
        item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain")
        clean_text=$(printf "  %3d) %s" "$i" "$domain")

        # 3. Tuyệt chiêu nội tại: Đếm độ dài chuỗi bằng O(1) không tốn CPU
        item_len=${#clean_text}

        pad=$((box_inner_width - item_len))
        [[ $pad -lt 0 ]] && pad=0

        echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
        ((i++))
      done
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

      while true; do
        echo -en "${C_CYAN}Nhập lựa chọn (1-${#selects[@]}) [0=Hủy bỏ]: ${C_RESET}"
        read -r REPLY
        if [[ "$REPLY" == "0" ]]; then
          wptt_quay_ve_menu "${1:-}" 0
        fi
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
          action_index=$((REPLY - 1))
          NAME_CHINH_OPTION="${selects[$action_index]}"
          break
        else
          echo -e "${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
      done
      thay_name_domain_chinh "$NAME" "$NAME_CHINH_OPTION"
    fi
  fi
fi

wptt_logs "INFO" "Chuyển hướng website $NAME về website $NAME2 "

# ==============================================================================
# NHÁNH 1: WEBSITE ĐÃ TỒN TẠI (CHỈ CẦN TIÊM HTACCESS)
# ==============================================================================
echo ""
_runing "Đang thiết lập chuyển hướng $NAME sang $NAME2..."

if [[ -d "/usr/local/lsws/$NAME/html" ]]; then
  if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
    . "/etc/wptt/vhost/.$NAME.conf"
    if [[ -n "$vhost_chuyen_htaccess" ]]; then
      . /etc/wptt/wptt-vhost-chuyen-ve-htaccess "$NAME" >/dev/null 2>&1
    fi
  fi

  echo '
#begin-chuyen-huong-domain-wptangtoc
RewriteEngine On
RewriteCond %{HTTP_HOST} ^'"$NAME"' [NC,OR]
RewriteCond %{HTTP_HOST} ^www.'"$NAME"' [NC]
RewriteCond %{REQUEST_URI} !.*well-known.*$ [NC]
RewriteRule (.*)$ https://'$NAME2www''"$NAME2"'/$1 [L, R=301,NC]
#end-chuyen-huong-domain-wptangtoc
' >"/usr/local/lsws/$NAME/html/.htaccess"

  mkdir -p /etc/wptt/chuyen-huong
  echo "" >"/etc/wptt/chuyen-huong/.$NAME.conf"

  if wptt_kha_dung_de_xoa_xac_thuc "$NAME"; then
    CACHE_DIR_LOCAL="/usr/local/lsws/$NAME/lscache"
    if [[ -n "$NAME" && -d "$CACHE_DIR_LOCAL" ]]; then
      TRASH_DIR="${CACHE_DIR_LOCAL}_trash_$(date +%s)_${RANDOM}"

      if mv -T -- "$CACHE_DIR_LOCAL" "$TRASH_DIR" 2>/dev/null; then
        (
          ionice -c 3 nice -n 19 rm -rf -- "${TRASH_DIR:?}"
        ) &
      fi
    fi
  fi

  if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
    mkdir -p /etc/wptt/vhost_bk
    mv "/etc/wptt/vhost/.$NAME.conf" /etc/wptt/vhost_bk/
  fi

  _rundone "Cập nhật luật chuyển hướng thành công"
  wptt_smart_reload_lsws >/dev/null 2>&1

  # Bỏ qua Nhánh 2 bằng cách nhảy xuống cuối cùng
  GOTO_FINISH="yes"
fi

# ==============================================================================
# NHÁNH 2: TẠO VHOST MỚI ĐỂ HỨNG CHUYỂN HƯỚNG
# ==============================================================================
if [[ -z "$GOTO_FINISH" ]]; then
  wptt_heal_user_locks() {
    local lock_files=(
      "/etc/passwd.lock"
      "/etc/shadow.lock"
      "/etc/group.lock"
      "/etc/gshadow.lock"
      "/etc/subuid.lock"
      "/etc/subgid.lock"
    )

    # 1. Kiểm tra nhanh: Nếu hệ thống hoàn toàn không có lock nào thì thoát ngay (0ms)
    local has_any_lock=0
    for lock in "${lock_files[@]}"; do
      if [[ -f "$lock" ]]; then
        has_any_lock=1
        break
      fi
    done
    ((has_any_lock == 0)) && return 0

    # Nhóm các tiến trình quản lý user của Linux
    local proc_regex="^(useradd|usermod|userdel|groupadd|groupdel|chage|passwd|vipw|pwck)$"
    local btime=0
    btime=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null || echo 0)

    for lock in "${lock_files[@]}"; do
      [[ -f "$lock" ]] || continue

      local lock_mtime=0
      lock_mtime=$(stat -c %Y "$lock" 2>/dev/null || echo 0)

      # TRƯỜNG HỢP 1: Lock sinh ra TRƯỚC khi máy chủ bật (Chắc chắn do sập nguồn/mất điện)
      if ((btime > 0 && lock_mtime < btime)); then
        /bin/rm -f -- "$lock" 2>/dev/null || true
        wptt_logs "WARN" "Đã dọn lock mồ côi do sập nguồn: $lock" 2>/dev/null || true
        continue
      fi

      # TRƯỜNG HỢP 2: Có file lock trong phiên làm việc hiện tại
      if pgrep -x "$proc_regex" >/dev/null 2>&1; then
        # CÓ TIẾN TRÌNH ĐANG CHẠY (Terminal khác đang tạo user song song):
        # Tuyệt đối KHÔNG xóa! Nhường quyền và chờ tối đa 3 giây (mỗi nhịp 0.2s)
        local wait_count=0
        while pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]] && ((wait_count < 15)); do
          sleep 0.2
          ((wait_count++))
        done

        # Sau khi chờ: nếu tiến trình kia chết ngang mà để sót lại lock (ví dụ vừa bị ngắt kết nối SSH)
        if ! pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]]; then
          /bin/rm -f -- "$lock" 2>/dev/null || true
          wptt_logs "WARN" "Đã dọn lock mồ côi sau khi tiến trình terminal kia bị ngắt: $lock" 2>/dev/null || true
        fi
      else
        # KHÔNG CÓ TIẾN TRÌNH NÀO SỞ HỮU (Lock mồ côi do tắt SSH trước đó):
        # Kiểm tra xác nhận 2 nhịp (đệm 0.3s) để loại trừ race condition
        sleep 0.3
        if ! pgrep -x "$proc_regex" >/dev/null 2>&1 && [[ -f "$lock" ]]; then
          /bin/rm -f -- "$lock" 2>/dev/null || true
          wptt_logs "WARN" "Đã dọn lock mồ côi: $lock (Không có tiến trình chạy)" 2>/dev/null || true
        fi
      fi
    done

    return 0
  }

  # Giới hạn tên user chuẩn Linux (Max 32 ký tự)
  check_ky_tu=${#USER}
  if ((check_ky_tu > 32)); then USER="${USER:0:30}"; fi

  user_created=0

  # Thử tối đa 3 lần để tự nhường nhịp cho Terminal khác
  for attempt in 1 2 3; do
    # 1. Dọn lock mồ côi hoặc chờ Terminal kia tạo xong
    wptt_heal_user_locks

    # 2. Thực thi tạo User
    if useradd -m -d "/usr/local/lsws/$NAME" -s /sbin/nologin "$USER" >/dev/null 2>&1; then
      user_created=1
      break
    fi

    # 3. Nếu thất bại ở lần 1 (do trùng tên user hoặc đụng đúng mili-giây với Terminal kia):
    # Tái tạo tên user với hậu tố ngẫu nhiên để tránh xung đột định danh
    random_suffix=$(openssl rand -hex 2)
    base_name=$(echo "$NAME" | tr -d '[-._]' | tr '[:upper:]' '[:lower:]')
    USER="${base_name:0:27}_${random_suffix}"

    sleep 0.3
  done

  # Chốt chặn kiểm định cuối cùng
  if ((user_created == 0)); then
    _runloi "${them:-Thêm} domain $NAME ${vao_he_thong:-vào hệ thống}"
    echo -e "\n${C_RED}Lỗi: Hệ điều hành không thể tạo user mới sau 3 lần thử!${C_RESET}"
    wptt_logs "ERROR" "Không thể khởi tạo user cho website $NAME (Đã xử lý lock đa terminal)" 2>/dev/null || true

    wptt_quay_ve_menu "${1:-}" 1 "enter"
  fi

  # Khóa password để vô hiệu hóa login trực tiếp qua SSH
  usermod -L "$USER" >/dev/null 2>&1

  work_cpucore='1024'
  cpucore=$(grep -c ^processor /proc/cpuinfo)
  max_client=$((work_cpucore * cpucore * 2))
  tong_ram_byte=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  rong_ram_mb=$(echo "scale=0;${tong_ram_byte}/1024" | bc)
  [[ -z "$rong_ram_mb" ]] && rong_ram_mb="2048"

  tmp_conf_httpd=$(mktemp -p "/etc/wptt/tmp" httpd_config.XXXXXX) || exit 1
  /bin/cp -fp "/usr/local/lsws/conf/httpd_config.conf" "$tmp_conf_httpd"
  echo "virtualhost $NAME {
vhRoot                  /usr/local/lsws/$NAME/
configFile              /usr/local/lsws/conf/vhosts/$NAME/$NAME.conf
allowSymbolLink         1
enableScript            1
restrained              1
maxKeepAliveReq         1000
setUIDMode              2
user                    $USER
group                   $USER
}" >>"$tmp_conf_httpd"

  sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS)[[:space:]]*\{/a \  map                     '"$NAME $NAME" "$tmp_conf_httpd"

  # 1. Escape dấu chấm để Regex không bắt nhầm ký tự bất kỳ
  NAME_ESC="${NAME//./\\.}" #chuyển ví dụ: wptangtoc.com thành wptangtoc\.com để tránh bị sed nhầm nhiều khi sed . nó ký tự tất cả 1 ký tự giả sử
  # 2. BƯỚC 1 (LŨY ĐẲNG): Quét sạch mọi dòng map cũ của chính VHost này
  sed -i -E "/^[[:space:]]*map[[:space:]]+${NAME_ESC}[[:space:]]+(.*[[:space:],])?${NAME_ESC}([[:space:],]|$)/d" "$tmp_conf_httpd"
  # 3. BƯỚC 2: Bơm dòng map mới chuẩn xác vào cả 2 Listener HTTP (80) và HTTPS (443)
  sed -i -E '/^[[:space:]]*listener[[:space:]]+(http|https|HTTP|HTTPS)[[:space:]]*\{/a \  map                     '"$NAME $NAME" "$tmp_conf_httpd"

  /bin/mv -fT "$tmp_conf_httpd" "/usr/local/lsws/conf/httpd_config.conf"

  mkdir -p "/usr/local/lsws/conf/vhosts/$NAME/"
  touch "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
  chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME" #chmod luôn là file rỗng trước khi có giá trị

  # Mặc định OLS sẽ dùng Namespace 2 (Cách ly an toàn nhất) cho máy vật lý / KVM
  lsapi_namespace="2"

  virt_type=$(systemd-detect-virt 2>/dev/null || echo "unknown")
  # Nếu rơi vào các môi trường ảo hóa dùng chung Kernel (1 phần) -> Ép về Namespace 1
  # namespace 2 là bật và 1 là tắt
  if [[ "$virt_type" =~ ^(lxc|lxd|openvz|docker|container|wsl)$ || -f /proc/user_beancounters || "${GITHUB_ACTIONS:-}" == "true" || "${CI:-}" == "true" ]]; then
    lsapi_namespace="1"
  fi
  #anh em ảo hóa giá rẻ 1 phần không hỗ trợ namespace

  NAMEPHP=${NAME//[-._]/}

  echo "docRoot                   /usr/local/lsws/$NAME/html
  vhDomain                  $NAME
  enableGzip                1
  cgroups                   0
  index  {
    useServer               0
    indexFiles              index.php, index.html
    autoIndex               0
  }
  scripthandler  {
    add                     lsapi:$NAMEPHP php
  }
  accessControl  {
    allow                   *
  }
  lsrecaptcha  {
    enabled                 1
    type                    0
  }
  namespace                 ${lsapi_namespace:-2}
  extprocessor $NAMEPHP {
    type                    lsapi
    address                 uds://tmp/lshttpd/$NAMEPHP.sock
    maxConns                30
    env                     PHP_LSAPI_CHILDREN=30
    env                     LSAPI_AVOID_FORK=200M
    initTimeout             60
    retryTimeout            0
    pcKeepAliveTimeout      5
    respBuffer              0
    autoStart               1
    path                    /usr/local/lsws/lsphp83/bin/lsphp
    backlog                 100
    instances               1
    extUser                 $USER
    extGroup                $USER
    runOnStartUp            2
    priority                0
    memSoftLimit            ${rong_ram_mb}M
    memHardLimit            ${rong_ram_mb}M
    procSoftLimit           $max_client
    procHardLimit           $max_client
  }
  context / {
    location                /usr/local/lsws/$NAME/html
    allowBrowse             1
    extraHeaders            <<<END_extraHeaders
X-XSS-Protection 1;mode=block
X-Frame-Options SAMEORIGIN
Referrer-Policy strict-origin-when-cross-origin
X-Content-Type-Options nosniff
X-Powered-By WPTangTocOLS
permissions-policy accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
    END_extraHeaders
    rewrite  {
    }
    addDefaultCharset       off
    phpIniOverride  {
    }
  }
  rewrite  {
    enable                  1
    autoLoadHtaccess        1
  /usr/local/lsws/$NAME/html/.htaccess
  }
  vhssl  {
    keyFile                 /etc/wptt-ssl-tu-ky/$NAME/$NAME.key
    certFile                /etc/wptt-ssl-tu-ky/$NAME/cert.crt
    certChain               0
    sslProtocol             24
    renegProtection         1
    sslSessionCache         1
    sslSessionTickets       1
    enableSpdy              15
    enableQuic              1
  }
  module cache {
  checkPrivateCache   1
  checkPublicCache    1
  maxCacheObjSize     10000000
  maxStaleAge         200
  qsCache             1
  reqCookieCache      1
  respCookieCache     1
  ignoreReqCacheCtrl  1
  ignoreRespCacheCtrl 0
  storagePath /usr/local/lsws/$NAME/luucache
  enableCache         0
  expireInSeconds     3600
  enablePrivateCache  0
  privateExpireInSeconds 3600
    ls_enabled              1
  }
  context /.well-known/acme-challenge {
    location                /usr/local/lsws/$NAME/html/.well-known/acme-challenge
    allowBrowse             1
    rewrite  {
        enable                  0
    }
    addDefaultCharset       off
    phpIniOverride  {
    }
  }
  " >"/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

  hostname_custom=$(cat "/usr/local/lsws/conf/vhosts/$Website_chinh/$Website_chinh.conf" 2>/dev/null | grep 'X-Powered-By' | cut -f2 -d ' ' | sort -u)
  if [[ -z "$hostname_custom" || "$hostname_custom" != 'WPTangTocOLS' ]]; then
    sed -i '/X-Powered-By/d' "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
  fi
  if [[ "$hostname_custom" != 'WPTangTocOLS' && -n "$hostname_custom" ]]; then
    sed -i "/extraHeaders /a X-Powered-By $hostname_custom" "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
  fi
  unset hostname_custom

  # Khởi tạo SSL Tự ký (Hứng Request)
  ssl_dir="/etc/wptt-ssl-tu-ky/$NAME"
  key_file="$ssl_dir/$NAME.key"
  crt_file="$ssl_dir/cert.crt"
  mkdir -p "$ssl_dir"
  if /usr/bin/openssl req -x509 -nodes -days 3650 \
    -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -keyout "$key_file" \
    -out "$crt_file" \
    -addext "subjectAltName=DNS:$NAME,DNS:*.$NAME" \
    -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTT/CN=$NAME" \
    >/dev/null 2>&1; then

    /bin/chmod 600 -- "$key_file"
    /bin/chmod 644 -- "$crt_file"
  fi

  if grep -q "Ubuntu" /etc/*release 2>/dev/null; then tuong_thich_nhom_litespeed="nogroup"; else tuong_thich_nhom_litespeed="nobody"; fi

  chown -hR lsadm:$tuong_thich_nhom_litespeed "/usr/local/lsws/conf/vhosts/$NAME"

  php_ver_chon=${php_version_check//[-._]/} #chuyển đổi lấy cấu hình trong /etc/wptt/.wptt.conf php_version_check giá trị biến môi truờng phiên bản PHP
  # Cập nhật PHP mặc định

  # Xử lý 2 rủi ro: Biến bị rỗng HOẶC Thư mục bản PHP đó không tồn tại (bị xóa)
  if [[ -z "$php_ver_chon" || ! -d "/usr/local/lsws/lsphp${php_ver_chon}" ]]; then #xử lý tình huống nếu phiên bản php đó không tồn tại nguời dùng nỡ tay xoá mặc định nó đi rồi sẽ tự động chọn phiên bản php mới nhất có trong hệ thống
    php_ver_chon=$(ls -d /usr/local/lsws/lsphp[0-9]* 2>/dev/null | grep -Eo '[0-9]+$' | sort -rn | head -n 1)
  fi

  if [[ -z "$php_ver_chon" ]]; then
    # Chốt chặn cuối: Nếu rà quét xong vẫn rỗng (máy chủ lỗi mất sạch PHP), ép về mặc định 83 để cứu file config
    php_ver_chon="83"
  fi

  # sed -E -i "s/lsphp[0-9]+/lsphp$php_ver_chon/g" "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
  sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

  if grep -q -i "ubuntu" /etc/os-release 2>/dev/null; then
    tuong_thich_nhom_litespeed="nogroup"
  else
    tuong_thich_nhom_litespeed="nobody"
  fi
  chown -hR lsadm:"$tuong_thich_nhom_litespeed" "/usr/local/lsws/conf/vhosts/$NAME"
  chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME"
  mkdir -p "/usr/local/lsws/$NAME/html"
  mkdir -p "/usr/local/lsws/$NAME/html/.well-known/acme-challenge"
  mkdir -p "/usr/local/lsws/$NAME/luucache"
  chmod 755 "/usr/local/lsws/$NAME"
  chmod 755 "/usr/local/lsws/$NAME/html"

  useradd -m -d "/usr/local/lsws/$NAME" -s /sbin/nologin "$USER" >/dev/null 2>&1
  usermod -L "$USER" >/dev/null 2>&1
  chown -hR "$USER:$USER" "/usr/local/lsws/$NAME/html"

  # Tiêm Htaccess
  echo '
#begin-chuyen-huong-domain-wptangtoc
RewriteEngine On
RewriteCond %{HTTP_HOST} ^'"$NAME"' [NC,OR]
RewriteCond %{HTTP_HOST} ^www.'"$NAME"' [NC]
RewriteCond %{REQUEST_URI} !.*well-known.*$ [NC]
RewriteRule (.*)$ https://'$NAME2www''"$NAME2"'/$1 [L, R=301,NC]
#end-chuyen-huong-domain-wptangtoc
' >"/usr/local/lsws/$NAME/html/.htaccess"

  mkdir -p /etc/wptt/chuyen-huong
  touch "/etc/wptt/chuyen-huong/.$NAME.conf"

  _rundone "Khởi tạo Virtual Host phụ thành công"
  wptt_smart_reload_lsws >/dev/null 2>&1
fi

# ==============================================================================
# KIỂM TRA DNS VÀ IN BÁO CÁO BO CONG
# ==============================================================================
echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT CHUYỂN HƯỚNG TÊN MIỀN (301 REDIRECT)${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Tên miền gốc  : ${C_YELLOW}$NAME${C_RESET}" 2
left_text "Chuyển hướng  : ${C_GREEN}$NAME2www$NAME2${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# Kiểm tra DNS
checkdns=$(host "$NAME" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
if [[ -z "$checkdns" ]]; then
  checkdns=$(nslookup "$NAME" 2>/dev/null | grep Address | cut -f5 | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
fi

ip=$(curl -skf --connect-timeout 5 --max-time 10 https://ipv4.icanhazip.com || curl -skf --connect-timeout 5 --max-time 10 https://checkip.amazonaws.com | grep -E -o '([0-9]{1,3}\.){3}[0-9]{1,3}')

if [[ "$checkdns" != "$ip" ]]; then
  echo -e "${C_YELLOW}CHÚ Ý QUAN TRỌNG VỀ DNS:${C_RESET}"
  if [[ -z "$checkdns" ]]; then
    echo -e "Tên miền ${C_BOLD_WHITE}$NAME${C_RESET} hiện chưa được trỏ IP."
    echo -e "Bạn vui lòng trỏ bản ghi A về IP: ${C_GREEN}$ip${C_RESET} để luật chuyển hướng hoạt động."
  else
    echo -e "Tên miền ${C_BOLD_WHITE}$NAME${C_RESET} đang trỏ đến IP: $checkdns"
    echo -e "Hãy đổi lại bản ghi A về IP máy chủ hiện tại: ${C_GREEN}$ip${C_RESET}"
  fi
  echo ""
fi

wptt_quay_ve_menu "${1:-}" 0
