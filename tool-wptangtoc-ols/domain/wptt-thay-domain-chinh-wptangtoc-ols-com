#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026 - Template First-Run
# shellcheck disable=SC1090,SC1091

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
stty iutf8 2>/dev/null || true

# Nạp cấu hình WPTT và các hàm tiện ích
. /etc/wptt/.wptt.conf 2>/dev/null || true
. /etc/wptt/core-functions 2>/dev/null || true

# Chỉ chạy khi domain chính vẫn đang ở trạng thái template mặc định
if [[ "${Website_chinh:-}" != 'wptangtoc-ols.com' ]]; then
  return 2>/dev/null || exit 0
fi

# ==============================================================================
# 1. ĐỒNG BỘ PHIÊN BẢN VÀ CẬP NHẬT GPG TỰ ĐỘNG
# ==============================================================================
version_wptangtoc_ols=$(cat /etc/wptt/tmp/wptangtoc-ols-version-main 2>/dev/null || echo "")
wptangtocols_version=$(curl --tlsv1.3 -s --connect-timeout 10 --max-time 30 https://wptangtoc.com/share/version-wptangtoc-ols.txt 2>/dev/null | head -1 | grep '\.' || true)
if [[ -z "$wptangtocols_version" ]]; then
  wptangtocols_version=$(curl --tlsv1.2 -s --connect-timeout 10 --max-time 30 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt 2>/dev/null | head -1 | grep '\.' || true)
fi

if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then
  . /etc/wptt/wptt-update2 2>/dev/null || true
  echo "$wptangtocols_version" >/etc/wptt/tmp/wptangtoc-ols-version 2>/dev/null || true

  curl --tlsv1.3 -sO https://wptangtoc.com/share/update --connect-timeout 10 --max-time 30 2>/dev/null || true
  curl --tlsv1.3 -sO https://hub.wptangtoc.com/update.sig --connect-timeout 10 --max-time 30 -A "checksum wptangtoc ols" 2>/dev/null || true

  if [[ ! -s update || ! -s update.sig ]]; then
    curl --tlsv1.2 -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update --connect-timeout 10 --max-time 15 2>/dev/null || true
    curl --tlsv1.2 -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig --connect-timeout 10 --max-time 15 2>/dev/null || true
  fi

  if [[ -s update && -s update.sig ]] && gpg --verify update.sig update >/dev/null 2>&1; then
    if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
      bash update >/dev/null 2>&1 || true
    fi
  else
    wptt_logs "INFO" "Lỗi: Script 'update' sai chữ ký GPG hoặc rớt mạng - Bỏ qua thực thi"
  fi
  rm -f update update.sig
fi

# Tối ưu hóa Namespace tương thích ảo hóa 1 phần
if [[ -f /etc/wptt/wptt-namespace-tuong-thich-ao-hoa-1-phan ]]; then
  /bin/bash /etc/wptt/wptt-namespace-tuong-thich-ao-hoa-1-phan >/dev/null 2>&1 || true
fi

. /etc/wptt/echo-color 2>/dev/null || true
clear 2>/dev/null || true

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CHÀO MỪNG BẠN ĐẾN VỚI WPTANGTOC OLS${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# 2. BẪY CTRL+C VÀ XÁC THỰC TÊN MIỀN CHÍNH
# ==============================================================================
block_ctrl_c() {
  echo -e "\n\n${C_RED}✖ BẮT BUỘC: Bạn phải nhập tên miền chính để khởi tạo máy chủ.${C_RESET}"
  echo -e "${C_YELLOW}➜ Không thể hủy bỏ bằng Ctrl+C. Vui lòng nhập domain hợp lệ:${C_RESET} "
}
trap block_ctrl_c SIGINT

if [[ "${1:-}" == 'github.wptangtoc.com' ]]; then
  NAME="$1"
else
  unset NAME
fi

while true; do
  if [[ -z "${NAME:-}" ]]; then
    echo -en "${C_CYAN}➜ Nhập tên miền chính cho website (Ví dụ: wptangtoc.com): ${C_RESET}"
    read -r NAME
  fi

  # Vệ sinh chuỗi đầu vào triệt để
  NAME="${NAME//$'\r'/}"
  NAME="${NAME// /}"
  NAME="${NAME//[[:space:]]/}"
  NAME="${NAME,,}"
  [[ "$NAME" == *"://"* ]] && NAME="${NAME#*://}"
  [[ "$NAME" == */* ]] && NAME="${NAME%%/*}"
  [[ "$NAME" == www.* ]] && NAME="${NAME#www.}"

  if [[ -z "$NAME" || "$NAME" == "0" ]]; then
    echo -e "${C_RED}Domain không được để trống!${C_RESET}"
    unset NAME
    continue
  fi

  if [[ "$NAME" != *.* ]]; then
    echo -e "${C_RED}Tên miền không hợp lệ (thiếu phần mở rộng, ví dụ: .com, .vn).${C_RESET}"
    unset NAME
    continue
  fi

  if [[ ! "$NAME" =~ ^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z]{2,}$ ]]; then
    echo -e "${C_RED}Tên miền chứa ký tự không hợp lệ hoặc sai định dạng RFC.${C_RESET}"
    unset NAME
    continue
  fi

  echo -e "${C_GREEN}✔ Đã xác nhận tên miền chính: ${C_BOLD_WHITE}$NAME${C_RESET}\n"
  break
done

trap - SIGINT

# ==============================================================================
# 3. DÒ QUÉT NETWORK STACK VÀ TỰ ĐỘNG THÍCH ỨNG OPENLITESPEED (IPV4 VS IPV6)
# ==============================================================================

# tình huống hãng vps đóng template lúc đầu máy chủ hỗ trợ ipv4 only họ đóng template nhưng khi đóng template người dùng gói đó họ có ipv4 và ipv6 thì sao hay ngược lại nếu lúc đóng template máy chủ lúc đầu họ hỗ trợ ipv4 và ipv6 nhưng người dùng họ tắt ipv6 đi chỉ only ipv4. giải quyết vấn đề này

has_ipv6=0
# Kiểm tra: Kernel có bật IPv6 và có gán địa chỉ Global IPv6 hợp lệ không
if [[ -f /proc/net/if_inet6 ]] && [[ "$(cat /sys/module/ipv6/parameters/disable 2>/dev/null || echo 0)" != "1" ]]; then
  server_ipv6=$(ip -6 addr show scope global 2>/dev/null | grep 'inet6' | awk '{print $2}' | sed '/fe80::/d' | head -n 1 || true)
  if [[ -n "$server_ipv6" ]]; then
    has_ipv6=1
  fi
fi

if [[ "$has_ipv6" -eq 1 ]]; then
  target_listen_http="[ANY]:80"
  target_listen_https="[ANY]:443"
else
  target_listen_http="*:80"
  target_listen_https="*:443"
fi

# ==============================================================================
# 4. CẬP NHẬT ATOMIC FILE HTTPD_CONFIG.CONF (LISTENER)
# ==============================================================================
ols_conf="/usr/local/lsws/conf/httpd_config.conf"
tmp_ols=$(wptt_atomic_begin "$ols_conf") || exit 1

# 1. Tự động chuẩn hóa địa chỉ lắng nghe của Listener HTTP và HTTPS
sed -i -E "/^[[:space:]]*listener[[:space:]]+(http|HTTP)[[:space:]]*\{/,/^[[:space:]]*\}/ s/^[[:space:]]*address[[:space:]]+.*/  address                 $target_listen_http/" "$tmp_ols"
sed -i -E "/^[[:space:]]*listener[[:space:]]+(https|HTTPS)[[:space:]]*\{/,/^[[:space:]]*\}/ s/^[[:space:]]*address[[:space:]]+.*/  address                 $target_listen_https/" "$tmp_ols"

# 2. Cập nhật đường dẫn chứng chỉ tự ký sang tên miền mới cho Listener HTTPS
sed -i -E "/^[[:space:]]*listener[[:space:]]+(https|HTTPS)[[:space:]]*\{/,/^[[:space:]]*\}/ {
  s|([[:space:]]*keyFile[[:space:]]+).*/.*\.key|\1/etc/wptt-ssl-tu-ky/$NAME/$NAME.key|
  s|([[:space:]]*certFile[[:space:]]+).*/.*\.crt|\1/etc/wptt-ssl-tu-ky/$NAME/cert.crt|
  /CACertFile/d
}" "$tmp_ols"

# 3. Xóa VirtualHost mặc định của template
sed -i -e '/^[[:space:]]*virtualhost[[:space:]]+wptangtoc-ols\.com[[:space:]]*\{/,/^[[:space:]]*\}/d' "$tmp_ols"

# 4. Xóa sạch mọi mapping cũ của template trên tất cả Listener
sed -i -E '/^[[:space:]]*map[[:space:]]+wptangtoc-ols\.com([[:space:]]+|$)/d' "$tmp_ols"

wptt_atomic_commit "$tmp_ols" "$ols_conf"

# ==============================================================================
# 5. TÁI TẠO BỘ KHÓA BẢO MẬT (LOCAL AES VAULT) & MẬT KHẨU MARIADB
# ==============================================================================
# Mỗi VPS triển khai từ template bắt buộc phải có salt ngẫu nhiên mới để chống dùng chung key
WPTT_AES_DIR="/etc/wptt-aes"
WPTT_KEY_FILE="$WPTT_AES_DIR/.wptt_salt.bin"

mkdir -p "$WPTT_AES_DIR"
chmod 700 "$WPTT_AES_DIR"
rm -f "$WPTT_KEY_FILE"

old_umask=$(umask)
umask 077
openssl rand -base64 48 >"$WPTT_KEY_FILE"
umask "$old_umask"

wptt_ma_hoa_local() {
  local plaintext="$1"
  echo -n "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null || true
}

# Tạo mật khẩu quản trị MariaDB ngẫu nhiên mới
database_admin_password=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 32)
mariadb <<EOF
use mysql;
CREATE USER IF NOT EXISTS 'wordpressadmin'@'localhost' IDENTIFIED BY '$database_admin_password';
ALTER USER 'wordpressadmin'@'localhost' IDENTIFIED BY '$database_admin_password';
GRANT ALL PRIVILEGES ON *.* TO 'wordpressadmin'@'localhost' WITH GRANT OPTION;
DROP USER IF EXISTS 'root'@'localhost';
FLUSH PRIVILEGES;
EOF

password_database_root_ma_hoa=$(wptt_ma_hoa_local "$database_admin_password" | tr -d '\n\r')

wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "Website_chinh=$NAME"
wptt_atomic_edit_config "/etc/wptt/.wptt.conf" "database_admin_password='${password_database_root_ma_hoa}'"

# ==============================================================================
# 6. KHỞI TẠO WEBSITE MỚI VÀ DỌN DẸP TEMPLATE CŨ
# ==============================================================================
# Xóa lệnh gọi script này trong .bashrc để lần sau đăng nhập không bị hỏi lại
sed -i '/wptt-thay-domain-chinh-wptangtoc-ols-com/d' /root/.bashrc

# Tạo Website thật của người dùng
echo -e "${C_CYAN}➜ Đang khởi tạo VHost và Database cho website $NAME...${C_RESET}"
(/etc/wptt/domain/wptt-themwebsite "$NAME")

# --- DỌN DẸP USER VÀ TÀI NGUYÊN TEMPLATE CŨ ---
old_user=$(awk -F: '$6 ~ /\/wptangtoc-ols\.com/ {print $1; exit}' /etc/passwd || true)

if [[ -n "$old_user" ]] && id -u "$old_user" >/dev/null 2>&1; then
  # 1. Diệt tiến trình đang chạy
  usermod -L -s /sbin/nologin "$old_user" >/dev/null 2>&1 || true
  pkill -9 -u "$old_user" >/dev/null 2>&1 || true

  # 2. Xóa file tạm TRƯỚC khi xóa user
  find /tmp /dev/shm /var/tmp -user "$old_user" -delete 2>/dev/null || true

  # 3. Thu hồi user khỏi hệ điều hành
  userdel -f "$old_user" >/dev/null 2>&1 || true
fi

# Xóa cấu hình Jail SSH của template cũ
sed -i -e "/^#begin-WPTT_JAIL_wptangtocwpolswpcom/,/^#end-WPTT_JAIL_wptangtocwpolswpcom$/d" /etc/ssh/sshd_config 2>/dev/null || true
systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true

# Xóa các thư mục vật lý của website template cũ
/bin/rm -rf /usr/local/lsws/conf/vhosts/wptangtoc-ols.com \
  /usr/local/lsws/wptangtoc-ols.com \
  /etc/wptt-ssl-tu-ky/wptangtoc-ols.com \
  /etc/wptt/vhost/.wptangtoc-ols.com.conf \
  /home/wptangtoc-ols.com \
  /usr/local/backup-website/wptangtoc-ols.com \
  /wptangtoc-ols/wptangtoc-ols.com >/dev/null 2>&1 || true

# ==============================================================================
# 7. TỰ ĐỘNG TỐI ƯU HỆ THỐNG THEO PHẦN CỨNG MỚI (RAM / CPU AUTO-TUNE)
# ==============================================================================
# Ép wptt-auto-tune tính toán lại cấu hình OLS, MariaDB và LSPHP dựa trên RAM thật của VPS này
echo '100' >/etc/wptt/.ram_hien_tai
/bin/bash /etc/wptt/cau-hinh/wptt-auto-tune >/dev/null 2>&1 || true

# Reload OpenLiteSpeed để áp dụng Listener và VHost mới
wptt_smart_reload_lsws >/dev/null 2>&1 || /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1 || true

# Dọn log cài đặt cũ
: >/var/log/wptangtoc-ols.log

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}KHỞI TẠO HỆ THỐNG THÀNH CÔNG!${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text " WPTangToc OLS phát triển bởi : ${C_YELLOW}Gia Tuấn${C_RESET}" 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
sleep 3
if [[ "${NAME:-}" == 'github.wptangtoc.com' ]]; then
  sudo sh -c 'echo "" > /root/.bashrc'
else
  exec bash
fi
