#!/bin/bash
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
stty iutf8 #từ latin1 sang utf8, nhiều khi anh em dùng bộ gõ tiếng việt: dùng à â nó thêm \xc3 hay \xa9 ... tương thích với bộ gõ tiếng việt telex khi nhập domain

#update ghi đè
. /etc/wptt/.wptt.conf
# . /etc/wptt/core-functions 2>/dev/null

if [[ $Website_chinh != 'wptangtoc-ols.com' ]]; then #chỉ hoạt động khi domain chính đang là wptangtoc ols
  return 2>/dev/null || exit
fi

version_wptangtoc_ols=$(cat /tmp/wptangtoc-ols-version-main)
wptangtocols_version=$(curl -s --connect-timeout 60 --max-time 60 https://wptangtoc.com/share/version-wptangtoc-ols.txt | head -1 | grep '\.')
if [[ -z "$wptangtocols_version" ]]; then
  wptangtocols_version=$(curl -s --connect-timeout 60 --max-time 60 https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/version-wptangtoc-ols.txt)
fi

if [[ "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then
  . /etc/wptt/wptt-update2

  echo "$wptangtocols_version" > /tmp/wptangtoc-ols-version #đánh dấu phiên bản mới

  curl -sO https://wptangtoc.com/share/update --connect-timeout 10 --max-time 30
  curl -sO https://hub.wptangtoc.com/update.sig --connect-timeout 10 --max-time 30 -A "checksum wptangtoc ols"

	# 2. Dự phòng nếu tải thất bại hoặc file trống
	if [[ ! -s update || ! -s update.sig ]]; then
		curl -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update --connect-timeout 10 --max-time 15
		curl -sO https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/update.sig --connect-timeout 10 --max-time 15
	fi

	# 3. Quét GPG và chỉ thực thi khi 100% chính chủ
	if [[ -s update && -s update.sig ]] && gpg --verify update.sig update 2>/dev/null; then
		if grep -q 'UPDATE_DONE="YES"' update 2>/dev/null; then
			bash update >/dev/null 2>&1
		fi
	else
		# Tùy chọn: Ghi log ngầm nếu phát hiện file bị can thiệp
		echo "Lỗi: Script 'update' sai chữ ký GPG hoặc rớt mạng - Bỏ qua thực thi ( $(date '+%d-%m-%Y %H:%M') )" >> /var/log/wptangtoc-ols.log
	fi

	# 4. Dọn rác
	rm -f update update.sig

fi
. /etc/wptt/echo-color
clear

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}Chào mừng bạn đến với WPTangToc OLS${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

echo ""

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 1. Hàm xử lý khi người dùng cố tình ấn Ctrl+C
function block_ctrl_c() {
  echo ""
  echo -e "${RED}[!] BẮT BUỘC: Bạn phải nhập tên miền để cấu hình hệ thống.${NC}"
  echo -e "${YELLOW}>> Không thể thoát bằng Ctrl+C. Vui lòng nhập domain hợp lệ.${NC}"
  # In lại dấu nhắc nhập liệu (tùy chọn, để thẩm mỹ)
  echo -ne "${GREEN}Nhập domain của bạn: ${NC}"
}

# 2. Kích hoạt bẫy tín hiệu (Trap)
trap block_ctrl_c SIGINT

# 3. Vòng lặp vĩnh cửu bắt nhập Domain
while true; do
  echo -ne "${GREEN}Nhập domain hoặc subdomain (ví dụ: wptangtoc.com): ${NC}"
  read NAME

  # --- Xử lý & Làm sạch dữ liệu đầu vào ---

  # Loại bỏ khoảng trắng và chuẩn hóa
  # BỘ LỌC VỆ SINH BIẾN ĐẦU VÀO (CHỐNG LỖI WINDOWS CLIPBOARD)
  NAME="${NAME//$'\r'/}"       # Lọc tận gốc ký tự CRLF (Windows)
  NAME="${NAME// /}"           # Xóa toàn bộ khoảng trắng thừa
  NAME="${NAME//[[:space:]]/}" # Tự động loại bỏ toàn bộ khoảng trắng (space/tab) nếu người dùng lỡ tay nhập thừa


  # Chuyển thành chữ thường
  NAME=$(echo "$NAME" | tr '[:upper:]' '[:lower:]')
  # Loại bỏ http:// hoặc https://
  NAME=$(echo "$NAME" | sed -E 's/^\s*.*:\/\///g')

  # Loại bỏ www. ở đầu
  if [[ "$NAME" == www.* ]]; then
	  NAME="${NAME#www.}" #loại bỏ www. ở đầu
  fi
  # Loại bỏ khoảng trắng thừa đầu đuôi
  NAME=$(echo "$NAME" | xargs)
  # Loại bỏ ký tự / cuối cùng nếu có
  NAME=${NAME%/}
  # Tự động loại bỏ toàn bộ khoảng trắng (space/tab) nếu người dùng lỡ tay nhập thừa

  # Check 1: Rỗng hoặc bằng 0
  if [[ -z "$NAME" ]] || [[ "$NAME" == "0" ]]; then
    echo -e "${RED}[Lỗi] Domain không được để trống. Vui lòng nhập lại.${NC}"
    continue # Quay lại đầu vòng lặp
  fi

  # Check 2: Không có dấu chấm (không phải domain)
  if [[ "$NAME" == "${NAME/./}" ]]; then
    echo -e "${RED}[Lỗi] Domain không đúng định dạng (thiếu dấu chấm). Ví dụ: wptangtoc.com${NC}"
    continue
  fi

  # Check 3: Có khoảng trắng ở giữa (VD: "wptangtoc com")
  if [[ "$NAME" =~ [[:space:]] ]]; then
    echo -e "${RED}[Lỗi] Domain không được chứa khoảng trắng.${NC}"
    continue
  fi

  # Check 4: Ký tự đặc biệt (chỉ cho phép chữ, số, dấu chấm, dấu gạch ngang)
  if [[ ! "$NAME" =~ ^[a-z0-9]+([a-z0-9.-]*[a-z0-9]+)?\.[a-z]{2,}$ ]]; then #Regex này đã bao phủ tốt, nhưng để chuẩn xác 100% theo tiêu chuẩn tên miền quốc tế (RFC 1035 - tên miền không được bắt đầu hoặc kết thúc bằng dấu gạch ngang - hoặc dấu chấm .
    echo -e "${RED}[Lỗi] Domain chứa ký tự không hợp lệ hoặc sai cấu trúc.${NC}"
    continue
  fi

  # Nếu vượt qua tất cả bài test -> Hợp lệ -> Thoát vòng lặp
  echo -e "${GREEN}>> Domain hợp lệ: $NAME${NC}"
  break
done

sed -i "/keyFile/d" /usr/local/lsws/conf/httpd_config.conf
sed -i "/certFile/d" /usr/local/lsws/conf/httpd_config.conf
sed -i "/CACertFile/d" /usr/local/lsws/conf/httpd_config.conf
sed -i "/https/a keyFile              \/etc\/wptt-ssl-tu-ky\/$NAME\/$NAME.key" /usr/local/lsws/conf/httpd_config.conf
sed -i "/https/a certFile             \/etc\/wptt-ssl-tu-ky\/$NAME\/cert.crt" /usr/local/lsws/conf/httpd_config.conf

sed -i "/Website_chinh/d" /etc/wptt/.wptt.conf
echo "Website_chinh=$NAME" >>/etc/wptt/.wptt.conf

sed -i -e '/^virtualhost wptangtoc-ols.com/,/^}$/d' /usr/local/lsws/conf/httpd_config.conf
sed -i "/wptangtoc-ols.com wptangtoc-ols.com/d" /usr/local/lsws/conf/httpd_config.conf

database_admin_password=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 32)

mariadb <<EOF
use mysql;
FLUSH PRIVILEGES;
CREATE USER 'wordpressadmin'@'localhost' IDENTIFIED BY '$database_admin_password';
GRANT ALL PRIVILEGES ON *.* TO 'wordpressadmin'@'localhost' WITH GRANT OPTION;
DROP USER 'root'@'localhost';
FLUSH PRIVILEGES;
EOF

wptt_ma_hoa() {
    local WPTT_KEY_FILE="/etc/wptt-aes/.wptt_salt.bin"
    local plaintext="$1"
    echo -n "$plaintext" | openssl enc -aes-256-cbc -pbkdf2 -a -A -salt -pass file:"$WPTT_KEY_FILE" 2>/dev/null
}

password_database_root_ma_hoa_luu_tru=$(wptt_ma_hoa "$database_admin_password" | tr -d '\n\r')

sed -i '/database_admin_password/d' /etc/wptt/.wptt.conf
echo "database_admin_password='${password_database_root_ma_hoa_luu_tru}'" >>/etc/wptt/.wptt.conf

sed -i '/wptt-thay-domain-chinh-wptangtoc-ols-com/d' /root/.bashrc
# source /root/.bashrc
# clear
(/etc/wptt/domain/wptt-themwebsite "$NAME") #đóng () để không bị chèn biến

rm -rf /usr/local/lsws/conf/vhosts/wptangtoc-ols.com >/dev/null 2>&1
rm -rf /usr/local/lsws/wptangtoc-ols.com >/dev/null 2>&1
rm -rf /etc/wptt-ssl-tu-ky/wptangtoc-ols.com >/dev/null 2>&1
rm -f /etc/wptt/vhost/.wptangtoc-ols.com.conf
pkill -u wptangtocwpolswpcom >/dev/null 2>&1

#-f la force băt buộc

sed -i -e "/^#begin-WPTT_JAIL_wptangtocwpolswpcom/,/^#end-WPTT_JAIL_wptangtocwpolswpcom$/d" /etc/ssh/sshd_config 2>/dev/null || true
systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null

#xác định username template web delete
username=$(cat /etc/passwd | grep '/wptangtoc-ols.com'| cut -f1 -d ':')
userdel -f "$username" >/dev/null 2>&1
rm -rf "${username:?}" >/dev/null 2>&1
rm -rf /home/wptangtoc-ols.com >/dev/null 2>&1
rm -rf /usr/local/backup-website/wptangtoc-ols.com >/dev/null 2>&1
rm -rf /wptangtoc-ols/wptangtoc-ols.com >/dev/null 2>&1

echo '100' >/etc/wptt/.ram_hien_tai #để ép thực thi wptt-auto-tune
/bin/bash /etc/wptt/cau-hinh/wptt-auto-tune >/dev/null 2>&1

echo '' >/var/log/wptangtoc-ols.log
#Làm mới sạch sẽ (Clean Refresh): Nó hủy bỏ phiên làm việc hiện tại và tải lại .bashrc từ đầu. Các biến môi trường cũ, hàm cũ, alias cũ sẽ bị xóa sạch.
exec bash

