		else
			# Nếu không phải giả lập thì hỏi xác nhận
			if wptt_xac_nhan "$xac_nhan $ban_co_muon $xoa $chung_chi SSL letsencrypt website $CLEAN?" "Nếu sau này bạn khởi tạo đúng domain này " "không phải xin cấp lại SSL letsencrypt cho domain này" "Đồng ý (Xoá sạch chứng chỉ SSL letsencrypt)" "Không đồng ý (Vẫn giữ chứng chỉ SSL letsencrypt)"; then
				dongyssl="y"
			else
				dongyssl="n"
			fi
		fi

		if [[ $dongyssl == "y" ]]; then
			_runing "Xóa chứng chỉ SSL website $CLEAN"

		# Vòng lặp: Xóa sạch mọi phiên bản thư mục SSL tìm được
		for ssl_name in "${thu_muc_ssl[@]}"; do
			if [[ -n "$ssl_name" && -d /etc/letsencrypt/live/"$ssl_name" ]]; then #xác thực an toàn chắc chắn thì mới xoá
				certbot revoke --non-interactive --agree-tos --cert-path /etc/letsencrypt/live/"${ssl_name:?}"/cert.pem >/dev/null 2>&1
				rm -f /etc/letsencrypt/renewal/"${ssl_name:?}".conf 2>/dev/null
				rm -rf /etc/letsencrypt/live/"${ssl_name:?}" 2>/dev/null
				rm -rf /etc/letsencrypt/archive/"${ssl_name:?}" 2>/dev/null
			fi
		done

		_rundone "Xóa chứng chỉ SSL website $CLEAN"
		fi
	fi
	# =================================================================

    if [[ -n "$CLEAN" && -f /etc/wptt-auto/${CLEAN}-auto-backup ]]; then
      _runing "$xoa $tu_dong_sao_luu_website $CLEAN"
      rm -f /etc/wptt-auto/"${CLEAN:?}"-auto-backup
      rm -f /etc/cron.d/backup"${CLEAN:?}".cron
      NAME_CRON_ubuntu=${CLEAN//[.]/_}
      rm -f /etc/cron.d/backup"${NAME_CRON_ubuntu}"_cron
      _rundone "$xoa $tu_dong_sao_luu_website $CLEAN"
    fi

    if [[ -n "$CLEAN" && -f /etc/cron.d/delete-google-driver-${CLEAN}.cron ]]; then
      _runing "Xóa tự động xóa file backup website $CLEAN trên Google Driver hết hạn"
      rm -f /etc/cron.d/delete-google-driver-"${CLEAN:?}".cron
      NAME_CRON_ubuntu=${CLEAN//[.]/_}
      rm -f /etc/cron.d/delete-google-driver-"${NAME_CRON_ubuntu}"_cron
      rm -f /etc/wptt-auto/"${CLEAN:?}"-delete-backup-google-driver
      _rundone "Xóa tự động xóa file backup website $CLEAN trên Google Driver hết hạn"
    fi

    if [[ -n "$CLEAN" && -f /etc/cron.d/wp-cron-job-${CLEAN}.cron ]]; then
      _runing "Xóa tự động tối ưu wp cron website $CLEAN"
      rm -f /etc/cron.d/wp-cron-job-"${CLEAN:?}".cron
      NAME_CRON_ubuntu=${CLEAN//[.]/_}
      rm -f /etc/cron.d/wp-cron-job-"${NAME_CRON_ubuntu}"_cron
      _rundone "Xóa tự động tối ưu wp cron website $CLEAN"
    fi

    if [[ -n "$CLEAN" && -f /etc/cron.d/delete${CLEAN}.cron ]]; then
      _runing "Xóa tự động xóa file backup website $CLEAN hết hạn"
      rm -f /etc/cron.d/delete"${CLEAN:?}".cron
      NAME_CRON_ubuntu=${CLEAN//[.]/_}
      rm -f /etc/cron.d/delete"${NAME_CRON_ubuntu}"_cron
      rm -f /etc/wptt-auto/"${CLEAN:?}"-delete-backup
      _rundone "Xóa tự động xóa file backup website $CLEAN hết hạn"
    fi

    if [[ -n "$CLEAN" && -f /etc/wptt/chuyen-huong/."$CLEAN".conf ]]; then
      rm -f /etc/wptt/chuyen-huong/."${CLEAN:?}".conf
    fi

	if [[ -n "$CLEAN" && -d /etc/wptt-ssl-tu-ky/"${CLEAN:?}" ]]; then
		rm -rf /etc/wptt-ssl-tu-ky/"${CLEAN:?}"
	fi

    NAMEwpadmin=${CLEAN//[-._]/wp}
    if [[ -n "$NAMEwpadmin" &&  -f /etc/fail2ban/filter.d/wordpress-dangnhap-${NAMEwpadmin}.conf ]]; then
      rm -f /etc/fail2ban/filter.d/wordpress-dangnhap-"${NAMEwpadmin:?}".conf
      sed -i "/wordpress-dangnhap-${NAMEwpadmin:?}/,+8d" /etc/fail2ban/jail.local
    fi

    if [[ -n "$NAMEwpadmin" && -f /etc/fail2ban/filter.d/ddos-${NAMEwpadmin}.conf ]]; then
      _runing "Xoá thiết lập chống ddos website $CLEAN"
      . /etc/wptt/bao-mat/wptt-canh-bao-ddos-thiet-lap-xoa "${CLEAN:?}" >/dev/null 2>&1
      _rundone "Xoá thiết lập chống ddos website $CLEAN"
    fi

    #restart apply hệ thống và nó tự clean tmp unix stocket lsphp username
    wptt_smart_reload_lsws >/dev/null 2>&1

    sleep 2
    echo "==================================================================="
    echo "Đã xóa thành công website $CLEAN                 "
    echo "==================================================================="

    echo "Xoá website $CLEAN thời gian: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  fi
fi
