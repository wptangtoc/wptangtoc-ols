#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  Tính năng Xóa domain [hay Xóa tên miền] trong quản lý máy chủ là quá trình gỡ bỏ một tên miền khỏi cấu hình của máy chủ đó. Sau khi xóa, máy chủ sẽ ngừng phục vụ website và các dịch vụ khác liên quan [mã nguồn, database, ssl, sao lưu...] đến tên miền đó từ máy chủ cụ thể này.

  Mục Đích Chính
  * Website không còn cần thiết: Ngừng hoạt động hoàn toàn website trên máy chủ.
  * Chuyển web sang nhà cung cấp khác: Xóa domain cũ sau khi đã di chuyển thành công.
  * Dọn dẹp tài khoản host: Loại bỏ các tên miền phụ không còn sử dụng.
  * Giải phóng tài nguyên: Tối ưu dung lượng đĩa và tài nguyên RAM/CPU.
  * Sau khi bán hoặc chuyển nhượng tên miền: Không phục vụ domain đã đổi chủ.
EOF
}

# Tránh lỗi kẹt thư mục làm việc khi thư mục hiện tại bị xóa
cd /root 2>/dev/null || cd /

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

NAME="${1:-}"
[[ "$NAME" == '98' ]] && NAME=''

if [[ -z "$NAME" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}${quan_ly_domain:-Quản lý Domain} ➜ ${xoa:-Xóa} Website${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  . /etc/wptt/tenmien 2>/dev/null
  lua_chon_NAME "${xoa:-Xóa} Website"
fi

# Tương thích đối số xóa website của tính năng wptt-xoa-domain-chuyen-huong
if [[ -f "/etc/wptt/vhost_bk/.${NAME}.conf" ]]; then
  /bin/mv -f "/etc/wptt/vhost_bk/.${NAME}.conf" "/etc/wptt/vhost/" 2>/dev/null || true
fi

if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi

pathcheck="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  . /etc/wptt/echo-color 2>/dev/null
  echoDo "${ten_mien_nay_khong_ton_tai_tren_he_thong:-Tên miền này không tồn tại trên hệ thống!}"
  sleep 2
  if [[ "${1:-}" == "98" ]]; then
    echo -en "${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu quản lý domain...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-domain-main 1
  fi
  return 1 2>/dev/null || exit 1
fi

# shellcheck disable=SC1090
. "/etc/wptt/vhost/.${NAME}.conf"
# shellcheck disable=SC1091
. /etc/wptt/.wptt.conf 2>/dev/null

CLEAN="$NAME"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI THÙNG RÁC, DUNG LƯỢNG VÀ CRONJOB
# ==============================================================================
[[ -z "${WPTT_TRASH_ENABLE:-}" ]] && WPTT_TRASH_ENABLE=1
DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')
CRON_LINK="/etc/cron.d/wptt-trash-cleaner"

if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
  if ((DISK_USAGE >= 90)); then
    echo -e "\n${C_RED}CẢNH BÁO ĐỎ: Ổ cứng đang đầy ${DISK_USAGE}%!${C_RESET}"
    echo -e "${C_YELLOW}Hệ thống sẽ TẠM TẮT Thùng rác ảo để giải phóng dung lượng ngay lập tức.${C_RESET}"
    WPTT_TRASH_ENABLE=0
    sleep 3
  elif [[ ! -f "$CRON_LINK" ]]; then
    WPTT_TRASH_ENABLE=0
  fi
fi

# ==============================================================================
# XÁC NHẬN THAO TÁC XÓA
# ==============================================================================
dongy='n'
if [[ "${1:-}" == '98' ]]; then
  msg_title="${xac_nhan:-Xác nhận} ${xoa:-xóa} website ${C_RED}${CLEAN}${C_RESET}?!"
  msg_info1="Không thể hoàn tác: Mọi dữ liệu sẽ bị xóa khỏi máy chủ."
  msg_info2="Hãy chắc chắn bạn đã có bản sao lưu gần nhất để dự phòng."

  if wptt_xac_nhan "$msg_title" "$msg_info1" "$msg_info2" "Đồng ý xoá website $NAME" "Không đồng ý (Hủy thao tác)"; then
    dongy='y'
  fi
else
  dongy='y'
fi

if [[ "$dongy" != 'y' ]]; then
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  exit 0
fi

# ==============================================================================
# XỬ LÝ TRƯỜNG HỢP XÓA WEBSITE CHÍNH (ĐẠI DIỆN HỆ THỐNG)
# ==============================================================================
if [[ "$NAME" == "$Website_chinh" ]]; then
  echo -e "\n\n${C_YELLOW}$NAME là website chính đại diện cho hệ thống.${C_RESET}"
  echo "Vui lòng chọn một domain khác thay thế làm website chính (đã kích hoạt SSL):"

  # Lọc domain ứng viên trực tiếp trên bộ nhớ RAM (In-Memory Array), không ghi đĩa
  selects=()
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain_candidate="${filepath##*/}"
    domain_candidate="${domain_candidate%.conf}"
    domain_candidate="${domain_candidate#.}"

    # Bỏ qua chính domain đang xóa và các file không phải domain hợp lệ
    [[ "$domain_candidate" == "$Website_chinh" || "$domain_candidate" != ?*.?* ]] && continue

    # Điều kiện: Phải tồn tại mã nguồn hợp lệ
    if [[ -d "/usr/local/lsws/${domain_candidate}/html" ]]; then
      selects+=("$domain_candidate")
    fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echoDo "Bạn không thể xoá website khi hệ thống chỉ có 1 domain duy nhất là domain chính."
    echoDo "Vui lòng thêm một website mới trước khi xóa website này."
    sleep 3
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
    return 1 2>/dev/null || exit 1
  fi

  PS3="
$(tput setab 0)-//-${nhap_lua_chon_cua_ban:-Nhập lựa chọn} [0=${exit_thoat:-Thoát}]:$(tput sgr0) "
  NAMEPHU=""
  select sel in "${selects[@]}"; do
    NAMEPHU="$sel"
    break
  done

  if [[ -z "$NAMEPHU" || "$NAMEPHU" == "0" || "$NAMEPHU" == "$Website_chinh" || "$NAMEPHU" == 'wptangtoc-ols.com' ]]; then
    echoDo "Lựa chọn không hợp lệ hoặc đã hủy bỏ!"
    exec /etc/wptt/wptt-domain-main 1
    exit 1
  fi

  _runing "Chuyển đổi website chính từ ${CLEAN} thành ${NAMEPHU}"

  # ATOMIC TRANSACTION: Cập nhật chứng chỉ SSL mặc định trên httpd_config.conf
  ols_conf="/usr/local/lsws/conf/httpd_config.conf"
  tmp_ols=$(wptt_atomic_begin "$ols_conf") || {
    _runloi "Không thể khởi tạo file nháp OpenLiteSpeed"
    exit 1
  }

  sed -i "/keyFile/d" "$tmp_ols"
  sed -i "/certFile/d" "$tmp_ols"
  sed -i "/CACertFile/d" "$tmp_ols"

  if [[ ! -f /etc/wptt-ssl-tu-ky/${NAMEPHU}/${NAMEPHU}.key ]]; then #tính toán tình huống dự phòng giả sử người dùng xóa mất ssl tự ký đi thì không thể có port đại diện được
    mkdir -p "/etc/wptt-ssl-tu-ky/$NAMEPHU"
    cd "/etc/wptt-ssl-tu-ky/$NAMEPHU" || exit
    openssl req -new -newkey rsa:2048 -nodes -keyout "$NAMEPHU.key" -out "NAMEPHU.csr" -subj "/C=VN/ST=Hanoi/L=Hanoi/O=wptangtoc ols/OU=IT Department/CN=$NAME/emailAddress=admin@example.com" >/dev/null 2>&1
    openssl x509 -req -in "$NAMEPHU.csr" -signkey "$NAMEPHU.key" -out cert.crt -days 3650 >/dev/null 2>&1
    cd -
  fi

  #phương án chỉ cần ssl tự ký là đủ an tâm để đại diện port 443 được rồi
  sed -i "/https/a \  keyFile               /etc/wptt-ssl-tu-ky/${NAMEPHU}/${NAMEPHU}.key\n  certFile              /etc/wptt-ssl-tu-ky/${NAMEPHU}/cert.crt" "$tmp_ols"
  wptt_atomic_commit "$tmp_ols" "$ols_conf"

  # ATOMIC TRANSACTION: Cập nhật biến Website_chinh vào .wptt.conf
  wptt_conf="/etc/wptt/.wptt.conf"
  tmp_wptt=$(wptt_atomic_begin "$wptt_conf")
  if [[ -n "$tmp_wptt" ]]; then
    sed -i -E "s/^[[:space:]]*Website_chinh=.*/Website_chinh=\"${NAMEPHU}\"/g" "$tmp_wptt"
    wptt_atomic_commit "$tmp_wptt" "$wptt_conf"
  fi

  # Chuyển giao phpMyAdmin sang website chính mới
  if [[ -n "${id_dang_nhap_phpmyadmin:-}" && -d "/usr/local/lsws/${CLEAN}/html/phpmyadmin" ]]; then
    /bin/cp -rf "/usr/local/lsws/${CLEAN}/html/phpmyadmin" "/usr/local/lsws/${NAMEPHU}/html/"
    mkdir -p "/usr/local/lsws/${NAMEPHU}/passwd"
    /bin/cp -f "/usr/local/lsws/${Website_chinh}/passwd/.phpmyadmin" "/usr/local/lsws/${NAMEPHU}/passwd/" 2>/dev/null || true

    tuong_thich_nhom_litespeed="nobody"
    grep -qi "ubuntu" /etc/*release 2>/dev/null && tuong_thich_nhom_litespeed="nogroup"
    chown -hR "nobody:${tuong_thich_nhom_litespeed}" "/usr/local/lsws/${NAMEPHU}/passwd"

    cat <<EOF >>"/usr/local/lsws/conf/vhosts/${NAMEPHU}/${NAMEPHU}.conf"
realm ${NAMEPHU}phpphpmyadmin {
  userDB  {
    location              /usr/local/lsws/${NAMEPHU}/passwd/.phpmyadmin
  }
}
context /phpmyadmin/ {
  location                phpmyadmin/
  allowBrowse             1
  realm                   ${NAMEPHU}phpphpmyadmin
  accessControl  {
    allow                 ALL
  }
  rewrite  {
  }
  addDefaultCharset       off
  phpIniOverride  {
  }
}
EOF
  fi

  wptt_smart_reload_lsws >/dev/null 2>&1
  _rundone "Chuyển đổi website chính từ ${CLEAN} thành ${NAMEPHU}"
fi

# ==============================================================================
# XỬ LÝ DATABASE VÀ THÙNG RÁC CỦA DATABASE
# ==============================================================================
password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf) || {
  _runloi "Không thể tạo file xác thực database tạm"
  exit 1
}
chmod 600 "$TEMP_CNF_ROOT"
cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username}"
password="${password_database_root}"
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4
EOF
unset password_database_root database_admin_password

wptt_abort_db_injection() {
  _runloi "$1"
  sleep 2
  /bin/rm -f "${TEMP_CNF_ROOT:?}"
  [[ "${2:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  return 2>/dev/null || exit 1
}

[[ -n "${DB_Name_web:-}" && ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "${1:-}"
[[ -n "${DB_User_web:-}" && ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "${1:-}"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
SHORT_DB_NAME="${DB_Name_web:0:38}"
TRASH_DB="${SHORT_DB_NAME}_trash_${TIMESTAMP}"

_runing "${xoa:-Xóa} database website $CLEAN"
if [[ -n "${DB_Name_web:-}" ]]; then
  if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "CREATE DATABASE IF NOT EXISTS \`$TRASH_DB\`;" 2>/dev/null
    RENAME_QUERY=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -s -e \
      "SELECT CONCAT('RENAME TABLE \`', table_schema, '\`.\`', table_name, '\` TO \`$TRASH_DB\`.\`', table_name, '\`;') \
       FROM information_schema.TABLES WHERE table_schema='$DB_Name_web';" 2>/dev/null)

    if [[ -n "$RENAME_QUERY" ]]; then
      mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "$RENAME_QUERY" 2>/dev/null
    fi
  fi

  # Dọn dẹp User & Drop Database gốc
  [[ -n "${DB_User_web:-}" ]] && mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "KILL USER ${DB_User_web}" 2>/dev/null
  mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "
    DROP DATABASE IF EXISTS \`${DB_Name_web}\`;
    DROP USER IF EXISTS '${DB_User_web}'@'localhost';
    FLUSH PRIVILEGES;
  " >/dev/null 2>&1
fi
_rundone "${xoa:-Xóa} database website $CLEAN"

# Xử lý database các thư mục phụ (subfolder) nếu có
if [[ -n "${subfolder_su_dung:-}" && -d "/etc/wptt/${CLEAN}-wptt" ]]; then
  for sub_conf in "/etc/wptt/${CLEAN}-wptt"/*; do
    [[ -f "$sub_conf" ]] || continue
    # shellcheck disable=SC1090
    . "$sub_conf"
    if [[ -n "${DB_Name_web:-}" ]]; then
      mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_Name_web}\`;" 2>/dev/null
    fi
  done
  /bin/rm -rf "/etc/wptt/${CLEAN:?}-wptt"
  # shellcheck disable=SC1090
  . "/etc/wptt/vhost/.${CLEAN}.conf"
fi

/bin/rm -f "${TEMP_CNF_ROOT:?}"

# ==============================================================================
# THÁO DỠ AN TOÀN JAIL / NAMESPACE / MOUNT POINT TRƯỚC KHI XÓA FILE
# ==============================================================================
if [[ -n "${User_name_vhost:-}" ]]; then
  usermod -L -s /sbin/nologin "$User_name_vhost" >/dev/null 2>&1 || true
  pkill -9 -u "$User_name_vhost" >/dev/null 2>&1 || true
fi

# Xé toạc Namespace OLS
OLS_NS_PATH="/var/lsns/*/$CLEAN"
if ls $OLS_NS_PATH 1>/dev/null 2>&1; then
  fuser -k -9 "$OLS_NS_PATH"/* "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
  umount -fl "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
  umount -fl "$OLS_NS_PATH"/* 2>/dev/null || true
  /bin/rm -rf /var/lsns/*/"${CLEAN:?}" 2>/dev/null || true
fi

# Rút toàn bộ mount bind của Jail
JAIL_PATH="/usr/local/lsws/$CLEAN"
if [[ -d "$JAIL_PATH" ]]; then
  umount -fl "$JAIL_PATH/etc/.${CLEAN}.conf" 2>/dev/null || true
  umount -fl "$JAIL_PATH/etc/wptt-user" 2>/dev/null || true
  umount -fl "$JAIL_PATH/usr/bin/wptangtoc-user" 2>/dev/null || true
  umount -fl "$JAIL_PATH/.cron_spool" 2>/dev/null || true

  DEFAULT_SOCK="/var/lib/mysql/mysql.sock"
  grep -qi "ubuntu" /etc/*release 2>/dev/null && DEFAULT_SOCK="/run/mysqld/mysqld.sock"
  REAL_SOCK=$(mariadb -N -e "select @@socket;" 2>/dev/null)
  REAL_SOCK="${REAL_SOCK:-$DEFAULT_SOCK}"
  umount -fl "${JAIL_PATH}${REAL_SOCK}" 2>/dev/null || true

  # Ultimate Cleanup: Quét và gỡ tất cả mount point còn sót lại trong thư mục vhost
  grep "$JAIL_PATH" /proc/mounts | awk '{print $2}' | sort -r | while read -r mp; do
    umount -fl "$mp" 2>/dev/null || true
  done
fi

# Xóa cấu hình vhost riêng lẻ của OLS
if [[ -d "/usr/local/lsws/conf/vhosts/${CLEAN}" ]]; then
  /bin/rm -rf "/usr/local/lsws/conf/vhosts/${CLEAN:?}"
fi

# Dọn dẹp User hệ thống và Cron của Jail
if [[ -n "${User_name_vhost:-}" ]]; then
  crontab -r -u "$User_name_vhost" >/dev/null 2>&1 || true
  domain_safe="${CLEAN//./_}"
  /bin/rm -f "/etc/cron.d/wpttjail_${domain_safe:?}" 2>/dev/null || true

  active_jails=$(grep -l '^User_name_vhost=' /etc/wptt/vhost/.*.conf 2>/dev/null | grep -vc "/\.${CLEAN}\.conf$" || true)
  if [[ "$active_jails" -eq 0 ]]; then
    /bin/rm -f /etc/cron.d/wptt-cron-jail-sync /etc/wptt/wptt-cron-jail-sync.sh /etc/cron.d/wptt-cron-jail-sync_cron
    if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
      systemctl restart cron.service >/dev/null 2>&1 || true
    else
      systemctl restart crond.service >/dev/null 2>&1 || true
    fi
  fi

  usermod -R wptangtoc-ols "$User_name_vhost" >/dev/null 2>&1 || true
  userdel -f "$User_name_vhost" >/dev/null 2>&1 || true

  # ATOMIC TRANSACTION: Dọn dẹp sshd_config an toàn
  sshd_file="/etc/ssh/sshd_config"
  if [[ -f "$sshd_file" ]]; then
    tmp_sshd=$(wptt_atomic_begin "$sshd_file")
    if [[ -n "$tmp_sshd" ]]; then
      sed -i -e "/^#begin-WPTT_JAIL_${User_name_vhost}/,/^#end-WPTT_JAIL_${User_name_vhost}$/d" "$tmp_sshd"
      if /usr/sbin/sshd -t -f "$tmp_sshd" >/dev/null 2>&1; then
        wptt_atomic_commit "$tmp_sshd" "$sshd_file"
        systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
      else
        /bin/rm -f "$tmp_sshd" 2>/dev/null
      fi
    fi
  fi

  find /tmp /dev/shm /var/tmp -user "$User_name_vhost" -delete >/dev/null 2>&1 || true
fi

# Mở khóa chattr file wp-config.php nếu có
if [[ -f "/usr/local/lsws/${CLEAN}/html/wp-config.php" ]]; then
  if lsattr "/usr/local/lsws/${CLEAN}/html/wp-config.php" 2>/dev/null | cut -f1 -d ' ' | grep -q 'i'; then
    . /etc/wptt/bao-mat/wptt-chattr-file-lock "${CLEAN:?}" off 2>/dev/null || true
  fi
fi

# ==============================================================================
# XỬ LÝ MÃ NGUỒN VÀ DI CHUYỂN VÀO THÙNG RÁC
# ==============================================================================
_runing "${xoa:-Xóa} website $CLEAN${tren_he_thong:-trên hệ thống}"
if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
  TRASH_DIR="/usr/local/.wptt_trash/${CLEAN}_${TIMESTAMP}"
  mkdir -p "/usr/local/.wptt_trash"
  chmod 700 "/usr/local/.wptt_trash"

  if [[ -d "/usr/local/lsws/${CLEAN}" ]]; then
    /bin/rm -rf "/usr/local/lsws/${CLEAN:?}/html/phpmyadmin" "/usr/local/lsws/${CLEAN:?}/html/quan-ly-files" 2>/dev/null || true
    mkdir -p "$TRASH_DIR/html"

    # Hoán đổi nguyên tử siêu tốc bằng renameat2 (RENAME_EXCHANGE = 2)
    python3 -c "
import ctypes, sys
try:
    libc = ctypes.CDLL('libc.so.6')
    res = libc.renameat2(-100, sys.argv[1].encode('utf-8'), -100, sys.argv[2].encode('utf-8'), 2)
    sys.exit(0 if res == 0 else 1)
except Exception:
    sys.exit(1)
" "/usr/local/lsws/${CLEAN}/html" "${TRASH_DIR}/html" >/dev/null 2>&1

    if [[ $? -eq 0 ]]; then
      /bin/rm -rf "/usr/local/lsws/${CLEAN:?}"
    else
      /bin/rm -rf "$TRASH_DIR/html"
      /bin/mv -f "/usr/local/lsws/${CLEAN}/html" "$TRASH_DIR/" 2>/dev/null || true
      /bin/rm -rf "/usr/local/lsws/${CLEAN:?}"
    fi

    echo "$TRASH_DB" >"$TRASH_DIR/.trash_db_name"
    [[ -n "${phien_ban_php_domain:-}" ]] && echo "$phien_ban_php_domain" >"$TRASH_DIR/.php_version"
  fi
else
  /bin/rm -rf "/usr/local/lsws/${CLEAN:?}"
fi

/bin/rm -rf "/wptangtoc-ols/${CLEAN:?}" "/home/${CLEAN:?}" 2>/dev/null || true
_rundone "${xoa:-Xóa} website $CLEAN${tren_he_thong:-trên hệ thống}"

# ==============================================================================
# ATOMIC TRANSACTION: GỠ VIRTUALHOST TRÊN OPENLITESPEED (httpd_config.conf)
# ==============================================================================
ols_master_conf="/usr/local/lsws/conf/httpd_config.conf"
tmp_ols_master=$(wptt_atomic_begin "$ols_master_conf")
if [[ -n "$tmp_ols_master" ]]; then
  # 1. Xóa Map Listener
  sed -i "/map[[:space:]]*${CLEAN:?}[[:space:]]*${CLEAN:?}/d" "$tmp_ols_master"

  # 2. Xóa block virtualhost đang hoạt động
  sed -i -e '/^[[:space:]]*virtualhost[[:space:]]\+'"${CLEAN:?}"'/,/^[[:space:]]*}[[:space:]]*$/d' "$tmp_ols_master"

  # 3. Xóa block virtualhost đang bị comment (#bkwptt_)
  sed -i -e '/^[[:space:]]*#bkwptt_virtualhost[[:space:]]\+'"${CLEAN:?}"'/,/^[[:space:]]*#bkwptt_}[[:space:]]*$/d' "$tmp_ols_master"

  # 4. Quét sạch các dòng định nghĩa vhost sót lại
  sed -i "/${CLEAN:?}[[:space:]]\+${CLEAN:?}/d" "$tmp_ols_master"

  # 5. Commit nguyên tử
  wptt_atomic_commit "$tmp_ols_master" "$ols_master_conf"
fi

/bin/rm -f "/etc/wptt/vhost/.${CLEAN:?}.conf" 2>/dev/null

# ==============================================================================
# DỌN DẸP BACKUP, SSL VÀ CRONJOB HỆ THỐNG
# ==============================================================================
if [[ "${2:-}" != 'nhan-ban' ]]; then
  # Dọn dẹp thư mục Backup
  if [[ -d "/usr/local/backup-website/${CLEAN}" ]]; then
    has_backup=$(find "/usr/local/backup-website/${CLEAN}" -maxdepth 1 -type f \( -name "*.zip" -o -name "*.sql*" -o -name "*.zst" -o -name "*.tar.gz" \) 2>/dev/null)
    if [[ -n "$has_backup" ]]; then
      if wptt_xac_nhan "${xac_nhan:-Xác nhận} ${ban_co_muon:-bạn có muốn} ${xoa:-xóa} ${thu_muc:-thư mục} backup của website $CLEAN?" \
        "Không thể hoàn tác: Toàn bộ bản sao lưu sẽ bị xóa sạch." \
        "Hãy chắc chắn bạn đã tải bản sao lưu về máy tính." \
        "Đồng ý (Xoá sạch backup)" "Không đồng ý (Vẫn giữ)"; then
        _runing "${xoa:-Xóa} backup website $CLEAN"
        /bin/rm -rf "/usr/local/backup-website/${CLEAN:?}"
        _rundone "${xoa:-Xóa} backup website $CLEAN"
      fi
    else
      /bin/rm -rf "/usr/local/backup-website/${CLEAN:?}"
    fi
  fi

  # Dọn dẹp Chứng chỉ Let's Encrypt
  thu_muc_ssl=()
  [[ -f "/etc/letsencrypt/live/${CLEAN}/cert.pem" ]] && thu_muc_ssl+=("$CLEAN")
  [[ -f "/etc/letsencrypt/live/www.${CLEAN}/cert.pem" ]] && thu_muc_ssl+=("www.$CLEAN")

  if [[ ${#thu_muc_ssl[@]} -gt 0 ]]; then
    dongyssl='n'
    if [[ -n "${domain_gia_lap:-}" ]]; then
      dongyssl='y'
    else
      if wptt_xac_nhan "${xac_nhan:-Xác nhận} ${ban_co_muon:-bạn có muốn} ${xoa:-xóa} ${chung_chi:-chứng chỉ} SSL letsencrypt website $CLEAN?" \
        "Nếu sau này khởi tạo lại đúng domain này bạn sẽ không phải xin cấp lại." \
        "" "Đồng ý (Xoá sạch SSL)" "Không đồng ý (Giữ lại SSL)"; then
        dongyssl='y'
      fi
    fi

    if [[ "$dongyssl" == "y" ]]; then
      _runing "Xóa chứng chỉ SSL website $CLEAN"
      for ssl_name in "${thu_muc_ssl[@]}"; do
        if [[ -d "/etc/letsencrypt/live/${ssl_name}" ]]; then
          certbot revoke --non-interactive --agree-tos --cert-path "/etc/letsencrypt/live/${ssl_name}/cert.pem" >/dev/null 2>&1 || true
          /bin/rm -f "/etc/letsencrypt/renewal/${ssl_name}.conf" 2>/dev/null
          /bin/rm -rf "/etc/letsencrypt/live/${ssl_name}" "/etc/letsencrypt/archive/${ssl_name}" 2>/dev/null
        fi
      done
      _rundone "Xóa chứng chỉ SSL website $CLEAN"
    fi
  fi

  # Dọn dẹp Cronjob & Auto Backup
  NAME_CRON_ubuntu="${CLEAN//./_}"
  /bin/rm -f "/etc/wptt-auto/${CLEAN:?}-auto-backup" "/etc/cron.d/backup${CLEAN:?}.cron" "/etc/cron.d/backup${NAME_CRON_ubuntu:?}_cron" 2>/dev/null
  /bin/rm -f "/etc/cron.d/delete-google-driver-${CLEAN:?}.cron" "/etc/cron.d/delete-google-driver-${NAME_CRON_ubuntu:?}_cron" "/etc/wptt-auto/${CLEAN:?}-delete-backup-google-driver" 2>/dev/null
  /bin/rm -f "/etc/cron.d/wp-cron-job-${CLEAN:?}.cron" "/etc/cron.d/wp-cron-job-${NAME_CRON_ubuntu:?}_cron" 2>/dev/null
  /bin/rm -f "/etc/cron.d/delete${CLEAN:?}.cron" "/etc/cron.d/delete${NAME_CRON_ubuntu:?}_cron" "/etc/wptt-auto/${CLEAN:?}-delete-backup" 2>/dev/null
  /bin/rm -f "/etc/wptt/chuyen-huong/.${CLEAN:?}.conf" 2>/dev/null
  /bin/rm -rf "/etc/wptt-ssl-tu-ky/${CLEAN:?}" 2>/dev/null

  # Dọn dẹp chứng chỉ Proxy Ngược 443 (Ghost Migration)
  if [[ -f "/etc/pki/ca-trust/source/anchors/${CLEAN}_wptt_proxy.crt" ]]; then
    /bin/rm -f "/etc/pki/ca-trust/source/anchors/${CLEAN:?}_wptt_proxy.crt"
    update-ca-trust >/dev/null 2>&1 || true
  fi
  if [[ -f "/usr/local/share/ca-certificates/${CLEAN}_wptt_proxy.crt" ]]; then
    /bin/rm -f "/usr/local/share/ca-certificates/${CLEAN:?}_wptt_proxy.crt"
    update-ca-certificates >/dev/null 2>&1 || true
  fi

  # Dọn dẹp Fail2ban filters
  NAMEwpadmin="${CLEAN//[-._]/wp}"
  if [[ -f "/etc/fail2ban/filter.d/wordpress-dangnhap-${NAMEwpadmin}.conf" ]]; then
    /bin/rm -f "/etc/fail2ban/filter.d/wordpress-dangnhap-${NAMEwpadmin:?}.conf"
    if [[ -f /etc/fail2ban/jail.local ]]; then
      tmp_f2b=$(wptt_atomic_begin "/etc/fail2ban/jail.local")
      if [[ -n "$tmp_f2b" ]]; then
        sed -i "/wordpress-dangnhap-${NAMEwpadmin:?}/,+8d" "$tmp_f2b"
        wptt_atomic_commit "$tmp_f2b" "/etc/fail2ban/jail.local"
      fi
    fi
  fi

  if [[ -f "/etc/fail2ban/filter.d/ddos-${NAMEwpadmin}.conf" ]]; then
    . /etc/wptt/bao-mat/wptt-canh-bao-ddos-thiet-lap-xoa "${CLEAN:?}" >/dev/null 2>&1 || true
  fi

  # Restart helper services nếu đang chạy
  systemctl is-active --quiet wptt-phanquyen && systemctl restart wptt-phanquyen >/dev/null 2>&1 || true
  systemctl is-active --quiet wptt-htaccess && systemctl restart wptt-htaccess >/dev/null 2>&1 || true

  wptt_smart_reload_lsws >/dev/null 2>&1
  sleep 1

  # ==============================================================================
  # THÔNG BÁO HOÀN TẤT
  # ==============================================================================
  print_border_top
  center_text "Đã xóa thành công website $CLEAN"
  print_border_bot

  if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
    echo -e " ${C_YELLOW}Mẹo:${C_RESET} Nếu lỡ tay xóa nhầm, bạn có thể khôi phục bằng lệnh: ${C_CYAN}36 [Thùng Rác]${C_RESET}"
  fi

  wptt_logs "INFO" "Xoá website $CLEAN" 2>/dev/null || true
fi

if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi
