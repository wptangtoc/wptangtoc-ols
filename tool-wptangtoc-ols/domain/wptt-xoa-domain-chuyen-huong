# @module: Xóa chuyển hướng domain (Hỗ trợ Chroot Jail & Thùng rác ảo)

function huong_dan() {
  Tính năng Xóa chuyển hướng domain là quá trình gỡ bỏ hoặc vô hiệu hóa một cài đặt đã được thiết lập trước đó để tự động điều hướng người dùng và công cụ tìm kiếm từ một tên miền này sang một tên miền khác.

  Nói một cách đơn giản, đây là hành động dừng việc tự động chuyển tiếp từ tên miền A sang tên miền B. Sau khi xóa chuyển hướng, khi người dùng truy cập vào tên miền A, họ sẽ không còn bị tự động đưa đến tên miền B nữa.

  Mục Đích Chính
  * Khôi phục nội dung gốc: Khi bạn muốn tên miền đang bị chuyển hướng [ví dụ: tên miền A] bắt đầu hiển thị nội dung riêng của nó, thay vì trỏ sang nơi khác.
  * Thay đổi đích đến của chuyển hướng: Nếu bạn muốn tên miền A chuyển hướng đến một tên miền C hoàn toàn mới, bạn có thể cần xóa chuyển hướng cũ [sang B] trước khi thiết lập chuyển hướng mới [sang C].
  * Hủy bỏ việc gộp tên miền: Nếu trước đó bạn gộp nhiều tên miền về một, nay muốn tách chúng ra hoạt động độc lập.
  * Gỡ lỗi: Nếu chuyển hướng đang gây ra lỗi [ví dụ: vòng lặp chuyển hướng, sai đích] thì việc xóa bỏ nó là cần thiết để khắc phục.
  * Không còn nhu cầu: Khi việc chuyển hướng không còn còn cần thiết nữa [ví dụ: tên miền đích không còn tồn tại, chiến dịch marketing đã kết thúc].
}

# fix output: GETCWD Nhảy ra khỏi thư mục đang đứng để tránh lỗi khi thư mục bị xóa
cd /root 2>/dev/null || cd /

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện UX Bo Cong

clear
print_border_top
center_text "${C_YELLOW}${quan_ly_domain} ➜ ${xoa_chuyen_huong_domain}${C_RESET}"
print_border_bot
echo ""

if [[ ! -d /etc/wptt/chuyen-huong ]]; then
  echo -e "${C_YELLOW}Bạn chưa từng thiết lập chuyển hướng domain nào trên hệ thống!${C_RESET}"
  sleep 3
  exec /etc/wptt/wptt-domain-main 1
  exit 0
fi

function lua_chon_NAME() {
  unset NAME selects
  selects=()

  if [ "$(ls -At /etc/wptt/chuyen-huong 2>/dev/null)" ]; then
    for entry in $(ls -A /etc/wptt/chuyen-huong); do
      local dom=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//')
      if [[ "$dom" != "${dom/./}" ]]; then
        # Bóc tách tên miền đích từ file .htaccess
        local target=$(sed '/^#begin-chuyen-huong-domain-wptangtoc/,/^#end-chuyen-huong-domain-wptangtoc$/!d' "/usr/local/lsws/$dom/html/.htaccess" 2>/dev/null | grep '301' | grep -o -E '([a-zA-Z0-9-]+\.)+[a-zA-Z0-9-]{2,}' | tail -n 1)
        [[ -z "$target" ]] && target="Không xác định"
        selects+=("$dom|$target")
      fi
    done

    if [[ ${#selects[@]} -eq 0 ]]; then
      echo -e "${C_YELLOW}Hệ thống chưa có domain nào được kích hoạt sử dụng chuyển hướng!${C_RESET}"
      sleep 3
      exec /etc/wptt/wptt-domain-main 1
    fi

    # Render Menu Bo Cong - Đồng bộ 100% bằng UX Pro 1 Cột
    print_border_top
    center_text "${C_YELLOW}DANH SÁCH WEBSITE ĐANG CHUYỂN HƯỚNG${C_RESET}"
    print_border_mid
    
    local i=1
    for item in "${selects[@]}"; do
      local source_dom=$(echo "$item" | cut -d'|' -f1)
      local target_dom=$(echo "$item" | cut -d'|' -f2)
      
      # Tạo text hiển thị với mã màu chuẩn
      local text_hien_thi="${C_BOLD_WHITE}${source_dom}${C_RESET} ➜ ${C_GREEN}${target_dom}${C_RESET}"
      print_full_row "$i" "$text_hien_thi"
      ((i++))
    done
    print_border_bot

    local fzf_installed=false
    if command -v fzf &>/dev/null; then
      fzf_installed=true
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
    else
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
    fi

    while true; do
      echo -en "\n${C_CYAN}${PROMPT_TEXT}${C_RESET}"
      if ! read -r REPLY; then exit 1; fi
      REPLY="${REPLY// /}"
      REPLY="${REPLY,,}"

      case "$REPLY" in
      0)
        echo -e "${C_GREEN}Đang thoát...${C_RESET}"
        NAME="0"
        return 0
        ;;
      00)
        if $fzf_installed; then
          local selected_item=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
          local dom=$(echo "$selected_item" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | cut -d'|' -f1)
          if [[ -n "$dom" ]]; then
            NAME="$dom"
            return 0
          else echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"; fi
        else
          echo -e "${C_RED}Lỗi: FZF chưa cài đặt.${C_RESET}"
        fi
        ;;
      *)
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
          local action_index=$((REPLY - 1))
          NAME=$(echo "${selects[$action_index]}" | cut -d'|' -f1)
          return 0
        else
          echo -e "${C_RED}Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
        ;;
      esac
    done
  else
    echo -e "${C_YELLOW}Không có domain nào tồn tại trên hệ thống!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-domain-main 1
  fi
}

lua_chon_NAME

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
  return 2>/dev/null || exit
}

path="/etc/wptt/chuyen-huong/.$NAME.conf"
if [[ ! -f "$path" ]]; then
  echo -e "\n${C_RED}❌ Domain chuyển hướng không tồn tại trên VPS!${C_RESET}"
  sleep 3
  exec /etc/wptt/wptt-domain-main 1
fi

CLEAN="$NAME"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI THÙNG RÁC VÀ CRONJOB (FAIL-SAFE)
# ==============================================================================
[[ -z "$WPTT_TRASH_ENABLE" ]] && WPTT_TRASH_ENABLE=1
DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')
CRON_LINK="/etc/cron.d/wptt-trash-cleaner"

if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
    if [[ "$DISK_USAGE" -ge 90 ]]; then
        WPTT_TRASH_ENABLE=0
    elif [[ ! -f "$CRON_LINK" ]]; then
        WPTT_TRASH_ENABLE=0
    fi
fi

# ==============================================================================
# HỎI XÓA MÃ NGUỒN (NẾU CÓ TỒN TẠI)
# ==============================================================================
xoa_ma_nguon="y"

if [[ -n $(find "/usr/local/lsws/$CLEAN/html" -maxdepth 2 -type f -name "*.php" 2>/dev/null | head -n 1) ]]; then
  echo ""
  echo -e "${C_YELLOW}Hệ thống phát hiện Website này đang chứa mã nguồn (.php).${C_RESET}"
  if wptt_xac_nhan "Bạn có muốn XÓA SẠCH toàn bộ Mã nguồn & Database không?" "${C_BOLD_WHITE}Website:${C_RESET} $CLEAN" "" "Có (Xóa sạch)" "Không (Chỉ gỡ luật chuyển hướng)"; then
    xoa_ma_nguon="y"
  else
    xoa_ma_nguon="n"
  fi
fi

echo "Xóa chuyển hướng website $CLEAN : $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
echo ""

# ==============================================================================
# THỰC THI GỠ BỎ
# ==============================================================================
if [[ "$xoa_ma_nguon" == 'y' ]]; then
  _runing "Đang chuẩn bị dọn dẹp hệ thống website $CLEAN"

  if [[ -f "/etc/wptt/vhost_bk/.$CLEAN.conf" ]]; then
    . "/etc/wptt/vhost_bk/.$CLEAN.conf"
  elif [[ -f "/etc/wptt/vhost/.$CLEAN.conf" ]]; then
    . "/etc/wptt/vhost/.$CLEAN.conf"
  fi

  # =================================================================
  # [VÁ LỖI TỬ HUYỆT JAIL & CHROOT] - Đóng lồng an toàn trước khi xóa
  # =================================================================
  if [[ -n "$User_name_vhost" ]]; then
    usermod -L -s /sbin/nologin "$User_name_vhost" >/dev/null 2>&1 || true
    pkill -9 -u "$User_name_vhost" >/dev/null 2>&1 || true
  fi

  # Xé toạc Namespace OLS
  OLS_NS_PATH="/var/lsns/*/$CLEAN"
  if ls "$OLS_NS_PATH" 1>/dev/null 2>&1; then
    fuser -k -9 "$OLS_NS_PATH"/* "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
    umount -fl "$OLS_NS_PATH"/*/mnt 2>/dev/null || true
    umount -fl "$OLS_NS_PATH"/* 2>/dev/null || true
    rm -rf /var/lsns/*/"${CLEAN:?}" 2>/dev/null || true
  fi

  # Rút mount bind của Jail
  JAIL_PATH="/usr/local/lsws/$CLEAN"
  if [[ -d "$JAIL_PATH" ]]; then
    umount -fl "$JAIL_PATH/etc/.$CLEAN.conf" 2>/dev/null || true
    umount -fl "$JAIL_PATH/etc/wptt" 2>/dev/null || true
    umount -fl "$JAIL_PATH/etc/wptt-user" 2>/dev/null || true
    umount -fl "$JAIL_PATH/usr/bin/wptangtoc-user" 2>/dev/null || true
    umount -fl "$JAIL_PATH/.cron_spool" 2>/dev/null || true

    if grep -qi "ubuntu" /etc/*release 2>/dev/null; then
      DEFAULT_SOCK="/run/mysqld/mysqld.sock"
    else
      DEFAULT_SOCK="/var/lib/mysql/mysql.sock"
    fi
    REAL_SOCK=$(mariadb -N -e "select @@socket;" 2>/dev/null || echo "$DEFAULT_SOCK")
    umount -fl "$JAIL_PATH$REAL_SOCK" 2>/dev/null || true
  fi
  
  grep "$JAIL_PATH" /proc/mounts | awk '{print $2}' | sort -r | while read -r mp; do
    umount -fl "$mp" 2>/dev/null || true
  done
  # =================================================================

  if [[ -n "$CLEAN" && -d /usr/local/lsws/conf/vhosts/$CLEAN ]];then
      rm -rf "/usr/local/lsws/conf/vhosts/${CLEAN:?}"
  fi

  if [[ $User_name_vhost ]]; then
    crontab -r -u "$User_name_vhost" >/dev/null 2>&1
    domain_safe="${CLEAN//./_}"
    rm -f "/etc/cron.d/wpttjail_${domain_safe:?}" 2>/dev/null || true

    usermod -R wptangtoc-ols "$User_name_vhost" >/dev/null 2>&1
    userdel -f "$User_name_vhost" >/dev/null 2>&1
    sed -i -e "/^#begin-WPTT_JAIL_$User_name_vhost/,/^#end-WPTT_JAIL_$User_name_vhost$/d" /etc/ssh/sshd_config 2>/dev/null || true
    systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null

    find /tmp -user "$User_name_vhost" -delete >/dev/null 2>&1
    find /dev/shm -user "$User_name_vhost" -delete >/dev/null 2>&1
    find /var/tmp -user "$User_name_vhost" -delete >/dev/null 2>&1
  fi

  # Check An Toàn Root
  if ! wptt_kha_dung_de_xoa_xac_thuc "$CLEAN"; then
    _runloi "Gỡ bỏ hệ thống"
    echo -e "${C_RED}❌ Lỗi: Check rỗng. Hủy bỏ lệnh xóa bảo vệ VPS!${C_RESET}"
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
    return 2>/dev/null || exit 1
  fi

  # ==============================================================================
  # XỬ LÝ DATABASE (HỖ TRỢ THÙNG RÁC ẢO)
  # ==============================================================================
  TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
  TRASH_DB="${DB_Name_web}_trash_${TIMESTAMP}"

  if [[ -n "$DB_User_web" ]] && [[ -n "$DB_Name_web" ]]; then
    password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
    [[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

    TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
    chmod 600 "$TEMP_CNF_ROOT"
    cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username}"
password="${password_database_root}"
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
EOF

    # Kiểm tra an toàn SQL Injection
    [[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && { rm -f "${TEMP_CNF_ROOT:?}"; exit 1; }
    [[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && { rm -f "${TEMP_CNF_ROOT:?}"; exit 1; }

    if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
        mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "CREATE DATABASE IF NOT EXISTS \`$TRASH_DB\`;" 2>/dev/null
        RENAME_QUERY=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -s -e "SELECT CONCAT('RENAME TABLE \`', table_schema, '\`.\`', table_name, '\` TO \`$TRASH_DB\`.\`', table_name, '\`;') FROM information_schema.TABLES WHERE table_schema='$DB_Name_web';" 2>/dev/null)
        if [[ -n "$RENAME_QUERY" ]]; then
            mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "$RENAME_QUERY" 2>/dev/null
        fi
    fi

    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "KILL USER ${DB_User_web}" >/dev/null 2>&1 || true
    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_Name_web}\`" >/dev/null 2>&1
    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP USER IF EXISTS '${DB_User_web}'@'localhost'" >/dev/null 2>&1
    rm -f "${TEMP_CNF_ROOT:?}"
  fi

  # ==============================================================================
  # XỬ LÝ MÃ NGUỒN (ĐƯA VÀO THÙNG RÁC HOẶC XÓA SẠCH)
  # ==============================================================================
  if [[ "$WPTT_TRASH_ENABLE" -eq 1 ]]; then
      TRASH_DIR="/usr/local/.wptt_trash/${CLEAN}_${TIMESTAMP}"
      mkdir -p "/usr/local/.wptt_trash"
      chmod 700 "/usr/local/.wptt_trash"
      
      if [[ -d "/usr/local/lsws/$CLEAN" ]]; then
          rm -rf "/usr/local/lsws/$CLEAN/luucache" 2>/dev/null
          mkdir -p "$TRASH_DIR"
          
          python3 -c "
import ctypes
import sys
try:
    libc = ctypes.CDLL('libc.so.6')
    res = libc.renameat2(-100, b'/usr/local/lsws/${CLEAN}', -100, b'${TRASH_DIR}', 2)
    if res != 0: sys.exit(1)
except Exception:
    sys.exit(1)
" >/dev/null 2>&1

          if [[ $? -eq 0 ]]; then
              rm -rf "/usr/local/lsws/$CLEAN"
          else
              rm -rf "$TRASH_DIR"
              mv "/usr/local/lsws/$CLEAN" "$TRASH_DIR"
          fi
          
          echo "$TRASH_DB" > "$TRASH_DIR/.trash_db_name"


					#tái tạo luôn .htaccess Chuẩn WordPress đè chuyển hướng trước
echo '# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress' >"$TRASH_DIR/html/.htaccess"


      fi
      
      rm -rf /wptangtoc-ols/"${CLEAN:?}" 2>/dev/null
      rm -rf /home/"${CLEAN:?}" 2>/dev/null
  else
      rm -rf /usr/local/lsws/"${CLEAN:?}"
      rm -rf /wptangtoc-ols/"${CLEAN:?}"
      rm -rf /home/"${CLEAN:?}"
  fi

  sed -i "/${CLEAN:?} ${CLEAN:?}/d" /usr/local/lsws/conf/httpd_config.conf
  sed -i -e '/^virtualhost '"${CLEAN:?}"'/,/^}$/d' /usr/local/lsws/conf/httpd_config.conf
  rm -f /etc/wptt/vhost/."${CLEAN:?}".conf 2>/dev/null
  [[ -f "/etc/wptt/vhost_bk/.$CLEAN.conf" ]] && rm -f "/etc/wptt/vhost_bk/.$CLEAN.conf"

  _rundone "Gỡ bỏ Vhost, User và đưa dữ liệu vào Thùng rác thành công"
  msg_action="Xóa hoàn toàn Mã nguồn, DB và gỡ Chuyển hướng."

else
  _runing "Đang gỡ bỏ luật chuyển hướng trong file .htaccess..."
  sed -i -e '/^#begin-chuyen-huong-domain-wptangtoc/,/^#end-chuyen-huong-domain-wptangtoc$/d' "/usr/local/lsws/$CLEAN/html/.htaccess"

  if [[ -f "/etc/wptt/vhost_bk/.$CLEAN.conf" ]]; then
    mv "/etc/wptt/vhost_bk/.$CLEAN.conf" "/etc/wptt/vhost/"
  fi

  echo '# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress' >"/usr/local/lsws/$CLEAN/html/.htaccess"

  _rundone "Phục hồi cấu hình .htaccess nguyên bản"
  msg_action="Giữ lại dữ liệu. Chỉ gỡ bỏ luật Chuyển hướng."
fi

# ==============================================================================
# KẾT THÚC DỌN DẸP & BÁO CÁO
# ==============================================================================
rm -f "/etc/wptt/chuyen-huong/.${CLEAN:?}.conf"

wptt_smart_reload_lsws >/dev/null 2>&1

echo ""
print_border_top
center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ CHUYỂN HƯỚNG${C_RESET}"
print_border_mid
left_text "Tên miền xử lý : ${C_YELLOW}$CLEAN${C_RESET}" 2
left_text "Hành động      : ${C_GREEN}$msg_action${C_RESET}" 2
print_border_bot
echo ""

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-domain-main 1
