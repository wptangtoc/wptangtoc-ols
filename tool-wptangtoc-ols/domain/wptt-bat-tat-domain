#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Đây là tính năng giúp tạm khoá website
  Tính năng bật và tắt này là tính năng tạm khoá website, không xoá mã nguồn bất kỳ thứ gì.
  chỉ đơn giản nó sẽ tạm ngừng hoạt động website hoặc bật lại nếu đã thiết lập tạm ngừng trước đó
}

# ==============================================================================
# NẠP CẤU HÌNH, NGÔN NGỮ VÀ MÀU SẮC
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

export box_inner_width=78

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_domain} ➜ ${mo_khoa_domain:-Tạm khóa / Kích hoạt lại Website}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

# ==============================================================================
# HÀM CHỌN WEBSITE KÈM TRẠNG THÁI TẠM KHÓA/HOẠT ĐỘNG
# ==============================================================================
function lua_chon_NAME() {
  unset NAME
  local selects=()
  local i=1

  for filepath in /etc/wptt/vhost/.*.conf; do
	  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

	  local domain="${filepath##*/}"
	  domain="${domain%.conf}"
	  domain="${domain#.}"

	  if [[ "$domain" == ?*.?* ]]; then
		  local status_text=""
		  local status_color=""

		  # Kiểm tra trạng thái dựa trên sự tồn tại của file .bkwptt
		  if [[ -f "/usr/local/lsws/conf/vhosts/$domain/$domain.conf.bkwptt" ]]; then
			  status_text="[Đang TẠM KHÓA]"
			  status_color=$C_RED
		  else
			  status_text="[Đang BẬT - Hoạt động]"
			  status_color=$C_GREEN
		  fi

		  selects+=("$domain|$status_text|$status_color")
	  fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Hệ thống chưa có website nào được khởi tạo!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-domain-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  local num_domains=${#selects[@]}

  # THÊM TÙY CHỌN ĐỒNG LOẠT VÀO CUỐI MẢNG NẾU CÓ >= 2 WEBSITE
  if [[ $num_domains -ge 2 ]]; then
    selects+=("TẤT CẢ WEBSITE (Thao tác đồng loạt)")
  fi

  # ============================================================================
  # RENDER BOX CHỌN DOMAIN (UX CHUẨN 78PX)
  # ============================================================================
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Trạng thái hiện tại & Chọn website muốn thao tác:"
  local clean_title=$(echo -e "$title_text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local len=${#clean_title}
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0

  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  for val in "${selects[@]}"; do
    if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      local clean_row=$(printf "  %3d) [ĐỒNG LOẠT] Tạm khóa / Kích hoạt lại toàn bộ hệ thống" "$i")
      local item_row=$(printf "  ${C_RED}%3d)${C_RESET} [${C_RED}ĐỒNG LOẠT${C_RESET}] Tạm khóa / Kích hoạt lại toàn bộ hệ thống" "$i")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    else
      IFS='|' read -r d s c <<<"$val"
      local clean_row=$(printf "  %3d) %-34s %s" "$i" "$d" "$s")
      local item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-34s${C_RESET} ${c}%s${C_RESET}" "$i" "$d" "$s")
      local pad=$((box_inner_width - ${#clean_row}))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    fi
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  command -v fzf &>/dev/null && fzf_installed=true
  local max_opt=${#selects[@]}

  local prompt_msg="Nhập lựa chọn của bạn (1-${max_opt}) [00=Chọn Nhanh | 0=Thoát]: "

  while true; do
    echo -en "${C_CYAN}${prompt_msg}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY=$(echo "$REPLY" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    case "$REPLY" in
    0) exec /etc/wptt/wptt-domain-main 1 ;;
    00)
      if $fzf_installed; then
        local fzf_list=()
        for val in "${selects[@]}"; do
          if [[ "$val" != "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
            IFS='|' read -r d s c <<<"$val"
            fzf_list+=("$d $s")
          fi
        done
        local sel=$(printf '%s\n' "${fzf_list[@]}" | nl -w 3 -s ': ' | fzf --height=40% --border=rounded --reverse)
        NAME=$(echo "$sel" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
        [[ -n "$NAME" ]] && return 0 || continue
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local val="${selects[$((REPLY - 1))]}"
        if [[ "$val" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" ]]; then
          NAME="TẤT CẢ WEBSITE (Thao tác đồng loạt)"
        else
          NAME="${val%|*|*}"
        fi
        return 0
      elif [[ "$REPLY" == ?*.?* ]]; then
        NAME="$REPLY"
        return 0
      fi
      ;;
    esac
  done
}

# ==============================================================================
# NHẬN DIỆN ĐỐI SỐ DÒNG LỆNH (CLI_MODE)
# ==============================================================================
CLI_MODE=0
CLI_ACTION=""

if [[ "${1:-}" == "all" && "${2:-}" == "on" ]]; then
  NAME="all_on"
  CLI_MODE=1
elif [[ "${1:-}" == "all" && "${2:-}" == "off" ]]; then
  NAME="all_off"
  CLI_MODE=1
elif [[ -n "${1:-}" && "${1:-}" != "98" ]]; then
  NAME="$1"
  # Hỗ trợ CLI cho 1 domain: wptt-bat-tat-domain domain.com on/off
  if [[ "${2:-}" == "on" ]]; then
    CLI_MODE=1
    CLI_ACTION="bat"
  elif [[ "${2:-}" == "off" ]]; then
    CLI_MODE=1
    CLI_ACTION="tat"
  fi
else
  lua_chon_NAME
fi

# ==============================================================================
# XÁC NHẬN BẰNG BOX UI & LẤY DANH SÁCH DOMAIN ĐỂ THỰC THI
# ==============================================================================
DOMAIN_LIST=()
wp_action=""
action_text=""
is_success=false

echo ""
if [[ "$NAME" == "TẤT CẢ WEBSITE (Thao tác đồng loạt)" || "$NAME" == "TẤT" || "$NAME" == "all_on" || "$NAME" == "all_off" ]]; then

  if [[ "$NAME" == "all_on" && $CLI_MODE -eq 1 ]]; then
    wp_action="bat"
    action_text="MỞ KHÓA"
  elif [[ "$NAME" == "all_off" && $CLI_MODE -eq 1 ]]; then
    wp_action="tat"
    action_text="TẠM KHÓA"
  else
    # SUB-MENU CHO TÙY CHỌN ĐỒNG LOẠT
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: TRẠNG THÁI WEBSITE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác thay đổi trạng thái cho toàn bộ website trên Server." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    str_opt1="  1) MỞ KHÓA (Kích hoạt lại đồng loạt các website đang khóa)"
    pad_opt1=$((box_inner_width - ${#str_opt1}))
    [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}MỞ KHÓA${C_RESET} (Kích hoạt lại đồng loạt các website đang khóa)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

    str_opt2="  2) TẠM KHÓA (Ngừng hoạt động đồng loạt toàn bộ website)"
    pad_opt2=$((box_inner_width - ${#str_opt2}))
    [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_RED}2)${C_RESET} ${C_BOLD_WHITE}TẠM KHÓA${C_RESET} (Ngừng hoạt động đồng loạt toàn bộ website)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
    read -r mass_choice

    if [[ "$mass_choice" == "1" || "$NAME" == "all_on" ]]; then
      wp_action="bat"
      action_text="MỞ KHÓA"
    elif [[ "$mass_choice" == "2" || "$NAME" == "all_off" ]]; then
      wp_action="tat"
      action_text="TẠM KHÓA"
    else
      echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
      exec /etc/wptt/wptt-domain-main 1
    fi
  fi

  # Quét toàn bộ domain
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    if [[ "$domain" == ?*.?* ]]; then
      DOMAIN_LIST+=("$domain")
    fi
  done

  if [[ ${#DOMAIN_LIST[@]} -eq 0 ]]; then
    echo -e "\n${C_RED}❌ Không có website hợp lệ nào để thao tác!${C_RESET}" && sleep 2 && exit 1
  fi

else
  # ============================================================================
  # XỬ LÝ 1 DOMAIN ĐƠN LẺ
  # ============================================================================
  pathcheck="/etc/wptt/vhost/.$NAME.conf"
  [[ ! -f "$pathcheck" ]] && echo -e "\n${C_RED}Tên miền không tồn tại trên hệ thống này!${C_RESET}" && sleep 2 && exec /etc/wptt/wptt-domain-main 1

  DOMAIN_LIST=("$NAME")
  is_locked=false
  [[ -f "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf.bkwptt" ]] && is_locked=true

  if [[ $CLI_MODE -eq 1 ]]; then
    wp_action="$CLI_ACTION"
    if [[ "$wp_action" == "bat" ]]; then
      action_text="MỞ KHÓA"
    else
      action_text="TẠM KHÓA"
    fi
  else
    # SUB-MENU CHO 1 DOMAIN
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}XÁC NHẬN THAY ĐỔI TRẠNG THÁI WEBSITE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

    if $is_locked; then
      left_text "  Website ${NAME} hiện ĐANG TẠM KHÓA." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      str_opt1="  1) MỞ KHÓA (Kích hoạt lại website hoạt động bình thường)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}MỞ KHÓA${C_RESET} (Kích hoạt lại website hoạt động bình thường)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

      str_opt2="  2) Không làm gì cả (Giữ nguyên trạng thái Tạm khóa)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Giữ nguyên trạng thái Tạm khóa)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice

      if [[ "$single_choice" == "1" ]]; then
        wp_action="bat"
        action_text="MỞ KHÓA"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-domain-main 1
      fi
    else
      left_text "  Website ${NAME} hiện ĐANG BẬT (Hoạt động bình thường)." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      str_opt1="  1) TẠM KHÓA (Ngừng hoạt động website, giữ nguyên dữ liệu)"
      pad_opt1=$((box_inner_width - ${#str_opt1}))
      [[ $pad_opt1 -lt 0 ]] && pad_opt1=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_RED}1)${C_RESET} ${C_BOLD_WHITE}TẠM KHÓA${C_RESET} (Ngừng hoạt động website, giữ nguyên dữ liệu)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

      str_opt2="  2) Không làm gì cả (Hủy thao tác)"
      pad_opt2=$((box_inner_width - ${#str_opt2}))
      [[ $pad_opt2 -lt 0 ]] && pad_opt2=0
      echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}2)${C_RESET} Không làm gì cả (Hủy thao tác)$(printf '%*s' "$pad_opt2" "")${C_CYAN}│${C_RESET}"

      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
      echo -en "${C_CYAN}Nhập lựa chọn của bạn (1-2) [0=Thoát]: ${C_RESET}"
      read -r single_choice

      if [[ "$single_choice" == "1" ]]; then
        wp_action="tat"
        action_text="TẠM KHÓA"
      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-domain-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# LẤY THÔNG TIN NHÓM QUYỀN TRƯỚC KHI CHẠY VÒNG LẶP
# ==============================================================================
if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

# ==============================================================================
# THỰC THI THAY ĐỔI FILE VHOST
# ==============================================================================
echo ""
for DOMAIN in "${DOMAIN_LIST[@]}"; do
  _runing "$action_text cho $DOMAIN"

  if [[ "$wp_action" == "bat" ]]; then
    # Kích hoạt lại (Nếu đang bị khóa thì mới mở)
    if [[ -f "/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf.bkwptt" ]]; then
      mv "/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf.bkwptt" "/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf"
      chown -R lsadm:$tuong_thich_nhom_litespeed "/usr/local/lsws/conf/vhosts/$DOMAIN"
      chmod -R 750 "/usr/local/lsws/conf/vhosts/$DOMAIN"
      is_success=true
    fi
  else
    # Tạm khóa (Nếu đang mở thì mới khóa)
    if [[ -n "$DOMAIN" && -f "/usr/local/lsws/conf/vhosts/$DOMAIN/$DOMAIN.conf" ]]; then
      mv "/usr/local/lsws/conf/vhosts/${DOMAIN:?}/${DOMAIN:?}.conf" "/usr/local/lsws/conf/vhosts/${DOMAIN:?}/${DOMAIN:?}.conf.bkwptt"
      [[ -d "/usr/local/lsws/${DOMAIN:?}/luucache" ]] && rm -rf "/usr/local/lsws/${DOMAIN:?}/luucache"
      is_success=true
    fi
  fi

  echo "$action_text website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cho $DOMAIN"
done

# ==============================================================================
# KHỞI ĐỘNG LẠI DỊCH VỤ VÀ BÁO CÁO (NẾU CÓ THAY ĐỔI)
# ==============================================================================
if $is_success; then
  /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_GREEN}HOÀN TẤT THAY ĐỔI TRẠNG THÁI WEBSITE${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
    left_text "Website thao tác : ${C_YELLOW}Toàn bộ ${#DOMAIN_LIST[@]} website trên Server${C_RESET}" 2
  else
    left_text "Website thao tác : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
  fi

  if [[ "$wp_action" == "bat" ]]; then
    left_text "Trạng thái mới   : ${C_GREEN}Đã MỞ KHÓA. Các website hoạt động bình thường.${C_RESET}" 2
  else
    left_text "Trạng thái mới   : ${C_RED}Đã TẠM KHÓA. Truy cập sẽ bị báo lỗi không tìm thấy.${C_RESET}" 2
  fi
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

else
  echo -e "${C_YELLOW}Không có thay đổi nào được thực hiện.${C_RESET}"
fi

if [[ ${1:-} == "98" ]]; then
  exec /etc/wptt/wptt-domain-main 1
fi
