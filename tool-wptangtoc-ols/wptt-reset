for entry in $(ls -A /etc/wptt/vhost /etc/wptt/vhost_bk /etc/wptt/chuyen-huong 2>/dev/null | awk '!/:$/ && !/^\.\.?$/' | sed '/^$/d' | grep -vE '^\.\.?conf$' | sort -uV); do
  domain=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//')
  path="/usr/local/lsws/$domain/html"

  if [[ -d "$path" ]]; then
    [[ -f "/etc/wptt/vhost/.$domain.conf" ]] && . "/etc/wptt/vhost/.$domain.conf"
    [[ -f "/etc/wptt/vhost_bk/.$domain.conf" ]] && . "/etc/wptt/vhost_bk/.$domain.conf"

