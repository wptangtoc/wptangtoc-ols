function huong_dan() {
  Tính năng Factory Reset LiteSpeed Webserver [Khôi phục cài đặt gốc cho LiteSpeed Webserver]
}

. /etc/wptt/echo-color
# ==============================================================================
# HỆ THỐNG MÀU SẮC GIAO DIỆN (UX)
# ==============================================================================
