C_GREEN='\e[1;32m'
C_YELLOW='\e[1;33m'
C_CYAN='\e[1;36m'
C_WHITE='\e[1;37m'
C_RESET='\e[0m'

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_CYAN}${C_RESET} ${C_YELLOW}WPTANGTOC OLS ➜ FACTORY RESET LITESPEED${C_RESET}${C_CYAN}${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
echo ""


echo -e "\n${C_CYAN}Đang khởi tạo tiến trình Factory Reset...${C_RESET}"
echo "Reset toàn bộ cấu hình webserver : $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

if [[ $1 = '98' ]];then #xác nhận thông qua menu phải yêu cầu hỏi nguời dùng cho chắc
	if ! wptt_xac_nhan "Bạn có muốn Khôi phục cấu hình vhost và server.conf của LiteSpeed không?" "Tính năng này sẽ XÓA SẠCH toàn bộ cấu hình LiteSpeed hiện tại.." "sẽ được khôi phục về trạng thái nguyên bản lúc mới cài đặt WPTangToc OLS" "Đồng ý khôi phục" "Hủy thao tác"; then
		[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-add-one-main 1
		exit 0
	fi
fi


# ==============================================================================
# BƯỚC 1: TÍNH TOÁN TÀI NGUYÊN
# ==============================================================================
echo -e "${C_YELLOW}➤ [1/5] Đang phân tích và đo lường tài nguyên phần cứng...${C_RESET}"

work_cpucore='1024'
cpucore=$(grep -c ^processor /proc/cpuinfo)
max_client=$(( work_cpucore * cpucore * 2 ))
max_client_max=$(( work_cpucore * cpucore * 3 ))
max_client_php=$(( work_cpucore * cpucore / 8 ))

tong_ram_byte=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
rong_ram_mb=$(echo "scale=0;${tong_ram_byte}/1024" | bc)
[[ -z "$rong_ram_mb" ]] && rong_ram_mb="2048"
tong_ram_mb_db=$(echo "scale=0;${rong_ram_mb}/4" | bc)

gioi_han_tien_trinh_bao_loi_503=$(( max_client / 8 ))
core_tien_lsphp_child=$(( cpucore * 2 ))

if [[ -n "${Website_chinh:-}" ]]; then
  NAME="$Website_chinh"
else
  NAME=$(ls -A /etc/wptt/vhost 2>/dev/null | grep -vE '^\.\.?conf$' | sort -uV | sed 's/^.//' | sed 's/.conf//' | head -1)
fi

if [[ -z "$NAME" ]]; then
  echo -e "${C_RED}❌ Lỗi nghiêm trọng: Không xác định được tên miền chính hợp lệ.${C_RESET}"
  exit 1
fi

USER="wptangtocusernamedemo"
NAMEPHP=${NAME//[-._]/}
USERCLEAN="$USER"

if grep -q -i "ubuntu" /etc/os-release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

TOTAL_RAM_MB=$(free -m | awk '/^Mem:/{print $2}')
if [ "$TOTAL_RAM_MB" -le 1200 ]; then
  KA_TIMEOUT="15"
  KA_REQS="1000"
elif [ "$TOTAL_RAM_MB" -le 4500 ]; then
  KA_TIMEOUT="45"
  KA_REQS="5000"
else
