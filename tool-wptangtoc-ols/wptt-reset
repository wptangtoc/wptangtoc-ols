chown -R lsadm:$tuong_thich_nhom_litespeed "/usr/local/lsws/conf/vhosts/$NAME"
chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME"

phpcheck2223=$(php -v | grep cli | grep -oP 'PHP \K[0-9]+\.[0-9]+' | head -1 | sed 's/ //g')
php_ver_chon=${phpcheck2223//[-._]/}

sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" /usr/local/lsws/conf/httpd_config.conf
sed -E -i "s|/lsphp[0-9]+/bin/lsphp|/lsphp${php_ver_chon}/bin/lsphp|g" "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
sed -i "/$NAME $NAME/d" /usr/local/lsws/conf/httpd_config.conf

if [ "$(ls -A /etc/wptt/vhost /etc/wptt/vhost_bk /etc/wptt/chuyen-huong 2>/dev/null | awk '!/:$/ && !/^\.\.?$/' | sed '/^$/d' | grep -vE '^\.\.?conf$' | sort -uV)" ]; then
  for entry in $(ls -A /etc/wptt/vhost /etc/wptt/vhost_bk /etc/wptt/chuyen-huong 2>/dev/null | awk '!/:$/ && !/^\.\.?$/' | sed '/^$/d' | grep -vE '^\.\.?conf$' | sort -uV); do
    domain=$(echo "$entry" | sed 's/^.//' | sed 's/.conf//')
    path="/usr/local/lsws/$domain/html"
    
    if [[ -d "$path" ]]; then
      sed -i "/listener http/a map \t\t$domain $domain" /usr/local/lsws/conf/httpd_config.conf
      mkdir -p "/usr/local/lsws/conf/vhosts/$domain"
      \cp -f "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf" "/usr/local/lsws/conf/vhosts/$domain/$domain.conf" 2>/dev/null
      sed -i "s/$NAME/$domain/g" "/usr/local/lsws/conf/vhosts/$domain/$domain.conf"
      chown -R lsadm:$tuong_thich_nhom_litespeed "/usr/local/lsws/conf/vhosts/$domain"
      chmod -R 750 "/usr/local/lsws/conf/vhosts/$domain"
    fi
  done
