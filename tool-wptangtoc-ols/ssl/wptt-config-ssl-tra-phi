#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026 - Enterprise Standard

function huong_dan() {
  cat <<'EOF'
  Tính năng Cài đặt SSL trả phí là quá trình trang bị cho website của bạn một chứng chỉ SSL/TLS thương mại [mua từ các nhà cung cấp như DigiCert, Sectigo, GlobalSign,...] để kích hoạt giao thức HTTPS, đảm bảo kết nối mã hóa và xác thực danh tính website ở mức độ cao hơn.

  Mục Đích Chính
  * Xác thực danh tính mạnh mẽ [đặc biệt với OV/EV].
  * Bảo mật dữ liệu: Mã hóa toàn bộ thông tin trao đổi giữa người dùng và website.
  * Tăng uy tín và niềm tin: Khách hàng an tâm hơn khi giao dịch.
  * Hỗ trợ tương thích ngược tốt hơn với các thiết bị đời cũ.
EOF
}

# Tránh kẹt thư mục làm việc khi thực thi
cd /root 2>/dev/null || cd /

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

if [[ "${1:-}" == "98" ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-ssl-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl:-Quản lý SSL} ➜ Khởi tạo & Cấu hình SSL Trả phí (Paid SSL)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME="${1:-}"
no_key="${2:-}"
[[ "$NAME" == "98" ]] && NAME=""

# ==============================================================================
# HÀM MENU CHỌN DOMAIN (UX BO CONG CHUẨN 78PX)
# ==============================================================================
function lua_chon_NAME() {
  unset NAME selects
  selects=()
  local box_inner_width=${box_inner_width:-78}

  local file_list=()
  [[ -d /etc/wptt/vhost ]] && file_list+=(/etc/wptt/vhost/.*.conf)
  [[ -d /etc/wptt/chuyen-huong ]] && file_list+=(/etc/wptt/chuyen-huong/.*.conf)

  for filepath in "${file_list[@]}"; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" || "$filepath" == *"*"* ]] && continue

    local dom="${filepath##*/}"
    dom="${dom%.conf}"
    dom="${dom#.}"

    if [[ "$dom" == ?*.?* ]]; then
      local vhost_conf="/usr/local/lsws/conf/vhosts/$dom/$dom.conf"
      if [[ -f "$vhost_conf" ]]; then
        if [[ -d "/usr/local/lsws/$dom/ssl" ]]; then
          selects+=("$dom|1")
        else
          selects+=("$dom|0")
        fi
      fi
    fi
  done

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "${C_YELLOW}⚠️ Không tìm thấy website nào trên hệ thống để thao tác!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-ssl-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Chọn Website muốn kích hoạt SSL trả phí / Custom SSL:"
  local len
  len=$(echo -n "$title_text" | awk '{print length($0)}')
  local pad_r=$((box_inner_width - len - 2))
  ((pad_r < 0)) && pad_r=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  ((pad_line_r < 0)) && pad_line_r=0
  local short_line
  short_line=$(printf "%${line_len}s" "" | tr ' ' '─')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  local i=1
  for item in "${selects[@]}"; do
    local dom
    dom=$(echo "$item" | cut -d'|' -f1)
    local stt
    stt=$(echo "$item" | cut -d'|' -f2)

    local color_stt="${C_GREEN}[Đã có thư mục SSL]"
    local clean_stt="[Đã có thư mục SSL]"
    if [[ "$stt" == "0" ]]; then
      color_stt="${C_YELLOW}[Chưa thiết lập]"
      clean_stt="[Chưa thiết lập]"
    fi

    local item_text
    item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-30s${C_RESET} %s" "$i" "$dom" "${color_stt}${C_RESET}")
    local clean_text
    clean_text=$(printf "  %3d) %-30s %s" "$i" "$dom" "$clean_stt")
    local item_len
    item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
    local pad=$((box_inner_width - item_len))
    ((pad < 0)) && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  if command -v fzf &>/dev/null; then
    fzf_installed=true
    PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
  else
    PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
  fi

  while true; do
    echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0)
      echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
      NAME="0"
      return 0
      ;;
    00)
      if $fzf_installed; then
        local selected_item
        selected_item=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
        local extracted_data
        extracted_data=$(echo "$selected_item" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//')
        if [[ -n "$extracted_data" ]]; then
          NAME=$(echo "$extracted_data" | cut -d'|' -f1)
          return 0
        else
          echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"
        fi
      else
        echo -e "${C_RED}Lỗi: FZF chưa cài đặt.${C_RESET}"
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((REPLY >= 1 && REPLY <= ${#selects[@]})); then
        local action_index=$((REPLY - 1))
        local extracted_data="${selects[$action_index]}"
        NAME=$(echo "$extracted_data" | cut -d'|' -f1)
        return 0
      else
        echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
      fi
      ;;
    esac
  done
}

if [[ -z "$NAME" ]]; then
  lua_chon_NAME
fi

NAME=$(echo "$NAME" | awk '{print $1}')
[[ "$NAME" == "0" || -z "$NAME" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
  return 2>/dev/null || exit 0
}

path="/etc/wptt/vhost/.${NAME}.conf"
path_redirect="/etc/wptt/chuyen-huong/.${NAME}.conf"
if [[ ! -f "$path" && ! -f "$path_redirect" ]]; then
  echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
  exit 1
fi

wptt_logs "INFO" "Thiết lập cài đặt ssl trả phí website $NAME" 2>/dev/null || true
thu_muc_ssl_tra_phi="/usr/local/lsws/$NAME/ssl"
mkdir -p "$thu_muc_ssl_tra_phi"
chown -hR nobody:nobody "$thu_muc_ssl_tra_phi" 2>/dev/null || true

# ==============================================================================
# BƯỚC 1: TẠO PRIVATE KEY VÀ CSR (NẾU CHƯA CÓ)
# ==============================================================================
dongy2="n"
if [[ -z "$no_key" && ! -f "$thu_muc_ssl_tra_phi/$NAME.key" ]]; then
  echo ""
  if wptt_xac_nhan "Bạn có muốn hệ thống tự tạo Private Key (.key) và mã CSR không?" \
    "${C_BOLD_WHITE}Gợi ý:${C_RESET} Chọn [Có] nếu bạn chưa mua SSL và cần mã CSR để gửi cho nhà cung cấp." \
    "" "Có (Tự động tạo)" "Không cần"; then
    dongy2="y"
  fi
fi

if [[ "$dongy2" == "y" ]]; then
  echo ""
  _runing "Đang khởi tạo mã hóa RSA 2048-bit cho Private Key và CSR..."
  openssl req -new -newkey rsa:2048 -nodes \
    -keyout "$thu_muc_ssl_tra_phi/$NAME.key" \
    -out "$thu_muc_ssl_tra_phi/$NAME.csr" \
    -subj "/C=VN/ST=Hai Phong/L=Hai Phong/O=WPTangToc OLS/CN=${NAME}/emailAddress=admin@${NAME}" >/dev/null 2>&1
  chmod 600 "$thu_muc_ssl_tra_phi/$NAME.key"
  _rundone "Khởi tạo Key và CSR thành công"
fi

# ==============================================================================
# BƯỚC 2: QUÉT & CHUẨN HÓA FILE (NATIVE GLOBBING - KHÔNG CD / KHÔNG LS)
# ==============================================================================
echo ""
_runing "Đang quét và tự động chuẩn hóa các tệp tin SSL..."

# 1. Chuẩn hóa Private Key: Nếu chưa có $NAME.key, tìm file .key bất kỳ đổi tên
if [[ ! -f "$thu_muc_ssl_tra_phi/$NAME.key" ]]; then
  for k in "$thu_muc_ssl_tra_phi"/*.key; do
    if [[ -f "$k" ]]; then
      /bin/mv -f "$k" "$thu_muc_ssl_tra_phi/$NAME.key"
      break
    fi
  done
fi

# 2. Chuẩn hóa Certificate chính: Tìm file .crt chứa dấu gạch dưới hoặc tên domain
if [[ ! -f "$thu_muc_ssl_tra_phi/cert.crt" ]]; then
  for c in "$thu_muc_ssl_tra_phi"/*.crt; do
    [[ ! -f "$c" || "$c" == *"ca_bundle.crt" ]] && continue
    local_bname=$(basename "$c")
    if [[ "$local_bname" == *"_"* || "$local_bname" == *"$NAME"* ]]; then
      /bin/mv -f "$c" "$thu_muc_ssl_tra_phi/cert.crt"
      break
    fi
  done
fi

# 3. Chuẩn hóa CA Bundle: Ưu tiên file .ca-bundle
if [[ ! -f "$thu_muc_ssl_tra_phi/ca_bundle.crt" ]]; then
  for b in "$thu_muc_ssl_tra_phi"/*.ca-bundle "$thu_muc_ssl_tra_phi"/*bundle*.crt; do
    if [[ -f "$b" && "$b" != "$thu_muc_ssl_tra_phi/cert.crt" ]]; then
      /bin/mv -f "$b" "$thu_muc_ssl_tra_phi/ca_bundle.crt"
      break
    fi
  done
fi

# 4. Tự động gộp nếu người dùng upload nhiều file .crt trung gian lẻ
if [[ ! -f "$thu_muc_ssl_tra_phi/ca_bundle.crt" ]]; then
  tmp_bundle="$thu_muc_ssl_tra_phi/.bundle_tmp"
  /bin/rm -f "$tmp_bundle"
  for crt_file in "$thu_muc_ssl_tra_phi"/*.crt; do
    [[ ! -f "$crt_file" || "$crt_file" == "$thu_muc_ssl_tra_phi/cert.crt" ]] && continue
    cat "$crt_file" >>"$tmp_bundle"
    echo "" >>"$tmp_bundle"
    /bin/rm -f "$crt_file"
  done
  [[ -s "$tmp_bundle" ]] && /bin/mv -f "$tmp_bundle" "$thu_muc_ssl_tra_phi/ca_bundle.crt"
  /bin/rm -f "$tmp_bundle" 2>/dev/null || true
fi

_rundone "Quét thư mục và chuẩn hóa tệp tin hoàn tất"

# ==============================================================================
# BƯỚC 3: KIỂM ĐỊNH TÍNH TOÀN VẸN VÀ KHỚP KHÓA (CRYPTOGRAPHIC PRE-FLIGHT)
# ==============================================================================
has_key=0
has_cert=0
has_ca=0

[[ -f "$thu_muc_ssl_tra_phi/$NAME.key" ]] && {
  has_key=1
  chmod 600 "$thu_muc_ssl_tra_phi/$NAME.key"
  stt_key="${C_GREEN}Đã tìm thấy${C_RESET}"
} || stt_key="${C_RED}❌ Đang thiếu${C_RESET}"

[[ -f "$thu_muc_ssl_tra_phi/cert.crt" ]] && {
  has_cert=1
  stt_cert="${C_GREEN}Đã tìm thấy${C_RESET}"
} || stt_cert="${C_RED}❌ Đang thiếu${C_RESET}"

[[ -f "$thu_muc_ssl_tra_phi/ca_bundle.crt" ]] && {
  has_ca=1
  stt_ca="${C_GREEN}Đã tìm thấy${C_RESET}"
} || stt_ca="${C_RED}❌ Đang thiếu${C_RESET}"

total_files=$((has_key + has_cert + has_ca))

# Kiểm tra cặp khóa (Modulus Match) chống lỗi cấp nhầm cert
keys_matched=true
if ((total_files == 3)); then
  mod_key=$(openssl rsa -noout -modulus -in "$thu_muc_ssl_tra_phi/$NAME.key" 2>/dev/null | openssl md5 2>/dev/null | awk '{print $NF}')
  mod_crt=$(openssl x509 -noout -modulus -in "$thu_muc_ssl_tra_phi/cert.crt" 2>/dev/null | openssl md5 2>/dev/null | awk '{print $NF}')

  if [[ -n "$mod_key" && -n "$mod_crt" && "$mod_key" != "$mod_crt" ]]; then
    keys_matched=false
  fi
fi

# ==============================================================================
# BƯỚC 4: KÍCH HOẠT CẤU HÌNH (ATOMIC TRANSACTIONS)
# ==============================================================================
if ((total_files == 3)) && $keys_matched; then
  _runing "Thiết lập cấu hình SSL trả phí vào Virtualhost..."

  # 1. ĐẢM BẢO LISTENER PORT 443 LUÔN DÙNG SSL TỰ KÝ 10 NĂM LÀM ĐẠI DIỆN BẤT TỬ
  ols_conf="/usr/local/lsws/conf/httpd_config.conf"
  if [[ -f "$ols_conf" ]]; then
    ssl_tuky_dir="/etc/wptt-ssl-tu-ky/${Website_chinh:-$NAME}"
    if [[ ! -f "${ssl_tuky_dir}/${Website_chinh:-$NAME}.key" || ! -f "${ssl_tuky_dir}/cert.crt" ]]; then
      mkdir -p "$ssl_tuky_dir"
      openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "${ssl_tuky_dir}/${Website_chinh:-$NAME}.key" \
        -out "${ssl_tuky_dir}/cert.crt" \
        -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTangToc OLS/CN=${Website_chinh:-$NAME}" >/dev/null 2>&1
    fi

    # Cập nhật Listener trong httpd_config.conf nguyên tử
    tmp_ols=$(wptt_atomic_begin "$ols_conf")
    if [[ -n "$tmp_ols" ]]; then
      sed -i "/keyFile/d; /certFile/d; /CACertFile/d" "$tmp_ols"
      sed -i "/https/a \  keyFile               ${ssl_tuky_dir}/${Website_chinh:-$NAME}.key\n  certFile              ${ssl_tuky_dir}/cert.crt" "$tmp_ols"
      wptt_atomic_commit "$tmp_ols" "$ols_conf"
    fi
  fi

  # 2. CẬP NHẬT CẤU HÌNH VHOST NGUYÊN TỬ (ATOMIC EDIT)
  vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
  if [[ -f "$vhost_conf" ]]; then
    tmp_vhost=$(wptt_atomic_begin "$vhost_conf")
    if [[ -n "$tmp_vhost" ]]; then
      sed -i -e '/^[[:space:]]*vhssl[[:space:]]*{/,/^[[:space:]]*}[[:space:]]*$/d' "$tmp_vhost"
      cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 /usr/local/lsws/$NAME/ssl/$NAME.key
  certFile                /usr/local/lsws/$NAME/ssl/cert.crt
  certChain               0
  CACertFile              /usr/local/lsws/$NAME/ssl/ca_bundle.crt
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
      wptt_atomic_commit "$tmp_vhost" "$vhost_conf"
    fi
  fi

  # 3. CẤU HÌNH REDIRECT HTTPS TRONG .HTACCESS NGUYÊN TỬ
  path2="/usr/local/lsws/$NAME/html/.htaccess"
  if [[ -f "$path2" ]]; then
    tmp_ht=$(wptt_atomic_begin "$path2")
    if [[ -n "$tmp_ht" ]]; then
      sed -i -e '/^#begin-chuyen-huong-http-to-https-wptangtoc-ols/,/^#end-chuyen-huong-http-to-https-wptangtoc-ols$/d' "$tmp_ht"
      sed -i -e '/^#begin-chuyen-huong-www-to-non-www-wptangtoc-ols/,/^#end-chuyen-huong-www-to-non-www-wptangtoc-ols$/d' "$tmp_ht"
      sed -i -e '/^#begin-chuyen-huong-non-www-to-www-wptangtoc-ols/,/^#end-chuyen-huong-non-www-to-www-wptangtoc-ols$/d' "$tmp_ht"

      sed -i '1 i #begin-chuyen-huong-http-to-https-wptangtoc-ols\
RewriteCond %{HTTPS} !=on\
RewriteRule ^(.*)$ https:\/\/%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]\
#end-chuyen-huong-http-to-https-wptangtoc-ols' "$tmp_ht"

      checkdns=$(host "$NAME" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
      checkdnscname=$(host "www.$NAME" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
      if [[ -n "$checkdns" && "$checkdns" == "$checkdnscname" ]]; then
        sed -i '1 i #begin-chuyen-huong-www-to-non-www-wptangtoc-ols\
RewriteCond %{HTTP_HOST} ^www.'"$NAME"' [NC]\
RewriteRule ^(.*)$ https:\/\/'"$NAME"'/$1 [L,R=301,NC]\
#end-chuyen-huong-www-to-non-www-wptangtoc-ols' "$tmp_ht"
      fi

      wptt_atomic_commit "$tmp_ht" "$path2"
    fi
  fi

  _rundone "Cập nhật Vhost và Htaccess hoàn tất"

  _runing "Khởi động lại dịch vụ OpenLiteSpeed..."
  wptt_smart_reload_lsws >/dev/null 2>&1
  _rundone "Máy chủ đã nhận diện chứng chỉ SSL mới"

  # BÁO CÁO THÀNH CÔNG
  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HOÀN TẤT KÍCH HOẠT SSL TRẢ PHÍ (CUSTOM SSL)${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website      : ${C_YELLOW}$NAME${C_RESET}" 2
  left_text "Private Key  : $stt_key" 2
  left_text "Certificate  : $stt_cert" 2
  left_text "CA Bundle    : $stt_ca" 2
  left_text "Listener 443 : ${C_GREEN}Bảo vệ độc lập bằng SSL Tự Ký${C_RESET}" 2
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Chứng chỉ SSL của bạn đã được kiểm định hợp lệ và kích hoạt thành công!" 2
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

else
  # ==============================================================================
  # HỖ TRỢ VÀ HƯỚNG DẪN KHI THIẾU FILE HOẶC KHÔNG KHỚP KHÓA
  # ==============================================================================
  if [[ "$dongy2" == "y" && -f "$thu_muc_ssl_tra_phi/$NAME.csr" ]]; then
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}MÃ CSR XÁC THỰC CỦA BẠN (CERTIFICATE SIGNING REQUEST)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hãy COPY toàn bộ đoạn mã bên dưới và cung cấp cho nhà cung cấp SSL:" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "${C_YELLOW}"
    cat "$thu_muc_ssl_tra_phi/$NAME.csr"
    echo -e "${C_RESET}\n"
  fi

  if ! $keys_matched; then
    echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}CẢNH BÁO: PRIVATE KEY VÀ CERTIFICATE KHÔNG TRÙNG KHỚP!${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Mã băm Modulus của Private Key và Certificate không giống nhau." 2
    left_text "Nguyên nhân: File cert.crt được cấp từ một mã CSR hoặc Private Key khác!" 2
    left_text "Giải pháp: Hãy tải đúng Private Key đã dùng để mua chứng chỉ này lên." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  fi

  echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HƯỚNG DẪN BƯỚC TIẾP THEO (CHƯA ĐỦ FILE ĐỂ KÍCH HOẠT)${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Trạng thái file trong thư mục:" 2
  left_text "- Private Key  : $stt_key" 2
  left_text "- Certificate  : $stt_cert" 2
  left_text "- CA Bundle    : $stt_ca" 2
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Vui lòng upload các file chứng chỉ vào đúng thư mục sau:" 2
  center_text "${C_YELLOW}/usr/local/lsws/$NAME/ssl/${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Quy ước đặt tên file chuẩn:" 2
  left_text "1. Private Key : ${NAME}.key (Khóa bí mật tạo kèm với CSR)" 2
  left_text "2. Certificate : cert.crt (File chứng chỉ cấp riêng cho domain)" 2
  left_text "3. CA Bundle   : ca_bundle.crt (Hoặc các file *.ca-bundle của hãng)" 2
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Sau khi upload xong, chạy lại lệnh sau để hệ thống tự động kích hoạt:" 2
  center_text "${C_GREEN}wptt ssl-tra-phi-config $NAME${C_RESET}"
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-ssl-main 1
fi
