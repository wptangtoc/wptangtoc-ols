echo ""
if wptt_xac_nhan "Bạn có muốn hệ thống tự tạo Private Key (.key) và mã CSR không?" \
  "${C_BOLD_WHITE}Gợi ý:${C_RESET} Chọn [Có] nếu bạn chưa có CSR để gửi cho nhà cung cấp SSL." \
  "Nếu bạn đã có sẵn bộ file (.key, .crt, .ca-bundle) trên máy tính, hãy chọn [Không cần]." \
  "Có (Tự động tạo CSR)" "Không cần (Đã có sẵn)"; then
  dongy2="y"
fi

if [[ "$dongy2" == "y" ]]; then
  echo -e "\n${C_CYAN}Chọn thuật toán mã hóa cho chứng chỉ SSL:${C_RESET}"
  echo -e " [1] ${C_GREEN}RSA 2048-bit${C_RESET} (Khuyên dùng - Tương thích 100% mọi nhà cung cấp)"
  echo -e " [2] ${C_YELLOW}RSA 4096-bit${C_RESET} (Bảo mật cao nhất - Tiêu tốn CPU máy chủ hơn)"
  echo -e " [3] ${C_CYAN}ECDSA P-256${C_RESET}  (Hiệu năng tối đa - Siêu nhẹ, tốc độ tốt nhất)"
  echo ""

  ssl_algo_choice=""
  _safe_prompt_input "Nhập lựa chọn của bạn [Mặc định 1]: " ssl_algo_choice
  ssl_algo_choice="${ssl_algo_choice//[[:space:]]/}"
  ssl_algo_choice="${ssl_algo_choice:-1}"

  case "$ssl_algo_choice" in
  2) algo_name="RSA 4096-bit" ;;
  3) algo_name="ECDSA P-256" ;;
  *) algo_name="RSA 2048-bit" ;;
  esac

  UI_TASK="Khởi tạo Private Key & CSR mã hóa ($algo_name) cho $NAME"
  _runing "$UI_TASK"

  subj_string="/C=VN/ST=Hai Phong/L=Hai Phong/O=$NAME/OU=$NAME/CN=$NAME/emailAddress=admin@${NAME}"

  old_umask=$(umask)
  umask 077

  case "$ssl_algo_choice" in
  2)
    openssl req -new -newkey rsa:4096 -nodes \
      -keyout "$key_file" -out "$csr_file" -subj "$subj_string" \
      -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1 || true
    ;;
  3)
    openssl ecparam -name prime256v1 -genkey -noout -out "$key_file" >/dev/null 2>&1 || true
    openssl req -new -key "$key_file" -out "$csr_file" -subj "$subj_string" \
      -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1 || true
    ;;
  *)
    openssl req -new -newkey rsa:2048 -nodes \
      -keyout "$key_file" -out "$csr_file" -subj "$subj_string" \
      -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1 || true
    ;;
  esac

  umask "$old_umask"
  [[ -f "$key_file" ]] && /bin/chmod 600 -- "$key_file"
  [[ -f "$csr_file" ]] && /bin/chmod 644 -- "$csr_file"

  if [[ -s "$csr_file" && -s "$key_file" ]]; then
    _rundone "$UI_TASK"

    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}MÃ CSR XÁC THỰC CỦA BẠN (CERTIFICATE SIGNING REQUEST)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hãy COPY toàn bộ đoạn mã bên dưới và gửi cho nhà cung cấp SSL:" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    echo -e "${C_YELLOW}"
    cat "$csr_file"
    echo -e "${C_RESET}\n"
  else
    _runloi "$UI_TASK"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi
fi

# ==============================================================================
# TÙY CHỌN NHANH: DÁN TRỰC TIẾP CHỨNG CHỈ NGAY TRÊN TERMINAL (KHÔNG CẦN SFTP)
# ==============================================================================
if [[ -s "$key_file" ]]; then
  if wptt_xac_nhan "Nhà cung cấp đã cấp chứng chỉ (.crt) cho bạn chưa?" \
    "Nếu đã có mã chứng chỉ, bạn có thể DÁN (Paste) trực tiếp ngay tại đây để kích hoạt luôn" \
    "mà không cần mở phần mềm SFTP/File Manager để upload file!" \
    "Đã có (Dán mã kích hoạt ngay)" "Chưa có (Tôi sẽ upload file sau)"; then

    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    tmp_cert_paste="$(mktemp -p /etc/wptt/tmp cert_paste_XXXXXX.crt)"
    tmp_ca_paste="$(mktemp -p /etc/wptt/tmp ca_paste_XXXXXX.crt)"

    echo -e "\n${C_CYAN}➤ Bước 1: Hãy DÁN nội dung Chứng chỉ chính (${C_YELLOW}cert.crt${C_CYAN}) vào bên dưới:${C_RESET}"
    echo -e "${C_GREEN}(Hệ thống sẽ tự động chuyển bước ngay khi thấy dòng -----END CERTIFICATE-----):${C_RESET}"
    _read_pem_from_terminal "$tmp_cert_paste" 1

    echo -e "\n${C_CYAN}➤ Bước 2: Hãy DÁN nội dung Chứng chỉ Trung gian (${C_YELLOW}ca_bundle.crt${C_CYAN}) vào bên dưới:${C_RESET}"
    echo -e "${C_GREEN}(Dán xong hãy nhấn phím ${C_YELLOW}Enter 2 lần${C_GREEN} để hoàn tất, hoặc nhấn Enter 2 lần để bỏ qua):${C_RESET}"
    _read_pem_from_terminal "$tmp_ca_paste" 0

    task_verify="Kiểm tra cặp khóa Toán học (Private Key & Certificate Match)"
    _runing "$task_verify"

    if _verify_key_cert_match "$key_file" "$tmp_cert_paste"; then
      /bin/cp -f -- "$tmp_cert_paste" "$cert_file"
      /bin/chmod 644 -- "$cert_file" 2>/dev/null || true

      if [[ -s "$tmp_ca_paste" ]] && grep -q "BEGIN CERTIFICATE" "$tmp_ca_paste" 2>/dev/null; then
        /bin/cp -f -- "$tmp_ca_paste" "$ca_file"
        /bin/chmod 644 -- "$ca_file" 2>/dev/null || true
        cat "$cert_file" "$ca_file" >"$ssl_dir/fullchain.pem" 2>/dev/null || true
      fi

      _apply_paid_vhssl_config "$NAME"
      if [[ -x /etc/wptt/ssl/wptt-renew-chuyen-huong ]]; then
        /bin/bash /etc/wptt/ssl/wptt-renew-chuyen-huong "$NAME" >/dev/null 2>&1 || true
      fi
      declare -F wptt_smart_reload_lsws >/dev/null 2>&1 && wptt_smart_reload_lsws >/dev/null 2>&1
      _rundone "$task_verify"

      echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}KÍCH HOẠT SSL TRẢ PHÍ THÀNH CÔNG 100%!${C_RESET}"
      echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "Chứng chỉ SSL và Private Key khớp nhau hoàn hảo." 2
      left_text "Website ${C_YELLOW}$NAME${C_RESET} đã được nạp chứng chỉ mới (Zero-Downtime)." 2
      echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
      wptt_quay_ve_menu "$route_arg" 0 "enter"
    else
      _runloi "$task_verify"
      echo -e "\n${C_RED}❌ LỖI: Chứng chỉ bạn vừa dán KHÔNG KHỚP với Private Key ($key_file) hoặc bị lỗi cú pháp PEM!${C_RESET}"
      echo -e "${C_YELLOW}Hệ thống đã chặn việc ghi vào Vhost để bảo vệ OpenLiteSpeed không bị lỗi.${C_RESET}\n"
    fi
  fi
fi

