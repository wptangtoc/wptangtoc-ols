# ==============================================================================
# MODULE PHÂN TÍCH LOG CERTBOT CHUYÊN SÂU (HỌC TỪ WPTT-CAISSL)
# ==============================================================================
_diagnose_certbot_failure() {
  local domain="$1"
  local recent_log="$2"
  local log_file="/var/log/letsencrypt/letsencrypt.log"

  echo -e "\n${C_RED}❌ Lỗi: Không thể cấp phát chứng chỉ SSL qua ACME cho '$domain'!${C_RESET}"

  # 1. Lỗi sai khóa EAB (KID / HMAC Key)
  if grep -Eqi "externalAccountRequired|eab|HMAC|binding|unauthorized.*account" <<<"$recent_log"; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}TỪ CHỐI CẤP PHÁT: MÃ EAB (KID / HMAC KEY) KHÔNG HỢP LỆ${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " - Mã EAB Key ID (keyId) hoặc EAB HMAC Key (b64MacKey) bị sai hoặc đã dùng rồi." 2
    left_text " - Với Google Trust Services / Sectigo / DigiCert, mỗi mã EAB chỉ được dùng" 2
    left_text "   1 lần duy nhất để đăng ký tài khoản ACME." 2
    left_text " - ${C_GREEN}Giải pháp:${C_RESET} Hãy tạo lại (Create / Regenerate) mã EAB mới rồi thử lại." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 0
  fi

  # 2. Lỗi chặn bản ghi CAA (Rất hay gặp với Google Trust Services nếu domain có cài CAA)
  if grep -Eqi "caa|Forbidden by CAA" <<<"$recent_log"; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}TỪ CHỐI CẤP PHÁT: BẢN GHI DNS CAA CHẶN NHÀ CUNG CẤP SSL${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " - Tên miền ${C_YELLOW}$domain${C_RESET} đang có bản ghi DNS loại CAA chặn không cho CA này cấp SSL." 2
    left_text " - ${C_GREEN}Giải pháp:${C_RESET} Vào quản lý DNS xóa bản ghi CAA cũ hoặc thêm bản ghi CAA cho phép" 2
    left_text "   ${C_CYAN}pki.goog${C_RESET} (nếu dùng Google) hoặc ${C_CYAN}sectigo.com${C_RESET} (nếu dùng ZeroSSL/Sectigo)." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 0
  fi

  # 3. Lỗi chặn truy cập file xác thực .well-known (403 / 404 / Unauthorized)
  if grep -Eqi "unauthorized|Invalid response from|404 Not Found|403 Forbidden" <<<"$recent_log"; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}TỪ CHỐI CẤP PHÁT: KHÔNG THỂ ĐỌC FILE XÁC THỰC (UNAUTHORIZED 403/404)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " - Tổ chức CA đã kết nối tới máy chủ nhưng bị chặn khi đọc thư mục" 2
    left_text "   ${C_YELLOW}/.well-known/acme-challenge/${C_RESET} (Lỗi 403 hoặc 404)." 2
    left_text " - ${C_RED}Thủ phạm thường gặp:${C_RESET}" 2
    left_text "   1. File ${C_YELLOW}.htaccess${C_RESET} có quy tắc chặn truy cập thư mục ẩn (bắt đầu bằng dấu chấm)." 2
    left_text "   2. Đang bật Tường lửa WAF (Cloudflare Bot Fight Mode / Wordfence)." 2
    left_text " - ${C_GREEN}Giải pháp:${C_RESET} Tạm thời tắt WAF hoặc kiểm tra lại file .htaccess rồi thử lại." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 0
  fi

  # 4. Lỗi kết nối Timeout / Firewall chặn Port 80 quốc tế
  if grep -Eqi "Timeout after connect|Timeout during connect|Connection refused" <<<"$recent_log"; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}TỪ CHỐI CẤP PHÁT: HỆ THỐNG BỊ CHẶN KẾT NỐI QUỐC TẾ (TIMEOUT PORT 80)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " - Máy chủ xác thực của CA (đặt tại Mỹ/Châu Âu) không thể kết nối vào" 2
    left_text "   Port 80 trên VPS của bạn." 2
    left_text " - ${C_GREEN}Giải pháp:${C_RESET} Kiểm tra tường lửa VPS hoặc liên hệ nhà cung cấp mở Port 80" 2
    left_text "   cho phép IP quốc tế truy cập." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 0
  fi

  # 5. Lỗi Rate Limit
  if grep -Eqi "rateLimited|too many certificates|too many failed authorizations" <<<"$recent_log"; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}TỪ CHỐI CẤP PHÁT: CHẠM NGƯỠNG GIỚI HẠN (RATE LIMIT)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " - Tên miền ${C_YELLOW}$domain${C_RESET} đã gửi quá nhiều yêu cầu xác thực lỗi liên tiếp." 2
    left_text " - Vui lòng chờ ít nhất 1 giờ trước khi thử cấp phát lại." 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 0
  fi

  # Tùy chọn mở trình đọc log nếu rơi vào các lỗi khác
  if [[ -f "$log_file" ]]; then
    echo -e "Chi tiết lỗi được ghi tại: ${C_YELLOW}$log_file${C_RESET}"
    if wptt_xac_nhan "Bạn có muốn mở xem trực tiếp file log (letsencrypt.log) để dò lỗi không?" \
      "Nhấn phím [q] để thoát khỏi trình đọc log." "" "Đồng ý (Xem log)" "Bỏ qua"; then
      less +G "$log_file"
    fi
  fi
}

