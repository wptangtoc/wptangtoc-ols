# Hàm đọc input an toàn (Chống rác bộ đệm Type-ahead & đảm bảo bật stty echo)
_safe_prompt_input() {
  local prompt_str="$1"
  local __out_var="$2"
  local input_val=""

  if declare -F wptt_flush_stdin >/dev/null 2>&1; then
    wptt_flush_stdin
  fi
  if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi

  if ! read -r -p "$prompt_str" input_val; then
    echo -e "\n${C_RED}⚠️ Đã mất kết nối Terminal (EOF). Đang thoát an toàn...${C_RESET}"
    exit 1
  fi
  printf -v "$__out_var" '%s' "$input_val"
}

# Hàm làm sạch thông minh chuỗi EAB KID / HMAC (Tự lọc bỏ tiền tố keyId:, b64MacKey:, dấu nháy...)
_clean_eab_token() {
  local raw="$1"
  raw="${raw#keyId:}"
  raw="${raw#b64MacKey:}"
  raw="${raw#--eab-kid=}"
  raw="${raw#--eab-hmac-key=}"
  raw="${raw//\"/}"
  raw="${raw//\'/}"
  raw="${raw//[[:space:]]/}"
  printf '%s' "$raw"
}

# Hàm tự động cài đặt OpenSSL và Certbot có Retry (Auto-Heal)
_ensure_ssl_dependencies() {
  local need_cb="${1:-0}"

  if ! command -v openssl >/dev/null 2>&1; then
    local task_ossl="Bổ sung thư viện mã hóa OpenSSL"
    _runing "$task_ossl"
    if command -v dnf >/dev/null 2>&1; then
      dnf install -y -q openssl >/dev/null 2>&1 || true
    elif command -v yum >/dev/null 2>&1; then
      yum install -y -q openssl >/dev/null 2>&1 || true
    elif command -v apt-get >/dev/null 2>&1; then
      env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
      env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openssl >/dev/null 2>&1 || true
    fi
    if command -v openssl >/dev/null 2>&1; then
      _rundone "$task_ossl"
    else
      _runloi "$task_ossl"
      return 1
    fi
  fi

  if ((need_cb == 1)) && ! command -v certbot >/dev/null 2>&1; then
    local ui_heal="Hệ thống phát hiện thiếu Certbot, đang tiến hành tự động cài đặt"
    _runing "$ui_heal"
    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    local log_cb
    log_cb="$(mktemp -p "/etc/wptt/tmp" wptt_certbot_install_XXXXXX.log)"
    local attempt=1 max_attempts=3 install_ok=0

    while ((attempt <= max_attempts)); do
      printf -- '--- Thử cài đặt Certbot lần %d ---\n' "$attempt" >>"$log_cb"
      if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
        env DEBIAN_FRONTEND=noninteractive apt-get update -y >>"$log_cb" 2>&1 || true
        if env DEBIAN_FRONTEND=noninteractive apt-get install -y certbot >>"$log_cb" 2>&1; then
          install_ok=1
          break
        fi
      else
        dnf install -y epel-release >>"$log_cb" 2>&1 || yum install -y epel-release >>"$log_cb" 2>&1 || true
        if dnf install -y certbot --setopt=timeout=15 >>"$log_cb" 2>&1 || yum install -y certbot >>"$log_cb" 2>&1; then
          install_ok=1
          break
        fi
      fi
      sleep 2
      ((attempt++))
    done

    if command -v certbot >/dev/null 2>&1 && ((install_ok == 1)); then
      _rundone "$ui_heal"
      /bin/rm -f -- "$log_cb" 2>/dev/null || true
    else
      _runloi "$ui_heal"
      echo -e "${C_RED}Lỗi nghiêm trọng: Không thể cài đặt Certbot sau $max_attempts lần thử!${C_RESET}"
      echo -e "=> Chi tiết lỗi đã được lưu tại: ${C_YELLOW}${log_cb}${C_RESET}"
      return 1
    fi
  fi
  return 0
}

# Hàm ghi nguyên tử khối vhssl vào Vhost của OpenLiteSpeed
_apply_paid_vhssl_config() {
  local domain="$1"
  local vhost_conf="/usr/local/lsws/conf/vhosts/$domain/$domain.conf"
  local s_dir="/usr/local/lsws/$domain/ssl"

  if [[ ! -f "$vhost_conf" ]]; then
    return 1
  fi

  if declare -F wptt_atomic_begin >/dev/null 2>&1; then
    tmp_vhost="$(wptt_atomic_begin "$vhost_conf")"
  else
    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    tmp_vhost="/etc/wptt/tmp/vhost_${domain}_$$.tmp"
    /bin/cp -fp -- "$vhost_conf" "$tmp_vhost"
  fi

  # Xóa khối vhssl cũ trong Vhost (Giữ nguyên 100% file chứng chỉ Let's Encrypt cũ trên đĩa)
  /bin/sed -e '/^[[:space:]]*vhssl[[:space:]]*{/,/^[[:space:]]*}/d' "$vhost_conf" >"$tmp_vhost"

  if [[ -s "$s_dir/ca_bundle.crt" ]] && grep -q "BEGIN CERTIFICATE" "$s_dir/ca_bundle.crt" 2>/dev/null; then
    cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $s_dir/$domain.key
  certFile                $s_dir/cert.crt
  certChain               0
  CACertFile              $s_dir/ca_bundle.crt
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
  else
    cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $s_dir/$domain.key
  certFile                $s_dir/cert.crt
  certChain               1
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
  fi

  if declare -F wptt_atomic_commit >/dev/null 2>&1; then
    wptt_atomic_commit "$tmp_vhost" "$vhost_conf"
  else
    /bin/mv -f -- "$tmp_vhost" "$vhost_conf"
  fi
  tmp_vhost=""
  return 0
}

# Hàm kiểm tra tính hợp lệ của X509 Certificate và khớp Toán học với Private Key
_verify_key_cert_match() {
  local k_file="$1"
  local c_file="$2"
  local k_pub="" c_pub=""

  [[ ! -s "$k_file" || ! -s "$c_file" ]] && return 1

  if ! openssl x509 -in "$c_file" -noout >/dev/null 2>&1; then
    return 1
  fi

  k_pub="$(openssl pkey -in "$k_file" -pubout -outform pem 2>/dev/null | sha256sum | awk '{print $1}')"
  c_pub="$(openssl x509 -in "$c_file" -pubkey -noout -outform pem 2>/dev/null | sha256sum | awk '{print $1}')"

  [[ -n "$k_pub" && -n "$c_pub" && "$k_pub" == "$c_pub" ]]
}

# Hàm đọc chuỗi PEM thông minh từ Terminal
_read_pem_from_terminal() {
  local out_file="$1"
  local stop_on_first_cert="${2:-1}"
  local line=""
  local empty_count=0
  local has_begin=0

  if declare -F wptt_flush_stdin >/dev/null 2>&1; then
    wptt_flush_stdin
  fi
  if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi

  : >"$out_file"
  while IFS= read -r line; do
    line="${line//$'\r'/}"

    if [[ -z "${line//[[:space:]]/}" ]]; then
      ((empty_count++))
      if ((has_begin == 1 && stop_on_first_cert == 0 && empty_count >= 1)) || ((empty_count >= 2)); then
        break
      fi
      continue
    fi

    empty_count=0
    [[ "$line" == *"-----BEGIN CERTIFICATE-----"* ]] && has_begin=1
    printf '%s\n' "$line" >>"$out_file"

    if ((stop_on_first_cert == 1)) && [[ "$line" == *"-----END CERTIFICATE-----"* ]]; then
      break
    fi
  done
}

# Hàm tạo Deploy Hook cho Certbot: Tự động chạy mỗi khi lệnh `certbot renew` tái cấp chứng chỉ ${NAME}-paid
_ensure_paid_deploy_hook() {
  local hook_script="/etc/wptt/ssl/wptt-paid-ssl-deploy-hook.sh"
  /bin/mkdir -p /etc/wptt/ssl 2>/dev/null || true

  cat >"$hook_script" <<'EOF'
#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 077

if [[ -z "${RENEWED_LINEAGE:-}" ]]; then
  exit 0
fi

cert_name="$(basename "$RENEWED_LINEAGE")"
# Cắt bỏ hậu tố -paid để lấy đúng tên miền gốc (VD: wptangtoc.com-paid -> wptangtoc.com)
domain_name="${cert_name%-paid}"
target_ssl_dir="/usr/local/lsws/${domain_name}/ssl"
vhost_conf="/usr/local/lsws/conf/vhosts/${domain_name}/${domain_name}.conf"

# Chốt chặn tương thích: Nếu quản trị viên đã chuyển Vhost về dùng Let's Encrypt Free
# (/etc/letsencrypt/live/...) thì không tự ý chép đè hay reload
if [[ -f "$vhost_conf" ]] && ! grep -q "$target_ssl_dir" "$vhost_conf" 2>/dev/null; then
  exit 0
fi

if [[ -d "/usr/local/lsws/${domain_name}" ]]; then
  /bin/mkdir -p -- "$target_ssl_dir"
  [[ -f "${RENEWED_LINEAGE}/privkey.pem" ]] && /bin/cp -fL -- "${RENEWED_LINEAGE}/privkey.pem" "${target_ssl_dir}/${domain_name}.key"
  [[ -f "${RENEWED_LINEAGE}/cert.pem" ]] && /bin/cp -fL -- "${RENEWED_LINEAGE}/cert.pem" "${target_ssl_dir}/cert.crt"
  [[ -f "${RENEWED_LINEAGE}/chain.pem" ]] && /bin/cp -fL -- "${RENEWED_LINEAGE}/chain.pem" "${target_ssl_dir}/ca_bundle.crt"
  [[ -f "${RENEWED_LINEAGE}/fullchain.pem" ]] && /bin/cp -fL -- "${RENEWED_LINEAGE}/fullchain.pem" "${target_ssl_dir}/fullchain.pem"

  /bin/chmod 600 -- "${target_ssl_dir}/${domain_name}.key" 2>/dev/null || true
  /bin/chmod 644 -- "${target_ssl_dir}/cert.crt" "${target_ssl_dir}/ca_bundle.crt" "${target_ssl_dir}/fullchain.pem" 2>/dev/null || true

  if [[ -x /etc/wptt/service/wptt-reload-lsws ]]; then
    /bin/bash /etc/wptt/service/wptt-reload-lsws >/dev/null 2>&1 || true
  else
    /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1 || true
  fi
fi
EOF
  /bin/chmod 700 -- "$hook_script"
}

# ==============================================================================
# MODULE KIỂM TRA XUNG ĐỘT PORT 80 & TIỀN TRẠM DNS (HỌC TỪ WPTT-CAISSL)
# ==============================================================================
_preflight_port80_and_dns() {
  local domain="$1"
  HAS_VALID_WWW_DNS=0

  # 1. Kiểm tra xung đột Port 80 (Nginx / Apache chiếm quyền)
  local conflict_process=""
  conflict_process="$(ss -tlnp 2>/dev/null | grep -E '\b:80\b' | grep -oP 'users:\(\("\K[^"]+' | grep -v -iE "litespeed|openlite|lsws|lshttpd" | head -n 1 || true)"
  if [[ -z "$conflict_process" ]]; then
    conflict_process="$(netstat -tlnp 2>/dev/null | grep -E '\b:80\b' | awk '{print $7}' | cut -d'/' -f2 | grep -v -iE "litespeed|openlite|lsws|lshttpd|-" | head -n 1 || true)"
  fi

  if [[ -n "$conflict_process" ]]; then
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_RED}CẢNH BÁO: XUNG ĐỘT PORT 80 (HTTP) CỦA OPENLITESPEED${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    center_text "Hệ thống phát hiện dịch vụ ${C_YELLOW}[$conflict_process]${C_RESET} đang chiếm giữ Port 80."
    center_text "Giao thức ACME bắt buộc Port 80 phải thông suốt để xác thực tên miền."
    center_text ""
    center_text "Để tiếp tục cài đặt, bạn cần tắt dịch vụ xung đột này đi bằng lệnh:"
    center_text "${C_GREEN}systemctl stop $conflict_process && systemctl disable $conflict_process${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    return 1
  fi

  # 2. Kiểm tra phân giải DNS (IPv6 AAAA & IPv4 A)
  local task_dns="Kiểm tra phân giải DNS cho tên miền $domain"
  echo ""
  _runing "$task_dns"

  local server_ips="" public_ip="" server_ipv6=""
  server_ips="$(ip a 2>/dev/null | grep -Eo '[0-9]{1,3}(\.[0-9]{1,3}){3}' | sed -e '/^127\./d' -e '/^192\.168\./d' | sort -u || true)"
  public_ip="$(curl -fsSL --connect-timeout 4 --max-time 8 https://ipv4.icanhazip.com 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}(\.[0-9]{1,3}){3}' || true)"
  if [[ -z "$public_ip" ]]; then
    public_ip="$(curl -fsSL --connect-timeout 4 --max-time 8 https://checkip.amazonaws.com 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}(\.[0-9]{1,3}){3}' || true)"
  fi
  server_ips="$server_ips $public_ip"
  server_ipv6="$(curl -fsSL --connect-timeout 4 --max-time 6 https://ipv6.icanhazip.com 2>/dev/null || true)"

  # Kiểm tra bẫy bản ghi IPv6 (AAAA)
  local checkdns_v6=""
  if command -v host >/dev/null 2>&1; then
    checkdns_v6="$(host -t AAAA "$domain" 2>/dev/null | awk '/has IPv6 address/ {print $5; exit}')"
  fi
  if [[ -z "$checkdns_v6" ]]; then
    checkdns_v6="$(curl -fsSL --connect-timeout 4 --max-time 6 "https://dns.google/resolve?name=${domain}&type=AAAA" 2>/dev/null | grep -Eo '"data":"[0-9a-fA-F:]+"' | head -n 1 | cut -d'"' -f4 || true)"
  fi

  if [[ -n "$checkdns_v6" ]]; then
    if [[ -z "$server_ipv6" ]] || ! grep -qiwF -- "$checkdns_v6" <<<"$server_ipv6"; then
      _runloi "$task_dns"
      echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_RED}CẢNH BÁO TỬ HUYỆT: TÊN MIỀN ĐANG TRỎ SAI BẢN GHI IPV6 (AAAA)${C_RESET}"
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text " ${C_YELLOW}Tại sao hệ thống cảnh báo bạn lúc này?${C_RESET}" 2
      left_text " Các tổ chức CA (Google / ZeroSSL / Sectigo) luôn ${C_RED}ƯU TIÊN TUYỆT ĐỐI${C_RESET}" 2
      left_text " xác thực qua IPv6 nếu tên miền có bản ghi AAAA. Dù IPv4 trỏ đúng," 2
      left_text " nhưng IPv6 trỏ sai thì CA vẫn sẽ báo lỗi và từ chối cấp SSL." 2
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text " ${C_YELLOW}Tình trạng hiện tại:${C_RESET}" 2
      left_text " - IPv6 (AAAA) đang trỏ : ${C_RED}$checkdns_v6${C_RESET}" 2
      if [[ -z "$server_ipv6" ]]; then
        left_text " - Máy chủ (VPS) này    : ${C_YELLOW}Chưa được cấu hình / Không hỗ trợ mạng IPv6${C_RESET}" 2
      else
        left_text " - Máy chủ (VPS) này    : ${C_GREEN}$server_ipv6${C_RESET}" 2
      fi
      echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text " ${C_GREEN}CÁCH GIẢI QUYẾT TRIỆT ĐỂ NHẤT (Chỉ 1 phút):${C_RESET}" 2
      left_text " 1. Truy cập trang quản lý DNS (Cloudflare, Namecheap, Mắt Bão...)" 2
      left_text " 2. Tìm và ${C_RED}XÓA BỎ HOÀN TOÀN${C_RESET} bản ghi Loại AAAA của tên miền này." 2
      left_text " 3. Chờ 2-3 phút để DNS cập nhật rồi tiến hành cài lại SSL." 2
      echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

      if ! wptt_xac_nhan "Bạn có muốn BỎ QUA cảnh báo IPv6 này để tiếp tục thử cấp phát không?" \
        "Chỉ nên tiếp tục nếu tên miền đang bật Đám mây Cam Cloudflare (Proxy)." \
        "Nếu không dùng Proxy, việc ép chạy có thể làm hỏng mã EAB dùng 1 lần!" \
        "Vẫn tiếp tục" "Hủy để sửa DNS (Khuyên dùng)"; then
        return 1
      fi
    fi
  fi

  # Kiểm tra bản ghi IPv4 (A) qua 4 nguồn độc lập
  local error_ssl_ipv4=1
  local checkdns="" checkdns2="" checkdns3="" checkdns4="" resolved_ip=""
  if command -v host >/dev/null 2>&1; then
    checkdns="$(host -t A "$domain" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}(\.[0-9]{1,3}){3}' || true)"
  fi
  if command -v nslookup >/dev/null 2>&1; then
    checkdns2="$(nslookup "$domain" 2>/dev/null | awk '/^Address:/ {print $2}' | grep -v '#' | grep -Eo -m 1 '[0-9]{1,3}(\.[0-9]{1,3}){3}' || true)"
  fi
  checkdns3="$(curl -fsSL --connect-timeout 4 --max-time 6 "https://dns.google/resolve?name=${domain}&type=A" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 || true)"
  checkdns4="$(curl -fsSL --connect-timeout 4 --max-time 6 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=${domain}&type=A" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 || true)"

  for resolved_ip in "$checkdns" "$checkdns2" "$checkdns3" "$checkdns4"; do
    if [[ -n "$resolved_ip" ]] && grep -qwF -- "$resolved_ip" <<<"$server_ips"; then
      error_ssl_ipv4=0
      break
    fi
  done

  if ((error_ssl_ipv4 == 1)); then
    _runloi "$task_dns"

    local trace_output=""
    trace_output="$(curl -Is --connect-timeout 4 --max-time 8 "https://$domain/cdn-cgi/trace" 2>/dev/null || curl -Is --connect-timeout 4 --max-time 8 "http://$domain/cdn-cgi/trace" 2>/dev/null || true)"
    if grep -Eqi 'cloudflare|cf-ray' <<<"$trace_output"; then
      echo -e "\n${C_YELLOW}☁️ PHÁT HIỆN TÊN MIỀN ĐANG BẬT PROXY CLOUDFLARE (ĐÁM MÂY CAM)${C_RESET}"
      echo -e "Tên miền ${C_CYAN}$domain${C_RESET} đang đi qua lớp trung gian Cloudflare CDN."
      echo -e "Nếu Cloudflare SSL/TLS đang ở chế độ ${C_GREEN}Full${C_RESET} hoặc ${C_GREEN}Flexible${C_RESET}, Certbot vẫn có thể xác thực qua Webroot."
      echo -e "Tuy nhiên, để an toàn 100% không bị tường lửa Cloudflare chặn Bot CA, bạn nên tạm tắt Đám mây Cam (chuyển sang Xám).\n"

      if ! wptt_xac_nhan "Bạn có muốn tiếp tục cấp phát SSL khi đang bật Đám mây Cam không?" \
        "Nếu thất bại, hãy vào Cloudflare tắt Đám mây Cam sang Xám (DNS Only) rồi chạy lại." \
        "" "Tiếp tục cấp phát" "Tạm dừng để tắt Đám mây Cam"; then
        return 1
      fi
    else
      echo -e "\n${C_RED}❌ LỖI: TÊN MIỀN CHƯA ĐƯỢC TRỎ BẢN GHI IPV4 (A) VỀ MÁY CHỦ!${C_RESET}"
      echo -e "Tên miền ${C_YELLOW}$domain${C_RESET} hiện đang trỏ tới: ${C_YELLOW}${checkdns3:-${checkdns:-Không xác định (Chưa phân giải được DNS)}}${C_RESET}"
      echo -e "IPv4 thực tế của máy chủ này là   : ${C_GREEN}${public_ip:-Không xác định}${C_RESET}"
      echo -e "Vui lòng trỏ đúng bản ghi A về IP máy chủ trước khi chạy xác thực ACME.\n"

      if ! wptt_xac_nhan "Bạn có chắc chắn muốn bỏ qua cảnh báo DNS này để ép chạy tiếp không?" \
        "Cảnh báo: Nếu DNS chưa trỏ về máy chủ, quá trình xác thực chắc chắn sẽ thất bại!" \
        "" "Vẫn ép chạy" "Thoát để trỏ lại DNS (Khuyên dùng)"; then
        return 1
      fi
    fi
  else
    _rundone "$task_dns"
  fi

  # 3. Kiểm tra tự động bản ghi www.$domain (Chỉ gộp www vào yêu cầu nếu www đã trỏ đúng IP và không dính bẫy IPv6)
  local checkdns_www="" checkdns_www_v6="" www_v6_ok=1
  checkdns_www="$(curl -fsSL --connect-timeout 4 --max-time 6 "https://dns.google/resolve?name=www.${domain}&type=A" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 || true)"
  if command -v host >/dev/null 2>&1; then
    checkdns_www_v6="$(host -t AAAA "www.$domain" 2>/dev/null | awk '/has IPv6 address/ {print $5; exit}')"
  fi
  if [[ -n "$checkdns_www_v6" ]]; then
    if [[ -z "$server_ipv6" ]] || ! grep -qiwF -- "$checkdns_www_v6" <<<"$server_ipv6"; then
      www_v6_ok=0
    fi
  fi

  if ((www_v6_ok == 1)) && [[ -n "$checkdns_www" ]] && grep -qwF -- "$checkdns_www" <<<"$server_ips"; then
    HAS_VALID_WWW_DNS=1
  fi

  return 0
}

# ==============================================================================
# MODULE 1: TỰ ĐỘNG LẤY MÃ EAB TỪ ZEROSSL API (1-CLICK / ZERO-TOUCH)
# ==============================================================================
_fetch_zerossl_eab_credentials() {
  local domain="$1"
  local mode="${2:-auto}" # auto = Tự động 100% không hỏi | custom = Tài khoản riêng
  ZEROSSL_EAB_KID=""
  ZEROSSL_EAB_HMAC=""
  CA_REUSE_EXISTING_ACCOUNT=0

  # NHÁNH 1: TỰ ĐỘNG 100% (KHÔNG HỎI EMAIL, KHÔNG HIỆN MENU CON)
  if [[ "$mode" == "auto" ]]; then
    if [[ -d "/etc/letsencrypt/accounts/acme.zerossl.com" ]] &&
      [[ -n "$(find /etc/letsencrypt/accounts/acme.zerossl.com -name 'regr.json' -print -quit 2>/dev/null)" ]]; then
      CA_REUSE_EXISTING_ACCOUNT=1
    fi

    local z_email="admin@${domain}"
    local task_zeab="Tự động khởi tạo khóa ACME EAB từ ZeroSSL ($z_email)"
    _runing "$task_zeab"

    local api_resp=""
    api_resp="$(curl -fsSL --connect-timeout 10 --max-time 20 -X POST "https://api.zerossl.com/acme/eab-credentials-email" \
      --data-urlencode "email=${z_email}" 2>/dev/null || true)"

    if [[ "$api_resp" == *'"eab_kid"'* && "$api_resp" == *'"eab_hmac_key"'* ]]; then
      ZEROSSL_EAB_KID="$(grep -Eo '"eab_kid"[[:space:]]*:[[:space:]]*"[^"]+"' <<<"$api_resp" | head -n 1 | cut -d'"' -f4)"
      ZEROSSL_EAB_HMAC="$(grep -Eo '"eab_hmac_key"[[:space:]]*:[[:space:]]*"[^"]+"' <<<"$api_resp" | head -n 1 | cut -d'"' -f4)"
    fi

    if [[ -n "$ZEROSSL_EAB_KID" && -n "$ZEROSSL_EAB_HMAC" ]]; then
      _rundone "$task_zeab"
      return 0
    fi

    # Nếu API tạo EAB mới bị bận nhưng trên máy đã có sẵn tài khoản ACME ZeroSSL cũ thì dùng luôn tài khoản cũ!
    if ((CA_REUSE_EXISTING_ACCOUNT == 1)); then
      _rundone "$task_zeab"
      return 0
    fi

    _runloi "$task_zeab"
    echo -e "${C_YELLOW}⚠️ Máy chủ API ZeroSSL đang bận. Chuyển sang chế độ nhập khóa dự phòng...${C_RESET}"
  fi

  # NHÁNH 2: KẾT NỐI TÀI KHOẢN ZEROSSL RIÊNG (HOẶC FALLBACK KHI API BẬN)
  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}KẾT NỐI TÀI KHOẢN ZEROSSL RIÊNG (DASHBOARD / PRO)${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "${C_GREEN}[1] Tự động lấy EAB bằng API Access Key (Trong mục Developer trên Web)${C_RESET}" 2
  left_text "${C_CYAN}[2] Nhập trực tiếp cặp mã EAB KID & EAB HMAC Key${C_RESET}" 2
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
  echo ""

  local z_mode=""
  _safe_prompt_input "Chọn phương thức [Mặc định 1]: " z_mode
  z_mode="${z_mode//[[:space:]]/}"
  z_mode="${z_mode:-1}"

  if [[ "$z_mode" == "1" ]]; then
    local z_apikey=""
    _safe_prompt_input "➤ Nhập ZeroSSL API Access Key của bạn: " z_apikey
    z_apikey="${z_apikey//[[:space:]]/}"

    if [[ -n "$z_apikey" ]]; then
      local task_zapi="Lấy khóa EAB qua ZeroSSL API Access Key"
      _runing "$task_zapi"

      local api_resp=""
      api_resp="$(curl -fsSL --connect-timeout 10 --max-time 20 -X POST "https://api.zerossl.com/acme/eab-credentials?access_key=${z_apikey}" 2>/dev/null || true)"

      if [[ "$api_resp" == *'"eab_kid"'* && "$api_resp" == *'"eab_hmac_key"'* ]]; then
        ZEROSSL_EAB_KID="$(grep -Eo '"eab_kid"[[:space:]]*:[[:space:]]*"[^"]+"' <<<"$api_resp" | head -n 1 | cut -d'"' -f4)"
        ZEROSSL_EAB_HMAC="$(grep -Eo '"eab_hmac_key"[[:space:]]*:[[:space:]]*"[^"]+"' <<<"$api_resp" | head -n 1 | cut -d'"' -f4)"
      fi

      if [[ -n "$ZEROSSL_EAB_KID" && -n "$ZEROSSL_EAB_HMAC" ]]; then
        _rundone "$task_zapi"
        return 0
      else
        _runloi "$task_zapi"
        echo -e "${C_YELLOW}⚠️ Access Key không hợp lệ. Chuyển sang nhập EAB thủ công...${C_RESET}"
      fi
    fi
  fi

  echo -e "\n${C_YELLOW}💡 Lấy mã EAB tại: ZeroSSL Dashboard ➜ Developer ➜ EAB Credentials for ACME Clients:${C_RESET}"
  _safe_prompt_input "➤ Nhập EAB Key ID (KID) : " ZEROSSL_EAB_KID
  _safe_prompt_input "➤ Nhập EAB HMAC Key     : " ZEROSSL_EAB_HMAC
  ZEROSSL_EAB_KID="$(_clean_eab_token "$ZEROSSL_EAB_KID")"
  ZEROSSL_EAB_HMAC="$(_clean_eab_token "$ZEROSSL_EAB_HMAC")"
  [[ -n "$ZEROSSL_EAB_KID" && -n "$ZEROSSL_EAB_HMAC" ]]
}

