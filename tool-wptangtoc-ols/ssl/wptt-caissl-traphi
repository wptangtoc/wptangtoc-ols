    old_umask=$(umask)
    umask 077
    [[ -f "${live_dir}/privkey.pem" ]] && /bin/cp -fL -- "${live_dir}/privkey.pem" "$key_file"
    [[ -f "${live_dir}/cert.pem" ]] && /bin/cp -fL -- "${live_dir}/cert.pem" "$cert_file"
    [[ -f "${live_dir}/chain.pem" ]] && /bin/cp -fL -- "${live_dir}/chain.pem" "$ca_file"
    [[ -f "${live_dir}/fullchain.pem" ]] && /bin/cp -fL -- "${live_dir}/fullchain.pem" "$ssl_dir/fullchain.pem"
    umask "$old_umask"

    /bin/chmod 600 -- "$key_file" 2>/dev/null || true
    /bin/chmod 644 -- "$cert_file" "$ca_file" "$ssl_dir/fullchain.pem" 2>/dev/null || true
  fi

  _apply_paid_vhssl_config "$NAME"
  if [[ -x /etc/wptt/ssl/wptt-renew-chuyen-huong ]]; then
    /bin/bash /etc/wptt/ssl/wptt-renew-chuyen-huong "$NAME" >/dev/null 2>&1 || true
  fi
  declare -F wptt_smart_reload_lsws >/dev/null 2>&1 && wptt_smart_reload_lsws >/dev/null 2>&1
  _rundone "$task_install"

  # Kiểm tra xác nhận máy chủ nạp cấu hình HTTPS cục bộ và mở Port 443 CSF
  task_verify_https="Kiểm tra phản hồi HTTPS trên OpenLiteSpeed ($NAME)"
  _runing "$task_verify_https"
  http_status="000"
  for _ in {1..10}; do
    http_status="$(curl -o /dev/null -s -w "%{http_code}" --resolve "$NAME:443:127.0.0.1" --connect-timeout 4 "https://$NAME" 2>/dev/null || echo "000")"
    if [[ "$http_status" =~ ^(200|301|302|403|404)$ ]]; then
      break
    fi
    sleep 1.5
  done
  _rundone "$task_verify_https"

  if [[ -f /etc/csf/csf.conf ]]; then
    if ! grep '^TCP_IN' /etc/csf/csf.conf | grep -q "443"; then
      /bin/sed -i 's/^TCP_IN = "/TCP_IN = "443,/g' /etc/csf/csf.conf
      csf -x >/dev/null 2>&1 || true
      csf -e >/dev/null 2>&1 || true
    fi
  fi

  wptt_logs "INFO" "Kích hoạt thành công SSL Tự động hóa ($ca_provider_label - Certbot ACME EAB) cho $NAME"

  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}KÍCH HOẠT TỰ ĐỘNG HÓA SSL (${ca_provider_label^^}) THÀNH CÔNG!${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Tên miền       : ${C_YELLOW}https://$NAME${C_RESET}" 2
  if ((HAS_VALID_WWW_DNS == 1)); then
    left_text "Kèm Subdomain  : ${C_GREEN}Đã tích hợp www.$NAME${C_RESET}" 2
  fi
  left_text "Nhà cung cấp   : ${C_CYAN}${ca_provider_label}${C_RESET}" 2
  left_text "Định danh      : ${C_CYAN}${paid_cert_name}${C_RESET}" 2
  left_text "Tự động tái cấp: ${C_GREEN}Đồng bộ gia hạn tự động SSL của WPTangToc OLS${C_RESET}" 2
  left_text "Đường dẫn SSL  : ${C_YELLOW}$ssl_dir/${C_RESET}" 2
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  wptt_quay_ve_menu "$route_arg" 0 "enter"
fi

