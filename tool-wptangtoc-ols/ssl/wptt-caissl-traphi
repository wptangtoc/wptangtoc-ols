function huong_dan() {
  cat <<'EOF'
  Tính năng Cài đặt SSL trả phí là quá trình trang bị cho website của bạn một chứng chỉ SSL/TLS thương mại [mua từ các nhà cung cấp như DigiCert, Sectigo, GlobalSign,...] để kích hoạt giao thức HTTPS, đảm bảo kết nối mã hóa và xác thực danh tính website ở mức độ cao hơn.

  Nói một cách đơn giản, đây là việc bạn đầu tư mua một giấy phép bảo mật cao cấp hơn cho website, thường đi kèm với các quy trình xác minh nghiêm ngặt hơn và có thể cung cấp các dấu hiệu tin cậy rõ ràng hơn cho người dùng so với chứng chỉ miễn phí.

  Mục Đích Chính
  * Xác thực danh tính mạnh mẽ [đặc biệt với OV/EV]:
  * OV [Organization Validation]: Xác minh sự tồn tại và tính hợp pháp của tổ chức sở hữu website.
  * EV [Extended Validation]: Quy trình xác minh nghiêm ngặt nhất, trước đây thường hiển thị tên công ty trên thanh địa chỉ màu xanh lá [hiện nay ít phổ biến hơn nhưng vẫn tăng độ tin cậy].
  * Bảo mật dữ liệu: Mã hóa toàn bộ thông tin trao đổi giữa người dùng và website.
  * Tăng uy tín và niềm tin: Khách hàng có thể cảm thấy an tâm hơn khi giao dịch trên website có chứng chỉ trả phí, đặc biệt là OV/EV.
  * Bảo hiểm [Warranty]: Nhiều chứng chỉ trả phí đi kèm với các gói bảo hiểm, bồi thường nếu có sai sót từ phía nhà cung cấp chứng chỉ gây thiệt hại.
  * Hỗ trợ khách hàng: Thường nhận được sự hỗ trợ kỹ thuật tốt hơn từ nhà cung cấp.
  * Các tính năng đặc biệt: Một số loại có thể hỗ trợ nhiều tên miền [SAN] hoặc wildcard [cho tất cả tên miền phụ] một cách linh hoạt.

  Việc cài đặt SSL trả phí thường đòi hỏi nhiều bước hơn và có chi phí, nhưng mang lại các lợi ích về xác thực và uy tín cao hơn cho một số loại hình website, đặc biệt là các trang thương mại điện tử lớn hoặc tổ chức tài chính.
EOF
}

# ==============================================================================
# MODULE BẢO VỆ & DỌN DẸP RÁC TỰ ĐỘNG (TRAP CLEANUP)
# ==============================================================================
tmp_vhost=""
cleanup() {
  local rc=$?
  # Dọn dẹp file temp htaccess nếu có
  [[ -n "$tmp_vhost" && -f "$tmp_vhost" ]] && /bin/rm -f -- "$tmp_vhost"
  # Chỉ thoát tiến trình nếu không phải đang source
  if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    exit "$rc"
  fi
}

# CHỈ áp dụng bẫy (trap) nếu file này ĐANG ĐƯỢC EXECUTE (tránh đè trap của file mẹ)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  trap cleanup EXIT
  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM HUP
fi

# ==============================================================================
# KHỞI TẠO MÔI TRƯỜNG & THƯ VIỆN
# ==============================================================================
. /etc/wptt/.wptt.conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null || true
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện lõi và UI Xác nhận

if [[ "${1:-}" == "98" ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-ssl-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl} ➜ Khởi tạo & Cấu hình SSL Trả phí (Paid SSL)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME="${1:-}"
no_key="${2:-}"
[[ "$NAME" == "98" ]] && NAME=""

# ==============================================================================
# HÀM MENU CHỌN DOMAIN (UX BO CONG)
# ==============================================================================
if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien
  lua_chon_NAME "cấu hình SSL Trả phí"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-ssl-main 1
  fi
  return 0 2>/dev/null || exit 0
}

path="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$path" ]]; then
  echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 3
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-ssl-main 1
  fi
  return 1 2>/dev/null || exit 1
fi

wptt_logs "INFO" "Thiết lập cài đặt ssl trả phí website $NAME"
ssl_dir="/usr/local/lsws/$NAME/ssl"
/bin/mkdir -p -- "$ssl_dir"

key_file="$ssl_dir/$NAME.key"
csr_file="$ssl_dir/$NAME.csr"

# ==============================================================================
# TẠO PRIVATE KEY VÀ CSR (VỚI 3 OPTION MÃ HÓA)
# ==============================================================================
dongy2="n"
if [[ -z "$no_key" ]]; then
  echo ""
  if wptt_xac_nhan "Bạn có muốn hệ thống tự tạo Private Key (.key) và mã CSR không?" "${C_BOLD_WHITE}Gợi ý:${C_RESET} Chọn [Có] nếu bạn chưa mua SSL và cần mã CSR để cung cấp cho nhà bán." "" "Có (Tự động tạo)" "Không cần"; then
    dongy2="y"
  fi
fi

if [[ "$dongy2" == "y" ]]; then
  echo -e "\n${C_CYAN}Chọn thuật toán mã hóa cho chứng chỉ SSL:${C_RESET}"
  echo -e " [1] ${C_GREEN}RSA 2048-bit${C_RESET} (Khuyên dùng - Tương thích 100% mọi nhà cung cấp)"
  echo -e " [2] ${C_YELLOW}RSA 4096-bit${C_RESET} (Bảo mật cao nhất - Tiêu tốn CPU máy chủ hơn)"
  echo -e " [3] ${C_CYAN}ECDSA P-256${C_RESET}  (Hiệu năng tối đa - Siêu nhẹ, tốc độ ngon nhất)"
  echo ""
  read -r -p "Nhập lựa chọn của bạn [Mặc định 1]: " ssl_algo_choice
  ssl_algo_choice="${ssl_algo_choice:-1}"


	#lập trình phòng thủ: check thư viện openssl có khi người dùng nghịch dại đi xóa openssl thì sao cứ check trước cho chắc
	if ! command -v openssl >/dev/null 2>&1; then
		dnf install openssl -y >/dev/null 2>&1 
	fi

  UI_TASK="Khởi tạo Private Key & CSR mã hóa cho $NAME"
  _runing "$UI_TASK"

  # Setup thông tin cơ bản cho CSR
  subj_string="/C=VN/ST=Hai Phong/L=Hai Phong/O=$NAME/OU=$NAME/CN=$NAME/emailAddress=admin@${NAME}"
  
  # Đặt umask 077 để đảm bảo Private Key được sinh ra luôn có quyền 600 từ gốc (Chống leak secret)
  old_umask=$(umask)
  umask 077

  case "$ssl_algo_choice" in
    2)
      openssl req -new -newkey rsa:4096 -nodes \
        -keyout "$key_file" -out "$csr_file" -subj "$subj_string" \
        -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1
      algo_name="RSA 4096-bit"
      ;;
    3)
      openssl ecparam -name prime256v1 -genkey -noout -out "$key_file" >/dev/null 2>&1
      openssl req -new -key "$key_file" -out "$csr_file" -subj "$subj_string" \
        -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1
      algo_name="ECDSA P-256"
      ;;
    *)
      openssl req -new -newkey rsa:2048 -nodes \
        -keyout "$key_file" -out "$csr_file" -subj "$subj_string" \
        -addext "subjectAltName=DNS:$NAME,DNS:www.$NAME" >/dev/null 2>&1
      algo_name="RSA 2048-bit"
      ;;
  esac

  umask "$old_umask" # Khôi phục umask
  
  # Chuẩn hóa quyền an toàn cho file
  /bin/chmod 600 -- "$key_file"
  /bin/chmod 644 -- "$csr_file"

  if [[ -s "$csr_file" && -s "$key_file" ]]; then
    _rundone "$UI_TASK ($algo_name)"

    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}MÃ CSR XÁC THỰC CỦA BẠN (CERTIFICATE SIGNING REQUEST)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hãy COPY toàn bộ đoạn mã bên dưới và cung cấp cho nhà cung cấp SSL:" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    # In mã CSR (KHÔNG ĐÓNG KHUNG ĐỂ UX COPY ĐƯỢC CHUẨN XÁC NHẤT)
    echo -e "${C_YELLOW}"
    cat "$csr_file"
    echo -e "${C_RESET}\n"
  else
    _runloi "$UI_TASK"
    return 1 2>/dev/null || exit 1
  fi
fi

# ==============================================================================
# CẤU HÌNH VHOST VÀ HTTPD_CONFIG (ATOMIC WRITE)
# ==============================================================================
UI_TASK_VHOST="Thiết lập cấu hình SSL trả phí Vhost"
_runing "$UI_TASK_VHOST"

vhost_conf_file="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

if [[ -f "$vhost_conf_file" ]]; then
  # 1. Khởi tạo file tạm nguyên tử
  if type wptt_atomic_begin >/dev/null 2>&1; then
    tmp_vhost=$(wptt_atomic_begin "$vhost_conf_file")
  else
    tmp_vhost="/etc/wptt/tmp/vhost_${NAME}_$$.tmp"
    /bin/touch -- "$tmp_vhost"
    /bin/chmod --reference="$vhost_conf_file" "$tmp_vhost"
    /bin/chown --reference="$vhost_conf_file" "$tmp_vhost"
  fi

  # 2. Xóa khối vhssl cũ (nếu có) và đẩy sang file tạm
  /bin/sed -e '/^vhssl /,/^}$/d' "$vhost_conf_file" > "$tmp_vhost"

  # 3. Bơm khối vhssl mới vào cuối file
  cat <<EOF >> "$tmp_vhost"
vhssl  {
  keyFile                 /usr/local/lsws/$NAME/ssl/$NAME.key
  certFile                /usr/local/lsws/$NAME/ssl/cert.crt
  certChain               0
  CACertFile              /usr/local/lsws/$NAME/ssl/ca_bundle.crt
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF

  # 4. Chốt giao dịch nguyên tử (Zero-downtime config replace)
  if type wptt_atomic_commit >/dev/null 2>&1; then
    wptt_atomic_commit "$tmp_vhost" "$vhost_conf_file"
  else
    /bin/mv -T -- "$tmp_vhost" "$vhost_conf_file"
  fi
  tmp_vhost="" # Dọn biến để trap bỏ qua
  
  _rundone "$UI_TASK_VHOST"
else
  _runloi "$UI_TASK_VHOST (Không tìm thấy Vhost)"
fi

# ==============================================================================
# HƯỚNG DẪN UPLOAD FILE (UX BO CONG)
# ==============================================================================
if [[ -z "$no_key" ]]; then
  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}CẤU HÌNH HỆ THỐNG HOÀN TẤT - BƯỚC TIẾP THEO${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Hệ thống đã dọn đường sẵn. Bây giờ bạn cần UPLOAD CÁC FILE CHỨNG CHỈ" 2
  left_text "mà nhà cung cấp gửi cho bạn vào thư mục sau:" 2
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  center_text "${C_YELLOW}$ssl_dir/${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  if [[ "$dongy2" == "y" ]]; then
    left_text "Yêu cầu upload 2 file (Phải đổi đúng tên như dưới đây):" 2
    left_text "1. ${C_CYAN}cert.crt${C_RESET}       (File chứng chỉ SSL của tên miền)" 4
    left_text "2. ${C_CYAN}ca_bundle.crt${C_RESET}  (File chứng chỉ CA trung gian / Chain)" 4
  else
    left_text "Yêu cầu upload 3 file (Phải đổi đúng tên như dưới đây):" 2
    left_text "1. ${C_CYAN}$NAME.key${C_RESET}  (File Private Key của bạn)" 4
    left_text "2. ${C_CYAN}cert.crt${C_RESET}       (File chứng chỉ SSL của tên miền)" 4
    left_text "3. ${C_CYAN}ca_bundle.crt${C_RESET}  (File chứng chỉ CA trung gian / Chain)" 4
  fi

  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "${C_YELLOW}SAU KHI UPLOAD XONG, HÃY CHẠY LỆNH NÀY NGOÀI TERMINAL ĐỂ KÍCH HOẠT:${C_RESET}" 2
  center_text "${C_GREEN}wptt ssl-tra-phi-config -d $NAME${C_RESET}"
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

if [[ "${1:-}" == "98" ]]; then
	echo -en "\n${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
	read -r _ # Dừng lại để người dùng xem kết quả
	exec /etc/wptt/wptt-ssl-main 1
fi
