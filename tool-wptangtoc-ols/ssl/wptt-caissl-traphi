cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi
  [[ -n "${tmp_vhost:-}" && -f "$tmp_vhost" ]] && /bin/rm -f -- "$tmp_vhost" 2>/dev/null || true
  [[ -n "${tmp_cert_paste:-}" && -f "$tmp_cert_paste" ]] && /bin/rm -f -- "$tmp_cert_paste" 2>/dev/null || true
  [[ -n "${tmp_ca_paste:-}" && -f "$tmp_ca_paste" ]] && /bin/rm -f -- "$tmp_ca_paste" 2>/dev/null || true
  [[ -n "${tmp_eab_ini:-}" && -f "$tmp_eab_ini" ]] && /bin/rm -f -- "$tmp_eab_ini" 2>/dev/null || true
  if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    exit "$rc"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
fi

