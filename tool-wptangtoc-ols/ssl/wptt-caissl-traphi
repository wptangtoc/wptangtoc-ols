# ==============================================================================
# NHÁNH A: CÀI ĐẶT TỰ ĐỘNG QUA CERTBOT ACME (CHẾ ĐỘ [1] ZEROSSL, [2] GOOGLE GTS, [3] CA KHÁC)
# ==============================================================================
if [[ "$paid_mode" == "1" || "$paid_mode" == "2" || "$paid_mode" == "3" ]]; then
  if ! _ensure_ssl_dependencies 1; then
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  # Tự động lấy docRoot chính xác từ Vhost
  webroot_path="$(awk '/docRoot/ {print $2; exit}' "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf" 2>/dev/null || true)"
  [[ -z "$webroot_path" || ! -d "$webroot_path" ]] && webroot_path="/usr/local/lsws/$NAME/html"

  if [[ ! -d "$webroot_path" ]]; then
    echo -e "\n${C_RED}❌ Lỗi nghiêm trọng: Không tìm thấy thư mục mã nguồn ($webroot_path)!${C_RESET}"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  # Kiểm tra xung đột Port 80 và phân giải DNS trước khi tiêu thụ mã EAB
  if ! _preflight_port80_and_dns "$NAME"; then
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  certbot_bin="$(command -v certbot 2>/dev/null || echo "/usr/bin/certbot")"

  # Mở khóa thư mục .well-known nếu tính năng Lock Down đang bật
  unset lock_down
  if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
    # shellcheck source=/dev/null
    wptt_load_vhost_conf "/etc/wptt/vhost/.$NAME.conf"
    if [[ -n "${lock_down:-}" && -d "${webroot_path}/.well-known" ]]; then
      chattr -R -i "${webroot_path}/.well-known" >/dev/null 2>&1 || true
      /bin/rm -rf -- "${webroot_path:?}/.well-known"
    fi
  fi

  acme_server="https://acme.zerossl.com/v2/DV90"
  eab_kid=""
  eab_hmac=""
  ca_provider_label="ZeroSSL"
  CA_REUSE_EXISTING_ACCOUNT=0

  if [[ "$paid_mode" == "1" ]]; then
    # Chế độ [1]: ZeroSSL Zero-Touch 100% — Không hỏi thêm bất kỳ câu nào!
    acme_server="https://acme.zerossl.com/v2/DV90"
    ca_provider_label="ZeroSSL"
    if _fetch_zerossl_eab_credentials "$NAME" "auto"; then
      eab_kid="$ZEROSSL_EAB_KID"
      eab_hmac="$ZEROSSL_EAB_HMAC"
    fi
  elif [[ "$paid_mode" == "2" ]]; then
    # Chế độ [2]: Google Trust Services (GTS) Public CA
    acme_server="https://dv.acme-v02.api.pki.goog/directory"
    ca_provider_label="Google Trust Services (GTS)"
    if _fetch_gts_eab_credentials; then
      eab_kid="$GTS_EAB_KID"
      eab_hmac="$GTS_EAB_HMAC"
    fi
  else
    # Chế độ [3]: Chọn nhà cung cấp CA thương mại khác hoặc tài khoản ZeroSSL riêng
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}CHỌN TỔ CHỨC CẤP PHÁT SSL THƯƠNG MẠI (CA ACME SERVER)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "${C_GREEN}[1] ZeroSSL Tài khoản riêng (Dùng API Access Key hoặc EAB trên Dashboard)${C_RESET}" 2
    left_text "${C_YELLOW}[2] Google Trust Services (GTS)               (https://dv.acme-v02.api.pki.goog)${C_RESET}" 2
    left_text "[3] Sectigo / Comodo / GogetSSL DV            (https://acme.sectigo.com/v2/DV)" 2
    left_text "[4] Sectigo OV (Chứng chỉ Doanh nghiệp)       (https://acme.sectigo.com/v2/OV)" 2
    left_text "[5] DigiCert / GeoTrust / Thawte              (https://acme.digicert.com/v2/acme)" 2
    left_text "[6] SSL.com Commercial (ECC/RSA)              (https://acme.ssl.com/sslcom-dv-ecc)" 2
    left_text "[7] Nhập đường dẫn ACME Server URL tùy chỉnh khác" 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo ""

    ca_choice=""
    _safe_prompt_input "Chọn nhà cung cấp CA của bạn [Mặc định 1]: " ca_choice
    ca_choice="${ca_choice//[[:space:]]/}"
    ca_choice="${ca_choice:-1}"

    case "$ca_choice" in
    1)
      acme_server="https://acme.zerossl.com/v2/DV90"
      ca_provider_label="ZeroSSL"
      if _fetch_zerossl_eab_credentials "$NAME" "custom"; then
        eab_kid="$ZEROSSL_EAB_KID"
        eab_hmac="$ZEROSSL_EAB_HMAC"
      fi
      ;;
    2)
      acme_server="https://dv.acme-v02.api.pki.goog/directory"
      ca_provider_label="Google Trust Services (GTS)"
      if _fetch_gts_eab_credentials; then
        eab_kid="$GTS_EAB_KID"
        eab_hmac="$GTS_EAB_HMAC"
      fi
      ;;
    3)
      acme_server="https://acme.sectigo.com/v2/DV"
      ca_provider_label="Sectigo DV"
      ;;
    4)
      acme_server="https://acme.sectigo.com/v2/OV"
      ca_provider_label="Sectigo OV"
      ;;
    5)
      acme_server="https://acme.digicert.com/v2/acme/directory/"
      ca_provider_label="DigiCert"
      ;;
    6)
      acme_server="https://acme.ssl.com/sslcom-dv-ecc"
      ca_provider_label="SSL.com"
      ;;
    7)
      custom_acme_url=""
      _safe_prompt_input "Nhập ACME Directory URL do nhà bán cung cấp: " custom_acme_url
      acme_server="${custom_acme_url//[[:space:]]/}"
      ca_provider_label="Custom ACME CA"
      ;;
    esac

    if [[ "$ca_choice" != "1" && "$ca_choice" != "2" ]]; then
      echo -e "\n${C_YELLOW}💡 Vui lòng lấy mã EAB (External Account Binding) trong trang quản lý SSL của bạn:${C_RESET}"
      _safe_prompt_input "➤ Nhập EAB Key ID (KID)   : " eab_kid
      _safe_prompt_input "➤ Nhập EAB HMAC Key       : " eab_hmac
      eab_kid="$(_clean_eab_token "$eab_kid")"
      eab_hmac="$(_clean_eab_token "$eab_hmac")"
    fi
  fi

  # Validate định dạng an toàn cho ACME URL và khóa EAB
  if [[ -z "$acme_server" || ! "$acme_server" =~ ^https://[a-zA-Z0-9._/-]+$ ]]; then
    echo -e "\n${C_RED}❌ Lỗi: Đường dẫn ACME Server phải bắt đầu bằng https:// và đúng định dạng URL!${C_RESET}\n"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  if [[ -z "$eab_kid" || -z "$eab_hmac" ]] && ((${CA_REUSE_EXISTING_ACCOUNT:-0} == 0)); then
    echo -e "\n${C_RED}❌ Lỗi: EAB Key ID và EAB HMAC Key không được để trống!${C_RESET}\n"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  # Khởi tạo Deploy Hook và kích hoạt lịch gia hạn tự động lũy đẳng của WPTangToc OLS
  hook_script="/etc/wptt/ssl/wptt-paid-ssl-deploy-hook.sh"
  _ensure_paid_deploy_hook

	#triển khai cron gia hạn tự động ssl
  if [[ -f /etc/wptt/ssl/gia-han-tu-dong-ssl-let-encrypt ]]; then
    /bin/bash /etc/wptt/ssl/gia-han-tu-dong-ssl-let-encrypt >/dev/null 2>&1 || true
  fi

  paid_cert_name="${NAME}-paid"
  task_issue="Xác thực & Cấp phát SSL ($ca_provider_label) bằng Certbot cho $NAME"
  _runing "$task_issue"

  # Đăng ký trước tài khoản ACME EAB qua file cấu hình ẩn 0600 để:
  # 1. Không làm lộ khóa EAB HMAC trên danh sách tiến trình (ps aux)
  # 2. Không làm file /etc/letsencrypt/renewal/${NAME}-paid.conf bị phụ thuộc vào file .ini tạm khi gia hạn sau 60 ngày
  cb_eab_args=()
  if [[ -n "$eab_kid" && -n "$eab_hmac" ]]; then
    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    old_umask_eab=$(umask)
    umask 077
    tmp_eab_ini="$(mktemp -p /etc/wptt/tmp wptt_eab_XXXXXX.ini)"
    cat >"$tmp_eab_ini" <<EOF
eab-kid = $eab_kid
eab-hmac-key = $eab_hmac
EOF
    umask "$old_umask_eab"

    "$certbot_bin" register \
      --config "$tmp_eab_ini" \
      --server "$acme_server" \
      --email "admin@${NAME}" \
      --agree-tos --non-interactive >/dev/null 2>&1 || true

    cb_eab_args=(--eab-kid "$eab_kid" --eab-hmac-key "$eab_hmac")
    /bin/rm -f -- "$tmp_eab_ini" 2>/dev/null || true
    tmp_eab_ini=""
  fi

  log_file="/var/log/letsencrypt/letsencrypt.log"
  line_start=0
  [[ -f "$log_file" ]] && line_start=$(wc -l <"$log_file" 2>/dev/null || echo 0)

  issue_ok=0
  cb_common_args=(
    certonly --webroot -w "$webroot_path"
    --server "$acme_server"
    "${cb_eab_args[@]}"
    --email "admin@${NAME}"
    --agree-tos --non-interactive
    --cert-name "$paid_cert_name"
    --deploy-hook "$hook_script"
    --force-renewal
  )

  # Nếu www.$NAME đã được trỏ đúng DNS, ưu tiên xin cấp gộp cả www trước; nếu chưa trỏ thì chỉ xin $NAME
  if ((HAS_VALID_WWW_DNS == 1)); then
    if "$certbot_bin" "${cb_common_args[@]}" --key-type ecdsa --elliptic-curve secp256r1 -d "$NAME" -d "www.$NAME" >/dev/null 2>&1; then
      issue_ok=1
    elif "$certbot_bin" "${cb_common_args[@]}" --key-type ecdsa --elliptic-curve secp256r1 -d "$NAME" >/dev/null 2>&1; then
      issue_ok=1
    elif "$certbot_bin" "${cb_common_args[@]}" --key-type rsa --rsa-key-size 2048 -d "$NAME" -d "www.$NAME" >/dev/null 2>&1; then
      issue_ok=1
    elif "$certbot_bin" "${cb_common_args[@]}" --key-type rsa --rsa-key-size 2048 -d "$NAME" >/dev/null 2>&1; then
      issue_ok=1
    fi
  else
    if "$certbot_bin" "${cb_common_args[@]}" --key-type ecdsa --elliptic-curve secp256r1 -d "$NAME" >/dev/null 2>&1; then
      issue_ok=1
    elif "$certbot_bin" "${cb_common_args[@]}" --key-type rsa --rsa-key-size 2048 -d "$NAME" >/dev/null 2>&1; then
      issue_ok=1
    fi
  fi

  line_end=0
  [[ -f "$log_file" ]] && line_end=$(wc -l <"$log_file" 2>/dev/null || echo 0)
  lines_new=$((line_end - line_start))
  ((lines_new <= 0)) && lines_new=150
  recent_log="$(tail -n "$lines_new" "$log_file" 2>/dev/null || true)"

  if ((issue_ok == 0)); then
    _runloi "$task_issue"
    _diagnose_certbot_failure "$NAME" "$recent_log"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi
  _rundone "$task_issue"

  task_install="Tích hợp chứng chỉ vào OpenLiteSpeed & Đồng bộ Tự động gia hạn"
  _runing "$task_install"

  live_dir="/etc/letsencrypt/live/${paid_cert_name}"
