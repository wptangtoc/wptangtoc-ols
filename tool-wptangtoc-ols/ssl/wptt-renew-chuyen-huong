#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
function huong_dan() {
  cat << 'EOF'
  WPTangToc OLS có tính năng Renew thiết lập lại chuyển hướng HTTP to HTTPS, thì đây là một chức năng quan trọng giúp bạn kiểm tra, sửa chữa và áp dụng lại một cách dứt khoát quy tắc chuyển hướng toàn bộ truy cập từ giao thức http:// không an toàn sang https:// an toàn cho website của bạn.

  Nhấn mạnh rằng tính năng này không chỉ tạo mới mà còn có khả năng khôi phục hoặc sửa chữa một cấu hình chuyển hướng có thể đã bị lỗi hoặc thay đổi trước đó.

  Tính năng Renew [Làm mới] / Thiết lập lại Chuyển hướng HTTP to HTTPS
  🔒 Mục đích chính:
  * Sửa lỗi Chuyển hướng: Khắc phục các tình huống mà việc tự động chuyển từ HTTP sang HTTPS bị hỏng, không hoạt động hoặc hoạt động không chính xác do thay đổi cấu hình, cập nhật hoặc lỗi nào đó.
  * Đảm bảo Tính Đúng đắn: Xác minh và áp dụng lại quy tắc chuyển hướng theo phương pháp chuẩn [thường là 301 Permanent Redirect] mà công cụ WPTangToc OLS khuyên dùng.
  * Tiêu chuẩn hóa Cấu hình: Đảm bảo tất cả các website được quản lý đều áp dụng một cơ chế chuyển hướng HTTPS đồng nhất và hiệu quả.
  * Đơn giản hóa Quản lý: Cung cấp một nút bấm hoặc lệnh duy nhất để xử lý toàn bộ việc enforces HTTPS, thay vì phải can thiệp thủ công vào cấu hình OpenLiteSpeed.
  * Hỗ trợ Sau khi Cài/Gia hạn SSL: Là một bước cần thiết sau khi bạn cài đặt hoặc gia hạn thành công chứng chỉ SSL để đảm bảo website ngay lập tức sử dụng nó.

  Tóm lại: Tính năng Renew thiết lập lại chuyển hướng HTTP to HTTPS trong WPTangToc OLS là một công cụ mạnh mẽ và tiện lợi, giúp bạn đảm bảo rằng website của mình luôn hoạt động một cách an toàn và nhất quán trên giao thức HTTPS, đồng thời dễ dàng sửa chữa các lỗi cấu hình liên quan.
EOF
}

# shellcheck source=/dev/null
. /etc/wptt/echo-color
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true

NAME="${1:-}"
[[ "$NAME" == "98" ]] && NAME=""

tmp_ht=""

# ==============================================================================
# GIAO DIỆN CHỌN DOMAIN VÀ ĐIỀU HƯỚNG MENU
# ==============================================================================
if [[ -z "$NAME" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}${quan_ly_ssl} ➜ Renew chuyển hướng HTTP TO HTTPS${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  
  if [[ -f /etc/wptt/tenmien-them-lua-chon-tat-ca-website ]]; then
    . /etc/wptt/tenmien-them-lua-chon-tat-ca-website
    lua_chon_NAME "Renew chuyển hướng HTTP TO HTTPS"
  else
    _runloi "Không tìm thấy module menu"
    return 1 2>/dev/null || exit 1
  fi
fi

# Chuyển hướng thoát an toàn
[[ "$NAME" == "0" || -z "$NAME" ]] && { [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1 || return 0 2>/dev/null || exit 0; }

# ==============================================================================
# KHỐI XỬ LÝ HÀNG LOẠT (TẤT CẢ WEBSITE)
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    # Validate tên miền hợp lệ và thư mục mã nguồn tồn tại
    if [[ "$domain" =~ ^[a-zA-Z0-9.-]+$ && -d "/usr/local/lsws/$domain/html" ]]; then
      
      # Dùng thư viện lõi để thẩm định tính khả dụng của SSL
      if /bin/bash /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$domain" >/dev/null 2>&1; then
        UI_STRING="Renew chuyển hướng SSL $domain"
        _runing "$UI_STRING"
        
        # Gọi tiến trình con để xử lý độc lập từng domain
        if /bin/bash /etc/wptt/ssl/wptt-renew-chuyen-huong "$domain" >/dev/null 2>&1; then
          _rundone "$UI_STRING"
        else
          _runloi "$UI_STRING"
        fi
      fi
    fi
  done
  shopt -u nullglob

  if [[ "${1:-}" == "98" ]];then
		exec /etc/wptt/wptt-ssl-main 1
	fi
  return 0 2>/dev/null || exit 0
fi

# ==============================================================================
# KHỐI XỬ LÝ ĐƠN LẺ MỘT TÊN MIỀN (CORE LOGIC)
# ==============================================================================
# Validate chốt chặn Injection
if [[ ! "$NAME" =~ ^[a-zA-Z0-9.-]+$ ]]; then
  _runloi "Tên miền không hợp lệ: $NAME"
  return 1 2>/dev/null || exit 1
fi

path_conf="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$path_conf" && ! -f "/etc/wptt/chuyen-huong/.$NAME.conf" ]]; then
  clear
  echoDo "Tên miền này không tồn tại trên hệ thống"
  sleep 2
  if [[ "${1:-}" == "98" ]];then
		exec /etc/wptt/wptt-ssl-main 1
	fi
  return 1 2>/dev/null || exit 1
fi

# ------------------------------------------------------------------------------
# KIỂM TRA ĐIỀU KIỆN TIÊN QUYẾT: SSL PHẢI KHẢ DỤNG TRƯỚC KHI ÉP HTTPS
# ------------------------------------------------------------------------------
# Bước 1: Gọi thư viện lõi kiểm tra chứng chỉ SSL Local
if ! /bin/bash /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$NAME" >/dev/null 2>&1; then
  # Bước 2: Fallback - Kiểm tra proxy Cloudflare (Đám mây cam)
  if ! curl -Is -m 5 "https://$NAME" 2>/dev/null | grep -qi -E 'cloudflare|cf-ray'; then
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_RED}LỖI: GIAO THỨC HTTPS CHƯA SẴN SÀNG!${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " Tên miền   : ${C_YELLOW}$NAME${C_RESET}" 2
    left_text " Trạng thái : ${C_RED}Không tìm thấy SSL khả dụng / Không có Proxy Cloudflare${C_RESET}" 2
    left_text " Giải pháp  : Vui lòng cài đặt SSL trước khi ép chuyển hướng." 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    sleep 3
    if [[ "${1:-}" == "98" ]];then
			exec /etc/wptt/wptt-ssl-main 1
		fi
    return 1 2>/dev/null || exit 1
  fi
fi

UI_STRING="Setup Chuyển hướng website $NAME (HTTP TO HTTPS)"
_runing "$UI_STRING"

# Load cấu hình Vhost và PHP
if ! . /etc/wptt/php/php-cli-domain-config "$NAME" >/dev/null 2>&1; then
  _runloi "$UI_STRING"
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME"
  return 1 2>/dev/null || exit 1
fi

# shellcheck source=/dev/null
. "$path_conf"
docroot="/usr/local/lsws/$NAME/html"
has_www_intent="0" # Mặc định là Non-WWW

# ------------------------------------------------------------------------------
# ĐỒNG BỘ URL VỚI DATABASE WORDPRESS (TỐI ƯU WP-CLI NON-BLOCKING)
# ------------------------------------------------------------------------------
if [[ -f "$docroot/wp-config.php" ]]; then
  WP_EXEC=(/sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp)
  
  # Chỉ dùng 1 lệnh get duy nhất để đọc trạng thái hiện tại
  current_home=$("${WP_EXEC[@]}" option get home --path="$docroot" 2>/dev/null || echo "")
  
  if [[ "$current_home" == *"//www."* ]]; then
    has_www_intent="1"
    # Tiết kiệm CPU: Chỉ Update nếu URL thực sự đang bị sai (Thiếu HTTPS)
    if [[ "$current_home" != "https://www.$NAME" ]]; then
      "${WP_EXEC[@]}" option update home "https://www.$NAME" --path="$docroot" >/dev/null 2>&1
      "${WP_EXEC[@]}" option update siteurl "https://www.$NAME" --path="$docroot" >/dev/null 2>&1
    fi
  else
    # Tiết kiệm CPU: Chỉ Update nếu URL thực sự đang bị sai (Thiếu HTTPS)
    if [[ "$current_home" != "https://$NAME" && -n "$current_home" ]]; then
      "${WP_EXEC[@]}" option update home "https://$NAME" --path="$docroot" >/dev/null 2>&1
      "${WP_EXEC[@]}" option update siteurl "https://$NAME" --path="$docroot" >/dev/null 2>&1
    fi
  fi
fi

# ------------------------------------------------------------------------------
# KIẾN TẠO HTACCESS NGUYÊN TỬ BẰNG THƯ VIỆN LÕI (CORE-FUNCTIONS)
# ------------------------------------------------------------------------------
htaccess_file="$docroot/.htaccess"


# Tạo file .htaccess gốc nếu chưa có để lấy mẫu quyền User
if [[ ! -f "$htaccess_file" ]]; then
  /bin/touch -- "$htaccess_file"
  /bin/chown -- "${User_name_vhost}:${Group_name_vhost:-$User_name_vhost}" "$htaccess_file"
  /bin/chmod 644 -- "$htaccess_file"
fi

# ==============================================================================
# "LƯỚI AN TOÀN": Kiểm tra xem WWW có tồn tại và an toàn để ép Redirect không?
# ==============================================================================
is_www_safe=0

# Cách 1: Đọc chứng chỉ Let's Encrypt
if [[ -f "/etc/letsencrypt/live/$NAME/cert.pem" ]]; then
  if openssl x509 -in "/etc/letsencrypt/live/$NAME/cert.pem" -noout -text 2>/dev/null | grep -q "DNS:www.$NAME"; then
    is_www_safe=1
  fi
# Cách 2: Đọc chứng chỉ Trả phí (Custom SSL)
elif [[ -f "/usr/local/lsws/$NAME/ssl/cert.crt" ]]; then
  if openssl x509 -in "/usr/local/lsws/$NAME/ssl/cert.crt" -noout -text 2>/dev/null | grep -q "DNS:www.$NAME"; then
    is_www_safe=1
  fi
fi

# Cách 3: Fallback - Thử bắt tay cURL (Cho trường hợp dùng Cloudflare SSL)
if [[ "$is_www_safe" == "0" ]]; then
  if curl -Is -m 5 "https://www.$NAME" >/dev/null 2>&1; then
    is_www_safe=1
  fi
fi

# ==============================================================================
# CHUẨN BỊ RULES CHUYỂN HƯỚNG "1 TRẠM" (SINGLE-HOP REDIRECT) TỐI ƯU SEO
# ==============================================================================
rules_block="#begin-chuyen-huong-http-to-https-wptangtoc-ols\n<IfModule mod_rewrite.c>\nRewriteEngine On\n"

if [[ "$is_www_safe" == "1" ]]; then
  # WWW AN TOÀN -> Ép Kép (HTTPS + Chuẩn hóa WWW/Non-WWW) bằng cờ [OR]
  if [[ "$has_www_intent" == "1" ]]; then
    rules_block+="RewriteCond %{HTTPS} !=on [OR]\n"
    rules_block+="RewriteCond %{HTTP_HOST} !^www\. [NC]\n"
    rules_block+="RewriteRule ^(.*)$ https://www.${NAME}/\$1 [R=301,L,NE]\n"
  else
    rules_block+="RewriteCond %{HTTPS} !=on [OR]\n"
    rules_block+="RewriteCond %{HTTP_HOST} ^www\. [NC]\n"
    rules_block+="RewriteRule ^(.*)$ https://${NAME}/\$1 [R=301,L,NE]\n"
  fi
else
  # WWW KHÔNG AN TOÀN (Lỗi DNS/Chưa có SSL) -> Chỉ ép đơn (HTTP -> HTTPS) giữ nguyên Host
  rules_block+="RewriteCond %{HTTPS} !=on\n"
  rules_block+="RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]\n"
fi
rules_block+="</IfModule>\n#end-chuyen-huong-http-to-https-wptangtoc-ols"

# ==================== BẮT ĐẦU GIAO DỊCH GHI NGUYÊN TỬ ====================

# 1. Khởi tạo file tạm an toàn từ hàm lõi
if type wptt_atomic_begin >/dev/null 2>&1; then
  tmp_ht=$(wptt_atomic_begin "$htaccess_file")
else
  tmp_ht="/etc/wptt/tmp/htaccess_${NAME}_$$.tmp"
  /bin/touch -- "$tmp_ht"
  /bin/chmod --reference="$htaccess_file" "$tmp_ht"
  /bin/chown --reference="$htaccess_file" "$tmp_ht"
fi

# 2. Bơm rule mới lên đỉnh, lọc bỏ hoàn toàn các khối rule cũ
echo -e "$rules_block" > "$tmp_ht"
/bin/sed -e '/^#begin-chuyen-huong-http-to-https-wptangtoc-ols/,/^#end-chuyen-huong-http-to-https-wptangtoc-ols$/d' \
         -e '/^#begin-chuyen-huong-www-to-non-www-wptangtoc-ols/,/^#end-chuyen-huong-www-to-non-www-wptangtoc-ols$/d' \
         -e '/^#begin-chuyen-huong-non-www-to-www-wptangtoc-ols/,/^#end-chuyen-huong-non-www-to-www-wptangtoc-ols$/d' \
         "$htaccess_file" >> "$tmp_ht"

# 3. Chốt giao dịch nguyên tử
if type wptt_atomic_commit >/dev/null 2>&1; then
  wptt_atomic_commit "$tmp_ht" "$htaccess_file"
else
  /bin/mv -T -- "$tmp_ht" "$htaccess_file"
fi
tmp_ht="" # Xóa track biến để hàm Trap không cần xử lý nữa

# ------------------------------------------------------------------------------
# KẾT THÚC VÀ BÁO CÁO
# ------------------------------------------------------------------------------
wptt_smart_reload_lsws >/dev/null 2>&1
wptt_logs "INFO" "Cấu hình renew chuyển hướng website $NAME hoàn tất"

_rundone "$UI_STRING"

# Thoát bằng return || exit đảm bảo an toàn tuyệt đối cho cả lệnh Execute lẫn Source
if [[ "${1:-}" == "98" ]];then
	exec /etc/wptt/wptt-ssl-main 1
fi
