#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026 - Enterprise Standard

function huong_dan() {
  cat <<'EOF'
  Tính năng Xóa SSL trả phí là quá trình gỡ bỏ một chứng chỉ SSL/TLS thương mại [mà bạn đã mua từ các nhà cung cấp như DigiCert, Sectigo, Comodo, v.v.] khỏi máy chủ web cho một tên miền cụ thể. Việc này thường đi kèm với việc vô hiệu hóa cấu hình HTTPS liên quan đến chứng chỉ đó, có thể khiến website quay lại sử dụng HTTP hoặc chuyển sang một chứng chỉ SSL khác.

  Nói một cách đơn giản, đây là hành động gỡ bỏ giấy phép bảo mật có trả phí khỏi website của bạn, làm cho website không còn sử dụng kết nối mã hóa HTTPS thông qua chứng chỉ cụ thể đó nữa.

  Mục Đích Chính
  * Chứng chỉ hết hạn và không gia hạn: Chuyển sang Let's Encrypt miễn phí hoặc ngừng website.
  * Thay đổi nhà cung cấp: Cấu hình lại chứng chỉ từ bên cấp khác.
  * Sự cố khóa bí mật: Khóa riêng tư bị lộ, cần gỡ bỏ ngay lập tức.
  * Cấu hình lại máy chủ: Tối ưu hóa lại các vhost trên hệ thống.
EOF
}

# Phòng ngừa kẹt thư mục làm việc khi thao tác
cd /root 2>/dev/null || cd /

. /etc/wptt/.wptt.conf 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

if [[ "${1:-}" == "98" ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-ssl-main 1"
fi

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl:-Quản lý SSL} ➜ Gỡ bỏ Chứng chỉ SSL Trả phí (Paid SSL)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

NAME="${1:-}"
[[ "$NAME" == "98" ]] && NAME=""

if [[ -z "$NAME" ]]; then
  function lua_chon_NAME() {
    unset NAME selects
    selects=()
    local box_inner_width=${box_inner_width:-71}

    # Quét Vhost thường
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"
      if [[ "$domain" == ?*.?* && -d "/usr/local/lsws/$domain/ssl" ]]; then
        selects+=("$domain")
      fi
    done

    # Quét Domain chuyển hướng
    if [[ -d "/etc/wptt/chuyen-huong" ]]; then
      for filepath in /etc/wptt/chuyen-huong/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
        local domain="${filepath##*/}"
        domain="${domain%.conf}"
        domain="${domain#.}"
        if [[ "$domain" == ?*.?* && -d "/usr/local/lsws/$domain/ssl" ]]; then
          selects+=("$domain")
        fi
      done
    fi

    # Lọc trùng lặp
    if [[ ${#selects[@]} -gt 0 ]]; then
      mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
    else
      echo -e "${C_YELLOW}⚠️ Hệ thống hiện không có Website nào đang sử dụng cấu hình SSL Trả phí!${C_RESET}"
      sleep 3
      exec /etc/wptt/wptt-ssl-main 1
    fi

    # Render Menu
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    local title_text="Lựa chọn Website bạn muốn XÓA chứng chỉ SSL Trả phí:"
    local len=$(echo -n "$title_text" | awk '{print length($0)}')
    local pad_r=$((box_inner_width - len - 2))
    [[ $pad_r -lt 0 ]] && pad_r=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    local pad_line_r=$((box_inner_width - line_len))
    [[ $pad_line_r -lt 0 ]] && pad_line_r=0
    local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
    echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

    local i=1
    for dom in "${selects[@]}"; do
      local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-30s${C_RESET} ${C_GREEN}[Có SSL Paid]${C_RESET}" "$i" "$dom")
      local clean_text=$(printf "  %3d) %-30s [Có SSL Paid]" "$i" "$dom")
      local item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
      local pad=$((box_inner_width - item_len))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
      ((i++))
    done
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    local fzf_installed=false
    if command -v fzf &>/dev/null; then
      fzf_installed=true
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
    else
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
    fi

    while true; do
      echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
      if ! read -r REPLY; then exit 1; fi
      REPLY="${REPLY// /}"
      REPLY="${REPLY,,}"

      case "$REPLY" in
      0)
        echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
        NAME="0"
        return 0
        ;;
      00)
        if $fzf_installed; then
          local selected_item
          selected_item=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website xóa SSL >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
          local dom
          dom=$(echo "$selected_item" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | cut -d'|' -f1)
          if [[ -n "$dom" ]]; then
            NAME="$dom"
            return 0
          else
            echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"
          fi
        else
          echo -e "${C_RED}Lỗi: FZF chưa cài đặt.${C_RESET}"
        fi
        ;;
      *)
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
          local action_index=$((REPLY - 1))
          NAME=$(echo "${selects[$action_index]}" | cut -d'|' -f1)
          return 0
        else
          echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
        ;;
      esac
    done
  }
  lua_chon_NAME
fi

# Chốt chặn thoát an toàn
[[ "$NAME" == "0" || -z "$NAME" ]] && {
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-ssl-main 1
  fi
  return 2>/dev/null || exit 0
}

pathcheck="/etc/wptt/vhost/.${NAME}.conf"
[[ ! -f "$pathcheck" && ! -f "/etc/wptt/chuyen-huong/.${NAME}.conf" ]] && {
  echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 2
  exec /etc/wptt/wptt-ssl-main 1
}

if [[ ! -d "/usr/local/lsws/${NAME}/ssl" ]]; then
  echo -e "\n${C_RED}❌ Website $NAME chưa thiết lập SSL Trả phí (Không tìm thấy thư mục cấu hình).${C_RESET}"
  sleep 2
  exec /etc/wptt/wptt-ssl-main 1
fi

# ==============================================================================
# XÁC NHẬN GỠ BỎ
# ==============================================================================
echo ""
extra_msg=""
if [[ -f "/etc/letsencrypt/live/${NAME}/cert.pem" ]]; then
  extra_msg="${C_GREEN}* Hệ thống sẽ tự động Fallback cấu hình về chứng chỉ Let's Encrypt hiện có.${C_RESET}"
else
  extra_msg="${C_YELLOW}* Hệ thống sẽ tự động tạo chứng chỉ Tự Ký (Self-Signed 10 năm) để OLS luôn an toàn.${C_RESET}"
fi

if wptt_xac_nhan "Bạn có chắc chắn muốn GỠ BỎ cấu hình SSL Trả phí của website này?" "${C_BOLD_WHITE}Website:${C_RESET} ${C_YELLOW}$NAME${C_RESET}\n$extra_msg" "" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then
  echo ""
  _runing "Tiến hành gỡ bỏ cấu hình và thiết lập Fallback SSL..."

  # --- 1. CHUẨN BỊ SSL TỰ KÝ 10 NĂM (DÙNG CHO LISTENER HOẶC FALLBACK VHOST) ---
  ssl_tuky_dir="/etc/wptt-ssl-tu-ky/${NAME}"
  if [[ ! -f "${ssl_tuky_dir}/${NAME}.key" || ! -f "${ssl_tuky_dir}/cert.crt" ]]; then
    mkdir -p "$ssl_tuky_dir"
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
      -keyout "${ssl_tuky_dir}/${NAME}.key" \
      -out "${ssl_tuky_dir}/cert.crt" \
      -subj "/C=VN/ST=Hanoi/L=Hanoi/O=WPTangToc OLS/CN=${NAME}" >/dev/null 2>&1
  fi

  # --- 2. XÁC ĐỊNH LOẠI SSL FALLBACK CHO VHOST ---
  if [[ -f "/etc/letsencrypt/live/${NAME}/cert.pem" ]]; then
    ssl_type="letsencrypt"
    ssl_key="/etc/letsencrypt/live/${NAME}/privkey.pem"
    ssl_cert="/etc/letsencrypt/live/${NAME}/cert.pem"
    ssl_ca="/etc/letsencrypt/live/${NAME}/chain.pem"
    fallback_status="Phục hồi về Let's Encrypt"
  else
    ssl_type="self-signed"
    ssl_key="${ssl_tuky_dir}/${NAME}.key"
    ssl_cert="${ssl_tuky_dir}/cert.crt"
    ssl_ca=""
    fallback_status="Cấp mới chứng chỉ Tự ký (Self-Signed)"
  fi

  # --- 3. CẬP NHẬT LISTENER HTTPD NGUYÊN TỬ (NẾU LÀ WEBSITE CHÍNH) ---
  # Nguyên tắc: Listener port 443 chỉ dùng SSL tự ký để đảm bảo tính bất tử cho socket HTTPS
  if [[ "$NAME" == "$Website_chinh" ]]; then
    ols_conf="/usr/local/lsws/conf/httpd_config.conf"
    if [[ -f "$ols_conf" ]]; then
      tmp_ols=$(wptt_atomic_begin "$ols_conf")
      if [[ -n "$tmp_ols" ]]; then
        sed -i "/keyFile/d" "$tmp_ols"
        sed -i "/certFile/d" "$tmp_ols"
        sed -i "/CACertFile/d" "$tmp_ols"

        sed -i "/https/a \  keyFile               ${ssl_tuky_dir}/${NAME}.key\n  certFile              ${ssl_tuky_dir}/cert.crt" "$tmp_ols"
        wptt_atomic_commit "$tmp_ols" "$ols_conf"
      fi
    fi
  fi

  # --- 4. CẬP NHẬT CẤU HÌNH VHOST NGUYÊN TỬ (ATOMIC EDIT) ---
  vhost_conf="/usr/local/lsws/conf/vhosts/${NAME}/${NAME}.conf"
  if [[ -f "$vhost_conf" ]]; then
    tmp_vhost=$(wptt_atomic_begin "$vhost_conf")
    if [[ -n "$tmp_vhost" ]]; then
      # Gỡ bỏ block vhssl cũ
      sed -i -e '/^[[:space:]]*vhssl[[:space:]]*{/,/^[[:space:]]*}[[:space:]]*$/d' "$tmp_vhost"

      # Ghi đè block vhssl mới an toàn
      if [[ "$ssl_type" == "letsencrypt" ]]; then
        cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $ssl_key
  certFile                $ssl_cert
  certChain               0
  CACertFile              $ssl_ca
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
      else
        cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $ssl_key
  certFile                $ssl_cert
  certChain               0
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
      fi

      wptt_atomic_commit "$tmp_vhost" "$vhost_conf"
    fi
  fi

  # --- 5. XÓA THƯ MỤC SSL TRẢ PHÍ CŨ ---
  if [[ -d "/usr/local/lsws/${NAME}/ssl" ]]; then
    /bin/rm -rf "/usr/local/lsws/${NAME:?}/ssl" 2>/dev/null || true
  fi

  # --- 6. XÓA RULE CHUYỂN HƯỚNG TRONG .HTACCESS (ATOMIC EDIT) ---
  ht_file="/usr/local/lsws/${NAME}/html/.htaccess"
  if [[ -f "$ht_file" ]]; then
    tmp_ht=$(wptt_atomic_begin "$ht_file")
    if [[ -n "$tmp_ht" ]]; then
      sed -i -e '/^#begin-chuyen-huong-http-to-https-wptangtoc-ols/,/^#end-chuyen-huong-http-to-https-wptangtoc-ols$/d' "$tmp_ht"
      sed -i -e '/^#begin-chuyen-huong-www-to-non-www-wptangtoc-ols/,/^#end-chuyen-huong-www-to-non-www-wptangtoc-ols$/d' "$tmp_ht"
      sed -i -e '/^#begin-chuyen-huong-non-www-to-www-wptangtoc-ols/,/^#end-chuyen-huong-non-www-to-www-wptangtoc-ols$/d' "$tmp_ht"
      wptt_atomic_commit "$tmp_ht" "$ht_file"
    fi
  fi

  # Nạp lại OpenLiteSpeed nhẹ nhàng
  wptt_smart_reload_lsws >/dev/null 2>&1

  wptt_logs "INFO" "Xóa cài đặt ssl trả phí website $NAME" 2>/dev/null || true
  _rundone "Tiến hành gỡ bỏ cấu hình và thiết lập Fallback SSL..."

  # ==============================================================================
  # BÁO CÁO HOÀN TẤT
  # ==============================================================================
  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ SSL TRẢ PHÍ${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website thao tác : ${C_YELLOW}$NAME${C_RESET}"
  left_text "Trạng thái mới   : ${C_GREEN}$fallback_status${C_RESET}"
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

else
  echo -e "${C_YELLOW}Đã hủy thao tác xóa cấu hình SSL Trả phí.${C_RESET}"
fi

if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-ssl-main 1
fi
