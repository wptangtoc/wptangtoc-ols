#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026 - Enterprise Standard
# @description: Gỡ bỏ Chứng chỉ SSL Trả phí / GTS / ZeroSSL (Paid & Custom ACME SSL)

function huong_dan() {
  cat <<'EOF'
  Tính năng Xóa SSL trả phí là quá trình gỡ bỏ một chứng chỉ SSL/TLS thương mại [mà bạn đã mua từ các nhà cung cấp như DigiCert, Sectigo, Comodo] hoặc chứng chỉ cấp qua ACME EAB [Google Trust Services (GTS), ZeroSSL] khỏi máy chủ web cho một tên miền cụ thể.

  Nói một cách đơn giản, đây là hành động gỡ bỏ giấy phép bảo mật hiện tại khỏi website của bạn và tự động chuyển đổi an toàn về chứng chỉ Let's Encrypt miễn phí sẵn có (hoặc chứng chỉ Tự ký bảo vệ Socket 443 của OpenLiteSpeed).

  Mục Đích Chính
  * Chứng chỉ hết hạn và không gia hạn: Chuyển về Let's Encrypt miễn phí hoặc ngừng sử dụng gói trả phí.
  * Ngắt chu kỳ gia hạn tự động ACME EAB (${NAME}-paid) của Google Trust Services (GTS) / ZeroSSL / Sectigo / DigiCert.
  * Thay đổi nhà cung cấp: Làm sạch cấu hình SSL cũ để nạp chứng chỉ mới.
  * Sự cố khóa bí mật: Khóa riêng tư (.key) bị lộ, cần thu hồi và gỡ bỏ ngay lập tức.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
stty iutf8 2>/dev/null || true
umask 022

# Phòng ngừa kẹt thư mục làm việc khi thao tác xóa
cd /root 2>/dev/null || cd /

# ==============================================================================
# MODULE BẢO VỆ & DỌN DẸP RÁC TỰ ĐỘNG (TRAP CLEANUP)
# ==============================================================================
tmp_ols=""
tmp_vhost=""
tmp_ht=""

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi
  [[ -n "${tmp_ols:-}" && -f "$tmp_ols" ]] && /bin/rm -f -- "$tmp_ols" 2>/dev/null || true
  [[ -n "${tmp_vhost:-}" && -f "$tmp_vhost" ]] && /bin/rm -f -- "$tmp_vhost" 2>/dev/null || true
  [[ -n "${tmp_ht:-}" && -f "$tmp_ht" ]] && /bin/rm -f -- "$tmp_ht" 2>/dev/null || true
  if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    exit "$rc"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
fi

# ==============================================================================
# KHỞI TẠO MÔI TRƯỜNG & THƯ VIỆN
# ==============================================================================
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && wptt_load_main_conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/${ngon_ngu}.sh" ]] && . "/etc/wptt/lang/${ngon_ngu}.sh" 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null || true

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl:-Quản lý SSL} ➜ Gỡ bỏ Chứng chỉ SSL Trả phí / GTS / ZeroSSL${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

route_arg="${1:-}"
NAME="${1:-}"
[[ "$NAME" == "98" || "$NAME" == "1" ]] && NAME=""

# Hàm kiểm tra tên miền có đang gắn cấu hình SSL trả phí hoặc ACME ${domain}-paid hay không
_has_paid_ssl_installed() {
  local dom="$1"
  [[ -d "/usr/local/lsws/${dom}/ssl" || -f "/etc/letsencrypt/renewal/${dom}-paid.conf" || -d "/etc/letsencrypt/live/${dom}-paid" ]]
}

# Hàm nhận diện chính xác tên hãng CA (GTS, ZeroSSL, Sectigo, DigiCert...) 0-Subshell
_detect_paid_ssl_provider() {
  local dom="$1"
  local renewal_conf="/etc/letsencrypt/renewal/${dom}-paid.conf"
  local line="" server_url=""

  if [[ -f "$renewal_conf" ]]; then
    while IFS= read -r line; do
      if [[ "$line" == server[[:space:]]*=* ]]; then
        server_url="${line#*=}"
        server_url="${server_url//[[:space:]]/}"
        break
      fi
    done <"$renewal_conf"

    case "${server_url,,}" in
      *pki.goog* | *google*)
        printf 'Google Trust (GTS)'
        return 0
        ;;
      *zerossl.com*)
        printf 'ZeroSSL ACME'
        return 0
        ;;
      *sectigo.com* | *comodo*)
        printf 'Sectigo ACME'
        return 0
        ;;
      *digicert.com*)
        printf 'DigiCert ACME'
        return 0
        ;;
      *ssl.com*)
        printf 'SSL.com ACME'
        return 0
        ;;
      *buypass.com*)
        printf 'Buypass ACME'
        return 0
        ;;
      *)
        printf 'Auto ACME EAB'
        return 0
        ;;
    esac
  fi

  if [[ -d "/etc/letsencrypt/live/${dom}-paid" ]]; then
    printf 'Auto ACME EAB'
  else
    printf 'SSL Paid Thủ công'
  fi
}

# ==============================================================================
# 1. MENU LỌC & CHỌN WEBSITE ĐANG DÙNG SSL TRẢ PHÍ / GTS / ZEROSSL
# ==============================================================================
if [[ -z "$NAME" ]]; then
  function lua_chon_NAME() {
    unset NAME
    if [[ "${CI:-}" == "true" || "${GITHUB_ACTIONS:-}" == "true" ]] && [[ -t 0 ]]; then
      return 1
    fi

    # [BẢO MẬT UX]: Tắt hiển thị phím gõ & xả sạch bộ đệm trong lúc quét và vẽ khung
    if [[ -t 0 ]]; then stty -echo 2>/dev/null || true; fi
    if declare -F wptt_flush_stdin >/dev/null 2>&1; then
      wptt_flush_stdin
    fi

    local selects=()
    local box_inner_width="${box_inner_width:-78}"
    local filepath domain

    shopt -s nullglob
    # Quét Vhost thường và Domain chuyển hướng
    for filepath in /etc/wptt/vhost/.*.conf /etc/wptt/chuyen-huong/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"
      if [[ "$domain" == ?*.?* && "$domain" != *..* ]] && _has_paid_ssl_installed "$domain"; then
        selects+=("$domain")
      fi
    done
    shopt -u nullglob

    if ((${#selects[@]} == 0)); then
      if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi
      echo -e "${C_YELLOW}⚠️ Hệ thống hiện không có Website nào đang sử dụng SSL Trả phí / GTS / ZeroSSL!${C_RESET}"
      sleep 2.5
      wptt_quay_ve_menu "$route_arg" 0
    fi

    if ((${#selects[@]} > 1)); then
      mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
    fi

    # Render Khung Bo Cong chuẩn 78 ký tự (0 Subshell)
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    local title_text="Lựa chọn Website bạn muốn XÓA SSL Trả phí / GTS / ZeroSSL:"
    local len=${#title_text}
    local pad_r=$((box_inner_width - len - 2))
    ((pad_r < 0)) && pad_r=0
    local pad_r_str=""
    printf -v pad_r_str '%*s' "$pad_r" ""
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}${pad_r_str}${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    ((line_len > box_inner_width)) && line_len=$box_inner_width
    local pad_line_r=$((box_inner_width - line_len))
    ((pad_line_r < 0)) && pad_line_r=0
    local short_line="" pad_line_str=""
    printf -v short_line "%${line_len}s" ""
    short_line="${short_line// /─}"
    printf -v pad_line_str '%*s' "$pad_line_r" ""
    echo -e "${C_CYAN}├${short_line}${pad_line_str}│${C_RESET}"

    local i=1 dom provider_label badge_plain badge_color item_text clean_text item_len pad pad_str
    for dom in "${selects[@]}"; do
      provider_label="$(_detect_paid_ssl_provider "$dom")"
      if [[ "$provider_label" == "SSL Paid Thủ công" ]]; then
        badge_plain="[${provider_label}]"
        badge_color="${C_CYAN}[${provider_label}]${C_RESET}"
      else
        badge_plain="[Auto: ${provider_label}]"
        badge_color="${C_GREEN}[Auto: ${provider_label}]${C_RESET}"
      fi

      printf -v item_text "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-36s${C_RESET} %s" "$i" "$dom" "$badge_color"
      printf -v clean_text "  %3d) %-36s %s" "$i" "$dom" "$badge_plain"

      item_len=${#clean_text}
      pad=$((box_inner_width - item_len))
      ((pad < 0)) && pad=0
      printf -v pad_str '%*s' "$pad" ""

      echo -e "${C_CYAN}│${C_RESET}${item_text}${pad_str}${C_CYAN}│${C_RESET}"
      ((i++))
    done
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    local fzf_installed=false
    local PROMPT_TEXT=""
    if command -v fzf >/dev/null 2>&1 && ((${#selects[@]} > 1)); then
      fzf_installed=true
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
    else
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
    fi

    # Bật lại hiển thị bàn phím trước vòng lặp nhập liệu
    if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi

    while true; do
      echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
      if declare -F wptt_flush_stdin >/dev/null 2>&1; then
        wptt_flush_stdin
      fi

      if ! read -r REPLY; then
        echo -e "\n${C_RED}⚠️ Đã mất kết nối Terminal (EOF). Đang thoát...${C_RESET}"
        exit 1
      fi
      REPLY="${REPLY//[[:space:]]/}"
      REPLY="${REPLY,,}"

      case "$REPLY" in
        0)
          echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
          NAME="0"
          return 0
          ;;
        00)
          if [[ "$fzf_installed" == true ]]; then
            local selected_item="" fzf_rc=0
            selected_item="$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website xóa SSL Paid >> " --height=40% --border=rounded --color=border:red --cycle --reverse)" || fzf_rc=$?
            selected_item="${selected_item#*: }"
            if ((fzf_rc == 0)) && [[ -n "$selected_item" ]]; then
              NAME="$selected_item"
              return 0
            else
              echo -e "\n${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"
            fi
          else
            echo -e "\n${C_RED}Lỗi: Tính năng chọn nhanh FZF không khả dụng.${C_RESET}"
          fi
          ;;
        *)
          if [[ "$REPLY" =~ ^[0-9]+$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#selects[@]})); then
            local action_index=$((10#$REPLY - 1))
            NAME="${selects[$action_index]}"
            return 0
          elif [[ "$REPLY" == ?*.?* && "$REPLY" != "." ]]; then
            local valid_d found_d=false
            for valid_d in "${selects[@]}"; do
              if [[ "$valid_d" == "$REPLY" ]]; then
                NAME="$valid_d"
                found_d=true
                break
              fi
            done
            if [[ "$found_d" == true ]]; then
              return 0
            else
              echo -e "\n${C_RED}❌ Tên miền '$REPLY' không có trong danh sách đang dùng SSL Trả phí / GTS / ZeroSSL!${C_RESET}"
            fi
          else
            echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
          fi
          ;;
      esac
    done
  }
  lua_chon_NAME
fi

# Chốt chặn thoát an toàn
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  wptt_quay_ve_menu "$route_arg" 0
fi

pathcheck="/etc/wptt/vhost/.${NAME}.conf"
if [[ ! -f "$pathcheck" && ! -f "/etc/wptt/chuyen-huong/.${NAME}.conf" ]]; then
  echo -e "\n${C_RED}❌ Tên miền '$NAME' không tồn tại trên hệ thống này!${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "$route_arg" 1
fi

if ! _has_paid_ssl_installed "$NAME"; then
  echo -e "\n${C_RED}❌ Website $NAME chưa thiết lập SSL Trả phí / GTS / ZeroSSL (Không tìm thấy thư mục cấu hình).${C_RESET}"
  sleep 2
  wptt_quay_ve_menu "$route_arg" 1
fi

current_provider="$(_detect_paid_ssl_provider "$NAME")"

# ==============================================================================
# 2. KIỂM TRA CHỨNG CHỈ FALLBACK (LET'S ENCRYPT CÒN HẠN HAY SELF-SIGNED)
# ==============================================================================
le_cert_valid=0
le_expired_notice=""
if [[ -s "/etc/letsencrypt/live/${NAME}/cert.pem" && -s "/etc/letsencrypt/live/${NAME}/privkey.pem" ]]; then
  if openssl x509 -checkend 0 -noout -in "/etc/letsencrypt/live/${NAME}/cert.pem" >/dev/null 2>&1; then
    le_cert_valid=1
  else
    le_expired_notice="${C_YELLOW}  (Lưu ý: Chứng chỉ Let's Encrypt cũ trên máy đã hết hạn nên không dùng làm Fallback)${C_RESET}\n"
  fi
fi

echo ""
extra_msg=""
if ((le_cert_valid == 1)); then
  extra_msg="${C_GREEN}* Hệ thống sẽ tự động Fallback cấu hình về chứng chỉ Let's Encrypt (còn hạn) hiện có.${C_RESET}"
else
  extra_msg="${le_expired_notice}${C_YELLOW}* Hệ thống sẽ tự động kích hoạt chứng chỉ Tự Ký (Self-Signed 10 năm) để bảo vệ OpenLiteSpeed.${C_RESET}"
fi

if [[ -f "/etc/letsencrypt/renewal/${NAME}-paid.conf" || -d "/etc/letsencrypt/live/${NAME}-paid" ]]; then
  extra_msg="${extra_msg}\n${C_CYAN}* Đồng thời ngắt và dọn dẹp cấu hình tự động gia hạn ACME EAB [${current_provider}] (${NAME}-paid).${C_RESET}"
fi

# ==============================================================================
# 3. XÁC NHẬN & THỰC THI GỠ BỎ NGUYÊN TỬ
# ==============================================================================
if wptt_xac_nhan "Bạn có chắc chắn muốn GỠ BỎ chứng chỉ [${current_provider}] của website này?" \
  "${C_BOLD_WHITE}Website:${C_RESET} ${C_YELLOW}$NAME${C_RESET} (${C_CYAN}${current_provider}${C_RESET})\n$extra_msg" \
  "" "Đồng ý Gỡ bỏ" "Hủy thao tác"; then

  echo ""
  TASK_REMOVE="Tiến hành gỡ bỏ cấu hình SSL [${current_provider}] và thiết lập Fallback SSL ($NAME)"
  _runing "$TASK_REMOVE"

  # --- BƯỚC 1: CHUẨN BỊ SSL TỰ KÝ 10 NĂM (BẢO VỆ QUYỀN 0600 CHO PRIVATE KEY) ---
  ssl_tuky_dir="/etc/wptt-ssl-tu-ky/${NAME}"
  /bin/mkdir -p -- "$ssl_tuky_dir"
  /bin/chmod 700 -- "$ssl_tuky_dir" 2>/dev/null || true

  key_file_tu_ky="${ssl_tuky_dir}/${NAME}.key"
  crt_file_tu_ky="${ssl_tuky_dir}/cert.crt"

  if [[ ! -s "$key_file_tu_ky" || ! -s "$crt_file_tu_ky" ]]; then
    old_umask=$(umask)
    umask 077
    /usr/bin/openssl req -x509 -nodes -days 3650 \
      -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
      -keyout "$key_file_tu_ky" \
      -out "$crt_file_tu_ky" \
      -addext "subjectAltName=DNS:$NAME,DNS:*.$NAME" \
      -subj "/C=VN/ST=Hai Phong/L=Hai Phong/O=WPTT/CN=$NAME" \
      >/dev/null 2>&1 || true
    umask "$old_umask"
    [[ -f "$key_file_tu_ky" ]] && /bin/chmod 600 -- "$key_file_tu_ky" 2>/dev/null || true
    [[ -f "$crt_file_tu_ky" ]] && /bin/chmod 644 -- "$crt_file_tu_ky" 2>/dev/null || true
  fi

  # --- BƯỚC 2: XÁC ĐỊNH LOẠI SSL FALLBACK CHO VHOST ---
  if ((le_cert_valid == 1)); then
    ssl_type="letsencrypt"
    ssl_key="/etc/letsencrypt/live/${NAME}/privkey.pem"
    ssl_cert="/etc/letsencrypt/live/${NAME}/cert.pem"
    ssl_ca="/etc/letsencrypt/live/${NAME}/chain.pem"
    fallback_status="Phục hồi về Let's Encrypt miễn phí (Đang còn hạn)"
  else
    ssl_type="self-signed"
    ssl_key="$key_file_tu_ky"
    ssl_cert="$crt_file_tu_ky"
    ssl_ca=""
    fallback_status="Chứng chỉ Tự ký (Self-Signed 10 năm)"
  fi

  # --- BƯỚC 3: CẬP NHẬT LISTENER HTTPD NGUYÊN TỬ (NẾU LÀ WEBSITE CHÍNH) ---
  if [[ -n "${Website_chinh:-}" && "$NAME" == "$Website_chinh" ]]; then
    ols_conf="/usr/local/lsws/conf/httpd_config.conf"
    if [[ -f "$ols_conf" ]] && ! grep -qF "$key_file_tu_ky" "$ols_conf" 2>/dev/null; then
      if declare -F wptt_atomic_begin >/dev/null 2>&1; then
        tmp_ols="$(wptt_atomic_begin "$ols_conf")"
      else
        /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
        tmp_ols="/etc/wptt/tmp/httpd_config_$$.tmp"
        /bin/cp -fp -- "$ols_conf" "$tmp_ols"
      fi

      if [[ -n "$tmp_ols" && -f "$tmp_ols" ]]; then
        /bin/sed -i "/keyFile/d; /certFile/d; /CACertFile/d" "$tmp_ols"
        /bin/sed -i "/listener[[:space:]]\+https[[:space:]]*{/a \\  keyFile                 ${key_file_tu_ky}\\n  certFile                ${crt_file_tu_ky}" "$tmp_ols"

        if declare -F wptt_atomic_commit >/dev/null 2>&1; then
          wptt_atomic_commit "$tmp_ols" "$ols_conf"
        else
          /bin/mv -f -- "$tmp_ols" "$ols_conf"
        fi
        tmp_ols=""
      fi
    fi
  fi

  # --- BƯỚC 4: CẬP NHẬT CẤU HÌNH VHOST NGUYÊN TỬ (ATOMIC EDIT) ---
  vhost_conf="/usr/local/lsws/conf/vhosts/${NAME}/${NAME}.conf"
  if [[ -f "$vhost_conf" ]]; then
    if declare -F wptt_atomic_begin >/dev/null 2>&1; then
      tmp_vhost="$(wptt_atomic_begin "$vhost_conf")"
    else
      /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
      tmp_vhost="/etc/wptt/tmp/vhost_${NAME}_$$.tmp"
      /bin/cp -fp -- "$vhost_conf" "$tmp_vhost"
    fi

    if [[ -n "$tmp_vhost" && -f "$tmp_vhost" ]]; then
      # Gỡ bỏ block vhssl cũ
      /bin/sed -i -e '/^[[:space:]]*vhssl[[:space:]]*{/,/^[[:space:]]*}[[:space:]]*$/d' "$tmp_vhost"

      # Ghi đè block vhssl mới an toàn
      if [[ "$ssl_type" == "letsencrypt" ]]; then
        cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $ssl_key
  certFile                $ssl_cert
  certChain               0
  CACertFile              $ssl_ca
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
      else
        cat <<EOF >>"$tmp_vhost"
vhssl  {
  keyFile                 $ssl_key
  certFile                $ssl_cert
  certChain               0
  sslProtocol             24
  renegProtection         1
  sslSessionCache         1
  sslSessionTickets       1
  enableSpdy              15
  enableQuic              1
}
EOF
      fi

      if declare -F wptt_atomic_commit >/dev/null 2>&1; then
        wptt_atomic_commit "$tmp_vhost" "$vhost_conf"
      else
        /bin/mv -f -- "$tmp_vhost" "$vhost_conf"
      fi
      tmp_vhost=""
    fi
  fi

  # --- BƯỚC 5: DỌN SẠCH ĐỊNH DANH CERTBOT ${NAME}-PAID & THƯ MỤC SSL TRẢ PHÍ ---
  if [[ -f "/etc/letsencrypt/renewal/${NAME}-paid.conf" || -d "/etc/letsencrypt/live/${NAME}-paid" ]]; then
    if command -v certbot >/dev/null 2>&1; then
      certbot delete --cert-name "${NAME}-paid" --non-interactive >/dev/null 2>&1 || true
    fi
    /bin/rm -rf -- "/etc/letsencrypt/live/${NAME:?}-paid" \
      "/etc/letsencrypt/archive/${NAME:?}-paid" \
      "/etc/letsencrypt/renewal/${NAME:?}-paid.conf" 2>/dev/null || true
  fi

  if [[ -d "/usr/local/lsws/${NAME}/ssl" ]]; then
    /bin/rm -rf -- "/usr/local/lsws/${NAME:?}/ssl" 2>/dev/null || true
  fi

  # --- BƯỚC 6: ĐỒNG BỘ RULE CHUYỂN HƯỚNG TRONG .HTACCESS THEO LOẠI FALLBACK ---
  if [[ "$ssl_type" == "self-signed" ]]; then
    ht_file="/usr/local/lsws/${NAME}/html/.htaccess"
    if [[ -f "$ht_file" ]]; then
      if declare -F wptt_atomic_begin >/dev/null 2>&1; then
        tmp_ht="$(wptt_atomic_begin "$ht_file")"
      else
        /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
        tmp_ht="/etc/wptt/tmp/ht_${NAME}_$$.tmp"
        /bin/cp -fp -- "$ht_file" "$tmp_ht"
      fi

      if [[ -n "$tmp_ht" && -f "$tmp_ht" ]]; then
        /bin/sed -i -e '/^#begin-chuyen-huong-http-to-https-wptangtoc-ols/,/^#end-chuyen-huong-http-to-https-wptangtoc-ols$/d' "$tmp_ht"
        /bin/sed -i -e '/^#begin-chuyen-huong-www-to-non-www-wptangtoc-ols/,/^#end-chuyen-huong-www-to-non-www-wptangtoc-ols$/d' "$tmp_ht"
        /bin/sed -i -e '/^#begin-chuyen-huong-non-www-to-www-wptangtoc-ols/,/^#end-chuyen-huong-non-www-to-www-wptangtoc-ols$/d' "$tmp_ht"

        if declare -F wptt_atomic_commit >/dev/null 2>&1; then
          wptt_atomic_commit "$tmp_ht" "$ht_file"
        else
          /bin/mv -f -- "$tmp_ht" "$ht_file"
        fi
        tmp_ht=""
      fi
    fi
  elif [[ -x /etc/wptt/ssl/wptt-renew-chuyen-huong ]]; then
    /bin/bash /etc/wptt/ssl/wptt-renew-chuyen-huong "$NAME" >/dev/null 2>&1 || true
  fi

  # Nạp lại OpenLiteSpeed không gián đoạn
  declare -F wptt_smart_reload_lsws >/dev/null 2>&1 && wptt_smart_reload_lsws >/dev/null 2>&1

  wptt_logs "INFO" "Xóa cài đặt SSL [${current_provider}] website $NAME (Fallback: $ssl_type)" 2>/dev/null || true
  _rundone "$TASK_REMOVE"

  # ==============================================================================
  # BÁO CÁO HOÀN TẤT
  # ==============================================================================
  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ BỎ CHỨNG CHỈ SSL (${current_provider^^})${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website thao tác : ${C_YELLOW}$NAME${C_RESET}" 2
  left_text "Đã gỡ bỏ gói     : ${C_RED}$current_provider${C_RESET}" 2
  left_text "Trạng thái mới   : ${C_GREEN}$fallback_status${C_RESET}" 2
  if [[ "$ssl_type" == "self-signed" ]]; then
    left_text "Gợi ý tiếp theo  : ${C_CYAN}Bạn có thể vào mục [Cài đặt SSL Let's Encrypt] để cấp SSL miễn phí.${C_RESET}" 2
  fi
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

else
  echo -e "\n${C_YELLOW}Đã hủy thao tác xóa cấu hình SSL (${current_provider}).${C_RESET}"
fi

wptt_quay_ve_menu "$route_arg" 0 "enter"
