#!/bin/bash

#thư viện để call vào những file như cài ssl và gia hạn thủ công
# Thiết lập cron gia hạn tự động SSL Let's Encrypt lũy đẳng
CURRENT_CRON=$(crontab -l 2>/dev/null)

# Kiểm tra xem dịch vụ Cron có đang hoạt động không (hỗ trợ cả crond - redhat và cron ubuntu)
if systemctl is-active --quiet crond || systemctl is-active --quiet cron; then #tính toán tình huống người dùng bị hỏng cron hoặc người dùng họ mask cron không cho cron chạy

		# [KẾ HOẠCH A]: DÙNG CRON (Vì Cron vẫn đang sống), vẫn ưu tiên dùng cron hơn vì đơn giản ssl letsencrypt gia hạn bằng cron đã rất đủ dùng rồi, còn nhẹ hơn chút, cũng chả cần chạy bù như .timer về cơ bản ssl letsencrypt chứng chỉ họ cho gia hạn trước 1 tháng nên cứ từ từ mà gia hạn
		if ! grep -q "/usr/bin/certbot renew" <<< "$CURRENT_CRON" || ! grep -q "/etc/wptt/ssl/auto-reset-ssl" <<< "$CURRENT_CRON"; then
			R_VAL=${RANDOM:-14}
			CERTBOT_MIN=$((R_VAL % 26))
			CERTBOT_HOUR=$((R_VAL % 12))

			(
			echo "$CURRENT_CRON" | grep -v -E "certbot renew|auto-reset-ssl"
			echo "$CERTBOT_MIN $CERTBOT_HOUR,$((CERTBOT_HOUR + 12)) * * * /usr/bin/certbot renew --quiet"
			echo "$((CERTBOT_MIN + 30)) $CERTBOT_HOUR * * * /etc/wptt/ssl/auto-reset-ssl >/dev/null 2>&1"
			) | crontab -

			systemctl restart crond 2>/dev/null || systemctl restart cron 2>/dev/null
		fi

	else
		# [KẾ HOẠCH B]: CRON ĐÃ CHẾT HOẶC BỊ MASK -> DÙNG SYSTEMD TIMERS
		if [ ! -f /etc/systemd/system/wptt-certbot.timer ]; then

				# 1. Tạo file Service (Định nghĩa công việc cần làm)
				cat << 'EOF' > /etc/systemd/system/wptt-certbot.service
[Unit]
Description=WPTangToc SSL Auto Renew Service
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet
# Chạy auto-reset-ssl sau khi Certbot gia hạn xong
ExecStartPost=/bin/bash -c "sleep 1800 && /etc/wptt/ssl/auto-reset-ssl >/dev/null 2>&1"
EOF

				# 2. Tạo file Timer (Định nghĩa lịch chạy)
				cat << 'EOF' > /etc/systemd/system/wptt-certbot.timer
[Unit]
Description=WPTangToc SSL Auto Renew Timer

[Timer]
# Chạy 2 lần mỗi ngày (0h và 12h)
OnCalendar=*-*-* 00,12:00:00
# Tính năng xịn của Systemd: Tự động Random trễ từ 1 giây đến 30 phút (1800s) chống bão API
RandomizedDelaySec=1800
# Chạy bù nếu máy chủ lỡ bị tắt vào đúng khung giờ đó
Persistent=true

[Install]
WantedBy=timers.target
EOF

				# Nạp lại cấu hình systemd và kích hoạt Kế hoạch B
				systemctl daemon-reload
				systemctl enable --now wptt-certbot.timer
		fi
fi
# End thiết lập gia hạn tự động SSL
# End thiết lập cron gia hạn tự động SSL Let's Encrypt lũy đẳng

