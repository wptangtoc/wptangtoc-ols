#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Thiết lập lịch tự động gia hạn SSL (Let's Encrypt & Paid ACME EAB) lũy đẳng

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
umask 022

# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true

CERTBOT_BIN="$(command -v certbot 2>/dev/null || echo "/usr/bin/certbot")"
CURRENT_CRON="$(crontab -l 2>/dev/null || true)"

# Kiểm tra xem dịch vụ Cron có đang hoạt động không (hỗ trợ cả crond trên RHEL/AlmaLinux và cron trên Ubuntu)
if systemctl is-active --quiet crond 2>/dev/null || systemctl is-active --quiet cron 2>/dev/null; then

  # [KẾ HOẠCH A]: DÙNG CRON (Lũy đẳng 100% - Dùng chung cho cả Let's Encrypt và SSL Trả phí Certbot EAB)
  if ! grep -q "certbot renew" <<<"$CURRENT_CRON" || ! grep -q "/etc/wptt/ssl/auto-reset-ssl" <<<"$CURRENT_CRON"; then
    R_VAL=${RANDOM:-14}
    CERTBOT_MIN=$((R_VAL % 26))
    CERTBOT_HOUR=$((R_VAL % 12))

    {
      [[ -n "$CURRENT_CRON" ]] && grep -v -E "certbot renew|/etc/wptt/ssl/auto-reset-ssl" <<<"$CURRENT_CRON" || true
      printf '%d %d,%d * * * %s renew --quiet\n' "$CERTBOT_MIN" "$CERTBOT_HOUR" "$((CERTBOT_HOUR + 12))" "$CERTBOT_BIN"
      printf '%d %d * * * /etc/wptt/ssl/auto-reset-ssl >/dev/null 2>&1\n' "$((CERTBOT_MIN + 30))" "$CERTBOT_HOUR"
    } | crontab -

    systemctl reload crond 2>/dev/null || systemctl reload cron 2>/dev/null ||
      systemctl restart crond 2>/dev/null || systemctl restart cron 2>/dev/null || true
  fi

else
  # [KẾ HOẠCH B]: CRON ĐÃ CHẾT HOẶC BỊ MASK -> DÙNG SYSTEMD TIMERS
  if [[ ! -f /etc/systemd/system/wptt-certbot.timer ]]; then

    cat <<EOF >/etc/systemd/system/wptt-certbot.service
[Unit]
Description=WPTangToc SSL Auto Renew Service (Free & Paid ACME)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${CERTBOT_BIN} renew --quiet
ExecStartPost=/bin/bash -c "sleep 60 && /etc/wptt/ssl/auto-reset-ssl >/dev/null 2>&1"
EOF

    cat <<'EOF' >/etc/systemd/system/wptt-certbot.timer
[Unit]
Description=WPTangToc SSL Auto Renew Timer

[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
EOF

    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now wptt-certbot.timer 2>/dev/null || true
  fi
fi
