#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Gia hạn thủ công toàn bộ chứng chỉ SSL (Let's Encrypt Free & GTS / ZeroSSL / Paid ACME EAB)

function huong_dan() {
  cat <<'EOF'
  Gia hạn chứng chỉ SSL thủ công: Tính năng này sẽ kiểm tra và yêu cầu gia hạn toàn bộ chứng chỉ SSL Let's Encrypt miễn phí cũng như chứng chỉ Google Trust Services (GTS), ZeroSSL, Sectigo, DigiCert... (ACME EAB) trên máy chủ.

  Ghi chú: Mặc định WPTangToc OLS đã có cơ chế tự động gia hạn ngầm vĩnh viễn qua Cron / Systemd Timer.
  Nếu vì lý do sự cố mạng tạm thời, tường lửa chặn IP quốc tế hoặc lỗi DNS vừa mới khắc phục xong, bạn có thể sử dụng tính năng này để chủ động kích hoạt gia hạn và kiểm tra báo cáo chi tiết ngay lập tức.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8 2>/dev/null || true
umask 022

# ==============================================================================
# MODULE BẢO VỆ TƯỜNG LỬA & DỌN DẸP TỰ ĐỘNG (FAIL-SAFE TRAP CLEANUP)
# ==============================================================================
csf_was_disabled=0
nft_was_stopped=0
log_certbot_install=""

_restore_firewall_and_cleanup() {
  if ((csf_was_disabled == 1)); then
    csf -e >/dev/null 2>&1 || true
    csf_was_disabled=0
  fi
  if ((nft_was_stopped == 1)); then
    systemctl start nftables >/dev/null 2>&1 || true
    nft_was_stopped=0
  fi
  if [[ -n "${log_certbot_install:-}" && -f "$log_certbot_install" ]]; then
    /bin/rm -f -- "$log_certbot_install" 2>/dev/null || true
  fi
}

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -t 0 ]]; then stty echo 2>/dev/null || true; fi
  _restore_firewall_and_cleanup
  if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    exit "$rc"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
fi

# ==============================================================================
# KHỞI TẠO MÔI TRƯỜNG & THƯ VIỆN
# ==============================================================================
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && wptt_load_main_conf 2>/dev/null || true
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null || true
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null || true

route_arg="${1:-}"

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl:-Quản lý SSL} ➜ Gia hạn thủ công chứng chỉ SSL (Let's Encrypt & Paid ACME)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if declare -F wptt_check_lsws >/dev/null 2>&1; then
  wptt_check_lsws "$route_arg"
fi

# ==============================================================================
# HÀM NHẬN DIỆN TÊN HÃNG CA TỰ ĐỘNG TỪ CẤU HÌNH RENEWAL (0-SUBSHELL)
# ==============================================================================
_detect_ca_provider_name() {
  local raw_lineage="$1"
  local renewal_conf="/etc/letsencrypt/renewal/${raw_lineage}.conf"
  local line="" server_url=""

  if [[ -f "$renewal_conf" ]]; then
    while IFS= read -r line; do
      if [[ "$line" == server[[:space:]]*=* ]]; then
        server_url="${line#*=}"
        server_url="${server_url//[[:space:]]/}"
        break
      fi
    done <"$renewal_conf"
  fi

  case "${server_url,,}" in
  *pki.goog* | *google*)
    printf 'Google Trust Services (GTS)'
    ;;
  *zerossl.com*)
    printf 'ZeroSSL'
    ;;
  *sectigo.com* | *comodo*)
    printf 'Sectigo Commercial'
    ;;
  *digicert.com*)
    printf 'DigiCert Commercial'
    ;;
  *ssl.com*)
    printf 'SSL.com Commercial'
    ;;
  *buypass.com*)
    printf 'Buypass Go SSL'
    ;;
  *letsencrypt.org*)
    printf "Let's Encrypt Free"
    ;;
  *)
    # Fallback: Nếu file renewal chưa ghi server, đọc nhanh Issuer từ cert.pem bằng openssl
    local cert_p="/etc/letsencrypt/live/${raw_lineage}/cert.pem"
    if [[ -f "$cert_p" ]] && command -v openssl >/dev/null 2>&1; then
      local issuer_str
      issuer_str="$(openssl x509 -in "$cert_p" -noout -issuer 2>/dev/null || true)"
      case "${issuer_str,,}" in
      *"google trust"* | *gts*)
        printf 'Google Trust Services (GTS)'
        return 0
        ;;
      *zerossl*)
        printf 'ZeroSSL'
        return 0
        ;;
      *sectigo* | *comodo*)
        printf 'Sectigo Commercial'
        return 0
        ;;
      *digicert*)
        printf 'DigiCert Commercial'
        return 0
        ;;
      *"let's encrypt"*)
        printf "Let's Encrypt Free"
        return 0
        ;;
      esac
    fi

    if [[ "$raw_lineage" == *-paid ]]; then
      printf 'Paid / Custom ACME EAB'
    else
      printf "Let's Encrypt Free"
    fi
    ;;
  esac
}

_format_cert_lineage_label() {
  local raw_name="$1"
  local clean_dom="${raw_name%-paid}"
  local ca_label
  ca_label="$(_detect_ca_provider_name "$raw_name")"
  printf '%s [%s]' "$clean_dom" "$ca_label"
}

# ==============================================================================
# 1. QUÉT HỆ THỐNG KIỂM TRA SỐ LƯỢNG CHỨNG CHỈ ACME (0-SUBSHELL)
# ==============================================================================
free_ssl_count=0
paid_acme_count=0
paid_domains=()
declare -A paid_ca_stats=()

shopt -s nullglob
for filepath in /etc/wptt/vhost/.*.conf /etc/wptt/chuyen-huong/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

  domain="${filepath##*/}"
  domain="${domain%.conf}"
  domain="${domain#.}"

  if [[ "$domain" == ?*.?* && "$domain" != *..* ]]; then
    if [[ -f "/etc/letsencrypt/live/$domain/cert.pem" ]]; then
      ((free_ssl_count++))
    fi
    if [[ -f "/etc/letsencrypt/live/${domain}-paid/cert.pem" ]]; then
      ((paid_acme_count++))
      paid_domains+=("$domain")
      ca_name="$(_detect_ca_provider_name "${domain}-paid")"
      paid_ca_stats["$ca_name"]=$((${paid_ca_stats["$ca_name"]:-0} + 1))
    fi
  fi
done
shopt -u nullglob

total_ssl_count=$((free_ssl_count + paid_acme_count))

if ((total_ssl_count == 0)); then
  echo -e "${C_RED}❌ Hệ thống hiện chưa có tên miền nào cài đặt SSL Let's Encrypt hoặc Paid / Custom ACME.${C_RESET}"
  sleep 2.5
  wptt_quay_ve_menu "$route_arg" 1
fi

# Thiết lập cron/timer gia hạn tự động SSL lũy đẳng (Idempotent)
if [[ -f /etc/wptt/ssl/gia-han-tu-dong-ssl-let-encrypt ]]; then
  /bin/bash /etc/wptt/ssl/gia-han-tu-dong-ssl-let-encrypt >/dev/null 2>&1 || true
fi

# ==============================================================================
# 2. XÁC NHẬN VÀ THỰC THI GIA HẠN
# ==============================================================================
summary_line="Phát hiện: ${C_GREEN}${free_ssl_count} SSL Let's Encrypt Free${C_RESET}"
if ((paid_acme_count > 0)); then
  paid_breakdown=""
  for ca_key in "${!paid_ca_stats[@]}"; do
    [[ -n "$paid_breakdown" ]] && paid_breakdown+=", "
    paid_breakdown+="${paid_ca_stats[$ca_key]} ${ca_key}"
  done
  summary_line="${summary_line} + ${C_CYAN}${paid_breakdown}${C_RESET}"
fi

if wptt_xac_nhan "Bạn muốn chạy kiểm tra & gia hạn chứng chỉ SSL trên toàn máy chủ?" \
  "$summary_line" \
  "Mặc định WPTangToc OLS đã có tiến trình gia hạn tự động." \
  "Đồng ý (Gia hạn ngay)" "Không đồng ý (Hủy thao tác)"; then

  echo ""
  # --- MODULE AUTO-HEAL: KIỂM TRA & CÀI ĐẶT CERTBOT NẾU BỊ MẤT ---
  if ! command -v certbot >/dev/null 2>&1; then
    UI_HEAL="Hệ thống phát hiện thiếu Certbot, đang tiến hành tự động cài đặt"
    _runing "$UI_HEAL"

    /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
    log_certbot_install="$(mktemp -p "/etc/wptt/tmp" wptt_certbot_install_XXXXXX.log)"
    install_success=0
    max_attempts=3
    attempt=1

    while ((attempt <= max_attempts)); do
      printf -- '--- Thử cài đặt lần %d ---\n' "$attempt" >>"$log_certbot_install"

      if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -y >>"$log_certbot_install" 2>&1 || true
        if apt-get install -y certbot >>"$log_certbot_install" 2>&1; then
          install_success=1
          break
        fi
      else
        dnf install -y epel-release >>"$log_certbot_install" 2>&1 || yum install -y epel-release >>"$log_certbot_install" 2>&1 || true
        if dnf install -y certbot --setopt=timeout=15 >>"$log_certbot_install" 2>&1 || yum install -y certbot >>"$log_certbot_install" 2>&1; then
          install_success=1
          break
        fi
      fi

      sleep 3
      ((attempt++))
    done

    if ! command -v certbot >/dev/null 2>&1 || ((install_success == 0)); then
      _runloi "$UI_HEAL"
      echo -e "${C_RED}Lỗi nghiêm trọng: Không thể cài đặt Certbot sau $max_attempts lần thử!${C_RESET}"
      echo -e "=> Chi tiết lỗi đã được lưu tại: ${C_YELLOW}${log_certbot_install}${C_RESET}"
      echo -e "=> Bạn hãy dùng lệnh: cat ${log_certbot_install} để xem nguyên nhân cụ thể."
      log_certbot_install=""
      wptt_quay_ve_menu "$route_arg" 1 "enter"
    else
      _rundone "$UI_HEAL"
      /bin/rm -f -- "$log_certbot_install" 2>/dev/null || true
      log_certbot_install=""
    fi
  fi

  # ============================================================================
  # KIỂM TRA XUNG ĐỘT PORT 80 TRƯỚC KHI CHẠY CERTBOT
  # ============================================================================
  conflict_process="$(ss -tlnp 2>/dev/null | grep -E '\b:80\b' | grep -oP 'users:\(\("\K[^"]+' | grep -v -iE "litespeed|openlite|lsws|lshttpd" | head -n 1 || true)"
  if [[ -z "$conflict_process" ]]; then
    conflict_process="$(netstat -tlnp 2>/dev/null | grep -E '\b:80\b' | awk '{print $7}' | cut -d'/' -f2 | grep -v -iE "litespeed|openlite|lsws|lshttpd|-" | head -n 1 || true)"
  fi

  if [[ -n "$conflict_process" ]]; then
    TASK_P80="Kiểm tra tình trạng xung đột Port 80 (HTTP)"
    _runing "$TASK_P80"
    _runloi "$TASK_P80"
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_RED}CẢNH BÁO: XUNG ĐỘT PORT 80 (HTTP) CỦA OPENLITESPEED${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    center_text "Hệ thống phát hiện dịch vụ ${C_YELLOW}[$conflict_process]${C_RESET} đang chiếm giữ Port 80."
    center_text "Giao thức ACME bắt buộc Port 80 phải thông suốt để xác thực gia hạn."
    center_text ""
    center_text "Để tiếp tục gia hạn, bạn cần tắt dịch vụ xung đột này đi bằng lệnh:"
    center_text "${C_GREEN}systemctl stop $conflict_process${C_RESET}"
    center_text "${C_GREEN}systemctl disable $conflict_process${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    wptt_quay_ve_menu "$route_arg" 1 "enter"
  fi

  # ============================================================================
  # CHUẨN BỊ MÔI TRƯỜNG GIA HẠN (MỞ KHÓA .WELL-KNOWN & TẠM MỞ TƯỜNG LỬA GEOIP)
  # ============================================================================
  UI_STRING="Gia hạn chứng chỉ SSL trên toàn hệ thống"
  _runing "$UI_STRING"
  wptt_logs "INFO" "Gia hạn thủ công chứng chỉ SSL toàn hệ thống"

  # 1. Mở khóa thư mục .well-known nếu có website đang bật tính năng Lock Down
  shopt -s nullglob
  for vconf in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$vconf" || "$vconf" == *"/..conf" ]] && continue
    vdom="${vconf##*/}"
    vdom="${vdom%.conf}"
    vdom="${vdom#.}"
    if [[ -d "/usr/local/lsws/$vdom/html/.well-known" ]] && grep -q "lock_down" "$vconf" 2>/dev/null; then
      chattr -R -i "/usr/local/lsws/$vdom/html/.well-known" >/dev/null 2>&1 || true
    fi
  done
  shopt -u nullglob

  # 2. Tạm mở tường lửa chặn IP quốc tế (Tránh chặn Bot xác thực của Let's Encrypt / GTS / ZeroSSL / Sectigo)
  if [[ -f /etc/csf/csf.conf ]]; then
    countryblicklist="$(awk -F'"' '/^CC_ALLOW_FILTER/ {print $2}' /etc/csf/csf.conf 2>/dev/null || true)"
    if [[ -n "$countryblicklist" ]]; then
      csf -x >/dev/null 2>&1 || true
      csf_was_disabled=1
    fi
  fi

  if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
    path_nftables_config="/etc/nftables.conf"
  else
    path_nftables_config="/etc/sysconfig/nftables.conf"
  fi

  if [[ -f "$path_nftables_config" ]] && grep -q 'ipvietnam' "$path_nftables_config" 2>/dev/null; then
    if systemctl is-active --quiet nftables 2>/dev/null; then
      systemctl stop nftables >/dev/null 2>&1 || true
      nft_was_stopped=1
    fi
  fi

  # ============================================================================
  # THỰC THI GIA HẠN VÀ CẮT LOG (LOG SLICING HYBRID)
  # ============================================================================
  LOG_FILE="/var/log/letsencrypt/letsencrypt.log"
  LINE_START=0
  [[ -f "$LOG_FILE" ]] && LINE_START=$(wc -l <"$LOG_FILE" 2>/dev/null || echo 0)

  certbot_bin="$(command -v certbot 2>/dev/null || echo "/usr/bin/certbot")"
  certbot_cli_output="$("$certbot_bin" renew 2>&1 || true)"

  LINE_END=0
  [[ -f "$LOG_FILE" ]] && LINE_END=$(wc -l <"$LOG_FILE" 2>/dev/null || echo 0)
  LINES_NEW=$((LINE_END - LINE_START))
  ((LINES_NEW <= 0)) && LINES_NEW=150

  RECENT_LOG="$(tail -n "$LINES_NEW" "$LOG_FILE" 2>/dev/null || true)"

  # ============================================================================
  # ĐỒNG BỘ CHỨNG CHỈ ${DOMAIN}-PAID VỀ /usr/local/lsws/${DOMAIN}/ssl (CHỈ KHI MỚI HƠN)
  # ============================================================================
  for pdom in "${paid_domains[@]+"${paid_domains[@]}"}"; do
    [[ -z "$pdom" ]] && continue
    live_pdir="/etc/letsencrypt/live/${pdom}-paid"
    target_sdir="/usr/local/lsws/${pdom}/ssl"
    vconf_p="/usr/local/lsws/conf/vhosts/${pdom}/${pdom}.conf"

    if [[ -d "$live_pdir" && -d "$target_sdir" ]] && grep -q "$target_sdir" "$vconf_p" 2>/dev/null; then
      if [[ ! -f "${target_sdir}/cert.crt" || "${live_pdir}/cert.pem" -nt "${target_sdir}/cert.crt" ]]; then
        old_umask=$(umask)
        umask 077
        [[ -f "${live_pdir}/privkey.pem" ]] && /bin/cp -fL -- "${live_pdir}/privkey.pem" "${target_sdir}/${pdom}.key"
        [[ -f "${live_pdir}/cert.pem" ]] && /bin/cp -fL -- "${live_pdir}/cert.pem" "${target_sdir}/cert.crt"
        [[ -f "${live_pdir}/chain.pem" ]] && /bin/cp -fL -- "${live_pdir}/chain.pem" "${target_sdir}/ca_bundle.crt"
        [[ -f "${live_pdir}/fullchain.pem" ]] && /bin/cp -fL -- "${live_pdir}/fullchain.pem" "${target_sdir}/fullchain.pem"
        umask "$old_umask"
        /bin/chmod 600 -- "${target_sdir}/${pdom}.key" 2>/dev/null || true
        /bin/chmod 644 -- "${target_sdir}/cert.crt" "${target_sdir}/ca_bundle.crt" "${target_sdir}/fullchain.pem" 2>/dev/null || true
      fi
    fi
  done

  # ============================================================================
  # ĐÓNG LẠI TƯỜNG LỬA & NẠP LẠI OPENLITESPEED
  # ============================================================================
  _restore_firewall_and_cleanup
  declare -F wptt_smart_reload_lsws >/dev/null 2>&1 && wptt_smart_reload_lsws >/dev/null 2>&1

  _rundone "$UI_STRING"

  # ============================================================================
  # HIỂN THỊ BÁO CÁO UX CHI TIẾT
  # ============================================================================
  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}BÁO CÁO GIA HẠN CHỨNG CHỈ SSL (CERTBOT ACME)${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

  # 1. Lọc danh sách gia hạn THÀNH CÔNG
  if grep -qiE "Congratulations|succeeded|\(success\)" <<<"$certbot_cli_output"; then
    echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    left_text "${C_BOLD_WHITE}GIA HẠN THÀNH CÔNG:${C_RESET}" 2
    while IFS= read -r domain_success; do
      [[ -z "$domain_success" ]] && continue
      label_str="$(_format_cert_lineage_label "$domain_success")"
      left_text "${C_GREEN}✓${C_RESET} $label_str" 4
    done < <(awk '
      /The following certificates were successfully renewed:/ { in_sec=1; next }
      /^[^ \t-]/ && in_sec { in_sec=0 }
      (in_sec && /\/live\//) || (/\/live\// && /\(success\)/) {
        if (match($0, /\/live\/[^\/]+\//)) {
          s = substr($0, RSTART + 6, RLENGTH - 7)
          print s
        }
      }
    ' <<<"$certbot_cli_output" | sort -u)
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  fi

  # 2. Lọc danh sách BỎ QUA (Chưa tới hạn < 30 ngày)
  if grep -qE "not yet due for renewal|\(skipped\)" <<<"$certbot_cli_output"; then
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    left_text "${C_BOLD_WHITE}ĐANG CÒN HẠN DÀI (TỰ ĐỘNG BỎ QUA):${C_RESET}" 2
    while IFS=$'\t' read -r domain_skip date_exp; do
      [[ -z "$domain_skip" ]] && continue
      label_str="$(_format_cert_lineage_label "$domain_skip")"
      left_text "⏸ $label_str (Hết hạn: ${C_YELLOW}${date_exp:-Còn hạn}${C_RESET})" 4
    done < <(awk '
      /\/live\// && /expires on/ {
        dom = ""; dt = ""
        if (match($0, /\/live\/[^\/]+\//)) {
          dom = substr($0, RSTART + 6, RLENGTH - 7)
        }
        if (match($0, /expires on [0-9-]+/)) {
          dt = substr($0, RSTART + 11, RLENGTH - 11)
        }
        if (dom != "") print dom "\t" dt
      }
    ' <<<"$certbot_cli_output")
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  fi

  # 3. Lọc danh sách LỖI (Sử dụng Log Slicing để bắt đúng nguyên nhân)
  if grep -qiE "failed|error|\(failure\)" <<<"$certbot_cli_output"; then
    echo -e "${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}GIA HẠN THẤT BẠI (CẦN KIỂM TRA QUẢN TRỊ VIÊN)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hệ thống phát hiện lỗi trên các chứng chỉ sau:" 2

    while IFS= read -r domain_fail; do
      [[ -z "$domain_fail" ]] && continue
      label_str="$(_format_cert_lineage_label "$domain_fail")"
      left_text "${C_RED}✗${C_RESET} $label_str" 4
    done < <(awk '
      /The following certificates could not be renewed:/ { in_fail=1; next }
      /^[^ \t-]/ && in_fail { in_fail=0 }
      (in_fail && /\/live\//) || (/\/live\// && /\(failure\)/) {
        if (match($0, /\/live\/[^\/]+\//)) {
          s = substr($0, RSTART + 6, RLENGTH - 7)
          print s
        }
      }
    ' <<<"$certbot_cli_output" | sort -u)

    error_details="$(grep -iE "Detail:|Challenge failed|Hint:|Timeout|unauthorized" <<<"$RECENT_LOG" | tail -n 4 || true)"
    if [[ -n "$error_details" ]]; then
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "${C_YELLOW}Nguyên nhân trích xuất từ hệ thống:${C_RESET}" 2
      while IFS= read -r err_line; do
        [[ -z "$err_line" ]] && continue
        clean_err="$(sed -E 's/^[0-9-]+ [0-9:,]+ [A-Z]+:certbot[^:]+:[[:space:]]*//g' <<<"$err_line")"
        left_text "  - $clean_err" 2
      done <<<"$error_details"
    fi

    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Log đầy đủ: ${C_YELLOW}$LOG_FILE${C_RESET}" 2
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  fi

  # 4. Chốt tóm tắt
  if grep -q "No renewals were attempted" <<<"$certbot_cli_output"; then
    echo -e "   ${C_GREEN}✔ Toàn bộ chứng chỉ SSL trên máy chủ đều đang còn hạn dài, chưa cần cấp mới.${C_RESET}\n"
  fi

  wptt_quay_ve_menu "$route_arg" 0 "enter"
fi

wptt_quay_ve_menu "$route_arg" 0
