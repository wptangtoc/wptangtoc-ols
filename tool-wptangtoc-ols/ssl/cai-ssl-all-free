#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${quan_ly_ssl} ➜ Cài đặt SSL Let's Encrypt Hàng loạt (Chưa có SSL)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

wptt_check_lsws || wptt_die "OpenLiteSpeed đang bị lỗi. Hệ thống từ chối cài đặt SSL để đảm bảo an toàn."

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

# ==============================================================================
# HÀM MENU LỌC DOMAIN BO CONG (CHỈ HIỂN THỊ WEB CHƯA CÓ SSL)
# ==============================================================================
if [[ -z "$NAME" ]]; then
  function lua_chon_NAME() {
    unset NAME selects
    selects=()
    local box_inner_width=${box_inner_width:-71}

    # Quét toàn bộ thư mục Vhost
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      # Lọc domain hợp lệ
      if [[ "$domain" == ?*.?* ]]; then
        # CHỈ LẤY: Domain ĐÃ CÓ MÃ NGUỒN nhưng CHƯA CÓ SSL
        if [[ -d "/usr/local/lsws/$domain/html" ]]; then
          if [[ ! -f "/etc/letsencrypt/live/$domain/cert.pem" && ! -d "/usr/local/lsws/$domain/ssl" ]]; then
            selects+=("$domain")
          fi
        fi
      fi
    done

    # Báo cáo nếu tất cả website đều đã có SSL
    if [[ ${#selects[@]} -eq 0 ]]; then
      echo -e "${C_GREEN}✔ Tuyệt vời! Tất cả các website trên máy chủ đều đã được bảo vệ bởi SSL.${C_RESET}"
      sleep 3
      exec /etc/wptt/wptt-ssl-main 1
    fi

    # Thêm tùy chọn "Tất cả website" nếu có từ 2 website trở lên chưa cài SSL
    if [[ ${#selects[@]} -gt 1 ]]; then
      selects+=("Tất cả website")
    fi

    # Sắp xếp mảng (Nhét 'Tất cả website' xuống cuối cùng)
    mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)
    # Lấy phần tử "Tất cả website" và đẩy xuống cuối nếu nó bị sort trồi lên
    for i in "${!selects[@]}"; do
        if [[ "${selects[$i]}" == "Tất cả website" ]]; then
            unset 'selects[i]'
            selects+=("Tất cả website")
            break
        fi
    done

    # Render Giao diện (UX/UI Đồng bộ)
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    local title_text="Lựa chọn Website (Chưa có SSL) bạn muốn cài đặt:"
    local len=$(echo -n "$title_text" | awk '{print length($0)}')
    local pad_r=$((box_inner_width - len - 2))
    [[ $pad_r -lt 0 ]] && pad_r=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    local pad_line_r=$((box_inner_width - line_len))
    [[ $pad_line_r -lt 0 ]] && pad_line_r=0
    local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
    echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

    local i=1
    local total_items=${#selects[@]}

    for (( idx=0; idx<total_items; idx++ )); do
      local dom="${selects[$idx]}"
      
      if [[ "$dom" == "Tất cả website" ]]; then
        if [[ $idx -gt 0 ]]; then
            echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        fi
        local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_YELLOW}%s${C_RESET}" "$i" "$dom")
        local clean_text=$(printf "  %3d) %s" "$i" "$dom")
        local item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
        local pad=$((box_inner_width - item_len))
        [[ $pad -lt 0 ]] && pad=0
        echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
      else
        local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%-25s${C_RESET} ${C_RED}[Chưa cấu hình HTTPS]${C_RESET}" "$i" "$dom")
        local clean_text=$(printf "  %3d) %-25s [Chưa cấu hình HTTPS]" "$i" "$dom")
        local item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
        local pad=$((box_inner_width - item_len))
        [[ $pad -lt 0 ]] && pad=0
        echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
      fi
      ((i++))
    done
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    local fzf_installed=false
    if command -v fzf &>/dev/null; then
      fzf_installed=true
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
    else
      PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
    fi

    while true; do
      echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
      if ! read -r REPLY; then exit 1; fi
      REPLY="${REPLY// /}"
      REPLY="${REPLY,,}"

      case "$REPLY" in
      0)
        echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
        NAME="0"
        return 0
        ;;
      00)
        if $fzf_installed; then
          local selected_item=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website >> " --height=40% --border=rounded --color=border:cyan --cycle --reverse)
          local dom=$(echo "$selected_item" | sed 's/^[[:space:]]*[0-9]\+\:[[:space:]]*//' | awk '{print $1}')
          if [[ -n "$dom" ]]; then
            NAME="$dom"
            return 0
          else echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"; fi
        else
          echo -e "${C_RED}Lỗi: FZF chưa cài đặt.${C_RESET}"
        fi
        ;;
      *)
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
          local action_index=$((REPLY - 1))
          NAME="${selects[$action_index]}"
          return 0
        else
          echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
        ;;
      esac
    done
  }
  lua_chon_NAME
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
  return 2>/dev/null || exit
}

# ==============================================================================
# XỬ LÝ KỊCH BẢN "TẤT CẢ WEBSITE" (VÒNG LẶP HÀNG LOẠT)
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  echo -e "\n${C_CYAN}➜ Khởi động tiến trình Cài đặt SSL hàng loạt cho các tên miền chưa có HTTPS...${C_RESET}\n"
  
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    local domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi

    # Chỉ cài SSL cho những domain hợp lệ chưa có chứng chỉ Let's Encrypt
    if [[ -d "/usr/local/lsws/$domain/html" ]]; then
      if [[ ! -f "/etc/letsencrypt/live/$domain/cert.pem" && ! -d "/usr/local/lsws/$domain/ssl" ]]; then
        echo -e "${C_YELLOW}------------------------------------------------------------------------------${C_RESET}"
        echo -e "${C_GREEN}Đang tiến hành cấp phát chứng chỉ cho:${C_RESET} ${C_BOLD_WHITE}$domain${C_RESET}"
        
        # GỌI TRỰC TIẾP MODULE CÀI SSL CHUẨN CỦA HỆ THỐNG
        # Chạy trong môi trường subshell (bash) để cách ly biến, tránh xung đột chéo
        bash /etc/wptt/ssl/wptt-caissl "$domain" "skip_menu"
      fi
    fi
  done
  
  echo -e "\n${C_GREEN}✔ Tiến trình cài đặt SSL hàng loạt đã hoàn tất.${C_RESET}"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
  exit 0
fi

# ==============================================================================
# XỬ LÝ KỊCH BẢN 1 TÊN MIỀN CỤ THỂ
# ==============================================================================
path="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$path" ]]; then
  echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 3
  exec /etc/wptt/wptt-ssl-main 1
  exit
fi

# Kiểm tra xem có bị trùng thao tác không
if [[ -f "/etc/letsencrypt/live/$NAME/cert.pem" || -d "/usr/local/lsws/$NAME/ssl" ]]; then
  echo -e "\n${C_YELLOW}⚠️ Website $NAME đã kích hoạt SSL từ trước rồi!${C_RESET}"
  
  # Dọn dẹp Cronjob cũ kỹ tự động cài SSL nếu có
  if [[ -f "/etc/cron.d/cai-ssl-auto-$NAME-tu-dong.cron" ]]; then
    rm -f "/etc/cron.d/cai-ssl-auto-$NAME-tu-dong.cron"
    if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
      NAME_CRON_ubuntu=${NAME//[.]/_}
      rm -f "/etc/cron.d/cai-ssl-auto-${NAME_CRON_ubuntu}-tu-dong_cron" 2>/dev/null
      systemctl restart cron.service
    else
      systemctl restart crond.service
    fi
  fi
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
  return 2>/dev/null || exit
fi

# Gọi module wptt-caissl với cờ skip_menu để cài đặt trực tiếp
echo -e "\n${C_CYAN}➜ Chuyển hướng tiến trình sang Module cài đặt SSL gốc...${C_RESET}"
bash /etc/wptt/ssl/wptt-caissl "$NAME" "skip_menu"

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-ssl-main 1
