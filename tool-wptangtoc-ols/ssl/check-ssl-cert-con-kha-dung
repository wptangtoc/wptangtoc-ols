#Thoát sớm (Fail-Fast): Không có domain $\rightarrow$ return 1 ngay. Cả 2 nước cờ trên đều tạch $\rightarrow$ return 1 dứt khoát.

# Tư duy thiết kế theo mô hình Fast-Path trong kiến trúc hệ thống:Fast-Path (0ms - 95% trường hợp): Khách có SSL CA thật (Let's Encrypt hoặc Paid SSL) thì kiểm tra file và thẩm định hạn dùng qua OpenSSL chỉ mất vài phần nghìn giây (0.001s) $\rightarrow$ return 0 ngay lập tức, không tốn dù chỉ 1 byte băng thông mạng, trải nghiệm CLI mượt mà như bơ.Nước cờ vét cuối cùng (Fallback): Chỉ khi Local SSL không có hoặc đã hết hạn, hệ thống mới kích hoạt cú thăm dò Cloudflare qua mạng với timeout siết chặt tối đa 1.5s.

check_local_ssl_validity() {
  local domain="${1:-}"

  # 1. Chốt chặn sớm: Không có domain thì hủy ngay lập tức
  [[ -z "$domain" ]] && return 1

  # ============================================================================
  # NHÁNH 1 (FAST-PATH): LOCAL SSL CÓ CA THẬT (0ms - MƯỢT NHẤT CÓ THỂ)
  # ============================================================================
  local vhost_conf="/usr/local/lsws/conf/vhosts/${domain}/${domain}.conf"
  local cert_path=""

  # Chỉ trích xuất certFile nếu là Let's Encrypt hoặc Paid SSL (bỏ qua SSL tự ký)
  if [[ -f "$vhost_conf" ]]; then
    if grep -E '^[[:space:]]*certFile[[:space:]]+.*letsencrypt' "$vhost_conf" >/dev/null 2>&1; then
      cert_path="/etc/letsencrypt/live/${domain}/cert.pem"
    elif grep -E '^[[:space:]]*certFile[[:space:]]+.*/usr/local/lsws/'"${domain}"'/ssl/' "$vhost_conf" >/dev/null 2>&1; then
      cert_path="/usr/local/lsws/${domain}/ssl/cert.crt"
    fi
  fi

  # Nếu tìm thấy cert local xịn VÀ CÒN HẠN -> RETURN 0 NGAY LẬP TỨC!
  if [[ -n "$cert_path" && -f "$cert_path" ]]; then
    if openssl x509 -in "$cert_path" -noout -checkend 0 >/dev/null 2>&1; then
      return 0
    fi
  fi

  # ============================================================================
  # NHÁNH 2 (NƯỚC CỜ VÉT CUỐI CÙNG): CLOUDFLARE CDN PROXY (TIMEOUT 1.5 GIÂY)
  # Chỉ kích hoạt khi Local không có cert hoặc cert local đã chết
  # ============================================================================
  local trace_res
  trace_res=$(curl -s -I --connect-timeout 1 --max-time 2 "https://${domain}/cdn-cgi/trace" 2>/dev/null)

  # Nếu curl bắt tay SSL thành công và có header Cloudflare
  if grep -Eqi 'cloudflare|cf-ray' <<< "$trace_res"; then
    return 0
  fi

  # ============================================================================
  # MỌI PHAO CỨU SINH ĐỀU THẤT BẠI -> RETURN 1 DỨT KHOÁT
  # ============================================================================
  return 1
}

# ==============================================================================
# ĐIỀU PHỐI THOÁT CHUẨN UNIX (HỖ TRỢ CẢ LỆNH IF LẪN BIẾN TOÀN CỤC)
# ==============================================================================
if check_local_ssl_validity "$1"; then
  exit 0
else
  exit 1
fi
