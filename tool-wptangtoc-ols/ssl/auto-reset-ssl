#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Thư viện Cron kiểm tra chứng chỉ SSL mới (Let's Encrypt & Paid ACME) và Reload OLS Zero-Downtime

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# Chốt chặn an toàn: Nếu mốc /usr/local/lsws/cgid chưa tồn tại (OLS chưa chạy), thoát sớm
[[ -e /usr/local/lsws/cgid ]] || exit 0

need_reload=0
reload_log_msg=""

# ==============================================================================
# 1. KIỂM TRA & ĐỒNG BỘ SSL TRẢ PHÍ TỰ ĐỘNG (/etc/letsencrypt/live/*-paid)
# ==============================================================================
# Chỉ quét khi tính năng SSL trả phí ACME EAB đã được kích hoạt trên hệ thống
if [[ -f /etc/wptt/ssl/wptt-paid-ssl-deploy-hook.sh && -d /etc/letsencrypt/live ]]; then
  shopt -s nullglob
  for paid_live_dir in /etc/letsencrypt/live/*-paid; do
    [[ -d "$paid_live_dir" ]] || continue

    cert_folder_name="${paid_live_dir##*/}"
    domain_name="${cert_folder_name%-paid}"
    target_ssl_dir="/usr/local/lsws/${domain_name}/ssl"
    vhost_conf="/usr/local/lsws/conf/vhosts/${domain_name}/${domain_name}.conf"

    # Bỏ qua nếu thư mục vhost của domain không còn tồn tại hoặc thiếu file cert.pem nguồn
    if [[ ! -d "/usr/local/lsws/${domain_name}" || ! -f "${paid_live_dir}/cert.pem" ]]; then
      continue
    fi

    # Chốt chặn tương thích: Nếu Vhost đã chuyển về dùng Let's Encrypt Free thì bỏ qua
    if [[ -f "$vhost_conf" ]] && ! grep -q "$target_ssl_dir" "$vhost_conf" 2>/dev/null; then
      continue
    fi

    # Đồng bộ khi:
    # 1. File đích cert.crt chưa tồn tại, HOẶC
    # 2. Chứng chỉ nguồn (cert.pem qua symlink) mới hơn file đích (cert.crt), HOẶC
    # 3. Chứng chỉ nguồn vừa được cấp mới sau mốc khởi chạy OLS (/usr/local/lsws/cgid) nhưng chưa reload
    sync_this_domain=0
    if [[ ! -s "${target_ssl_dir}/cert.crt" ]] || [[ "${paid_live_dir}/cert.pem" -nt "${target_ssl_dir}/cert.crt" ]]; then
      sync_this_domain=1
    elif [[ -n $(find -L "$paid_live_dir" -maxdepth 1 -type f -name "*.pem" -mmin -1640 -newer /usr/local/lsws/cgid -print -quit 2>/dev/null) ]]; then
      # Kiểm tra thêm nội dung cert.pem và cert.crt có khác nhau không để tránh reload lặp
      if ! cmp -s "${paid_live_dir}/cert.pem" "${target_ssl_dir}/cert.crt" 2>/dev/null; then
        sync_this_domain=1
      fi
    fi

    if ((sync_this_domain == 1)); then
      /bin/mkdir -p -- "$target_ssl_dir"
      /bin/chmod 700 -- "$target_ssl_dir" 2>/dev/null || true

      old_umask=$(umask)
      umask 077
      # Dùng -fL (không dùng -p) để cập nhật mtime mới nhất cho cert.crt, chống lặp ở lần Cron sau, để sau này đổi chiếu: nếu archive lớn file lớn hơn trong đường dẫn ssl thì thực thi, nếu ngược lại file mtime trong thư mục: /usr/local/lsws/$NAME/ssl/cert.crt mà lớn thì archive thì không cần phải thực thi bypas bỏ qua, không dùng -p để đối chiếu mtime
      [[ -f "${paid_live_dir}/privkey.pem" ]] && /bin/cp -fL -- "${paid_live_dir}/privkey.pem" "${target_ssl_dir}/${domain_name}.key" 2>/dev/null || true
      [[ -f "${paid_live_dir}/cert.pem" ]] && /bin/cp -fL -- "${paid_live_dir}/cert.pem" "${target_ssl_dir}/cert.crt" 2>/dev/null || true
      [[ -f "${paid_live_dir}/chain.pem" ]] && /bin/cp -fL -- "${paid_live_dir}/chain.pem" "${target_ssl_dir}/ca_bundle.crt" 2>/dev/null || true
      [[ -f "${paid_live_dir}/fullchain.pem" ]] && /bin/cp -fL -- "${paid_live_dir}/fullchain.pem" "${target_ssl_dir}/fullchain.pem" 2>/dev/null || true
      umask "$old_umask"

      /bin/chmod 600 -- "${target_ssl_dir}/${domain_name}.key" 2>/dev/null || true
      /bin/chmod 644 -- "${target_ssl_dir}/cert.crt" "${target_ssl_dir}/ca_bundle.crt" "${target_ssl_dir}/fullchain.pem" 2>/dev/null || true

      need_reload=1
      reload_log_msg="Gia hạn tự động SSL trả phí / ZeroSSL / GTS ($domain_name)"
    fi
  done
  shopt -u nullglob
fi

# ==============================================================================
# 2. KIỂM TRA SSL LET'S ENCRYPT MIỄN PHÍ (/etc/letsencrypt/archive)
# ==============================================================================
# Tối ưu I/O: Chỉ chạy lệnh find này nếu Bước 1 chưa bật cờ need_reload
if ((need_reload == 0)) && [[ -d /etc/letsencrypt/archive ]]; then
  if [[ -n $(find /etc/letsencrypt/archive -type f -name "*.pem" -mmin -1640 -newer /usr/local/lsws/cgid -print -quit 2>/dev/null) ]]; then
    need_reload=1
    reload_log_msg="Gia hạn tự động SSL Let's Encrypt"
  fi
fi

# ==============================================================================
# 3. DỒN VỀ CUỐI: RELOAD OPENLITESPEED ĐÚNG 1 LẦN DUY NHẤT (ZERO-DOWNTIME)
# ==============================================================================
if ((need_reload == 1)); then
  # shellcheck source=/dev/null
  [[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null || true
  if declare -F wptt_logs >/dev/null 2>&1; then
    wptt_logs "INFO" "$reload_log_msg"
  fi
  if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
    wptt_smart_reload_lsws >/dev/null 2>&1 || true
  else
    /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1 || true
  fi
fi
