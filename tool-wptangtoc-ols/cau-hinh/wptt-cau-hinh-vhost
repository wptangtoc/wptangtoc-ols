#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Chỉnh sửa cấu hình Virtual Host (Vhost) Website

function huong_dan() {
  cat <<'EOF'
  Tính năng Sửa cấu hình OpenLiteSpeed vhost website là việc thiết lập hoặc điều chỉnh các cài đặt cho một Virtual Host [viết tắt là vhost] cụ thể trên máy chủ OpenLiteSpeed. Mỗi vhost đại diện cho một website [một tên miền hoặc tên miền phụ] riêng biệt mà bạn muốn máy chủ phục vụ.

  Nói một cách đơn giản, nếu OpenLiteSpeed là một chung cư lớn, thì mỗi căn hộ [website] trong đó sẽ có một bảng nội quy [cấu hình vhost] riêng. Sửa cấu hình vhost chính là việc bạn tùy chỉnh bảng nội quy cho từng căn hộ đó.

  Mục Đích Chính [Các Cài Đặt Quan Trọng Trong Vhost]
  * Định nghĩa Thư mục gốc [Document Root]: Chỉ định thư mục trên máy chủ chứa toàn bộ mã nguồn và tệp tin của website đó.
  * Liên kết Tên miền [Domain Name]: Gán một hoặc nhiều tên miền [ví dụ: yourdomain.com, www.yourdomain.com] với cấu hình vhost này.
  * Cấu hình PHP [qua LSAPI]: Thiết lập cách PHP được xử lý cho website này, ví dụ: chọn phiên bản PHP, các biến môi trường, giới hạn tài nguyên PHP riêng.
  * Thiết lập SSL/TLS [HTTPS]: Gán chứng chỉ SSL [certificate, private key, chain] để kích hoạt kết nối HTTPS an toàn cho tên miền.
  * Quy tắc Viết lại URL [Rewrite Rules]: Tạo các quy tắc chuyển hướng URL, URL thân thiện SEO, bắt buộc HTTPS, v.v., áp dụng riêng cho website này [tương thích với mod_rewrite của Apache].
  * Kiểm soát Truy cập: Thiết lập các quy tắc chặn/cho phép truy cập dựa trên địa chỉ IP.
  * Cấu hình Log: Chỉ định vị trí lưu file log truy cập và log lỗi riêng cho website.
  * Cài đặt LiteSpeed Cache [LSCache]: Bật và tùy chỉnh chính sách cache cho website này.

  Mỗi website trên máy chủ OpenLiteSpeed sẽ có một bộ cấu hình riêng, cho phép nó hoạt động đúng với các tệp tin, chứng chỉ SSL, quy tắc viết lại URL và cài đặt PHP của riêng mình, tất cả đều được phục vụ bởi cùng một tiến trình OpenLiteSpeed.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true
umask 022

# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

route_menu="${1:-}"
vhost_conf=""
tmp_edit=""
backup_orig=""
need_rollback=0

# ==============================================================================
# BẪY DỌN DẸP & TỰ ĐỘNG ROLLBACK NẾU BỊ NGẮT GIỮA CHỪNG (CTRL+C / ĐỨT SSH)
# ==============================================================================
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP

  if ((need_rollback == 1)) && [[ -n "${vhost_conf:-}" && -n "${backup_orig:-}" && -f "$backup_orig" ]]; then
    local rb_tmp=""
    rb_tmp="$(wptt_atomic_begin "$vhost_conf" 2>/dev/null || true)"
    if [[ -n "$rb_tmp" && -f "$rb_tmp" ]]; then
      /bin/cp -f -- "$backup_orig" "$rb_tmp" 2>/dev/null || true
      wptt_atomic_commit "$rb_tmp" "$vhost_conf" 2>/dev/null || true
    fi
  fi

  [[ -n "${tmp_edit:-}" && -f "$tmp_edit" ]] && /bin/rm -f -- "$tmp_edit" 2>/dev/null || true
  [[ -n "${backup_orig:-}" && -f "$backup_orig" ]] && /bin/rm -f -- "$backup_orig" 2>/dev/null || true
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# ==============================================================================
# HÀM IN DÒNG LỖI TỰ ĐỘNG BẺ DÒNG (MULTI-LINE WORD WRAP) CHUẨN KHUNG 78 KÝ TỰ
# ==============================================================================
_print_wrapped_error_box() {
  local raw_text="$1"
  local line="" clean_line="" chunk=""
  local max_w=76

  while IFS= read -r line; do
    line="${line//$'\r'/}"
    [[ -z "$line" ]] && continue

    # Bỏ qua các cảnh báo WARN mặc định vô hại của Vhost Example / UID nhỏ
    if [[ "$line" == *"smaller than minimum requirement"* || "$line" == *"vhost:Example"* ]]; then
      continue
    fi

    # Cắt bỏ phần Timestamp dài dòng ở đầu (VD: "2026-10-30 17:17:22.786631 ") để ưu tiên hiển thị lỗi
    clean_line="$line"
    if [[ "$clean_line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+[0-9:.]+[[:space:]]+(.*)$ ]]; then
      clean_line="${BASH_REMATCH[1]}"
    fi

    # Tự động bẻ dòng nếu thông báo lỗi dài hơn 74 ký tự (Không bao giờ cắt cụt bằng ...)
    local first_wrap=1
    while [[ -n "$clean_line" ]]; do
      if ((first_wrap == 1)); then
        if ((${#clean_line} <= max_w)); then
          printf "${C_RED}│${C_RESET}  ${C_BOLD_WHITE}%-74s${C_RESET}${C_RED}│${C_RESET}\n" "$clean_line"
          break
        else
          chunk="${clean_line:0:$max_w}"
          clean_line="${clean_line:$max_w}"
          printf "${C_RED}│${C_RESET}  ${C_BOLD_WHITE}%-74s${C_RESET}${C_RED}│${C_RESET}\n" "$chunk"
          first_wrap=0
        fi
      else
        local sub_w=$((max_w - 4))
        chunk="${clean_line:0:$sub_w}"
        clean_line="${clean_line:$sub_w}"
        printf "${C_RED}│${C_RESET}    ${C_YELLOW}↳ %-70s${C_RESET}${C_RED}│${C_RESET}\n" "$chunk"
      fi
    done
  done <<<"$raw_text"
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${cau_hinh_webserver:-Cấu hình Webserver} ➜ Chỉnh sửa Virtual Host (Vhost) Website${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# 1. GỌI MENU CHỌN DOMAIN LÕI & KIỂM TRA TRẠNG THÁI VHOST
# ==============================================================================
# shellcheck source=/dev/null
[[ -f /etc/wptt/tenmien ]] && . /etc/wptt/tenmien 2>/dev/null
lua_chon_NAME "cấu hình Vhost"

if [[ "${NAME:-}" == "0" || -z "${NAME:-}" ]]; then
  wptt_quay_ve_menu "$route_menu" 0
fi

vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"

if [[ -f "/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf.bkwptt" ]]; then
  echo -e "\n${C_YELLOW}⚠️ Website '$NAME' đang bị TẠM KHÓA. Không thể sửa cấu hình lúc này!${C_RESET}"
  read -r -s -n 1 -t 2.5 _ 2>/dev/null || true
  wptt_quay_ve_menu "$route_menu" 0
fi

if [[ ! -f "$vhost_conf" ]]; then
  echo -e "\n${C_RED}❌ Lỗi: File cấu hình Vhost của tên miền '$NAME' không tồn tại trên hệ thống!${C_RESET}"
  read -r -s -n 1 -t 2.5 _ 2>/dev/null || true
  wptt_quay_ve_menu "$route_menu" 1
fi

# ==============================================================================
# 2. XÁC NHẬN BẢO MẬT & HƯỚNG DẪN TRÌNH SOẠN THẢO
# ==============================================================================
echo ""
if wptt_xac_nhan "Bạn có CHẮC CHẮN muốn mở và chỉnh sửa cấu hình Vhost ($NAME) không?" \
  "CẢNH BÁO NGUY HIỂM: File cấu hình Vhost rất nhạy cảm." \
  "Chỉ một sai sót nhỏ cũng có thể làm sập Website này!" \
  "Đồng ý Chỉnh sửa" "Hủy thao tác"; then
  echo ""

  editor_cmd="${editor_cau_hinh:-nano}"
  if ! command -v "$editor_cmd" >/dev/null 2>&1; then
    if command -v nano >/dev/null 2>&1; then
      editor_cmd="nano"
    elif command -v vi >/dev/null 2>&1; then
      editor_cmd="vi"
    else
      _runloi "Tìm trình soạn thảo văn bản (nano/vi)"
      wptt_quay_ve_menu "$route_menu" 1
    fi
  fi

  if [[ "$editor_cmd" == "nano" ]]; then
    echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HƯỚNG DẪN LƯU FILE BẰNG NANO${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "1. Chỉnh sửa xong, ấn tổ hợp phím  : ${C_YELLOW}Ctrl + O${C_RESET}" 4
    left_text "2. Hệ thống hỏi tên file, ấn phím  : ${C_YELLOW}Enter${C_RESET}" 4
    left_text "3. Thoát ra ngoài Menu, ấn tổ hợp  : ${C_YELLOW}Ctrl + X${C_RESET}" 4
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "${C_YELLOW}Đang mở trình soạn thảo: $editor_cmd${C_RESET}\n"
  fi

  read -r -s -n 1 -t 1.8 _ 2>/dev/null || true

  # ============================================================================
  # 3. KHỞI TẠO BẢN SAO LƯU GỐC & FILE NHÁP ATOMIC (wptt_atomic_begin)
  # ============================================================================
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
  chmod 700 /etc/wptt/tmp 2>/dev/null || true

  backup_orig="$(mktemp -p /etc/wptt/tmp "vhost_${NAME}_orig_XXXXXX.bak")"
  /bin/cp -fp -- "$vhost_conf" "$backup_orig" || {
    _runloi "Tạo bản sao lưu an toàn cho Vhost $NAME"
    wptt_quay_ve_menu "$route_menu" 1
  }

  old_md5=""
  read -r old_md5 _ < <(md5sum "$vhost_conf" 2>/dev/null)

  tmp_edit="$(wptt_atomic_begin "$vhost_conf")" || {
    _runloi "Khởi tạo file nháp chỉnh sửa Vhost $NAME"
    wptt_quay_ve_menu "$route_menu" 1
  }

  # ============================================================================
  # 4. VÒNG LẶP CHỈNH SỬA -> ATOMIC COMMIT -> KIỂM TRA CÚ PHÁP -> ROLLBACK/RETRY
  # ============================================================================
  while true; do
    "$editor_cmd" "$tmp_edit"
    clear

    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}ĐANG KIỂM TRA SỰ THAY ĐỔI VÀ CÚ PHÁP VHOST: ${C_BOLD_WHITE}$NAME${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

    new_md5=""
    read -r new_md5 _ < <(md5sum "$tmp_edit" 2>/dev/null)

    if [[ "$old_md5" == "$new_md5" ]]; then
      if ((need_rollback == 1)); then
        rb_tmp="$(wptt_atomic_begin "$vhost_conf")"
        /bin/cp -f -- "$backup_orig" "$rb_tmp"
        wptt_atomic_commit "$rb_tmp" "$vhost_conf"
        need_rollback=0
      fi
      echo -e "${C_YELLOW}Không có sự thay đổi nào được phát hiện trong file. Bỏ qua bước nạp lại.${C_RESET}\n"
      break
    fi

    # Áp dụng nguyên tử file nháp vào vị trí chính thức để openlitespeed -t kiểm tra
    need_rollback=1
    commit_stage="$(wptt_atomic_begin "$vhost_conf")" || {
      _runloi "Chuẩn bị commit cấu hình Vhost $NAME"
      break
    }
    /bin/cp -f -- "$tmp_edit" "$commit_stage"
    wptt_atomic_commit "$commit_stage" "$vhost_conf"

    task_syntax="Phân tích cú pháp cấu hình Vhost $NAME (Syntax Check)"
    _runing "$task_syntax"
    syntax_rc=0
    syntax_check="$(/usr/local/lsws/bin/openlitespeed -t 2>&1)" || syntax_rc=$?

    # Lọc bỏ các dòng WARN mặc định vô hại của hệ thống trước khi đánh giá lỗi
    filtered_syntax="$(grep -vE 'smaller than minimum requirement|vhost:Example' <<<"$syntax_check" || true)"

    if ((syntax_rc != 0)) || grep -qiE '\[ERROR\]|FATAL|invalid value|syntax error|failed to' <<<"$filtered_syntax"; then
      _runloi "$task_syntax"
      wptt_logs "ERROR" "Chỉnh sửa Vhost website $NAME bị lỗi cú pháp OpenLiteSpeed"

      echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}PHÁT HIỆN LỖI CÚ PHÁP TRONG VHOST VỪA SỬA ($NAME)${C_RESET}" "$C_RED"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "${C_YELLOW}Hệ thống đã CHẶN LỆNH RELOAD để bảo vệ Website khỏi bị sập!${C_RESET}" 2 "$C_RED"
      left_text "Chi tiết mã lỗi từ OpenLiteSpeed:" 2 "$C_RED"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      _print_wrapped_error_box "${filtered_syntax:-$syntax_check}"

      echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

      if wptt_xac_nhan "Cấu hình Vhost ($NAME) bạn vừa lưu bị lỗi cú pháp!" \
        "Bạn có muốn mở lại trình soạn thảo để sửa tiếp không?" \
        "(Nếu chọn Hủy, hệ thống sẽ tự động khôi phục lại file Vhost gốc)" \
        "Sửa lại ngay" "Hủy & Khôi phục file gốc"; then
        continue
      else
        task_rb="Khôi phục (Rollback) lại file cấu hình Vhost gốc cho $NAME"
        _runing "$task_rb"
        rb_tmp="$(wptt_atomic_begin "$vhost_conf")"
        /bin/cp -f -- "$backup_orig" "$rb_tmp"
        wptt_atomic_commit "$rb_tmp" "$vhost_conf"
        need_rollback=0
        _rundone "$task_rb"
        wptt_logs "INFO" "Đã tự động Rollback Vhost website $NAME về bản gốc an toàn"
        wptt_quay_ve_menu "$route_menu" 1
      fi
    else
      need_rollback=0
      _rundone "$task_syntax"

      # Đồng bộ ngược phiên bản PHP vào /etc/wptt/vhost/.$NAME.conf nếu người dùng sửa tay lsphpXX trong Vhost
      if [[ -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
        detected_lsphp=""
        while IFS= read -r vline; do
          if [[ "$vline" =~ /lsphp([0-9]{2})/bin/lsphp ]]; then
            detected_lsphp="${BASH_REMATCH[1]}"
            break
          fi
        done <"$vhost_conf"
        if [[ -n "$detected_lsphp" ]]; then
          detected_php_dot="${detected_lsphp:0:1}.${detected_lsphp:1:1}"
          wptt_atomic_edit_config "/etc/wptt/vhost/.$NAME.conf" "phien_ban_php_domain=$detected_php_dot" 2>/dev/null || true
        fi
      fi

      task_reload="Nạp lại cấu hình Vhost mới cho OpenLiteSpeed (Zero-Downtime)"
      _runing "$task_reload"
      wptt_smart_reload_lsws >/dev/null 2>&1
      wptt_logs "INFO" "Cấu hình lại Vhost LiteSpeed Webserver website $NAME thành công"
      _rundone "$task_reload"

      echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}CẬP NHẬT CẤU HÌNH VHOST THÀNH CÔNG${C_RESET}" "$C_GREEN"
      echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "Website thao tác : ${C_YELLOW}$NAME${C_RESET}" 2 "$C_GREEN"
      left_text "Trạng thái       : Các thay đổi đã được kiểm tra và áp dụng mượt mà." 2 "$C_GREEN"
      echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
      break
    fi
  done

else
  echo -e "${C_YELLOW}Đã hủy thao tác chỉnh sửa cấu hình Vhost.${C_RESET}\n"
fi

wptt_quay_ve_menu "$route_menu" 0
