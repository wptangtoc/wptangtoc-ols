#!/bin/bash
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026
# @description: Tự động phát hiện thay đổi phần cứng (RAM/CPU) và Auto-Tune toàn diện MariaDB, OLS, ZRAM & Kernel

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH='/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

# 1. Đọc tổng RAM hiện tại của VPS (MB) bằng Pure Bash (0-Subshell)
mem_total_kb=0
if [[ -r /proc/meminfo ]]; then
  while IFS=': ' read -r key val _; do
    if [[ "$key" == "MemTotal" && "$val" =~ ^[0-9]+$ ]]; then
      mem_total_kb="$val"
      break
    fi
  done </proc/meminfo
fi

if ((mem_total_kb > 0)); then
  TOTAL_RAM=$((mem_total_kb / 1024))
else
  TOTAL_RAM=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')
fi
[[ -z "$TOTAL_RAM" || ! "$TOTAL_RAM" =~ ^[0-9]+$ ]] && TOTAL_RAM=2048

FILE_CACHE="/etc/wptt/.ram_hien_tai"

if [[ ! -f "$FILE_CACHE" ]]; then
  echo "$TOTAL_RAM" >"$FILE_CACHE"
  return 2>/dev/null || exit 0
fi

OLD_RAM=$(awk 'NR==1{print $1}' "$FILE_CACHE" 2>/dev/null)
[[ -z "$OLD_RAM" || ! "$OLD_RAM" =~ ^[0-9]+$ ]] && OLD_RAM="$TOTAL_RAM"

# 2. Tính toán độ chênh lệch
DIFF=$((TOTAL_RAM - OLD_RAM))
((DIFF < 0)) && DIFF=$((-DIFF))

# 3. NẾU ĐỔI PHẦN CỨNG TRÊN 350MB (Bao phủ cả nâng/hạ 512MB <-> 1GB) -> KÍCH HOẠT AUTO-TUNING
if ((DIFF > 350)); then
  wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - Phát hiện đổi phần cứng: RAM từ ${OLD_RAM}MB sang ${TOTAL_RAM}MB. Đang Auto-Tune..."

  # ==========================================
  # A. TÍNH TOÁN THÔNG SỐ THEO PHẦN CỨNG
  # ==========================================
  work_cpucore=1024
  cpucore=$(nproc 2>/dev/null || echo 1)
  ((cpucore <= 0)) && cpucore=1

  max_client=$((work_cpucore * cpucore * 2))
  max_client_max=$((work_cpucore * cpucore * 3))

  rong_ram_mb=$TOTAL_RAM
  ((rong_ram_mb <= 0)) && rong_ram_mb=2048

  gioi_han_tien_trinh_bao_loi_503=$((max_client / 8))
  core_tien_lsphp_child=$((cpucore * 2))

  tong_ram_gb=$((rong_ram_mb / 1024))
  ((tong_ram_gb == 0)) && tong_ram_gb=1

  # Luôn tắt performance_schema để giải phóng RAM và giảm CPU overhead tối đa
  perf_schema_val="OFF"

  # ---------------------------------------------------------
  # PHÂN TẦNG INNODB BUFFER POOL & KẾT NỐI (ĐẶC TRỊ VPS < 2GB)
  # ---------------------------------------------------------
  if ((rong_ram_mb <= 650)); then
    # Tầng 512MB RAM: Khóa cứng chống OOM tuyệt đối
    tong_ram_mb_db=32
    buffer_db=8
    max_connections=30
    db_table_size=16
    table_cache_val=400
    thread_cache_val=16
  elif ((rong_ram_mb <= 1150)); then
    # Tầng 1GB RAM
    tong_ram_mb_db=128
    buffer_db=16
    max_connections=50
    db_table_size=32
    table_cache_val=800
    thread_cache_val=32
  elif ((rong_ram_mb <= 1850)); then
    # Tầng 1.5GB RAM
    tong_ram_mb_db=256
    buffer_db=32
    max_connections=80
    db_table_size=64
    table_cache_val=1200
    thread_cache_val=48
  else
    # Tầng >= 2GB RAM: Áp dụng công thức 40% RAM (làm tròn block 128MB)
    tong_ram_mb_db=$(((rong_ram_mb * 40 / 100 / 128) * 128))
    ((tong_ram_mb_db == 0)) && tong_ram_mb_db=512
    buffer_db=$((rong_ram_mb / 8))
    max_connections=$((64 * tong_ram_gb))
    db_table_size=$((tong_ram_gb * 64))
    table_cache_val=2000
    thread_cache_val=81
  fi

  mkdir -p /etc/wptt/tmp 2>/dev/null
  chmod 700 /etc/wptt/tmp 2>/dev/null
  TEMP_mariadb_config=$(mktemp -p "/etc/wptt/tmp" mariadb_db_config_cnf_XXXXXX.cnf 2>/dev/null || mktemp)
  TEMP_OLS_config_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX 2>/dev/null || mktemp -d)
  TEMP_SYSCTL_config=""

  # Đảm bảo không bao giờ để sót file tạm trong /etc/wptt/tmp dù thoát giữa chừng
  _wptt_autotune_cleanup() {
    rm -f "${TEMP_mariadb_config:-}" "${TEMP_SYSCTL_config:-}" 2>/dev/null || true
    rm -rf "${TEMP_OLS_config_DIR:-}" 2>/dev/null || true
  }
  trap _wptt_autotune_cleanup EXIT

  # ==========================================
  # B. CẤU HÌNH MARIADB (CHUẨN ATOMIC)
  # ==========================================
  HAS_SQLITE=0
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ -f "/usr/local/lsws/$domain/html/wp-content/db.php" ]] && grep -qi "sqlite" "/usr/local/lsws/$domain/html/wp-content/db.php"; then
      HAS_SQLITE=1
      break
    fi
  done
  shopt -u nullglob

  if [[ "$HAS_SQLITE" -eq 0 ]]; then
    if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
      duong_dan_cau_hinh_mariadb="/etc/mysql/my.cnf"
    else
      duong_dan_cau_hinh_mariadb="/etc/my.cnf.d/server.cnf"
    fi

    if [[ -f "$duong_dan_cau_hinh_mariadb" ]]; then
      cp -fp "$duong_dan_cau_hinh_mariadb" "$TEMP_mariadb_config" 2>/dev/null

      tmp_mariadb=$(wptt_atomic_begin "$duong_dan_cau_hinh_mariadb") || {
        wptt_logs "ERROR" "Không thể khởi tạo file nháp MariaDB"
      }

      if [[ -n "$tmp_mariadb" && -f "$tmp_mariadb" ]]; then
        sed -i '/^[[:blank:]]*# WPTT AUTO-TUNE MARIADB/d; /^[[:blank:]]*key_buffer_size/d; /^[[:blank:]]*innodb_buffer_pool_size/d; /^[[:blank:]]*max_connections/d; /^[[:blank:]]*tmp_table_size/d; /^[[:blank:]]*max_heap_table_size/d; /^[[:blank:]]*max_allowed_packet/d; /^[[:blank:]]*table_cache/d; /^[[:blank:]]*table_open_cache/d; /^[[:blank:]]*thread_cache_size/d; /^[[:blank:]]*performance_schema/d' "$tmp_mariadb"

        # Luôn đảm bảo các biến nằm đúng trong ngữ cảnh [mysqld]
        if ! grep -qi '^[[:blank:]]*\[mysqld\]' "$tmp_mariadb"; then
          printf "\n[mysqld]\n" >>"$tmp_mariadb"
        elif [[ "$(grep -iE '^[[:blank:]]*\[.*\]' "$tmp_mariadb" | tail -n 1 | tr -d '[:blank:]' | tr '[:upper:]' '[:lower:]')" != "[mysqld]" ]]; then
          printf "\n[mysqld]\n" >>"$tmp_mariadb"
        fi

        cat <<EOF >>"$tmp_mariadb"
# WPTT AUTO-TUNE MARIADB
performance_schema = $perf_schema_val
table_open_cache = $table_cache_val
thread_cache_size = $thread_cache_val
key_buffer_size = ${buffer_db}M
innodb_buffer_pool_size = ${tong_ram_mb_db}M
max_connections = $max_connections
tmp_table_size = ${db_table_size}M
max_heap_table_size = ${db_table_size}M
max_allowed_packet = 64M
EOF
        wptt_atomic_commit "$tmp_mariadb" "$duong_dan_cau_hinh_mariadb"
      fi
    fi
  fi

  # ---------------------------------------------------------
  # BACKUP OLS CHỌN LỌC (CHỐNG LỖI MÙ QUÁNG COPY Wildcard)
  # ---------------------------------------------------------
  cp -fp /usr/local/lsws/conf/httpd_config.conf "$TEMP_OLS_config_DIR/" 2>/dev/null
  cp -rf /usr/local/lsws/conf/vhosts "$TEMP_OLS_config_DIR/" 2>/dev/null

  # ==========================================
  # C. CẤU HÌNH OPENLITESPEED (OLS)
  # ==========================================
  OLS_CONF='/usr/local/lsws/conf/httpd_config.conf'

  tmp_httpd_OLS=$(wptt_atomic_begin "$OLS_CONF") || {
    _runloi "Không thể khởi tạo file nháp OpenLiteSpeed"
    exit 1
  }

  if ((TOTAL_RAM <= 650)); then
    BUFFER_SIZE="32M"
    MMAP_CACHE_SIZE="16M"
    KA_TIMEOUT="10"
    KA_REQS="500"
  elif ((TOTAL_RAM <= 1200)); then
    BUFFER_SIZE="60M"
    MMAP_CACHE_SIZE="20M"
    KA_TIMEOUT="15"
    KA_REQS="1000"
  elif ((TOTAL_RAM <= 2500)); then
    BUFFER_SIZE="120M"
    MMAP_CACHE_SIZE="40M"
    KA_TIMEOUT="30"
    KA_REQS="3000"
  elif ((TOTAL_RAM <= 4500)); then
    BUFFER_SIZE="180M"
    MMAP_CACHE_SIZE="80M"
    KA_TIMEOUT="45"
    KA_REQS="5000"
  else
    BUFFER_SIZE="256M"
    MMAP_CACHE_SIZE="80M"
    KA_TIMEOUT="60"
    KA_REQS="10000"
  fi

  sed -i -E "s/^[[:blank:]]*keepAliveTimeout.*/keepAliveTimeout         $KA_TIMEOUT/g" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*maxKeepAliveReq.*/maxKeepAliveReq          $KA_REQS/g" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*inMemBufSize[[:blank:]]+.*/inMemBufSize             ${BUFFER_SIZE}/" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*totalInMemCacheSize[[:blank:]]+.*/totalInMemCacheSize      ${MMAP_CACHE_SIZE}/" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*httpdWorkers.*/httpdWorkers             $cpucore/g" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*cpuAffinity.*/cpuAffinity              $cpucore/g" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*maxConnections.*/maxConnections           $max_client_max/g" "$tmp_httpd_OLS"
  sed -i -E "s/^[[:blank:]]*maxSSLConnections.*/maxSSLConnections        $max_client_max/g" "$tmp_httpd_OLS"

  sed -i -E "/extprocessor.*lsphp/,/\}/ s/^([[:blank:]]*maxConns[[:blank:]]+).*/\1$core_tien_lsphp_child/g" "$tmp_httpd_OLS"
  sed -i -E "/extprocessor.*lsphp/,/\}/ s/^([[:blank:]]*env[[:blank:]]+PHP_LSAPI_CHILDREN=).*/\1$core_tien_lsphp_child/g" "$tmp_httpd_OLS"
  wptt_atomic_commit "$tmp_httpd_OLS" "$OLS_CONF"

  # ==========================================
  # D. CẤU HÌNH VHOSTS TỪNG TÊN MIỀN
  # ==========================================
  shopt -s nullglob
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"
    VHOST_CONF="/usr/local/lsws/conf/vhosts/$domain/$domain.conf"

    if [[ -n "$domain" && "$domain" != "conf" && -f "$VHOST_CONF" ]]; then
      unset tmp_httpd_vhost_ols
      tmp_httpd_vhost_ols=$(wptt_atomic_begin "$VHOST_CONF") || {
        continue
      }

      sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*maxConns[[:blank:]]+).*/\1$core_tien_lsphp_child/" "$tmp_httpd_vhost_ols"
      if [[ -f "/usr/local/lsws/$domain/html/wp-content/db.php" ]] && grep -qi "sqlite" "/usr/local/lsws/$domain/html/wp-content/db.php"; then
        ngu_dong_core_tien_lsphp_child="2"
        sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*env[[:blank:]]+PHP_LSAPI_CHILDREN=).*/\1$ngu_dong_core_tien_lsphp_child/" "$tmp_httpd_vhost_ols"
      else
        sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*env[[:blank:]]+PHP_LSAPI_CHILDREN=).*/\1$core_tien_lsphp_child/" "$tmp_httpd_vhost_ols"
      fi
      sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*memSoftLimit[[:blank:]]+).*/\1${rong_ram_mb}M/" "$tmp_httpd_vhost_ols"
      sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*memHardLimit[[:blank:]]+).*/\1${rong_ram_mb}M/" "$tmp_httpd_vhost_ols"
      sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*procSoftLimit[[:blank:]]+).*/\1$gioi_han_tien_trinh_bao_loi_503/" "$tmp_httpd_vhost_ols"
      sed -i -E "/extprocessor/,/\}/ s/^([[:blank:]]*procHardLimit[[:blank:]]+).*/\1$gioi_han_tien_trinh_bao_loi_503/" "$tmp_httpd_vhost_ols"
      wptt_atomic_commit "$tmp_httpd_vhost_ols" "$VHOST_CONF"
    fi
  done
  shopt -u nullglob

  # ==========================================
  # E. CHẠY SCRIPT TỐI ƯU CACHE & FAIL2BAN
  # ==========================================
  [[ -x "/etc/wptt/cache/opcache-optimize-tune" ]] && /etc/wptt/cache/opcache-optimize-tune
  [[ -x "/etc/wptt/cache/object-cache-optimize-tune" ]] && /etc/wptt/cache/object-cache-optimize-tune

  # Auto-Tune Fail2Ban (Giảm 75% RAM Thread Stack & chống nghẽn Disk SQLite trên VPS nhỏ)
  if [[ -d "/etc/fail2ban" ]] && command -v fail2ban-client >/dev/null 2>&1; then
    mkdir -p /etc/systemd/system/fail2ban.service.d /etc/fail2ban/fail2ban.d
    if ((TOTAL_RAM <= 1200)); then
      F2B_MEM_HIGH="48M"
      F2B_MEM_MAX="96M"
      F2B_DBFILE=":memory:"
      F2B_MAXMATCHES="20"
    else
      F2B_MEM_HIGH="128M"
      F2B_MEM_MAX="256M"
      F2B_DBFILE="/var/lib/fail2ban/fail2ban.sqlite3"
      F2B_MAXMATCHES="50"
    fi

    cat <<EOF >/etc/systemd/system/fail2ban.service.d/wptt-autotune.conf
[Service]
LimitSTACK=512K
MemoryHigh=$F2B_MEM_HIGH
MemoryMax=$F2B_MEM_MAX
EOF

    cat <<EOF >/etc/fail2ban/fail2ban.d/wptt-autotune.local
[Definition]
dbfile = $F2B_DBFILE
dbpurgeage = 86400
dbmaxmatches = $F2B_MAXMATCHES
EOF

    systemctl daemon-reload >/dev/null 2>&1 || true
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
      systemctl restart fail2ban >/dev/null 2>&1 || true
    fi
    wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - Fail2Ban Auto-Tuned: Stack 512K, DB=${F2B_DBFILE}"
  fi

  # ==========================================
  # F. LƯU TRẠNG THÁI VÀ KHỞI ĐỘNG LẠI
  # ==========================================
  # Restart MariaDB & Kiểm tra cú pháp
  if [[ "$HAS_SQLITE" -eq 0 && -f "$duong_dan_cau_hinh_mariadb" ]]; then
    if mariadbd --help --verbose >/dev/null 2>&1; then
      systemctl restart mariadb
      rm -f "${TEMP_mariadb_config:?}" 2>/dev/null
      wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - MariaDB Auto-Tuning Thành công!"
    else
      # Rollback Atomic an toàn nếu cú pháp bị lỗi
      if [[ -f "$TEMP_mariadb_config" ]]; then
        tmp_restore_mariadb=$(wptt_atomic_begin "$duong_dan_cau_hinh_mariadb")
        if [[ -n "$tmp_restore_mariadb" ]]; then
          cp -f "$TEMP_mariadb_config" "$tmp_restore_mariadb"
          wptt_atomic_commit "$tmp_restore_mariadb" "$duong_dan_cau_hinh_mariadb"
        else
          cp -f "$TEMP_mariadb_config" "$duong_dan_cau_hinh_mariadb"
        fi
        chmod 644 "$duong_dan_cau_hinh_mariadb"
        chown root:root "$duong_dan_cau_hinh_mariadb"
        rm -f "${TEMP_mariadb_config:?}" 2>/dev/null
      fi
      wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - MariaDB Auto-Tuning thất bại! Đã khôi phục an toàn."
    fi
  fi

  # Restart OLS
  if /usr/local/lsws/bin/openlitespeed -t >/dev/null 2>&1; then
    /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
    rm -rf "${TEMP_OLS_config_DIR:?}"
    wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - OLS Auto-Tuning Thành công!"
  else
    # Restore OLS an toàn
    cp -fp "$TEMP_OLS_config_DIR/httpd_config.conf" /usr/local/lsws/conf/ 2>/dev/null
    cp -rf "$TEMP_OLS_config_DIR/vhosts" /usr/local/lsws/conf/ 2>/dev/null

    if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
      tuong_thich_nhom_litespeed="nogroup"
    else
      tuong_thich_nhom_litespeed="nobody"
    fi

    chown -hR lsadm:"$tuong_thich_nhom_litespeed" /usr/local/lsws/conf
    chmod -R 750 /usr/local/lsws/conf
    rm -rf "${TEMP_OLS_config_DIR:?}"
    wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - Lỗi cú pháp OLS Auto-Tuning! Đã khôi phục an toàn."
  fi

  # ==========================================
  # G. THIẾT LẬP ZRAM
  # ==========================================
  if ((TOTAL_RAM <= 8192)); then
    ZRAM_SIZE_MB=$((TOTAL_RAM / 2))
    ZRAM_PERCENT=50
  else
    ZRAM_SIZE_MB=4096
    ZRAM_PERCENT=$((4096 * 100 / TOTAL_RAM))
    ((ZRAM_PERCENT < 5)) && ZRAM_PERCENT=5
  fi

  if grep -qiE "ubuntu|debian" /etc/os-release 2>/dev/null; then
    OS_TYPE="UBUNTU"
    duong_dan_config_zram="/etc/default/zramswap"
  else
    OS_TYPE="RHEL"
    duong_dan_config_zram="/etc/systemd/zram-generator.conf"
  fi

  if [[ -f "$duong_dan_config_zram" ]]; then
    if [[ "$OS_TYPE" == "RHEL" ]]; then
      SUPPORTED_ALGOS=$(tr -d '[]' </sys/block/zram0/comp_algorithm 2>/dev/null || true)
      if [[ " $SUPPORTED_ALGOS " == *" zstd "* ]]; then
        BEST_ALGO="zstd"
      elif [[ " $SUPPORTED_ALGOS " == *" lz4 "* ]]; then
        BEST_ALGO="lz4"
      elif [[ " $SUPPORTED_ALGOS " == *" lzo-rle "* ]]; then
        BEST_ALGO="lzo-rle"
      else
        BEST_ALGO="lzo"
      fi

      cat <<EOF >"$duong_dan_config_zram"
[zram0]
zram-fraction = 1.0
max-zram-size = $ZRAM_SIZE_MB
zram-size = $ZRAM_SIZE_MB
compression-algorithm = $BEST_ALGO
swap-priority = 100
fs-type = swap
EOF
      chmod 644 "$duong_dan_config_zram"

      systemctl stop dev-zram0.swap >/dev/null 2>&1 || true
      zramctl --reset /dev/zram0 >/dev/null 2>&1 || true
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl start dev-zram0.swap >/dev/null 2>&1 || true
    elif [[ "$OS_TYPE" == "UBUNTU" ]]; then
      BEST_ALGO="zstd"
      cat <<EOF >"$duong_dan_config_zram"
ALGO=$BEST_ALGO
PERCENT=$ZRAM_PERCENT
SIZE=$ZRAM_SIZE_MB
PRIORITY=100
EOF
      chmod 644 "$duong_dan_config_zram"
      systemctl restart zramswap >/dev/null 2>&1 || true
    fi
    wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - ZRAM Auto-Tuned: ${ZRAM_SIZE_MB}MB với ${BEST_ALGO}"
  fi

  # ==========================================
  # H. AUTO-TUNE KERNEL SYSCTL & TUNED PROFILE (ĐỒNG BỘ 100% KIẾN TRÚC MỚI)
  # ==========================================
  if [[ ! -f /proc/user_beancounters && -d /etc/sysctl.d ]]; then
    if ((TOTAL_RAM <= 768)); then
      # VPS 512MB RAM
      CONNTRACK_MAX=65536
      CONNTRACK_HASHSIZE=16384
      MIN_FREE_KB=16384
      MAX_TW_BUCKETS=65536
      TCP_MAX_MEM=8388608
      VFS_PRESSURE=100
      DIRTY_BG_BYTES=16777216  # 16MB
      DIRTY_MAX_BYTES=67108864 # 64MB
    elif ((TOTAL_RAM <= 1536)); then
      # VPS 1GB RAM
      CONNTRACK_MAX=131072
      CONNTRACK_HASHSIZE=32768
      MIN_FREE_KB=32768
      MAX_TW_BUCKETS=131072
      TCP_MAX_MEM=16777216
      VFS_PRESSURE=100
      DIRTY_BG_BYTES=33554432   # 32MB
      DIRTY_MAX_BYTES=134217728 # 128MB
    elif ((TOTAL_RAM <= 4096)); then
      # VPS 2GB - 4GB RAM
      CONNTRACK_MAX=262144
      CONNTRACK_HASHSIZE=65536
      MIN_FREE_KB=65536
      MAX_TW_BUCKETS=262144
      TCP_MAX_MEM=16777216
      VFS_PRESSURE=60
      DIRTY_BG_BYTES=67108864   # 64MB
      DIRTY_MAX_BYTES=268435456 # 256MB
    else
      # Máy chủ > 4GB RAM
      CONNTRACK_MAX=524288
      CONNTRACK_HASHSIZE=131072
      MIN_FREE_KB=65536
      MAX_TW_BUCKETS=1440000
      TCP_MAX_MEM=33554432
      VFS_PRESSURE=50
      DIRTY_BG_BYTES=134217728  # 128MB
      DIRTY_MAX_BYTES=536870912 # 512MB
    fi

    # Tự động nhận diện trạng thái ZRAM để gán swappiness và page-cluster tương ứng
    if [[ -f "$duong_dan_config_zram" ]] || [[ -d /sys/block/zram0 ]] || grep -q '/dev/zram' /proc/swaps 2>/dev/null; then
      SWAPPINESS_VAL=100
      PAGE_CLUSTER_VAL=0
    else
      SWAPPINESS_VAL=10
      PAGE_CLUSTER_VAL=3
    fi

    modprobe tcp_bbr >/dev/null 2>&1 || true
    modprobe sch_fq >/dev/null 2>&1 || true
    modprobe nf_conntrack >/dev/null 2>&1 || true

    /bin/mkdir -p /etc/modules-load.d /etc/modprobe.d 2>/dev/null
    cat >/etc/modules-load.d/wptangtoc.conf <<'EOF'
tcp_bbr
sch_fq
nf_conntrack
EOF

    printf 'options nf_conntrack hashsize=%s\n' "$CONNTRACK_HASHSIZE" >/etc/modprobe.d/nf_conntrack.conf
    if [[ -w /sys/module/nf_conntrack/parameters/hashsize ]]; then
      printf '%s\n' "$CONNTRACK_HASHSIZE" >/sys/module/nf_conntrack/parameters/hashsize 2>/dev/null || true
    fi

    avail_cc=""
    if [[ -r /proc/sys/net/ipv4/tcp_available_congestion_control ]]; then
      read -r avail_cc </proc/sys/net/ipv4/tcp_available_congestion_control || true
    fi
    if [[ "$avail_cc" == *"bbr"* ]]; then
      TCP_CC="bbr"
    else
      TCP_CC="cubic"
    fi

    # Dọn dẹp các file cấu hình cũ để tránh xung đột thứ tự nạp
    /bin/rm -f /etc/sysctl.d/101-sysctl.conf /etc/sysctl.d/99-wptt-zram.conf 2>/dev/null || true

    SYSCTL_CONF="/etc/sysctl.d/99-wptangtoc-ols.conf"
    TEMP_SYSCTL_config="$(mktemp -p /etc/wptt/tmp wptt_sysctl_XXXXXX.conf 2>/dev/null || mktemp)"

    if [[ -n "$TEMP_SYSCTL_config" ]]; then
      cat >"$TEMP_SYSCTL_config" <<EOF
# ==============================================================================
# WPTangToc OLS - Enterprise Kernel, ZRAM & Network Tuning (${TOTAL_RAM}MB RAM)
# ==============================================================================

# 1. Quản lý Tiến trình, Lập lịch Server & File System (MariaDB Native AIO)
kernel.pid_max = 65536
kernel.printk = 4 1 1 7
kernel.panic = 10
kernel.sched_autogroup_enabled = 0
fs.nr_open = 12000000
fs.file-max = 9000000
fs.aio-max-nr = 1048576
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 1024

# 2. Quản lý Bộ nhớ Ảo tối ưu chuyên biệt cho ZRAM, MariaDB & Redis/KeyDB/Valkey
vm.swappiness = ${SWAPPINESS_VAL}
vm.page-cluster = ${PAGE_CLUSTER_VAL}
vm.vfs_cache_pressure = ${VFS_PRESSURE}
vm.dirty_background_ratio = 0
vm.dirty_ratio = 0
vm.dirty_background_bytes = ${DIRTY_BG_BYTES}
vm.dirty_bytes = ${DIRTY_MAX_BYTES}
vm.dirty_expire_centisecs = 1500
vm.dirty_writeback_centisecs = 300
vm.min_free_kbytes = ${MIN_FREE_KB}
vm.overcommit_memory = 1
vm.panic_on_oom = 0
vm.max_map_count = 262144

# 3. Bộ đệm Socket Core & Mở rộng UDP cho QUIC / HTTP/3 (OpenLiteSpeed)
net.core.wmem_max = ${TCP_MAX_MEM}
net.core.rmem_max = ${TCP_MAX_MEM}
net.core.rmem_default = 262144
net.core.wmem_default = 262144
net.core.optmem_max = 65536
net.core.netdev_max_backlog = 65536
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 8000
net.core.somaxconn = 65535
net.unix.max_dgram_qlen = 4096

# 4. Hiệu năng TCP & Thuật toán chống nghẽn Google BBR
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = ${TCP_CC}
net.ipv4.tcp_rmem = 4096 87380 ${TCP_MAX_MEM}
net.ipv4.tcp_wmem = 4096 65536 ${TCP_MAX_MEM}
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.tcp_limit_output_bytes = 1048576
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_base_mss = 1024
net.ipv4.tcp_sack = 1
net.ipv4.tcp_window_scaling = 1

# 5. Chống cạn kiệt Socket & DDoS Tầng TCP
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = 65536
net.ipv4.tcp_syn_retries = 2
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_fin_timeout = 10
net.ipv4.tcp_keepalive_time = 240
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_tw_reuse = 2
net.ipv4.tcp_max_tw_buckets = ${MAX_TW_BUCKETS}
net.ipv4.tcp_max_orphans = 65536
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.tcp_rfc1337 = 1
net.ipv4.tcp_challenge_ack_limit = 999999999

# 6. Khóa Bảo mật Tầng IPv4 & IPv6 (Tắt log_martians chống tràn đĩa khi bị Spoof DDoS)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.log_martians = 0
net.ipv4.conf.default.log_martians = 0
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0

# 7. Tối ưu Bảng theo dõi kết nối Netfilter Conntrack (Đồng bộ với Nftables & HTTP/3 QUIC)
net.netfilter.nf_conntrack_max = ${CONNTRACK_MAX}
net.netfilter.nf_conntrack_buckets = ${CONNTRACK_HASHSIZE}
net.netfilter.nf_conntrack_helper = 0
net.netfilter.nf_conntrack_tcp_timeout_established = 1800
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 15
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_udp_timeout = 30
net.netfilter.nf_conntrack_udp_timeout_stream = 60
net.netfilter.nf_conntrack_generic_timeout = 60
EOF

      if grep -q 'AMD EPYC' /proc/cpuinfo 2>/dev/null; then
        printf 'kernel.watchdog_thresh = 20\n' >>"$TEMP_SYSCTL_config"
      fi

      # -------------------------------------------------------------------------
      # Tối ưu kiến trúc NUMA (Dành riêng cho máy chủ lớn Bare-metal, Dual CPU)
      # Chống giật lag MariaDB và dập tắt cảnh báo của Redis khi cấp phát RAM
      # -------------------------------------------------------------------------
      numa_nodes=$(ls -1d /sys/devices/system/node/node* 2>/dev/null | wc -l)
      if ((numa_nodes > 1)); then
        cat >>"$TEMP_SYSCTL_config" <<EOF
# Tối ưu kiến trúc đa CPU (Multi-Socket/NUMA)
kernel.numa_balancing = 0
vm.zone_reclaim_mode = 0
EOF
      fi

      chmod 644 "$TEMP_SYSCTL_config"
      /bin/mv -fT -- "$TEMP_SYSCTL_config" "$SYSCTL_CONF"
      TEMP_SYSCTL_config=""

      # Đồng bộ Custom Tuned Profile (Ghi đè dirty_ratio=0 để bảo toàn dirty_bytes)
      if command -v tuned-adm >/dev/null 2>&1; then
        /bin/mkdir -p /etc/tuned/wptangtoc-performance 2>/dev/null
        cat >/etc/tuned/wptangtoc-performance/tuned.conf <<EOF
[main]
summary=WPTangToc OLS Latency Performance with ZRAM Optimization
include=latency-performance

[vm]
transparent_hugepages=never

[sysctl]
vm.swappiness=${SWAPPINESS_VAL}
vm.page-cluster=${PAGE_CLUSTER_VAL}
vm.vfs_cache_pressure=${VFS_PRESSURE}
vm.dirty_background_ratio=0
vm.dirty_ratio=0
vm.dirty_background_bytes=${DIRTY_BG_BYTES}
vm.dirty_bytes=${DIRTY_MAX_BYTES}
EOF
        chmod 644 /etc/tuned/wptangtoc-performance/tuned.conf
        tuned-adm profile wptangtoc-performance >/dev/null 2>&1 || true
      fi

      /sbin/sysctl --system >/dev/null 2>&1 || true
      wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - Kernel Sysctl Auto-Tuned: Conntrack=${CONNTRACK_MAX}, VFS=${VFS_PRESSURE}, DirtyMax=${DIRTY_MAX_BYTES}, Swappiness=${SWAPPINESS_VAL}"
    fi
  fi

  echo "$TOTAL_RAM" >"$FILE_CACHE"
  wptt_logs "INFO" "$(date '+%d-%m-%Y %H:%M') - Auto-Tuning hoàn tất toàn diện!"
fi
