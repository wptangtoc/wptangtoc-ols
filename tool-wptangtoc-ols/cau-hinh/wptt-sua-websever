#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026
# @description: Chỉnh sửa cấu hình OpenLiteSpeed HTTPD

function huong_dan() {
  cat <<'EOF'
  Tính năng Sửa cấu hình OpenLiteSpeed là quá trình điều chỉnh các thiết lập và tham số của máy chủ web OpenLiteSpeed để tùy biến cách nó hoạt động, hiệu suất, bảo mật, và cách nó phục vụ các website được lưu trữ trên đó.

  Nói một cách đơn giản, OpenLiteSpeed [OLS] là một đầu bếp hiệu suất cao cho website của bạn. Sửa cấu hình là việc bạn hướng dẫn đầu bếp này cách nấu nướng [phục vụ website], bảo quản nguyên liệu [quản lý cache], đảm bảo an toàn vệ sinh [bảo mật], và tối ưu gian bếp [hiệu suất] cho phù hợp nhất.

  Mục Đích Chính
  * Thiết lập Website [Virtual Hosts]: Định nghĩa cách OLS phục vụ các tên miền [website] khác nhau, bao gồm thư mục gốc chứa website, cổng lắng nghe, và các cài đặt riêng cho từng trang.
  * Tối ưu hiệu suất: Điều chỉnh các thông số liên quan đến xử lý kết nối, bộ nhớ đệm [LSCache - một điểm mạnh của LiteSpeed], xử lý PHP, nén GZIP để website chạy nhanh và hiệu quả hơn.
  * Tăng cường bảo mật: Cấu hình các tính năng bảo mật như chứng chỉ SSL/TLS [cho HTTPS], kiểm soát truy cập, chống lại các kiểu tấn công web phổ biến.
  * Tích hợp và Cấu hình PHP: Thiết lập cách OLS làm việc với PHP [thường qua LSAPI], chọn phiên bản PHP, cấu hình các tiến trình PHP.
  * Quản lý Cache [LSCache]: Bật và tinh chỉnh LiteSpeed Cache, một cơ chế cache mạnh mẽ ở cấp độ máy chủ giúp tăng tốc đáng kể các ứng dụng web động [như WordPress].
  * Quản lý Log: Cấu hình file log truy cập, log lỗi.
  * Thiết lập Listeners: Định nghĩa các địa chỉ IP và cổng mà máy chủ sẽ lắng nghe yêu cầu [ví dụ: cổng 80 cho HTTP, cổng 443 cho HTTPS].

  Sau khi cấu hình, máy chủ OpenLiteSpeed sẽ được tối ưu để phục vụ các website cụ thể một cách hiệu quả, an toàn, và với hiệu suất cao theo đúng yêu cầu của bạn.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null || true
umask 022

# shellcheck source=/dev/null
[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
[[ -f "/etc/wptt/lang/$ngon_ngu.sh" ]] && . "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

route_menu="${1:-}"
config_path="/usr/local/lsws/conf/httpd_config.conf"
tmp_edit=""
backup_orig=""
need_rollback=0

# ==============================================================================
# BẪY DỌN DẸP & TỰ ĐỘNG ROLLBACK NẾU BỊ NGẮT GIỮA CHỪNG (CTRL+C / ĐỨT SSH)
# ==============================================================================
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP

  if ((need_rollback == 1)) && [[ -n "${backup_orig:-}" && -f "$backup_orig" ]]; then
    local rb_tmp=""
    rb_tmp="$(wptt_atomic_begin "$config_path" 2>/dev/null || true)"
    if [[ -n "$rb_tmp" && -f "$rb_tmp" ]]; then
      /bin/cp -f -- "$backup_orig" "$rb_tmp" 2>/dev/null || true
      wptt_atomic_commit "$rb_tmp" "$config_path" 2>/dev/null || true
    fi
  fi

  [[ -n "${tmp_edit:-}" && -f "$tmp_edit" ]] && /bin/rm -f -- "$tmp_edit" 2>/dev/null || true
  [[ -n "${backup_orig:-}" && -f "$backup_orig" ]] && /bin/rm -f -- "$backup_orig" 2>/dev/null || true
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# ==============================================================================
# HÀM IN DÒNG LỖI TỰ ĐỘNG BẺ DÒNG (MULTI-LINE WORD WRAP) CHUẨN KHUNG 78 KÝ TỰ
# ==============================================================================
_print_wrapped_error_box() {
  local raw_text="$1"
  local line="" clean_line="" chunk=""
  local max_w=75

  while IFS= read -r line; do
    line="${line//$'\r'/}"
    [[ -z "$line" ]] && continue

    # Bỏ qua các cảnh báo WARN mặc định vô hại của Vhost Example / UID nhỏ
    if [[ "$line" == *"smaller than minimum requirement"* || "$line" == *"vhost:Example"* ]]; then
      continue
    fi

    # Cắt bỏ phần Timestamp dài dòng ở đầu (VD: "2026-10-30 17:17:22.786631 ") để ưu tiên hiển thị lỗi
    clean_line="$line"
    if [[ "$clean_line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+[0-9:.]+[[:space:]]+(.*)$ ]]; then
      clean_line="${BASH_REMATCH[1]}"
    fi

    # Tự động bẻ dòng nếu thông báo lỗi dài hơn 74 ký tự (Không bao giờ cắt cụt bằng ...)
    local first_wrap=1
    while [[ -n "$clean_line" ]]; do
      if ((first_wrap == 1)); then
        if ((${#clean_line} <= max_w)); then
          printf "${C_RED}│${C_RESET}  ${C_BOLD_WHITE}%-74s${C_RESET}${C_RED}│${C_RESET}\n" "$clean_line"
          break
        else
          chunk="${clean_line:0:$max_w}"
          clean_line="${clean_line:$max_w}"
          printf "${C_RED}│${C_RESET}  ${C_BOLD_WHITE}%-74s${C_RESET}${C_RED}│${C_RESET}\n" "$chunk"
          first_wrap=0
        fi
      else
        local sub_w=$((max_w - 4))
        chunk="${clean_line:0:$sub_w}"
        clean_line="${clean_line:$sub_w}"
        printf "${C_RED}│${C_RESET}    ${C_YELLOW}↳ %-70s${C_RESET}${C_RED}│${C_RESET}\n" "$chunk"
      fi
    done
  done <<<"$raw_text"
}

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}${cau_hinh_webserver:-Cấu hình Webserver} ➜ Chỉnh sửa file OpenLiteSpeed gốc${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ ! -f "$config_path" ]]; then
  _runloi "Kiểm tra file cấu hình $config_path"
  echo -e "\n${C_RED}❌ Lỗi: Không tìm thấy file cấu hình '$config_path'!${C_RESET}\n"
  wptt_quay_ve_menu "$route_menu" 1
fi

# ==============================================================================
# 1. XÁC NHẬN BẢO MẬT & HƯỚNG DẪN TRÌNH SOẠN THẢO
# ==============================================================================
if wptt_xac_nhan "Bạn có CHẮC CHẮN muốn mở và chỉnh sửa HTTPD không?" \
  "CẢNH BÁO NGUY HIỂM: File cấu hình HTTPD gốc rất nhạy cảm." \
  "Chỉ một sai sót nhỏ cũng có thể làm sập toàn bộ hệ thống Webserver" \
  "Đồng ý Chỉnh sửa" "Hủy thao tác"; then
  echo ""

  editor_cmd="${editor_cau_hinh:-nano}"
  if ! command -v "$editor_cmd" >/dev/null 2>&1; then
    if command -v nano >/dev/null 2>&1; then
      editor_cmd="nano"
    elif command -v vi >/dev/null 2>&1; then
      editor_cmd="vi"
    else
      _runloi "Tìm trình soạn thảo văn bản (nano/vi)"
      wptt_quay_ve_menu "$route_menu" 1
    fi
  fi

  if [[ "$editor_cmd" == "nano" ]]; then
    echo -e "${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_BOLD_WHITE}HƯỚNG DẪN LƯU FILE BẰNG NANO${C_RESET}"
    echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "1. Chỉnh sửa xong, ấn tổ hợp phím  : ${C_YELLOW}Ctrl + O${C_RESET}" 4
    left_text "2. Hệ thống hỏi tên file, ấn phím  : ${C_YELLOW}Enter${C_RESET}" 4
    left_text "3. Thoát ra ngoài Menu, ấn tổ hợp  : ${C_YELLOW}Ctrl + X${C_RESET}" 4
    echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  else
    echo -e "${C_YELLOW}Đang mở trình soạn thảo: $editor_cmd${C_RESET}\n"
  fi

  read -r -s -n 1 -t 1.8 _ 2>/dev/null || true

  # ============================================================================
  # 2. KHỞI TẠO BẢN SAO LƯU GỐC & FILE NHÁP ATOMIC (wptt_atomic_begin)
  # ============================================================================
  /bin/mkdir -p /etc/wptt/tmp 2>/dev/null || true
  chmod 700 /etc/wptt/tmp 2>/dev/null || true

  backup_orig="$(mktemp -p /etc/wptt/tmp httpd_config_orig_XXXXXX.bak)"
  /bin/cp -fp -- "$config_path" "$backup_orig" || {
    _runloi "Tạo bản sao lưu an toàn cho httpd_config.conf"
    wptt_quay_ve_menu "$route_menu" 1
  }

  old_md5=""
  read -r old_md5 _ < <(md5sum "$config_path" 2>/dev/null)

  tmp_edit="$(wptt_atomic_begin "$config_path")" || {
    _runloi "Khởi tạo file nháp chỉnh sửa OpenLiteSpeed"
    wptt_quay_ve_menu "$route_menu" 1
  }

  # ============================================================================
  # 3. VÒNG LẶP CHỈNH SỬA -> ATOMIC COMMIT -> KIỂM TRA CÚ PHÁP -> ROLLBACK/RETRY
  # ============================================================================
  while true; do
    "$editor_cmd" "$tmp_edit"
    clear

    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}ĐANG KIỂM TRA SỰ THAY ĐỔI VÀ CÚ PHÁP${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

    new_md5=""
    read -r new_md5 _ < <(md5sum "$tmp_edit" 2>/dev/null)

    if [[ "$old_md5" == "$new_md5" ]]; then
      if ((need_rollback == 1)); then
        rb_tmp="$(wptt_atomic_begin "$config_path")"
        /bin/cp -f -- "$backup_orig" "$rb_tmp"
        wptt_atomic_commit "$rb_tmp" "$config_path"
        need_rollback=0
      fi
      echo -e "${C_YELLOW}Không có sự thay đổi nào được phát hiện trong file. Bỏ qua bước nạp lại.${C_RESET}\n"
      break
    fi

    # Áp dụng nguyên tử file nháp vào vị trí chính thức để openlitespeed -t kiểm tra
    need_rollback=1
    commit_stage="$(wptt_atomic_begin "$config_path")" || {
      _runloi "Chuẩn bị commit cấu hình OpenLiteSpeed"
      break
    }
    /bin/cp -f -- "$tmp_edit" "$commit_stage"
    wptt_atomic_commit "$commit_stage" "$config_path"

    task_syntax="Phân tích cú pháp cấu hình OpenLiteSpeed (Syntax Check)"
    _runing "$task_syntax"
    syntax_rc=0
    syntax_check="$(/usr/local/lsws/bin/openlitespeed -t 2>&1)" || syntax_rc=$?

    # Lọc bỏ các dòng WARN vô hại (UID/GID Example) trước khi đánh giá lỗi
    filtered_syntax="$(grep -vE 'smaller than minimum requirement|vhost:Example' <<<"$syntax_check" || true)"

    # Báo lỗi nếu mã thoát != 0 HOẶC có [ERROR], FATAL, hoặc cấu hình sai giá trị (invalid value / syntax error)
    if ((syntax_rc != 0)) || grep -qiE '\[ERROR\]|FATAL|invalid value|syntax error|failed to' <<<"$filtered_syntax"; then
      _runloi "$task_syntax"
      wptt_logs "ERROR" "Chỉnh sửa httpd_config.conf bị lỗi cú pháp OpenLiteSpeed"

      echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}PHÁT HIỆN LỖI CÚ PHÁP TRONG CẤU HÌNH VỪA SỬA${C_RESET}" "$C_RED"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "${C_YELLOW}Hệ thống đã CHẶN LỆNH RELOAD để bảo vệ Website khỏi bị sập!${C_RESET}" 2 "$C_RED"
      left_text "Chi tiết mã lỗi từ OpenLiteSpeed:" 2 "$C_RED"
      echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

      # In toàn bộ nội dung lỗi (tự động xuống dòng mượt mà, không bị cắt cụt ...)
      _print_wrapped_error_box "${filtered_syntax:-$syntax_check}"

      echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

      if wptt_xac_nhan "Cấu hình bạn vừa lưu bị lỗi cú pháp!" \
        "Bạn có muốn mở lại trình soạn thảo để sửa tiếp không?" \
        "(Nếu chọn Hủy, hệ thống sẽ tự động khôi phục lại file gốc ban đầu)" \
        "Sửa lại ngay" "Hủy & Khôi phục file gốc"; then
        continue
      else
        task_rb="Khôi phục (Rollback) lại file cấu hình gốc an toàn"
        _runing "$task_rb"
        rb_tmp="$(wptt_atomic_begin "$config_path")"
        /bin/cp -f -- "$backup_orig" "$rb_tmp"
        wptt_atomic_commit "$rb_tmp" "$config_path"
        need_rollback=0
        _rundone "$task_rb"
        wptt_logs "INFO" "Đã tự động Rollback httpd_config.conf về bản gốc an toàn"
        wptt_quay_ve_menu "$route_menu" 1
      fi
    else
      need_rollback=0
      _rundone "$task_syntax"

      task_reload="Nạp lại cấu hình mới cho OpenLiteSpeed (Zero-Downtime)"
      _runing "$task_reload"
      wptt_smart_reload_lsws >/dev/null 2>&1
      wptt_logs "INFO" "Cấu hình lại LiteSpeed Webserver (httpd_config.conf) thành công"
      _rundone "$task_reload"

      echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
      center_text "${C_BOLD_WHITE}CẬP NHẬT CẤU HÌNH THÀNH CÔNG${C_RESET}" "$C_GREEN"
      echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
      left_text "Trạng thái : Các thay đổi đã được kiểm tra và áp dụng mượt mà." 2 "$C_GREEN"
      echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
      break
    fi
  done

else
  echo -e "${C_YELLOW}Đã hủy thao tác chỉnh sửa cấu hình.${C_RESET}\n"
fi

wptt_quay_ve_menu "$route_menu" 0
