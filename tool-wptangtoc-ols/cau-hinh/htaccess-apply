#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Setup Realtime OpenLiteSpeed .htaccess Watcher
# @since: 2026

# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

# 1. DỌN DẸP HỆ THỐNG CRONJOB CŨ
TASK_CRON="Dọn dẹp cấu hình Cronjob cũ"
_runing "$TASK_CRON"
(crontab -l 2>/dev/null | grep -vE 'wptt_smart_reload_lsws|/usr/local/lsws/cgid' || true) | crontab - 2>/dev/null

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  rm -f /etc/cron.d/optimize-htaccess-wptangtoc-ols-premium_cron 2>/dev/null
  systemctl restart cron.service >/dev/null 2>&1 || true
else
  systemctl restart crond.service >/dev/null 2>&1 || true
fi
_rundone "$TASK_CRON"

# 2. CÀI ĐẶT THƯ VIỆN GIAO TIẾP KERNEL (INOTIFY-TOOLS)
TASK_INOTIFY="Kiểm tra và cài đặt thư viện inotify-tools"
_runing "$TASK_INOTIFY"
if ! command -v inotifywait &>/dev/null; then
  if [[ -f /etc/redhat-release ]]; then
    dnf install inotify-tools -y -q >/dev/null 2>&1 || yum install inotify-tools -y -q >/dev/null 2>&1
  elif [[ -f /etc/debian_version ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null 2>&1 &&
      DEBIAN_FRONTEND=noninteractive apt-get install inotify-tools -y -q >/dev/null 2>&1
  fi
fi

if command -v inotifywait &>/dev/null; then
  _rundone "$TASK_INOTIFY"
else
  _runloi "$TASK_INOTIFY"
  if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-add-one-main 1
  fi
  exit 1
fi

# Đảm bảo giới hạn inotify của Kernel luôn dư dả cho VPS nhỏ
if [[ -w /proc/sys/fs/inotify/max_user_watches ]]; then
  CURRENT_WATCHES=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo 8192)
  if ((CURRENT_WATCHES < 65536)); then
    sysctl -w fs.inotify.max_user_watches=65536 >/dev/null 2>&1 || true
  fi
fi

# Đảm bảo file tĩnh engine có quyền thực thi
chmod 700 /etc/wptt/wptt-htaccess-watcher 2>/dev/null

# 3. TẠO VÀ KÍCH HOẠT DỊCH VỤ SYSTEMD CHẠY NGẦM VĨNH VIỄN
TASK_SYSTEMD="Thiết lập Dịch vụ Systemd Daemon"
_runing "$TASK_SYSTEMD"
cat <<'EOF' >/etc/systemd/system/wptt-htaccess.service
[Unit]
Description=WPTangToc OLS Realtime .htaccess Watcher
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /etc/wptt/wptt-htaccess-watcher
Restart=always
RestartSec=5
# Tối ưu bộ nhớ và CPU tối đa cho VPS nhỏ chống rò rỉ RAM
LimitSTACK=512K
MemoryHigh=16M
MemoryMax=32M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >/dev/null 2>&1
systemctl enable wptt-htaccess >/dev/null 2>&1
if systemctl restart wptt-htaccess >/dev/null 2>&1; then
  _rundone "$TASK_SYSTEMD"
else
  _runloi "$TASK_SYSTEMD"
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CẤU HÌNH .HTACCESS REALTIME HOÀN TẤT${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Reload OLS tức thì (0.001s) ngay khi ấn Save file .htaccess"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ "${1:-}" == "98" ]]; then
  exec /etc/wptt/wptt-add-one-main 1
fi
