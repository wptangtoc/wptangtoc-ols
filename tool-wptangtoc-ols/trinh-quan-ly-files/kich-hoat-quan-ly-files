#!/bin/bash
function huong_dan() {
  Tính năng Kích hoạt File Manager [Trình quản lý tệp/tập tin] thường có nghĩa là truy cập và sử dụng một công cụ dựa trên giao diện web, cho phép bạn quản lý trực tiếp các tệp tin và thư mục của website trên máy chủ, tương tự như Windows Explorer trên máy tính của bạn.

  Nói một cách đơn giản, đây là công cụ giúp bạn xem, tải lên, tải xuống, tạo mới, xóa, đổi tên, sửa đổi tệp tin, và thay đổi quyền truy cập [permissions] cho các tệp và thư mục của website ngay trong trình duyệt web mà không cần dùng phần mềm FTP riêng.

  Mục Đích Chính
  * Quản lý tệp tin dễ dàng: Cung cấp giao diện đồ họa trực quan để thao tác với file và thư mục trên server.
  * Chỉnh sửa nhanh: Cho phép xem và sửa nhanh các tệp văn bản [HTML, CSS, PHP, file cấu hình] trực tiếp.
  * Tải lên/Tải xuống: Dễ dàng đưa file website mới lên server hoặc tải về các file hiện có, backup.
  * Quản lý quyền: Thay đổi quyền đọc/ghi/thực thi cho file và thư mục, rất quan trọng để website hoạt động đúng.
  * Nén/Giải nén: Hỗ trợ tạo file nén [zip] hoặc giải nén các file đã tải lên.

  Sau khi kích hoạt bạn có thể thực hiện các thao tác quản lý tệp tin cho website của mình một cách thuận tiện.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

NAME=$1
[[ "$NAME" == "98" ]] && NAME=""

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}QUẢN LÝ FILE MANAGER ➜ $bat File Manager${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# HÀM MENU LỌC THÔNG MINH (UX BO CONG CĂN LỀ CHUẨN XÁC)
# ==============================================================================
if [[ -z "$NAME" ]]; then
  function lua_chon_NAME() {
    unset NAME selects
    selects=()
    local box_inner_width=${box_inner_width:-78}

    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
      local domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" == ?*.?* ]]; then
        # CHỈ HIỂN THỊ DOMAIN CHƯA CÓ FILE MANAGER
        if [[ ! -d "/usr/local/lsws/$domain/html/quan-ly-files" ]]; then
          selects+=("$domain")
        fi
      fi
    done

    if [[ ${#selects[@]} -eq 0 ]]; then
      echo -e "${C_YELLOW}Tất cả website trên hệ thống đều đã được kích hoạt File Manager!${C_RESET}"
      sleep 3
      exec /etc/wptt/wptt-quan-ly-files-main 1
    fi

    mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

    # RENDER KHUNG MENU BO CONG
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    local title_text="Nhập lựa chọn website của bạn muốn kích hoạt File Manager:"
    local len=$(echo -n "$title_text" | awk '{print length($0)}')
    local pad_r=$((box_inner_width - len - 2))
    [[ $pad_r -lt 0 ]] && pad_r=0
    echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

    local line_len=$((len + 3))
    local pad_line_r=$((box_inner_width - line_len))
    [[ $pad_line_r -lt 0 ]] && pad_line_r=0
    local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
    echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

    local i=1
    for domain in "${selects[@]}"; do
      local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain")
      local clean_text=$(printf "  %3d) %s" "$i" "$domain")
      local item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
      local pad=$((box_inner_width - item_len))
      [[ $pad -lt 0 ]] && pad=0
      echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
      ((i++))
    done
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    # PROMPT INPUT
    local fzf_installed=false
    if command -v fzf &>/dev/null; then
      fzf_installed=true
      PROMPT_TEXT="Nhập lựa chọn website (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
    else
      PROMPT_TEXT="Nhập lựa chọn website (1-${#selects[@]}) [0=Thoát]: "
    fi

    while true; do
      echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
      if ! read -r REPLY; then exit 1; fi
      REPLY="${REPLY// /}"
      REPLY="${REPLY,,}"

      case "$REPLY" in
      0)
        echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
        NAME="0"
        return 0
        ;;
      00)
        if $fzf_installed; then
          local selected_name=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website kích hoạt >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
          selected_name="${selected_name#*: }"
          if [[ -n "$selected_name" ]]; then
            NAME="$selected_name"
            return 0
          else
            echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"
          fi
        else
          echo -e "${C_RED}Lỗi: FZF chưa được cài đặt.${C_RESET}"
        fi
        ;;
      *)
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
          local action_index=$((REPLY - 1))
          NAME="${selects[$action_index]}"
          return 0
        else
          echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
        fi
        ;;
      esac
    done
  }

  lua_chon_NAME
fi

# --- CHỐT CHẶN THOÁT HIỂM ---
if [[ "$NAME" == "0" || -z "$NAME" ]]; then
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-quan-ly-files-main 1
  return 2>/dev/null || exit
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}Tên miền không tồn tại trên hệ thống này!${C_RESET}"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-quan-ly-files-main 1
  return 2>/dev/null || exit
fi

if [[ -d "/usr/local/lsws/$NAME/html/quan-ly-files" ]]; then
  echo -e "\n${C_YELLOW}Bạn đã kích hoạt trình quản lý files cho website này rồi!${C_RESET}"
  sleep 2
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-quan-ly-files-main 1
  return 2>/dev/null || exit
fi

# ==============================================================================
# BẮT ĐẦU CÀI ĐẶT & DOWNLOAD (TÍCH HỢP ZERO TRUST GPG & UX PV TÀNG HÌNH)
# ==============================================================================
echo ""
_runing "Tải và xác thực GPG FileManager cho website $NAME..."
password_quan_ly_file=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 36)
user_quan_ly_file=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 24)

cd /usr/local/lsws/"$NAME"/html || exit 1

fm_zip="quan-ly-files.zip"
rm -f "${fm_zip:?}" "${fm_zip:?}.sig" #clean truớc khi download

# Định nghĩa 3 trạm tải chiến lược
URL_1="https://wptangtoc.com/share/quan-ly-files.zip"
URL_2="https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/main/quan-ly-files.zip"

echo "" # Tạo một dòng trống cho thanh tiến trình PV chạy mượt

function wptt_download_filemanager_ux() {
  local url="$1"
  
  # Lấy kích thước thật qua header (Vượt 302 Redirect của Github)
  local fsize
  fsize=$(curl -sIL --max-time 5 "$url" | grep -i -E "content-length" | tail -n 1 | awk '{print $2}' | tr -d '\r')

  if command -v pv &>/dev/null && [[ -n "$fsize" && "$fsize" -gt 0 ]]; then
    # Ép ngắt nếu tốc độ dưới 100KB/s trong 8 giây
    curl -sL --connect-timeout 5 --speed-limit 102400 --speed-time 8 "$url" | pv -s "$fsize" -N "Tải FileManager" -p -t -e -r -b -w 90 > "$fm_zip"
    local dl_status=${PIPESTATUS[0]}
    
    # Tàng hình: lùi lên 1 dòng, xóa sạch tiến trình
    echo -en "\033[1A\033[2K\r"
    return "$dl_status"
  else
    # Phương án dự phòng với Wget (Giao diện chuẩn 1 dòng)
    wget -q --show-progress --timeout=8 --tries=2 "$url" -O "$fm_zip"
    local dl_status=$?
    
    echo -en "\033[1A\033[2K\r"
    return $dl_status
  fi
}

# Vòng lặp tải thông minh (Thử lần lượt từng Link kèm xác thực GPG)
success_download=0
for url in "$URL_1" "$URL_2"; do
  if wptt_download_filemanager_ux "$url"; then
    
    # --- BƯỚC 1: TẢI CHỮ KÝ GPG ĐỂ ĐỐI CHIẾU ---
    wget -q --timeout=15 --tries=3 "https://hub.wptangtoc.com/quan-ly-files.zip.sig" -U 'checksum wptangtoc ols' -O "${fm_zip}.sig"
    
    # --- BƯỚC 2: XÁC THỰC BẢO MẬT GPG ---
    if gpg --verify "${fm_zip}.sig" "$fm_zip" >/dev/null 2>&1; then
      
      # --- BƯỚC 3: KIỂM TRA TÍNH TOÀN VẸN CỦA FILE NÉN ---
      if unzip -t "$fm_zip" &>/dev/null; then
        success_download=1
        break # Tải, Xác thực và Checksum hoàn hảo -> Thoát vòng lặp!
      fi
    else
      echo -e "\n${C_RED}❌ CẢNH BÁO BẢO MẬT: Chữ ký GPG không hợp lệ hoặc thiếu Public Key! Bỏ qua nguồn tải này.${C_RESET}"
    fi
  fi
  rm -f "${fm_zip:?}" "${fm_zip:?}.sig" # Nếu lỗi, GPG sai hoặc file hỏng, xóa đi để thử link tiếp theo
done

if [[ $success_download -eq 0 ]]; then
  _runloi "Tải hoặc Xác thực FileManager thất bại! Vui lòng kiểm tra lại mạng hoặc khóa GPG."
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-quan-ly-files-main 1
  return 2>/dev/null || exit 1
fi

echo -en "\033[1A\033[2K\r" # Xóa nốt dòng trống để UI khít lại

unzip -oq "$fm_zip"
rm -f "${fm_zip:?}" "${fm_zip:?}.sig"
_rundone "Tải và xác thực FileManager cho website $NAME thành công."

_runing "Cài đặt FileManager cho website $NAME..."
sed -i '/password_dang_nhap_quan_ly_file_cap_2/d' /etc/wptt/vhost/."$NAME".conf
sed -i '/id_dang_nhap_quan_ly_file_cap_2/d' /etc/wptt/vhost/."$NAME".conf
sed -i '/id_quan_ly_files/d' /etc/wptt/vhost/."$NAME".conf
sed -i '/password_quan_ly_file/d' /etc/wptt/vhost/."$NAME".conf

mkdir -p /usr/local/lsws/"$NAME"/passwd
cd /usr/local/lsws/"$NAME"/html/quan-ly-files || exit
php ma-hoa-wptangtoc.php "$user_quan_ly_file" "$password_quan_ly_file"
rm -f ma-hoa-wptangtoc.php

# MÃ HÓA LỚP 2 VÀ GHI VÀO FILE CONFIG BẰNG DẤU NHÁY ĐƠN
enc_id_fm=$(wptt_ma_hoa "$user_quan_ly_file")
enc_pass_fm=$(wptt_ma_hoa "$password_quan_ly_file")
echo "id_quan_ly_files='${enc_id_fm}'" >>/etc/wptt/vhost/."$NAME".conf
echo "password_quan_ly_file='${enc_pass_fm}'" >>/etc/wptt/vhost/."$NAME".conf

PHP_Command="admin_php"
Webadmin_Pass=$(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 36)
id_ols_admin=$(openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 24)
Encrypt_string=$(/usr/local/lsws/admin/fcgi-bin/$PHP_Command -q /usr/local/lsws/admin/misc/htpasswd.php "${Webadmin_Pass}")

echo "$id_ols_admin:$Encrypt_string" >/usr/local/lsws/"$NAME"/passwd/.files

sed -i -e '/^realm '"${NAME}"files'/,/^}$/d' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf
sed -i -e '/^context \/quan-ly-files\//,/^}$/d' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf

cat <<EOF >>/usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf
realm ${NAME}files {
  userDB  {
    location              /usr/local/lsws/${NAME}/passwd/.files
  }
}
context /quan-ly-files/ {
  location                quan-ly-files/
  allowBrowse             1
  realm                   ${NAME}files

  accessControl  {
    allow                 ALL
  }

  rewrite  {

  }
  addDefaultCharset       off

  phpIniOverride  {
php_value upload_max_filesize 30G
php_value max_file_uploads 10000
php_value post_max_size 30G
php_value max_execution_time 10000
php_value max_input_time 10000
php_admin_value open_basedir ""
php_admin_value disable_functions ""
  }
}
EOF

# MÃ HÓA LỚP 1 VÀ GHI VÀO FILE CONFIG BẰNG DẤU NHÁY ĐƠN
enc_id_cap2=$(wptt_ma_hoa "$id_ols_admin")
enc_pass_cap2=$(wptt_ma_hoa "$Webadmin_Pass")
echo "id_dang_nhap_quan_ly_file_cap_2='${enc_id_cap2}'" >>/etc/wptt/vhost/."$NAME".conf
echo "password_dang_nhap_quan_ly_file_cap_2='${enc_pass_cap2}'" >>/etc/wptt/vhost/."$NAME".conf

if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

chown nobody:$tuong_thich_nhom_litespeed /usr/local/lsws/"$NAME"/passwd/.files
chmod 400 /usr/local/lsws/"$NAME"/passwd/.files

# SỰ KIỆN GÂY ĐÈ BIẾN: Khai báo cất giữ Cleartext trước khi gọi lại file .conf
print_pass_fm="$password_quan_ly_file"

. /etc/wptt/vhost/."$NAME".conf

chown -R "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/html/quan-ly-files
chmod 400 /usr/local/lsws/"$NAME"/passwd/.password-giatuan.json
chmod 400 /usr/local/lsws/"$NAME"/passwd/.user-giatuan.json
chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/passwd/.password-giatuan.json
chown "$User_name_vhost":"$User_name_vhost" /usr/local/lsws/"$NAME"/passwd/.user-giatuan.json

wptt_smart_reload_lsws >/dev/null 2>&1
_rundone "Kích hoạt FileManager thành công cho website $NAME"

# ==============================================================================
# BẢNG TÓM TẮT THÔNG TIN TRUY CẬP (KHUNG 78PX BO GÓC)
# ==============================================================================

unset ssl_xac_thuc_kha_dung
. /etc/wptt/ssl/check-ssl-cert-con-kha-dung "$NAME"
if [[ $ssl_xac_thuc_kha_dung = 'true' ]]; then
  url_truy_cap="https://$NAME/quan-ly-files"
else
  url_truy_cap="http://$NAME/quan-ly-files"
fi

box_inner_width=${box_inner_width:-78}

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}TÀI KHOẢN TRUY CẬP FILE MANAGER: $NAME${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

# Hàm in_dong nâng cấp dùng awk đếm ký tự chuẩn để không bị lệch viền
function in_dong() {
  local raw_text="$1"
  local colored_text="$2"
  local len=$(echo -n "$raw_text" | awk '{print length($0)}')
  local pad=$((box_inner_width - len))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_GREEN}│${C_RESET}${colored_text}$(printf '%*s' "$pad" "")${C_GREEN}│${C_RESET}"
}

in_dong "  Đường dẫn truy cập : $url_truy_cap" "  ${C_BOLD_WHITE}Đường dẫn truy cập :${C_RESET} ${C_CYAN}$url_truy_cap${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
in_dong "  LỚP 1: XÁC THỰC MÁY CHỦ (HTTP Basic Auth)" "  ${C_BOLD_WHITE}LỚP 1: XÁC THỰC MÁY CHỦ (HTTP Basic Auth)${C_RESET}"
in_dong "  User đăng nhập     : $id_ols_admin" "  User đăng nhập     : ${C_YELLOW}$id_ols_admin${C_RESET}"
in_dong "  Password           : $Webadmin_Pass" "  Password           : ${C_YELLOW}$Webadmin_Pass${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
in_dong "  LỚP 2: ĐĂNG NHẬP ỨNG DỤNG FILE MANAGER" "  ${C_BOLD_WHITE}LỚP 2: ĐĂNG NHẬP ỨNG DỤNG FILE MANAGER${C_RESET}"
in_dong "  User File Manager  : $user_quan_ly_file" "  User File Manager  : ${C_YELLOW}$user_quan_ly_file${C_RESET}"
in_dong "  Password           : $print_pass_fm" "  Password           : ${C_YELLOW}$print_pass_fm${C_RESET}"
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -e "${C_CYAN}Ghi chú:${C_RESET} Bạn có thể xem lại tài khoản tại menu: WPTangToc OLS => Quản lý File"
echo -e "${C_YELLOW}Khuyến nghị:${C_RESET} Khi sử dụng xong, vui lòng TẮT (Xóa) FileManager để bảo mật tối đa."

if [[ -d /usr/local/lsws/modsec/owasp ]]; then
  echo -e "\n${C_RED}LƯU Ý MODSECURITY:${C_RESET}"
  echo -e "Hệ thống phát hiện bạn đang bật tường lửa ModSecurity."
  echo -e "Nếu gặp lỗi ${C_RED}403 Forbidden${C_RESET} khi lưu file (VD: wp-config.php), hãy TẠM TẮT ModSecurity,"
  echo -e "chỉnh sửa xong file rồi bật lại ModSecurity nhé."
fi

echo "Kích hoạt filemanager website $NAME : $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

echo -en "\n${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
read -r
[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-quan-ly-files-main 1
