#!/bin/bash

function huong_dan() {
  rsync là một công cụ mạnh mẽ và linh hoạt dùng để đồng bộ hóa [synchronize] và truyền tải [transfer] file/thư mục giữa các máy tính/máy chủ. Khi nói về chuyển website rsync tự động hóa quá trình sao chép dữ liệu website từ một nơi này sang một nơi khác [ví dụ: từ server phát triển sang server sản phẩm, hoặc để sao lưu website].

  Các tính năng nổi bật khi dùng rsync để chuyển website tự động:

  Đồng bộ hóa thông minh: rsync chỉ sao chép những phần file đã thay đổi hoặc những file mới, giúp tiết kiệm băng thông và thời gian so với việc sao chép toàn bộ.
  * Hiệu quả và Nhanh chóng: Nhờ thuật toán delta-transfer, rsync truyền dữ liệu rất hiệu quả.
  * Bảo toàn thuộc tính file: rsync có thể giữ nguyên các thuộc tính của file như quyền truy cập, thời gian sửa đổi, v.v.
  * Bảo mật: Có thể truyền dữ liệu qua các kênh mã hóa như SSH để đảm bảo an toàn.
  * Nén dữ liệu: rsync hỗ trợ nén dữ liệu trong quá trình truyền để giảm dung lượng và tăng tốc độ.
  * Linh hoạt: Nhiều tùy chọn cấu hình cho phép bạn tùy chỉnh quá trình đồng bộ hóa theo nhu cầu cụ thể.
  Nói tóm lại, sử dụng rsync để tự động hóa việc chuyển website giúp đảm bảo dữ liệu luôn được cập nhật, tiết kiệm thời gian quản trị và giảm thiểu rủi ro lỗi do con người.
}

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHUYỂN WEBSITE ➜ Đóng gói & Rsync sang Server mới${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập địa chỉ IP Server mới [0=Thoát]: ${C_RESET}"
  read -r IP
  [[ "$IP" == "0" || -z "$IP" ]] && {
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
    exit 0
  }

  # Clean IP
  IP="${IP//[[:space:]]/}"

  # Regex kiểm tra IPv4 & IPv6
  is_ipv4=$(echo "$IP" | grep -E -o '^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$')
  is_ipv6=$(echo "$IP" | grep -oE '\b([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b|\b([0-9a-fA-F]{1,4}:){1,7}:\b|::1')

  if [[ -n "$is_ipv4" || -n "$is_ipv6" ]]; then
    break
  else
    echo -e "${C_RED}Lỗi: Định dạng IP không hợp lệ! Vui lòng nhập lại.${C_RESET}"
  fi
done

echo -en "${C_CYAN}Nhập Port SSH Server mới [Mặc định: 22]: ${C_RESET}"
read -r Port
Port=${Port:-22}
if ! [[ "$Port" =~ ^[0-9]+$ ]]; then
  echo -e "${C_RED}Lỗi: Port phải là số!${C_RESET}"
  exit 1
fi

. /etc/wptt/.wptt.conf

# Đảm bảo thư mục két sắt tmp luôn tồn tại
mkdir -p /etc/wptt/tmp
chmod 755 /etc/wptt/tmp

# Xóa list cũ trước khi build vòng lặp
SAFE_TXT_ALL="/etc/wptt/tmp/danh-sach-website-wptangtoc-ols.txt"
rm -f "$SAFE_TXT_ALL"

if [[ -d /etc/wptt/vhost ]]; then
  echo
  rm -f /usr/local/lsws/"${Website_chinh:?}"/html/danh-sach-website-wptangtoc-ols.txt
  echo '--------------------------------------------------'
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}" 
    domain="${domain%.conf}" 
    domain="${domain#.}"     

    if [[ "$domain" != ?*.?* ]]; then 
      continue
    fi

    path="/usr/local/lsws/$domain/html"
    i=1
    if [[ -d "$path" ]]; then              
      if [[ -f $path/wp-config.php ]]; then 
        _runing "Sao lưu database website $domain"
        
        # ==============================================================================
        # [BẢO MẬT]: CHỈ DÙNG REGEX ĐỌC TEXT PURE. CẤM WP-CLI
        # ==============================================================================
        unset DB_Password_web DB_User_web DB_Name_web
        wp_config_file="$path/wp-config.php"

        DB_User_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_USER['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_USER['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
        DB_Password_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_PASSWORD['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_PASSWORD['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
        DB_Name_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_NAME['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_NAME['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")

        if [[ -z "$DB_User_web" || -z "$DB_Password_web" || -z "$DB_Name_web" ]]; then
          _runloi "Bỏ qua: Không trích xuất được Database Info của $domain"
          continue
        fi
        # ==============================================================================

        password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
        [[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

        TEMP_CNF=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
        chmod 600 "$TEMP_CNF"
        cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
        trap "rm -f ${TEMP_CNF}" EXIT

        # ==============================================================================
        # [BẢO MẬT & TỐI ƯU]: DUMP VÀO KÉT SẮT VÀ BẮT LỖI BẰNG EXIT CODE
        # ==============================================================================
        SAFE_DUMP_FILE="/etc/wptt/tmp/${domain}_giatuan_wptangtoc.sql"
        rm -f "$SAFE_DUMP_FILE"
        
        if ! mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" > "$SAFE_DUMP_FILE"; then
          _runloi "Sao lưu database website $domain (Lỗi thực thi lệnh)"
          rm -f "$SAFE_DUMP_FILE" "${TEMP_CNF:?}"
          continue
        fi
        rm -f "${TEMP_CNF:?}"
        
        if [[ ! -s "$SAFE_DUMP_FILE" ]]; then
          _runloi "Sao lưu database website $domain (Lỗi file rỗng)"
          rm -f "$SAFE_DUMP_FILE"
          continue
        fi

        rm -f "${path:?}/giatuan-wptangtoc.sql"
        cp "$SAFE_DUMP_FILE" "${path}/giatuan-wptangtoc.sql"
        
        # [BẢO MẬT TỐI ĐA] Khóa chặt file bằng quyền Root 600
        chown root:root "${path}/giatuan-wptangtoc.sql" 2>/dev/null
        chmod 600 "${path}/giatuan-wptangtoc.sql" 2>/dev/null
        rm -f "$SAFE_DUMP_FILE"
        
        echo "$domain" >> "$SAFE_TXT_ALL"
        _rundone "Sao lưu database website $domain"
        # ==============================================================================
      fi
    fi
  done
  
  # Kết thúc vòng lặp, copy list ra domain chính
  if [[ -f "$SAFE_TXT_ALL" ]]; then
    cp "$SAFE_TXT_ALL" "/usr/local/lsws/$Website_chinh/html/danh-sach-website-wptangtoc-ols.txt"
    chown root:root "/usr/local/lsws/$Website_chinh/html/danh-sach-website-wptangtoc-ols.txt" 2>/dev/null
    chmod 600 "/usr/local/lsws/$Website_chinh/html/danh-sach-website-wptangtoc-ols.txt" 2>/dev/null
    rm -f "$SAFE_TXT_ALL"
  fi
  
  echo '--------------------------------------------------'
  echo
fi

# =================================================================
# [CẢI TIẾN] Thu thập danh sách Domain và Đúc màng lọc OS thông minh
# =================================================================

RSYNC_domain_all=()
RSYNC_EXCLUDES=() # Khởi tạo mảng trống

if [[ -d /etc/wptt/vhost ]]; then
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi

    path="/usr/local/lsws/$domain/html"
    if [[ -d "$path" ]]; then

      RSYNC_domain_all+=("/usr/local/lsws/$domain")

      RSYNC_EXCLUDES+=(
        "--exclude=/$domain/bin"
        "--exclude=/$domain/sbin"
        "--exclude=/$domain/lib"
        "--exclude=/$domain/lib64"
        "--exclude=/$domain/usr"
        "--exclude=/$domain/dev"
        "--exclude=/$domain/etc"
        "--exclude=/$domain/tmp"
        "--exclude=/$domain/var"
        "--exclude=/$domain/passwd"
        "--exclude=/$domain/html/phpmyadmin"
        "--exclude=/$domain/html/quan-ly-files"
        "--exclude=/$domain/.cron_spool"
        "--exclude=/$domain/.bash*"
        "--exclude=/$domain/.lsns"
        "--exclude=/$domain/luucache"
        "--exclude=/$domain/logs"
        "--exclude=/$domain/backup-website"
      )
    fi
  done
fi

#backup-database-subfolder
for filepath in /etc/wptt/vhost/.*.conf; do
  [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

  NAME="${filepath##*/}"
  NAME="${NAME%.conf}"
  NAME="${NAME#.}"

  if [[ "$NAME" != ?*.?* ]]; then
    continue
  fi

  rm -f /usr/local/lsws/"${NAME:?}"/html/subfolder-wptt.txt
  SAFE_SUB_TXT="/etc/wptt/tmp/subfolder-${NAME}.txt"
  rm -f "$SAFE_SUB_TXT"

  if [[ ! -d /etc/wptt/$NAME-wptt ]]; then
    continue
  fi

  domain_all=()
  readarray -t domain_all < <(find /usr/local/lsws/"$NAME"/html -type f -name 'wp-config.php')
  
  for entry in "${domain_all[@]}"; do
    path=$(echo "$entry" | sed 's/\/wp-config.php//g')

    thumuc=$(echo "$path" | cut -f7 -d '/')
    if [[ -z "$thumuc" ]]; then
      continue
    fi

    if [[ -f "$path/wp-config.php" ]]; then
      # ==============================================================================
      # [BẢO MẬT] XỬ LÝ DUMP DB SUBFOLDER QUA REGEX VÀ TMP ROOT
      # ==============================================================================
      unset DB_Password_web DB_User_web DB_Name_web
      wp_config_file_sub="$path/wp-config.php"

      DB_User_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_USER['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_USER['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
      DB_Password_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_PASSWORD['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_PASSWORD['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
      DB_Name_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_NAME['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_NAME['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")

      if [[ -z "$DB_User_web" || -z "$DB_Password_web" || -z "$DB_Name_web" ]]; then
        continue
      fi

      TEMP_CNF=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
      chmod 600 "$TEMP_CNF" 
      
      cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${DB_Password_web}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
      trap "rm -f ${TEMP_CNF}" EXIT

      SAFE_DUMP_FILE_SUB="/etc/wptt/tmp/sub_${thumuc}_giatuan_wptangtoc.sql"
      rm -f "$SAFE_DUMP_FILE_SUB"
      
      if ! mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" > "$SAFE_DUMP_FILE_SUB"; then
        rm -f "$SAFE_DUMP_FILE_SUB" "${TEMP_CNF:?}"
        continue
      fi
      rm -f "${TEMP_CNF:?}"
      
      if [[ ! -s "$SAFE_DUMP_FILE_SUB" ]]; then
        rm -f "$SAFE_DUMP_FILE_SUB"
        continue
      fi
      
      rm -f "${path:?}/giatuan-wptangtoc.sql"
      cp "$SAFE_DUMP_FILE_SUB" "${path}/giatuan-wptangtoc.sql"
      
      # [BẢO MẬT TỐI ĐA] Khóa chặt quyền 600 Root
      chown root:root "${path}/giatuan-wptangtoc.sql" 2>/dev/null
      chmod 600 "${path}/giatuan-wptangtoc.sql" 2>/dev/null
      
      rm -f "$SAFE_DUMP_FILE_SUB"
      
      echo "$thumuc" >> "$SAFE_SUB_TXT"
      # ==============================================================================
    fi
  done
  
  if [[ -f "$SAFE_SUB_TXT" ]]; then
    cp "$SAFE_SUB_TXT" "/usr/local/lsws/$NAME/html/subfolder-wptt.txt"
    chown root:root "/usr/local/lsws/$NAME/html/subfolder-wptt.txt" 2>/dev/null
    chmod 600 "/usr/local/lsws/$NAME/html/subfolder-wptt.txt" 2>/dev/null
    rm -f "$SAFE_SUB_TXT"
  fi
done

missing_tools='rsync'
if ! command -v "$missing_tools" &>/dev/null; then
  if [ -f /etc/redhat-release ]; then 
    dnf install -y epel-release
    dnf install -y "${missing_tools}"
  elif [ -f /etc/debian_version ]; then 
    apt-get update
    apt-get install -y "${missing_tools}"
  fi
fi

if command -v csf >/dev/null 2>&1; then
  csf -a "$IP" >/dev/null 2>&1
fi

echo "Chuyển toàn bộ website bằng rsync all cho $IP : $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

# =================================================================
# Thực thi Rsync kèm mảng Exclude động đã được đúc ở trên
# =================================================================

echo -e "${C_CYAN}Vui lòng nhập mật khẩu SSH của Server đích khi được hỏi.${C_RESET}\n"

# ==============================================================================
# [ĐỒNG BỘ TUYỆT HẢO - ZERO-DOWNTIME MIGRATION]
# Sử dụng tham số --delete để ép Server Mới trở thành bản sao (Mirror) 100% của Server Cũ.
# Ở các lần Rsync vét data (Delta Sync), những file rác hoặc file đã bị xóa ở Server Cũ 
# sẽ bị quét sạch khỏi Server Mới. Đảm bảo dung lượng tối ưu và không bỏ sót file thừa.
# Rất hữu ích cho kịch bản khách hàng trỏ DNS sau, web vừa chạy vừa chuyển dữ liệu.
# ==============================================================================
rsync -avzh --delete "${RSYNC_EXCLUDES[@]}" -e "ssh -p $Port -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null" "${RSYNC_domain_all[@]}" root@"$IP":/usr/local/lsws

# [BẢN VÁ] Bẫy lỗi Rsync nếu sai pass hoặc rớt mạng
if [[ $? -ne 0 ]]; then
  echo -e "\n${C_RED}❌ LỖI NGHIÊM TRỌNG: Quá trình truyền tải Rsync thất bại!${C_RESET}"
  echo -e "${C_YELLOW}Nguyên nhân có thể do: Sai mật khẩu SSH, Port $Port bị chặn, hoặc rớt mạng.${C_RESET}"
  echo -e "Vui lòng kiểm tra lại thông tin Server đích và chạy lại lệnh.\n"
  
  rm -f /usr/local/lsws/"${Website_chinh:-}"/html/danh-sach-website-wptangtoc-ols.txt 2>/dev/null
  for d in "${RSYNC_domain_all[@]}"; do
    find "$d/html" -name "giatuan-wptangtoc.sql" -type f -delete 2>/dev/null
  done
  
  echo -en "${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r _
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
  exit 1
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT QUÁ TRÌNH TRUYỀN TẢI DỮ LIỆU${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Dữ liệu đã được nén và đẩy sang máy chủ đích ($IP)." 2
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}CÔNG VIỆC CẦN LÀM TIẾP THEO:${C_RESET}" 2
left_text "  1. Đăng nhập vào Server MỚI ($IP)." 2
left_text "  2. Truy cập Menu WPTangToc OLS." 2
left_text "  3. Chọn mục: ${C_YELLOW}Chuyển website (27)${C_RESET} ➜ ${C_YELLOW}GET nhận (4)${C_RESET}." 2
left_text "  4. Chờ hệ thống tự động Import Toàn Bộ Website." 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -en "${C_GREEN}Xác nhận bên Server mới đã thực thi lệnh GET xong: Nhấn phím [Enter]${C_RESET}"
read -r _

# Dọn dẹp rác sau khi Rsync thành công
rm -f /usr/local/lsws/"${Website_chinh:-}"/html/danh-sach-website-wptangtoc-ols.txt 2>/dev/null
for d in "${RSYNC_domain_all[@]}"; do
  find "$d/html" -name "giatuan-wptangtoc.sql" -type f -delete 2>/dev/null
  find "$d/html" -name "subfolder-wptt.txt" -type f -delete 2>/dev/null
done

# =================================================================
# [MODULE MỚI] GHOST MIGRATION - CẤU HÌNH PROXY HÀNG LOẠT (NATIVE 443 + FAIL-SAFE)
# =================================================================
echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BƯỚC CHUYỂN GIAO: KÍCH HOẠT GHOST MIGRATION (PROXY NGƯỢC)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}TẠI SAO BẠN NÊN BẬT TÍNH NĂNG NÀY?${C_RESET}" 2
left_text "1. Chống rớt đơn: Mạng Internet (WiFi, 4G) cần 2-24h để cập nhật DNS mới." 2
left_text "   Proxy sẽ bẻ lái khách đi lạc ở IP cũ sang Server MỚI ngay lập tức." 2
left_text "2. Quay xe khẩn cấp: Nếu website trên Server MỚI gặp lỗi bất ngờ, bạn" 2
left_text "   chỉ cần TẮT Proxy, website sẽ lập tức chạy lại bằng dữ liệu an toàn" 2
left_text "   đang có trên Server CŨ này (như chưa hề có cuộc chia chân)!" 2
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}HƯỚNG DẪN TẮT / GỠ BỎ PROXY:${C_RESET}" 2
left_text "- Khi muốn QUAY XE do lỗi, hoặc khi DNS ĐÃ CẬP NHẬT XONG (sau 24h)." 2
left_text "- Vào Menu: ${C_YELLOW}Add-ons ➜ Thiết lập Proxy ngược${C_RESET} ➜ Chọn tên miền và GỠ BỎ." 2
left_text "- Lưu ý: Chỉ xóa các website ở máy chủ CŨ này khi mọi thứ đã chạy hoàn hảo." 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if wptt_xac_nhan "Server MỚI đã nhận TẤT CẢ dữ liệu xong chưa? Bật Proxy ngay bây giờ?" "Traffic của toàn bộ website sẽ chuyển hướng sang $IP (Mã hóa SSL 443)." "" "Đã xong - Bật Proxy" "Bỏ qua"; then
  
  _runing "Đang nạp chứng chỉ và thiết lập Động cơ Bóng ma (Port 443) cho TOÀN BỘ WEBSITE..."

  proxy_success_count=0

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}" 
    domain="${domain%.conf}" 
    domain="${domain#.}"     

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi

    if ! echo -n | openssl s_client -connect "$IP:443" -servername "$domain" -showcerts 2>/dev/null | openssl x509 -outform PEM > "/etc/pki/ca-trust/source/anchors/${domain}_wptt_proxy.crt" 2>/dev/null; then
      echo -e "${C_YELLOW}CẢNH BÁO: Lấy chứng chỉ TLS cho $domain thất bại! (Port 443 bị chặn hoặc chưa sẵn sàng). Bỏ qua Proxy cho tên miền này.${C_RESET}"
      rm -f "/etc/pki/ca-trust/source/anchors/${domain}_wptt_proxy.crt"
      continue 
    fi

    sed -i -e "/^extprocessor ${domain}proxy {/,/^}$/d" /usr/local/lsws/conf/httpd_config.conf
    
    echo "
extprocessor ${domain}proxy {
  type                    proxy
  address                 https://$IP:443
  maxConns                2000
  initTimeout             90
  retryTimeout            20
  respBuffer              0
  secure                  1
}
" >>/usr/local/lsws/conf/httpd_config.conf

    HTACCESS_FILE="/usr/local/lsws/$domain/html/.htaccess"
    if [[ -d "/usr/local/lsws/$domain/html" ]]; then
      if [[ -L "$HTACCESS_FILE" ]]; then rm -f "$HTACCESS_FILE"; fi
      
      touch "$HTACCESS_FILE"
      sed -i -e '/^#begin-proxy-wptangtoc/,/^#end-proxy-wptangtoc$/d' "$HTACCESS_FILE" 
      
      TMP_PROXY=$(mktemp)
      cat <<EOF > "$TMP_PROXY"
#begin-proxy-wptangtoc
RewriteCond %{REQUEST_URI} !.*well-known.*\$ [NC]
RewriteRule ^(.*)\$ https://${domain}proxy/\$1 [P,L,E=PROXY-HOST:${domain}]
#end-proxy-wptangtoc
EOF
      
      cat "$HTACCESS_FILE" >> "$TMP_PROXY"
      cat "$TMP_PROXY" > "$HTACCESS_FILE"
      rm -f "$TMP_PROXY"
      
      owner_group=$(stat -c '%U:%G' "/usr/local/lsws/$domain/html" 2>/dev/null)
      chown "$owner_group" "$HTACCESS_FILE" 2>/dev/null
    fi
    ((proxy_success_count++))
  done

  if [[ $proxy_success_count -gt 0 ]]; then
    update-ca-trust

    _runing "Đang khởi động lại dịch vụ OpenLiteSpeed..."
    wptt_smart_reload_lsws >/dev/null 2>&1
    
    _rundone "Cửa nôm (Ghost Proxy - Secure End-to-End) đã được kích hoạt thành công cho $proxy_success_count website!"
    echo -e "\n${C_GREEN}Các website thành công hiện đang hoạt động như các Trạm trung chuyển.${C_RESET}"
    echo -e "${C_YELLOW}Bây giờ bạn có thể thong thả trỏ IP DNS về máy chủ mới mà không sợ rớt đơn hàng!${C_RESET}\n"
    
    echo -e "${C_RED}LƯU Ý QUAN TRỌNG: KHÔNG ĐƯỢC xóa các website ở máy chủ cũ ngay bây giờ!${C_RESET}"
    echo -e "${C_RED}Hãy chờ an toàn ít nhất 24h để DNS thế giới cập nhật hết sang IP mới rồi mới tiến hành xóa.${C_RESET}\n"
  else
    echo -e "\n${C_RED}❌ LỖI: Không thể thiết lập Proxy cho bất kỳ website nào do lỗi kết nối hoặc chứng chỉ!${C_RESET}"
    echo -e "${C_YELLOW}Toàn bộ website ở máy chủ cũ vẫn hoạt động độc lập bình thường.${C_RESET}\n"
  fi

else
  echo -e "\n${C_YELLOW}Đã bỏ qua thiết lập Ghost Proxy.${C_RESET}"
  echo -e "Toàn bộ website ở máy chủ cũ vẫn hoạt động độc lập bình thường.\n"
fi

echo -en "${C_GREEN}Nhấn phím [Enter] để kết thúc...${C_RESET}"
read -r _
[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
