#!/bin/bash

function huong_dan() {
  rsync là một công cụ mạnh mẽ và linh hoạt dùng để đồng bộ hóa [synchronize] và truyền tải [transfer] file/thư mục giữa các máy tính/máy chủ. Khi nói về chuyển website rsync tự động hóa quá trình sao chép dữ liệu website từ một nơi này sang một nơi khác [ví dụ: từ server phát triển sang server sản phẩm, hoặc để sao lưu website].

  Tính năng này chỉ chuyển từ server nguồn đang dùng [wptangtoc ols] sang hệ thống đích cũng đang wptantoc ols
  Bạn thực thi menu server nguồn bắt đầu sử dụng tính năng

  Các tính năng nổi bật khi dùng rsync để chuyển website:

  Đồng bộ hóa thông minh: rsync chỉ sao chép những phần file đã thay đổi hoặc những file mới, giúp tiết kiệm băng thông và thời gian so với việc sao chép toàn bộ.
  * Hiệu quả và Nhanh chóng: Nhờ thuật toán delta-transfer, rsync truyền dữ liệu rất hiệu quả.
  * Bảo toàn thuộc tính file: rsync có thể giữ nguyên các thuộc tính của file như quyền truy cập, thời gian sửa đổi, v.v.
  * Bảo mật: Có thể truyền dữ liệu qua các kênh mã hóa như SSH để đảm bảo an toàn.
  * Nén dữ liệu: rsync hỗ trợ nén dữ liệu trong quá trình truyền để giảm dung lượng và tăng tốc độ.
  * Linh hoạt: Nhiều tùy chọn cấu hình cho phép bạn tùy chỉnh quá trình đồng bộ hóa theo nhu cầu cụ thể.
  Nói tóm lại, sử dụng rsync để tự động hóa việc chuyển website giúp đảm bảo dữ liệu luôn được cập nhật, tiết kiệm thời gian quản trị và giảm thiểu rủi ro lỗi do con người. Rất phù hợp với mã nguồn lớn
}

. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHUYỂN WEBSITE ➜ Đóng gói 1 website & Rsync sang Server mới${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

. /etc/wptt/tenmien-only-website-by-wordpress #chỉ support website WordPress
lua_chon_NAME "Rsync chuyển đi"

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-chuyen-web-main 1
  fi
  return 2>/dev/null
  exit
fi

. /etc/wptt/echo-color

while true; do
  echo -en "${C_CYAN}Nhập địa chỉ IP Server mới [0=Thoát]: ${C_RESET}"
  read -r IP
  [[ "$IP" == "0" || -z "$IP" ]] && {
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
    exit 0
  }

  # Clean IP
  IP="${IP//[[:space:]]/}"

  # Regex kiểm tra IPv4 & IPv6
  is_ipv4=$(echo "$IP" | grep -E -o '^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$')
  is_ipv6=$(echo "$IP" | grep -oE '\b([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b|\b([0-9a-fA-F]{1,4}:){1,7}:\b|::1')

  if [[ -n "$is_ipv4" || -n "$is_ipv6" ]]; then
    break
  else
    echo -e "${C_RED}Lỗi: Định dạng IP không hợp lệ! Vui lòng nhập lại.${C_RESET}"
  fi
done

echo -en "${C_CYAN}Nhập Port SSH Server mới [Mặc định: 22]: ${C_RESET}"
read -r Port
Port=${Port:-22}
if ! [[ "$Port" =~ ^[0-9]+$ ]]; then
  echo -e "${C_RED}Lỗi: Port phải là số!${C_RESET}"
  exit 1
fi

. /etc/wptt/.wptt.conf

# Đảm bảo két sắt tmp luôn tồn tại
mkdir -p /etc/wptt/tmp
chmod 755 /etc/wptt/tmp

path="/usr/local/lsws/$NAME/html"

_runing "Sao lưu database website $NAME"

# ==============================================================================
# [BẢO MẬT]: CHỈ DÙNG REGEX ĐỌC TEXT PURE. CẤM WP-CLI
# ==============================================================================
unset DB_Password_web DB_User_web DB_Name_web
wp_config_file="$path/wp-config.php"

if [[ -f "$wp_config_file" ]]; then
  DB_User_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_USER['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_USER['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
  DB_Password_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_PASSWORD['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_PASSWORD['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
  DB_Name_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_NAME['\"]" "$wp_config_file" | head -n 1 | sed -E "s/.*['\"]DB_NAME['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
fi

if [[ -z "$DB_User_web" || -z "$DB_Name_web" ]]; then
  echo "Không xác định được tài khoản database trong wp-config.php"
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-chuyen-web-main 1
  fi
  return 2>/dev/null
  exit
fi
# ==============================================================================

password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web" 

TEMP_CNF=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF" 

cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
trap "rm -f ${TEMP_CNF}" EXIT

# ==============================================================================
# [BẢO MẬT & TỐI ƯU]: DUMP VÀO KÉT SẮT VÀ BẮT LỖI BẰNG EXIT CODE
# ==============================================================================
SAFE_DUMP_FILE="/etc/wptt/tmp/${NAME}_giatuan_wptangtoc.sql"
SAFE_TXT_FILE="/etc/wptt/tmp/danh-sach-${NAME}.txt"
rm -f "$SAFE_DUMP_FILE" "$SAFE_TXT_FILE"

# Thực thi và bắt lỗi trực tiếp
if ! mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" > "$SAFE_DUMP_FILE"; then
  _runloi "Sao lưu database website $NAME (Lỗi thực thi lệnh)"
  rm -f "$SAFE_DUMP_FILE" "${TEMP_CNF:?}"
  exit 1
fi
rm -f "${TEMP_CNF:?}"

# Check file rỗng bằng hàm chuẩn Bash
if [[ ! -s "$SAFE_DUMP_FILE" ]]; then
  _runloi "Sao lưu database website $NAME (Lỗi file rỗng)"
  rm -f "$SAFE_DUMP_FILE"
  exit 1
fi

# Chép qua thư mục đích
rm -f "${path}/giatuan-wptangtoc.sql" "${path}/danh-sach-website-wptangtoc-ols.txt"

cp "$SAFE_DUMP_FILE" "${path}/giatuan-wptangtoc.sql"

# Tạo file txt ở Két sắt rồi copy sang
echo "$NAME" > "$SAFE_TXT_FILE"
cp "$SAFE_TXT_FILE" "${path}/danh-sach-website-wptangtoc-ols.txt"

# [BẢO MẬT TỐI ĐA] Khóa chặt bằng quyền Root 600 chống sửa lén
chown root:root "${path}/giatuan-wptangtoc.sql" "${path}/danh-sach-website-wptangtoc-ols.txt" 2>/dev/null
chmod 600 "${path}/giatuan-wptangtoc.sql" "${path}/danh-sach-website-wptangtoc-ols.txt" 2>/dev/null

rm -f "$SAFE_DUMP_FILE" "$SAFE_TXT_FILE"
_rundone "Sao lưu database website $NAME"
# ==============================================================================

#subfolder backup database
if [[ -d /etc/wptt/$NAME-wptt ]]; then
  rm -f /usr/local/lsws/"${NAME:?}"/html/subfolder-wptt.txt
  SAFE_SUB_TXT="/etc/wptt/tmp/subfolder-${NAME}.txt"
  rm -f "$SAFE_SUB_TXT"

  domain_all=()
  readarray -t domain_all < <(find /usr/local/lsws/"$NAME"/html -type f -name 'wp-config.php')
  
  for entry in "${domain_all[@]}"; do
    path_sub=$(echo "$entry" | sed 's/\/wp-config.php//g')
    i=1

    thumuc=$(echo "$path_sub" | cut -f7 -d '/')
    if [[ -z "$thumuc" ]]; then
      continue
    fi

    if [[ -f "$path_sub/wp-config.php" ]]; then
      
      unset DB_Password_web DB_User_web DB_Name_web
      wp_config_file_sub="$path_sub/wp-config.php"

      DB_User_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_USER['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_USER['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
      DB_Password_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_PASSWORD['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_PASSWORD['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")
      DB_Name_web=$(grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]DB_NAME['\"]" "$wp_config_file_sub" | head -n 1 | sed -E "s/.*['\"]DB_NAME['\"][[:space:]]*,[[:space:]]*['\"](.*)['\"][[:space:]]*\).*/\1/")

      if [[ -z "$DB_User_web" || -z "$DB_Password_web" || -z "$DB_Name_web" ]]; then
        continue
      fi

      TEMP_CNF_SUB=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
      chmod 600 "$TEMP_CNF_SUB" 
      
      cat >"$TEMP_CNF_SUB" <<EOF
[client]
user=${DB_User_web}
password=${DB_Password_web}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
      trap "rm -f ${TEMP_CNF_SUB}" EXIT

      SAFE_DUMP_FILE_SUB="/etc/wptt/tmp/sub_${thumuc}_giatuan_wptangtoc.sql"
      rm -f "$SAFE_DUMP_FILE_SUB"
      
      if ! mariadb-dump --defaults-extra-file="$TEMP_CNF_SUB" "$DB_Name_web" > "$SAFE_DUMP_FILE_SUB"; then
        rm -f "$SAFE_DUMP_FILE_SUB" "${TEMP_CNF_SUB:?}"
        continue
      fi
      rm -f "${TEMP_CNF_SUB:?}"
      
      if [[ ! -s "$SAFE_DUMP_FILE_SUB" ]]; then
        rm -f "$SAFE_DUMP_FILE_SUB"
        continue
      fi
      
      rm -f "${path_sub:?}/giatuan-wptangtoc.sql"
      cp "$SAFE_DUMP_FILE_SUB" "${path_sub}/giatuan-wptangtoc.sql"
      
      # Khóa quyền root
      chown root:root "${path_sub}/giatuan-wptangtoc.sql" 2>/dev/null
      chmod 600 "${path_sub}/giatuan-wptangtoc.sql" 2>/dev/null
      
      rm -f "$SAFE_DUMP_FILE_SUB"

      echo "$thumuc" >> "$SAFE_SUB_TXT"
    fi
  done
  
  if [[ -f "$SAFE_SUB_TXT" ]]; then
    cp "$SAFE_SUB_TXT" "/usr/local/lsws/${NAME}/html/subfolder-wptt.txt"
    chown root:root "/usr/local/lsws/${NAME}/html/subfolder-wptt.txt" 2>/dev/null
    chmod 600 "/usr/local/lsws/${NAME}/html/subfolder-wptt.txt" 2>/dev/null
    rm -f "$SAFE_SUB_TXT"
  fi
fi

missing_tools='rsync'
if ! command -v "$missing_tools" &>/dev/null; then
  if [ -f /etc/redhat-release ]; then 
    dnf install -y epel-release
    dnf install -y "${missing_tools}"
  elif [ -f /etc/debian_version ]; then 
    apt-get update
    apt-get install -y "${missing_tools}"
  fi
fi

if command -v csf >/dev/null 2>&1; then
  csf -a "$IP" >/dev/null 2>&1
fi

RSYNC_EXCLUDES=(
  "--exclude=/$NAME/bin"
  "--exclude=/$NAME/sbin"
  "--exclude=/$NAME/lib"
  "--exclude=/$NAME/lib64"
  "--exclude=/$NAME/usr"
  "--exclude=/$NAME/dev"
  "--exclude=/$NAME/etc"
  "--exclude=/$NAME/tmp"
  "--exclude=/$NAME/var"
  "--exclude=/$NAME/passwd"
  "--exclude=/$NAME/wptt_tmp"
  "--exclude=/$NAME/html/phpmyadmin"
  "--exclude=/$NAME/html/quan-ly-files"
  "--exclude=/$NAME/.cron_spool"
  "--exclude=/$NAME/.bash*"
  "--exclude=/$NAME/.lsns"
  "--exclude=/$NAME/luucache"
  "--exclude=/$NAME/logs"
  "--exclude=/$NAME/backup-website"
)

echo "Chuyển website rsync only website $NAME vào $IP: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

echo -e "${C_CYAN}Vui lòng nhập mật khẩu SSH của Server đích khi được hỏi.${C_RESET}\n"

# [MIRROR SYNC] Thêm --delete để xóa file thừa ở đích, hỗ trợ đồng bộ vét data (Zero-Downtime) hoàn hảo.
rsync -avzh --delete-delay "${RSYNC_EXCLUDES[@]}" -e "ssh -p $Port -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null" /usr/local/lsws/"${NAME:?}" root@"$IP":/usr/local/lsws

if [[ $? -ne 0 ]]; then
  echo -e "\n${C_RED}❌ LỖI NGHIÊM TRỌNG: Quá trình truyền tải Rsync thất bại!${C_RESET}"
  echo -e "${C_YELLOW}Nguyên nhân có thể do: Sai mật khẩu SSH, Port $Port bị chặn, hoặc rớt mạng.${C_RESET}"
  echo -e "Vui lòng kiểm tra lại thông tin Server đích và chạy lại lệnh.\n"
  
  rm -f /usr/local/lsws/"${NAME:?}"/html/danh-sach-website-wptangtoc-ols.txt
  rm -f "${path:?}/giatuan-wptangtoc.sql"
  
  echo -en "${C_GREEN}Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
  read -r _
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
  exit 1
fi

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT QUÁ TRÌNH TRUYỀN TẢI DỮ LIỆU${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Dữ liệu đã được nén và đẩy sang máy chủ đích ($IP)." 2
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}CÔNG VIỆC CẦN LÀM TIẾP THEO:${C_RESET}" 2
left_text "  1. Đăng nhập vào Server MỚI ($IP)." 2
left_text "  2. Truy cập Menu WPTangToc OLS." 2
left_text "  3. Chọn mục: ${C_YELLOW}Chuyển website (27)${C_RESET} ➜ ${C_YELLOW}GET nhận Rsync (4)${C_RESET}." 2
left_text "  4. Chờ hệ thống tự động Import." 2
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

echo -en "${C_GREEN}Xác nhận bên Server mới đã thực thi lệnh trên xong: Nhấn phím [Enter]${C_RESET}"
read -r _

rm -f /usr/local/lsws/"${NAME:?}"/html/danh-sach-website-wptangtoc-ols.txt
rm -f "${path:?}/giatuan-wptangtoc.sql"

# =================================================================
# CẤU HÌNH PROXY SAU KHI CHUYỂN (GHOST MIGRATION)
# =================================================================
echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}BƯỚC CHUYỂN GIAO: KÍCH HOẠT GHOST MIGRATION (PROXY NGƯỢC)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}TẠI SAO BẠN NÊN BẬT TÍNH NĂNG NÀY?${C_RESET}" 2
left_text "1. Chống rớt đơn: Mạng Internet (WiFi, 4G) cần 2-24h để cập nhật DNS mới." 2
left_text "   Proxy sẽ bẻ lái khách đi lạc ở IP cũ sang Server MỚI ngay lập tức." 2
left_text "2. Quay xe khẩn cấp: Nếu website trên Server MỚI gặp lỗi bất ngờ, bạn" 2
left_text "   chỉ cần TẮT Proxy, website sẽ lập tức chạy lại bằng dữ liệu an toàn" 2
left_text "   đang có trên Server CŨ này (như chưa hề có cuộc chia chân)!" 2
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_BOLD_WHITE}HƯỚNG DẪN TẮT / GỠ BỎ PROXY:${C_RESET}" 2
left_text "- Khi muốn QUAY XE do lỗi, hoặc khi DNS ĐÃ CẬP NHẬT XONG (sau 24h)." 2
left_text "- Vào Menu: ${C_YELLOW}Add-ons ➜ Thiết lập Proxy ngược${C_RESET} ➜ Chọn tên miền và GỠ BỎ." 2
left_text "- Lưu ý: Chỉ xóa website ở máy chủ CŨ này khi mọi thứ đã chạy hoàn hảo." 2
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if wptt_xac_nhan "Server MỚI đã nhận dữ liệu thành công chưa? Bật Proxy ngay bây giờ?" "Traffic của $NAME sẽ chuyển hướng sang $IP (Mã hóa SSL 443)." "" "Đã xong - Bật Proxy" "Bỏ qua"; then
  
  _runing "Đang nạp chứng chỉ tự ký từ máy chủ đích vào kho tin cậy..."

  if ! echo -n | openssl s_client -connect "$IP:443" -servername "$NAME" -showcerts 2>/dev/null | openssl x509 -outform PEM > "/etc/pki/ca-trust/source/anchors/${NAME}_wptt_proxy.crt" 2>/dev/null; then
    
    _runloi "Lấy chứng chỉ TLS thất bại! (Port 443 đích có thể bị chặn hoặc chưa sẵn sàng)"
    echo -e "${C_YELLOW}CẢNH BÁO: Đã HỦY quá trình cấu hình Proxy ngược để đảm bảo an toàn cho website.${C_RESET}"
    
    rm -f "/etc/pki/ca-trust/source/anchors/${NAME}_wptt_proxy.crt"
    SKIP_DELETE=0
    
  else
    update-ca-trust
    _rundone "Nạp chứng chỉ hoàn tất! Máy chủ đã tin tưởng Server đích."
    _runing "Đang thiết lập Động Ghost Proxy (Port 443) cho $NAME..."

    sed -i -e "/^extprocessor ${NAME}proxy {/,/^}$/d" /usr/local/lsws/conf/httpd_config.conf
    
    echo "
extprocessor ${NAME}proxy {
  type                    proxy
  address                 https://$IP:443
  maxConns                2000
  initTimeout             90
  retryTimeout            20
  respBuffer              0
  secure                  1
}
" >>/usr/local/lsws/conf/httpd_config.conf

    HTACCESS_FILE="/usr/local/lsws/$NAME/html/.htaccess"
    if [[ -d "/usr/local/lsws/$NAME/html" ]]; then
      if [[ -L "$HTACCESS_FILE" ]]; then rm -f "$HTACCESS_FILE"; fi
      
      touch "$HTACCESS_FILE"
      
      sed -i -e '/^#begin-proxy-wptangtoc/,/^#end-proxy-wptangtoc$/d' "$HTACCESS_FILE"
      
      TMP_PROXY=$(mktemp)
      cat <<EOF > "$TMP_PROXY"
#begin-proxy-wptangtoc
RewriteCond %{REQUEST_URI} !.*well-known.*\$ [NC]
RewriteRule ^(.*)\$ https://${NAME}proxy/\$1 [P,L,E=PROXY-HOST:${NAME}]
#end-proxy-wptangtoc
EOF
      
      cat "$HTACCESS_FILE" >> "$TMP_PROXY"
      cat "$TMP_PROXY" > "$HTACCESS_FILE"
      rm -f "$TMP_PROXY"
      
      owner_group=$(stat -c '%U:%G' "/usr/local/lsws/$NAME/html" 2>/dev/null)
      chown "$owner_group" "$HTACCESS_FILE" 2>/dev/null
    fi

    _runing "Đang khởi động lại dịch vụ OpenLiteSpeed..."
    wptt_smart_reload_lsws >/dev/null 2>&1
    
    _rundone "Ghost Proxy (Secure End-to-End) đã được kích hoạt thành công!"
    echo -e "\n${C_GREEN}Website $NAME hiện đang hoạt động như một Trạm trung chuyển.${C_RESET}"
    echo -e "${C_YELLOW}Bây giờ bạn có thể trỏ IP DNS về máy chủ mới mà không sợ rớt đơn hàng!${C_RESET}\n"
    
    echo -e "${C_RED}LƯU Ý QUAN TRỌNG: KHÔNG ĐƯỢC xóa website này ở máy chủ cũ ngay bây giờ!${C_RESET}"
    echo -e "${C_RED}Hãy chờ an toàn ít nhất 24h để DNS thế giới cập nhật hết sang IP mới rồi mới tiến hành xóa web.${C_RESET}\n"
    
    SKIP_DELETE=1
  fi

else
  echo -e "\n${C_YELLOW}Đã bỏ qua thiết lập Ghost Proxy.${C_RESET}"
  echo -e "Website ở máy chủ cũ vẫn hoạt động độc lập bình thường.\n"
  
  SKIP_DELETE=0
fi

if [[ "${SKIP_DELETE:-0}" == "0" ]]; then
  if wptt_xac_nhan "Bạn có muốn XOÁ website $NAME này trên máy chủ CŨ này không?" "Lưu ý: Hành động này sẽ xóa toàn bộ mã nguồn và Database của $NAME." "" "Đồng ý Xóa" "Giữ lại"; then
    . /etc/wptt/domain/wptt-xoa-website "$NAME"
  fi
fi

if [[ "${1:-}" == "98" ]];then
	echo -en "${C_GREEN}Nhấn phím [Enter] để quay lại menu Chuyển Website...${C_RESET}"
	read -r _
	exec /etc/wptt/wptt-chuyen-web-main 1
fi
