#!/bin/bash
. /etc/wptt/echo-color
read -rp "Nhập địa chỉ IP server mới: [0=Thoát] " IP
if [[ "$IP" = "0" || -z "$IP" ]]; then
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-chuyen-web-main 1
  fi
  return 2>/dev/null
  exit
fi

error_block_ipv4='1'
error_block_ipv6='1'
if [[ -n $(echo "$IP" | grep -E -o '(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)') ]]; then #kiểm tra có phải ipv4 không
  error_block_ipv4='0'
fi


if [[ -n $(echo "$IP" | grep -xE '([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])') ]]; then
      error_block_ipv6='0'
fi


if [[ "$error_block_ipv6" = '1' && "$error_block_ipv4" = '1' ]]; then
  echoDo "Bạn không nhập đúng định dạng IP"
  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    exec /etc/wptt/wptt-chuyen-web-main 1
  fi
  return 2>/dev/null
  exit
fi

read -rp "Nhập Port SSH Server mới: " Port
# check điều kiện số tự nhiên port
if [[ ! $Port =~ ^-?[0-9]+$ ]]; then
  clear
  echoDo "Port không đúng định dạng, vui lòng nhập port là số tự nhiên"
  exit
fi

. /etc/wptt/.wptt.conf

if [ "$(ls -A /etc/wptt/vhost | grep -v '^\.\.conf$' | sort -uV)" ]; then
  rm -f /tmp/domain-rsync-move
	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}" #cắt hết / ở phía truớc chỉ dữ giá trị / ở sau còn dữ lại như: .wptangtoc.com.conf
		domain="${domain%.conf}" #cắt .conf ở phía sau => còn: .wptangtoc.com
		domain="${domain#.}" #cắt . ở phía truớc => còn wptangtoc.com

		if [[ "$domain" != ?*.?* ]]; then #yêu cầu phải có dấu . trong domain thì mới gọi là domain đúng, nếu không có . thì continue nhảy qua for 
			continue
		fi
    path="/usr/local/lsws/$domain/html"
    i=1
    if [[ -d "$path" ]]; then
      echo "/usr/local/lsws/$domain" >>/tmp/domain-rsync-move
    fi
  done
fi

list_ssl_domain_all=$(cat /tmp/domain-rsync-move | sort -u | uniq | sed '/^$/d' | sed 's/ $//g' | tr -s '\n' ' ')
if [[ $(which rsync) = '' ]]; then
  yum install rsync -y
fi

#cho ip vào danh sách trắng csf khi dùng csf
check_csf=$(which csf)
if [[ $check_csf ]]; then
  csf -a "$IP" >/dev/null 2>&1
fi

echo "Lệnh: rsync -avzh -e 'ssh -p $Port -o StrictHostKeyChecking=no' $list_ssl_domain_all root@$IP:/usr/local/lsws"
rsync -avzh -e "ssh -p $Port -o StrictHostKeyChecking=no" "$list_ssl_domain_all" root@"$IP":/usr/local/lsws
echo "Hoàn tất move mã nguồn qua ip $IP"
