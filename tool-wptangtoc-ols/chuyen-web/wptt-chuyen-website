#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng này chuyển website ngoài [Cpanel,plesk,Cyperpanel, AApanel, Larpvs,HocVPs,VPSSim... hệ thống cũ có terminal là được] chuyển về wptangtoc ols

  Tính năng Quản lý Chuyển Website [Website Migration] trong WPTangToc OLS là một tập hợp các công cụ và quy trình được thiết kế để giúp bạn di chuyển website [đặc biệt là WordPress] từ một nơi này sang nơi khác một cách dễ dàng và ít lỗi hơn. 🚚💨

  Giới thiệu ngắn gọn:
  Mục đích: Đơn giản hóa quá trình chuyển website giữa các máy chủ, từ nhà cung cấp này sang nhà cung cấp khác, hoặc từ môi trường phát triển [staging] lên máy chủ chính [production] và ngược lại.

  Lợi ích:
  * Giảm thiểu lỗi thủ công: Tự động hóa nhiều bước phức tạp trong quá trình di chuyển.
  * Tiết kiệm thời gian: Tăng tốc độ di chuyển website so với việc làm thủ công hoàn toàn.
  * Đảm bảo tính toàn vẹn: Giúp di chuyển đầy đủ cả tệp tin và cơ sở dữ liệu một cách nhất quán.
  * Thuận tiện: Cung cấp một quy trình tích hợp ngay trong công cụ quản lý máy chủ quen thuộc.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện UX Bo Cong

NAME=${1:-}
all_for=${2:-}
[[ "$NAME" == "98" ]] && NAME=""

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHUYỂN WEBSITE ➜ Kéo Website từ Panel khác về WPTangToc OLS${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# 1. GỌI MENU CHỌN DOMAIN VÀ KIỂM TRA TỒN TẠI
# ==============================================================================
if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien 2>/dev/null
  echo -e "${C_YELLOW}Website (đã thêm vào Vhost hệ thống) mà bạn muốn chuyển dữ liệu về:${C_RESET}"
  lua_chon_NAME "chuyển dữ liệu về"
fi

[[ "$NAME" == "0" || -z "$NAME" ]] && exit 0

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  echo -e "\n${C_RED}Tên miền chưa được khởi tạo trên hệ thống! Vui lòng Thêm Website trước.${C_RESET}"
  sleep 3
  exit 1
fi

_runing "Đang kiểm tra phân giải DNS tên miền..."

checkdns=$(host "$NAME" 2>/dev/null | grep -Eo -m 1 '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
[[ -z "$checkdns" ]] && checkdns=$(nslookup "$NAME" 2>/dev/null | grep Address | tail -n1 | grep -Eo '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')

ip=$(curl -skf --connect-timeout 5 "https://ipv4.icanhazip.com" || curl -skf --connect-timeout 5 "https://checkip.amazonaws.com")
[[ -z "$ip" ]] && ip=$(curl -sk --connect-timeout 5 "https://ipv6.icanhazip.com")

if [[ "$checkdns" == "$ip" ]]; then
  _runloi "Tên miền đã trỏ về Server mới!"
  echo -e "\n${C_RED}Lỗi: DNS của tên miền $NAME đã trỏ về IP của máy chủ này ($ip).${C_RESET}"
  echo -e "${C_YELLOW}Tính năng này yêu cầu DNS phải đang trỏ về máy chủ cũ để có thể tải file qua HTTP!${C_RESET}"
  exit 1
elif [[ -z "$checkdns" ]]; then
  _runloi "Tên miền không tồn tại!"
  echo -e "\n${C_RED}Lỗi: Website $NAME không tồn tại hoặc không thể phân giải DNS trên Internet.${C_RESET}"
  exit 1
fi
_rundone "DNS hợp lệ (Trỏ về máy chủ CŨ: $checkdns)."

# ==============================================================================
# 3. HƯỚNG DẪN THAO TÁC TRÊN SERVER CŨ
# ==============================================================================
if [[ -z "$all_for" ]]; then
  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HƯỚNG DẪN THAO TÁC ĐÓNG GÓI DỮ LIỆU${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "  ${C_YELLOW}BƯỚC 1:${C_RESET} Mở Terminal (SSH) hay Terminal online trên máy chủ CŨ." 2
  left_text "  ${C_YELLOW}BƯỚC 2:${C_RESET} Dùng lệnh 'cd' truy cập vào thư mục chứa mã nguồn website." 2
  left_text "  ${C_YELLOW}BƯỚC 3:${C_RESET} Copy và dán lệnh dưới đây vào Terminal máy chủ cũ để chạy:" 2
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  center_text "${C_GREEN}curl -sO https://wptangtoc.com/share/wptt && bash wptt${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  if ! wptt_xac_nhan "Bạn đã chạy xong lệnh trên máy chủ CŨ chưa?" "Hệ thống sẽ tiến hành kéo File về ngay lập tức." "" "Đã Xong! Kéo dữ liệu về" "Hủy thao tác"; then
    exec /etc/wptt/wptt-chuyen-web-main 1
  fi
fi

# 3.5. THÁM BÁO DUNG LƯỢNG VÀ HTTP STATUS
_runing "Đo thám dung lượng & kết nối Server cũ..."
url_zip="http://$NAME/giatuan-wptangtoc.zip"
url_sql="http://$NAME/giatuan-wptangtoc.sql"

# Vừa lấy Headers Content-Length, vừa soi mã HTTP Code trả về
headers_zip=$(curl -sIL -w "\nHTTP_CODE:%{http_code}" --insecure --connect-timeout 10 "$url_zip")
headers_sql=$(curl -sIL -w "\nHTTP_CODE:%{http_code}" --insecure --connect-timeout 10 "$url_sql")

http_code_zip=$(echo "$headers_zip" | grep -i "^HTTP_CODE:" | tail -n 1 | cut -d':' -f2)
http_code_sql=$(echo "$headers_sql" | grep -i "^HTTP_CODE:" | tail -n 1 | cut -d':' -f2)

kiem_tra_loi_http() {
  local code="$1"
  local loai_file="$2"

  if [[ "$code" == "403" ]]; then
    _runloi "Lỗi 403 Forbidden: Tường lửa máy chủ cũ đã chặn tải $loai_file!"
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_RED}TƯỜNG LỬA CHẶN TRUY CẬP (HTTP 403)${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " Nguyên nhân: Tường lửa (WAF, ModSecurity, cPanel/Plesk) trên máy" 2
    left_text " chủ cũ của bạn đang cấu hình cấm truy cập hoặc cấm tải trực tiếp" 2
    left_text " các định dạng nhạy cảm như .zip và .sql qua trình duyệt/URL." 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text " ${C_GREEN}CÁCH KHẮC PHỤC:${C_RESET}" 2
    left_text " - Tạm tắt ModSecurity hoặc Firewall trên Panel của máy chủ cũ." 2
    left_text " - Hoặc tạm đổi tên file thành .txt (vd: giatuan-wptangtoc.txt)." 2
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

	flock -u 200 2>/dev/null
	exec 200>&- 2>/dev/null
	rm -f "$TEMP_CNF_ROOT" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null

    exit 1
  elif [[ "$code" == "404" ]]; then
    _runloi "Lỗi 404 Not Found: Không tìm thấy $loai_file trên máy chủ cũ!"
    echo -e "${C_YELLOW}Vui lòng kiểm tra lại xem lệnh đóng gói đã chạy thành công trên máy chủ cũ chưa.${C_RESET}"

	flock -u 200 2>/dev/null
	exec 200>&- 2>/dev/null
	rm -f "$TEMP_CNF_ROOT" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
	exit 1

  elif (( code >= 400 )); then
    _runloi "Lỗi HTTP $code: Không thể truy cập $loai_file trên máy chủ cũ!"

	flock -u 200 2>/dev/null
	exec 200>&- 2>/dev/null
	rm -f "$TEMP_CNF_ROOT" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
    exit 1
  elif [[ "$code" == "000" ]]; then
    _runloi "Lỗi Kết Nối (Timeout): Máy chủ cũ không phản hồi hoặc chặn Ping."

	flock -u 200 2>/dev/null
	exec 200>&- 2>/dev/null
	rm -f "$TEMP_CNF_ROOT" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
    exit 1
  fi
}

kiem_tra_loi_http "$http_code_sql" "Database (.sql)"
kiem_tra_loi_http "$http_code_zip" "Mã Nguồn (.zip)"

# Lấy thông số Size để Check Disk
size_zip=$(echo "$headers_zip" | grep -i "^content-length:" | tail -n 1 | awk '{print $2}' | tr -d '\r')
size_sql=$(echo "$headers_sql" | grep -i "^content-length:" | tail -n 1 | awk '{print $2}' | tr -d '\r')

[[ -z "$size_zip" ]] && size_zip=0
[[ -z "$size_sql" ]] && size_sql=0

if (( size_zip > 0 || size_sql > 0 )); then
    required_bytes=$(( size_zip * 4 + size_sql + 524288000 ))
    free_space_bytes=$(df -P -B1 /usr/local/lsws | awk 'NR==2 {print $4}')
    
    if (( free_space_bytes < required_bytes )); then
        _runloi "CẢNH BÁO: KHÔNG ĐỦ DUNG LƯỢNG Ổ CỨNG ĐỂ CHUYỂN WEB!"
        
        req_gb=$(awk "BEGIN {printf \"%.2f\", $required_bytes / 1073741824}")
        free_gb=$(awk "BEGIN {printf \"%.2f\", $free_space_bytes / 1073741824}")
        
        echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
        center_text "${C_RED}THÁM BÁO DUNG LƯỢNG (PRE-FLIGHT CHECK) THẤT BẠI${C_RESET}"
        echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        left_text " Máy chủ hiện tại chỉ còn trống : ${C_YELLOW}$free_gb GB${C_RESET}" 2
        left_text " Tiến trình chuyển web dự kiến cần: ${C_RED}$req_gb GB${C_RESET}" 2
        echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        left_text " ${C_GREEN}LỜI KHUYÊN:${C_RESET} Dung lượng VPS của bạn không đủ để chứa và bung nén" 2
        left_text " website này. Vui lòng ${C_YELLOW}NÂNG CẤP Ổ CỨNG (Upgrade Disk)${C_RESET} hoặc xóa bớt" 2
        left_text " dữ liệu rác trước khi tiến hành chuyển website để tránh sập MariaDB." 2
        echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

		flock -u 200 2>/dev/null
		exec 200>&- 2>/dev/null
		rm -f "$TEMP_CNF_ROOT" 2>/dev/null
		rm -f "$LOCK_FILE" 2>/dev/null
        exit 1

    fi
    
    req_mb=$(( required_bytes / 1024 / 1024 ))
    free_mb=$(( free_space_bytes / 1024 / 1024 ))
    _rundone "Kiểm tra DISK khả dụng để thực thi (Cần ${req_mb}MB | Trống ${free_mb}MB)."
else
    _runloi "Không thể đo lường trước dung lượng từ máy chủ cũ (Bỏ qua Pre-flight Check)."
fi

# ==============================================================================
# 4. DOWNLOAD BẢN SAO LƯU TỪ SERVER CŨ (GIAO DIỆN UX PRO)
# ==============================================================================
echo ""
_runing "Đang khởi tạo tiến trình Download..."
mkdir -p "/usr/local/backup-website/$NAME"
duong_dan_thu_muc="/usr/local/backup-website/$NAME/giatuan-wptangtoc.zip"
duong_dan_thu_muc_sql="/usr/local/backup-website/$NAME/giatuan-wptangtoc.sql"

rm -f "${duong_dan_thu_muc:?}"
rm -f "${duong_dan_thu_muc_sql:?}"
_rundone "Khởi tạo kết nối hoàn tất."

# Hàm tải file tích hợp Progress Bar thông minh (Đã ép chuẩn 85px)
tai_file_ux() {
  local url="$1"
  local output_file="$2"
  local file_name="$3"
  local size_bytes="$4"

  echo -e "   ${C_CYAN}➜ Đang tải: ${C_BOLD_WHITE}$file_name${C_RESET}"

  if command -v pv >/dev/null 2>&1; then
    if [[ -n "$size_bytes" && "$size_bytes" -gt 0 ]]; then
      curl -sL --insecure "$url" | pv -w 85 -W -p -e -r -b -a -s "$size_bytes" >"$output_file"
    else
      curl -sL --insecure "$url" | pv -w 85 -W -t -r -b -a >"$output_file"
    fi
  else
    curl -L --insecure -# "$url" -o "$output_file"
  fi
  echo ""
}

tai_file_ux "$url_sql" "$duong_dan_thu_muc_sql" "Database SQL" "$size_sql"

if head -n 10 "$duong_dan_thu_muc_sql" | grep -qiE "<html|<doctype html"; then
  _runloi "File SQL không hợp lệ hoặc chứa HTML rác!"
  rm -f "${duong_dan_thu_muc:?}" "${duong_dan_thu_muc_sql:?}"
  exit 1
fi

tai_file_ux "$url_zip" "$duong_dan_thu_muc" "Mã Nguồn ZIP" "$size_zip"

if ! unzip -tq "$duong_dan_thu_muc" >/dev/null 2>&1; then
  _runloi "File ZIP bị hỏng hoặc chứa mã HTML rác từ Firewall CDN/Cloudflare!"
  rm -f "${duong_dan_thu_muc:?}" "${duong_dan_thu_muc_sql:?}"
  exit 1
fi

if [[ ! -s "$duong_dan_thu_muc" || ! -s "$duong_dan_thu_muc_sql" ]]; then
  _runloi "Tải dữ liệu thất bại (File rỗng 0 byte)."
  exit 1
fi

_rundone "Tải thành công File SQL và Mã nguồn về thư mục Backup."

# ==============================================================================
# 5. KHÔI PHỤC DATABASE & MÃ NGUỒN (ATOMIC ZERO-DOWNTIME)
# ==============================================================================
. "/etc/wptt/vhost/.$NAME.conf" 2>/dev/null

LOCK_FILE="/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME}.lock"
exec 200>"$LOCK_FILE"

if ! flock -n 200; then
  echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}LỖI ĐỤNG ĐỘ TIẾN TRÌNH (LOCKING)${C_RESET}"
  echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Website $NAME đang được thao tác bởi một tiến trình Backup/Restore khác!"
  left_text "Vui lòng chờ tiến trình đó hoàn tất rồi thử lại để tránh hỏng dữ liệu."
  echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
  exit 1
fi

_runing "Đang nạp Database (Atomic Blue/Green)..."
password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF_ROOT"
cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user=${database_admin_username}
password=${password_database_root}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
EOF

cleanup_lock() {
    rm -f "$TEMP_CNF_ROOT" 2>/dev/null
    rm -f "$LOCK_FILE" 2>/dev/null
}
trap "cleanup_lock" EXIT

unset password_database_root database_admin_password

wptt_abort_db_injection() {
  _runloi "$1"
  sleep 2
  [[ "$2" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
  return 2>/dev/null || exit 1
}

[[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
[[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"

password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"
[[ "$password_database_website_giai_ma" =~ [[:space:]\'\"\`\\] ]] && wptt_abort_db_injection "Mật khẩu User Database chứa ký tự cấm!" "$1"

# BẬT CHẾ ĐỘ BẢO TRÌ (CHỐNG MẤT ĐƠN HÀNG)
if [[ -f /usr/local/lsws/"$NAME"/html/wp-load.php ]]; then
  MAINTENANCE_FILE="/usr/local/lsws/$NAME/html/.maintenance"
  unset bao_tri_restore_atomic
  LIST_PLUGIN_BAO_TRI="/etc/wptt/backup-restore/plugins-bao-tri.txt"

  if [[ -f "$MAINTENANCE_FILE" ]]; then
    grep -q "wptt_auto_maintenance" "$MAINTENANCE_FILE" 2>/dev/null && bao_tri_restore_atomic='1'
  else
    PLUGINS_DIR="/usr/local/lsws/$NAME/html/wp-content/plugins"
    while read -r plugin_name || [[ -n "$plugin_name" ]]; do
      plugin_name=$(echo "$plugin_name" | xargs)
      [[ -z "$plugin_name" || "$plugin_name" == \#* ]] && continue
      if [[ -d "$PLUGINS_DIR/$plugin_name" ]]; then
        echo '<?php $upgrading = time(); // wptt_auto_maintenance ?>' >"$MAINTENANCE_FILE"
        chown "$User_name_vhost":"$User_name_vhost" "$MAINTENANCE_FILE" 2>/dev/null
        bao_tri_restore_atomic='1'
        break
      fi
    done <"$LIST_PLUGIN_BAO_TRI"
  fi
fi

# ATOMIC BLUE/GREEN DATABASE SWAP
DB_TEMP="${DB_Name_web}_temp"
DB_TRASH="${DB_Name_web}_trash"

mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "CREATE DATABASE IF NOT EXISTS \`${DB_Name_web}\`;" 2>/dev/null
mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP USER IF EXISTS '${DB_User_web}'@'localhost'; CREATE USER '${DB_User_web}'@'localhost' IDENTIFIED BY '${password_database_website_giai_ma}';"
mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "GRANT ALL PRIVILEGES ON \`${DB_Name_web}\`.* TO '${DB_User_web}'@'localhost'; FLUSH PRIVILEGES;"
mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_TEMP}\`; CREATE DATABASE \`${DB_TEMP}\`;" 2>/dev/null

INIT_SQL="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET AUTOCOMMIT=0;"
END_SQL="COMMIT; SET FOREIGN_KEY_CHECKS=1; SET UNIQUE_CHECKS=1; SET AUTOCOMMIT=1;"

if command -v pv &>/dev/null; then
  echo ""
  (
    echo "$INIT_SQL"
    pv -w 85 -f -p -N "Tiến độ DB" "$duong_dan_thu_muc_sql"
    echo "$END_SQL"
  ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP"
  IMPORT_STATUS=$?
  echo -en "\033[1A\033[2K\033[1A\r"
else
  (
    echo "$INIT_SQL"
    cat "$duong_dan_thu_muc_sql"
    echo "$END_SQL"
  ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP"
  IMPORT_STATUS=$?
fi

if [[ $IMPORT_STATUS -eq 0 ]]; then
  mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; CREATE DATABASE \`${DB_TRASH}\`;" 2>/dev/null
  OLD_TABLES=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -B -e "SHOW TABLES IN \`${DB_Name_web}\`;" 2>/dev/null)
  NEW_TABLES=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -B -e "SHOW TABLES IN \`${DB_TEMP}\`;" 2>/dev/null)
  RENAME_QUERY="RENAME TABLE "
  
  if [[ -n "$OLD_TABLES" ]]; then
    for t in $OLD_TABLES; do RENAME_QUERY+="\`${DB_Name_web}\`.\`$t\` TO \`${DB_TRASH}\`.\`$t\`, "; done
  fi
  if [[ -n "$NEW_TABLES" ]]; then
    for t in $NEW_TABLES; do RENAME_QUERY+="\`${DB_TEMP}\`.\`$t\` TO \`${DB_Name_web}\`.\`$t\`, "; done
  fi
  
  if [[ "$RENAME_QUERY" != "RENAME TABLE " ]]; then
    RENAME_QUERY=${RENAME_QUERY%, }
    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "$RENAME_QUERY;" 2>/dev/null
    if [[ $? -eq 0 ]]; then
      mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
    fi
  else
    mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
  fi
  _rundone "Import Database thành công."
else
  mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -e "DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
  _runloi "Lỗi Import Database! Dữ liệu web cũ được giữ nguyên."

  flock -u 200 2>/dev/null
  exec 200>&- 2>/dev/null
  rm -f "$TEMP_CNF_ROOT" 2>/dev/null
  rm -f "$LOCK_FILE" 2>/dev/null
  exit 1
fi
