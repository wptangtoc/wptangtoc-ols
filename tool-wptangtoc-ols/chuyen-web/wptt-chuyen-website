THU_MUC_TAM="/usr/local/lsws/$NAME/html_temp_wptt"
rm -rf "$THU_MUC_TAM" && mkdir -p "$THU_MUC_TAM"

if command -v pv &>/dev/null; then
  echo ""
  total_files=$(unzip -Z -1 "$duong_dan_thu_muc" 2>/dev/null | wc -l)
  if [[ -z "$all_for" ]]; then
    unzip -o "$duong_dan_thu_muc" -d "$THU_MUC_TAM"/ -x "wptt" | pv -w 85 -f -p -l -s "$total_files" -N "Tiến độ ZIP" >/dev/null
  else
    unzip -o "$duong_dan_thu_muc" -d "$THU_MUC_TAM"/ | pv -w 85 -f -p -l -s "$total_files" -N "Tiến độ ZIP" >/dev/null
  fi
  echo -en "\033[1A\033[2K\033[1A\r"
else
  if [[ -z "$all_for" ]]; then
    unzip -oq "$duong_dan_thu_muc" -d "$THU_MUC_TAM"/ -x "wptt" 2>/dev/null
  else
    unzip -oq "$duong_dan_thu_muc" -d "$THU_MUC_TAM"/ 2>/dev/null
  fi
