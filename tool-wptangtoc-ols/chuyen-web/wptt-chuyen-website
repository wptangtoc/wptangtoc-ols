if [[ -d "$THU_MUC_TAM" ]]; then
  if [[ -f "/usr/local/lsws/${NAME}/html/.htaccess" && ! -f "$THU_MUC_TAM/.htaccess" ]]; then
    cp -p "/usr/local/lsws/${NAME}/html/.htaccess" "$THU_MUC_TAM/" 2>/dev/null
  fi
  if [[ -f "/usr/local/lsws/${NAME}/html/wp-config.php" && ! -f "$THU_MUC_TAM/wp-config.php" ]]; then
    cp -p "/usr/local/lsws/${NAME}/html/wp-config.php" "$THU_MUC_TAM/" 2>/dev/null
  fi

  THU_MUC_CHINH="/usr/local/lsws/${NAME}/html"
  python3 -c "
import ctypes
import sys
try:
    libc = ctypes.CDLL('libc.so.6')
    res = libc.renameat2(-100, b'${THU_MUC_CHINH}', -100, b'${THU_MUC_TAM}', 2)
    if res != 0: sys.exit(1)
except Exception:
    sys.exit(1)
" >/dev/null 2>&1

  if [[ $? -eq 0 ]]; then
    rm -rf "$THU_MUC_TAM"
  else
    mv "$THU_MUC_CHINH" "${THU_MUC_CHINH}_old_trash" 2>/dev/null
    mv "$THU_MUC_TAM" "$THU_MUC_CHINH" 2>/dev/null
    rm -rf "${THU_MUC_CHINH}_old_trash"
  fi

  rm -f "/usr/local/lsws/${NAME}/html/index.html"
  _rundone "Giải nén và chuyển đổi mã nguồn hoàn tất."
else
  _runloi "Giải nén thất bại! Hủy bỏ để bảo vệ web cũ."
  rm -rf "$THU_MUC_TAM"
  exit 1
fi

