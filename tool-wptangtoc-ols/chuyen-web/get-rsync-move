#!/bin/bash
function huong_dan() {
  Tính năng này là Trái tim của quá trình Chuyển nhà [Migration]. Nó chịu trách nhiệm giải nén và lắp ráp tự động các website vừa được Rsync đưa về máy chủ.

  Hệ thống sẽ tự động thực hiện:
  1. Nhận diện danh sách tên miền mới được chuyển về.
  2. Khởi tạo không gian Web [Vhost] trên LiteSpeed.
  3. Tự động tạo Database mới, User mới và bung [Import] file SQL siêu tốc.
  4. Tự động kết nối lại file wp-config.php [WordPress] và phân quyền bảo mật.

  LƯU Ý QUAN TRỌNG:
  - Đảm bảo tiến trình Rsync dữ liệu từ máy chủ cũ đã chạy XONG HOÀN TOÀN trước khi kích hoạt lệnh này.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-domain-main 1"
fi


clear
print_border_top
center_text "${C_YELLOW}Chuyển Website ➜ Khởi tạo Website sau di cư (Get Rsync)${C_RESET}"
print_border_bot


wptt_check_mariadb || wptt_die "MariaDB đang bị sập! Hệ thống từ chối tạo thêm Get domain mới."
wptt_check_lsws || wptt_die "OpenLiteSpeed đang bị sập! Đã hủy thao tác để an toàn!"


list_file=$(find /usr/local/lsws/*/html/danh-sach-website-wptangtoc-ols.txt 2>/dev/null | head -n 1)
domain_them=$(cat "$list_file" 2>/dev/null)

if [[ -z "$domain_them" ]]; then
  echo -e "${C_RED}❌ Lỗi: Không tìm thấy danh sách website nào vừa được di cư về!${C_RESET}"
  echo -e "Hãy đảm bảo quá trình Rsync dữ liệu đã hoàn tất thành công.\n"
  sleep 3
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
  exit 1
fi

# Dọn dẹp danh sách tạm
find /usr/local/lsws/*/html/ -name "danh-sach-website-wptangtoc-ols.txt" -delete

# Lấy danh sách domain đã có trên máy chủ
domain_da_co=()
for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
        domain_da_co+=("$domain")
    fi
done

# ==============================================================================
# KHỞI TẠO FILE TẠM VÀ BẪY LỖI (TRAP) DỌN DẸP
# ==============================================================================
TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF_ROOT"
WPTT_TMP_IMPORT_SCRIPT="/etc/wptt/tmp/wptt-import-db.sh"

# Bẫy dọn dẹp: Tự động xóa file rác nếu lệnh chạy xong hoặc bị ngắt đột ngột (Ctrl+C)
trap 'rm -f "$TEMP_CNF_ROOT" "$WPTT_TMP_IMPORT_SCRIPT" 2>/dev/null' EXIT INT TERM

# Tải trước script Import với Timeout chống treo mạng
curl --connect-timeout 10 -m 30 --tlsv1.3 -s -o "$WPTT_TMP_IMPORT_SCRIPT" "https://wptangtoc.com/giatuan/wptt-import-db"

# ==============================================================================
# BƯỚC 1: KHỞI TẠO VHOST & SUBFOLDER
# ==============================================================================
for NAME in $domain_them; do
  if [[ ! " ${domain_da_co[@]} " =~ " ${NAME} " ]]; then
    _runing "Khởi tạo website: $NAME"
    
    # CHỐNG VĂNG TIẾN TRÌNH: Dùng bash thay vì source (.) để chặn lệnh exit từ script con
    bash /etc/wptt/domain/wptt-themwebsite "$NAME" >/dev/null 2>&1
    
    # EDGE BUG BYPASS: Kiểm tra xem file cấu hình vhost có thực sự được tạo không
    if [[ ! -f "/etc/wptt/vhost/.$NAME.conf" ]]; then
      _runloi "Lỗi: Khởi tạo Vhost cho $NAME thất bại! Đã Bypass (Bỏ qua)."
      echo ""
      print_border_bot
      echo ""
      continue # Bỏ qua toàn bộ các bước DB phía dưới cho domain lỗi này
    fi


		if [[ ! -f "/usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf" ]]; then
			_runloi "Lỗi: Khởi tạo Vhost cho $NAME thất bại! Đã Bypass (Bỏ qua)."
			echo ""
			print_border_bot
			echo ""
			continue # Bỏ qua toàn bộ các bước DB phía dưới cho domain lỗi này
		fi


    rm -f "/usr/local/lsws/${NAME:?}/html/index.html"

    # Xử lý Subfolder (Nếu có)
    sub_file="/usr/local/lsws/$NAME/html/subfolder-wptt.txt"
    if [[ -f "$sub_file" ]]; then
      for thumuc in $(cat "$sub_file"); do
        bash /etc/wptt/domain/wptt-subfolder-website "$NAME" "$thumuc" >/dev/null 2>&1
      done
    fi
    _rundone "Khởi tạo website: $NAME"
  fi
done

# ==============================================================================
# BƯỚC 2: XỬ LÝ DATABASE & IMPORT SQL (UX PV TÀNG HÌNH + BẮT LỖI PIPEFAIL)
# ==============================================================================
INIT_SQL="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET AUTOCOMMIT=0;"
END_SQL="COMMIT; SET FOREIGN_KEY_CHECKS=1; SET UNIQUE_CHECKS=1; SET AUTOCOMMIT=1;"

. /etc/wptt/.wptt.conf # Call lại file cấu hình gốc
password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

if [[ -z "$password_database_root" || -z "$database_admin_username" ]]; then
    echo -e "${C_RED}❌ Lỗi: Không thể lấy được thông tin quản trị viên Database từ /etc/wptt/.wptt.conf!${C_RESET}"
    exit 1
fi

cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user="${database_admin_username}"
password="${password_database_root}"
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
EOF

unset password_database_root database_admin_password # Giải biến root bảo mật

for NAME in $domain_them; do
  sql_file="/usr/local/lsws/$NAME/html/giatuan-wptangtoc.sql"

  if [[ -f "$sql_file" ]]; then
    print_border_top "${C_GREEN}"
    left_text "➜ Get xử lý Website: ${C_BOLD_WHITE}$NAME${C_RESET}"

    # CHỐNG RÒ RỈ BIẾN (VARIABLE LEAK): Xóa rác biến từ vòng lặp trước đó
    unset DB_Name_web DB_User_web DB_Password_web password_database_website_giai_ma

    # Nạp cấu hình Database vừa được tạo ở Bước 1
    . "/etc/wptt/vhost/.$NAME.conf" 2>/dev/null

    wptt_abort_db_injection() {
        _runloi "$1"
        sleep 2
        continue
    }

    [[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
    [[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"

    password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
    [[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

    [[ "$password_database_website_giai_ma" =~ [[:space:]\'\"\`\\] ]] && wptt_abort_db_injection "Mật khẩu User Database chứa ký tự cấm!" "$1"

    # Khởi tạo Database & User trong 1 luồng Heredoc duy nhất
    if ! mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false <<EOF_SQL
DROP DATABASE IF EXISTS \`${DB_Name_web}\`;
CREATE DATABASE IF NOT EXISTS \`${DB_Name_web}\`;
DROP USER IF EXISTS '${DB_User_web}'@'localhost';
CREATE USER IF NOT EXISTS '${DB_User_web}'@'localhost' IDENTIFIED BY '${password_database_website_giai_ma}';
GRANT ALL PRIVILEGES ON \`${DB_Name_web}\`.* TO '${DB_User_web}'@'localhost';
FLUSH PRIVILEGES;
EOF_SQL
    then
      _runloi "Lỗi khởi tạo Database/User cho website $NAME! Đã Bypass (Bỏ qua)."
      echo ""
      print_border_bot
      echo ""
      continue
    fi

    # Import SQL siêu tốc với PV Tàng Hình và BẮT LỖI PIPELINE
    _runing "Import website $NAME"
    import_success=true

    set -o pipefail
    if command -v pv &>/dev/null; then
      if ! (
        echo "$INIT_SQL"
        pv -N "Import Database" -p -t -e -r -b -w 78 "$sql_file"
        echo "$END_SQL"
      ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false "$DB_Name_web" 2>/dev/null; then
        import_success=false
      fi
    else
      if ! (
        echo "$INIT_SQL"
        cat "$sql_file"
        echo "$END_SQL"
      ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false "$DB_Name_web" 2>/dev/null; then
        import_success=false
      fi
    fi
    set +o pipefail

    if [ "$import_success" = false ]; then
      _runloi "Lỗi Import SQL cho $NAME (File hỏng/MariaDB sập)! Đã Bypass (Bỏ qua)."
      echo ""
      print_border_bot
      echo ""
      continue
    fi

    # Dọn dẹp & Phân quyền (Chạy Subprocess bash để an toàn)
    rm -f "${sql_file:?}"
    bash /etc/wptt/db/wptt-ket-noi "$NAME" >/dev/null 2>&1
		touch "/etc/wptt/tmp/lock_chmod_watcher_${NAME}.active" 2>/dev/null
    bash /etc/wptt/wptt-phanquyen "$NAME" >/dev/null 2>&1
		rm -f "/etc/wptt/tmp/lock_chmod_watcher_${NAME}.active" 2>/dev/null

    if [[ -d /usr/local/lsws/$NAME/logs ]]; then
      sed -i -e '/^errorlog /,/^}$/d' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf
      sed -i -e '/^accesslog /,/^}$/d' /usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf
      echo '
errorlog $VH_ROOT/logs/error.log {
  useServer               1
  logLevel                ERROR
  rollingSize             10M
}
accesslog $VH_ROOT/logs/access.log {
  useServer               0
  rollingSize             10M
  keepDays                30
  compressArchive         1
}' >>/usr/local/lsws/conf/vhosts/"$NAME"/"$NAME".conf
    fi

    echo -en "\033[1A\033[2K\r"
    _rundone "Import website $NAME"
    sleep 1
    echo -en "\033[1A\033[2K\r"
    print_border_bot
    echo ""
  fi

  # Xử lý Website trong Subfolder (nếu có)
  sub_file="/usr/local/lsws/$NAME/html/subfolder-wptt.txt"
  if [[ -f "$sub_file" ]]; then
    wp_configs=$(find "/usr/local/lsws/$NAME/html" -type f -name 'wp-config.php')
    for config_path in $wp_configs; do
      dir_path=$(dirname "$config_path")
      [[ "$dir_path" == "/usr/local/lsws/$NAME/html" ]] && continue

      if [[ -f "$dir_path/giatuan-wptangtoc.sql" ]]; then
        _runing "Đang xử lý Sub-Website tại: $(basename "$dir_path")"
        if [[ -f "$WPTT_TMP_IMPORT_SCRIPT" ]]; then
            (cd "$dir_path" && bash "$WPTT_TMP_IMPORT_SCRIPT" >/dev/null 2>&1)
        fi
        rm -f "${dir_path:?}/giatuan-wptangtoc.sql"
        _rundone "Đang xử lý Sub-Website tại: $(basename "$dir_path")"
      fi
    done
    rm -f "${sub_file:?}"
  fi

  if grep -q 'begin-proxy-wptangtoc' "/usr/local/lsws/$NAME/html/.htaccess"; then
    sed -i -e '/^#begin-proxy-wptangtoc/,/^#end-proxy-wptangtoc$/d' /usr/local/lsws/"$NAME"/html/.htaccess
  fi

done

chown root:root /usr/local/lsws
wptt_smart_reload_lsws >/dev/null 2>&1

rm -f wptt-rsync-move ~/wptt-rsync-move

# Lấy IP Máy chủ
ip=$(curl -skf --connect-timeout 5 "https://ipv4.icanhazip.com" || curl -skf --connect-timeout 5 "https://checkip.amazonaws.com")
[[ -z "$ip" ]] && ip=$(curl -sk --connect-timeout 5 "https://ipv6.icanhazip.com")

unset ipv6
if grep -q 'address.*\[ANY\]' /usr/local/lsws/conf/httpd_config.conf; then
    ipv6=$(curl -s --connect-timeout 5 --max-time 10 https://ipv6.icanhazip.com)
fi

print_border_top "${C_GREEN}"
center_text "${C_BOLD_WHITE}HOÀN TẤT NẠP TẤT CẢ WEBSITE VÀO HỆ THỐNG${C_RESET}"
print_border_mid "${C_GREEN}"
left_text "Quá trình di cư và khởi tạo đã hoàn tất!" 2
print_border_mid "${C_GREEN}"
left_text "Địa chỉ IPv4 máy chủ mới : ${C_YELLOW}$ip${C_RESET}" 2

if [[ -n "$ipv6" ]]; then
    left_text "Địa chỉ IPv6 máy chủ mới : ${C_YELLOW}$ipv6${C_RESET}" 2
fi

left_text "Hành động tiếp theo    : Trỏ DNS các website về IP trên" 2
left_text "                         và tiến hành cài đặt SSL ngay lập tức." 2

print_border_bot "${C_GREEN}"
echo -en "\n${C_GREEN}➜ nhấn [enter] để quay lại menu chuyển website...${C_RESET}"
read -r _
[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-chuyen-web-main 1
