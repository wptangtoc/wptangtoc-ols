#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Chuyển đổi .htaccess sang cấu hình Native Vhost của OpenLiteSpeed
# @since: 2026

# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null || true
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null || true

WPTT_HTACCESS_KEEP='^(rewrite(engine|base|cond|rule)|cachelookup|cachekeymodify)[[:space:]]'
WPTT_HTACCESS_SYNC_SUPPORTED='^(redirect(permanent|temp|match)?|php_(admin_)?(value|flag)|header|expires(active|default|bytype)|errordocument|order|allow|deny|require|options|directoryindex|adddefaultcharset)[[:space:]]'

wptt_htaccess_clean() {
  tr -d '\r' <"$1" |
    sed -e 's/\xc2\xa0/ /g' |
    sed -e ':a' -e '/\\$/{N;s/\\\n[[:space:]]*/ /;ta' -e '}' |
    sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' |
    grep -vE '^(#|$)' || true
}

wptt_htaccess_rewrite_only() {
  wptt_htaccess_clean "$1" | awk -v keep="$WPTT_HTACCESS_KEEP" '
    function add(s) { if (depth > 0) body[depth] = body[depth] s; else out = out s }
    {
      low = tolower($0)
      if (low ~ /^<ifmodule[ \t]+[^>]*>$/) { depth++; head[depth] = $0; body[depth] = ""; next }
      if (low ~ /^<\/ifmodule>$/) {
        if (depth == 0) next
        blk = (body[depth] != "") ? head[depth] "\n" body[depth] "</IfModule>\n" : ""
        depth--
        if (blk != "") add(blk)
        next
      }
      if (low ~ keep) add($0 "\n")
    }
    END { printf "%s", out }'
}

wptt_htaccess_skipped() {
  wptt_htaccess_clean "$1" |
    grep -viE '^</?(IfModule|Files|FilesMatch)' |
    grep -viE "$WPTT_HTACCESS_KEEP" |
    grep -viE "$WPTT_HTACCESS_SYNC_SUPPORTED" || true
}

NAME="${1:-}"
NO_RELOAD="${2:-}"
if [[ "$NAME" = "98" ]]; then
  NAME=""
fi

if [[ -z "$NAME" ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/tenmien
  lua_chon_NAME "chuyển đổi .htaccess sang vhosts:"
fi

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  return 2>/dev/null || exit 0
fi

path="/etc/wptt/vhost/.$NAME.conf"
path_bk="/etc/wptt/vhost_bk/.$NAME.conf"

if [[ ! -f "$path" && ! -f "$path_bk" ]]; then
  clear
  echoDo "Domain khong ton tai tren VPS."
  return 2>/dev/null || exit 1
fi

if [[ ! -f "/usr/local/lsws/$NAME/html/.htaccess" ]]; then
  echoDo "Không xác định được .htaccess của website $NAME"
  return 2>/dev/null || exit 1
fi

vhost_conf="/usr/local/lsws/conf/vhosts/$NAME/$NAME.conf"
htaccess_file="/usr/local/lsws/$NAME/html/.htaccess"

/bin/cp -p -- "$vhost_conf" "$vhost_conf.bak-wptt" 2>/dev/null || true

sed -i -e '/^rewrite/,/^}$/d' "$vhost_conf"

_runing "Thiết lập chuyển htaccess sang vhosts"
cat <<'EOF' >>"$vhost_conf"

rewrite  {
  enable                  1
  autoLoadHtaccess        0
}
EOF

sed -i -e '/^context \/ {/,/^}$/d' "$vhost_conf"
sed -i '/^$/d' "$vhost_conf"

unset lenh_htaccess lenh_bo_qua
lenh_htaccess=$(wptt_htaccess_rewrite_only "$htaccess_file")
lenh_bo_qua=$(wptt_htaccess_skipped "$htaccess_file")

# Khởi tạo ký tự mở Heredoc của OLS bằng printf để tránh lỗi hiển thị
ols_heredoc_open="$(printf '\074\074\074')"

cat <<EOF >>"$vhost_conf"

context / {
  location                /usr/local/lsws/$NAME/html
  allowBrowse             1
  extraHeaders            ${ols_heredoc_open}END_extraHeaders
X-XSS-Protection 1;mode=block
X-Frame-Options SAMEORIGIN
Referrer-Policy strict-origin-when-cross-origin
X-Content-Type-Options nosniff
X-Powered-By WPTangTocOLS
permissions-policy accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  END_extraHeaders


  rewrite  {
      enable                1
      inherit               1
      rules                 ${ols_heredoc_open}END_rules
$lenh_htaccess
      END_rules
  }
  addDefaultCharset       off

  phpIniOverride  {

  }
}
EOF

if [[ -n "${Website_chinh:-}" && -f "/usr/local/lsws/conf/vhosts/${Website_chinh}/${Website_chinh}.conf" ]]; then
  hostname_custom=$(grep 'X-Powered-By' "/usr/local/lsws/conf/vhosts/${Website_chinh}/${Website_chinh}.conf" 2>/dev/null | cut -f2 -d ' ' | sort -u)
else
  hostname_custom="WPTangTocOLS"
fi

if [[ -z "$hostname_custom" || "$hostname_custom" != "WPTangTocOLS" ]]; then
  sed -i '/X-Powered-By/d' "$vhost_conf"
fi

if [[ -n "$hostname_custom" && "$hostname_custom" != "WPTangTocOLS" ]]; then
  sed -i "/extraHeaders /a X-Powered-By $hostname_custom" "$vhost_conf"
fi
unset hostname_custom ols_heredoc_open

# Gọi ngay wptt-htaccess-sync để biên dịch Redirect 301, Header, php_value, Deny/Allow, Expires vào Vhost
if [[ -f /etc/wptt/wptt-htaccess-sync ]]; then
  /bin/bash /etc/wptt/wptt-htaccess-sync --no-reload --quiet "$NAME" >/dev/null 2>&1 || true
fi

if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
  tuong_thich_nhom_litespeed="nogroup"
else
  tuong_thich_nhom_litespeed="nobody"
fi

chown -hR "lsadm:${tuong_thich_nhom_litespeed}" "/usr/local/lsws/conf/vhosts/$NAME"
chmod -R 750 "/usr/local/lsws/conf/vhosts/$NAME"

if [[ "$NO_RELOAD" != "--no-reload" ]]; then
  wptt_smart_reload_lsws >/dev/null 2>&1
fi

sed -i '/^$/d' "/etc/wptt/vhost/.$NAME.conf" 2>/dev/null || true
wptt_atomic_edit_config "/etc/wptt/vhost/.$NAME.conf" "vhost_chuyen_htaccess=1"
_rundone "Thiết lập chuyển htaccess sang vhosts"

if [[ -n "$lenh_bo_qua" ]]; then
  echo "Các chỉ thị .htaccess sau không tương thích rewrite OLS nên đã được bỏ qua:"
  echo "$lenh_bo_qua" | sed 's/^/  - /'
  wptt_logs "INFO" "Bỏ qua chỉ thị .htaccess không tương thích OLS website $NAME: $(echo "$lenh_bo_qua" | tr '\n' ';')"
fi
unset lenh_htaccess lenh_bo_qua

wptt_logs "INFO" "Thiết lập chuyển htaccess sang vhosts website $NAME"
