#!/bin/bash
set -o pipefail
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng Khôi phục database [Database Restoration] là quá trình đưa một cơ sở dữ liệu [database] trở lại một trạng thái đã được lưu trữ trước đó, thường là từ một tệp tin sao lưu [backup].

  Nói một cách đơn giản, nếu database của bạn gặp sự cố [mất dữ liệu, bị lỗi, bị tấn công], tính năng này giống như việc bạn sử dụng một cỗ máy thời gian để quay ngược database về một thời điểm mà nó còn hoạt động tốt, dựa trên bản sao lưu bạn đã có.

  Mục Đích Chính
  * Phục hồi sau thảm họa/sự cố: Đây là mục đích quan trọng nhất, giúp lấy lại dữ liệu và cấu trúc database sau khi xảy ra lỗi phần cứng, lỗi phần mềm, tấn công mạng, xóa nhầm, hoặc các vấn đề khác gây mất mát dữ liệu.
  * Hoàn tác các thay đổi không mong muốn: Khôi phục lại trạng thái trước khi có những thay đổi dữ liệu sai sót hoặc cập nhật ứng dụng gây lỗi.
  * Phục hồi tại một thời điểm cụ thể [Point-in-Time Recovery]: Nếu chiến lược sao lưu của bạn hỗ trợ, bạn có thể khôi phục database về chính xác một thời điểm nào đó trước khi sự cố xảy ra.
  * Phục vụ môi trường thử nghiệm/phát triển: Tạo một bản sao của database sản xuất trên môi trường thử nghiệm để kiểm tra mà không ảnh hưởng đến dữ liệu thật.
}

export box_inner_width=78

. /etc/wptt/.wptt.conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"

. /etc/wptt/echo-color

check_menu_wptangtoc_active=$1

thoat_ve_menu() {
  if [[ "$check_menu_wptangtoc_active" == "97" ]]; then
    exec /etc/wptt/wptt-backup-restore-main 1
  else
    exec /etc/wptt/wptt-db-main 1
  fi
}

if [[ $check_menu_wptangtoc_active = "97" ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}$backup_restore ➜ $khoi_phuc_database${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
else
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}$quan_ly_database ➜ $khoi_phuc_database${C_RESET}"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"
fi

. /etc/wptt/core-functions
if [[ "$1" == '98' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-db-main 1"
fi

if [[ "$1" == '97' ]]; then
  WPTT_IN_MENU="yes"
  WPTT_MENU_BACK="/etc/wptt/wptt-backup-restore-main 1"
fi

wptt_check_mariadb || wptt_die "MariaDB đang bị sập! Hệ thống từ chối không cho phép khôi phục database."

. /etc/wptt/tenmien
lua_chon_NAME "$khoi_phuc_database:"

if [[ "$NAME" = "0" || -z "$NAME" ]]; then
  thoat_ve_menu
fi

pathcheck="/etc/wptt/vhost/.$NAME.conf"
if [[ ! -f "$pathcheck" ]]; then
  clear
  echo -e "\n${C_RED}❌ $ten_mien_nay_khong_ton_tai_tren_he_thong${C_RESET}"
  sleep 3
  thoat_ve_menu
fi

if [[ ! $(ls -A /usr/local/backup-website/"$NAME" 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$') && ! $(ls -A /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$') ]]; then
  echo -e "\n${C_YELLOW}⚠️ Không có file backup database (.sql, .sql.gz, .sql.zst) nào tồn tại.${C_RESET}"
  echo "Vui lòng upload file backup database của bạn vào: /usr/local/backup-website/$NAME/"
  sleep 4
  thoat_ve_menu
fi

b=1
for entry in $(ls -At /usr/local/backup-website/"$NAME" 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$'); do
  b=$((b + 1))
done

bb=1
if [[ $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$') ]]; then
  for entry in $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$'); do
    bb=$((bb + 1))
  done
fi

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}THỐNG KÊ BẢN SAO LƯU DATABASE (CƠ SỞ DỮ LIỆU)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Số lượng file (Quyền Root): $((b - 1))"
left_text "Số lượng file (Quyền User): $((bb - 1))"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_GREEN}Tổng cộng có: $((bb + b - 2)) file sao lưu Database${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

selects=()
for entry in $(ls -At /usr/local/backup-website/"$NAME" 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$'); do
  selects+=("$entry")
done

if [[ $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$') ]]; then
  for entry in $(ls -At /usr/local/lsws/"$NAME"/backup-website 2>/dev/null | grep '.sql$\|.sql.gz$\|.sql.zst$'); do
    selects+=("$entry")
  done
fi

if [[ ${#selects[@]} -eq 0 ]]; then
  echo -e "\n${C_RED}❌ Không có file backup Database nào hợp lệ!${C_RESET}"
  sleep 3
  thoat_ve_menu
fi

echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}CHỌN MỐC THỜI GIAN KHÔI PHỤC (DATABASE)${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

i=1
for val in "${selects[@]}"; do
  if [[ -f "/usr/local/backup-website/$NAME/$val" ]]; then
    fsize=$(du -sh "/usr/local/backup-website/$NAME/$val" 2>/dev/null | cut -f1)
  else
    fsize=$(du -sh "/usr/local/lsws/$NAME/backup-website/$val" 2>/dev/null | cut -f1)
  fi
  
  item_row=$(printf "  ${C_CYAN}%3d)${C_RESET} [${C_GREEN}%-7s${C_RESET}] ${C_BOLD_WHITE}%s${C_RESET}" "$i" "${fsize:-???}" "$val")
  clean_row=$(printf "  %3d) [%-7s] %s" "$i" "${fsize:-???}" "$val")
  pad=$((box_inner_width - ${#clean_row}))
  [[ $pad -lt 0 ]] && pad=0
  echo -e "${C_CYAN}│${C_RESET}${item_row}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
  ((i++))
done
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

while true; do
  echo -en "${C_CYAN}Nhập số thứ tự file Database cần khôi phục (1-${#selects[@]}) [0=Thoát]: ${C_RESET}"
  read -r REPLY
  [[ "$REPLY" == "0" || -z "$REPLY" ]] && thoat_ve_menu
  if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
    idx=$((REPLY - 1))
    file="${selects[$idx]}"
    break
  else
    echo -e "${C_RED}❌ Lựa chọn không hợp lệ!${C_RESET}"
  fi
done

duong_dan_thu_path_sql="/usr/local/backup-website/$NAME/$file"
if [[ ! -f $duong_dan_thu_path_sql ]]; then
  duong_dan_thu_path_sql="/usr/local/lsws/$NAME/backup-website/$file"
fi

if [[ -f "/usr/local/backup-website/$NAME/$file" && -f "/usr/local/lsws/$NAME/backup-website/$file" ]]; then
  echo -e "\n${C_YELLOW}⚠️ Phát hiện trùng lặp tên file backup Database giữa thư mục Root và User!${C_RESET}"
  echo -e "${C_CYAN}1)${C_RESET} Dùng bản của ${C_RED}Root${C_RESET} (/usr/local/backup-website/...)"
  echo -e "${C_CYAN}2)${C_RESET} Dùng bản của ${C_GREEN}User${C_RESET} (/usr/local/lsws/.../backup-website/...)"
  while true; do
    echo -en "${C_CYAN}Chọn nguồn ưu tiên [1-2]: ${C_RESET}"
    read -r opt
    case "$opt" in
    1)
      duong_dan_thu_path_sql="/usr/local/backup-website/$NAME/$file"
      break
      ;;
    2)
      duong_dan_thu_path_sql="/usr/local/lsws/$NAME/backup-website/$file"
      break
      ;;
    *) echo -e "${C_RED}❌ Nhập sai, vui lòng chọn 1 hoặc 2.${C_RESET}" ;;
    esac
  done
fi

check_file_error=$(du -c "$duong_dan_thu_path_sql" | awk '{print $1}' | sed '1d')
if ((${check_file_error:-0} < 3)); then
  echo -e "\n${C_RED}❌ Lỗi: File $file quá nhỏ (Dưới 3KB), có thể bị lỗi corrupt!${C_RESET}"
  echo "Vui lòng lựa chọn file Database backup khác."
  sleep 3
  thoat_ve_menu
fi

. /etc/wptt/vhost/."$NAME".conf

echo ""
if ! wptt_xac_nhan "$xac_nhan $ban_co_muon $nhap_du_lieu $file" "Website vẫn online bình thường trong quá trình khôi phục" "Khôi phục database website ${NAME}?" "$dong_y" "$khong_dong_y"; then
  thoat_ve_menu
fi

echo "Khôi phục database website $NAME: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log

# ==============================================================================
# BẮT ĐẦU CƠ CHẾ LOCKING
# ==============================================================================
if [[ -n "$NAME" && "$NAME" != "Tất cả website" && "$NAME" != "98" ]]; then
  LOCK_FILE="/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME}.lock"
  exec 200>"$LOCK_FILE"

  if ! flock -n 200; then
    echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}LỖI ĐỤNG ĐỘ TIẾN TRÌNH (LOCKING)${C_RESET}"
    echo -e "${C_RED}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Website $NAME đang được thao tác bởi một tiến trình khác (Backup/Restore)."
    left_text "Vui lòng chờ tiến trình đó hoàn tất rồi thử lại để tránh hỏng dữ liệu!"
    echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
    sleep 3
    thoat_ve_menu
  fi
fi

wptt_abort_db_injection() {
    _runloi "$1"
    sleep 2
    thoat_ve_menu
}

[[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!"
[[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!"

password_database_root=$(wptt_giai_ma "$database_admin_password" 2>/dev/null)
[[ -z "$password_database_root" ]] && password_database_root="$database_admin_password"

TEMP_CNF_ROOT=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF_ROOT"

cat >"$TEMP_CNF_ROOT" <<EOF
[client]
user=${database_admin_username}
password=${password_database_root}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF
trap "rm -f ${TEMP_CNF_ROOT}" EXIT

# ==============================================================================
# ATOMIC RESTORE: KHÔNG XÓA DB LIVE TRƯỚC, TẠO TRẠM TRUNG CHUYỂN NGẦM
# ==============================================================================
DB_TEMP="${DB_Name_web}_temp"
DB_TRASH="${DB_Name_web}_trash"

mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "CREATE DATABASE IF NOT EXISTS \`${DB_Name_web}\`;" 2>/dev/null
mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_TEMP}\`; CREATE DATABASE \`${DB_TEMP}\`;" 2>/dev/null

wp_config_php_path="/usr/local/lsws/$NAME/html/wp-config.php"

if [[ -f $wp_config_php_path ]]; then
  if [[ $lock_down ]]; then
    chattr -i "$wp_config_php_path"
  fi
  password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
  [[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web"

  wp config set DB_HOST 'localhost' --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_NAME "$DB_Name_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_USER "$DB_User_web" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  wp config set DB_PASSWORD "$password_database_website_giai_ma" --type=constant --allow-root --path="/usr/local/lsws/$NAME/html" --quiet
  if [[ $lock_down ]]; then
    chattr +i "$wp_config_php_path"
  fi
fi

# Hiển thị UI Tối giản gốc
_runing "$khoi_phuc_database website $NAME"

if ! command -v pv &>/dev/null; then
  if [ -f /etc/redhat-release ]; then
    dnf install pv -y -q >/dev/null 2>&1 || yum install pv -y -q >/dev/null 2>&1
  elif [ -f /etc/debian_version ]; then
    apt-get update -q >/dev/null 2>&1 && apt-get install pv -y -q >/dev/null 2>&1
  fi
fi

INIT_SQL="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET AUTOCOMMIT=0;"
END_SQL="COMMIT; SET FOREIGN_KEY_CHECKS=1; SET UNIQUE_CHECKS=1; SET AUTOCOMMIT=1;"

if command -v pv &>/dev/null; then echo ""; fi

if command -v pv &>/dev/null; then
  if [[ "$duong_dan_thu_path_sql" == *".sql.zst" ]]; then
    [[ -z $(command -v zstd 2>/dev/null) ]] && dnf install zstd -y -q >/dev/null 2>&1
    ( echo "$INIT_SQL"; pv -w 78 -f -p -N "Tiến độ DB" "$duong_dan_thu_path_sql" | zstd -d; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  elif [[ "$duong_dan_thu_path_sql" == *".sql.gz" ]]; then
    ( echo "$INIT_SQL"; pv -w 78 -f -p -N "Tiến độ DB" "$duong_dan_thu_path_sql" | zcat; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  else
    ( echo "$INIT_SQL"; pv -w 78 -f -p -N "Tiến độ DB" "$duong_dan_thu_path_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  fi
  IMPORT_STATUS=$?
  # Ma thuật dọn dẹp: Tàng hình thanh PV và ghi đè
  echo -en "\033[1A\033[2K\033[1A\r"
else
  if [[ "$duong_dan_thu_path_sql" == *".sql.zst" ]]; then
    [[ -z $(command -v zstd 2>/dev/null) ]] && dnf install zstd -y -q >/dev/null 2>&1
    ( echo "$INIT_SQL"; zstd -d <"$duong_dan_thu_path_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  elif [[ "$duong_dan_thu_path_sql" == *".sql.gz" ]]; then
    ( echo "$INIT_SQL"; zcat "$duong_dan_thu_path_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  else
    ( echo "$INIT_SQL"; cat "$duong_dan_thu_path_sql"; echo "$END_SQL"; ) | mariadb --defaults-extra-file="$TEMP_CNF_ROOT" "$DB_TEMP" --ssl-verify-server-cert=false
  fi
  IMPORT_STATUS=$?
fi

if [[ $IMPORT_STATUS -eq 0 ]]; then
  # Tráo đổi Atomic Swap
  mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; CREATE DATABASE \`${DB_TRASH}\`;" 2>/dev/null
  
  OLD_TABLES=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -B -e "SHOW TABLES IN \`${DB_Name_web}\`;" 2>/dev/null)
  NEW_TABLES=$(mariadb --defaults-extra-file="$TEMP_CNF_ROOT" -N -B -e "SHOW TABLES IN \`${DB_TEMP}\`;" 2>/dev/null)
  
  RENAME_QUERY="RENAME TABLE "
  if [[ -n "$OLD_TABLES" ]]; then
      for t in $OLD_TABLES; do RENAME_QUERY+="\`${DB_Name_web}\`.\`$t\` TO \`${DB_TRASH}\`.\`$t\`, "; done
  fi
  if [[ -n "$NEW_TABLES" ]]; then
      for t in $NEW_TABLES; do RENAME_QUERY+="\`${DB_TEMP}\`.\`$t\` TO \`${DB_Name_web}\`.\`$t\`, "; done
  fi
  
  if [[ "$RENAME_QUERY" != "RENAME TABLE " ]]; then
      RENAME_QUERY=${RENAME_QUERY%, }
      mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "$RENAME_QUERY;" 2>/dev/null
      
      if [[ $? -eq 0 ]]; then
          khoi_phuc_database_status='1'
          mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
      else
          unset khoi_phuc_database_status
      fi
  else
      khoi_phuc_database_status='1'
      mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_TRASH}\`; DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
  fi
else
  unset khoi_phuc_database_status
  mariadb --defaults-extra-file="$TEMP_CNF_ROOT" --ssl-verify-server-cert=false -e "DROP DATABASE IF EXISTS \`${DB_TEMP}\`;" 2>/dev/null
fi

if [[ -n "$khoi_phuc_database_status" ]]; then
  _rundone "$khoi_phuc_database website $NAME"
else
  _runloi "$khoi_phuc_database website $NAME"
fi

rm -f "${TEMP_CNF_ROOT}"

pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ -f $pathcheckwp ]]; then
  _runing "Xóa toàn bộ cache website $NAME"
  (/etc/wptt/cache/wptt-xoacache "$NAME" >/dev/null 2>&1)
  _rundone "Xóa toàn bộ cache website $NAME"
fi

clear

if [[ -n "$khoi_phuc_database_status" ]]; then
	thong_bao_sql=$(echo "$duong_dan_thu_path_sql" | cut -f6 -d '/' | grep "^$NAME" | sed "s/^$NAME//g" | cut -f1 -d '.')
	echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
	center_text "${C_BOLD_WHITE}$khoi_phuc_database $NAME thành công${C_RESET}"
	echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
	
	if [[ -n "$thong_bao_sql" ]]; then
		chuyen_doi_thong_bao_gio=$(echo "$thong_bao_sql" | cut -c 1-2)
		chuyen_doi_thong_bao_ngay=$(echo "$thong_bao_sql" | cut -f2 -d '_' | cut -c 1-2)
		chuyen_doi_thong_bao_thang=$(echo "$thong_bao_sql" | cut -f3 -d '_' | cut -c 1-2)
		chuyen_doi_thong_bao_nam=$(echo "$thong_bao_sql" | cut -f4 -d '_' | cut -c 1-4)
		if [[ -n "$chuyen_doi_thong_bao_gio" && -n "$chuyen_doi_thong_bao_ngay" && -n "$chuyen_doi_thong_bao_thang" && -n "$chuyen_doi_thong_bao_nam" ]]; then
			left_text "Khôi phục DB về: Lúc $chuyen_doi_thong_bao_gio giờ ngày $chuyen_doi_thong_bao_ngay/$chuyen_doi_thong_bao_thang/$chuyen_doi_thong_bao_nam"
		fi
	else
	    left_text "Trạng thái     : Cơ sở dữ liệu đã được phục hồi Atomic an toàn."
	fi
	echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
else
	echo -e "\n${C_RED}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
	center_text "${C_BOLD_WHITE}$khoi_phuc_database $NAME thất bại${C_RESET}"
	echo -e "${C_RED}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

#nhả khoá chủ động locking
flock -u 200
exec 200>&-
rm -f "/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME:?}.lock" 2>/dev/null

thoat_ve_menu
