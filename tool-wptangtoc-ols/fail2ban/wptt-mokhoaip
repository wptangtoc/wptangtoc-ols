#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Mở khóa địa chỉ IP và dải CIDR đa tầng kèm bộ chọn nhanh FZF (Bản Enterprise chống lỗi hiển thị)

function huong_dan() {
  cat <<'EOF'
  Tính năng Mở khóa IP [hay gỡ chặn IP] trong WPTangToc OLS là chức năng đối ngược với tính năng Chặn IP. Nó cho phép người quản trị máy chủ loại bỏ một địa chỉ IP cụ thể ra khỏi danh sách bị chặn, khôi phục quyền truy cập của IP đó vào website hoặc toàn bộ máy chủ.

  Mục đích chính của tính năng Mở khóa IP:
  * Sửa lỗi chặn nhầm: Trong một số trường hợp, IP của người dùng hợp lệ hoặc thậm chí IP của chính quản trị viên có thể vô tình bị chặn. Tính năng mở khóa IP giúp khắc phục tình trạng này.
  * Thay đổi chính sách truy cập: Khi một IP trước đây bị coi là mối đe dọa nhưng nay đã được xác minh là an toàn.
  * Quản lý danh sách chặn linh hoạt: Cho phép quản trị viên duy trì một danh sách IP bị chặn chính xác và cập nhật.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null

# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
if [[ -z "${ngon_ngu:-}" ]]; then
  ngon_ngu='vi'
fi
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null

TMP_LIST=""
TMP_SORTED=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${TMP_LIST:-}" && -f "$TMP_LIST" ]]; then
    /bin/rm -f -- "${TMP_LIST:?}"
  fi
  if [[ -n "${TMP_SORTED:-}" && -f "$TMP_SORTED" ]]; then
    /bin/rm -f -- "${TMP_SORTED:?}"
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# ==============================================================================
# 1. HÀM KIỂM TRA & CHUẨN HÓA IPV4 / IPV6 / CIDR THUẦN BASH (0 SUBSHELL)
# ==============================================================================
VALIDATED_IP=""

wptt_validate_ip_pure_bash() {
  local raw_input="$1"
  local addr="$raw_input"
  local cidr=""

  VALIDATED_IP=""

  if [[ "$raw_input" == *"/"* ]]; then
    addr="${raw_input%%/*}"
    cidr="${raw_input#*/}"
    if [[ ! "$cidr" =~ ^[0-9]{1,3}$ ]]; then
      return 1
    fi
  fi

  # A. Kiểm tra chuẩn IPv4
  if [[ "$addr" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    local o1="${BASH_REMATCH[1]}"
    local o2="${BASH_REMATCH[2]}"
    local o3="${BASH_REMATCH[3]}"
    local o4="${BASH_REMATCH[4]}"

    if ((10#$o1 <= 255 && 10#$o2 <= 255 && 10#$o3 <= 255 && 10#$o4 <= 255)); then
      if [[ -n "$cidr" ]]; then
        if ((10#$cidr < 8 || 10#$cidr > 32)); then
          return 1
        fi
        VALIDATED_IP="$((10#$o1)).$((10#$o2)).$((10#$o3)).$((10#$o4))/$((10#$cidr))"
      else
        VALIDATED_IP="$((10#$o1)).$((10#$o2)).$((10#$o3)).$((10#$o4))"
      fi
      return 0
    fi
    return 1
  fi

  # B. Kiểm tra chuẩn IPv6 (Hỗ trợ đầy đủ dạng rút gọn :: và IPv4-mapped)
  if [[ "$addr" == *":"* && "$addr" != *":::"* ]]; then
    if [[ "$addr" =~ ^:[0-9a-fA-F] ]]; then
      return 1
    fi
    if [[ "$addr" =~ [0-9a-fA-F]:$ ]]; then
      return 1
    fi
    local check_dc="${addr/::/@}"
    if [[ "$check_dc" == *"::"* ]]; then
      return 1
    fi

    local IFS=':'
    local -a hextets=()
    read -r -a hextets <<<"$addr"
    if ((${#hextets[@]} <= 8)); then
      local h
      local valid_v6=1
      for h in "${hextets[@]}"; do
        [[ -z "$h" ]] && continue
        if [[ ! "$h" =~ ^[0-9a-fA-F]{1,4}$ && ! "$h" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
          valid_v6=0
          break
        fi
      done
      if ((valid_v6 == 1)); then
        if [[ -n "$cidr" ]]; then
          if ((10#$cidr < 16 || 10#$cidr > 128)); then
            return 1
          fi
          VALIDATED_IP="${addr,,}/$((10#$cidr))"
        else
          VALIDATED_IP="${addr,,}"
        fi
        return 0
      fi
    fi
  fi

  return 1
}

# ==============================================================================
# 2. HÀM QUÉT TẤT CẢ IP BỊ CHẶN TRÊN HỆ THỐNG (CHO CHẾ ĐỘ FZF 00)
# ==============================================================================
wptt_scan_all_blocked_ips() {
  local out_file="$1"
  : >"$out_file"

  # 1. Quét CSF Firewall (Chặn vĩnh viễn & Chặn tạm thời)
  if command -v csf >/dev/null 2>&1 && [[ -f /etc/csf/csf.conf ]]; then
    if [[ -f /etc/csf/csf.deny ]]; then
      awk '
        /^[ \t]*#/ { next }
        /^[ \t]*$/ { next }
        {
          if (index($1, "\x7c") == 0) print "CSF", $1
        }
      ' /etc/csf/csf.deny >>"$out_file" 2>/dev/null
    fi
    if [[ -s /var/lib/csf/csf.tempban ]]; then
      awk -F '\x7c' '
        /^[ \t]*#/ { next }
        NF >= 1 && $1 != "" {
          gsub(/[[:space:]]/, "", $1)
          if ($1 != "") print "CSF-Temp", $1
        }
      ' /var/lib/csf/csf.tempban >>"$out_file" 2>/dev/null
    fi
  fi

  # 2. Quét Nftables (Đã vá lỗi loại trừ hoàn toàn 0.0.0.0 và ::)
  if systemctl is-active --quiet nftables 2>/dev/null && command -v nft >/dev/null 2>&1; then
    awk '
      function is_ip(val) {
        if (val == "0.0.0.0" || val == "::" || val ~ /^0(\.0){3}/) return 0
        if (val ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) return 1
        if (val ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}\/[0-9]{1,2}$/) return 1
        if (index(val, ":") > 0 && val ~ /^[0-9a-fA-F:\/]+$/) return 1
        return 0
      }
      /elements[ \t]*=[ \t]*\{/ { in_elem = 1 }
      in_elem {
        for (i = 1; i <= NF; i++) {
          cand = $i
          gsub(/[,{}]/, "", cand)
          if (is_ip(cand)) print "Nftables", cand
        }
        if (index($0, "}") > 0) in_elem = 0
      }
      /saddr/ && /drop/ {
        for (i = 1; i <= NF; i++) {
          if ($i == "saddr" && (i + 1) <= NF) {
            cand = $(i + 1)
            gsub(/[,{}]/, "", cand)
            if (is_ip(cand)) print "Nftables", cand
          }
        }
      }
    ' < <(nft list ruleset 2>/dev/null) >>"$out_file" 2>/dev/null || true
  fi

  # 3. Quét Firewalld (Zone Drop)
  if systemctl is-active --quiet firewalld 2>/dev/null && command -v firewall-cmd >/dev/null 2>&1; then
    awk '
      {
        for (i = 1; i <= NF; i++) {
          if ($i != "") print "Firewalld", $i
        }
      }
    ' < <(firewall-cmd --zone=drop --list-sources 2>/dev/null) >>"$out_file" 2>/dev/null
  fi

  # 4. Quét SSHGuard (Toàn diện: DB, Firewalld Ipset, Nftables Set, Iptables Chain)
  if systemctl is-active --quiet sshguard 2>/dev/null; then
    # A. Quét từ Database vĩnh viễn (Định dạng: timestamp|service|type|IP)
    if [[ -f /var/lib/sshguard/blacklist.db ]]; then
      awk -F'\x7c' '
        {
          cand = ""
          if (NF >= 4) cand = $4
          else if (NF == 1) cand = $1

          gsub(/[, \t]/, "", cand)
          if (cand != "" && cand != "127.0.0.1" && cand != "::1") {
            if (cand ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}/ || index(cand, ":") > 0) {
              print "SSHGuard-DB", cand
            }
          }
        }
      ' /var/lib/sshguard/blacklist.db >>"$out_file" 2>/dev/null
    fi

    # B. Quét từ Ipset đang chạy trên RAM của Firewalld
    if systemctl is-active --quiet firewalld 2>/dev/null && command -v firewall-cmd >/dev/null 2>&1; then
      for iset in sshguard4 sshguard6; do
        firewall-cmd --ipset="$iset" --get-entries 2>/dev/null | awk -v sn="SSHGuard-FW" '
          { if ($1 != "") print sn, $1 }
        ' >>"$out_file" 2>/dev/null
      done
    fi

    # C. Quét từ Set attackers của Nftables (Khi dùng backend sshg-fw-nft-sets)
    if systemctl is-active --quiet nftables 2>/dev/null && command -v nft >/dev/null 2>&1; then
      awk '
        /^table (ip|ip6|inet) sshguard/ { in_table = 1 }
        in_table && /set attackers/ { in_set = 1 }
        in_set && /elements[ \t]*=[ \t]*\{/ { in_elem = 1 }
        in_elem {
          for (i = 1; i <= NF; i++) {
            cand = $i
            gsub(/[,{}]/, "", cand)
            if (cand ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}/ || (index(cand, ":") > 0 && cand ~ /^[0-9a-fA-F:\/]+$/)) {
              print "SSHGuard-FW", cand
            }
          }
          if (index($0, "}") > 0) { in_elem = 0; in_set = 0; in_table = 0 }
        }
      ' < <(nft list ruleset 2>/dev/null) >>"$out_file" 2>/dev/null
    fi

    # D. Quét từ Chain sshguard của Iptables/CSF (Khi dùng backend sshg-fw-iptables)
    if command -v iptables >/dev/null 2>&1; then
      iptables -w -S sshguard 2>/dev/null | awk '
        /^-A sshguard/ && /-s / {
          for (i = 1; i <= NF; i++) {
            if ($i == "-s" && (i + 1) <= NF) {
              print "SSHGuard-FW", $(i + 1)
            }
          }
        }
      ' >>"$out_file" 2>/dev/null
    fi
    if command -v ip6tables >/dev/null 2>&1; then
      ip6tables -w -S sshguard 2>/dev/null | awk '
        /^-A sshguard/ && /-s / {
          for (i = 1; i <= NF; i++) {
            if ($i == "-s" && (i + 1) <= NF) {
              print "SSHGuard-FW", $(i + 1)
            }
          }
        }
      ' >>"$out_file" 2>/dev/null
    fi
  fi

  # 5. Quét Fail2ban
  if systemctl is-active --quiet fail2ban 2>/dev/null && command -v fail2ban-client >/dev/null 2>&1; then
    local jail_raw jail_list jail
    jail_raw="$(fail2ban-client status 2>/dev/null)"
    if [[ "$jail_raw" =~ Jail[[:space:]]list:[[:space:]]*([^\n\r]+) ]]; then
      jail_list="${BASH_REMATCH[1]//,/ }"
      for jail in $jail_list; do
        [[ -n "$jail" ]] || continue
        fail2ban-client status "$jail" 2>/dev/null | awk -v j="Fail2ban-${jail}" '
          /Banned IP list:/ {
            for (i = 4; i <= NF; i++) {
              cand = $i
              gsub(/[,]/, "", cand)
              if (cand != "" && cand !~ /^(list:|Banned|IP|is:|none)$/ && (cand ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/ || index(cand, ":") > 0)) {
                print j, cand
              }
            }
          }
        ' >>"$out_file" 2>/dev/null || true
      done
    fi
  fi

  # 6. Quét OpenLiteSpeed Dynamic Anti-DDoS (/tmp/lshttpd/.rtreport*)
  local rtreport_files=(/tmp/lshttpd/.rtreport*)
  if [[ -e "${rtreport_files[0]}" ]]; then
    awk '
      /^BLOCKED_IP:/ {
        gsub(/BLOCKED_IP:/, "", $0)
        gsub(/,/, " ", $0)
        for (i = 1; i <= NF; i++) {
          cand = $i
          if (cand ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
            print "OLS-Dynamic", cand
          } else if (index(cand, ":") > 0) {
            print "OLS-Dynamic", cand
          }
        }
      }
    ' /tmp/lshttpd/.rtreport* >>"$out_file" 2>/dev/null
  fi
}

# ==============================================================================
# 3. BỘ MÁY NHẬP LIỆU (ĐỐI SỐ CLI, NHẬP TAY HOẶC FZF 00)
# ==============================================================================
route_flag="${1:-}"
cli_ip=""

if [[ -n "$route_flag" && "$route_flag" != "98" && "$route_flag" != "99" ]]; then
  cli_ip="$route_flag"
fi

if [[ -z "$cli_ip" ]]; then
  clear
  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}QUẢN LÝ IP ➜ Mở Khóa Địa Chỉ IP (Unblock IP)${C_RESET}" "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""
fi

ip=""

while true; do
  if [[ -n "$cli_ip" ]]; then
    ip_input="$cli_ip"
  else
    if command -v fzf >/dev/null 2>&1; then
      echo -en "${C_CYAN}Nhập IP muốn Mở khóa [00=Danh sách chọn nhanh, 0=Thoát]: ${C_RESET}"
    else
      echo -en "${C_CYAN}Nhập IP muốn Mở khóa [0=Thoát]: ${C_RESET}"
    fi
    read -r ip_input
  fi

  if [[ -z "${ip_input:-}" ]]; then
    ip_input="0"
  fi
  if [[ "$ip_input" == "0" ]]; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
    wptt_quay_ve_menu "$route_flag" 0
  fi

  ip="${ip_input//[[:space:]]/}"

  # Nhánh A: Chọn nhanh qua bảng FZF khi nhập 00
  if [[ "$ip" == "00" ]]; then
    if ! command -v fzf >/dev/null 2>&1; then
      echo -e "${C_RED}❌ Lỗi: Máy chủ chưa cài đặt công cụ FZF!${C_RESET}\n"
      if [[ -n "$cli_ip" ]]; then
        wptt_quay_ve_menu "$route_flag" 1 "enter"
      fi
      continue
    fi

    scan_msg="Quét danh sách IP đang bị chặn trên toàn hệ thống"
    _runing "$scan_msg"

    mkdir -p /etc/wptt/tmp 2>/dev/null
    TMP_LIST="$(mktemp -p /etc/wptt/tmp wptt_unblock_raw_XXXXXX.tmp)"
    TMP_SORTED="$(mktemp -p /etc/wptt/tmp wptt_unblock_sorted_XXXXXX.tmp)"

    wptt_scan_all_blocked_ips "$TMP_LIST"

    awk '
      NF >= 2 {
        src = $1
        addr = $2
        
        # CHUẨN HÓA IP: Tự động loại bỏ /32 (của IPv4) và /128 (của IPv6) để chống trùng lặp
        sub(/\/32$/, "", addr)
        sub(/\/128$/, "", addr)

        if (map[addr] == "") {
          map[addr] = src
        } else if (index(", " map[addr] ", ", ", " src ", ") == 0) {
          map[addr] = map[addr] ", " src
        }
      }
      END {
        for (addr in map) {
          printf "%-42s \x7c %s\n", addr, map[addr]
        }
      }
    ' "$TMP_LIST" >"$TMP_SORTED.unsorted"

    sort -V "$TMP_SORTED.unsorted" >"$TMP_SORTED" 2>/dev/null
    /bin/rm -f -- "$TMP_SORTED.unsorted" "${TMP_LIST:?}"
    TMP_LIST=""

    _rundone "$scan_msg"

    if [[ ! -s "$TMP_SORTED" ]]; then
      /bin/rm -f -- "${TMP_SORTED:?}"
      TMP_SORTED=""
      echo -e "\n${C_GREEN}✔ Hiện tại không có địa chỉ IP nào bị chặn trên hệ thống!${C_RESET}\n"
      if [[ -n "$cli_ip" ]]; then
        wptt_quay_ve_menu "$route_flag" 0 "enter"
      fi
      continue
    fi

    CHON_IP="$(fzf \
      --prompt="Chọn IP cần Mở khóa > " \
      --header="ĐỊA CHỈ IP / DẢI MẠNG                     ➜ NGUỒN CHẶN (Nhấn ESC để hủy)" \
      --layout=reverse --border=rounded --color=border:cyan --height=65% <"$TMP_SORTED")"

    /bin/rm -f -- "${TMP_SORTED:?}"
    TMP_SORTED=""

    if [[ -z "$CHON_IP" ]]; then
      echo -e "${C_YELLOW}Đã hủy thao tác chọn nhanh qua FZF.${C_RESET}\n"
      if [[ -n "$cli_ip" ]]; then
        wptt_quay_ve_menu "$route_flag" 0
      fi
      continue
    fi

    # Lấy cột đầu tiên (IP/CIDR) bằng read nội bộ (0 Subshell)
    read -r ip _ <<<"$CHON_IP"
    ip="${ip//[[:space:]]/}"
    echo -e "${C_CYAN}Đã chọn mở khóa IP: ${C_BOLD_WHITE}${ip}${C_RESET}"
    break

  # Nhánh B: Nhập tay -> Validate bằng Pure Bash
  else
    if wptt_validate_ip_pure_bash "$ip"; then
      ip="$VALIDATED_IP"
      break
    else
      echo -e "${C_RED}❌ Lỗi: Địa chỉ IP '${ip}' không hợp lệ! Vui lòng kiểm tra lại định dạng.${C_RESET}\n"
      if [[ -n "$cli_ip" ]]; then
        wptt_quay_ve_menu "$route_flag" 1 "enter"
      fi
    fi
  fi
done

# ==============================================================================
# 4. THỰC THI MỞ KHÓA TRÊN TOÀN BỘ HỆ THỐNG (ĐA TẦNG)
# ==============================================================================
echo ""
task_msg="Mở khóa địa chỉ IP $ip trên hệ thống"
_runing "$task_msg"

# Tách biệt dạng IP trần (không đuôi /32, /128) và dạng có CIDR để đối chiếu chính xác ở mọi tầng
ip_bare="${ip%/32}"
ip_bare="${ip_bare%/128}"
if [[ "$ip_bare" == *":"* ]]; then
  ip_host_cidr="${ip_bare}/128"
else
  ip_host_cidr="${ip_bare}/32"
fi

declare -a cleared_services=()

# ------------------------------------------------------------------------------
# 1. Mở khóa trên Fail2ban
# ------------------------------------------------------------------------------
if systemctl is-active --quiet fail2ban 2>/dev/null && command -v fail2ban-client >/dev/null 2>&1; then
  f2b_unbanned=0
  jail_raw="$(fail2ban-client status 2>/dev/null)"

  if [[ "$jail_raw" =~ Jail[[:space:]]list:[[:space:]]*(.*) ]]; then
    jail_list="${BASH_REMATCH[1]//,/ }"

    for jail in $jail_list; do
      [[ -n "$jail" ]] || continue

      jail_status="$(fail2ban-client status "$jail" 2>/dev/null)"

      if printf '%s\n' "$jail_status" |
        awk -v t1="$ip" -v t2="$ip_bare" '
          /Banned IP list:/ {
            for (i = 1; i <= NF; i++) {
              value = $i
              gsub(/,/, "", value)
              if (value == t1 || value == t2) found = 1
            }
          }
          END { exit !found }
        '; then

        if fail2ban-client set "$jail" unbanip "$ip_bare" >/dev/null 2>&1 ||
           fail2ban-client set "$jail" unbanip "$ip" >/dev/null 2>&1; then
          f2b_unbanned=1
        fi
      fi
    done
  fi

  if (( f2b_unbanned == 1 )); then
    cleared_services+=("Fail2ban")
  fi
fi

# ------------------------------------------------------------------------------
# 2. Mở khóa trên SSHGuard (Hỗ trợ toàn diện: DB, Firewalld, Nftables, Iptables/CSF)
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 2. Mở khóa trên SSHGuard (Surgical Unban - Chỉ gỡ đúng IP chỉ định, bảo toàn RAM)
# ------------------------------------------------------------------------------
if systemctl is-active --quiet sshguard 2>/dev/null || [[ -f /var/lib/sshguard/blacklist.db ]]; then
  sshg_unbanned=0

  # 2.1. Xóa tận gốc khỏi Blacklist Database (Khóa vĩnh viễn)
  sshg_db="/var/lib/sshguard/blacklist.db"
  if [[ -f "$sshg_db" ]] && awk -F'|' -v t1="$ip" -v t2="$ip_bare" '
    {
      cand = (NF >= 4) ? $4 : $1
      gsub(/[[:space:]]/, "", cand)
      if (cand == t1 || cand == t2) f = 1
    }
    END { exit !f }
  ' "$sshg_db" 2>/dev/null; then
    mkdir -p /etc/wptt/tmp 2>/dev/null
    sshg_tmp="$(/bin/mktemp -p "/etc/wptt/tmp" "sshguard_blacklist_XXXXXX.tmp")"
    if [[ -n "$sshg_tmp" ]]; then
      if awk -F'|' -v t1="$ip" -v t2="$ip_bare" '
        {
          cand = (NF >= 4) ? $4 : $1
          gsub(/[[:space:]]/, "", cand)
          if (cand != t1 && cand != t2) print $0
        }
      ' "$sshg_db" >"$sshg_tmp" && cat "$sshg_tmp" >"$sshg_db"; then
        sshg_unbanned=1
      fi
      /bin/rm -f -- "${sshg_tmp:?}"
    fi
  fi

  # 2.2. Xóa đích danh IP khỏi Firewalld (Tự động quét cả IP trần, IP/32, IP/128 VÀ Kernel set)
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    fw_ipset="sshguard4"
    [[ "$ip_bare" == *":"* ]] && fw_ipset="sshguard6"

    for cand_entry in "$ip" "$ip_bare" "$ip_host_cidr"; do
      if firewall-cmd --ipset="$fw_ipset" --query-entry="$cand_entry" >/dev/null 2>&1; then
        if firewall-cmd --ipset="$fw_ipset" --remove-entry="$cand_entry" >/dev/null 2>&1; then
          sshg_unbanned=1
        fi
        firewall-cmd --permanent --ipset="$fw_ipset" --remove-entry="$cand_entry" >/dev/null 2>&1 || true
      fi
    done

    # Gỡ trực tiếp phần tử đó trong bảng 'inet firewalld' của Nftables
    if command -v nft >/dev/null 2>&1; then
      if nft delete element inet firewalld "$fw_ipset" "{ $ip_bare }" >/dev/null 2>&1 ||
         nft delete element inet firewalld "$fw_ipset" "{ $ip }" >/dev/null 2>&1; then
        sshg_unbanned=1
      fi
    fi
  fi

  # 2.3. Xóa đích danh IP khỏi Nftables (Khi dùng backend sshg-fw-nft-sets)
  if command -v nft >/dev/null 2>&1; then
    nft_family="ip"
    [[ "$ip_bare" == *":"* ]] && nft_family="ip6"

    for tbl in "$nft_family" "inet"; do
      if nft delete element "$tbl" sshguard attackers "{ $ip_bare }" >/dev/null 2>&1 ||
         nft delete element "$tbl" sshguard attackers "{ $ip }" >/dev/null 2>&1; then
        sshg_unbanned=1
      fi
    done
  fi

  # 2.4. Xóa đích danh IP khỏi Iptables / Ip6tables (Khi chạy cùng CSF hoặc sshg-fw-iptables)
  if [[ "$ip_bare" == *":"* ]]; then
    if command -v ip6tables >/dev/null 2>&1; then
      while ip6tables -w -D sshguard -s "$ip_bare" -j DROP >/dev/null 2>&1 ||
            ip6tables -w -D sshguard -s "$ip_host_cidr" -j DROP >/dev/null 2>&1 ||
            ip6tables -w -D sshguard -s "$ip" -j DROP >/dev/null 2>&1; do
        sshg_unbanned=1
      done
    fi
  else
    if command -v iptables >/dev/null 2>&1; then
      while iptables -w -D sshguard -s "$ip_bare" -j DROP >/dev/null 2>&1 ||
            iptables -w -D sshguard -s "$ip_host_cidr" -j DROP >/dev/null 2>&1 ||
            iptables -w -D sshguard -s "$ip" -j DROP >/dev/null 2>&1; do
        sshg_unbanned=1
      done
    fi
  fi

  # 2.5. Ghi nhận trạng thái (TUYỆT ĐỐI KHÔNG RESTART SSHGUARD ĐỂ BẢO TOÀN CÁC IP KHÁC TRÊN RAM)
  if (( sshg_unbanned == 1 )); then
    cleared_services+=("SSHGuard")
  fi
fi
# ------------------------------------------------------------------------------
# 3. Mở khóa trên CSF Firewall (Cả Vĩnh viễn & Tempban)
# ------------------------------------------------------------------------------
if command -v csf >/dev/null 2>&1 && [[ -f /etc/csf/csf.conf ]]; then
  csf_cleared=0
  csf_out="$(csf -dr "$ip" 2>/dev/null)"
  if [[ "$csf_out" == *"Removing"* || "$csf_out" == *"csf.deny"* ]]; then
    csf_cleared=1
  fi
  csf_temp_out="$(csf -tr "$ip" 2>/dev/null)"
  if [[ "$csf_temp_out" == *"Removing"* || "$csf_temp_out" == *"tempban"* ]]; then
    csf_cleared=1
  fi
  if (( csf_cleared == 1 )); then
    cleared_services+=("CSF Firewall")
  fi
fi

# ------------------------------------------------------------------------------
# 4. Mở khóa trên Nftables (Rule riêng của WPTangToc)
# ------------------------------------------------------------------------------
if systemctl is-active --quiet nftables 2>/dev/null; then
  if [[ -f /etc/wptt/bao-mat/nftables/unban.sh ]]; then
    if /bin/bash /etc/wptt/bao-mat/nftables/unban.sh "$ip" >/dev/null 2>&1; then
      cleared_services+=("Nftables")
    fi
  fi
fi

# ------------------------------------------------------------------------------
# 5. Mở khóa trên Firewalld (Zone Drop)
# ------------------------------------------------------------------------------
if systemctl is-active --quiet firewalld 2>/dev/null; then
  fw_zone_cleared=0
  for cand_src in "$ip" "$ip_bare" "$ip_host_cidr"; do
    if firewall-cmd --zone=drop --query-source="$cand_src" >/dev/null 2>&1; then
      firewall-cmd --zone=drop --remove-source="$cand_src" >/dev/null 2>&1
      firewall-cmd --permanent --zone=drop --remove-source="$cand_src" >/dev/null 2>&1
      fw_zone_cleared=1
    fi
  done
  if (( fw_zone_cleared == 1 )); then
    cleared_services+=("Firewalld")
  fi
fi

# ------------------------------------------------------------------------------
# 6. Mở khóa trên OpenLiteSpeed Dynamic Anti-DDoS
# ------------------------------------------------------------------------------
rtreport_list=(/tmp/lshttpd/.rtreport*)
if [[ -e "${rtreport_list[0]}" ]]; then
  if awk -v target="$ip_bare" '/^BLOCKED_IP:/ && index($0, target) > 0 { found=1; exit } END { exit !found }' /tmp/lshttpd/.rtreport* 2>/dev/null; then
    if declare -F wptt_smart_reload_lsws >/dev/null 2>&1; then
      wptt_smart_reload_lsws >/dev/null 2>&1
    else
      if ! /usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1; then
        /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
      fi
    fi
    cleared_services+=("OpenLiteSpeed Anti-DDoS")
  fi
fi

# ==============================================================================
# 5. GHI LOG VÀ BÁO CÁO HOÀN TẤT
# ==============================================================================
_rundone "$task_msg"

FIREWALL_CLEARED=""
for svc in "${cleared_services[@]+"${cleared_services[@]}"}"; do
  if [[ -n "$svc" ]]; then
    FIREWALL_CLEARED+="${svc}, "
  fi
done
FIREWALL_CLEARED="${FIREWALL_CLEARED%, }"

if [[ -z "$FIREWALL_CLEARED" ]]; then
  FIREWALL_CLEARED="Không phát hiện thấy IP này trong danh sách chặn"
fi

wptt_logs "INFO" "Mở khóa IP $ip (Dịch vụ: $FIREWALL_CLEARED)"

echo ""
print_border_top "$C_GREEN"
center_text "${C_BOLD_WHITE}HOÀN TẤT GỠ CHẶN ĐỊA CHỈ IP${C_RESET}" "$C_GREEN"
print_border_mid "$C_GREEN"
left_text "Địa chỉ ân xá   : ${C_YELLOW}${ip}${C_RESET}" 2 "$C_GREEN"
left_text "Dịch vụ đã gỡ   : ${C_BOLD_WHITE}${FIREWALL_CLEARED}${C_RESET}" 2 "$C_GREEN"
left_text "Trạng thái      : ${C_GREEN}Đã khôi phục quyền truy cập vào máy chủ.${C_RESET}" 2 "$C_GREEN"
print_border_bot "$C_GREEN"

wptt_quay_ve_menu "$route_flag" 0 "enter"
