# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Khóa địa chỉ IP và dải CIDR ở tầng L3/L4 kèm cơ chế chống tự khóa SSH (Bản Enterprise chống lỗi hiển thị)

function huong_dan() {
  cat <<'EOF'
  Tính năng Chặn IP trong WPTangToc OLS là một công cụ bảo mật quan trọng, cho phép người quản trị máy chủ ngăn chặn truy cập từ các địa chỉ IP cụ thể đến website hoặc toàn bộ máy chủ. Đây là một biện pháp hiệu quả để đối phó với các hoạt động gây hại như tấn công DDoS, brute-force, spam, hoặc truy cập trái phép từ những nguồn đã biết.
EOF
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
stty iutf8 2>/dev/null

# shellcheck source=/dev/null
. /etc/wptt/.wptt.conf 2>/dev/null
if [[ -z "${ngon_ngu:-}" ]]; then
  ngon_ngu='vi'
fi
# shellcheck source=/dev/null
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/echo-color 2>/dev/null
# shellcheck source=/dev/null
. /etc/wptt/core-functions 2>/dev/null

if ! declare -F wptt_quay_ve_menu >/dev/null 2>&1; then
  wptt_quay_ve_menu() {
    local route_arg="${1:-}"
    local exit_code="${2:-0}"
    local wait_enter="${3:-}"
    local is_menu=0
    [[ "$route_arg" == "98" ]] && is_menu=1
    [[ "$route_arg" == "99" ]] && is_menu=1

    if ((is_menu == 1)); then
      if [[ "${wait_enter,,}" == "enter" ]]; then
        echo ""
        read -rp "➜ Nhấn phím [Enter] để quay về Menu... " _
      fi
      if [[ "$route_arg" == "99" ]]; then
        exec /usr/bin/wptangtoc 1
      fi
      exec "${WPTT_CURRENT_MENU:-/etc/wptt/wptt-bao-mat-main}" 1
    fi
    if ! return "$exit_code" 2>/dev/null; then
      exit "$exit_code"
    fi
  }
fi

# ==============================================================================
# 1. HÀM KIỂM TRA & CHUẨN HÓA IPV4 / IPV6 / CIDR THUẦN BASH (0 SUBSHELL)
# ==============================================================================
VALIDATED_IP=""
IP_FAMILY=""

wptt_validate_ip_pure_bash() {
  local raw_input="$1"
  local addr="$raw_input"
  local cidr=""

  VALIDATED_IP=""
  IP_FAMILY=""

  if [[ "$raw_input" == *"/"* ]]; then
    addr="${raw_input%%/*}"
    cidr="${raw_input#*/}"
    if [[ ! "$cidr" =~ ^[0-9]{1,3}$ ]]; then
      return 1
    fi
  fi

  # A. Kiểm tra chuẩn IPv4
  if [[ "$addr" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    local o1="${BASH_REMATCH[1]}"
    local o2="${BASH_REMATCH[2]}"
    local o3="${BASH_REMATCH[3]}"
    local o4="${BASH_REMATCH[4]}"

    if ((10#$o1 <= 255 && 10#$o2 <= 255 && 10#$o3 <= 255 && 10#$o4 <= 255)); then
      if [[ -n "$cidr" ]]; then
        if ((10#$cidr < 8)); then
          return 1
        fi
        if ((10#$cidr > 32)); then
          return 1
        fi
        VALIDATED_IP="$((10#$o1)).$((10#$o2)).$((10#$o3)).$((10#$o4))/$((10#$cidr))"
      else
        VALIDATED_IP="$((10#$o1)).$((10#$o2)).$((10#$o3)).$((10#$o4))"
      fi
      IP_FAMILY="ipv4"
      return 0
    fi
    return 1
  fi

  # B. Kiểm tra chuẩn IPv6
  if [[ "$addr" == *":"* && "$addr" != *":::"* ]]; then
    if [[ "$addr" =~ ^:[0-9a-fA-F] ]]; then
      return 1
    fi
    if [[ "$addr" =~ [0-9a-fA-F]:$ ]]; then
      return 1
    fi
    local check_dc="${addr/::/@}"
    if [[ "$check_dc" == *"::"* ]]; then
      return 1
    fi

    local IFS=':'
    local -a hextets=()
    read -r -a hextets <<<"$addr"
    if ((${#hextets[@]} <= 8)); then
      local h
      local valid_v6=1
      for h in "${hextets[@]}"; do
        [[ -z "$h" ]] && continue
        if [[ ! "$h" =~ ^[0-9a-fA-F]{1,4}$ && ! "$h" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
          valid_v6=0
          break
        fi
      done
      if ((valid_v6 == 1)); then
        if [[ -n "$cidr" ]]; then
          if ((10#$cidr < 16)); then
            return 1
          fi
          if ((10#$cidr > 128)); then
            return 1
          fi
          VALIDATED_IP="${addr,,}/$((10#$cidr))"
        else
          VALIDATED_IP="${addr,,}"
        fi
        IP_FAMILY="ipv6"
        return 0
      fi
    fi
  fi

  return 1
}

# ==============================================================================
# 2. HÀM CHỐNG TỰ KHÓA MÌNH (SELF-LOCKOUT GUARD)
# ==============================================================================
wptt_is_protected_ip() {
  local check_target="${1%%/*}"
  local reason_var="$2"
  local msg=""

  if [[ "$check_target" == 127.* ]] ||
    [[ "$check_target" == "0.0.0.0" ]] ||
    [[ "$check_target" == "::1" ]] ||
    [[ "$check_target" == "::" ]] ||
    [[ "$check_target" == fe80:* ]]; then
    msg="Đây là địa chỉ Loopback / Nội bộ của hệ thống!"
    printf -v "$reason_var" '%s' "$msg"
    return 0
  fi

  if [[ "$check_target" == "8.8.8.8" ]] ||
    [[ "$check_target" == "8.8.4.4" ]] ||
    [[ "$check_target" == "1.1.1.1" ]] ||
    [[ "$check_target" == "1.0.0.1" ]] ||
    [[ "$check_target" == "2001:4860:4860::8888" ]] ||
    [[ "$check_target" == "2606:4700:4700::1111" ]]; then
    msg="Đây là máy chủ DNS quốc tế (Google/Cloudflare), khóa sẽ làm VPS mất kết nối tên miền!"
    printf -v "$reason_var" '%s' "$msg"
    return 0
  fi

  local current_ssh_ip=""
  if [[ -n "${SSH_CLIENT:-}" ]]; then
    current_ssh_ip="${SSH_CLIENT%% *}"
  elif [[ -n "${SSH_CONNECTION:-}" ]]; then
    current_ssh_ip="${SSH_CONNECTION%% *}"
  fi
  current_ssh_ip="${current_ssh_ip#::ffff:}"

  if [[ -n "$current_ssh_ip" && "${check_target,,}" == "${current_ssh_ip,,}" ]]; then
    msg="Đây chính là địa chỉ IP mạng hiện tại của bạn đang kết nối SSH vào VPS!"
    printf -v "$reason_var" '%s' "$msg"
    return 0
  fi

  if [[ -n "${IP_SERVER:-}" && "${check_target,,}" == "${IP_SERVER,,}" ]]; then
    msg="Đây là địa chỉ IP chính của máy chủ VPS này!"
    printf -v "$reason_var" '%s' "$msg"
    return 0
  fi

  local host_ips
  host_ips="$(hostname -I 2>/dev/null)"
  if [[ " $host_ips " == *" $check_target "* ]]; then
    msg="Địa chỉ IP này thuộc về card mạng của chính máy chủ VPS!"
    printf -v "$reason_var" '%s' "$msg"
    return 0
  fi

  return 1
}

# ==============================================================================
# 3. NHẬN DỮ LIỆU ĐẦU VÀO
# ==============================================================================
route_flag="${1:-}"
cli_ip=""

if [[ -n "$route_flag" && "$route_flag" != "98" && "$route_flag" != "99" ]]; then
  cli_ip="$route_flag"
fi

if [[ -z "$cli_ip" ]]; then
  clear
  echo ""
  print_border_top "$C_CYAN"
  center_text "${C_YELLOW}QUẢN LÝ IP ➜ Khóa Địa Chỉ IP (Block IP)${C_RESET}" "$C_CYAN"
  print_border_bot "$C_CYAN"
  echo ""
fi

while true; do
  if [[ -n "$cli_ip" ]]; then
    ip="$cli_ip"
  else
    echo -en "${C_CYAN}Nhập địa chỉ IPv4 / IPv6 muốn Khóa [0=Thoát]: ${C_RESET}"
    read -r ip
  fi

  if [[ -z "${ip:-}" ]]; then
    ip="0"
  fi
  if [[ "$ip" == "0" ]]; then
    echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}\n"
    wptt_quay_ve_menu "$route_flag" 0
  fi

  ip="${ip//[[:space:]]/}"

  if ! wptt_validate_ip_pure_bash "$ip"; then
    echo -e "${C_RED}❌ Lỗi: Địa chỉ IP '${ip}' không hợp lệ! Vui lòng kiểm tra lại định dạng.${C_RESET}"
    if [[ -n "$cli_ip" ]]; then
      wptt_quay_ve_menu "$route_flag" 1 "enter"
    fi
    continue
  fi

  ip="$VALIDATED_IP"
  protect_reason=""
  if wptt_is_protected_ip "$ip" protect_reason; then
    echo -e "${C_RED}🛡️ CẢNH BÁO BẢO VỆ: Từ chối khóa IP ${C_BOLD_WHITE}${ip}${C_RED}!${C_RESET}"
    echo -e "${C_YELLOW}Lý do: ${protect_reason}${C_RESET}\n"
    if [[ -n "$cli_ip" ]]; then
      wptt_quay_ve_menu "$route_flag" 1 "enter"
    fi
    continue
  fi

  break
done

# ==============================================================================
# 4. THỰC THI KHÓA IP TRÊN TƯỜNG LỬA (TẦNG L3/L4)
# ==============================================================================
echo ""
task_msg="Khóa địa chỉ IP $ip trên hệ thống tường lửa"
_runing "$task_msg"

FIREWALL_USED="Chưa xác định"
already_blocked=0
block_success=0

if command -v csf >/dev/null 2>&1 && [[ -f /etc/csf/csf.conf ]]; then
  FIREWALL_USED="CSF Firewall"
  if [[ -f /etc/csf/csf.deny ]] && awk -v target="$ip" '$1 == target { found=1; exit } END { exit !found }' /etc/csf/csf.deny 2>/dev/null; then
    already_blocked=1
  elif csf -d "$ip" "Khoa tu WPTangToc OLS" >/dev/null 2>&1; then
    block_success=1
  fi

elif systemctl is-active --quiet nftables 2>/dev/null; then
  FIREWALL_USED="Nftables"
  if [[ -f /etc/wptt/bao-mat/nftables/block-ip-nftables.sh ]]; then
    if /bin/bash /etc/wptt/bao-mat/nftables/block-ip-nftables.sh "$ip" >/dev/null 2>&1; then
      block_success=1
    fi
  fi

elif systemctl is-active --quiet firewalld 2>/dev/null; then
  FIREWALL_USED="Firewalld (Zone Drop)"
  if firewall-cmd --zone=drop --query-source="$ip" >/dev/null 2>&1; then
    already_blocked=1
  else
    if firewall-cmd --zone=drop --add-source="$ip" >/dev/null 2>&1 &&
      firewall-cmd --permanent --zone=drop --add-source="$ip" >/dev/null 2>&1; then
      block_success=1
    fi
  fi
fi

if ((already_blocked == 1)); then
  _rundone "$task_msg"
  echo -e "\n${C_YELLOW}ℹ THÔNG BÁO: Địa chỉ IP ${C_BOLD_WHITE}${ip}${C_YELLOW} đã nằm sẵn trong danh sách chặn của ${FIREWALL_USED}!${C_RESET}"
  wptt_quay_ve_menu "$route_flag" 0 "enter"
fi

if ((block_success == 0)); then
  _runloi "$task_msg"
  if [[ "$FIREWALL_USED" == "Chưa xác định" ]]; then
    echoDo "Hệ thống không tìm thấy tường lửa nào đang hoạt động (CSF, Nftables, Firewalld)!"
    echo -e "${C_YELLOW}Gợi ý: Vui lòng bật tường lửa trong Menu Bảo Mật trước khi sử dụng tính năng khóa IP.${C_RESET}"
  else
    echoDo "Không thể thêm luật chặn IP $ip vào ${FIREWALL_USED}. Vui lòng kiểm tra trạng thái dịch vụ tường lửa."
  fi
  wptt_logs "ERROR" "Khóa IP $ip thất bại (Firewall: $FIREWALL_USED)"
  wptt_quay_ve_menu "$route_flag" 1 "enter"
fi

# ==============================================================================
# 5. CẮT ĐỨT KẾT NỐI TCP TRÊN RAM (SOCKET & CONNTRACK)
# ==============================================================================
target_ip_only="${ip%%/*}"

if command -v ss >/dev/null 2>&1; then
  if [[ "$IP_FAMILY" == "ipv6" ]]; then
    if ! ss -K dst "[${target_ip_only}]" >/dev/null 2>&1; then
      ss -K dst "$ip" >/dev/null 2>&1
    fi
  else
    ss -K dst "$ip" >/dev/null 2>&1
  fi
fi

if command -v conntrack >/dev/null 2>&1; then
  if [[ "$IP_FAMILY" == "ipv6" ]]; then
    conntrack -D -f ipv6 -s "$target_ip_only" >/dev/null 2>&1
    conntrack -D -f ipv6 -d "$target_ip_only" >/dev/null 2>&1
  else
    conntrack -D -f ipv4 -s "$target_ip_only" >/dev/null 2>&1
    conntrack -D -f ipv4 -d "$target_ip_only" >/dev/null 2>&1
  fi
fi

# ==============================================================================
# 6. GHI LOG VÀ BÁO CÁO HOÀN TẤT
# ==============================================================================
_rundone "$task_msg"
wptt_logs "INFO" "Đã khóa IP $ip bằng $FIREWALL_USED"

echo ""
print_border_top "$C_GREEN"
center_text "${C_BOLD_WHITE}HOÀN TẤT CHẶN ĐỊA CHỈ IP${C_RESET}" "$C_GREEN"
print_border_mid "$C_GREEN"
left_text "Địa chỉ bị cấm  : ${C_RED}${ip}${C_RESET} (${IP_FAMILY^^})" 2 "$C_GREEN"
left_text "Tường lửa xử lý : ${C_YELLOW}${FIREWALL_USED}${C_RESET}" 2 "$C_GREEN"
left_text "Trạng thái      : ${C_BOLD_WHITE}Đã cắt đứt toàn bộ kết nối đến máy chủ.${C_RESET}" 2 "$C_GREEN"
print_border_bot "$C_GREEN"

wptt_quay_ve_menu "$route_flag" 0 "enter"
