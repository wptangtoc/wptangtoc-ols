function huong_dan() {
Tính năng Thùng rác ảo [Virtual Trash] trong WPTangToc OLS là lá chắn bảo vệ an toàn dữ liệu, chống lại các sai sót vô tình khi xóa website.

[ Giới thiệu ngắn gọn ]
Mục đích: Cung cấp cơ chế "Soft Delete", thay vì xóa vĩnh viễn [rm -rf], hệ thống sẽ dời mã nguồn và Database vào một khu vực an toàn, cho phép phục hồi khi cần thiết.

[ Cách hoạt động ]
* Lưu trữ tạm thời: Website bị xóa sẽ được dời vào /usr/local/.wptt_trash.
* Bảo toàn Database: Sử dụng kỹ thuật RENAME TABLE để đưa Database vào thùng rác ngay lập tức mà không tốn thêm dung lượng sao lưu.
* Dọn dẹp tự động: Cronjob hệ thống sẽ tự động quét và tiêu hủy vĩnh viễn các dữ liệu nằm trong thùng rác vượt quá số ngày quy định.

[ Lợi ích ]
* An tâm tuyệt đối: Tránh thảm họa "lỡ tay" xóa nhầm website quan trọng.
* Tối ưu I/O: Quá trình đưa vào thùng rác diễn ra dưới 0.1 giây, không gây nghẽn ổ đĩa.
* Linh hoạt: Cho phép bật/tắt hoặc điều chỉnh thời gian lưu trữ phù hợp với mọi cấu hình ổ cứng VPS.
}


if [[ -z "$1" ]]; then
  . /etc/wptt/wptt-header-menu
  header_menu
else
  . /etc/wptt/echo-color 2>/dev/null
  echoDo "────────────────────────────────────────────────────────────────────────────────"
fi

# Load cấu hình gốc và thiết lập giá trị mặc định nếu chưa có
. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null

[[ -z "$WPTT_TRASH_ENABLE" ]] && WPTT_TRASH_ENABLE=1
[[ -z "$WPTT_TRASH_DAYS" ]] && WPTT_TRASH_DAYS=3
[[ -z "$WPTT_TRASH_PATH" ]] && WPTT_TRASH_PATH="/usr/local/.wptt_trash"

echo ""
echo "Quản lý Thùng rác ảo:" >/dev/null

# ==============================================================================
# 2. KHAI BÁO TIÊU ĐỀ MENU VÀ OPTIONS
# ==============================================================================
MENU_TITLE="TRUNG TÂM QUẢN LÝ THÙNG RÁC ẢO (VIRTUAL TRASH)"

options=(
  "Xem danh sách website trong thùng rác"    # 0 -> Phím 1
  "Phục hồi website (Restore)"               # 1 -> Phím 2
  "Dọn sạch thùng rác ngay lập tức"          # 2 -> Phím 3
  
  "Bật / Tắt tính năng Thùng rác ảo"         # 3 -> Phím 4
  "Thay đổi số ngày lưu trữ tự động"         # 4 -> Phím 5
)

# ==============================================================================
# 3. LOGIC XỬ LÝ
# ==============================================================================
run_action() {
  local index=$1
  local script_path=""
  local script_args="98" # Truyền tham số để bỏ qua header ở file con nếu cần

  case $index in
    0) script_path="/etc/wptt/trash/wptt-trash-list" ;;
    1) script_path="/etc/wptt/trash/wptt-trash-restore" ;;
    2) script_path="/etc/wptt/trash/wptt-trash-empty" ;;
    3) script_path="/etc/wptt/trash/wptt-bat-tat-trash" ;;
    4) script_path="/etc/wptt/trash/wptt-trash-set-days" ;;
    *) 
       echo -e "\n${C_RED}[!] Lựa chọn không hợp lệ.${C_RESET}"
       sleep 1
       return 1
       ;;
  esac

  if [[ -x "$script_path" || -f "$script_path" ]]; then
    bash "$script_path" "$script_args"
  else
    echo -e "\n${C_RED}[!] Tính năng đang được phát triển hoặc thiếu file module '${script_path}'.${C_RESET}"
    sleep 2
    bash /etc/wptt/wptt-thung-rac-main 1
  fi
}

# ==============================================================================
# 4. GIAO DIỆN TÙY CHỈNH (DYNAMIC UX)
# ==============================================================================
draw_custom_grid() {
  # Đọc lại file cấu hình Real-time mỗi lần vẽ lại Menu để cập nhật trạng thái tức thì
  . /etc/wptt/.wptt.conf 2>/dev/null
  [[ -z "$WPTT_TRASH_ENABLE" ]] && WPTT_TRASH_ENABLE=1
  [[ -z "$WPTT_TRASH_DAYS" ]] && WPTT_TRASH_DAYS=3

  # Xử lý Logic hiển thị UI
  local trash_status="${C_GREEN}ĐANG BẬT${C_RESET}"
  [[ "$WPTT_TRASH_ENABLE" -eq 0 ]] && trash_status="${C_RED}ĐANG TẮT${C_RESET}"

  local count_web=0
  local size_trash="0 B"
  
  if [[ -d "$WPTT_TRASH_PATH" ]]; then
    # Tính số lượng thư mục bên trong (mỗi thư mục là 1 website)
    count_web=$(find "$WPTT_TRASH_PATH" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    # Tính tổng dung lượng (Zero-fork nếu trống, tính gộp nếu có file)
    size_trash=$(du -sh "$WPTT_TRASH_PATH" 2>/dev/null | awk '{print $1}')
    [[ -z "$size_trash" ]] && size_trash="0 B"
  fi

  # Render Panel Thông tin
  print_spacer
  left_text "${MARGIN}${C_YELLOW} THÔNG TIN HIỆN TẠI:${C_RESET}"
  left_text "${MARGIN} ‣ Trạng thái hệ thống: ${trash_status}"
  left_text "${MARGIN} ‣ Lịch tự động xóa   : ${C_CYAN}Sau ${WPTT_TRASH_DAYS} Ngày${C_RESET}"
  left_text "${MARGIN} ‣ Đang giam giữ      : ${C_BOLD_WHITE}${count_web} Website${C_RESET} (Tổng dung lượng: ${C_YELLOW}${size_trash}${C_RESET})"
  
  print_spacer
  echo -e "${MARGIN}${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  print_spacer

  # Render Menu Lựa chọn
  print_full_row "" "CÔNG CỤ PHỤC HỒI & DỌN DẸP"
  print_full_row "1" "${options[0]}"
  print_full_row "2" "${options[1]}"
  print_full_row "3" "${options[2]}"

  print_spacer

  print_full_row "" "CẤU HÌNH HỆ THỐNG"
  print_full_row "4" "${options[3]}"
  print_full_row "5" "${options[4]}"
}

# Khởi động Engine Vòng lặp Menu
. /etc/wptt/wptt-callback-menu-chon
