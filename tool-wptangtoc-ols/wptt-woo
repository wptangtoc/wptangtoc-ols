#!/bin/bash
# Cấu hình webserver dành cho Woocommerce

[[ -f /etc/wptt/.wptt.conf ]] && . /etc/wptt/.wptt.conf

# shellcheck source=/dev/null
[[ -f /etc/wptt/echo-color ]] && . /etc/wptt/echo-color

# shellcheck source=/dev/null
[[ -f /etc/wptt/core-functions ]] && . /etc/wptt/core-functions 2>/dev/null

# Khởi tạo các hàm fallback (dự phòng) trong trường hợp file core bị thiếu, 
# tránh văng lỗi "command not found"
declare -F _runing >/dev/null || _runing() { echo "RUNNING: $*"; }
declare -F wptt_logs >/dev/null || wptt_logs() { echo "[$1] $2"; }
declare -F _rundone >/dev/null || _rundone() { echo "DONE: $*"; }
declare -F wptt_smart_reload_lsws >/dev/null || wptt_smart_reload_lsws() { :; }

_runing "Cấu hình webserver dành cho Woocommerce"
wptt_logs "INFO" "Thiết lập cấu hình Woocommerce webserver"

# Kiểm tra PHP CLI có tồn tại không trước khi gọi
if ! command -v php >/dev/null 2>&1; then
    wptt_logs "ERROR" "Lệnh 'php' không tồn tại. Vui lòng kiểm tra lại môi trường."
    exit 1
fi

# Lấy đường dẫn php.ini hiện tại, lấy dòng đầu tiên match để tránh rác
php_cli=$(php -i 2>/dev/null | grep -m 1 "Loaded Configuration File" | awk '{print $5}')

if [[ -z "$php_cli" || ! -f "$php_cli" ]]; then
    wptt_logs "ERROR" "Không tìm thấy file php.ini hợp lệ từ cấu hình CLI."
    exit 1
fi

# Dùng Bash Regex để tách lấy phiên bản (vd: lsphp81) thay vì dùng lệnh 'cut' cứng nhắc
if [[ "$php_cli" =~ (lsphp[0-9]+) ]]; then
    php_cli_version="${BASH_REMATCH[1]}"
else
    wptt_logs "ERROR" "Không thể trích xuất chuỗi phiên bản 'lsphp' từ đường dẫn: $php_cli"
    exit 1
fi

lsws_dir="/usr/local/lsws"

# Kiểm tra xem thư mục có tồn tại không trước khi lặp
if [[ -d "$lsws_dir" ]]; then
    # Bật tính năng nullglob để nếu không có file nào khớp thì không ném ra lỗi string literal
    shopt -s nullglob
    
    # Dùng File Globbing thay vì 'ls | grep' (Chuẩn SC2012, SC2207)
    for dir_path in "$lsws_dir"/lsphp[0-9]*; do
        php_all=$(basename "$dir_path")
        
        # Thay thế phiên bản trong chuỗi đường dẫn
        php_config="${php_cli//$php_cli_version/$php_all}"

        if [[ -f "$php_config" ]]; then
            # Thay đổi các thông số cấu hình
            sed -i '/memory_limit/d' "$php_config"
            sed -i '/memory-limit/a memory_limit = 256M' "$php_config"

            sed -i '/max_input_time/d' "$php_config"
            sed -i '/max-input-time/a max_input_time = 120' "$php_config"

            # Tối ưu: Gom chung các lệnh xóa vào một lần gọi sed (tiết kiệm I/O)
            sed -i -e '/opcache.memory_consumption/d' \
                   -e '/opcache.interned_strings_buffer/d' \
                   -e '/opcache.max_accelerated_files/d' "$php_config"

            # Tối ưu: Sử dụng Here-Doc thay cho lệnh echo qua nhiều dòng
            cat >> "$php_config" <<EOF
opcache.memory_consumption=256
opcache.max_accelerated_files=20000
opcache.interned_strings_buffer=16
EOF
        fi
    done
    
    # Tắt nullglob trả về trạng thái mặc định cho bash
    shopt -u nullglob
fi

wptt_smart_reload_lsws >/dev/null 2>&1
_rundone "Cấu hình webserver dành cho Woocommerce"
