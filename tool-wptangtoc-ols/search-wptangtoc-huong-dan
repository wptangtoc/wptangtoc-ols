wptt_fzf_previewer() {
  local f_title="$1"
  local script_to_preview="$2"
  local search_query="${3:-}"

  printf "\033[1;36m📖 %s\033[0m\n" "$f_title"
  printf "\033[90m──────────────────────────────────────────────────────────────────────────────\033[0m\n"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    printf "\033[0;33m⚠️ Không tìm thấy tệp thực thi (%s).\033[0m\n" "$script_to_preview"
    return 0
  fi

  local alt_regex="" word esc_word i ch
  if [[ -n "$search_query" ]]; then
    for word in $search_query; do
      ((${#word} < 2)) && continue
      esc_word=""
      for ((i = 0; i < ${#word}; i++)); do
        ch="${word:i:1}"
        case "$ch" in
          '\' | '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|') esc_word+="\\$ch" ;;
          'a' | 'A') esc_word+="(a|à|á|ả|ã|ạ|ă|ằ|ắ|ẳ|ẵ|ặ|â|ầ|ấ|ẩ|ẫ|ậ)" ;;
          'd' | 'D') esc_word+="(d|đ)" ;;
          'e' | 'E') esc_word+="(e|è|é|ẻ|ẽ|ẹ|ê|ề|ế|ể|ễ|ệ)" ;;
          'i' | 'I') esc_word+="(i|ì|í|ỉ|ĩ|ị)" ;;
          'o' | 'O') esc_word+="(o|ò|ó|ỏ|õ|ọ|ô|ồ|ố|ổ|ỗ|ộ|ơ|ờ|ớ|ở|ỡ|ợ)" ;;
          'u' | 'U') esc_word+="(u|ù|ú|ủ|ũ|ụ|ư|ừ|ứ|ử|ữ|ự)" ;;
          'y' | 'Y') esc_word+="(y|ỳ|ý|ỷ|ỹ|ỵ)" ;;
          *) esc_word+="$ch" ;;
        esac
      done
      if [[ -n "$alt_regex" ]]; then
        alt_regex+="|${esc_word}"
      else
        alt_regex="${esc_word}"
      fi
    done
  fi

  local active=0 has_content=0 line trimmed
  shopt -s nocasematch
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?huong_dan[[:space:]]*\(\)[[:space:]]*\{ ]]; then
        active=1
      fi
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*\} ]]; then
      break
    fi

    if [[ "$line" =~ ^[[:space:]]*cat[[:space:]]+\<\<-?[[:space:]]*[\'\"]?EOF[\'\"]? ]] || [[ "$line" =~ ^[[:space:]]*EOF[[:space:]]*$ ]]; then
      continue
    fi

    trimmed="${line#"${line%%[![:space:]]*}"}"
    if [[ "$trimmed" =~ ^echo([[:space:]]+-[eEn]+)?[[:space:]]+(.*)$ ]]; then
      line="${BASH_REMATCH[2]}"
      if [[ "$line" == \"*\" ]]; then
        line="${line#\"}"
        line="${line%\"}"
      elif [[ "$line" == \'*\' ]]; then
        line="${line#\'}"
        line="${line%\'}"
      fi
    fi

    has_content=1

    if [[ -n "$alt_regex" && "$line" =~ ($alt_regex) ]]; then
      local out="" rest="$line" m_str prefix
      while [[ "$rest" =~ ($alt_regex) ]]; do
        m_str="${BASH_REMATCH[1]}"
        [[ -z "$m_str" ]] && break
        prefix="${rest%%"$m_str"*}"
        out+="${prefix}"$'\033[1;33;4m'"${m_str}"$'\033[0m'
        rest="${rest#*"$m_str"}"
      done
      line="${out}${rest}"
    fi

    printf "%b\n" "$line"
  done <"$script_to_preview"
  shopt -u nocasematch

  if ((has_content == 0)); then
    printf "\033[0;33mℹ️ Tính năng này hiện chưa có tài liệu hướng dẫn chi tiết.\033[0m\n"
  fi
}
export -f wptt_fzf_previewer

