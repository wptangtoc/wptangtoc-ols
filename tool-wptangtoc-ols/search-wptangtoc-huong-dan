if ! declare -F wptt_smart_reload_lsws &>/dev/null; then
  # shellcheck source=/dev/null
  . /etc/wptt/core-functions 2>/dev/null
fi

function huong_dan() {
  cat <<'EOF'
Tính năng tài liệu hướng dẫn, thì đây là một phần rất quan trọng, đóng vai trò như sách hướng dẫn sử dụng hoặc trung tâm trợ giúp tích hợp, giúp người dùng hiểu và sử dụng công cụ một cách hiệu quả.

Giới thiệu ngắn gọn về tính năng này:

Mục đích chính:
- Hướng dẫn sử dụng: Cung cấp các chỉ dẫn chi tiết về cách cài đặt, cấu hình và sử dụng các chức năng khác nhau có trong bộ công cụ WPTangToc OLS.
- Giải thích tính năng: Làm rõ mục đích, cách hoạt động và lợi ích của từng tùy chọn hoặc lệnh mà công cụ cung cấp.
- Hướng dẫn thực hiện tác vụ: Đưa ra các bước cụ thể để thực hiện các công việc phổ biến như tạo website mới, cài đặt cache, quản lý database, v.v.
- Khắc phục sự cố: Cung cấp các giải pháp cho những vấn đề hoặc lỗi thường gặp.

Lợi ích:
- Tự học & Tự giải quyết vấn đề: Giúp người dùng có thể tự tìm hiểu.
- Sử dụng đúng cách: Khai thác tối đa tiềm năng của công cụ.
- Chuẩn hóa kiến thức: Tạo ra nguồn thông tin tham khảo chính thức.

Hướng dẫn tính năng:
- Di chuyển nút mũi tên (↑ ↓).
- ESC để huỷ.
- Gõ để lọc.
- Enter để chọn.
- Cuộn trỏ chuột hoặc (Shift + ↑ ↓) để cuộn nội dung.
EOF
}

if ! command -v fzf &>/dev/null; then
  echo "Vui lòng cài fzf thì mới sử dụng được tính năng này"
  exec /usr/bin/wptangtoc 1
fi

export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=en_US.UTF-8 2>/dev/null || true
export LANG=C.UTF-8 2>/dev/null || export LANG=en_US.UTF-8 2>/dev/null || true
stty iutf8 2>/dev/null || true
shopt -s extglob

if [[ -z "${C_CYAN:-}" ]]; then
  if [[ -f /etc/wptt/echo-color ]]; then
    # shellcheck source=/dev/null
    . /etc/wptt/echo-color
  else
    echo "Lỗi: Không tìm thấy /etc/wptt/echo-color"
    exit 1
  fi
fi

if [[ -f /etc/wptt/.wptt.conf ]]; then
  # shellcheck source=/dev/null
  . /etc/wptt/.wptt.conf
else
  echo "Lỗi: Không tìm thấy /etc/wptt/.wptt.conf"
  exit 1
fi

[[ -z "${ngon_ngu:-}" ]] && ngon_ngu='vi'
lang_file="/etc/wptt/lang/${ngon_ngu}.sh"
if [[ -f "$lang_file" ]]; then
  # shellcheck source=/dev/null
  . "$lang_file"
elif [[ -f "/etc/wptt/lang/vi.sh" ]]; then
  # shellcheck source=/dev/null
  . "/etc/wptt/lang/vi.sh"
fi

# Bẫy tín hiệu Ctrl+C an toàn
_wptt_huongdan_ctrl_c() {
  trap - SIGINT SIGTERM SIGQUIT
  stty sane 2>/dev/null || true
  tput cnorm 2>/dev/null || true
  echo -e "\n\nĐã thoát. Nhập lệnh ${C_GREEN}1${C_RESET} hoặc ${C_GREEN}wptangtoc${C_RESET} để quay lại."
  export WPTT_BYPASS=1
  exec bash --login
}
trap '_wptt_huongdan_ctrl_c' SIGINT SIGTERM SIGQUIT

# ==============================================================================
# 1. CÁC HÀM XỬ LÝ CHUỖI & GIẢI MÃ BIẾN THUẦN BASH (0 SUBSHELL - 0 EVAL)
# ==============================================================================
_trim_str() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  REPLY_TRIM="$s"
}

_expand_vars_safe() {
  local s="$1"
  local REPLY_TRIM=""
  _trim_str "$s"
  s="$REPLY_TRIM"

  if [[ "$s" == \"*\" ]]; then
    s="${s#\"}"
    s="${s%\"}"
  elif [[ "$s" == \'*\' ]]; then
    s="${s#\'}"
    s="${s%\'}"
  fi

  # Thay biến đúng 1 lượt, từ trái sang phải.
  # KHÔNG thay lại phần giá trị vừa chèn vào => không thể lặp vô hạn.
  local re='\$\{([a-zA-Z_][a-zA-Z0-9_]*):-([^}]*)\}|\$\{([a-zA-Z_][a-zA-Z0-9_]*)\}|\$([a-zA-Z_][a-zA-Z0-9_]*)'
  local out="" rest="$s" full prefix var_name def_val var_val
  while [[ "$rest" =~ $re ]]; do
    full="${BASH_REMATCH[0]}"
    if [[ -n "${BASH_REMATCH[1]}" ]]; then
      var_name="${BASH_REMATCH[1]}"
      def_val="${BASH_REMATCH[2]}"
      var_val="${!var_name:-$def_val}"
    elif [[ -n "${BASH_REMATCH[3]}" ]]; then
      var_name="${BASH_REMATCH[3]}"
      var_val="${!var_name:-}"
    else
      var_name="${BASH_REMATCH[4]}"
      var_val="${!var_name:-}"
    fi
    prefix="${rest%%"$full"*}"
    out+="${prefix}${var_val}"
    rest="${rest#*"$full"}"
  done
  s="${out}${rest}"

  printf -v s '%b' "$s"
  s="${s//$'\x1B'\[*([0-9;])[a-zA-Z]/}"
  _trim_str "$s"
  REPLY_EXPANDED="$REPLY_TRIM"
}

_parse_options_from_file() {
  local filepath="$1"
  PARSED_OPTIONS=()
  local in_opts=0 line clean_line REPLY_TRIM="" REPLY_EXPANDED=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    clean_line="${line%%#*}"
    _trim_str "$clean_line"
    clean_line="$REPLY_TRIM"
    [[ -z "$clean_line" ]] && continue

    if ((in_opts == 0)); then
      if [[ "$clean_line" =~ ^options=\((.*)$ ]]; then
        in_opts=1
        clean_line="${BASH_REMATCH[1]}"
        _trim_str "$clean_line"
        clean_line="$REPLY_TRIM"
        if [[ "$clean_line" == *")" ]]; then
          clean_line="${clean_line%)}"
          _trim_str "$clean_line"
          if [[ -n "$REPLY_TRIM" ]]; then
            _expand_vars_safe "$REPLY_TRIM"
            [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
          fi
          break
        fi
        [[ -z "$clean_line" ]] && continue
      else
        continue
      fi
    fi

    if ((in_opts == 1)); then
      if [[ "$clean_line" == ")"* ]]; then
        break
      elif [[ "$clean_line" == *")" ]]; then
        clean_line="${clean_line%)}"
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
        break
      else
        _expand_vars_safe "$clean_line"
        [[ -n "$REPLY_EXPANDED" ]] && PARSED_OPTIONS+=("$REPLY_EXPANDED")
      fi
    fi
  done <"$filepath"
}

# ==============================================================================
# 2. ĐỌC HOẶC XÂY DỰNG CACHE INDEX DÙNG CHUNG VỚI SEARCH-WPTANGTOC (0.002s)
# ==============================================================================
mkdir -p /etc/wptt/tmp 2>/dev/null || true
/bin/rm -f -- /etc/wptt/tmp/wptt_search_index_*.tsv 2>/dev/null || true
CACHE_FILE="/etc/wptt/tmp/wptt_search_v2_${ngon_ngu}_${version_wptangtoc_ols:-latest}.tsv"

declare -A feature_scripts=()
declare -a fzf_lines=()

use_cache=0
if [[ -s "$CACHE_FILE" ]]; then
  cache_mtime=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)
  main_mtime=$(stat -c %Y /usr/bin/wptangtoc 2>/dev/null || echo 0)
  self_mtime=$(stat -c %Y "$0" 2>/dev/null || echo 0)
  printf -v now_ts '%(%s)T' -1
  if ((cache_mtime >= main_mtime && cache_mtime >= self_mtime && (now_ts - cache_mtime) < 86400)); then
    use_cache=1
  fi
fi

if ((use_cache == 1)); then
  while IFS=$'\t' read -r f_key f_script _; do
    [[ -z "$f_key" || -z "$f_script" ]] && continue
    feature_scripts["$f_key"]="$f_script"
    fzf_lines+=("${f_key}"$'\t'"${f_script}")
  done <"$CACHE_FILE"
fi

if ((${#fzf_lines[@]} == 0)); then
  main_definition_file="/usr/bin/wptangtoc"
  declare -A main_menu_priority=()

  if [[ -r "$main_definition_file" ]]; then
    _parse_options_from_file "$main_definition_file"
    for i in "${!PARSED_OPTIONS[@]}"; do
      printf -v prio_str "%02d" "$i"
      main_menu_priority["${PARSED_OPTIONS[$i]}"]="$prio_str"
    done
  fi

  shopt -s nullglob
  all_files_to_process=(/etc/wptt/*-main /etc/wptt/*/*-main /etc/wptt/*/*/*-main)
  shopt -u nullglob

  if [[ -r "$main_definition_file" ]]; then
    has_main=0
    for f in "${all_files_to_process[@]}"; do
      if [[ "$f" -ef "$main_definition_file" ]]; then
        has_main=1
        break
      fi
    done
    ((has_main == 0)) && all_files_to_process+=("$main_definition_file")
  fi

  if ((${#all_files_to_process[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tệp menu nào."
    exit 1
  fi

  declare -A feature_args=()
  declare -A feature_sort_keys=()

  for filepath in "${all_files_to_process[@]}"; do
    [[ -r "$filepath" ]] || continue
    file="${filepath##*/}"

    # 1. Trích xuất Tiêu đề Danh mục: GIỮ NGUYÊN LOGIC TÊN NGẮN GỌN NHƯ BẢN GỐC
    category_title=""
    last_title_var=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^[[:space:]]*echo[[:space:]]+\"\$([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
        last_title_var="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^[[:space:]]*options=\( ]]; then
        break
      fi
    done <"$filepath"

    if [[ -n "$last_title_var" && -n "${!last_title_var:-}" ]]; then
      category_title="${!last_title_var}"
      category_title="${category_title%:}"
      _trim_str "$category_title"
      category_title="$REPLY_TRIM"
    fi

    if [[ -z "$category_title" ]]; then
      category_base="${file%-main}"
      category_base="${category_base#wptt-}"
      category_base="${category_base#wptangtoc-}"
      category_base="${category_base//-/ }"
      category_title="${category_base^}"
    fi

    _parse_options_from_file "$filepath"
    ((${#PARSED_OPTIONS[@]} == 0)) && continue

    in_run_action=0
    in_case=0
    current_label=""
    current_script=""
    current_args="98"

    while IFS= read -r line || [[ -n "$line" ]]; do
      clean_line="${line%%#*}"
      _trim_str "$clean_line"
      clean_line="$REPLY_TRIM"
      [[ -z "$clean_line" ]] && continue

      if ((in_run_action == 0)); then
        [[ "$clean_line" =~ ^run_action[[:space:]]*\(\) ]] && in_run_action=1
        continue
      fi

      if ((in_case == 0)); then
        [[ "$clean_line" =~ ^case[[:space:]]+ ]] && in_case=1
        continue
      fi

      if [[ "$clean_line" == "esac"* ]]; then
        break
      fi

      if [[ "$clean_line" =~ ^([0-9]+)\)(.*)$ ]]; then
        current_label="${BASH_REMATCH[1]}"
        clean_line="${BASH_REMATCH[2]}"
        current_script=""
        current_args="98"
      fi

      if [[ -n "$current_label" ]]; then
        if [[ "$clean_line" =~ script_path=\"([^\"]+)\" ]]; then
          current_script="${BASH_REMATCH[1]}"
        elif [[ "$clean_line" =~ (exec|\.)[[:space:]]+(/etc/wptt/[^[:space:]\;]+) ]]; then
          current_script="${BASH_REMATCH[2]}"
        fi

        if [[ "$clean_line" =~ script_args=\"([^\"]+)\" ]]; then
          current_args="${BASH_REMATCH[1]}"
        fi

        if [[ "$clean_line" == *";;"* ]]; then
          idx=$((10#$current_label))
          if ((idx >= 0 && idx < ${#PARSED_OPTIONS[@]})) && [[ -n "$current_script" ]]; then
            opt_title="${PARSED_OPTIONS[$idx]}"
            if [[ -n "$opt_title" && "$opt_title" != *"───"* ]]; then
              # Giữ nguyên định dạng ngăn cách " > " ngắn gọn như cũ
              feature_key="$category_title > $opt_title"
              if [[ -z "${feature_scripts["$feature_key"]:-}" ]]; then
                feature_scripts["$feature_key"]="$current_script"
                feature_args["$feature_key"]="${current_args:-98}"
                feature_sort_keys["$feature_key"]="${main_menu_priority["$opt_title"]:-99}"
              fi
            fi
          fi
          current_label=""
        fi
      fi
    done <"$filepath"
  done

  if ((${#feature_scripts[@]} == 0)); then
    _runloi "Lỗi: Không tìm thấy tính năng nào khả dụng."
    exit 1
  fi

  : >"${CACHE_FILE}.tmp"
  while IFS=$'\t' read -r _ f_key; do
    [[ -z "$f_key" ]] && continue
    f_script="${feature_scripts["$f_key"]}"
    f_arg="${feature_args["$f_key"]:-98}"
    fzf_lines+=("${f_key}"$'\t'"${f_script}")
    printf "%s\t%s\t%s\n" "$f_key" "$f_script" "$f_arg" >>"${CACHE_FILE}.tmp"
  done < <(
    for key in "${!feature_scripts[@]}"; do
      printf "%s\t%s\n" "${feature_sort_keys["$key"]:-99}" "$key"
    done | sort -k1,1 -k2,2
  )
  mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null || true
fi

# ==============================================================================
# 3. HÀM PREVIEW THUẦN BASH 100% (0 SUBSHELL KHI CUỘN PHÍM MŨI TÊN)
# ==============================================================================
wptt_fzf_previewer() {
  local full_line="$1"
  local _ script_to_preview=""
  IFS=$'\t' read -r _ script_to_preview _ <<<"$full_line"

  if [[ -z "$script_to_preview" || ! -r "$script_to_preview" ]]; then
    return 0
  fi

  local active=0 line trimmed
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if ((active == 0)); then
      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?huong_dan[[:space:]]*\(\)[[:space:]]*\{ ]]; then
        active=1
      fi
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*\} ]]; then
      break
    fi

    if [[ "$line" =~ ^[[:space:]]*cat[[:space:]]+\<\<-?[[:space:]]*[\'\"]?EOF[\'\"]? ]] || [[ "$line" =~ ^[[:space:]]*EOF[[:space:]]*$ ]]; then
      continue
    fi

    trimmed="${line#"${line%%[![:space:]]*}"}"
    if [[ "$trimmed" =~ ^echo([[:space:]]+-[eEn]+)?[[:space:]]+(.*)$ ]]; then
      line="${BASH_REMATCH[2]}"
      if [[ "$line" == \"*\" ]]; then
        line="${line#\"}"
        line="${line%\"}"
      elif [[ "$line" == \'*\' ]]; then
        line="${line#\'}"
        line="${line%\'}"
      fi
    fi

    printf "%b\n" "$line"
  done <"$script_to_preview"
}
export -f wptt_fzf_previewer

clear

# ==============================================================================
# 4. CHẠY FZF (ÉP SHELL=/bin/bash ĐỂ TƯƠNG THÍCH 100% VỚI EXPORT -F)
# ==============================================================================
selected_line_from_fzf=""
trap '' SIGINT
selected_line_from_fzf=$(
  SHELL=/bin/bash printf "%s\n" "${fzf_lines[@]}" | fzf \
    --prompt="Tìm kiếm hướng dẫn WPTangToc OLS > " \
    --height='~60%' \
    --border=rounded \
    --color=border:red \
    --layout=reverse \
    --cycle \
    --header="Có ${#fzf_lines[@]} Hướng dẫn: Gõ để lọc, ↓ và ↑ để di chuyển, Shift + ↓/↑ để cuộn, Enter chọn, ESC hủy" \
    --with-nth=1 \
    --delimiter=$'\t' \
    --preview='wptt_fzf_previewer {}' \
    --preview-window=up:70%:wrap
) || true
trap '_wptt_huongdan_ctrl_c' SIGINT

# ==============================================================================
# 5. XUẤT NỘI DUNG SAU KHI ENTER (0 SUBSHELL)
# ==============================================================================
if [[ -n "$selected_line_from_fzf" ]]; then
  IFS=$'\t' read -r selected_feature script_to_run _ <<<"$selected_line_from_fzf"
  echo ""
  echoXanhlacay "Bạn đã chọn: $selected_feature"
  echo ""
  if [[ -r "$script_to_run" ]]; then
    wptt_fzf_previewer "$selected_line_from_fzf"
    echoDo "────────────────────────────────────────────────────────────────────────────────"
    read -rp "Nhập phím bất kỳ để quay lại menu chính: " _ || true
    exec /usr/bin/wptangtoc 1
  else
    _runloi "Lỗi: Không thể tìm thấy script '$script_to_run'."
    exec /usr/bin/wptangtoc 1
  fi
else
  echoVang "Không chọn gì. Đang thoát..."
  exec /usr/bin/wptangtoc 1
fi
