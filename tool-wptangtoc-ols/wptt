function rm-login() {
    get_web_context
    _runing "Xóa WP cli login"
    if [[ ! -d "$path_web/wp-content/plugins/wp-cli-login-server" ]]; then
        _runloi "Xóa WP cli login"
        echoDo "Website không cài đặt wp cli login"
        exit 1
    fi
    . /etc/wptt/vhost/."$name_web".conf
    . /etc/wptt/php/php-cli-domain-config "$name_web"

    local run_wp="/sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp --allow-root --path=$path_web"
    
    $run_wp plugin deactivate wp-cli-login-server >/dev/null 2>&1
    $run_wp plugin delete wp-cli-login-server >/dev/null 2>&1
    rm -rf "$path_web/wp-content/plugins/wp-cli-login-server"
    
    local tien_to=$($run_wp db prefix 2>/dev/null)
    $run_wp db query "DELETE FROM ${tien_to}options WHERE option_name = 'wp_cli_login'" 2>/dev/null
    $run_wp db query "UPDATE ${tien_to}options SET option_value = 'a:0:{}' WHERE option_name = 'recently_activated';" 2>/dev/null
    _rundone "Xóa WP cli login"
}

function config-ls() {
    get_web_context
    [[ -z "$name_web" ]] && { echoDo "Không xác định được domain website"; exit 1; }
    if [[ -d "/usr/local/lsws/$name_web/html/wp-content/plugins/litespeed-cache" ]]; then
        . /etc/wptt/php/php-cli-domain-config "$name_web"
        local skip_plugins=$(cat /etc/wptt/ioncube-plugin-list 2>/dev/null | tr '\n' ',' | sed 's/,$//g')
        local run_wp="/usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp --allow-root --path=/usr/local/lsws/$name_web/html"
        
        $run_wp litespeed-option set cache-browser false --skip-plugin="$skip_plugins" >/dev/null 2>&1
        $run_wp litespeed-option set cache-browser false >/dev/null 2>&1
        /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
        echo "Hoàn tất cấu hình LSCache"
    else
        echo "Chưa cài đặt plugin litespeed cache"
    fi
}

