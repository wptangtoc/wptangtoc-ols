function cdbk() {
    local target_domain=""

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            -d|--domain) target_domain="$2"; shift ;;
            -h|--help) 
                echo -e "${C_YELLOW}Cách dùng: wptt cdbk [Tùy chọn]${C_RESET}"
                echo "  -d, --domain <tên-miền>   Truy cập nhanh vào thư mục backup website"
                echo "  Tương thích ngược       : wptt cdbk wptangtoc.com"
                return 0 ;;
            *) 
                # Tương thích ngược: Khách gõ trực tiếp tên miền mà không cần -d
                if [[ "$1" == *.* && -z "$target_domain" ]]; then target_domain="$1"
                else echo -e "${C_RED}LỖI: Tham số không hợp lệ '$1'${C_RESET}"; return 1; fi ;;
        esac
        shift
    done

    # Thực thi source và truyền tên miền xuống script gốc (Zero Breaking Changes)
    if [[ -n "$target_domain" ]]; then
        source "/etc/wptt/ma-nguon/wptt-truy-cap-nhanh-backup-website" "$target_domain"
    else
        source "/etc/wptt/ma-nguon/wptt-truy-cap-nhanh-backup-website"
    fi
}



