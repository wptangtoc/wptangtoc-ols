function reboot-all() {
    . /etc/os-release
    local is_ubuntu=0
    [[ "$ID" == "ubuntu" || "$ID" == "debian" ]] && is_ubuntu=1

    _runing "Khởi động lại LiteSpeed"
    /usr/local/lsws/bin/lswsctrl restart >/dev/null 2>&1
    _rundone "Khởi động lại LiteSpeed"

    _runing "Khởi động lại Maria Database"
    systemctl restart mariadb.service >/dev/null 2>&1
    _rundone "Khởi động lại Maria Database"

    _runing "Khởi động lại SSH"
    systemctl restart sshd.service >/dev/null 2>&1
    _rundone "Khởi động lại SSH"

    _runing "Khởi động lại Crond"
    if [[ $is_ubuntu -eq 1 ]]; then
        systemctl restart cron.service >/dev/null 2>&1
    else
        systemctl restart crond.service >/dev/null 2>&1
    fi
    _rundone "Khởi động lại Crond"

    _runing "Khởi động lại fail2ban"
    systemctl restart fail2ban.service >/dev/null 2>&1
    _rundone "Khởi động lại fail2ban"

    local redis_conf="/etc/redis.conf"
    [[ $is_ubuntu -eq 1 || "$ID" == "almalinux" || "$ID" == "rocky" || "$ID" == "rhel" || "$ID" == "ol" ]] && redis_conf="/etc/redis/redis.conf"
    if [[ -f $redis_conf ]]; then
        _runing "Khởi động lại Redis"
        systemctl restart redis.service >/dev/null 2>&1
        _rundone "Khởi động lại Redis"
    fi

    local memcached_conf="/etc/sysconfig/memcached"
    [[ $is_ubuntu -eq 1 ]] && memcached_conf="/etc/memcached.conf"
    if [[ -f $memcached_conf ]]; then
        _runing "Khởi động lại Memcached"
        systemctl restart memcached.service >/dev/null 2>&1
        _rundone "Khởi động lại Memcached"
    fi

    if [[ -f /etc/csf/csf.conf ]]; then
        _runing "Khởi động lại CSF"
        systemctl restart csf.service >/dev/null 2>&1
        systemctl restart lfd.service >/dev/null 2>&1
        _rundone "Khởi động lại CSF"
    fi

    if systemctl is-active --quiet nftables.service 2>/dev/null; then
        systemctl restart nftables >/dev/null 2>&1
    fi

    echo "+-----------------------------------------------------------------------+"
    echo "|Tình trạng hoạt động các service hiện tại                              |"
    echo "+-----------------------------------------------------------------------+"
    printf "|LiteSpeed     : %-60s |\n" "$(systemctl is-active lsws.service 2>/dev/null)"
    printf "|MariaDB       : %-60s |\n" "$(systemctl is-active mariadb.service 2>/dev/null)"
    [[ -f $memcached_conf ]] && printf "|Memcached     : %-60s |\n" "$(systemctl is-active memcached.service 2>/dev/null)"
    [[ -f $redis_conf ]] && printf "|Redis         : %-60s |\n" "$(systemctl is-active redis.service 2>/dev/null)"
    [[ -f /etc/csf/csf.conf ]] && printf "|CSF           : %-60s |\n" "$(systemctl is-active csf.service 2>/dev/null)"
    printf "|SSH           : %-60s |\n" "$(systemctl is-active sshd.service 2>/dev/null)"
    if [[ $is_ubuntu -eq 1 ]]; then
        printf "|Crond         : %-60s |\n" "$(systemctl is-active cron.service 2>/dev/null)"
    else
        printf "|Crond         : %-60s |\n" "$(systemctl is-active crond.service 2>/dev/null)"
    fi
    printf "|Fail2Ban      : %-60s |\n" "$(systemctl is-active fail2ban.service 2>/dev/null)"
    if systemctl is-active --quiet nftables.service 2>/dev/null; then
        printf "|Nftables      : %-60s |\n" "$(systemctl is-active nftables.service 2>/dev/null)"
    fi
    echo "+-----------------------------------------------------------------------+"

    echo "Reboot All service thời gian: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
}

function ip() {
    local ip_addr=$(curl -4 -skf --connect-timeout 3 --max-time 5 https://ipv4.icanhazip.com || curl -4 -skf --connect-timeout 3 --max-time 5 https://checkip.amazonaws.com)
    if [[ -n "$ip_addr" ]]; then
        echo -e "${C_GREEN}IP hiện tại của webserver là:${C_RESET} ${C_BOLD_WHITE}$ip_addr${C_RESET}"
    else
        echoDo "Không xác định được địa chỉ IP"
    fi
}

function dns-check() {
    local ip_addr=$(curl -4 -skf --connect-timeout 3 --max-time 5 https://ipv4.icanhazip.com || curl -4 -skf --connect-timeout 3 --max-time 5 https://checkip.amazonaws.com)
    local NAME=$1
    if [[ "$NAME" != *.* ]]; then
        clear
        . /etc/wptt/.wptt.conf 2>/dev/null
        echoDo "Domain tên miền nhập không đúng định dạng."
        echo "ví dụ như: $Website_chinh"
        exit 1
    fi

    local checkdns=$(host "$NAME" 2>/dev/null | awk '/has address/ {print $4; exit}')
    [[ -z "$checkdns" ]] && checkdns=$(nslookup "$NAME" 2>/dev/null | awk '/^Address: / {print $2; exit}')

    if [[ "$checkdns" != "$ip_addr" ]]; then
        echoDo "Tên miền chưa trỏ DNS về máy chủ webhost IP: $ip_addr"
        echo "Hãy trỏ DNS thì mới có thể cài được SSL"
        echo "Hãy trỏ DNS $checkdns thành $ip_addr rồi quay lại cài SSL nhé"
        [[ -z "$checkdns" ]] && echo "Tên miền $NAME chưa được trỏ IP. Vui lòng trỏ IP về $ip_addr"
        echo "Tên miền $NAME đang được quản lý bởi nhà cung cấp, hãy truy cập vào đó để trỏ."
    else
        echoDone "Domain $NAME đã trỏ DNS về máy chủ của bạn ($ip_addr)"
    fi
}

function version() {
    . /etc/wptt/.wptt.conf 2>/dev/null
    local wptangtocols_version=$(curl -s --connect-timeout 5 --max-time 10 https://wptangtoc.com/share/version-wptangtoc-ols.txt | head -1 | grep '\.')
    if [[ -n "$wptangtocols_version" && "$wptangtocols_version" != "$version_wptangtoc_ols" ]]; then
        clear
        echo "========================================================================="
        echo -e "Thông báo cập nhật - Bạn đang sử dụng WPTANGTOC OLS: ${C_RED} $version_wptangtoc_ols ${C_RESET}"
        echo "-------------------------------------------------------------------------"
        echo -e "Đã có bản cập nhật mới WPTANGTOC OLS: ${C_RED} $wptangtocols_version ${C_RESET}."
        echo "Gõ lệnh: 99 hoặc wptt update để cập nhật."
        echo "========================================================================="
    fi
}

