function rm-login2() {
    get_web_context
    _runing "Xóa WP dologin"
    if [[ ! -d "$path_web/wp-content/plugins/dologin" ]]; then
        _runloi "Xóa WP dologin"
        echoDo "website không cài đặt wp dologin"
        exit 1
    fi
    . /etc/wptt/php/php-cli-domain-config "$name_web"
    local run_wp="/usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp --allow-root --path=$path_web"
    
    $run_wp plugin deactivate dologin >/dev/null 2>&1
    $run_wp plugin delete dologin >/dev/null 2>&1
    rm -rf "${path_web:?}/wp-content/plugins/dologin"
    
    local tien_to=$($run_wp db prefix 2>/dev/null)
    local WPMLTABLES=($($run_wp db tables --all-tables 2>/dev/null | grep '_dologin_'))
    for WPMLTABLE in "${WPMLTABLES[@]}"; do
        $run_wp db query "DROP TABLE ${WPMLTABLE}" 2>/dev/null
    done
    $run_wp db query "DELETE FROM ${tien_to}options WHERE option_name LIKE 'dologin.%'" 2>/dev/null
    _rundone "Xóa WP dologin"
}

