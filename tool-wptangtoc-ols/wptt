function wp-memcached() {
    . /etc/os-release
    local memcached_conf="/etc/sysconfig/memcached"
    [[ "$ID" == "ubuntu" || "$ID" == "debian" ]] && memcached_conf="/etc/memcached.conf"
    
    if [[ -f "$memcached_conf" ]]; then
        get_web_context
        [[ -z "$name_web" ]] && { echoDo "Không xác định được domain website"; exit 1; }

        _runing "Thiết lập memcached"
        local wp_cfg="/usr/local/lsws/$name_web/html/wp-config.php"
        sed -i '/memcached_servers =/d' "$wp_cfg"
        sed -i "2 i \$memcached_servers = ['/var/run/memcached/memcached.sock:0'];" "$wp_cfg"
        rm -f "/usr/local/lsws/$name_web/html/wp-content/object-cache.php"
        cp -f /etc/wptt/cache/memcached.php "/usr/local/lsws/$name_web/html/wp-content/object-cache.php"
        . /etc/wptt/vhost/."$name_web".conf 2>/dev/null
        chown "$User_name_vhost":"$User_name_vhost" "/usr/local/lsws/$name_web/html/wp-content/object-cache.php"
        chmod 644 "/usr/local/lsws/$name_web/html/wp-content/object-cache.php"
        _rundone "Thiết lập memcached"
    else
        echo "Chưa cài đặt memcached"
    fi
}

function wp-redis() {
    local ACTIVE_CACHE=""
    if systemctl is-enabled --quiet valkey 2>/dev/null || systemctl is-active --quiet valkey 2>/dev/null; then
        ACTIVE_CACHE="valkey"
    elif systemctl is-enabled --quiet keydb 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null; then
        ACTIVE_CACHE="keydb"
    elif systemctl is-enabled --quiet redis 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null; then
        ACTIVE_CACHE="redis"
    fi

    if [[ -n "$ACTIVE_CACHE" ]]; then
        get_web_context
        [[ -z "$name_web" ]] && { echoDo "Không xác định được domain website"; exit 1; }
        local wp_cfg="/usr/local/lsws/$name_web/html/wp-config.php"
        [[ ! -f "$wp_cfg" ]] && { echo "Không xác định được đây là website WordPress"; exit 1; }

        _runing "Kích hoạt redis cho website $name_web"
        . /etc/wptt/vhost/."$name_web".conf 2>/dev/null
        . /etc/wptt/php/php-cli-domain-config "$name_web" 2>/dev/null

        local run_wp="/sbin/runuser -u $User_name_vhost -- /usr/local/lsws/lsphp${phien_ban_php_domain_thuc_thi}/bin/php /usr/local/bin/wp --allow-root --path=/usr/local/lsws/$name_web/html"

        if $run_wp plugin list --fields=name --status=active 2>/dev/null | grep -q 'wp-redis'; then
            _runloi "Đã cài đặt wp redis trước đó rồi"
            echoDo "website không cài đặt wp redis trước đó rồi"
            exit 1
        fi

        sed -i '/redis_server =/d' "$wp_cfg"
        sed -i "2 i \$redis_server = array('host'=> '/var/run/${ACTIVE_CACHE}/${ACTIVE_CACHE}.sock','port'=>null,'database'=> 0);" "$wp_cfg"

        $run_wp config shuffle-salts WP_CACHE_KEY_SALT --force >/dev/null 2>&1

        for line_num in $(grep -n "define( 'WP_CACHE_KEY_SALT'" "$wp_cfg" | head -n -1 | cut -d: -f1 | tac); do
            sed -i "${line_num}d" "$wp_cfg"
        done

        if ! grep -q "WP_CACHE_KEY_SALT" "$wp_cfg"; then
            sed -i "/define( 'WP_CACHE_KEY_SALT'/d" "$wp_cfg"
            sed -i "/^define( 'NONCE_SALT'/a define( 'WP_CACHE_KEY_SALT', '$name_web' );" "$wp_cfg"
            $run_wp config shuffle-salts WP_CACHE_KEY_SALT --force >/dev/null 2>&1
            for line_num in $(grep -n "define( 'WP_CACHE_KEY_SALT'" "$wp_cfg" | head -n -1 | cut -d: -f1 | tac); do
                sed -i "${line_num}d" "$wp_cfg"
            done
        fi

        $run_wp plugin install wp-redis --activate >/dev/null 2>&1
        $run_wp redis enable >/dev/null 2>&1
        _rundone "Kích hoạt redis cho website $name_web"
    else
        echo "Chưa cài đặt redis trên hệ thống, vui lòng cài đặt redis"
    fi
}

function disk() {
    echo "==================================================================="
    local disk_stats_output=$(df -BG / 2>/dev/null | awk 'NR==2 {print $3, $2, $5}')
    if [[ -z "$disk_stats_output" ]]; then
        local disk_used_gb="N/A"
        local disk_total_gb="N/A"
        local disk_percent_display="\033[31m(N/A)\033[0m"
    else
        read -r disk_used_raw disk_total_raw disk_percent_raw_str <<< "$disk_stats_output"
        local disk_used_gb="${disk_used_raw//G/}"
        local disk_total_gb="${disk_total_raw//G/}"
        local disk_percent_numeric="${disk_percent_raw_str//%/}"

        if ! [[ "$disk_percent_numeric" =~ ^[0-9]+$ ]]; then
            local display_val_on_error="(${disk_percent_raw_str:-ERR})"
            local disk_percent_display="\033[31m${display_val_on_error}\033[0m"
        else
            local disk_percent_display=$(awk -v val="$disk_percent_numeric" -v p_str="(${disk_percent_raw_str})" 'BEGIN {
                if (val > 90) printf "\033[31m%s\033[0m", p_str;
                else if (val > 70) printf "\033[33m%s\033[0m", p_str;
                else printf "%s", p_str;
            }')
        fi
    fi
    echo "Dung lượng ổ cứng hiện tại: ${disk_used_gb}/${disk_total_gb}GB ${disk_percent_display}"

    local inode_usage=$(df -i / | awk 'NR==2 {print $5}' | tr -d '%')
    if [[ "$inode_usage" -gt 90 ]]; then
        echo -e "${C_RED}CẢNH BÁO: Số lượng tệp tin (Inodes) sắp đầy ($inode_usage%)!${C_RESET}"
    fi
    echo "==================================================================="

    [[ -d /usr/local/lsws/logs ]] && echo "Dung lượng logs của server là $(du -hs /usr/local/lsws/logs | awk '{print $1}')B"
    [[ -f /var/log/mysql/mysql.log ]] && echo "Dung lượng logs database của server là $(du -hs /var/log/mysql | awk '{print $1}')B"

    # TỐI ƯU SIÊU TỐC: Dùng vòng lặp For nguyên bản Bash thay vì subshell ls+grep+sort
    for entry in /etc/wptt/vhost/*.conf /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$entry" || "$entry" == *"/..conf" || "$entry" == *"/.*.conf" ]] && continue
        
        local domain="${entry##*/.}"
        domain="${domain##*/}"
        domain="${domain%.conf}"
        
        local path="/usr/local/lsws/$domain/html"
        
        if [[ -d "$path" ]]; then
            echo "==================================================================="
            echo "$domain đang sử dụng ổ cứng: "
            echo "Dung lượng mã nguồn website $domain là $(du -hs "$path" 2>/dev/null | awk '{print $1}')B"
        fi
        
        if [[ -d "/usr/local/backup-website/$domain" ]]; then
            local has_backup=0
            for b_file in "/usr/local/backup-website/$domain"/*.{zip,sql,sql.gz}; do
                [[ -f "$b_file" ]] && { has_backup=1; break; }
            done
            if [[ $has_backup -eq 1 ]]; then
                echo "Dung lượng backup của website $domain là $(du -hs "/usr/local/backup-website/$domain" 2>/dev/null | awk '{print $1}')B"
            fi
        fi

        if [[ -d "/usr/local/lsws/$domain/luucache" ]]; then
            if [[ -d "$path/wp-content/plugins/litespeed-cache" ]] || grep -q '\[P\]' "$path/.htaccess" 2>/dev/null || grep -q 'proxy' "/usr/local/lsws/conf/vhosts/$domain/$domain.conf" 2>/dev/null; then
                echo "Dung lượng cache LScache của website $domain là $(du -hs "/usr/local/lsws/$domain/luucache" 2>/dev/null | awk '{print $1}')B"
            fi
        fi

        if [[ -d "/usr/local/lsws/$domain/logs" ]]; then
            echo "Dung lượng logs của website $domain là $(du -hs "/usr/local/lsws/$domain/logs" 2>/dev/null | awk '{print $1}')B"
        fi

        . "/etc/wptt/vhost/.$domain.conf" 2>/dev/null
        if [[ -n "$DB_Name_web" && -d "/var/lib/mysql/$DB_Name_web" ]]; then
            local db_size=$(du -hs "/var/lib/mysql/$DB_Name_web" 2>/dev/null | awk '{print $1}')
            [[ "$db_size" != *"K"* ]] && echo "Dung lượng database của website $domain là ${db_size}B"
        fi
        echo "==================================================================="
    done
}

