# --- HÀM LẤY ĐƯỜNG DẪN ZERO-FORK SIÊU TỐC ---
get_web_context() {
    local current_pwd="$PWD"
    IFS='/' read -r -a pwd_parts <<< "$current_pwd"
    name_web="${pwd_parts[4]}"
    path_web="/${pwd_parts[1]}/${pwd_parts[2]}/${pwd_parts[3]}/${pwd_parts[4]}/${pwd_parts[5]}"
}

