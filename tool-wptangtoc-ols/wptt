function ssl-tra-phi-config() {
  local target_domain=""
  while [[ "$#" -gt 0 ]]; do
    case $1 in
    -d | --domain)
      target_domain="$2"
      shift
      ;;
    -h | --help)
      echo "Cách dùng: wptt ssl-tra-phi-config -d <tên-miền>"
      return 0
      ;;
    *)
      if [[ "$1" == *.* && -z "$target_domain" ]]; then
        target_domain="$1"
      else return 1; fi
      ;;
    esac
    shift
  done
  [[ -z "$target_domain" ]] && {
    echoDo "Thiếu --domain"
    return 1
  }

  if [[ ! -d "/usr/local/lsws/$target_domain/html" ]]; then
    echoDo "Domain không tồn tại trong hệ thống"
    exit 1
  fi

  if [[ ! -d "/usr/local/lsws/$target_domain/ssl" ]]; then
    echoDo "Domain chưa được thiết lập ssl trả phí"
    exit 1
  fi
  bash /etc/wptt/ssl/wptt-config-ssl-tra-phi "$target_domain"
}
