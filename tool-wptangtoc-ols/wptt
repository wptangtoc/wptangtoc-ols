function saoluu() {
    local target_domain=""
    local is_all=0
    local is_quiet=0

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            -d|--domain) target_domain="$2"; shift ;;
            -a|--all) is_all=1 ;;
            -q|--quiet) is_quiet=1 ;;
            -h|--help)
                echo -e "${C_YELLOW}Cách dùng: wptt saoluu [Tùy chọn]${C_RESET}"
                echo "  -d, --domain <tên-miền>   Sao lưu một website cụ thể"
                echo "  -a, --all                 Sao lưu toàn bộ website trên máy chủ"
                echo "  -q, --quiet               Chạy ngầm (Ansible/CI)"
                return 0 ;;
            *) 
