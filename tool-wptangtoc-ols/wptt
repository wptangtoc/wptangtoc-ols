function don-rac() {
    _runing "Đang giải phóng bộ nhớ đệm (RAM Cache)"
    sync; echo 1 > /proc/sys/vm/drop_caches
    sync; echo 2 > /proc/sys/vm/drop_caches
    sync; echo 3 > /proc/sys/vm/drop_caches
    _rundone "Đã xả sạch Cache RAM thành công!"
}


function disk() {
    . /etc/wptt/echo-color 2>/dev/null
    . /etc/wptt/core-functions 2>/dev/null

    clear
    echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}BÁO CÁO DUNG LƯỢNG MÁY CHỦ & WEBSITE${C_RESET}"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

    # ==============================================================================
    # 1. THỐNG KÊ TÀI NGUYÊN CẤP MÁY CHỦ (SERVER LEVEL)
    # ==============================================================================
    echo -e "\n${C_BOLD_WHITE}TỔNG QUAN HỆ THỐNG (ROOT)${C_RESET}"
    
    # 1.1 Xử lý Disk Space
    local disk_stats_output=$(df -BG / 2>/dev/null | awk 'NR==2 {print $3, $2, $5}')
    if [[ -z "$disk_stats_output" ]]; then
        local disk_used_gb="N/A"
        local disk_total_gb="N/A"
        local disk_percent_display="${C_RED}(N/A)${C_RESET}"
    else
        read -r disk_used_raw disk_total_raw disk_percent_raw_str <<< "$disk_stats_output"
        local disk_used_gb="${disk_used_raw//G/}"
        local disk_total_gb="${disk_total_raw//G/}"
        local disk_percent_numeric="${disk_percent_raw_str//%/}"

        if ! [[ "$disk_percent_numeric" =~ ^[0-9]+$ ]]; then
            local display_val_on_error="(${disk_percent_raw_str:-ERR})"
            local disk_percent_display="${C_RED}${display_val_on_error}${C_RESET}"
        else
            local disk_percent_display=$(awk -v val="$disk_percent_numeric" -v p_str="(${disk_percent_raw_str})" 'BEGIN {
                if (val >= 90) printf "\033[31m%s\033[0m", p_str;
                else if (val >= 70) printf "\033[33m%s\033[0m", p_str;
                else printf "\033[32m%s\033[0m", p_str;
            }')
        fi
    fi
    echo -e "  • Ổ đĩa cứng (Disk)  : ${C_CYAN}${disk_used_gb}/${disk_total_gb}GB${C_RESET} $disk_percent_display"

    # 1.2 Xử lý Inodes
    local inode_usage=$(df -i / | awk 'NR==2 {print $5}' | tr -d '%')
    if [[ "$inode_usage" -gt 90 ]]; then
        echo -e "  • Tệp tin (Inodes)   : ${C_RED}$inode_usage% (Sắp quá tải!)${C_RESET}"
    else
        echo -e "  • Tệp tin (Inodes)   : ${C_GREEN}$inode_usage% (An toàn)${C_RESET}"
    fi

    # 1.3 Xử lý Logs Máy chủ
    if [[ -d /usr/local/lsws/logs ]]; then
        echo -e "  • Web Server Logs    : $(du -hs /usr/local/lsws/logs 2>/dev/null | awk '{print $1}')B"
    fi
    if [[ -f /var/log/mysql/mysql.log || -d /var/log/mysql ]]; then
        echo -e "  • Database Logs      : $(du -hs /var/log/mysql 2>/dev/null | awk '{print $1}')B"
    fi

    # 1.4 [MODULE MỚI] Xử lý Thùng rác ảo
    local trash_path="${WPTT_TRASH_PATH:-/usr/local/.wptt_trash}"
    if [[ -d "$trash_path" && -n "$(ls -A "$trash_path" 2>/dev/null)" ]]; then
        local trash_size=$(du -hs "$trash_path" 2>/dev/null | awk '{print $1}')
        echo -e "  • Thùng rác ảo       : ${C_RED}${trash_size}B${C_RESET} (Đang chiếm dụng)"
    fi

    echo -e "${C_CYAN}───────────────────────────────────────────────────────────────────────────────${C_RESET}"

    # ==============================================================================
    # 2. THỐNG KÊ CHI TIẾT TỪNG WEBSITE (DOMAIN LEVEL)
    # ==============================================================================
    echo -e "${C_BOLD_WHITE}DUNG LƯỢNG CHI TIẾT TỪNG WEBSITE${C_RESET}"
    local count=0

    # TỐI ƯU SIÊU TỐC: Dùng vòng lặp For nguyên bản Bash
    for entry in /etc/wptt/vhost/*.conf /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$entry" || "$entry" == *"/..conf" || "$entry" == *"/.*.conf" ]] && continue
        
        local domain="${entry##*/.}"
        domain="${domain##*/}"
        domain="${domain%.conf}"
        
        local path="/usr/local/lsws/$domain/html"
        
        # Bỏ qua nếu mã nguồn không tồn tại (website đã bị xóa)
        [[ ! -d "$path" ]] && continue
        
        ((count++))
        echo -e "\n${C_CYAN}[${count}]${C_RESET} ${C_YELLOW}${domain}${C_RESET}"

        # Mã nguồn
        local src_size=$(du -hs "$path" 2>/dev/null | awk '{print $1}')
        echo -e "  ├─ Mã nguồn Website : ${C_GREEN}${src_size}B${C_RESET}"

        # Database
        unset DB_Name_web # Xóa biến cũ để chống râu ông nọ cắm cằm bà kia
        . "/etc/wptt/vhost/.$domain.conf" 2>/dev/null
        if [[ -n "$DB_Name_web" && -d "/var/lib/mysql/$DB_Name_web" ]]; then
            local db_size=$(du -hs "/var/lib/mysql/$DB_Name_web" 2>/dev/null | awk '{print $1}')
            # Ẩn nếu size quá nhỏ (chỉ vài KB - db rỗng)
            [[ "$db_size" != *"K"* ]] && echo -e "  ├─ Cơ sở dữ liệu    : ${C_GREEN}${db_size}B${C_RESET}"
        fi

        # Backup
        local backup_dir="/usr/local/backup-website/$domain"
        if [[ -d "$backup_dir" && -n "$(ls -A "$backup_dir" 2>/dev/null)" ]]; then
            local backup_size=$(du -hs "$backup_dir" 2>/dev/null | awk '{print $1}')
            echo -e "  ├─ Bản sao lưu (Zip): ${C_CYAN}${backup_size}B${C_RESET}"
        fi

        # LSCache
        if [[ -d "/usr/local/lsws/$domain/luucache" && -n "$(ls -A "/usr/local/lsws/$domain/luucache" 2>/dev/null)" ]]; then
            if [[ -d "$path/wp-content/plugins/litespeed-cache" ]] || grep -q '\[P\]' "$path/.htaccess" 2>/dev/null || grep -q 'proxy' "/usr/local/lsws/conf/vhosts/$domain/$domain.conf" 2>/dev/null; then
                local cache_size=$(du -hs "/usr/local/lsws/$domain/luucache" 2>/dev/null | awk '{print $1}')
                echo -e "  ├─ Bộ đệm LSCache   : ${cache_size}B"
            fi
        fi

        # Logs Website
        if [[ -d "/usr/local/lsws/$domain/logs" && -n "$(ls -A "/usr/local/lsws/$domain/logs" 2>/dev/null)" ]]; then
            local log_size=$(du -hs "/usr/local/lsws/$domain/logs" 2>/dev/null | awk '{print $1}')
            echo -e "  └─ Nhật ký Logs     : ${log_size}B"
        fi
    done

    if [[ $count -eq 0 ]]; then
        echo -e "  ${C_YELLOW}Không có website nào đang hoạt động trên hệ thống.${C_RESET}"
    fi

    echo ""
}


