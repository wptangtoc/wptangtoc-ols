# ==============================================================================
# HÀM LẤY ĐƯỜNG DẪN THÔNG MINH (HỖ TRỢ FLAG CLI VÀ FOLDER CONTEXT)
# ==============================================================================
get_web_context() {
    local target_domain="$1"
    
    if [[ -n "$target_domain" && "$target_domain" == *.* ]]; then
        # Nếu có cờ --domain truyền vào, lấy đích danh
        name_web="$target_domain"
        path_web="/usr/local/lsws/$name_web/html"
    else
        # Nếu không có cờ, fallback lấy theo thư mục hiện tại (Zero-fork)
        local current_pwd="$PWD"
        IFS='/' read -r -a pwd_parts <<< "$current_pwd"
        name_web="${pwd_parts[4]}"
        path_web="/${pwd_parts[1]}/${pwd_parts[2]}/${pwd_parts[3]}/${pwd_parts[4]}/${pwd_parts[5]}"
    fi
}

