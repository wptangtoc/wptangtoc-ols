function wp-redis() {
    local target_domain=""
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            -d|--domain) target_domain="$2"; shift ;;
        esac
        shift
    done
    
    get_web_context "$target_domain"
    [[ -z "$name_web" ]] && { echoDo "Không xác định được domain website"; return 1; }
    
    # ... (Giữ nguyên phần logic bật redis cực đỉnh của sếp) ...
    local ACTIVE_CACHE=""
    if systemctl is-enabled --quiet valkey 2>/dev/null || systemctl is-active --quiet valkey 2>/dev/null; then ACTIVE_CACHE="valkey"
    elif systemctl is-enabled --quiet keydb 2>/dev/null || systemctl is-active --quiet keydb 2>/dev/null; then ACTIVE_CACHE="keydb"
    elif systemctl is-enabled --quiet redis 2>/dev/null || systemctl is-active --quiet redis 2>/dev/null; then ACTIVE_CACHE="redis"
    fi

    if [[ -n "$ACTIVE_CACHE" ]]; then
        local wp_cfg="/usr/local/lsws/$name_web/html/wp-config.php"
        [[ ! -f "$wp_cfg" ]] && { echo "Không xác định được đây là website WordPress"; return 1; }

        _runing "Kích hoạt Pantheon wp-redis cho website $name_web"
        . /etc/wptt/vhost/."$name_web".conf 2>/dev/null
        . /etc/wptt/php/php-cli-domain-config "$name_web" 2>/dev/null
        local run_wp=( /sbin/runuser -u "$User_name_vhost" -- /usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php /usr/local/bin/wp --path="/usr/local/lsws/$name_web/html" )

        if "${run_wp[@]}" plugin list --fields=name --status=active 2>/dev/null | grep -q 'wp-redis'; then
            echoDo "Website đã cài đặt wp redis trước đó rồi"; return 1
        fi

        sed -i '/$redis_server = array/d' "$wp_cfg"
        local raw_redis_pass=""
        [[ -n "$redis_acl_pass" ]] && raw_redis_pass=$(wptt_giai_ma "$redis_acl_pass")

        if [[ -n "$redis_acl_user" && -n "$raw_redis_pass" && "$redis_db_id" ]]; then
            sed -i "s|^<?php|<?php\n\$redis_server = array('host'=> '/var/run/${ACTIVE_CACHE}/${ACTIVE_CACHE}.sock','port'=>null,'database'=> ${redis_db_id}, 'auth' => array('$redis_acl_user', '$raw_redis_pass'));|" "$wp_cfg"
        else
            sed -i "s|^<?php|<?php\n\$redis_server = array('host'=> '/var/run/${ACTIVE_CACHE}/${ACTIVE_CACHE}.sock','port'=>null,'database'=> 0);|" "$wp_cfg"
        fi

        "${run_wp[@]}" config shuffle-salts WP_CACHE_KEY_SALT --force >/dev/null 2>&1
        for line_num in $(grep -n "define( 'WP_CACHE_KEY_SALT'" "$wp_cfg" | head -n -1 | cut -d: -f1 | tac); do sed -i "${line_num}d" "$wp_cfg"; done
        
        if ! grep -q "WP_CACHE_KEY_SALT" "$wp_cfg"; then
            sed -i "/define( 'WP_CACHE_KEY_SALT'/d" "$wp_cfg"
            sed -i "s|^define( 'NONCE_SALT'.*|&\ndefine( 'WP_CACHE_KEY_SALT', '$name_web' );|" "$wp_cfg"
            "${run_wp[@]}" config shuffle-salts WP_CACHE_KEY_SALT --force >/dev/null 2>&1
            for line_num in $(grep -n "define( 'WP_CACHE_KEY_SALT'" "$wp_cfg" | head -n -1 | cut -d: -f1 | tac); do sed -i "${line_num}d" "$wp_cfg"; done
        fi

        "${run_wp[@]}" plugin install wp-redis --activate >/dev/null 2>&1
        "${run_wp[@]}" redis enable >/dev/null 2>&1
        _rundone "Kích hoạt Pantheon wp-redis cho website $name_web"
    else
        echo "Chưa cài đặt redis trên hệ thống, vui lòng cài đặt redis"
    fi
}

