#!/bin/bash

sed -i -e '/^errorlog /,/^}$/d' /usr/local/lsws/conf/httpd_config.conf
echo '
errorlog logs/error.log {
  logLevel                ERROR
  debugLevel              0
  rollingSize             10M
  keepDays                30
  compressArchive         1
  enableStderrLog         0
}
' >>/usr/local/lsws/conf/httpd_config.conf

/usr/local/lsws/bin/lswsctrl reload >/dev/null 2>&1
echo "Hoàn tất giảm logLevel log từ thành WARNing thành error"
