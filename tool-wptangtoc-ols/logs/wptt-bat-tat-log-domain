      echo -e "${C_CYAN}│${C_RESET}  ${C_GREEN}1)${C_RESET} ${C_BOLD_WHITE}BẬT ghi Logs${C_RESET} (Lưu truy cập access.log & Bắt lỗi error.log)$(printf '%*s' "$pad_opt1" "")${C_CYAN}│${C_RESET}"

