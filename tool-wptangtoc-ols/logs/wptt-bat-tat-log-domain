    center_text "${C_YELLOW}THAO TÁC ĐỒNG LOẠT: CẤU HÌNH GHI LOGS WEBSITE${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "  Bạn đang thao tác quản lý tính năng ghi nhật ký cho toàn bộ hệ thống." 2
    left_text "  Vui lòng chọn hành động bạn muốn thực hiện:" 2
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

