      else
        echo -e "${C_YELLOW}Đã hủy thao tác.${C_RESET}" && sleep 1
        exec /etc/wptt/wptt-logs-main 1
      fi
    fi
  fi
fi

# ==============================================================================
# THỰC THI CHỈNH SỬA FILE VHOST
# ==============================================================================
echo ""
for DOMAIN in "${DOMAIN_LIST[@]}"; do
  _runing "$action_text cho website $DOMAIN"
  process_logs_domain "$DOMAIN" "$wp_action"
  echo "$action_text website $DOMAIN: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "$action_text cho website $DOMAIN"
done

# ==============================================================================
# RELOAD LITESPEED & HIỂN THỊ KẾT QUẢ
# ==============================================================================
wptt_smart_reload_lsws >/dev/null 2>&1

echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HOÀN TẤT THIẾT LẬP LOGS${C_RESET}"
echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
if [[ ${#DOMAIN_LIST[@]} -ge 2 ]]; then
  left_text "Phạm vi tác động : ${C_YELLOW}TẤT CẢ WEBSITE (${#DOMAIN_LIST[@]} web)${C_RESET}" 2
else
  left_text "Website thao tác : ${C_YELLOW}${DOMAIN_LIST[0]}${C_RESET}" 2
fi

if [[ "$wp_action" == "bat" ]]; then
  left_text "Trạng thái mới   : ${C_GREEN}Đã BẬT chức năng ghi Logs cho website.${C_RESET}" 2
else
  left_text "Trạng thái mới   : ${C_YELLOW}Đã TẮT chức năng ghi Logs để tối ưu Disk I/O.${C_RESET}" 2
fi
echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

if [[ ${1:-} == "98" && $CLI_MODE -eq 0 ]]; then
  exec /etc/wptt/wptt-logs-main 1
fi
