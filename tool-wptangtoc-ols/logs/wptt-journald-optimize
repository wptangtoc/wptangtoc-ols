#!/bin/bash
mkdir -p /etc/systemd/journald.conf.d

cat << 'EOF' > /etc/systemd/journald.conf.d/00-wptt.conf
[Journal]
# Giới hạn dung lượng tối đa lưu trên ổ cứng (/var/log/journal)
SystemMaxUse=100M

# Giới hạn dung lượng tối đa lưu tạm trên RAM (/run/log/journal)
RuntimeMaxUse=20M

# Kích thước tối đa của mỗi file log đơn lẻ trước khi xoay vòng
SystemMaxFileSize=20M

# Tự động dọn dẹp log cũ hơn 1 tháng
MaxRetentionSec=1month

# Cơ chế nén log nhị phân để tiết kiệm đĩa
Compress=yes
EOF

# Nạp lại cấu hình tức thì mà không làm rớt service
systemctl restart systemd-journald
