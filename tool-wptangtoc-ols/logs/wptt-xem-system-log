#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null

LOG_FILE="/var/log/wptangtoc-ols.log"

clear
print_border_top
center_text "${C_YELLOW}NHẬT KÝ HỆ THỐNG WPTANGTOC OLS${C_RESET}"
print_border_mid
left_text "${C_CYAN}Đường dẫn:${C_RESET} $LOG_FILE"
left_text "${C_CYAN}Phím tắt:${C_RESET} Phím lên/xuống để cuộn | Bấm [q] để thoát"
print_border_bot

echo ""

if [[ ! -f "$LOG_FILE" ]]; then
    _runloi "Chưa tìm thấy tệp nhật ký hệ thống nào."
    echo -en "\n${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu...${C_RESET}"
    read -r _
    exec /etc/wptt/wptt-logs-main 1
    exit 0
fi

# Sử dụng lệnh less để xem log, hỗ trợ cuộn, tìm kiếm, hiển thị số dòng
# c: Xóa màn hình trước khi in, G: Cuộn thẳng xuống dòng cuối cùng (log mới nhất)
less +G -c "$LOG_FILE"

# Sau khi người dùng bấm 'q' để thoát khỏi less
echo -en "\n${C_GREEN}➜ Nhấn phím [Enter] để quay lại Menu Logs...${C_RESET}"
read -r _

if [[ "${1:-}" == "98" ]]; then
    exec /etc/wptt/wptt-logs-main 1
fi
