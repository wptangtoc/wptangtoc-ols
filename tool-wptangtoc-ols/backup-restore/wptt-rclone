#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com
# @since: 2026

function huong_dan() {
  Thiết lập Google Drive đám mây là một giải pháp sao lưu website hiệu quả, an toàn và có khả năng tùy biến cao.
  Đây là một giải pháp mạnh mẽ và linh hoạt, cho phép bạn lưu trữ các bản sao lưu website của mình ở một vị trí riêng biệt.
}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
stty iutf8

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Thiết lập Rclone (Google Drive)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# KIỂM TRA TRẠNG THÁI CÀI ĐẶT TRƯỚC ĐÓ
# ==============================================================================
if [[ ! -d /root/.config/rclone ]]; then
  mkdir -p /root/.config/rclone
  chmod 751 /root/.config
fi

duong_dan_rclone="/root/.config/rclone/rclone.conf"
if [[ -f "$duong_dan_rclone" && -s "$duong_dan_rclone" ]]; then
  
  raw_type=$(grep -A 1 '\[wptangtoc\]' "$duong_dan_rclone" 2>/dev/null | grep 'type' | awk -F '=' '{print $2}' | tr -d ' ')
  
  case "$raw_type" in
    drive)    cloud_name="Google Drive" ;;
    onedrive) cloud_name="Microsoft OneDrive" ;;
    s3)       cloud_name="S3 Storage (AWS/R2/MinIO...)" ;;
    *)        cloud_name="Cloud Khác ($raw_type)" ;;
  esac

  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}PHÁT HIỆN KẾT NỐI CLOUD TỒN TẠI${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Hệ thống phát hiện VPS đã được cấu hình lưu trữ Đám mây từ trước."
  left_text "Trạng thái hiện tại: Đang kết nối nền tảng [ ${C_GREEN}${cloud_name}${C_RESET} ]"
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  
  msg_title="BẠN CÓ MUỐN GỠ KẾT NỐI CŨ VÀ CÀI ĐẶT LẠI KHÔNG?"
  msg_sub1="Đang dùng : ${C_GREEN}$cloud_name${C_RESET}"
  msg_sub2="Ghi chú  : Dữ liệu cũ trên $cloud_name sẽ không bị xóa."
  
  if ! wptt_xac_nhan "$msg_title" "$msg_sub1" "$msg_sub2" "Đồng ý Xóa và Cài Mới" "Giữ nguyên (Thoát)"; then
    exec /etc/wptt/wptt-backup-restore-main 1
    exit
  fi
  
  rm -f "${duong_dan_rclone:?}"
  clear
fi

# ==============================================================================
# CÀI ĐẶT BINARY RCLONE (ĐỘNG CƠ TẢI XUỐNG THÔNG MINH + GIAO DIỆN PV)
# ==============================================================================
_runing "Đang cài đặt và đồng bộ hóa công cụ Rclone..."
rm -rf ~/.config/rclone
mkdir -p /root/.config/rclone
rm -rf /usr/sbin/rclone /usr/bin/rclone
cd /tmp || exit

if ! command -v unzip &>/dev/null; then
    if [ -f /etc/redhat-release ]; then
      dnf install unzip -y -q >/dev/null 2>&1 || yum install unzip -y -q >/dev/null 2>&1
    elif [ -f /etc/debian_version ]; then apt-get update -q >/dev/null 2>&1 && apt-get install unzip -y -q >/dev/null 2>&1; fi
fi

phienban=$(curl --connect-timeout 5 -s https://downloads.rclone.org/version.txt | awk '{print $2}' | tr -d 'v')
[[ -z "$phienban" ]] && phienban="1.74.2"

if uname -m | grep -q 'aarch64'; then
  cpu_dong_="linux-arm64"
else
  cpu_dong_="linux-amd64"
fi

FILE_ZIP="rclone-v${phienban}-${cpu_dong_}.zip"
rm -f "${FILE_ZIP:?}"

URL_1="https://github.com/rclone/rclone/releases/download/v${phienban}/$FILE_ZIP"
URL_2="https://downloads.rclone.org/v${phienban}/$FILE_ZIP"

echo ""

function wptt_download_rclone_ux() {
  local url="$1"
  local fsize
  fsize=$(curl -sIL --max-time 5 "$url" | grep -i -E "content-length" | tail -n 1 | awk '{print $2}' | tr -d '\r')

  if command -v pv &>/dev/null && [[ -n "$fsize" && "$fsize" -gt 0 ]]; then
    curl -sL --connect-timeout 5 --speed-limit 102400 --speed-time 8 "$url" | pv -s "$fsize" -N "Tải Rclone v${phienban}" -p -t -e -r -b -w 90 > "$FILE_ZIP"
    local dl_status=${PIPESTATUS[0]}
    echo -en "\033[1A\033[2K\r"
    return "$dl_status"
  else
    wget -q --show-progress --timeout=8 --tries=2 "$url" -O "$FILE_ZIP"
    local dl_status=$?
    echo -en "\033[1A\033[2K\r"
    return $dl_status
  fi
}

success_download=0
for url in "$URL_1" "$URL_2"; do
  if wptt_download_rclone_ux "$url"; then
    if unzip -t "$FILE_ZIP" &>/dev/null; then
      success_download=1
      break
    fi
  fi
  rm -f "${FILE_ZIP:?}"
done

if [[ $success_download -eq 0 ]]; then
  _runloi "Cài đặt Rclone"
  echo -e "${C_RED}Lỗi: Mạng quốc tế nghẽn, không thể tải Rclone. Vui lòng thử lại sau!${C_RESET}"
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
  exec /usr/bin/wptangtoc 1
  exit 1
fi

echo -en "\033[1A\033[2K\r"

unzip -oq "$FILE_ZIP"
cp -r "rclone-v${phienban}-${cpu_dong_}/rclone" /usr/sbin/
chmod 755 /usr/sbin/rclone
rm -rf "/tmp/rclone-v${phienban:?}-${cpu_dong_:?}" "${FILE_ZIP:?}"
_rundone "Cài đặt nền tảng Rclone thành công (Phiên bản: $phienban)"

# ==============================================================================
# LỰA CHỌN CLIENT ID & KIỂM TRA BẰNG DUMMY TOKEN (UX TỐI ƯU)
# ==============================================================================
box_inner_width=${box_inner_width:-78}
echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}CẤU HÌNH API GOOGLE DRIVE${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Google giới hạn nghiêm ngặt số lượt truy cập trên API dùng chung của Rclone."
left_text "Để bứt tốc độ Upload và chống lỗi 403 (Rate Limit), hệ thống KHUYÊN DÙNG"
left_text "Client ID cá nhân. Bạn có thể bỏ qua nếu muốn dùng API mặc định."
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯"

echo ""
if wptt_xac_nhan "Bạn có muốn thiết lập Google Drive Client ID cá nhân không?" "" "" "Có (Khuyên dùng)" "Không (Dùng mặc định)"; then
    echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
    center_text "${C_YELLOW}NHẬP THÔNG SỐ CLIENT ID CÁ NHÂN${C_RESET}"
    echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
    left_text "Hướng dẫn tạo: https://wptangtoc.com/google-drive-client-id-ca-nhan-rclone/"
    echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯"

    echo -en "${C_GREEN}➤ Nhập Google Client ID của bạn: ${C_RESET}"
    read -r custom_client_id
    echo -en "${C_GREEN}➤ Nhập Google Client Secret của bạn: ${C_RESET}"
    read -r custom_client_secret

    # Thanh trừng rác (CRLF, khoảng trắng)
    custom_client_id="${custom_client_id//$'\r'/}"
    custom_client_id="${custom_client_id//[[:space:]]/}"
    custom_client_secret="${custom_client_secret//$'\r'/}"
    custom_client_secret="${custom_client_secret//[[:space:]]/}"

    if [[ -z "$custom_client_id" || -z "$custom_client_secret" ]]; then
        _runloi "Thông số bị bỏ trống. Tự động lùi về cấu hình API mặc định!"
        custom_client_id=""
        custom_client_secret=""
        cmd_rclone="rclone authorize \"drive\" \"eyJzY29wZSI6ImRyaXZlIn0\""
    else
        _runing "Đang kiểm tra tính hợp lệ của Client ID & Secret..."
        api_test=$(curl -s -X POST https://oauth2.googleapis.com/token \
          -d "client_id=$custom_client_id" \
          -d "client_secret=$custom_client_secret" \
          -d "grant_type=refresh_token" \
          -d "refresh_token=wptangtoc_dummy_test_token")

        if [[ "$api_test" == *"invalid_client"* || "$api_test" == *"Unauthorized"* ]]; then
            _runloi "Kiểm tra thất bại: ID hoặc Secret không chính xác!"
            echo -e "${C_YELLOW}Google API từ chối xác thực. Hệ thống sẽ tự động dùng API mặc định.${C_RESET}"
            sleep 2
            custom_client_id=""
            custom_client_secret=""
            cmd_rclone="rclone authorize \"drive\" \"eyJzY29wZSI6ImRyaXZlIn0\""
        else
            _rundone "Client ID và Secret cấu trúc hợp lệ (Đã được Google xác nhận)!"
            cmd_rclone="rclone authorize \"drive\" --drive-client-id \"$custom_client_id\" --drive-client-secret \"$custom_client_secret\""
        fi
    fi
else
    # Lệnh sinh Token mặc định
    custom_client_id=""
    custom_client_secret=""
    cmd_rclone="rclone authorize \"drive\" \"eyJzY29wZSI6ImRyaXZlIn0\""
fi

# ==============================================================================
# HƯỚNG DẪN XÁC THỰC VÀ SINH TOKEN
# ==============================================================================

center_text_1() {
  local text="$1"
  # Tẩy sạch ký tự mã màu ANSI để đếm chiều dài cho chuẩn
  local clean_text=$(echo -e "$text" | sed "s/\x1B\[[0-9;]*[a-zA-Z]//g")
  local text_len=${#clean_text}

  if ((text_len >= box_inner_width)); then
    printf "${C_CYAN}${C_RESET} %b ${C_CYAN}${C_RESET}\n" "$text"
    return
  fi

  local pad_left=$(((box_inner_width - text_len) / 2))
  local pad_right=$((box_inner_width - text_len - pad_left))
  printf "${C_CYAN}${C_RESET}%*s%b%*s${C_CYAN}${C_RESET}\n" "$pad_left" "" "$text" "$pad_right" ""
}


echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}HƯỚNG DẪN XÁC THỰC GOOGLE DRIVE${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "${C_RED}CHÚ Ý: KHÔNG CHẠY LỆNH DƯỚI ĐÂY TRÊN VPS NÀY!${C_RESET}" 2
left_text "Hãy mở CMD (Windows) hoặc Terminal (Macbook) trên ${C_YELLOW}MÁY TÍNH CÁ NHÂN${C_RESET}" 2
left_text "của bạn, copy và dán lệnh sau vào để trình duyệt tự mở lên:" 2
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
center_text_1 "${C_YELLOW}$cmd_rclone${C_RESET}"
echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
left_text "Hoặc truy cập URL này để xem hướng dẫn chi tiết:" 2
center_text "${C_GREEN}https://wptangtoc.com/xac-thuc-drive/${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# BẮT TOKEN BẰNG CƠ CHẾ SLURP (TỰ ĐỘNG HÚT MULTI-LINE CHỈ VỚI 1 ENTER)
# ==============================================================================
echo -en "${C_CYAN}Dán TOÀN BỘ mã Token của bạn vào đây [0=Thoát]: ${C_RESET}"
read -r checkid

if [[ "$checkid" == "0" || -z "$checkid" ]]; then
  echo -e "\n${C_YELLOW}Đã hủy thao tác thiết lập.${C_RESET}"
  sleep 1
  exec /etc/wptt/wptt-backup-restore-main 1
  exit
fi

# Hút nốt các dòng còn lại trong bộ đệm
while read -r -t 0.1 extra_line; do
  checkid="$checkid$extra_line"
done

# Tiêu diệt triệt để ký tự CRLF lọt vào từ Windows Clipboard
checkid="${checkid//$'\r'/}"

_runing "Đang kết nối và thiết lập Google Drive (API)..."

# ==============================================================================
# LỌC VÀ TIÊM (INJECT) TOKEN VÀO FILE CONFIG CHUẨN XÁC
# ==============================================================================
clean_token=$(echo "$checkid" | sed 's/.*Paste the following into your remote machine --->//Ig' | sed 's/<---End paste.*//Ig' | tr -d '\n\r ')

if [[ "$clean_token" == eyJ* ]]; then
  decoded_token=$(echo "$clean_token" | base64 -d 2>/dev/null)
  clean_token=$(echo "$decoded_token" | sed 's/^{"token":"//' | sed 's/"}$//')
  clean_token="${clean_token//\\\"/\"}"
fi

# Ghi đè cấu hình cơ bản thẳng vào tệp tin rclone.conf
cat <<EOF > "$duong_dan_rclone"
[wptangtoc]
type = drive
scope = drive
EOF

# Chỉ tiêm ID và Secret vào nếu người dùng chọn và nhập đúng (Đã qua bài test API)
if [[ -n "$custom_client_id" && -n "$custom_client_secret" ]]; then
    echo "client_id = $custom_client_id" >> "$duong_dan_rclone"
    echo "client_secret = $custom_client_secret" >> "$duong_dan_rclone"
fi

# Chốt hạ mã Token
echo "token = $clean_token" >> "$duong_dan_rclone"

# KIỂM TRA VÀ KHỞI TẠO THƯ MỤC BACKUP
if grep -q 'wptangtoc' "$duong_dan_rclone" 2>/dev/null; then
  check_tao_thu_muc=$(rclone lsd wptangtoc: 2>/dev/null | grep 'wptangtoc_ols_backup')
  if [[ -z "$check_tao_thu_muc" ]]; then
    rclone mkdir wptangtoc:wptangtoc_ols_backup >/dev/null 2>&1
  fi
fi

if rclone lsd wptangtoc: 2>/dev/null | grep -q 'wptangtoc_ols_backup'; then
  _rundone "Thiết lập kết nối Google Drive thành công"

  echo -e "\n${C_GREEN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_BOLD_WHITE}HOÀN TẤT KẾT NỐI CLOUD${C_RESET}"
  echo -e "${C_GREEN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  left_text "Nền tảng    : ${C_YELLOW}Google Drive${C_RESET}"
  if [[ -n "$custom_client_id" ]]; then
      left_text "Giao thức   : ${C_GREEN}API Cá nhân (Bứt tốc & Chống Rate Limit)${C_RESET}"
  else
      left_text "Giao thức   : API Mặc định (Dùng chung)"
  fi
  left_text "Trạng thái  : ${C_GREEN}Kết nối Token hợp lệ.${C_RESET}"
  left_text "Thư mục lưu : Khởi tạo thành công [wptangtoc_ols_backup/]"
  echo -e "${C_GREEN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

  if ls /etc/cron.d/backup*.cron 1>/dev/null 2>&1; then
    echo -e "${C_YELLOW}Ghi chú:${C_RESET} Bạn đang có các tiến trình Auto Backup đã được bật."
    echo -e "Hệ thống sẽ tự động sử dụng Google Drive làm kho lưu trữ chính trong chu kỳ tới."
  fi
else
  _runloi "Thiết lập Google Drive thất bại"
  echo -e "${C_RED}Lỗi: Mã Token không hợp lệ hoặc bị từ chối truy cập. Vui lòng kiểm tra lại Token hoặc Client ID.${C_RESET}"
  rm -f "${duong_dan_rclone:?}"
fi

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
