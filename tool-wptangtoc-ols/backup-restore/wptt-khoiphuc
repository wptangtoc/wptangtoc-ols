flock -u 200
exec 200>&-
rm -f "/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME:?}.lock" 2>/dev/null
rm -f "/etc/wptt/tmp/lock_chmod_watcher_${NAME}.active" 2>/dev/null

