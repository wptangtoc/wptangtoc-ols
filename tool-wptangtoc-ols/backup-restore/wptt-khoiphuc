wptt_apply_permissions() {
    local target_dir="$1"
    _runing "Đang thiết lập phân quyền an toàn (Pre-flight) cho: $target_dir"
    
    find "$target_dir" -type f \( -perm -4000 -o -perm -2000 \) -print0 | xargs -0 -r chmod ugo-s
    chown -hR "$User_name_vhost":"$User_name_vhost" "$target_dir"

    if [[ -n "$lock_down" ]]; then
        find "$target_dir" -user "$User_name_vhost" -type f -print0 | xargs -0 chmod 404
        find "$target_dir" -user "$User_name_vhost" -type d -print0 | xargs -0 chmod 515
        [[ -d "$target_dir/wp-content/uploads" ]] && find "$target_dir/wp-content/uploads" -user "$User_name_vhost" -type d -print0 | xargs -0 chmod 755
    else
        find "$target_dir" -user "$User_name_vhost" -type f -print0 | xargs -0 chmod 644
        find "$target_dir" -user "$User_name_vhost" -type d -print0 | xargs -0 chmod 755
    fi
    
    _rundone "Thiết lập phân quyền hoàn tất"
}


