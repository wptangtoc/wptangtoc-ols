archive_size_kb=$(du -k "$duong_dan_thu_muc_ma_nguon" | cut -f1)

# Lấy kích thước bung nén thực tế hoặc ước lượng
if [[ "$file" == *".zip" ]]; then
  unzipped_size_kb=$(unzip -Zt "$duong_dan_thu_muc_ma_nguon" 2>/dev/null | awk '{print $3}' | awk '{printf "%d", $1/1024}')
else
  unzipped_size_kb=$((archive_size_kb * 3))
fi

[[ -z "$unzipped_size_kb" || "$unzipped_size_kb" -eq 0 ]] && unzipped_size_kb=$((archive_size_kb * 3))

required_space_kb=$((unzipped_size_kb * 15 / 10))

thuc_thi_giai_nen() {
	local target_dir
	target_dir="$1"
  if [[ "$file" == *".zip" ]]; then
    if ! command -v unzip &>/dev/null; then
      if [ -f /etc/redhat-release ]; then dnf install unzip -y -q >/dev/null 2>&1 || yum install unzip -y -q >/dev/null 2>&1;
      elif [ -f /etc/debian_version ]; then apt-get update -q >/dev/null 2>&1 && apt-get install unzip -y -q >/dev/null 2>&1; fi
    fi
    local total_files=$(unzip -Z -1 "$duong_dan_thu_muc_ma_nguon" 2>/dev/null | wc -l)
    if unzip -l "$duong_dan_thu_muc_ma_nguon" | awk '{ print $4 }' | grep -q '^wp-load.php$'; then
      unzip -o "$duong_dan_thu_muc_ma_nguon" -d "$target_dir"/ | pv -f -p -l -s "$total_files" -N "Tiến độ giải nén" >/dev/null
    else
      check_path_file_wp_load_bi_boc_boi_thu_muc=$(unzip -l "$duong_dan_thu_muc_ma_nguon" | awk '{ print $4 }' | grep '/wp-load.php$')
      if [[ -n "$check_path_file_wp_load_bi_boc_boi_thu_muc" ]]; then
        check_path_file_wp_load_bi_boc_boi_thu_muc_change=$(echo "$check_path_file_wp_load_bi_boc_boi_thu_muc" | sed 's/wp-load.php/*/g')
        TEMP_DIR_ma_nguon=$(mktemp -d /etc/wptt/tmp/XXXXXX)
        unzip -o "$duong_dan_thu_muc_ma_nguon" -d "$TEMP_DIR_ma_nguon" | pv -f -p -l -s "$total_files" -N "Tiến độ giải nén" >/dev/null
        mv "$TEMP_DIR_ma_nguon"/"$check_path_file_wp_load_bi_boc_boi_thu_muc_change" "$target_dir"/
        rm -rf "${TEMP_DIR_ma_nguon:?}"
      else
        unzip -o "$duong_dan_thu_muc_ma_nguon" -d "$target_dir"/ | pv -f -p -l -s "$total_files" -N "Tiến độ giải nén" >/dev/null
      fi
    fi
    echo -en "\033[1A\033[2K\r"
  elif [[ "$file" == *".tar.zst" ]]; then
    [[ -z $(which zstd) ]] && dnf install zstd -y -q >/dev/null 2>&1
    [[ -z $(which tar) ]] && dnf install tar -y -q >/dev/null 2>&1
    local fsize=$(stat -c %s "$duong_dan_thu_muc_ma_nguon")
    if tar --use-compress-program="zstd" -tvf "$duong_dan_thu_muc_ma_nguon" | awk '{ print $6 }' | grep -q '^./wp-load.php$'; then
      pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="zstd" -xf - -C "$target_dir" --overwrite
    else
      check_path_file_wp_load_bi_boc_boi_thu_muc=$(tar --use-compress-program="zstd" -tvf "$duong_dan_thu_muc_ma_nguon" | awk '{ print $6 }' | sed 's#\./##g' | grep '/wp-load.php$')
      if [[ -n "$check_path_file_wp_load_bi_boc_boi_thu_muc" ]]; then
        check_path_file_wp_load_bi_boc_boi_thu_muc_change=$(echo "$check_path_file_wp_load_bi_boc_boi_thu_muc" | sed 's/wp-load.php/*/g')
        TEMP_DIR_ma_nguon=$(mktemp -d /etc/wptt/tmp/XXXXXX)
        pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="zstd" -xf - -C "$TEMP_DIR_ma_nguon" --overwrite
        mv "$TEMP_DIR_ma_nguon"/"$check_path_file_wp_load_bi_boc_boi_thu_muc_change" "$target_dir"
        rm -rf "${TEMP_DIR_ma_nguon:?}"
      else
        pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="zstd" -xf - -C "$target_dir" --overwrite
      fi
    fi
    echo -en "\033[1A\033[2K\r"
  elif [[ "$file" == *".tar.gz" ]]; then
    [[ -z $(which pigz) ]] && dnf install pigz -y -q >/dev/null 2>&1
    [[ -z $(which tar) ]] && dnf install tar -y -q >/dev/null 2>&1
    local fsize=$(stat -c %s "$duong_dan_thu_muc_ma_nguon")
    if tar -tvzf "$duong_dan_thu_muc_ma_nguon" | awk '{ print $6 }' | grep -q '^wp-load.php$'; then
      pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="pigz" -xf - -C "$target_dir" --overwrite
    else
      check_path_file_wp_load_bi_boc_boi_thu_muc=$(tar -tvzf "$duong_dan_thu_muc_ma_nguon" | awk '{ print $6 }' | grep '/wp-load.php$')
      if [[ -n "$check_path_file_wp_load_bi_boc_boi_thu_muc" ]]; then
        check_path_file_wp_load_bi_boc_boi_thu_muc_change=$(echo "$check_path_file_wp_load_bi_boc_boi_thu_muc" | sed 's/wp-load.php/*/g')
        TEMP_DIR_ma_nguon=$(mktemp -d /etc/wptt/tmp/XXXXXX)
        pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="pigz" -xf - -C "$TEMP_DIR_ma_nguon" --overwrite
        mv "$TEMP_DIR_ma_nguon"/"$check_path_file_wp_load_bi_boc_boi_thu_muc_change" "$target_dir"
        rm -rf "${TEMP_DIR_ma_nguon:?}"
      else
        pv -f -p -s "$fsize" -N "Tiến độ giải nén" "$duong_dan_thu_muc_ma_nguon" | tar --use-compress-program="pigz" -xf - -C "$target_dir" --overwrite
      fi
    fi
    echo -en "\033[1A\033[2K\r"
  fi
}

# 2. Phân luồng chiến lược khôi phục bài toán khi ổ cứng dư giả: giải nén ra vị trí khác rồi rồi sau đó move vào như vậy nó hạn chế downtime hơn
if (( free_space_kb > required_space_kb )); then
  
  THU_MUC_TAM="/usr/local/lsws/$NAME/html_temp_wptt"
  rm -rf "$THU_MUC_TAM" && mkdir -p "$THU_MUC_TAM"
  
  thuc_thi_giai_nen "$THU_MUC_TAM"
  
  if [[ -f "$THU_MUC_TAM/wp-load.php" ]]; then
    # Cứu hộ các tệp tin cấu hình và file ẩn quan trọng trước khi xóa mã nguồn cũ
    if [[ -f "/usr/local/lsws/${NAME}/html/.htaccess" && ! -f "$THU_MUC_TAM/.htaccess" ]]; then
        cp -p "/usr/local/lsws/${NAME}/html/.htaccess" "$THU_MUC_TAM/"
    fi
    
    if [[ -f "/usr/local/lsws/${NAME}/html/wp-content/.htaccess" && ! -f "$THU_MUC_TAM/wp-content/.htaccess" ]]; then
        cp -p "/usr/local/lsws/${NAME}/html/wp-content/.htaccess" "$THU_MUC_TAM/wp-content"
    fi
    
    if [[ -f "/usr/local/lsws/${NAME}/html/wp-config.php" && ! -f "$THU_MUC_TAM/wp-config.php" ]]; then
        cp -p "/usr/local/lsws/${NAME}/html/wp-config.php" "$THU_MUC_TAM/"
    fi


	THU_MUC_CHINH="/usr/local/lsws/${NAME}/html"
    # 1. Gọi Python3 đâm thẳng vào libc.so.6 để xài Syscall RENAME_EXCHANGE (Cờ = 2)
    python3 -c "
import ctypes
import sys
try:
    libc = ctypes.CDLL('libc.so.6')
    # AT_FDCWD = -100, RENAME_EXCHANGE = 2
    res = libc.renameat2(-100, b'${THU_MUC_CHINH}', -100, b'${THU_MUC_TAM}', 2)
    if res != 0:
        sys.exit(1)
except Exception:
    sys.exit(1)
" >/dev/null 2>&1

    # 2. Kiểm tra sinh tử (Bắt buộc phải có)
    if [[ $? -eq 0 ]]; then
        # Nếu tráo đổi THÀNH CÔNG: THU_MUC_TAM giờ đang chứa rác cũ, dọn dẹp nó
        rm -rf "$THU_MUC_TAM"
    else
        # Nếu thất bại (Lỗi Python, Kernel cũ...): Kích hoạt chế độ dự phòng bằng lệnh mv, tuơng thích nguợc nó cũng đuợc 9.9 điểm so với kỹ thuật RENAME_EXCHANGE
        mv "$THU_MUC_CHINH" "${THU_MUC_CHINH}_old_trash"
        mv "$THU_MUC_TAM" "$THU_MUC_CHINH"
        rm -rf "${THU_MUC_CHINH}_old_trash"
    fi

    _rundone "$giai_nen $ma_nguon website $NAME"
  else
    _runloi "Lỗi giải nén! Đã hủy bỏ thao tác để bảo vệ toàn vẹn mã nguồn gốc."
    rm -rf "$THU_MUC_TAM"
    flock -u 200; exec 200>&-
    rm -f "/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME:?}.lock" 2>/dev/null
    exit 1
  fi
else

#kiểm tra tính toàn vẹn của file, nếu file bị lỗi thì tuyệt đối không xoá mã nguồn phải check kỹ càng truớc
  if [[ "$file" == *".zip" ]]; then
    if ! unzip -t "$duong_dan_thu_muc_ma_nguon" >/dev/null 2>&1; then
      _runloi "Lỗi: File .zip bị hỏng! Bảo lưu nguyên vẹn mã nguồn cũ."
      flock -u 200; exec 200>&-
      exit 1
    fi
  elif [[ "$file" == *".tar.zst" ]]; then
    if ! tar --use-compress-program="zstd" -tf "$duong_dan_thu_muc_ma_nguon" >/dev/null 2>&1; then
      _runloi "Lỗi: File .tar.zst bị hỏng! Bảo lưu nguyên vẹn mã nguồn cũ."
      flock -u 200; exec 200>&-
      exit 1
    fi
  elif [[ "$file" == *".tar.gz" ]]; then
    if ! tar -tf "$duong_dan_thu_muc_ma_nguon" >/dev/null 2>&1; then
      _runloi "Lỗi: File .tar.gz bị hỏng! Bảo lưu nguyên vẹn mã nguồn cũ."
      flock -u 200; exec 200>&-
      exit 1
    fi
  fi
  
  #tính toán bài toán khi ổ cứng không đủ phải xoá mã nguồn hiện hữu truớc khi giải nén, tình huống như mã nguồn nặng 6GB mà ổ cứng có 10GB. và file zip 4GB chả hạn. bắt buộc phải xoá mã nguồn để giải phóng disk truớc khi giải nén không thì full disk
  if wptt_kha_dung_de_xoa_xac_thuc "$NAME"; then 
    rm -rf /usr/local/lsws/"${NAME:?}"/html/*
  fi

  thuc_thi_giai_nen "/usr/local/lsws/$NAME/html"
  _rundone "$giai_nen $ma_nguon website $NAME"
fi

