          exit_code=$?
        fi
        [[ $exit_code -gt 1 ]] && return 1
      fi
    fi
  elif [[ "$file" == *".tar.gz" ]]; then
    [[ -z $(command -v pigz 2>/dev/null) ]] && dnf install pigz -y -q >/dev/null 2>&1
    [[ -z $(command -v tar 2>/dev/null) ]] && dnf install tar -y -q >/dev/null 2>&1
    local fsize=$(stat -c %s "$duong_dan_thu_muc_ma_nguon")
    if tar -tvzf "$duong_dan_thu_muc_ma_nguon" 2>/dev/null | awk '{ print $6 }' | grep -q '^./wp-load.php$\|^wp-load.php$\|^/wp-load.php$'; then
