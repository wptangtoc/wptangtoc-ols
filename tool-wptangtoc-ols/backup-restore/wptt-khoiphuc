        fi
        [[ $exit_code -gt 1 ]] && { rm -rf "${TEMP_DIR_ma_nguon:?}"; return 1; }

        mv "$TEMP_DIR_ma_nguon"/"$check_path_change" "$target_dir" 2>/dev/null
