#!/bin/bash
set -o pipefail
umask 077

#bảo đảm cho môi truờng cron hoạt động chuẩn 100%, để cho rclone xác nhận rclone.conf chuẩn xác
export HOME=/root
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @description: Sao lưu lũy tiến từng phần (Tiết kiệm 80% ổ cứng) - Tối ưu UX/Hiệu năng
# @since: 2026

function huong_dan() {
  cat <<'EOF'
  💾 TÍNH NĂNG: SAO LƯU WEBSITE LŨY TIẾN (INCREMENTAL BACKUP)

  Sao lưu website là việc đóng gói và cất giữ toàn bộ dữ liệu của bạn để phòng ngừa rủi ro. Tuy nhiên, với các website WordPress lâu năm có dung lượng lớn (Ví dụ: 10GB - chủ yếu là hình ảnh), nếu mỗi ngày bạn backup 1 bản Full, bạn sẽ tốn 300GB ổ cứng chỉ trong 1 tháng.

  Sao lưu lũy tiến (Incremental Backup) là công nghệ sinh ra để giải bài toán đó. Nó giúp bạn tiết kiệm đến 90% dung lượng lưu trữ (và tiết kiệm cả băng thông mạng khi upload lên Cloud).

  🚀 NGUYÊN LÝ HOẠT ĐỘNG THÔNG MINH (CHỈ WORDPRESS):
  Hệ thống sẽ bóc tách cấu trúc website WordPress thành 3 phần riêng biệt thay vì gộp chung vào 1 file zip khổng lồ:
   ➜ Phần 1: Database (Dữ liệu chữ) - Luôn được sao lưu mới hoàn toàn mỗi lần chạy vì dung lượng rất nhỏ.
   ➜ Phần 2: Core (Mã nguồn & Plugin) - Chỉ nặng khoảng vài chục đến vài trăm MB, luôn được sao lưu mới.
   ➜ Phần 3: Hình ảnh (Uploads) - Đây là phần nặng nhất.
       + Đầu mỗi tháng, hệ thống sẽ chốt hạ 1 file zip chứa TOÀN BỘ hình ảnh từ trước đến nay.
       + Những ngày tiếp theo trong tháng, khi bạn chạy tính năng này, hệ thống CHỈ ZIP thêm thư mục hình ảnh của tháng hiện tại (rất nhẹ, vài MB) rồi nối đè (Merge) vào file Core.

  💡 KẾT QUẢ VƯỢT TRỘI:
  Nhờ kỹ thuật này, thay vì mỗi ngày tạo ra 1 file 10GB (30 ngày = 300GB), bạn chỉ cần lưu 1 file gốc 9GB vào đầu tháng, và 29 ngày tiếp theo mỗi ngày tạo ra 1 file vài chục MB. Tổng dung lượng lưu trữ 30 ngày giảm từ 300GB xuống chỉ còn khoảng 11GB.

  ⚠️ YÊU CẦU BẮT BUỘC:
  Để tính năng này hoạt động, website WordPress của bạn PHẢI BẬT tính năng sắp xếp ảnh theo Tháng và Năm (WP-Admin -> Settings -> Media -> Tích chọn "Organize my uploads into month- and year-based folders").
EOF
}

. /etc/wptt/core-functions
wptt_load_main_conf
if [[ -z "$ngon_ngu" ]]; then
  ngon_ngu='vi'
fi
. "/etc/wptt/lang/$ngon_ngu.sh"
. /etc/wptt/echo-color

echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_BOLD_WHITE}$backup_restore ➜ $sao_luu_website (Lũy Tiến)${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

NAME=$1
ggdriver=$2
ggdriver2=$3

if [[ $NAME = "98" ]]; then
  NAME=""
fi

wptt_check_mariadb "${1:-}"

get_cloud_name() {
  local conf="/root/.config/rclone/rclone.conf"
  if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$conf" 2>/dev/null; then
    echo "OneDrive"
  elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$conf" 2>/dev/null; then
    echo "S3 Storage"
  else
    echo "Google Drive"
  fi
}

# Đo dung lượng thực (apparent-size) để hiển thị chính xác tức thì trên ZFS/Btrfs/XFS
get_backup_dir_size() {
  local dir="$1"
  if [[ ! -d "$dir" ]] || [[ -z "$(find "$dir" -type f -print -quit 2>/dev/null)" ]]; then
    printf '0B'
    return 0
  fi
  du -sh --apparent-size "$dir" 2>/dev/null | awk '{print $1}'
}

if [[ -z "$NAME" ]]; then
  . /etc/wptt/tenmien-them-lua-chon-tat-ca-website-by-wordpress
  lua_chon_NAME "$sao_luu_website luỹ tiến"

  if [[ "$NAME" = "0" || -z "$NAME" ]]; then
    exec /etc/wptt/wptt-backup-restore-main 1
  fi
fi

if [[ $2 = '12345' ]] || [[ $2 = '1998' ]]; then
  ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup="ionice -c 3 nice -n 19"
else
  ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup=""
fi

date_nam=$(date +"%Y")
if [[ $NAME = 'Tất cả website' ]]; then
  if [[ -z $3 ]]; then #doi số 3 không có giá trị auto mới hỏi
    unset ggdriver ggdriver2 checkdathietlap
    checkdathietlap=$(grep -q '\[wptangtoc\]' ~/.config/rclone/rclone.conf 2>/dev/null && echo 1)
    if [[ $checkdathietlap ]]; then
      drive_name="$(get_cloud_name)"

      echo "$ban_co_muon file backup uploads $drive_name?"

      prompt="$nhap_lua_chon_cua_ban [1-2]: "
      ggdriver="n"
      options=("$dong_y" "$khong_dong_y")
      PS3="$prompt"
      select opt in "${options[@]}"; do
        case "$REPLY" in
        1) ggdriver="1998"; break ;;
        2) ggdriver="n"; break ;;
        $((${#options[@]} + 1))) printf "\n$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"; break ;;
        *) printf "$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"; break ;;
        esac
      done

      if [[ "$ggdriver" = "1998" ]]; then
        echo "$ban_co_muon $xoa file backup tại local khi đã được lưu trữ đám mây $drive_name không?"
        prompt="$nhap_lua_chon_cua_ban [1-2]: "
        ggdriver2="12345"
        options=("$dong_y" "$khong_dong_y")
        PS3="$prompt"
        select opt in "${options[@]}"; do
          case "$REPLY" in
          1) ggdriver2="1998"; break ;;
          2) ggdriver2="12345"; break ;;
          $((${#options[@]} + 1))) printf "\n$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"; break ;;
          *) printf "$ban_nhap_sai_he_thong_se_chon_khong_dong_y\n"; break ;;
          esac
        done
      fi
    fi
  fi

  START_TIMESTAMP_FILE=$(mktemp -p "/etc/wptt/tmp" wptt_ts_start_XXXXXX) #khởi tạo file temp để xác định bắt đầu thực thi all
  before_optimize_full_all="$(get_backup_dir_size "/usr/local/backup-website")"

  if [[ -d /etc/wptt/vhost ]]; then
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"

      if [[ "$domain" != ?*.?* ]]; then continue; fi

      path_html="/usr/local/lsws/$domain/html/wp-load.php"
      path_uploads_dir_nam="/usr/local/lsws/$domain/html/wp-content/uploads/$date_nam"
      i=1
      if [[ -f "$path_html" && -d "$path_uploads_dir_nam" ]]; then
        /bin/bash /etc/wptt/backup-restore/wptt-saoluu-luy-tien-tung-phan "$domain" "$ggdriver" "$ggdriver2"
      fi
    done
  fi

  # [UX ĐỈNH CAO] - ĐÁ CHẠY NỀN LẤY DUNG LƯỢNG ALL BẤT ĐỒNG BỘ
  if [[ $ggdriver = '1998' ]]; then
    FILE_TEMP_CLOUD_SIZE_ALL=$(mktemp -p "/etc/wptt/tmp" wptt_rclone_XXXXXX.cnf)
    (rclone about wptangtoc: 2>/dev/null >"$FILE_TEMP_CLOUD_SIZE_ALL") &
    PID_CLOUD_SIZE_ALL=$!
  fi

  check_menu_wptangtoc_active=$1
  if [[ $check_menu_wptangtoc_active = "98" ]]; then
    END_TIMESTAMP_FILE=$(mktemp -p "/etc/wptt/tmp" wptt_ts_end_XXXXXX) #kết thúc file temp
    clear
    print_border_top
    left_text "Hoàn tất backup $sao_luu_tat_ca_website (Lũy Tiến)"
    print_border_mid
    for filepath in /etc/wptt/vhost/.*.conf; do
      [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
      domain="${filepath##*/}"
      domain="${domain%.conf}"
      domain="${domain#.}"
      if [[ "$domain" != ?*.?* ]]; then continue; fi

      path="/usr/local/lsws/$domain/html"
      i=1

      if [[ -d "$path" ]]; then
        if [[ $ggdriver2 != '1998' ]]; then
          if [[ -d "/usr/local/backup-website/$domain" ]] && [[ $(find "/usr/local/backup-website/$domain" -type f -newer "$START_TIMESTAMP_FILE" ! -newer "$END_TIMESTAMP_FILE" -print -quit 2>/dev/null) ]]; then
            left_text "Hoàn tất backup website: $domain"
          fi
        else
          left_text "Hoàn tất backup website: $domain"
        fi
      fi
    done

    if [[ $ggdriver2 != '1998' ]]; then
      print_border_mid
      left_text "Dung lượng thư mục trước khi sao lưu  : $before_optimize_full_all"
      left_text "Dung lượng thư mục sau khi sao lưu    : $(get_backup_dir_size "/usr/local/backup-website")"
    fi

    # HỨNG KẾT QUẢ TỪ TIẾN TRÌNH CHẠY NỀN BẤT ĐỒNG BỘ (TẤT CẢ WEBSITE)
    if [[ $ggdriver = '1998' ]]; then
      print_border_mid
      [[ -z "${drive_name:-}" ]] && drive_name="$(get_cloud_name)"
      wait $PID_CLOUD_SIZE_ALL 2>/dev/null
      rclone_about_info=$(cat "$FILE_TEMP_CLOUD_SIZE_ALL" 2>/dev/null)
      rm -f "$FILE_TEMP_CLOUD_SIZE_ALL" 2>/dev/null
      CLOUD_DIR_ALL="wptangtoc_ols_backup"
      if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' /root/.config/rclone/rclone.conf 2>/dev/null; then
        CLOUD_DIR_ALL="wptangtoc-ols-backup"
      elif rclone lsd wptangtoc: 2>/dev/null | grep -q 'wptangtoc-ols-backup'; then
        CLOUD_DIR_ALL="wptangtoc-ols-backup"
      fi

      if echo "$rclone_about_info" | grep -q "Used:"; then
        # === XỬ LÝ CHO GOOGLE DRIVE / ONEDRIVE ===
        drive_total=$(echo "$rclone_about_info" | awk '/^Total:/{print $2" "$3}')
        drive_used=$(echo "$rclone_about_info" | awk '/^Used:/{print $2" "$3}')
        drive_free=$(echo "$rclone_about_info" | awk '/^Free:/{print $2" "$3}')
      else
        # === XỬ LÝ CHO S3 STORAGE (Không có about, dùng rclone size) ===
        rclone_size_info=$(rclone size "wptangtoc:$CLOUD_DIR_ALL" 2>/dev/null)

        # Bóc tách "33.000 GiB" từ dòng "Total size: 33.000 GiB (35438709360 Byte)"
        s3_used_size=$(echo "$rclone_size_info" | awk '/Total size:/{print $3" "$4}')

        # Bóc tách "76" từ dòng "Total objects: 76"
        s3_objects=$(echo "$rclone_size_info" | awk '/Total objects:/{print $3}')

        drive_total="Không xác định (S3 Object Storage)"
        drive_free="Không xác định"

        if [[ -n "$s3_used_size" ]]; then
          drive_used="$s3_used_size (Tổng: $s3_objects files backup)"
        else
          drive_used="Đang cập nhật..."
        fi
      fi

      # Fallback an toàn nếu cả 2 phương thức đều lỗi (VD: Rớt mạng, Token lỗi)
      [[ -z "$drive_total" ]] && drive_total="Không xác định"
      [[ -z "$drive_used" ]] && drive_used="Không xác định"
      [[ -z "$drive_free" ]] && drive_free="Không xác định"

      # In ra giao diện
      left_text "Thống kê không gian lưu trữ $drive_name sau sao lưu:"
      left_text " ▪ Tổng dung lượng : $drive_total"
      left_text " ▪ Đã sử dụng      : $drive_used"
      left_text " ▪ Còn trống       : $drive_free"
      left_text " ▪ Vị trí lưu file : ➜ $CLOUD_DIR_ALL/"
    fi

    print_border_bot
    rm -f "${START_TIMESTAMP_FILE:?}" "${END_TIMESTAMP_FILE:?}"
    exec /etc/wptt/wptt-backup-restore-main 1
  fi
  rm -f "${START_TIMESTAMP_FILE:?}"
  return 2>/dev/null
  exit
fi

# ==============================================================================
# BẮT ĐẦU CƠ CHẾ LOCKING (CHỐNG ĐỤNG ĐỘ TIẾN TRÌNH BACKUP)
# ==============================================================================
if [[ -n "$NAME" && "$NAME" != "Tất cả website" && "$NAME" != "98" ]]; then
  # 1. Định nghĩa file khóa riêng biệt cho từng domain
  LOCK_FILE="/etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME}.lock"

  # 2. Gán File Descriptor 200 cho file khóa này
  exec 200>"$LOCK_FILE"

  # 3. Thử lấy khóa (Non-blocking với -n)
  if ! flock -n 200; then
    echo ""
    echo "========================================================================="
    _runloi "Lỗi Đụng Độ Tiến Trình"
    echoDo "Website $NAME đang được thao tác bởi một tiến trình khác (Backup/Restore)."
    echoDo "Vui lòng chờ tiến trình đó hoàn tất rồi thử lại để tránh hỏng dữ liệu!"
    wptt_logs "INFO" "Sao lưu website $NAME luỹ tiến nhưng bị xung đột"
    echo "========================================================================="

    check_menu_wptangtoc_active=$1
    if [[ $check_menu_wptangtoc_active = "98" || -z "$check_menu_wptangtoc_active" ]]; then
      sleep 3
      exec /etc/wptt/wptt-backup-restore-main 1
    fi
    return 2>/dev/null || exit 1
  fi
fi
# ==============================================================================
# KẾT THÚC CƠ CHẾ LOCKING
# ==============================================================================

times=$(date +%Hgio\_%d\_%m\_%Y)

# LỚP KHIÊN BẢO VỆ: Bắt sự kiện Ctrl+C để dọn rác và thoát ngay lập tức
trap 'echo -e "\n\n${C_RED} Tiến trình sao lưu bị hủy đột ngột bởi người dùng (Ctrl+C)!${C_RESET}"; \
      rm -f /usr/local/backup-website/${NAME:?}/${NAME:?}${times:?}* 2>/dev/null; \
      exec 200>&-; \
      rm -f /etc/wptt/tmp/wptt_lock_sao_luu_khoi_phuc_${NAME:?}.lock 2>/dev/null; \
      exit 130' SIGINT


pathcheckwp="/usr/local/lsws/$NAME/html/wp-load.php"
if [[ ! -f "$pathcheckwp" ]]; then
  clear
  echoDo "Hệ thống xác nhận bạn không sử dụng WordPress"
  echoDo "Tính năng này chỉ có thể hoạt động trên mã nguồn WordPress"
  sleep 3
  exec /etc/wptt/wptt-backup-restore-main 1
  exit
fi

if ! . /etc/wptt/php/php-cli-domain-config "$NAME"; then
  wptt_logs "ERROR" "Không thể lấy cấu hình PHP cho domain $NAME (thư viện php-cli-domain-config thất bại)."
  _runloi "Không xác định được phiên bản PHP"
  return 1 2>/dev/null || exit 1
fi

# Mở disable_functions và bỏ qua plugin/theme khi kiểm tra option để không báo lỗi giả
ym_folder_opt=$(/usr/local/lsws/lsphp"${phien_ban_php_domain_thuc_thi}"/bin/php -d disable_functions="" /usr/local/bin/wp option get uploads_use_yearmonth_folders --skip-plugins --skip-themes --allow-root --path=/usr/local/lsws/"$NAME"/html 2>/dev/null | tr -d '\r\n')
if [[ "$ym_folder_opt" != "1" ]]; then
  echoDo "Hệ thống xác nhận bạn sử dụng WordPress nhưng không để chế độ uploads_use_yearmonth_folders"
  echo "Để dùng tính năng này, hãy vào WP-Admin => Settings => Media => Bật Organize my uploads into month- and year-based folders"
  sleep 3
  exec /etc/wptt/wptt-backup-restore-main 1
  exit
fi

pathcheck="/usr/local/backup-website/$NAME"
mkdir -p "$pathcheck"
before_optimize="$(get_backup_dir_size "$pathcheck")"
wptt_load_main_conf
wptt_load_vhost_conf "$NAME"
cd /usr/local/lsws/"$NAME"/html || exit 1

wptt_logs "INFO" "Sao lưu website $NAME luỹ tiến"

_runing "$sao_luu_database website $NAME"

# 1. Khai báo hàm xử lý lỗi dùng chung ngay tại chỗ
wptt_abort_db_injection() {
  _runloi "$1"
  sleep 2
  [[ "$2" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
  return 2>/dev/null || exit 1
}

# 2. Thực thi kiểm tra 3 lớp bằng toán tử ngắn mạch (&&)
[[ ! "$DB_Name_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên Database chứa ký tự không hợp lệ!" "$1"
[[ ! "$DB_User_web" =~ ^[a-zA-Z0-9_]+$ ]] && wptt_abort_db_injection "Tên User Database chứa ký tự không hợp lệ!" "$1"
#end nguy cơ local sql Injection
password_database_website_giai_ma=$(wptt_giai_ma "$DB_Password_web" 2>/dev/null)
[[ -z "$password_database_website_giai_ma" ]] && password_database_website_giai_ma="$DB_Password_web" #không mã hoá trả tuơng thích nguợc

[[ "$password_database_website_giai_ma" =~ [[:space:]\'\"\`\\] ]] && wptt_abort_db_injection "Mật khẩu USer Database chứa ký tự cấm (khoảng trắng, dấu nháy, backtick...)!" "$1"

TEMP_CNF=$(mktemp -p "/etc/wptt/tmp" wptt_db_XXXXXX.cnf)
chmod 600 "$TEMP_CNF" # Chỉ root mới đọc được

cat >"$TEMP_CNF" <<EOF
[client]
user=${DB_User_web}
password=${password_database_website_giai_ma}
host=localhost
max_allowed_packet=1G
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet=1G
single-transaction
EOF

unset password_database_website_giai_ma DB_Password_web

RAW_SIZE=$(mariadb --defaults-extra-file="$TEMP_CNF" -N -e "SELECT SUM(data_length) FROM information_schema.TABLES WHERE table_schema='$DB_Name_web'")
if [[ -z "$RAW_SIZE" || "$RAW_SIZE" == "NULL" ]]; then RAW_SIZE=1024; fi
ADJUSTED_SIZE=$((RAW_SIZE * 95 / 100))

if command -v pv &>/dev/null; then
  PV_CMD="pv -s $ADJUSTED_SIZE -N 'Exporting' -p -t -e -w 80"
else
  PV_CMD="cat"
fi


echo ""

# 1. Định nghĩa trước biến đường dẫn file để tránh lặp code (Quy tắc DRY)
if [[ "$sql_gz" = '1' ]]; then
  FILE_DB="$NAME$times.sql.gz"
elif [[ "$sql_gz" = '2' ]]; then
  FILE_DB="$NAME$times.sql.zst"
else
  FILE_DB="$NAME$times.sql"
fi
DB_OUTPUT="/usr/local/backup-website/$NAME/$FILE_DB"

# 2. Thực thi lệnh Dump vào đường ống (Pipeline)
if [[ "$sql_gz" = '1' ]]; then
  $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup gzip >"$DB_OUTPUT"
elif [[ "$sql_gz" = '2' ]]; then
  $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | bash -c "$PV_CMD" | $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup zstd >"$DB_OUTPUT"
else
  $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup mariadb-dump --defaults-extra-file="$TEMP_CNF" "$DB_Name_web" --ssl-verify-server-cert=false | $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup bash -c "$PV_CMD" >"$DB_OUTPUT"
fi

# 3. BẮT NGAY MÃ LỖI CỦA PIPELINE (Sức mạnh của pipefail)
db_backup_status=$?

# Dọn dẹp giao diện và file tạm
echo -ne "\033[1A\r\033[K"
echo -ne "\033[1A\r\033[K"
rm -f "$TEMP_CNF" 2>/dev/null

# 4. Phân xử Thành / Bại sòng phẳng chỉ bằng 1 khối IF duy nhất
if [ $db_backup_status -eq 0 ] && [ -f "$DB_OUTPUT" ]; then
  # Thành công: Chmod nâng cao bảo mật và báo Done
  $ep_luong_cpu_disk_thu_tu_yeu_tien_thap_dang_chay_auto_backup chmod 600 "$DB_OUTPUT" 2>/dev/null
  sync "$DB_OUTPUT" 2>/dev/null || true
  _rundone "$sao_luu_database website $NAME"
  tuanxacnhandb="1"
else
  # Thất bại: Đứt mắt xích dump, báo Lỗi và dọn dẹp rác
  tuanxacnhandb="0"
