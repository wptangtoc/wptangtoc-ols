#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

function huong_dan() {
  Tính năng tự động xóa file backup cũ tại ổ cứng máy chủ [Local] theo số lượng bản sao lưu.

  Nói đơn giản, bạn thiết lập quy tắc [ví dụ: chỉ giữ lại 10 bản sao lưu mới nhất]. Hệ thống sẽ tự động quét, bảo vệ 10 bản mới này và chỉ xóa những bản cũ hơn vượt quá giới hạn.

  Lưu ý quan trọng: "1 Bản" ở đây được hiểu là một bộ sao lưu hoàn chỉnh, bao gồm 1 file Mã Nguồn [.zip/.tar] VÀ 1 file Database [.sql]. Nếu bạn chọn giữ 10 bản, hệ thống sẽ giữ lại đúng 10 file Mã nguồn và 10 file Database tương ứng.

  Lợi ích:
  * Chống Full Disk: Ngăn chặn triệt để tình trạng file backup sinh ra liên tục làm đầy ổ cứng khiến VPS bị treo, sập database.
  * Quản lý khoa học: Luôn có một số lượng mốc thời gian cố định để lựa chọn khi cần khôi phục.
}

. /etc/wptt/.wptt.conf 2>/dev/null
[[ -z "$ngon_ngu" ]] && ngon_ngu='vi'
. "/etc/wptt/lang/$ngon_ngu.sh" 2>/dev/null
. /etc/wptt/echo-color 2>/dev/null
. /etc/wptt/core-functions 2>/dev/null # Nạp thư viện xác nhận

clear
echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
center_text "${C_YELLOW}SAO LƯU & KHÔI PHỤC ➜ Thiết lập Tự động dọn dẹp Backup Local${C_RESET}"
echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"

# ==============================================================================
# BẢNG THỐNG KÊ CÁC DOMAIN ĐÃ KÍCH HOẠT AUTO DELETE LOCAL
# ==============================================================================
box_inner_width=${box_inner_width:-71}
active_list=()

if [ "$(ls -A /etc/wptt/vhost 2>/dev/null | grep -v '^\.\.conf$' | sort -uV)" ]; then
	for filepath in /etc/wptt/vhost/.*.conf; do
		[[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

		domain="${filepath##*/}"
		domain="${domain%.conf}"
		domain="${domain#.}"

		if [[ "$domain" != ?*.?* ]]; then
			continue
		fi
        
        # Trả lại tên file theo chuẩn cũ để tương thích ngược
		path="/etc/cron.d/delete$domain.cron"

		if [[ -f "$path" ]]; then
            # Hỗ trợ lấy thông số từ cả cấu trúc code mới (số bản) và code cũ (số phút)
            if grep -q "wptt-auto-delete-local-backup" "/etc/wptt-auto/$domain-delete-backup" 2>/dev/null; then
                so_ban_luu_hien_tai=$(cat "/etc/wptt-auto/$domain-delete-backup" 2>/dev/null | awk '{print $NF}' | grep -o '[0-9]\+')
                domain_padded=$(printf "%-25s" "$domain")
                active_list+=("${C_BOLD_WHITE}${domain_padded}${C_RESET} : Luôn giữ lại ${C_YELLOW}${so_ban_luu_hien_tai} bản${C_RESET} mới nhất")
            else
                domain_padded=$(printf "%-25s" "$domain")
                active_list+=("${C_BOLD_WHITE}${domain_padded}${C_RESET} : Đang dùng cấu hình xóa theo ngày cũ")
            fi
		fi
	done
fi

if [[ -f /etc/cron.d/delete-backup-all-website-wptt-ols-local.cron ]]; then
    if grep -q "wptt-auto-delete-local-backup" "/etc/wptt-auto/all-delete-backup-het-han-local" 2>/dev/null; then
        so_ban_luu_hien_tai=$(cat /etc/wptt-auto/all-delete-backup-het-han-local 2>/dev/null | awk '{print $NF}' | grep -o '[0-9]\+')
        domain_padded=$(printf "%-25s" "[Toàn bộ Website]")
        active_list+=("${C_YELLOW}${domain_padded}${C_RESET} : Luôn giữ lại ${C_YELLOW}${so_ban_luu_hien_tai} bản${C_RESET} mới nhất")
    else
        domain_padded=$(printf "%-25s" "[Toàn bộ Website]")
        active_list+=("${C_YELLOW}${domain_padded}${C_RESET} : Đang dùng cấu hình xóa theo ngày cũ")
    fi
fi

if [[ ${#active_list[@]} -gt 0 ]]; then
  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_YELLOW}DANH SÁCH ĐÃ THIẾT LẬP TỰ ĐỘNG DỌN DẸP BACKUP LOCAL${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"
  for item in "${active_list[@]}"; do
    left_text "$item" 2
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
fi

# ==============================================================================
# HÀM MENU LỌC THÔNG MINH
# ==============================================================================
function lua_chon_NAME() {
  unset NAME selects
  selects=()

  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    local domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" == ?*.?* ]]; then
      if [[ ! -f "/etc/cron.d/delete$domain.cron" ]]; then
        selects+=("$domain")
      fi
    fi
  done

  if [[ ! -f /etc/cron.d/delete-backup-all-website-wptt-ols-local.cron ]]; then
    selects+=("Tất cả website")
  fi

  if [[ ${#selects[@]} -eq 0 ]]; then
    echo -e "${C_YELLOW}Tất cả domain trên hệ thống đều đã được cấu hình tự động dọn dẹp backup!${C_RESET}"
    sleep 3
    exec /etc/wptt/wptt-backup-restore-main 1
  fi

  mapfile -t selects < <(printf "%s\n" "${selects[@]}" | sort -uV)

  echo -e "${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  local title_text="Lựa chọn website muốn thiết lập tự động dọn dẹp backup cũ:"
  local len=$(echo -n "$title_text" | awk '{print length($0)}')
  local pad_r=$((box_inner_width - len - 2))
  [[ $pad_r -lt 0 ]] && pad_r=0
  echo -e "${C_CYAN}│${C_RESET}  ${C_YELLOW}${title_text}${C_RESET}$(printf '%*s' "$pad_r" "")${C_CYAN}│${C_RESET}"

  local line_len=$((len + 3))
  local pad_line_r=$((box_inner_width - line_len))
  [[ $pad_line_r -lt 0 ]] && pad_line_r=0
  local short_line=$(printf "%${line_len}s" "" | sed 's/ /─/g')
  echo -e "${C_CYAN}├${short_line}$(printf '%*s' "$pad_line_r" "")│${C_RESET}"

  local i=1
  for domain in "${selects[@]}"; do
    if [[ "$domain" == "Tất cả website" ]]; then
      local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_YELLOW}%s${C_RESET}" "$i" "$domain")
    else
      local item_text=$(printf "  ${C_CYAN}%3d)${C_RESET} ${C_BOLD_WHITE}%s${C_RESET}" "$i" "$domain")
    fi
    local clean_text=$(printf "  %3d) %s" "$i" "$domain")
    local item_len=$(echo -n "$clean_text" | awk '{print length($0)}')
    local pad=$((box_inner_width - item_len))
    [[ $pad -lt 0 ]] && pad=0
    echo -e "${C_CYAN}│${C_RESET}${item_text}$(printf '%*s' "$pad" "")${C_CYAN}│${C_RESET}"
    ((i++))
  done
  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${C_RESET}"

  local fzf_installed=false
  if command -v fzf &>/dev/null; then
    fzf_installed=true
    PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [00=Tìm nhanh] [0=Thoát]: "
  else
    PROMPT_TEXT="Nhập lựa chọn (1-${#selects[@]}) [0=Thoát]: "
  fi

  while true; do
    echo -en "${C_CYAN}${PROMPT_TEXT}${C_RESET}"
    if ! read -r REPLY; then exit 1; fi
    REPLY="${REPLY// /}"
    REPLY="${REPLY,,}"

    case "$REPLY" in
    0)
      echo -e "\n${C_GREEN}Đang thoát...${C_RESET}"
      NAME="0"
      return 0
      ;;
    00)
      if $fzf_installed; then
        local selected_name=$(printf '%s\n' "${selects[@]}" | nl -w 3 -s ': ' | fzf --prompt="Tìm website >> " --height=40% --border=rounded --color=border:red --cycle --reverse)
        selected_name="${selected_name#*: }"
        if [[ -n "$selected_name" ]]; then
          NAME="$selected_name"
          return 0
        else echo -e "${C_YELLOW}Đã hủy chọn. Vui lòng chọn lại.${C_RESET}"; fi
      else
        echo -e "${C_RED}Lỗi: FZF chưa cài đặt.${C_RESET}"
      fi
      ;;
    *)
      if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#selects[@]} ]; then
        local action_index=$((REPLY - 1))
        NAME="${selects[$action_index]}"
        return 0
      else
        echo -e "\n${C_RED}❌ Lựa chọn không hợp lệ! Vui lòng chọn lại.${C_RESET}"
      fi
      ;;
    esac
  done
}

lua_chon_NAME

[[ "$NAME" == "0" || -z "$NAME" ]] && {
  [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
  return 2>/dev/null || exit
}

if [[ "$NAME" != 'Tất cả website' ]]; then
  pathcheck="/etc/wptt/vhost/.$NAME.conf"
  if [[ ! -f "$pathcheck" ]]; then
    echo -e "\n${C_RED}❌ Tên miền không tồn tại trên hệ thống này!${C_RESET}"
    sleep 3
    [[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
    return 2>/dev/null || exit
  fi
fi

# ==============================================================================
# NHẬP VÀ XÁC NHẬN SỐ LƯỢNG BẢN SAO LƯU (VERSIONING)
# ==============================================================================
echo ""
echo -e "(${C_GREEN}1 Bản backup = 1 file Mã nguồn + 1 file Database${C_RESET})"
echo ""
while true; do
  echo -en "${C_CYAN}Nhập số lượng bản backup muốn giữ lại ở Local (Ví dụ: 3, 5, 10): ${C_RESET}"
  read -r so_ban
  if [[ ! "$so_ban" =~ ^[1-9][0-9]*$ ]]; then
    echo -e "${C_RED}❌ Lỗi: Số lượng không hợp lệ! Vui lòng nhập số nguyên dương lớn hơn 0.${C_RESET}"
  else
    break
  fi
done

echo ""
msg_xacnhan="Bạn muốn tự động xóa file dư thừa, luôn giữ lại ${C_YELLOW}$so_ban bản mới nhất${C_RESET} ở Local?"
if wptt_xac_nhan "$msg_xacnhan" "${C_BOLD_WHITE}Website:${C_RESET} ${C_YELLOW}$NAME${C_RESET}" "" "Đồng ý Thiết lập" "Hủy bỏ"; then

  mkdir -p /etc/wptt-auto

  # ==============================================================================
  # GHI FILE CẤU HÌNH VÀ CRON (TƯƠNG THÍCH NGƯỢC)
  # ==============================================================================
  _runing "Đang khởi tạo chu kỳ Cronjob tự động dọn dẹp Local..."

  if [[ "$NAME" == 'Tất cả website' ]]; then
    cat >"/etc/wptt-auto/all-delete-backup-het-han-local" <<END
#!/bin/bash
/bin/bash /etc/wptt/backup-restore/wptt-auto-delete-local-backup "$NAME" $so_ban
END
    chmod 700 /etc/wptt-auto/all-delete-backup-het-han-local

    cat >"/etc/cron.d/delete-backup-all-website-wptt-ols-local.cron" <<END
0 2 * * * root /bin/bash /etc/wptt-auto/all-delete-backup-het-han-local >/dev/null 2>&1

END
    chmod 644 "/etc/cron.d/delete-backup-all-website-wptt-ols-local.cron"
  else
    cat >"/etc/wptt-auto/$NAME-delete-backup" <<END
#!/bin/bash
/bin/bash /etc/wptt/backup-restore/wptt-auto-delete-local-backup $NAME $so_ban
END
    chmod 700 "/etc/wptt-auto/$NAME-delete-backup"

    cat >"/etc/cron.d/delete$NAME.cron" <<END
0 2 * * * root /bin/bash /etc/wptt-auto/$NAME-delete-backup >/dev/null 2>&1

END
    chmod 644 "/etc/cron.d/delete$NAME.cron"
  fi

  # Khởi động lại Cron daemon (Kèm logic tạo Symlink cho Ubuntu y hệt phiên bản cũ)
  if grep -q "Ubuntu" /etc/*release 2>/dev/null; then
    if [[ "$NAME" == 'Tất cả website' ]]; then
      ln -sf /etc/cron.d/delete-backup-all-website-wptt-ols-local.cron /etc/cron.d/delete-backup-all-website-wptt-ols-local_cron 2>/dev/null
    else
      NAME_CRON_ubuntu=${NAME//[.]/_}
      ln -sf "/etc/cron.d/delete$NAME.cron" "/etc/cron.d/delete${NAME_CRON_ubuntu}_cron" 2>/dev/null
    fi
    systemctl restart cron.service
  else
    systemctl restart crond.service
  fi

  echo "Thiết lập tự động dọn dẹp backup Local $NAME: $(date '+%d-%m-%Y %H:%M')" >>/var/log/wptangtoc-ols.log
  _rundone "Cấu hình Cronjob thành công"

  echo -e "\n${C_CYAN}╭──────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  center_text "${C_GREEN}THIẾT LẬP TỰ ĐỘNG XÓA BACKUP THÀNH CÔNG${C_RESET}"
  echo -e "${C_CYAN}├──────────────────────────────────────────────────────────────────────────────┤${C_RESET}"

  left_text "Website        : ${C_YELLOW}$NAME${C_RESET}"
  left_text "Số bản giữ lại : Luôn giữ ${C_YELLOW}$so_ban bản mới nhất${C_RESET}"

  if [[ "$NAME" == 'Tất cả website' ]]; then
    left_text "Khu vực quét   : /usr/local/backup-website/*"
  else
    left_text "Khu vực quét   : /usr/local/backup-website/$NAME/"
  fi

  echo -e "${C_CYAN}╰──────────────────────────────────────────────────────────────────────────────╯\n${C_RESET}"
  echo -e "${C_CYAN}Ghi chú:${C_RESET} Cứ vào lúc ${C_GREEN}2 giờ sáng hàng ngày${C_RESET}, hệ thống sẽ tự động quét."
  echo -e "Chỉ những file vượt quá ${C_YELLOW}giới hạn $so_ban bản${C_RESET} sẽ bị loại bỏ để giải phóng ổ cứng."
  echo -e "(${C_GREEN}1 Bản = 1 file Mã nguồn + 1 file Database${C_RESET})"

else
  echo -e "${C_YELLOW}Đã hủy thao tác thiết lập Auto Delete.${C_RESET}"
fi

[[ "${1:-}" == "98" ]] && exec /etc/wptt/wptt-backup-restore-main 1
