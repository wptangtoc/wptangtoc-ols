#!/bin/bash
. /etc/wptt/core-functions 2>/dev/null
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export HOME=/root
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

NAME=$1
so_ban=$2

## Ngăn chặn thảm họa xóa sạch dữ liệu nếu biến $so_ban bị lỗi, rỗng hoặc là chữ
if [[ ! "$so_ban" =~ ^[1-9][0-9]*$ ]]; then
    echo "Lỗi: Số lượng bản backup cần giữ ($so_ban) không hợp lệ! Bắt buộc phải là số nguyên dương."
    exit 1
fi

# ==============================================================================
# HÀM XÓA FILE TẠI LOCAL (TỐI ƯU HÓA HIỆU NĂNG BATCH DELETE)
# ==============================================================================
xoa_backup_cu() {
    local domain="$1"
    local backup_dir="/usr/local/backup-website/$domain"
  
    # Nếu thư mục không tồn tại thì thoát ngay để đỡ tốn nhịp CPU
    [[ ! -d "$backup_dir" ]] && return
  
    local source_files=() db_files=() files_to_delete=()

    # Thu thập mảng file (mới nhất -> cũ nhất)
    mapfile -t source_files < <(ls -t "$backup_dir" 2>/dev/null | grep -E '\.(zip|tar\.gz|tar\.zst)$')
    mapfile -t db_files < <(ls -t "$backup_dir" 2>/dev/null | grep -E '\.(sql|sql\.gz|sql\.zst)$')
  
    # 1. Cắt lấy danh sách các file CŨ HƠN số bản quy định (nếu có)
    if [[ ${#source_files[@]} -gt $so_ban ]]; then
        files_to_delete+=( "${source_files[@]:$so_ban}" )
    fi
  
    if [[ ${#db_files[@]} -gt $so_ban ]]; then
        files_to_delete+=( "${db_files[@]:$so_ban}" )
    fi

    # 2. XÓA GOM LÔ (BATCHING) - CHỈ CHẠY RM 1 LẦN DUY NHẤT
    if [[ ${#files_to_delete[@]} -gt 0 ]]; then
        # Tuyệt kỹ Bash: Nối thẳng chuỗi đường dẫn tuyệt đối vào đầu mọi phần tử của mảng 
        # (Không cần for, không subshell, chạy bằng tốc độ gốc của Bash)
        local delete_paths=( "${files_to_delete[@]/#/$backup_dir/}" )
        
        # Bắn 1 lệnh rm duy nhất nuốt trọn toàn bộ danh sách file
        ionice -c 3 nice -n 19 rm -f "${delete_paths[@]}"
    fi
}

# ==============================================================================
# THỰC THI CHÍNH
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
    # Quét toàn bộ vhost
    for filepath in /etc/wptt/vhost/.*.conf; do
        [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
        
        # Tách tên domain (Dùng built-in của Bash cực nhẹ)
        domain="${filepath##*/}"
        domain="${domain%.conf}"
        domain="${domain#.}"

        # Kiểm tra chuẩn domain (có chứa dấu chấm)
        if [[ "$domain" != *.* ]]; then
            continue
        fi
        
        if [[ "$domain" != "${domain/./}" ]] && [[ "$domain" != '.' ]]; then
            NAME_CRON=${domain//[.]/_}
            if [[ -f "/etc/cron.d/delete$domain.cron" || -f "/etc/cron.d/delete_local_${NAME_CRON}" ]]; then
                # Ưu tiên cấu hình riêng lẻ -> bỏ qua
                continue
            fi
            xoa_backup_cu "$domain"
        fi
    done
else
    # Chỉ thực thi 1 website cụ thể
    xoa_backup_cu "$NAME"
fi
