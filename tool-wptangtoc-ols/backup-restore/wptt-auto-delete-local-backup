#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

# BẢO ĐẢM MÔI TRƯỜNG CRON HOẠT ĐỘNG CHUẨN 100%
export HOME=/root
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"

NAME=$1
so_ban=$2

# ==============================================================================
# HÀM XÓA FILE TẠI LOCAL (GIỮ LẠI SỐ BẢN MỚI NHẤT)
# ==============================================================================
xoa_backup_cu() {
  local domain="$1"
  local backup_dir="/usr/local/backup-website/$domain"
  
  # Nếu thư mục không tồn tại thì bỏ qua
  [[ ! -d "$backup_dir" ]] && return
  
  # Dùng ls -t để lấy danh sách file, sắp xếp theo thời gian (mới nhất nằm trên cùng)
  local all_files=$(ls -t "$backup_dir" 2>/dev/null)
  
  # Tách mảng Mã nguồn và Database y hệt như Cloud
  local source_files=($(echo "$all_files" | grep -E '\.(zip|tar\.gz|tar\.zst)$'))
  local db_files=($(echo "$all_files" | grep -E '\.(sql|sql\.gz|sql\.zst)$'))
  
  local files_to_delete=()
  
  # Chém mảng: Bỏ qua $so_ban đầu tiên, lấy phần còn lại tống vào danh sách xóa
  if [[ ${#source_files[@]} -gt $so_ban ]]; then
    files_to_delete+=("${source_files[@]:$so_ban}")
  fi
  
  if [[ ${#db_files[@]} -gt $so_ban ]]; then
    files_to_delete+=("${db_files[@]:$so_ban}")
  fi
  
  # Thực thi trảm file cũ
  for file in "${files_to_delete[@]}"; do
    if [[ -n "$file" ]]; then
      # Ép lệnh nice và ionice để thao tác xóa không làm nghẽn I/O ổ cứng của các website đang chạy
      ionice -c 3 nice -n 19 rm -f "$backup_dir/$file"
    fi
  done
}

# ==============================================================================
# THỰC THI CHÍNH
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  # Quét toàn bộ vhost nếu chọn All
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi
    if [ "$domain" != "${domain/./}" ] && [ "$domain" != '.' ]; then
		NAME_CRON=${domain//[.]/_}
		if [[ -f "/etc/cron.d/delete$domain.cron" || -f "/etc/cron.d/delete_local_${NAME_CRON}" ]]; then
			# Phát hiện website đã có cấu hình riêng -> Bỏ qua, không áp dụng luật "Tất cả", nguyên tắc giá trị riêng lẻ đè giá trị toàn cục
			continue
		fi
      xoa_backup_cu "$domain"
    fi
  done
else
  # Chỉ thực thi 1 website cụ thể
  xoa_backup_cu "$NAME"
fi
