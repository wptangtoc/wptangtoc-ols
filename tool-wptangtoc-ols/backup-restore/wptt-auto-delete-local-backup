#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export HOME=/root
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"

NAME=$1
so_ban=$2

## Ngăn chặn thảm họa xóa sạch dữ liệu nếu biến $so_ban bị lỗi, rỗng hoặc là chữ
if [[ ! "$so_ban" =~ ^[1-9][0-9]*$ ]]; then
    echo "Lỗi: Số lượng bản backup cần giữ ($so_ban) không hợp lệ! Bắt buộc phải là số nguyên dương."
    exit 1
fi

# Biến cờ theo dõi: Bắt đầu với 0 (Chưa có gì bị xóa)
HAS_DELETED_FILES=0

# ==============================================================================
# HÀM XÓA FILE TẠI LOCAL (GIỮ LẠI SỐ BẢN MỚI NHẤT)
# ==============================================================================
xoa_backup_cu() {
  local domain="$1"
  local backup_dir="/usr/local/backup-website/$domain"
  
  # Nếu thư mục không tồn tại thì bỏ qua
  [[ ! -d "$backup_dir" ]] && return
  
  local source_files=()
  local db_files=()

  # Dùng ls -t để lấy danh sách file, sắp xếp theo thời gian (mới nhất nằm trên cùng)
  mapfile -t source_files < <(ls -t "$backup_dir" 2>/dev/null | grep -E '\.(zip|tar\.gz|tar\.zst)$')
  mapfile -t db_files < <(ls -t "$backup_dir" 2>/dev/null | grep -E '\.(sql|sql\.gz|sql\.zst)$')
  
  # Nếu cả array Mã nguồn và Database đều chưa vượt quá số bản quy định (hoặc rỗng),
  # lập tức Thoát sớm tránh rủi ro
  if [[ ${#source_files[@]} -le $so_ban && ${#db_files[@]} -le $so_ban ]]; then
      return
  fi
  
  if [[ ${#source_files[@]} -gt $so_ban ]]; then
    for file in "${source_files[@]:$so_ban}"; do
      if [[ -n "$file" ]]; then
        ionice -c 3 nice -n 19 rm -f "$backup_dir/$file"
        HAS_DELETED_FILES=1 # Xác nhận đã có rác xả ra
      fi
    done
  fi
  
  if [[ ${#db_files[@]} -gt $so_ban ]]; then
    for file in "${db_files[@]:$so_ban}"; do
      if [[ -n "$file" ]]; then
        ionice -c 3 nice -n 19 rm -f "$backup_dir/$file"
        HAS_DELETED_FILES=1 # Xác nhận đã có rác xả ra
      fi
    done
  fi
}

# ==============================================================================
# THỰC THI CHÍNH
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  # Quét toàn bộ vhost nếu chọn All
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue
    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi
    if [ "$domain" != "${domain/./}" ] && [ "$domain" != '.' ]; then
        NAME_CRON=${domain//[.]/_}
        if [[ -f "/etc/cron.d/delete$domain.cron" || -f "/etc/cron.d/delete_local_${NAME_CRON}" ]]; then
            # Phát hiện website đã có cấu hình riêng -> Bỏ qua, không áp dụng luật "Tất cả"
            continue
        fi
      xoa_backup_cu "$domain"
    fi
  done
else
  # Chỉ thực thi 1 website cụ thể
  xoa_backup_cu "$NAME"
fi

# ==============================================================================
# TỐI ƯU HÓA Ổ CỨNG SSD (FSTRIM) CHỈ KHI CÓ FILE BỊ XÓA
# ==============================================================================
if [[ $HAS_DELETED_FILES -eq 1 ]]; then
	flock -n /etc/wptt/tmp/wptt_fstrim.lock -c "ionice -c 3 nice -n 19 fstrim -a >/dev/null 2>&1"
	# ionice -c 3 nice -n 19 fstrim -a >/dev/null 2>&1
fi
