#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @since: 2026

export HOME=/root
export PATH="/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
#không có export này thì rclone lsl nó không hoạt động trong môi truờng cron

NAME=$1
so_ban=$2

# Ngăn chặn thảm họa xóa sạch dữ liệu Cloud nếu biến $so_ban bị lỗi, rỗng hoặc là chữ
if [[ ! "$so_ban" =~ ^[1-9][0-9]*$ ]]; then
  echo "Lỗi: Số lượng bản backup cần giữ ($so_ban) không hợp lệ! Bắt buộc phải là số nguyên dương."
  exit 1
fi

RCLONE_CONF="/root/.config/rclone/rclone.conf"

# Kiểm tra trạng thái kích hoạt Cloud
if ! grep -q 'wptangtoc' "$RCLONE_CONF" 2>/dev/null; then
  echo "Bạn chưa kích hoạt Rclone Cloud"
  exit 1
fi

# ==============================================================================
# NHẬN DIỆN CLOUD VÀ THƯ MỤC LƯU TRỮ
# ==============================================================================
CLOUD_DIR="wptangtoc_ols_backup"
DELETE_FLAGS=()

# Bắt buộc quét đúng tham số "type =" để tránh nhận diện nhầm
if grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*onedrive' "$RCLONE_CONF" 2>/dev/null; then
  if grep -q 'personal' "$RCLONE_CONF" 2>/dev/null; then
    DELETE_FLAGS=() # Personal OneDrive không hỗ trợ hard-delete cờ phụ
  else
    DELETE_FLAGS=("--onedrive-hard-delete") # OneDrive Business hoặc SharePoint
  fi
elif grep -E -q '^[[:space:]]*type[[:space:]]*=[[:space:]]*s3' "$RCLONE_CONF" 2>/dev/null; then
  CLOUD_DIR="wptangtoc-ols-backup" # S3 bắt buộc dùng dấu gạch ngang
  DELETE_FLAGS=() # S3 tự động hard-delete, không cần cờ phụ
else
  # Mặc định là Google Drive
  DELETE_FLAGS=("--drive-use-trash=false") # Xóa vĩnh viễn không vào thùng rác Drive
fi

# Fallback: Tránh trường hợp dùng Drive/OneDrive nhưng đã lỡ tạo Bucket gạch ngang trước đó
if rclone lsd wptangtoc: 2>/dev/null | grep -q 'wptangtoc-ols-backup'; then
  CLOUD_DIR="wptangtoc-ols-backup"
fi

# ==============================================================================
# HÀM XÓA FILE (BULK DELETE CHỐNG DỘI BOM API)
# ==============================================================================
xoa_backup_cu() {
  local domain="$1"
  
  # Lấy toàn bộ file, sắp xếp theo thời gian sửa đổi (Mới nhất nằm trên cùng)
  local all_files=$(rclone lsl "wptangtoc:$CLOUD_DIR/$domain" 2>/dev/null | sort -r -k2,3 | awk '{print $NF}')
  
  # Nếu thư mục rỗng, thoát sớm
  [[ -z "$all_files" ]] && return
  
  local source_files=()
  local db_files=()
  local files_to_delete=()
  
  # Tách thành 2 mảng bằng mapfile
  mapfile -t source_files < <(echo "$all_files" | grep -E '\.(zip|tar\.gz|tar\.zst)$')
  mapfile -t db_files < <(echo "$all_files" | grep -E '\.(sql|sql\.gz|sql\.zst)$')
  
  # Thoát sớm giải phóng I/O và API nếu chưa vượt mốc $so_ban
  if [[ ${#source_files[@]} -le $so_ban && ${#db_files[@]} -le $so_ban ]]; then
      return
  fi
  
  # Gom tất cả "tử tù" vào một danh sách chung
  if [[ ${#source_files[@]} -gt $so_ban ]]; then
    files_to_delete+=("${source_files[@]:$so_ban}")
  fi
  
  if [[ ${#db_files[@]} -gt $so_ban ]]; then
    files_to_delete+=("${db_files[@]:$so_ban}")
  fi
  
  # THỰC THI BULK DELETE QUA 1 REQUEST DUY NHẤT
  if [[ ${#files_to_delete[@]} -gt 0 ]]; then
		local tmp_delete_list
		tmp_delete_list=$(mktemp -p "/etc/wptt/tmp" delete_list_"${domain}"_XXXXXX.txt)
    
    # Ghi toàn bộ tên file cần xóa vào file temp
    printf "%s\n" "${files_to_delete[@]}" > "$tmp_delete_list"
    
    # --files-from (Chỉ tốn đúng 1 nhịp gọi API), call 1 lần xóa nhiều file thay vì xóa từng file nó dễ bị limit API
    if [[ ${#DELETE_FLAGS[@]} -gt 0 ]]; then
      rclone -v "${DELETE_FLAGS[@]}" delete "wptangtoc:$CLOUD_DIR/$domain" --files-from "$tmp_delete_list"
    else
      rclone -v delete "wptangtoc:$CLOUD_DIR/$domain" --files-from "$tmp_delete_list"
    fi
    
    # Dọn rác file temp[cite: 1]
    rm -f "$tmp_delete_list"
  fi
}

# ==============================================================================
# THỰC THI CHÍNH
# ==============================================================================
if [[ "$NAME" == 'Tất cả website' ]]; then
  # Quét toàn bộ vhost nếu chọn All
  for filepath in /etc/wptt/vhost/.*.conf; do
    [[ ! -f "$filepath" || "$filepath" == *"/..conf" ]] && continue

    domain="${filepath##*/}"
    domain="${domain%.conf}"
    domain="${domain#.}"

    if [[ "$domain" != ?*.?* ]]; then
      continue
    fi
    if [ "$domain" != "${domain/./}" ] && [ "$domain" != '.' ]; then

        # CƠ CHẾ KẾ THỪA ƯU TIÊN (PRIORITY OVERRIDE) CLOUD
        NAME_CRON=${domain//[.]/_} #ubuntu nó không cho dấu . tuơng thích
        if [[ -f "/etc/cron.d/delete-google-driver-$domain.cron" || -f "/etc/cron.d/delete_gdrive_${NAME_CRON}" ]]; then
            # Phát hiện website đã có cấu hình riêng -> Bỏ qua, không áp dụng luật "Tất cả", nguyên tắc giá trị riêng lẻ đè giá trị toàn cục
            continue
        fi

      xoa_backup_cu "$domain"
    fi
  done
else
  # Chỉ thực thi 1 website cụ thể
  xoa_backup_cu "$NAME"
fi
