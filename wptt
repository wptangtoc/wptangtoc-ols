#!/bin/bash
pwd=$(pwd)
if [[ ! -f $pwd/wp-config.php ]]; then
    echo "Chua truy cap vao duong dan ma nguon website"
    cd || exit
    ls --color=auto
    read -rp "Nhap duong nhan ma nguon website: " NAME
    pwd=$(pwd)
    pwd="$pwd/$NAME"
fi

if [[ -f $pwd/wp-config.php ]]; then
    rm -f "$pwd"/giatuan-wptangtoc.zip
    rm -f "$pwd"/giatuan-wptangtoc-sha256.txt
    rm -f "$pwd"/giatuan-wptangtoc.sql

    get_wp_config() {
        local key="$1"
        grep -E "^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]$key['\"]" "$pwd/wp-config.php" | head -n 1 | sed -E "s/^[[:space:]]*define[[:space:]]*\([[:space:]]*['\"]$key['\"][[:space:]]*,[[:space:]]*['\"]//;s/['\"][[:space:]]*\)[[:space:]]*;.*//"
    }

    DB_NAME=$(get_wp_config "DB_NAME")
    DB_USER=$(get_wp_config "DB_USER")
    DB_PASSWORD=$(get_wp_config "DB_PASSWORD")
    DB_HOST=$(get_wp_config "DB_HOST")
    
    # Mặc định localhost nếu wp-config.php không có Host
    [[ -z "$DB_HOST" ]] && DB_HOST="localhost"

    echo "Dang dong goi ma nguon ZIP..."
    cd "$pwd" && zip -r "$pwd"/giatuan-wptangtoc.zip * -x "wp-content/ai1wm-backups/*" -x "wp-content/cache/*" -x "wp-content/updraft/*" -x "error_log" -x "wp-content/debug.log" -x "wp-content/uploads/backupbuddy_backups/*" -x "wp-content/backups-dup-pro/*"
    
    echo "Dang ket xuat Database SQL..."
    # Đã thêm tham số -h "$DB_HOST" để hỗ trợ kéo web từ Share Hosting (Remote Database)
    mysqldump -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" --single-transaction --quick --lock-tables=false >"$pwd"/giatuan-wptangtoc.sql
    
    database="$pwd/giatuan-wptangtoc.zip"
    database2="$pwd/giatuan-wptangtoc.sql"
    database_sha256="$pwd/giatuan-wptangtoc-sha256.txt"

    if [[ ! -f "$database" || ! -f "$database2" ]]; then
        echo "Qua trinh bi loi! Khong tim thay file Zip hoac Sql."
        rm -f wptt
        exit
    else
        # TẠO MÃ BĂM SHA256 NẾU HỆ THỐNG HỖ TRỢ
        if command -v sha256sum >/dev/null 2>&1; then
            echo "Dang tao ma bam SHA256 de bao mat truyen tai..."
            sha256sum giatuan-wptangtoc.zip giatuan-wptangtoc.sql > giatuan-wptangtoc-sha256.txt
        fi

        echo "==========================================================="
        echo "Hoan tat sao luu!"
        echo "Hay quay lai WPTangToc OLS de tiep tuc qua trinh tai xuong."
        echo "==========================================================="
        
        read -rp "Xac nhan da keo xong file ve OLS, xoa rác backup nay? (y/n): " dongyluon
        if [[ "$dongyluon" = "y" ]]; then
            rm -f "$database"
            rm -f "$database2"
            rm -f "$database_sha256"
            rm -f wptt
            echo "Hoan tat!"
        else
            rm -f wptt
        fi
    fi
else
    echo "Hay truy cap vao thu muc ma nguon cua website roi su dung lenh"
    rm -f wptt
fi
