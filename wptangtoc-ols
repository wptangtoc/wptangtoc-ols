# ==============================================================================
# 4. TỰ ĐỘNG XỬ LÝ LỖI PHÂN VÙNG /home DUNG LƯỢNG LỚN (LVM AUTO-MERGE)
# ==============================================================================
HOME_DEV=$(df -P /home 2>/dev/null | awk 'NR==2 {print $1}' || echo "")
ROOT_DEV=$(df -P / 2>/dev/null | awk 'NR==2 {print $1}' || echo "")
FS_TYPE=$(df -Th 2>/dev/null | awk '$NF=="/" {print $2}' || echo "")

if [[ -n "$HOME_DEV" && -n "$ROOT_DEV" && "$HOME_DEV" != "$ROOT_DEV" ]]; then
  if [[ "${PWD:-}" == /home* ]]; then
    clear
    echo -e "\e[31mLỖI NGHIÊM TRỌNG: Script đang chạy từ bên trong thư mục /home!\e[0m"
    echo "Hệ thống không thể gộp phân vùng ổ cứng khi bạn đang đứng bên trong nó."
    echo -e "\e[33m➜ Hướng xử lý: Chuyển ra thư mục /root và chạy lại:\e[0m"
    echo "mv wptangtoc-ols /root/ && cd /root && bash wptangtoc-ols"
    exit 1
  fi

  HOME_TYPE=$(lsblk -no TYPE "$HOME_DEV" 2>/dev/null | grep -ow "lvm" || echo "")
  ROOT_TYPE=$(lsblk -no TYPE "$ROOT_DEV" 2>/dev/null | grep -ow "lvm" || echo "")

  if [[ "$HOME_TYPE" == "lvm" && "$ROOT_TYPE" == "lvm" ]]; then
    clear
    echo -e "\e[33m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
    echo -e "\e[33m│                  CẢNH BÁO: TÁI CẤU TRÚC PHÂN VÙNG Ổ CỨNG                     │\e[0m"
    echo -e "\e[33m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[33m│\e[0m Hệ thống phát hiện VPS của bạn đang chia phần lớn dung lượng cho ổ \e[36m/home\e[0m.    \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m WPTangToc OLS lưu trữ dữ liệu Web và Database tại phân vùng gốc \e[36m/\e[0m.             \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m Nếu không gộp, website của bạn sẽ rất nhanh bị đầy ổ cứng và sập MariaDB.    \e[33m│\e[0m"
    echo -e "\e[33m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[33m│\e[0m \e[1;31mRỦI RO TỚI DỮ LIỆU:\e[0m Việc gộp LVM can thiệp rất sâu vào nhân hệ điều hành.    \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m Yêu cầu bạn phải \e[1;31mCHỤP SNAPSHOT / BACKUP\e[0m toàn bộ VPS trên trang quản lý của   \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m nhà cung cấp trước khi bấm Đồng ý để phòng sự cố cúp điện hoặc Kernel Panic. \e[33m│\e[0m"
    echo -e "\e[33m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m"
    echo ""

    while true; do
      echo -en "\e[36m➤ Bạn có ĐỒNG Ý thực hiện gộp ổ /home vào nhánh gốc (/) không? (y/n): \e[0m"
      read -r confirm_merge
      if [[ "$confirm_merge" == "n" || "$confirm_merge" == "N" ]]; then
        echo -e "\n\e[31mĐã hủy tiến trình cài đặt.\e[0m"
        echo "Lời khuyên: Bạn có thể chủ động cài lại hệ điều hành (Rebuild OS) từ trang quản lý Cloud và thiết lập cấp 100% dung lượng cho ổ / (Root), sau đó chạy lại mã cài đặt."
        rm -f wptangtoc-ols || true
        exit 1
      elif [[ "$confirm_merge" == "y" || "$confirm_merge" == "Y" ]]; then
        echo -e "\n\e[32mĐã xác nhận! Bắt đầu phẫu thuật gộp phân vùng...\e[0m"
        break
      else
        echo -e "\e[31m❌ Vui lòng nhập 'y' (Đồng ý) hoặc 'n' (Hủy bỏ).\e[0m"
      fi
    done

    SECURE_HOME_BACKUP=$(mktemp -d)
    cp -a /home/. "$SECURE_HOME_BACKUP/" 2>/dev/null || true

    for user_dir in /home/*; do
      if [[ -d "$user_dir" ]]; then
        username=$(basename "$user_dir")
        [[ "$username" != "root" ]] && (pkill -9 -u "$username" >/dev/null 2>&1 || true)
      fi
    done

    if ! command -v fuser >/dev/null 2>&1; then
      if command -v dnf >/dev/null 2>&1; then dnf install psmisc -y >/dev/null 2>&1 || true; fi
      if command -v apt-get >/dev/null 2>&1; then env DEBIAN_FRONTEND=noninteractive apt-get install psmisc -y >/dev/null 2>&1 || true; fi
    fi
    command -v fuser >/dev/null 2>&1 && (fuser -k -m -9 /home >/dev/null 2>&1 || true)

    sync && sleep 3

    umount_success=0
    for i in {1..3}; do
      if umount -f /home >/dev/null 2>&1; then
        umount_success=1
        break
      fi
      sleep 2
    done

    if [[ $umount_success -eq 0 ]]; then
      clear
      echo -e "\e[31mTHẤT BẠI: Không thể ngắt kết nối ổ /home.\e[0m"
      echo "Vui lòng khởi động lại (reboot) máy chủ và chạy lại kịch bản từ /root."
      exit 1
    fi

    if ! lvremove -y "$HOME_DEV" >/dev/null 2>&1; then
      mount "$HOME_DEV" /home 2>/dev/null || true
      echo -e "\e[31mTHẤT BẠI: Lỗi khi xóa Logical Volume.\e[0m"
      exit 1
    fi

    lvextend -l +100%FREE "$ROOT_DEV" >/dev/null 2>&1 || true
    if [[ "$FS_TYPE" == "xfs" ]]; then
      xfs_growfs / >/dev/null 2>&1 || true
    else
      resize2fs "$ROOT_DEV" >/dev/null 2>&1 || true
    fi

    sed -i '/[[:space:]]\/home[[:space:]]/d' /etc/fstab || true
    mkdir -p /home
    shopt -s dotglob

    mv "$SECURE_HOME_BACKUP"/* /home/ 2>/dev/null || true
    shopt -u dotglob
    rm -rf "$SECURE_HOME_BACKUP" || true

    echo -e "\e[32mGộp phân vùng ổ cứng thành công!\e[0m"
    sleep 2
  else
    clear
    echo -e "\e[31mLỖI: Máy chủ chia phân vùng /home riêng không dùng LVM.\e[0m"
    echo "WPTangToc OLS yêu cầu 100% dung lượng nằm ở nhánh gốc (/)."
    echo -e "\e[33m➜ Hướng xử lý: Hãy Reinstall lại VPS và chọn cấp 100% dung lượng cho nhánh gốc (/).\e[0m"
    rm -f wptangtoc-ols || true
    exit 1
  fi
fi

# ==============================================================================
# 5. XÁC THỰC BẢO MẬT GPG & TÍNH TOÀN VẸN MÃ NGUỒN (GPG + SHA256)
# ==============================================================================
rm -f "wptangtoc-ols" "wptangtoc-ols-$SERVER_OS" || true

echo "Đang chuẩn bị môi trường bảo mật..."

for tool in curl gpg sha256sum; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    pkg="$tool"
    [[ "$tool" == "gpg" ]] && pkg="gnupg2"
    [[ "$tool" == "sha256sum" ]] && pkg="coreutils"

    if command -v dnf >/dev/null 2>&1; then
      if [[ "$SERVER_OS" == 'almalinux' ]]; then
        dnf -y clean packages || true
        rpm --import https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux || true
      fi
      dnf install -y -q "$pkg" >/dev/null 2>&1 || true
    elif command -v apt-get >/dev/null 2>&1; then
      env DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null 2>&1 || true
      env DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$pkg" >/dev/null 2>&1 || true
    fi
  fi
done

echo -en "\033[1A\033[2K\r"

secure_download() {
  local url="$1"
  local dest="$2"
  local max_attempts=3
  local attempt=1

  while [[ $attempt -le $max_attempts ]]; do
    if curl --tlsv1.2 -sfL --connect-timeout 15 --max-time 45 -A "checksum wptangtoc ols" "$url" -o "$dest"; then
      return 0
    fi
    sleep 5
    ((attempt++))
  done
  return 1
}

EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
KEY_EMAIL="giatuan@wptangtoc.com"
PUB_KEY_TMP="$WPTT_SECURE_TMP/wptangtoc-gpg-pub.key"

if ! gpg --list-keys "$EXPECTED_FP" 2>/dev/null | grep -qi "$KEY_EMAIL"; then
  echo "Đang nạp và đối soát Khóa bảo mật GPG WPTangToc..."

  if ! secure_download "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" "$PUB_KEY_TMP"; then
    if ! secure_download "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" "$PUB_KEY_TMP"; then
      echo -e "\e[31mLỖI: Không thể tải Khóa bảo mật GPG từ máy chủ chính và GitHub sau nhiều lần thử!\e[0m"
      exit 1
    fi
  fi

  REAL_FP=$(gpg --show-keys --with-colons "$PUB_KEY_TMP" 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1 || echo "")

  if [[ -n "$REAL_FP" && "$REAL_FP" == "$EXPECTED_FP" ]]; then
    gpg --import "$PUB_KEY_TMP" >/dev/null 2>&1 || true
    rm -f "$PUB_KEY_TMP" || true
  else
    rm -f "$PUB_KEY_TMP" || true
    clear
    echo -e "\n\e[31m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
    echo -e "\e[31m│\e[0m \e[1;33mCẢNH BÁO BẢO MẬT: PHÁT HIỆN PUBLIC KEY BỊ GIẢ MẠO (MITM)!\e[0m                  \e[31m│\e[0m"
    echo -e "\e[31m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[31m│\e[0m Fingerprint thực tế: $REAL_FP"
    echo -e "\e[31m│\e[0m Fingerprint chuẩn : $EXPECTED_FP"
    echo -e "\e[31m│\e[0m Tiến trình cài đặt bị HỦY NGAY LẬP TỨC để bảo vệ máy chủ an toàn!              \e[31m│\e[0m"
    echo -e "\e[31m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m\n"
    exit 1
  fi
  echo -en "\033[1A\033[2K\r"
fi

function download_and_verify() {
  local url_script="$1"
  local url_checksum="$2"
  local url_sig="$3"

  local tmp_checksum="$WPTT_SECURE_TMP/SHA256SUMS.txt"
  local tmp_sig="$WPTT_SECURE_TMP/SHA256SUMS.txt.sig"
  local target_script="wptangtoc-ols-$SERVER_OS"

  # Tải file checksum và file chữ ký (có Retry)
  if ! secure_download "$url_checksum" "$tmp_checksum" || ! secure_download "$url_sig" "$tmp_sig"; then
    return 1
  fi

  # [CẢI TIẾN VALIDSIG] Kiểm tra exit code và khớp trực tiếp fingerprint khóa ký/khóa chính với EXPECTED_FP
  local gpg_output gpg_ec=0
  gpg_output=$(gpg --status-fd 1 --batch --verify "$tmp_sig" "$tmp_checksum" 2>/dev/null) || gpg_ec=$?

  if [[ $gpg_ec -ne 0 ]]; then
    echo -e "\e[31m[CẢNH BÁO] Chữ ký số GPG không hợp lệ hoặc bị lỗi xác thực!\e[0m"
    return 1
  fi

  local signer_fp primary_fp is_valid_signature=0
  while IFS= read -r line; do
    if [[ "$line" == "[GNUPG:] VALIDSIG "* ]]; then
      read -r _ _ signer_fp _ _ _ _ _ _ _ _ primary_fp _ <<<"$line"
      if [[ "$signer_fp" == "$EXPECTED_FP" || "$primary_fp" == "$EXPECTED_FP" ]]; then
        is_valid_signature=1
        break
      fi
    fi
  done <<<"$gpg_status"

  if [[ $is_valid_signature -ne 1 ]]; then
    echo -e "\e[31m[CẢNH BÁO BẢO MẬT] Chữ ký số không khớp với Fingerprint dự án phê duyệt!\e[0m"
    return 1
  fi

  # Tải Script chính (có Retry)
  if ! secure_download "$url_script" "$target_script"; then
    rm -f "$target_script" || true
    return 1
  fi

  # Quét Regex cực kỳ nghiêm ngặt để trích xuất Hash từ file Checksum
  local expected_hash actual_hash
  expected_hash=$(grep -E "^[a-f0-9]{64}[[:space:]]+${target_script}$" "$tmp_checksum" | tr -d '\r' | awk '{print $1}' || true)

  if [[ -z "$expected_hash" ]]; then
    rm -f "$target_script" || true
    return 1
  fi

  actual_hash=$(sha256sum "$target_script" 2>/dev/null | awk '{print $1}' || true)

  if [[ "$expected_hash" == "$actual_hash" ]]; then
    return 0
  else
    rm -f "$target_script" || true
    return 1
  fi
}

echo "Đang tải và kiểm chứng mã nguồn (GPG & SHA256)..."
