# Bộ cài đặt WPTangToc OLS

OUTPUT=$(cat /etc/*release 2>/dev/null)
if echo "$OUTPUT" | grep -q "AlmaLinux 8\|Rocky Linux 8\|Red Hat Enterprise Linux 8\|Oracle Linux Server 8"; then
  SERVER_OS='almalinux'
elif echo "$OUTPUT" | grep -q "AlmaLinux 9\|Rocky Linux 9\|Red Hat Enterprise Linux 9\|Oracle Linux Server 9"; then
  SERVER_OS='almalinux-9'
elif echo "$OUTPUT" | grep -q "AlmaLinux 10\|Rocky Linux 10\|Red Hat Enterprise Linux 10\|Oracle Linux Server 10"; then
  SERVER_OS='almalinux-10'
elif echo "$OUTPUT" | grep -q "Ubuntu 22.04\|Ubuntu 24.04"; then
  SERVER_OS='ubuntu'
else
  echo "Hiện tại WPTangToc OLS không hỗ trợ hệ điều hành $(hostnamectl 2>/dev/null | grep System | cut -f2 -d':' | sed 's/^ //g') của bạn."
  echo "Hệ điều hành khuyên dùng: AlmaLinux 8, 9 | Rocky Linux 8, 9 | Ubuntu 22.04, 24.04."
  rm -f wptangtoc-ols
  exit 1
fi

if [[ $SERVER_OS = 'almalinux-10' ]]; then
  echo "Hệ điều hành AlmaLinux 10 đang tạm ngừng do một số thư viện chưa tương thích hoàn toàn."
  echo "Khuyến nghị từ Gia Tuấn: Vui lòng chuyển qua sử dụng AlmaLinux 9."
  rm -f wptangtoc-ols
  exit 1
fi

# HÀM THÔNG BÁO PANEL CŨ
function canh_bao_panel_cu() {
  local ten_panel="$1"
  clear
  echo -e "\e[31mCẢNH BÁO: Máy chủ của bạn đã cài đặt sẵn \e[33m${ten_panel}\e[31m!\e[0m"
  echo "Để WPTangToc OLS hoạt động mượt mà và bảo mật nhất, yêu cầu hệ điều hành mới tinh (Fresh OS)."
  echo -e "\n➜ Hướng xử lý: Hãy Rebuild/Reinstall lại VPS (Khuyên dùng: AlmaLinux 9)."
  rm -f wptangtoc-ols
  exit 1
}

# KIỂM TRA ĐÃ CÀI WPTANGTOC OLS
if [ -d /etc/wptt ]; then
  clear
  echo "Máy chủ của bạn đã được cài đặt WPTangToc OLS từ trước!"
  echo "Yêu cầu hỗ trợ: Gia Tuấn - Email: giatuan@wptangtoc.com"
  rm -f wptangtoc-ols
  exit 0
fi

# MẢNG QUÉT CÁC PANEL / SCRIPT KHÁC
declare -A cac_panel_khac=(
  ["/var/cpanel/cpanel.config"]="WHM/cPanel"
  ["/usr/local/lscp"]="CyberPanel"
  ["/etc/psa/.psa.shadow"]="Plesk"
  ["/etc/init.d/directadmin"]="DirectAdmin"
  ["/etc/init.d/webmin"]="Webmin"
  ["/www/server/panel"]="aaPanel"
  ["/root/passwords.txt"]="Sentora"
  ["/etc/hocvps/scripts.conf"]="HocVPS"
  ["/usr/local/bin/ee"]="EasyEngine v3"
  ["/opt/easyengine"]="EasyEngine v4"
  ["/usr/local/bin/wo"]="WordOps"
  ["/home/kusanagi"]="Kusanagi"
  ["/usr/local/cwpsrv"]="CentOS Web Panel (CWP)"
  ["/usr/local/vesta/"]="VestaCP"
  ["/usr/local/hestia/"]="HestiaCP"
  ["/usr/local/fastpanel2/"]="FastPanel"
  ["/etc/runcloud/"]="RunCloud"
  ["/usr/local/cloudpanel/"]="CloudPanel"
  ["/root/vpssim.conf"]="VPSSIM"
  ["/etc/larvps/.larvps.conf"]="LarVPS"
  ["/opt/tinopanel"]="TinoPanel"
  ["/var/hostvn/hostvn.conf"]="HostVN"
  ["/usr/local/lsws"]="LiteSpeed Webserver"
  ["/home/lsws"]="LiteSpeed Webserver"
)


#quét danh sách
#thêm dấu ! vào thành "${!cac_panel_khac[@]}", Bash sẽ thông minh lôi toàn bộ các Key (Đường dẫn file: /var/cpanel..., /usr/local/lscp...) ra để kiểm tra.
#nếu không có ! thì thay  nó sẽ lấy value ra kiểm tra, mà mình muốn dùng key để kiểm tra thì thêm !

for path in "${!cac_panel_khac[@]}"; do
  if [[ -e "$path" ]]; then
    canh_bao_panel_cu "${cac_panel_khac[$path]}"
  fi
done

# KIỂM TRA KIẾN TRÚC CPU ARM
if uname -m | grep -q 'aarch64'; then
  if [[ $SERVER_OS == 'almalinux' ]]; then #arm không support almalinx 8, chỉ support từ bản 9 trở lên
    clear
    echo "WPTangToc OLS không hỗ trợ CPU ARM trên phiên bản AlmaLinux 8."
    echo "Để chạy trên kiến trúc ARM, vui lòng sử dụng AlmaLinux 9, Rocky Linux 9 hoặc Ubuntu."
    rm -f wptangtoc-ols
    exit 1
  fi
fi

# YÊU CẦU QUYỀN ROOT
check_root=$(whoami 2>/dev/null || who | awk '{print $1}' | head -n 1)
if [[ "$check_root" != "root" ]]; then
  echo "Lỗi: Vui lòng sử dụng tài khoản root để cài đặt WPTangToc OLS."
  echo "Hướng dẫn login root: https://wptangtoc.com/wptangtoc-ols-cau-hoi-thuong-gap/#Yeu_cau_tai_khoan_root_moi_cai_duoc_wptangtoc_ols"
  rm -f wptangtoc-ols
  exit 1
fi

# ==============================================================================
# TỰ ĐỘNG XỬ LÝ LỖI PHÂN VÙNG /home DUNG LƯỢNG LỚN (LVM AUTO-MERGE AN TOÀN 100%)
# ==============================================================================
HOME_DEV=$(df -P /home 2>/dev/null | awk 'NR==2 {print $1}')
ROOT_DEV=$(df -P / 2>/dev/null | awk 'NR==2 {print $1}')
FS_TYPE=$(df -Th 2>/dev/null | awk '$NF=="/" {print $2}')

if [[ -n "$HOME_DEV" && -n "$ROOT_DEV" && "$HOME_DEV" != "$ROOT_DEV" ]]; then
  if [[ "$PWD" == /home* ]]; then
    clear
    echo -e "\e[31mLỖI NGHIÊM TRỌNG: Script đang chạy từ bên trong thư mục /home!\e[0m"
    echo "Hệ thống không thể gộp phân vùng ổ cứng khi bạn đang đứng bên trong nó."
    echo -e "\e[33m➜ Hướng xử lý: Chuyển ra thư mục /root và chạy lại:\e[0m"
    echo "mv wptangtoc-ols /root/ && cd /root && bash wptangtoc-ols"
    exit 1
  fi

  HOME_TYPE=$(lsblk -no TYPE "$HOME_DEV" 2>/dev/null | grep -ow "lvm")
  ROOT_TYPE=$(lsblk -no TYPE "$ROOT_DEV" 2>/dev/null | grep -ow "lvm")

  if [[ "$HOME_TYPE" == "lvm" && "$ROOT_TYPE" == "lvm" ]]; then
    clear
    echo -e "\e[33m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
    echo -e "\e[33m│                 CẢNH BÁO: TÁI CẤU TRÚC PHÂN VÙNG Ổ CỨNG                      │\e[0m"
    echo -e "\e[33m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[33m│\e[0m Hệ thống phát hiện VPS của bạn đang chia phần lớn dung lượng cho ổ \e[36m/home\e[0m.    \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m WPTangToc OLS lưu trữ dữ liệu Web và Database tại phân vùng gốc \e[36m/\e[0m.           \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m Nếu không gộp, website của bạn sẽ rất nhanh bị đầy ổ cứng và sập MariaDB.    \e[33m│\e[0m"
    echo -e "\e[33m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[33m│\e[0m \e[1;31mRỦI RO TỚI DỮ LIỆU:\e[0m Việc gộp LVM can thiệp rất sâu vào nhân hệ điều hành.    \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m Yêu cầu bạn phải \e[1;31mCHỤP SNAPSHOT / BACKUP\e[0m toàn bộ VPS trên trang quản lý của   \e[33m│\e[0m"
    echo -e "\e[33m│\e[0m nhà cung cấp trước khi bấm Đồng ý để phòng sự cố cúp điện hoặc Kernel Panic. \e[33m│\e[0m"
    echo -e "\e[33m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m"
    echo ""
    
    while true; do
        echo -en "\e[36m➤ Bạn có ĐỒNG Ý thực hiện gộp ổ /home vào nhánh gốc (/) không? (y/n): \e[0m"
        read -r confirm_merge
        if [[ "$confirm_merge" == "n" || "$confirm_merge" == "N" ]]; then
            echo -e "\n\e[31mĐã hủy tiến trình cài đặt.\e[0m"
            echo "Lời khuyên: Bạn có thể chủ động cài lại hệ điều hành (Rebuild OS) từ trang quản lý Cloud và thiết lập cấp 100% dung lượng cho ổ / (Root), sau đó chạy lại mã cài đặt."
            rm -f wptangtoc-ols
            exit 1
        elif [[ "$confirm_merge" == "y" || "$confirm_merge" == "Y" ]]; then
            echo -e "\n\e[32mĐã xác nhận! Bắt đầu phẫu thuật gộp phân vùng...\e[0m"
            break
        else
            echo -e "\e[31m❌ Vui lòng nhập 'y' (Đồng ý) hoặc 'n' (Hủy bỏ).\e[0m"
        fi
    done
    
    mkdir -p /tmp/home_backup
    cp -a /home/. /tmp/home_backup/ 2>/dev/null
    
    for user_dir in /home/*; do
      if [[ -d "$user_dir" ]]; then
        username=$(basename "$user_dir")
        [[ "$username" != "root" ]] && pkill -9 -u "$username" >/dev/null 2>&1
      fi
    done

    if ! command -v fuser >/dev/null 2>&1; then
      dnf install psmisc -y >/dev/null 2>&1 || apt-get install psmisc -y >/dev/null 2>&1
    fi
    command -v fuser >/dev/null 2>&1 && fuser -k -m -9 /home >/dev/null 2>&1
    
    sync && sleep 3
    
    umount_success=0
    for i in {1..3}; do
      if umount -f /home >/dev/null 2>&1; then
        umount_success=1
        break
      fi
      sleep 2
    done
    
    if [[ $umount_success -eq 0 ]]; then
      clear
      echo -e "\e[31mTHẤT BẠI: Không thể ngắt kết nối ổ /home.\e[0m"
      echo "Vui lòng khởi động lại (reboot) máy chủ và chạy lại kịch bản từ /root."
      exit 1
    fi
    
    if ! lvremove -y "$HOME_DEV" >/dev/null 2>&1; then
      mount "$HOME_DEV" /home 2>/dev/null
      echo -e "\e[31mTHẤT BẠI: Lỗi khi xóa Logical Volume.\e[0m"
      exit 1
    fi
    
    lvextend -l +100%FREE "$ROOT_DEV" >/dev/null 2>&1
    if [[ "$FS_TYPE" == "xfs" ]]; then
      xfs_growfs / >/dev/null 2>&1
    else
      resize2fs "$ROOT_DEV" >/dev/null 2>&1
    fi
    
    sed -i '/[[:space:]]\/home[[:space:]]/d' /etc/fstab
    mkdir -p /home
    shopt -s dotglob
    mv /tmp/home_backup/* /home/ 2>/dev/null
    shopt -u dotglob
    rm -rf /tmp/home_backup
    
    echo -e "\e[32mGộp phân vùng ổ cứng thành công!\e[0m"
    sleep 2
  else
    clear
    echo -e "\e[31mLỖI: Máy chủ chia phân vùng /home riêng không dùng LVM.\e[0m"
    echo "WPTangToc OLS yêu cầu 100% dung lượng nằm ở nhánh gốc (/)."
    echo -e "\e[33m➜ Hướng xử lý: Hãy Reinstall lại VPS và chọn cấp 100% dung lượng cho nhánh gốc (/).\e[0m"
    rm -f wptangtoc-ols
    exit 1
  fi
fi

# ==============================================================================
# XÁC THỰC BẢO MẬT GPG & TÍNH TOÀN VẸN MÃ NGUỒN (GPG + SHA256)
# ==============================================================================
rm -f "wptangtoc-ols" "wptangtoc-ols-$SERVER_OS"

echo "Đang chuẩn bị môi trường bảo mật..."

# 1. Đảm bảo có sẵn công cụ curl, gpg, sha256sum
for tool in curl gpg sha256sum; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    pkg="$tool"
    [[ "$tool" == "gpg" ]] && pkg="gnupg2"
    [[ "$tool" == "sha256sum" ]] && pkg="coreutils"
    if command -v dnf >/dev/null 2>&1; then

	if [[ $SERVER_OS == 'almalinux' ]]; then #bản almalinx 8.6 ngày xưa trở về truớc phải update gpg online lại mới install đuợc, đề phòng tuơng thích
	dnf -y clean packages
	rpm --import https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux
	fi

      dnf install -y -q "$pkg" >/dev/null 2>&1

    elif command -v apt-get >/dev/null 2>&1; then
      apt-get update -q >/dev/null 2>&1 && apt-get install -y -q "$pkg" >/dev/null 2>&1
    fi
  fi
done

# XÓA LINE "Đang chuẩn bị môi trường..."
echo -en "\033[1A\033[2K\r"

# 2. Nhập và kiểm định Fingerprint Public Key
EXPECTED_FP="EE091EEB9A5189BC80837C059AA528D37B902267"
KEY_EMAIL="giatuan@wptangtoc.com"

if ! gpg --list-keys "$KEY_EMAIL" >/dev/null 2>&1; then
  echo "Đang nạp và đối soát Khóa bảo mật GPG WPTangToc..."
  
  # Kèm User-Agent vào CURL lấy Key
  curl -sfL -A "checksum wptangtoc ols" --connect-timeout 15 "https://wptangtoc.com/share/wptangtoc-gpg-pub.key" -o /tmp/wptangtoc-gpg-pub.key || \
  curl -sfL -A "checksum wptangtoc ols" --connect-timeout 15 "https://raw.githubusercontent.com/wptangtoc/wptangtoc-ols/refs/heads/main/wptangtoc-gpg-pub.key" -o /tmp/wptangtoc-gpg-pub.key

  if [[ ! -s /tmp/wptangtoc-gpg-pub.key ]]; then
    echo -e "\e[31mLỖI: Không thể tải Khóa bảo mật GPG từ máy chủ chính và GitHub!\e[0m"
    exit 1
  fi

  REAL_FP=$(gpg --show-keys --with-colons /tmp/wptangtoc-gpg-pub.key 2>/dev/null | awk -F: '$1 == "fpr" {print $10}' | head -n 1)

  if [[ -n "$REAL_FP" && "$REAL_FP" == "$EXPECTED_FP" ]]; then
    gpg --import /tmp/wptangtoc-gpg-pub.key >/dev/null 2>&1
    rm -f /tmp/wptangtoc-gpg-pub.key
  else
    rm -f /tmp/wptangtoc-gpg-pub.key
    clear
    echo -e "\n\e[31m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
    echo -e "\e[31m│\e[0m \e[1;33mCẢNH BÁO BẢO MẬT: PHÁT HIỆN PUBLIC KEY BỊ GIẢ MẠO!\e[0m                           \e[31m│\e[0m"
    echo -e "\e[31m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[31m│\e[0m Fingerprint thực tế: $REAL_FP"
    echo -e "\e[31m│\e[0m Fingerprint chuẩn : $EXPECTED_FP"
    echo -e "\e[31m│\e[0m Tiến trình cài đặt bị HỦY NGAY LẬP TỨC để bảo vệ máy chủ an toàn!             \e[31m│\e[0m"
    echo -e "\e[31m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m\n"
    exit 1
  fi
  # XÓA LINE "Đang nạp..."
  echo -en "\033[1A\033[2K\r"
fi

# 3. Hàm tải, đối soát GPG Signature và Checksum SHA256
function download_and_verify() {
  local url_script="$1"
  local url_checksum="$2"
  local url_sig="$3"

  local tmp_checksum="/tmp/WPTT_SHA256SUMS_$$.txt"
  local tmp_sig="/tmp/WPTT_SHA256SUMS_$$.sig"

  if ! curl -sfL -A "checksum wptangtoc ols" --connect-timeout 20 "$url_checksum" -o "$tmp_checksum"; then
    rm -f "$tmp_checksum" "$tmp_sig"
    return 1
  fi

  if ! curl -sfL -A "checksum wptangtoc ols" --connect-timeout 20 "$url_sig" -o "$tmp_sig"; then
    rm -f "$tmp_checksum" "$tmp_sig"
    return 1
  fi

  # Bước A: Xác thực chữ ký số GPG của file Checksum
  local gpg_verify_output
  gpg_verify_output=$(gpg --batch --status-fd 1 --verify "$tmp_sig" "$tmp_checksum" 2>/dev/null)
  
  if ! echo "$gpg_verify_output" | grep -q '^\[GNUPG:\] GOODSIG ' || \
     ! echo "$gpg_verify_output" | grep -q "$EXPECTED_FP"; then
    echo -e "\e[31m[CẢNH BÁO] Chữ ký số GPG của file checksum không hợp lệ hoặc bị can thiệp!\e[0m"
    rm -f "$tmp_checksum" "$tmp_sig"
    return 1
  fi

  # Bước B: Tải script cài đặt cho OS tương ứng (Kèm User-Agent)
  if ! curl -sfLO -A "checksum wptangtoc ols" --connect-timeout 30 "$url_script"; then
    rm -f "$tmp_checksum" "$tmp_sig" "wptangtoc-ols-$SERVER_OS"
    return 1
  fi

  # Bước C: Kiểm tra mã băm SHA256 từ file checksum
  local expected_hash actual_hash
  expected_hash=$(grep -E "[[:space:]]wptangtoc-ols-$SERVER_OS$" "$tmp_checksum" | tr -d '\r' | awk '{print $1}')
  actual_hash=$(sha256sum "wptangtoc-ols-$SERVER_OS" 2>/dev/null | awk '{print $1}')

  rm -f "$tmp_checksum" "$tmp_sig"

  if [[ -n "$expected_hash" && "$expected_hash" == "$actual_hash" ]]; then
    return 0
  else
    rm -f "wptangtoc-ols-$SERVER_OS"
    return 1
  fi
}

echo "Đang tải và kiểm chứng mã nguồn (GPG & SHA256)..."
DOWNLOAD_SUCCESS=0

# Nguồn 1: Máy chủ chính (wptangtoc.com & hub)
if download_and_verify \
  "https://wptangtoc.com/share/wptangtoc-ols-$SERVER_OS" \
  "https://hub.wptangtoc.com/SHA256SUMS.txt" \
  "https://hub.wptangtoc.com/SHA256SUMS.txt.sig"; then
  DOWNLOAD_SUCCESS=1
  echo -en "\033[1A\033[2K\r"
else
  # Xóa dòng đang tải, hiện dòng chuyển đổi nguồn Github
  echo -en "\033[1A\033[2K\r"
  echo -e "\e[33mNguồn chính gián đoạn. Tự động chuyển vùng sang GitHub Releases...\e[0m"
  if download_and_verify \
    "https://github.com/wptangtoc/wptangtoc-ols/releases/latest/download/wptangtoc-ols-$SERVER_OS" \
    "https://github.com/wptangtoc/wptangtoc-ols/releases/latest/download/SHA256SUMS.txt" \
    "https://github.com/wptangtoc/wptangtoc-ols/releases/latest/download/SHA256SUMS.txt.sig"; then
    DOWNLOAD_SUCCESS=1
    echo -en "\033[1A\033[2K\r"
  fi
fi

# CHỐT CHẶN BẢO MẬT CUỐI CÙNG
if [[ $DOWNLOAD_SUCCESS -eq 0 ]]; then
  echo ""
  echo -e "\e[31m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
  echo -e "\e[31m│\e[0m \e[1;31mLỖI BẢO MẬT: KHÔNG THỂ XÁC MINH TÍNH TOÀN VẸN CỦA BẢN CÀI ĐẶT!\e[0m               \e[31m│\e[0m"
  echo -e "\e[31m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
  echo -e "\e[31m│\e[0m Hệ thống không thể xác thực Chữ ký số GPG hoặc mã băm SHA256 từ các nguồn.   \e[31m│\e[0m"
  echo -e "\e[31m│\e[0m Tiến trình tự động HỦY để bảo vệ VPS của bạn khỏi các cuộc tấn công MITM.    \e[31m│\e[0m"
  echo -e "\e[31m│\e[0m Vui lòng kiểm tra lại kết nối mạng hoặc liên hệ tác giả: Gia Tuấn.            \e[31m│\e[0m"
  echo -e "\e[31m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m\n"
  exit 1
fi

echo -e "\e[32m✔ Xác minh Chữ ký số GPG & SHA256 hoàn tất: Bản cài đặt chính chủ 100%!\e[0m"
sleep 1
echo -en "\033[1A\033[2K\r"

# THỰC THI GÓI CÀI ĐẶT
bash "wptangtoc-ols-$SERVER_OS" "$@"
