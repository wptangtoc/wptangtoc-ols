# 1. BASH STRICT MODE & ERROR TRAP
set -Eeuo pipefail

WPTT_SECURE_TMP=$(mktemp -d)

wptt_error_trap() {
  local exit_code=$?
  local line_no=$1
  local err_cmd="$2"
  tput cnorm 2>/dev/null || true
  echo -e "\n\e[31m✖ TIẾN TRÌNH KHỞI TẠO BỊ ĐỨT GÃY TẠI DÒNG: $line_no (Mã lỗi: $exit_code)\e[0m"
  echo -e "\e[33mLệnh gây lỗi: $err_cmd\e[0m"
  echo -e "Vui lòng kiểm tra lại môi trường hệ điều hành hoặc liên hệ: giatuan@wptangtoc.com"
  [[ -n "${WPTT_SECURE_TMP:-}" && -d "$WPTT_SECURE_TMP" ]] && rm -rf "$WPTT_SECURE_TMP" || true
}
trap 'wptt_error_trap ${LINENO} "$BASH_COMMAND"' ERR

export LC_ALL=en_US.UTF-8 2>/dev/null || true
export LANG=en_US.UTF-8 2>/dev/null || true
stty iutf8 2>/dev/null || true

# ==============================================================================
# 2. KIỂM TRA HỆ ĐIỀU HÀNH & KIẾN TRÚC CPU
