ARCH=$(uname -m)
if [[ "$ARCH" != "x86_64" && "$ARCH" != "aarch64" ]]; then
  clear
  echo -e "\e[31m╭──────────────────────────────────────────────────────────────────────────────╮\e[0m"
  echo -e "\e[31m│\e[0m \e[1;31mLỖI: KIẾN TRÚC CPU '$ARCH' KHÔNG ĐƯỢC HỖ TRỢ!\e[0m                \e[31m│\e[0m"
  echo -e "\e[31m├──────────────────────────────────────────────────────────────────────────────┤\e[0m"
  echo -e "\e[31m│\e[0m WPTangToc OLS yêu cầu độ ổn định và hiệu suất cao nhất. Hệ thống hiện      \e[31m│\e[0m"
  echo -e "\e[31m│\e[0m tại chỉ hỗ trợ chính thức trên các dòng vi xử lý:                          \e[31m│\e[0m"
  echo -e "\e[31m│\e[0m   • Intel / AMD (x86_64)                                                   \e[31m│\e[0m"
  echo -e "\e[31m│\e[0m   • ARM64 (aarch64 - Ampere Altra, AWS Graviton, Apple Silicon...)         \e[31m│\e[0m"
  echo -e "\e[31m╰──────────────────────────────────────────────────────────────────────────────╯\e[0m\n"
  rm -f wptangtoc-ols || true
  exit 1
fi

OUTPUT=$(cat /etc/*release 2>/dev/null || true)
if echo "$OUTPUT" | grep -q "AlmaLinux 8\|Rocky Linux 8\|Red Hat Enterprise Linux 8\|Oracle Linux Server 8"; then
  SERVER_OS='almalinux'
elif echo "$OUTPUT" | grep -q "AlmaLinux 9\|Rocky Linux 9\|Red Hat Enterprise Linux 9\|Oracle Linux Server 9"; then
  SERVER_OS='almalinux-9'
elif echo "$OUTPUT" | grep -q "AlmaLinux 10\|Rocky Linux 10\|Red Hat Enterprise Linux 10\|Oracle Linux Server 10"; then
  SERVER_OS='almalinux-10'
elif echo "$OUTPUT" | grep -q "Ubuntu 22.04\|Ubuntu 24.04"; then
  SERVER_OS='ubuntu'
else
  echo -e "\e[31mHiện tại WPTangToc OLS không hỗ trợ hệ điều hành $(hostnamectl 2>/dev/null | grep System | cut -f2 -d':' | sed 's/^ //g' || echo 'hiện tại') của bạn.\e[0m"
  echo "Hệ điều hành khuyên dùng: AlmaLinux 8, 9, 10 | Rocky Linux 8, 9, 10 | Ubuntu 22.04, 24.04."
  rm -f wptangtoc-ols || true
  exit 1
fi

if [[ "$ARCH" == 'aarch64' && "$SERVER_OS" == 'almalinux' ]]; then
  clear
  echo -e "\e[31mWPTangToc OLS không hỗ trợ CPU ARM trên phiên bản AlmaLinux 8.\e[0m"
  echo "Để chạy trên kiến trúc ARM, vui lòng sử dụng AlmaLinux 9, Rocky Linux 9 hoặc Ubuntu."
  rm -f wptangtoc-ols || true
  exit 1
fi

# YÊU CẦU QUYỀN ROOT
check_root=$(whoami 2>/dev/null || who | awk '{print $1}' | head -n 1 || echo "root")
if [[ "$check_root" != "root" ]]; then
