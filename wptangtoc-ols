  echo "Hướng dẫn login root: https://wptangtoc.com/wptangtoc-ols-cau-hoi-thuong-gap/"
  rm -f wptangtoc-ols || true
  exit 1
fi

# KIỂM TRA MÔI TRƯỜNG DOCKER / THIẾU SYSTEMD
if [[ ! -d /run/systemd/system ]]; then
  clear
  echo -e "\e[31mLỖI MÔI TRƯỜNG: Phát hiện Docker, Container hoặc hệ thống thiếu Systemd!\e[0m"
  echo "WPTangToc OLS quản lý các dịch vụ cốt lõi (LiteSpeed, MariaDB, Firewall...) thông qua Systemd."
  echo "Môi trường hiện tại không hỗ trợ Systemd (PID 1) nên không thể tiếp tục cài đặt."
  echo -e "\e[33m➜ Hướng xử lý: Vui lòng cài đặt trên VPS / Máy chủ vật lý (KVM, VMware...) có hệ điều hành đầy đủ.\e[0m"
