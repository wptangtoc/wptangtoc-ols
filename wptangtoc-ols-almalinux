    exit 1
}

BOX_COLOR="$C_CYAN"
box_out() {
  local s=("$@") b w=0 l
  for l in "${s[@]}"; do
    ((w < ${#l})) && w="${#l}"
  done
  local pad=$((w + 2))
  local border=$(printf '─%.0s' $(seq 1 $pad))
  echo -e "${BOX_COLOR}╭${border}╮${C_RESET}"
  for l in "${s[@]}"; do
    local spaces=$(( w - ${#l} ))
    local spc_str=""
    [[ $spaces -gt 0 ]] && spc_str=$(printf ' %.0s' $(seq 1 $spaces))
    echo -e "${BOX_COLOR}│${C_RESET} ${C_BOLD_WHITE}${l}${spc_str}${C_RESET} ${BOX_COLOR}│${C_RESET}"
  done
  echo -e "${BOX_COLOR}╰${border}╯${C_RESET}"
}

wptt_error_trap() {
    local exit_code=$?
    local line_no=$1
    local err_cmd="$2"
    tput cnorm 2>/dev/null || true
    echo -e "\n\n${C_RED}✖ TIẾN TRÌNH CÀI ĐẶT BỊ ĐỨT GÃY TẠI DÒNG: $line_no (Mã lỗi: $exit_code)${C_RESET}"
    echo -e "${C_YELLOW}Lệnh gây lỗi: $err_cmd${C_RESET}"
    echo -e "Vui lòng kiểm tra file $LOG_FILE để tìm nguyên nhân."
    [[ -n "${WPTT_SECURE_TMP:-}" && -d "$WPTT_SECURE_TMP" ]] && rm -rf "$WPTT_SECURE_TMP" || true
}
trap 'wptt_error_trap ${LINENO} "$BASH_COMMAND"' ERR

wptt_run() {
    local n=1 max=3 delay_retry=5
    while true; do
        "$@" >> "$LOG_FILE" 2>&1 &
        local pid=$!
        local spin='-\|/'
        local i=0
        local start_time=$SECONDS
        
        tput civis 2>/dev/null || true
        while kill -0 "$pid" 2>/dev/null; do
            local elapsed=$(( SECONDS - start_time ))
            i=$(( (i + 1) % 4 ))
            printf "\e[1A\r\033[K${C_CYAN} ➜ %s... [%c] %ds ${C_RESET}\n" "$CURRENT_STEP" "${spin:$i:1}" "$elapsed"
            sleep 0.15
        done
        tput cnorm 2>/dev/null || true
        
        local exit_code=0
        wait "$pid" || exit_code=$?
        
        if [[ $exit_code -eq 0 ]]; then
            printf "\e[1A\r\033[K${C_CYAN} ➜ %s... ${C_RESET}\n" "$CURRENT_STEP"
            return 0
        else
            if [[ $n -lt $max ]]; then
                printf "\e[1A\r\033[K${C_YELLOW} ➜ %s... (Lỗi %d, đang thử lại %d/%d) ${C_RESET}\n" "$CURRENT_STEP" "$exit_code" "$n" "$max"
                sleep $delay_retry
                ((n++))
            else
                printf "\e[1A\r\033[K${C_CYAN} ➜ %s... ${C_RESET}\n" "$CURRENT_STEP"
                return $exit_code
            fi
        fi
    done
}

