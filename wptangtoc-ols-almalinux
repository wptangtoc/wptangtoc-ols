    echo -e " ├─ Trạng thái Port Web  : ${C_RED}Không thể kết nối (Timeout)${C_RESET}"
    echo -e " └─ ${C_YELLOW}⚠ CẢNH BÁO CLOUD FIREWALL: Nếu bạn sử dụng Google Cloud, AWS, Oracle, Azure, Tencent...${C_RESET}"
    echo -e "    Vui lòng vào trang quản trị Cloud để mở Port 80, 443 và Port SSH ($port_ssh)."
fi
echo -e "======================================================================"

if [[ ! -d /usr/local/lsws ]]; then
	echo -e "${C_RED}${C_BOLD}CẢNH BÁO: CHƯA CÀI ĐẶT ĐƯỢC LITESPEED! Xem log tại $LOG_FILE${C_RESET}"
else
	rm -f /var/log/wptangtoc-install.log || true
fi

rm -f "${WPTT_INSTALL_SCRIPT:?}" 2>/dev/null || true
_step "Máy chủ sẽ tự động khởi động lại sau 3 giây để áp dụng cấu hình..."
sleep 3
/sbin/reboot
