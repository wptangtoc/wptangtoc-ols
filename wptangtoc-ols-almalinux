if [[ -z $(dnf -q list available 2>/dev/null | grep "lsphp${goi_ls_php_bat_buoc}") ]]; then #sử lý tình huống khi php hết hạn mà lại là thư viện bắt buộc của ols
_step "Tải bộ nạp cấu trúc mở rộng PHP EOL dự phòng (CentOS 8)"
wptt_run bash -c '
    goi_ls_php_bat_buoc=$(dnf deplist openlitespeed | grep -oP "lsphp\K[0-9]+" | tail -n1 || echo "")
    if [[ -n "$goi_ls_php_bat_buoc" ]] && ! dnf list available 2>/dev/null | grep -q "lsphp${goi_ls_php_bat_buoc}"; then
        extension_php_bat_buoc=(common gd xml pdo process opcache mysqlnd mbstring imap zip)
        if uname -m | grep -q "aarch64"; then
            curl -skfL https://rpms.litespeedtech.com/centos/8/aarch64/RPMS >"'"$WPTT_SECURE_TMP"'/php_extension_call_eol"
        else
            curl -skfL https://rpms.litespeedtech.com/centos/8/x86_64/RPMS >"'"$WPTT_SECURE_TMP"'/php_extension_call_eol"
        fi
        
        if [[ ! -s "'"$WPTT_SECURE_TMP"'/php_extension_call_eol" ]]; then
            sed -i "/rpms.litespeedtech.com/d" /etc/hosts
            echo $"\n52.55.120.73 rpms.litespeedtech.com\n" >>/etc/hosts
            if uname -m | grep -q "aarch64"; then
                curl -skfL https://rpms.litespeedtech.com/centos/8/aarch64/RPMS >"'"$WPTT_SECURE_TMP"'/php_extension_call_eol"
            else
                curl -skfL https://rpms.litespeedtech.com/centos/8/x86_64/RPMS >"'"$WPTT_SECURE_TMP"'/php_extension_call_eol"
            fi
        fi
        
        url_repo_litespeed=$(
          cat "'"$WPTT_SECURE_TMP"'/php_extension_call_eol" | grep lsphp"${goi_ls_php_bat_buoc}" | grep -oP "href=\"\K[^\"]+" | grep -v "debuginfo\|-devel\|-debugsource" | awk '\''
            BEGIN { FS = "/" }
            {
                filename = $NF; split(filename, parts, "-"); pkg_name = ""; version = ""
                if (parts[2] == "pecl") { pkg_name = parts[1] "-" parts[2] "-" parts[3]; version = parts[4] } 
                else if (parts[2] ~ /^[0-9]+\.[0-9]+/) { pkg_name = parts[1]; version = parts[2] } 
                else { pkg_name = parts[1] "-" parts[2]; version = parts[3] }
                if (version > versions[pkg_name]) { versions[pkg_name] = version; latest_lines[pkg_name] = $0 }
            }
            END { PROCINFO["sorted_in"] = "@ind_str_asc"; for (pkg in latest_lines) { print latest_lines[pkg] } }'\''
        )
        
        for extension_php_in in "${extension_php_bat_buoc[@]}"; do
            if [[ $(printf "%s\n" "${url_repo_litespeed[@]}" | grep "lsphp${goi_ls_php_bat_buoc}-${extension_php_in}-") ]]; then
                dnf install https://rpms.litespeedtech.com$(printf "%s\n" "${url_repo_litespeed[@]}" | grep "lsphp${goi_ls_php_bat_buoc}-${extension_php_in}-") -y 2>/dev/null || true
            fi
        done
        url_php_eol_install=$(printf "%s\n" "${url_repo_litespeed[@]}" | grep -P "lsphp${goi_ls_php_bat_buoc}-\K[0-9]+\.[0-9]+" | tail -n1 || true)
        if [[ -n "$url_php_eol_install" ]]; then dnf install https://rpms.litespeedtech.com"${url_php_eol_install}" -y 2>/dev/null || true; fi
    fi
'
_success "Nạp cấu trúc dự phòng hoàn tất"
